{"aDipatyam": [{"id": "ADipatyam", "headword": "आधिपत्यम्", "headword_slp1": "ADipatyam", "fold": "aDipatyam", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "ஆதி4பத்யம் : எஜமானத்தன்மை, பிரபுத்தன்மை, எல்லோருக்கும் எல்லாவற்றுக்கும் மேலாதாக இருப்பது, அரசனின் கடமைகள்.", "gloss_language": "ta"}], "synonyms": ["aadhipatyam", "ஆதிபத்யம்"], "synonyms_slp1": ["aadhipatyam", "ஆதிபத்யம்"]}], "aDipeLa3tika": [{"id": "ADipeLa3tika", "headword": "आधिपॆळ3तिक", "headword_slp1": "ADipeLa3tika", "fold": "aDipeLa3tika", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "ஆதி4பெள3திக : பிராணிகளால் ஏற்படும் (துன்பம் முதலியன), பிராணிகள் தொடர்புடைய, பௌதிக. அடிப்படையான.", "gloss_language": "ta"}], "synonyms": ["aadhipeLa3tika", "ஆதிபெளதிக"], "synonyms_slp1": ["aadhipeLa3tika", "ஆதிபெளதிக"]}], "aDiswanam": [{"id": "aDizwAnam", "headword": "अधिष्टानम्", "headword_slp1": "aDizwAnam", "fold": "aDiswanam", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அதி4ஷ்டானம் : அருகில் இருத்தல், ஆதாரம், வசிக்குமிடம், பதவி, துறவியின் சமாதி.", "gloss_language": "ta"}], "synonyms": ["adhiShTaanam", "அதிஷ்டானம்"], "synonyms_slp1": ["adhiShTaanam", "அதிஷ்டானம்"]}]}