{"avaraRam": [{"id": "AvaraRam", "headword": "आवरणम्", "headword_slp1": "AvaraRam", "fold": "avaraRam", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "ஆவரணம் : மறைத்தல், முடித்தல், வேலி, படுதா, திரை, கேடயம்.", "gloss_language": "ta"}], "synonyms": ["aavaraNam", "ஆவரணம்"], "synonyms_slp1": ["aavaraNam", "ஆவரணம்"]}], "avartanam": [{"id": "Avarttanam", "headword": "आवर्त्तनम्", "headword_slp1": "Avarttanam", "fold": "avartanam", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "ஆவர்த்தனம் : சுற்றுதல், திரும்புதல், கடைதல், உருக்குதல், மனனம் செய்தல், படித்தல், வட்டமான சலனம்.", "gloss_language": "ta"}], "synonyms": ["aavarttanam", "ஆவர்த்தனம்"], "synonyms_slp1": ["aavarttanam", "ஆவர்த்தனம்"]}], "avahanam": [{"id": "AvAhanam", "headword": "आवाहनम्", "headword_slp1": "AvAhanam", "fold": "avahanam", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "ஆவாஹனம் : கூப்பிடுதல், அழைத்தல், தேவதைகளை வரவழைத்தல்.", "gloss_language": "ta"}], "synonyms": ["aavaahanam", "ஆவாஹனம்"], "synonyms_slp1": ["aavaahanam", "ஆவாஹனம்"]}], "avasta": [{"id": "avastA", "headword": "अवस्ता", "headword_slp1": "avastA", "fold": "avasta", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவஸ்தா : நிலை, ஸ்திதி, கால அளவு, உருவம், தோற்றம், அழகு, அளவு, விகிதம்.", "gloss_language": "ta"}], "synonyms": ["avastaa", "அவஸ்தா"], "synonyms_slp1": ["avastaa", "அவஸ்தா"]}], "avakasaH": [{"id": "avakASaH", "headword": "अवकाशः", "headword_slp1": "avakASaH", "fold": "avakasaH", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவகாச’: : சந்தர்ப்பம், வாய்ப்பு, விடுமுறை, ஓய்வு, இடம், இடைவெளி, இடைவேளை, தொளை, வெடிப்பு.", "gloss_language": "ta"}], "synonyms": ["avakaashaH", "அவகாச:"], "synonyms_slp1": ["avakaashaH", "அவகாச:"]}], "avaboDaH": [{"id": "avaboDaH", "headword": "अवबोधः", "headword_slp1": "avaboDaH", "fold": "avaboDaH", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவபோ3த4 : : விழித்துக் கொள்ளுதல், அறிவு, பார்த்தல், விவேகம், கற்பித்தல், அறிவித்தல்.", "gloss_language": "ta"}], "synonyms": ["avabOdhaH", "அவபோத :"], "synonyms_slp1": ["avabOdhaH", "அவபோத :"]}], "avayavaH": [{"id": "avayavaH", "headword": "अवयवः", "headword_slp1": "avayavaH", "fold": "avayavaH", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவயவ: : உடல் பாகம், அம்சம், உடல், வாதம் செய்ய பயன்படும் ஒரு உருப்பு.", "gloss_language": "ta"}], "synonyms": ["avayavaH", "அவயவ:"], "synonyms_slp1": ["avayavaH", "அவயவ:"]}], "avarohaH": [{"id": "avarohaH", "headword": "अवरोहः", "headword_slp1": "avarohaH", "fold": "avarohaH", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவரோஹ : : இறங்குதல், மரத்தின் மீது சுற்றிக்கொள்ளும் கொடி, சுவர்க்கம், ஆகாயம், ஆலம் விழுது, சங்கீதத்தில் மேல் ஸ்தாயில் இருந்து கீழே இறங்குவது.", "gloss_language": "ta"}], "synonyms": ["avarOhaH", "அவரோஹ :"], "synonyms_slp1": ["avarOhaH", "அவரோஹ :"]}], "avasaraH": [{"id": "avasaraH", "headword": "अवसरः", "headword_slp1": "avasaraH", "fold": "avasaraH", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவஸர: : சமயம், சந்தர்ப்பம், ஸ்தானம், ஆண்டு, மழை பொழிதல், ரஹசிய ஆலோசனை.", "gloss_language": "ta"}], "synonyms": ["avasaraH", "அவஸர:"], "synonyms_slp1": ["avasaraH", "அவஸர:"]}], "avasanam": [{"id": "avasAnam", "headword": "अवसानम्", "headword_slp1": "avasAnam", "fold": "avasanam", "headword_language": "sa", "source": "samskritam-tamizham-dictionary", "senses": [{"gloss": "அவஸானம் : நிறுத்துதல், முடிவு, வியாதி, எல்லை, இருப்பிடம், இளைப்பு ஆறுமிடம்.", "gloss_language": "ta"}], "synonyms": ["avasaanam", "அவஸானம்"], "synonyms_slp1": ["avasaanam", "அவஸானம்"]}]}