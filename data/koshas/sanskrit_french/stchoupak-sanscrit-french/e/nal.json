{"nala": [{"id": "nala", "headword": "नल", "headword_slp1": "nala", "fold": "nala", "headword_language": "sa", "source": "stchoupak-sanscrit-french", "senses": [{"gloss": "नल-\n m. sorte de roseau (cf. नड-) ;\n mesure de longueur (cf.\nनल्व-) ;\n n. d'un roi des Niṣadha, fils de Vīrasena et mari de Damayantī ;\nde divers autres personnages dont un fils de Niṣadha et père de Nabha ;\n d'un\nsinge, fils de Viśvakarman, qui construisit pour Rāma un pont donnant accès\nà l'île de Laṅkā.\n˚कूबर- m. fils de Kubera (cf. नद˚).\n˚गिरि- m. n. de l'éléphant de Pradyota.\n˚शङ्कया adv. supposant qu'il est N.\n˚शालि- m. sorte de riz.\n˚सेतु- m. pont construit par le singe Nala (mod. Pont d'Adam).\nनलोदय- m. titre d'un poème décrivant les aventures de Nala et\nDamayantī.\nनलोपाख्यान- nt. Histoire de Nala, section du MhBh.", "gloss_language": "fr"}], "synonyms": ["नलं", "नलः"], "synonyms_slp1": ["nalaM", "nalaH"]}, {"id": "nAla", "headword": "नाल", "headword_slp1": "nAla", "fold": "nala", "headword_language": "sa", "source": "stchoupak-sanscrit-french", "senses": [{"gloss": "नाल-\n a. fait de roseaux, qui consiste en roseaux ;\n nt. (m.) tige\ncreuse, not. du lotus ;\n tube, canal, ustensile tubulaire, vaisseau du corps ;\nhampe, manche (ifc.) ;\n sorte d'ornement du char ;\n -आ- f. n. d'une rivière.", "gloss_language": "fr"}], "synonyms": ["नालं", "नालः"], "synonyms_slp1": ["nAlaM", "nAlaH"]}], "nalaka": [{"id": "nalaka", "headword": "नलक", "headword_slp1": "nalaka", "fold": "nalaka", "headword_language": "sa", "source": "stchoupak-sanscrit-french", "senses": [{"gloss": "नलक-\n nt. os long (du corps humain).", "gloss_language": "fr"}], "synonyms": ["नलकं"], "synonyms_slp1": ["nalakaM"]}], "nalada": [{"id": "nalada", "headword": "नलद", "headword_slp1": "nalada", "fold": "nalada", "headword_language": "sa", "source": "stchoupak-sanscrit-french", "senses": [{"gloss": "नलद-\n m. nt. nard.", "gloss_language": "fr"}], "synonyms": ["नलदं"], "synonyms_slp1": ["naladaM"]}], "nalina": [{"id