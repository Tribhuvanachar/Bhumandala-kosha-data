{"vam": [{"id": "vam", "headword": "वम्", "headword_slp1": "vam", "fold": "vam", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "√vam [Cu. 〔452〕], 1〉 ausspeien, ausbrechen [A.]; 2〉 bildlich eine Rede (vácas) ausspeien, d. h. sie von sich thun, bereuen.\nStamm vama:\n-an 2〉 etád vácas {934,8} (paṇáyas).\nImpf. avam (von Stamm vam, Pāṇ. 〔7,2,34〕):\n-mīt 1〉 bildlich cátuḥśṛṅgas 〰 gaurás etád (ghṛtásya nā́ma = ghṛtám) {354,2}.", "gloss_language": "de"}]}, {"id": "vAm", "headword": "वाम्", "headword_slp1": "vAm", "fold": "vam", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "(vām), euch beiden, siehe tvám; vā́m, wir beide, siehe ahám.", "gloss_language": "de"}]}], "vamra": [{"id": "vamra", "headword": "वम्र", "headword_slp1": "vamra", "fold": "vamra", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vamrá, m., 1〉 Ameise (wol wegen des scharfen Saftes, den sie ausspritzen vam); 2〉 Eigenname eines Mannes.\n-ás 1〉 yád 〰 atisárpati {711,21} (neben upajíhvikā). — 2〉 {51,9} (stávānas).\n-ám 2〉 {112,15} (vipipānám).\n-ásya 1〉 2〉 {925,5} mithunā́ vívavrī.", "gloss_language": "de"}], "synonyms": ["वम्रः"], "synonyms_slp1": ["vamraH"]}], "vamraka": [{"id": "vamraka", "headword": "वम्रक", "headword_slp1": "vamraka", "fold": "vamraka", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vamraká, m., Ameischen [von vamrá].\n-ás {925,12} 〰 paḍbhís úpa sarpat índram.", "gloss_language": "de"}]}], "vamri": [{"id": "vamrI", "headword": "वम्री", "headword_slp1": "vamrI", "fold": "vamri", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vamrī́, f. [fem. von vamrá], Ameise.\n-ī́bhis {315,9} 〰 putrám agrúvas adānám nivéśanāt ‥ ā́jabhartha.", "gloss_language": "de"}]}], "vama": [{"id": "vAma", "headword": "वाम", "headword_slp1": "vAma", "fold": "vama", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vāmá, a., n. [von van], 1〉 lieb, theuer, werth, herrlich; 2〉 n., Gut, werthes Gut, Heil, Wohlstand; 3〉 Instr. f. vāmáyā als Adv. lieblich, schön. — Vgl. ánti-vāma.\n-ám [m.] 1〉 śévam átithim {948,1}; gṛhápatim {494,2}.\n-ám [n.] 1〉 suvitám vásyas {141,12}; dráviṇam {295,6}; ójas {1006,3}. — 2〉 {190,5}; {301,13}; {326,24}; {414,7}; {460,10}; {512,6}; {543,4}; {587,2}; {594,1}; {647,21}; {692,4} (śáṃsiam); {833,4}; {866,10}; {882,2}; {889,16}; {950,6}; bhū́ri {33,3}; {124,12}; {505,6}; {512,4}; {868,8}.\n-ám-vāmam 2〉 {326,24}; {902,8}.\n-éna 2〉 {48,1} (sahá 〰).\n-ásya 1〉 hótur {164,1}; vés {164,7}; vásunas {460,5}; {621,31}. — 2〉 āyé {229,10}; kṣattā́ {454,2} (bhū́res); pránītis {489,20}; vāmabhā́jas {512,6}; bhaktáye {647,11}; rātím {966,5}; ī́śānāsas {692,5}.\n-é 3〉 té 〰 ā́ sius {846,8}.\n-ā́ni 2〉 víśvā {436,6}; {642,18}; {712,5}.\n-ā́ [n.] 2〉 víśvā {40,6}; {442,9}; {534,1}.\n-áyā 3〉 stómam ciketa {629,7}.\n-ī́ [N. s. f.] 1〉 práṇītis {489,20}; {895,1}.\n-ī́s [A. p. f.] 1〉 íṣas {287,1}.", "gloss_language": "de"}], "synonyms": ["वामं", "वामः"], "synonyms_slp1": ["vAmaM", "vAmaH"]}], "vamajata": [{"id": "vAmajAta", "headword": "वामजात", "headword_slp1": "vAmajAta", "fold": "vamajata", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vāmá-jāta, a., lieblich geartet, schön geboren.\n-ās [N. p. m.] {966,3} (neben bhū́rivarpasas, citrótayas).", "gloss_language": "de"}]}], "vamadeva": [{"id": "vAmadeva", "headword": "वामदेव", "headword_slp1": "vAmadeva", "fold": "vamadeva", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vāmá-deva, m., Eigenname eines Sängers.\n-asya {312,18} bhúvas‿avitā́ 〰 dhīnā́m.", "gloss_language": "de"}], "synonyms": ["वामदेवः"], "synonyms_slp1": ["vAmadevaH"]}], "vamaniti": [{"id": "vAmanIti", "headword": "वामनीति", "headword_slp1": "vAmanIti", "fold": "vamaniti", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vāmá-nīti, a., schöne Leitung gewährend, schön leitend.\n-is bhava {488,7} neben súnītis.", "gloss_language": "de"}]}], "vamaBaj": [{"id": "vAmaBAj", "headword": "वामभाज्", "headword_slp1": "vAmaBAj", "fold": "vamaBaj", "headword_language": "sa", "source": "grassman-sanskrit-german", "senses": [{"gloss": "vāma-bhā́j, a., Gut [vāmá 2] empfangend, insbesondere 2〉 mit dem Gen. vāmásya.\n-ā́jas [N. p. m.] sákhāyas te 〰 siāma {289,22}. — 2〉 vāmásya {512,6}.", "gloss_language": "de"}]}]}