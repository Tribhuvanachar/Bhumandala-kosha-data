. [Falsch! Mallinātha zitiert hier das Ratirahasyam wie folgt: सर्वतः कटिपरिभ्रमो यदि, प्रेङ्खपूर्वम् इदम् उक्तम् आरतम्. Das bedeutet natürlich, daß diese figura Veneris प्रेङ्खारतम् heißt, aber nicht आरतम्. Nun ist aber außerdem die Lesart schlecht, denn es handelt sich hier um das aus dem Kāmasūtra wohlbekannte प्रेङ्खोलितम्. So liest denn auch die ed. Benares 1912 प्रेङ्खपूर्वम् इदम् उक्तम् ऊलितम् (X,48), wie ich auch schon in meinen Beitr. z. ind. Erotik^1, p. 569, habe drucken lassen.]", "gloss_language": "de"}]}], "araTin": [{"id": "araTin", "headword": "अरथिन्", "headword_slp1": "araTin", "fold": "araTin", "headword_language": "sa", "source": "schmidt-nachtrage-zum-sanskrit-worterbuch", "senses": [{"gloss": "अरथिन् Adj. keinen Wagen habend, Spr. 3666.", "gloss_language": "de"}]}], "arada": [{"id": "arada", "headword": "अरद", "headword_slp1": "arada", "fold": "arada", "headword_language": "sa", "source": "schmidt-nachtrage-zum-sanskrit-worterbuch", "senses": [{"gloss": "°अरद Adj. ohne Stoßzähne (Elefant), Yudh. 7,16.", "gloss_language": "de"}]}], "araDra": [{"id": "araDra", "headword": "अरध्र", "headword_slp1": "araDra", "fold": "araDra", "headword_language": "sa", "source": "schmidt-nachtrage-zum-sanskrit-worterbuch", "senses": [{"gloss": "अ᳓रध्र , vgl. Pischel, Ved. Studien, I,125.", "gloss_language": "de"}]}], "arantos": [{"id": "arantos", "headword": "अरन्तोस्", "headword_slp1": "arantos", "fold": "arantos", "headword_language": "sa", "source": "schmidt-nachtrage-zum-sanskrit-worterbuch", "senses": [{"gloss": "अरन्तोस् Gen. Inf. von रम् mit अ priv. ईश्वरो हास्य वित्ते देवा अरन्तोः: es könnte geschehen, daß die Götter an seinem Reichtum keinen Gefallen fänden, Ait. Br. 3,48,8.", "gloss_language": "de"}]}], "aranDra": [{"id": "aranDra", "headword": "अरन्ध्र", "headword_slp1": "aranDra", "fold": "aranDra", "headword_language": "sa", "source": "schmidt-nachtrage-zum-sanskrit-worterbuch", "senses": [{"gloss": "अरन्ध्र Adj. keine Öffnung habend, Naiṣ. 3,44.", "g