{"Brans": [{"id": "BraMS", "headword": "भ्रंश्", "headword_slp1": "BraMS", "fold": "Brans", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "भ्रंश्, भ्र॑शते, भ्रश्यते (˚ति) fallen, stürzen\n(übertr.), verloren gehen, versagen, ausgehen\n(Abl.) von jemd. getrennt werden,\neiner Sache verlustig gehen (Abl.). p. p.\nभ्रष्ट॑ entfallen, gestürzt, zu Fall gekommen,\nverschwunden, vergangen;\n befreit\no. getrennt von, gekommen um, beraubt\n(Abl.). Caus. भ्रंशयति zu Fall bringen,\nverschwinden o. entwischen lassen;\njemd. (Acc.) um etw. (Abl.) bringen.\nपरि, p. p. परिभ्रष्ट gefallen, um- o. eingefallen,\ngestürzt (übertr.), verschwunden,\nabhanden gekommen;\n entfallen\naus, befreit von, beraubt, verlustig\n(Abl.) प्र entfallen, herabfallen;\n p. p.\nप्रभ्रष्ट entfallen, entlaufen, entsprungen\n(Abl.), verloren, verschwunden, um etw.\n[]\n(Abl.) gekommen. वि Unglück haben,\nscheitern in (Loc.), sich losmachen von\n(Abl.). p. p. विभ्रष्ट gefallen, gestürzt\n(übertr.), verschwunden;\n gescheitert in,\ngekommen um (—˚).", "gloss_language": "de"}]}], "Bransa": [{"id": "BraMSa", "headword": "भ्रंश", "headword_slp1": "BraMSa", "fold": "Bransa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "भ्रंश m. Fall, Sturz, Ruin, Verlust, das\nVerschwinden, Weichen, Verlustiggehen\n(Abl.) das Ablassen, Sichtrennen\nvon (Abl. o. —˚).", "gloss_language": "de"}], "synonyms": ["भ्रंशः"], "synonyms_slp1": ["BraMSaH"]}], "Bransana": [{"id": "BraMSana", "headword": "भ्रंशन", "headword_slp1": "BraMSana", "fold": "Bransana", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "भ्रंशन stürzend;\n n. das Bringen o. Kommen\num (Abl.)", "gloss_language": "de"}]}], "Bransin": [{"id": "BraMSin", "headword": "भ्रंशिन्", "headword_slp1": "BraMSin", "fold": "Bransin", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "भ्रंशिन् entfallend, heraus- o. abfallend\n(A