{"baDira": [{"id": "baDira", "headword": "बधिर", "headword_slp1": "baDira", "fold": "baDira", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "बधिर॑ taub. Abstr. बधिरिता f.", "gloss_language": "de"}], "synonyms": ["बधिरः"], "synonyms_slp1": ["baDiraH"]}], "baDiray": [{"id": "baDiray", "headword": "बधिरय्", "headword_slp1": "baDiray", "fold": "baDiray", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "बधिरय्, ˚यति taub machen, betäuben;\np. p. बधिरित.", "gloss_language": "de"}]}], "baD": [{"id": "bAD", "headword": "बाध्", "headword_slp1": "bAD", "fold": "baD", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "बाध्, बाधते (˚ति) drängen, vertreiben,\nbeunruhigen, plagen, beeinträchtigen,\naufheben, beseitigen, vernichten. Pass.\nबाध्यते leiden;\n p. p. बाधित॑ gedrängt,\ngeplagt etc. Caus. बाधयति bedrängen,\nbelästigen, peinigen. Desid. बीभत्सते\nsich ekeln o. scheuen. Intens. बाबधे\nu. बद्बधे॑ einengen, zusammensperren;\nPartic. बद्बधान॑ in die Enge getrieben,\neingeschlossen. अति heftig quälen. आ\nandrängen, quälen, peinigen. नि niederdrücken,\nbeengen, bedrängen. परि fern\nhalten, ausschließen von (Abl.) belästigen,\nplagen. प्र vorwärts drängen, fördern;\nzurückschlagen, vertreiben, bedrücken,\npeinigen वि auseinandertreiben,\nherausschlagen, verjagen. सम् zusammendrängen,\npeinigen, plagen.", "gloss_language": "de"}]}], "baDa": [{"id": "bADa", "headword": "बाध", "headword_slp1": "bADa", "fold": "baDa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. बाध॑ m. Peiniger;\n (auch f. आ) Pein,\nSehmerz, Plage, Not;\n Schädigung, Beseitigung,\nAufhebung, Widerspruch.", "gloss_language": "de"}, {"gloss": "2. बा॑ध m. Drang.", "gloss_language": "de"}], "synonyms": ["बाधः"], "synonyms_slp1": ["bADaH"]}], "baDaka": [{"id": "bADaka", "headword": "बाधक", "headword_slp1": "bADaka", "fold": "baDaka", "headword_language": "sa", "s