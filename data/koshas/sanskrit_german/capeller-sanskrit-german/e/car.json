{"car": [{"id": "car", "headword": "चर्", "headword_slp1": "car", "fold": "car", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "चर् च॑रतो (˚ते) sich bewegen, gehen,\nfahren mit (Instr), herumstreichen;\nwandern durch, entlang nach (Acc.);\ndurchforschen, auskundschtfen (nur\np.p. चरित);\n sich verhalten, verfahren\nmit (Instr. o. Loc.) etwas (Adj., Ger.\no. Adv.) dauernd thun o. sein;\n betreiben,\nvollziehen, halten, beobachten, ausüben,\nbewirken,hervorbringen (Acc.);\n zu sich\nnehmen, verzehren, fressen (Acc.),\nweiden, pasci (absol o. mit Acc.).p. p.\nचरित॑ (s. bes.) u. चीर्ण Caus. चार॑यति in\nBewegung setzen;\n herumgehen-, weiden\noffressen lassen;\n jemd etwas thun lassen\n(2 Acc.) अधि wandeln auf o. über —\nhinweg (Instr.) अनु nachwandeln,\ndurchstreifen;\n Caus. durchstreichen o.\ndurchforschen lassen von (Instr.)\nअन्तर् wandeln zwischen o. durch, sich\nbefinden in (Acc., Loc., o. Gen.). अप\nabgehen, fehlen;\n sich vergehen. अभि\nsich vergehen gegen (Acc.), jemd. bezaubern,\numstricken (Acc. o. Dat.).\nअव herabkommen von (Abl.) आ\nherankommen, sich nähern (Acc.) betreten,\nbesuchen, gebrauchen, anwenden,\nbehandeln, verfahren, thun, ausüben, vollbringen;\naußtellen, vorschreiben (g.).\nआचरित u. ˚तव्य s. bes. समा verfahren,\nhandeln, thun, begehen, vollbringen.\nउद् aufgehen (Sonne), sich erheben,\nertönen;\n den Leib entleeren;\n aussprechen\n(bes. Caus.). उप herzutreten,\nbedienen, aufwarten, behandeln (Krankheit);\nअनृतेन belügen. निस् u. विनिस्\n[]\nhervorgehen, -kommen. परि umherwandeln,\nbedienen, aufwarten. प्र hervortreten,\nvorschreiten, vorgehen, verfahren,\nausüben, thun, vollbringen.\nवि auseinandergehen, sich öffnen, hervorkommen,\nsich hinaus verbreiten,\nausziehen, ins Feld rücken, umherstreichen,\ndurchwandern, wandeln, sich\nauf halten, leben, verfahren, handeln,\nthun, vollbringen;\n fehlgehen, sich versehen,\nausschweifen. Caus gehen o.\nlaufen lassen fehlgehen lassen d. h.\nverführen;\n in Gedanken hin- und herbewegen,\ndurchdenken, prüfen, erwägen,\nüberlegen, anzweifeln;\n p. p. विचारित\nzweifelhaft. सम् zusammenkommen,\nsich bewegen, gehen, treten. अनुसम्\nzusammeneilen nach.", "gloss_language": "de"}]}], "cara": [{"id": "cara", "headword": "चर", "headword_slp1": "cara", "fold": "cara", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "चर sich regend, beweglich (opp. स्थावर),\nTier (opp. Pflanze);\n gehend, wandelnd\nnach, lebend in, ausübend, vollziehend\n(—˚) m. Späher;\n f. चरा॑ Beweglichkeit.", "gloss_language": "de"}], "synonyms": ["चरः"], "synonyms_slp1": ["caraH"]}, {"id": "cAra", "headword": "चार", "headword_slp1": "cAra", "fold": "cara", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "चार m. Gang, Lauf, Späher, Kundschafter.", "gloss_language": "de"}], "synonyms": ["चारं", "चारः"], "synonyms_slp1": ["cAraM", "cAraH"]}], "caraka": [{"id": "caraka", "headword": "चरक", "headword_slp1": "caraka", "fold": "caraka", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "च॑रक m. Wanderer, bes. Brahmanenschüler,\nSpäher;\n N. einer vedischen\nSchule u. eines alten Arztes.", "gloss_language": "de"}], "synonyms": ["चरकः"], "synonyms_slp1": ["carakaH"]}, {"id": "cAraka", "headword": "चारक", "headword_slp1": "cAraka", "fold": "caraka", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "चारक erfahrend (—˚);\n m. Späher, Kundschafter.", "gloss_language": "de"}], "synonyms": ["चारकः"], "synonyms_slp1": ["cArakaH"]}], "carakaDvaryu": [{"id": "carakADvaryu", "headword": "चरकाध्वर्यु", "headword_slp1": "carakADvaryu", "fold": "carakaDvaryu", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "च॑रकाध्वर्यु m. ein Priester der Caraka.", "gloss_language": "de"}]}], "caraRa": [{"id": "caraRa", "headword": "चरण", "headword_slp1": "caraRa", "fold": "caraRa", "headword_language": "sa", "source":