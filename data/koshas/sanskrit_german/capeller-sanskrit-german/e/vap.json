{"vap": [{"id": "vap", "headword": "वप्", "headword_slp1": "vap", "fold": "vap", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. वप्, व॑पति, ˚ते scheren, abscheren, abgrasen.\nMed. sich scheren. p. p. उप्त geschoren.\nCaus. वापयति, ˚ते scheren\nlassen;\n Med. sich sch. l.", "gloss_language": "de"}, {"gloss": "2. वप्, व॑पति, ˚ते hinstreuen, säen, hinwerfen,\nbestreuen, besäen. p. p. उप्त॑ hingeworfen,\nzerstreut, gesät (auch उपति);\n bestreut,\nbedeckt, übergossen mit (Instr. 0. —˚).\nCaus. वापयति säen, pflanzen;\n p. p. वापित\ngesät. आ einstregen, hineinwerfen,\n-schütten, -legen;\n beifügen. Caus. bei-\nmischen, beimengen;\n kämmen, ordnen\n(das Haar). उद् ausschütten, heraus-\nschaffen, hervorziehen. नि hinschütten,\nhin-, niederwerfen;\n p. p. न्युप्त u. निवप्र\nhingeschütte o. -geworfen (Würfel).\nनिस् herausschütten, zuteilen, dar-\nbringen (r.). प्र ausstreuen, hinwerfen.\nप्रति einstecken, einfügen;\n p. p. प्रत्युप्त\neingesteckt in (Loc. o. —˚);\n besteckt,\nbelegt mit (—˚). सम् einschütten, hin-\neinlegen, zusammenthun.", "gloss_language": "de"}]}], "vapa": [{"id": "vapa", "headword": "वप", "headword_slp1": "vapa", "fold": "vapa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "वप॑ m. Säer.", "gloss_language": "de"}], "synonyms": ["वपः"], "synonyms_slp1": ["vapaH"]}, {"id": "vapA", "headword": "वपा", "headword_slp1": "vapA", "fold": "vapa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "वपा॑ f. Eingeweidehaupt, Netzhaut.", "gloss_language": "de"}]}, {"id": "vApa", "headword": "वाप", "headword_slp1": "vApa", "fold": "vapa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. वाप m. das Scheren.", "gloss_language": "de"}, {"gloss": "2. वाप m. Säer;\n Saat.", "gloss_language": "de"}], "synonyms": ["वापः"], "synonyms_slp1": ["vApaH"]}], "vapana": [{"id": "vapana", "headword": "वपन", "headword_slp1": "vap