{"dar": [{"id": "dar", "headword": "दर्", "headword_slp1": "dar", "fold": "dar", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. दर् दृण॑ति (द॑र्ति) auseinandergehen\no. fallen, aufbrechen;\n sprengen, zerreißen.\nPass. दीर्यते (दीर्यति) intr.;\np.p. दीर्ण॑ gespalten, geborsten, zersprengt;\nzerfahren, verwirrt. Caus.\nदर॑यति, दारयति u. ˚ते sprengen,\naufreißen, erschließen;\n auseinanderjagen,\nverscheuchen. Intens. दर्दर्षि\n= Simpl. trans., eröffnen, erschließen.\nअव Pass. bersten, zerreißen. आ (sich)\nspalten, aufthun, erschließen (auch\nIntens.). प्र zerbrechen, zerreißen.\nअभिप्र sprengen, aufthun, zum Vorschein\nbringen. वि spalten, sprengen,\nzrreißen (auch übertr.). Pass. विदीर्यते\nbersten, außpringen, sich öffnen;\n p.p.\nविदीर्ण geborsten, gespalten, aufgerissen,\naufgesperrt. Caus. = Simpl.", "gloss_language": "de"}, {"gloss": "2. दर् द्रिय॑ते (nur—˚), mit आ = आद्रियते\n(˚ति) berücksichtigen, beachten, rücksichtsvoll\nbehandeln;\n oft mit Neg., vgl.\nअनादृत्य. p.p. आदृत rücksichtsvoll,\nbedacht auf (Loc. o. —˚);\n beachtet,\ngeachtet, geehrt.", "gloss_language": "de"}]}], "dara": [{"id": "dara", "headword": "दर", "headword_slp1": "dara", "fold": "dara", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "दर spaltend, erschließend (—˚);\n n. u. ˚—\nein wenig. m. u. ई f. Loch, Höhle.", "gloss_language": "de"}], "synonyms": ["दरं", "दरः"], "synonyms_slp1": ["daraM", "daraH"]}, {"id": "dAra", "headword": "दार", "headword_slp1": "dAra", "fold": "dara", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. दार m., ई f. Riss, Spalte.", "gloss_language": "de"}, {"gloss": "2. दार m. Sg. u. Pl. (f. आ, n. Pl.) Weib,\nGattin. दारान् (प्र-) कर् ein Weib\nnehmen.", "gloss_language": "de"}], "synonyms": ["दारः"], "synonyms_slp1": ["dAraH"]}], "daraRa": [{"id": "daraRa", "headword": "दरण", "headword_slp1": "daraRa", "fold": "daraRa", "headword_language": "sa