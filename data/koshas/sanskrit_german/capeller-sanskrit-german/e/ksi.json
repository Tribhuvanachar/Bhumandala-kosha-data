{"ksi": [{"id": "kzi", "headword": "क्षि", "headword_slp1": "kzi", "fold": "ksi", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. क्षि क्षे॑ति, क्षिय॑ति, क्ष॑यति wohnen, verweilen,\nbewohnen;\n besitzen, beherrschen\n(Gen.). Caus. क्षय॑यति u. क्षेपयति ruhig\nwohnen machen. — अधि wohnen\nbei o. in, sich ausbreiten über o. unter\n(Acc. o. Loc.) उप wohnen, weilen an,\nhangen, an, abhängen von (Acc.)", "gloss_language": "de"}, {"gloss": "2. क्षि क्षिणा॑ति, क्षिणो॑ति u. क्षयति vernichten,\nzerstören, verderben, schwächen;\nक्षीय॑ते schwinden, abnehmen, zu Grunde\ngehen. p.p. क्षित॑ u. क्षीण॑ Caus. क्षययति\nu. क्षपयति, ˚ते vernichten, zerstören,\nherunterbringen, zubringen (Zeit). p.p.\nक्षयित u. क्षपित। — प्र = Sipl.;\np.p.\nप्र॑क्षीण zerstört, erschöpft, vermindert.", "gloss_language": "de"}], "synonyms": ["क्षिः"], "synonyms_slp1": ["kziH"]}], "ksit": [{"id": "kzit", "headword": "क्षित्", "headword_slp1": "kzit", "fold": "ksit", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "क्षित् (—˚) bewohnend;\n Bewohner.", "gloss_language": "de"}]}], "ksiti": [{"id": "kziti", "headword": "क्षिति", "headword_slp1": "kziti", "fold": "ksiti", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. क्षिति॑ f. Wohnsitz, Erde;\n Pl. die Wohnsitze\nd. h. Stämme, Völker, Menschen,\nGeschlechter.", "gloss_language": "de"}, {"gloss": "2. क्षि॑ति f. Untergang, Verderben.", "gloss_language": "de"}], "synonyms": ["क्षितिः"], "synonyms_slp1": ["kzitiH"]}], "ksitikampa": [{"id": "kzitikampa", "headword": "क्षितिकम्प", "headword_slp1": "kzitikampa", "fold": "ksitikampa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "क्षितिकम्प m. Erdbeden.", "gloss_language": "de"}], "synonyms": ["क्षितिकंप", "क्षितिकम्पः"], "synonyms_slp1": ["kzitikaMpa", "kzitikampaH"]}], "ksititala": [{"id": "kzititala", "headword": "क्षितितल", "headword_slp1": "kzititala"