_language": "de"}]}], "yata": [{"id": "yata", "headword": "यत", "headword_slp1": "yata", "fold": "yata", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यत॑ s. यम्.", "gloss_language": "de"}], "synonyms": ["यतः"], "synonyms_slp1": ["yataH"]}, {"id": "yAta", "headword": "यात", "headword_slp1": "yAta", "fold": "yata", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यात (s.) या n. Gang, Weg, Fahrt.", "gloss_language": "de"}], "synonyms": ["यातं", "यातः"], "synonyms_slp1": ["yAtaM", "yAtaH"]}], "yatama": [{"id": "yatama", "headword": "यतम", "headword_slp1": "yatama", "fold": "yatama", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतम॑ welcher (von Vielen).", "gloss_language": "de"}], "synonyms": ["यतमः"], "synonyms_slp1": ["yatamaH"]}], "yatamaTa": [{"id": "yatamaTA", "headword": "यतमथा", "headword_slp1": "yatamaTA", "fold": "yatamaTa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतम॑था auf welche Weise (von vielen).", "gloss_language": "de"}]}], "yatara": [{"id": "yatara", "headword": "यतर", "headword_slp1": "yatara", "fold": "yatara", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतर॑ welcher (von Zweien).", "gloss_language": "de"}], "synonyms": ["यतरः"], "synonyms_slp1": ["yataraH"]}], "yataraTa": [{"id": "yataraTA", "headword": "यतरथा", "headword_slp1": "yataraTA", "fold": "yataraTa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतर॑था auf welche Weise (von zweien).", "gloss_language": "de"}]}], "yatavrata": [{"id": "yatavrata", "headword": "यतव्रत", "headword_slp1": "yatavrata", "fold": "yatavrata", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतव्रत heilig, fromm (eig. von festen Gelübde).", "gloss_language": "de"}]}], "yatas": [{"id": "yatas", "headword": "यतस्", "headword_slp1": "yatas", "fold": "yatas", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "य॑तस् Adv. = Abl. zu य, von wem o.\nwelchem, woher, wovon, woraus, wo,\nwohin (dopp.) je von wem o. von wem\nauch immer u.s.w);\n warum, weshalb;\nda, weil: seitdem (auch mit प्रभृति) so\nbald als;\n auf dass, damit. Oft zu Anf.\neiner Strophe: denn. Die Verb. mit\nततस् s.d.", "gloss_language": "de"}]}], "yatatman": [{"id": "yatAtman", "headword": "यतात्मन्", "headword_slp1": "yatAtman", "fold": "yatatman", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतात्मन् gezügelten Geisten, sich beherrschend.", "gloss_language": "de"}]}], "yati": [{"id": "yati", "headword": "यति", "headword_slp1": "yati", "fold": "yati", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. य॑ति (nur Pl.) wieviele (rel.).", "gloss_language": "de"}, {"gloss": "2. य॑ति m. Ordner, Lenker;\n Büßer, Asket.", "gloss_language": "de"}, {"gloss": "3. य॑ति f. Lenkung;\n Pause, Cäsur.", "gloss_language": "de"}], "synonyms": ["यतिः"], "synonyms_slp1": ["yatiH"]}], "yatitavya": [{"id": "yatitavya", "headword": "यतितव्य", "headword_slp1": "yatitavya", "fold": "yatitavya", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतितव्य zu sorgen (n. impers.).", "gloss_language": "de"}]}], "yatitva": [{"id": "yatitva", "headword": "यतित्व", "headword_slp1": "yatitva", "fold": "yatitva", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतित्व n. der Büßerstand.", "gloss_language": "de"}]}], "yatiTa": [{"id": "yatiTa", "headword": "यतिथ", "headword_slp1": "yatiTa", "fold": "yatiTa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "यतिथ॑, f. ई॑ der wievieste (rel.).", "gloss_language": "de"}]}], "yatiDa": [{"id": "yatiDA", "headword": "यतिधा", "headword_slp1": "yatiDA", "fold": "yatiDa", "headword_language": "sa", "sourc