{"vid": [{"id": "vid", "headword": "विद्", "headword_slp1": "vid", "fold": "vid", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "1. विद्, वेत्ति (auch Perf. वे॑द mit Praes.-\nBed. wissen, erkennen, begreifen,\nwahrnehmen, erfahren, empfinden,\ndenken an (Acc. 0. Gen.), verstehen\nfür, nennen (2 Acc.). p. p. विदित॑ erkannt\n(auch वित्त), bekannt als (Nom.);\nn. impers., auch adv. mit Wissen von\n(Gen.). Caus. वेद॑यते (˚ति) mitteilen,\nmelden, anzeigen;\n jemd. etw. erklären,\nlehren (2 Acc.), erkennen als, halten\nfür (2 Acc.). Desid. विविदिषति wissen\nwollen, sich erkundigen nach (Acc.).\nआ genau kennen, wissen. Caus. an-\nkündigen, melden, anzeigen (j.);\n p. p.\nआवेदित angemeldet, angezeigt. नि\n(bes. Caus.) kundthun, mitteilen, anzeigen,\nberichten (mit Dat., Gen. 0. Loc.\nder Pers. u. Acc. der S. darbringen,\nüberantworten;\n nennen (2 Acc.). प्र\nkennen, wissen, प्रति merken, erkennen;\nCaus. verkünden, melden, jemd. etw.\n(2 Acc.) mitteilen. सम् (zusammen)\nwissen, kennen, p. p. संविदित erkannt,\nbekannt;\n n. adv im Einverständnis\nmit (Gen.).", "gloss_language": "de"}, {"gloss": "2. विद् (mesit —˚) kennend, wissend.", "gloss_language": "de"}, {"gloss": "3. विद्, विन्द॑ति, ˚ते (विते॑) finden, treffen,\nerreichen, erfassen, heimsuchen;\n be-\nwirken, erweben, jemd. (Dat.) etw.\nverschaffen, verleihen;\n gewinnen, be-\nsitzen, außuchen, sich zuwenden, heiraten\n(von Mann u. Weib). Pass. विद्य॑ते\n(˚ति) gefunden werden, vorhanden\nsein. विद्यमान vorhanden, befindlich;\nविदान u. विदान॑ gefunden, erfunden\nals (Nom.), bestehend, wirklich, ge-\n[]\nwöhnlich. p.. वित्त॑ erhalten, erworben;\nविन्न gefunden;\n f. आ verheriratet (Wei).\nअधि zurücksetzen (eig. überheiraten,\nvom Manne u. der neuen Frau ges.);\np. p. अधिविन्ना f. eine (durch eine neue\nHeirat) zurückgesetzte Frau. अनु auf-\nfinden, habhaft werden (Acc.);\n p. p. अ॑नुवित्त\naufgefunden, vorhanden. आ antreffen,\ngeraten in, erlangen. निस् herausfinden.\nPass. überdrüssig werden;\n p. p.\nनिर्विण्ण einer Sache überdrüssig, satt\n(Abl., Instr., Gen. Loc. o. —˚);\n verdrießlich.\nपरि früher (d. i. vor dem\nältern Bruder) heiraten. सम् finden,\nhabhaft werden;\n संविदान॑ vereint, ein-\nträchtig. Pass. sich finden, da sein.", "gloss_language": "de"}, {"gloss": "4. विद् (—˚) findend, gewinnend, verschaffend.", "gloss_language": "de"}]}], "vida": [{"id": "vida", "headword": "विद", "headword_slp1": "vida", "fold": "vida", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "विद (—˚) = 2. विद्.", "gloss_language": "de"}], "synonyms": ["विदः"], "synonyms_slp1": ["vidaH"]}], "vidagDa": [{"id": "vidagDa", "headword": "विदग्ध", "headword_slp1": "vidagDa", "fold": "vidagDa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "विदग्ध s. दह्.", "gloss_language": "de"}], "synonyms": ["विदग्धः"], "synonyms_slp1": ["vidagDaH"]}], "vidagDacuqamaRi": [{"id": "vidagDacUqAmaRi", "headword": "विदग्धचूडामणि", "headword_slp1": "vidagDacUqAmaRi", "fold": "vidagDacuqamaRi", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "विदग्धचूडामणि m. N. eines Papageien.", "gloss_language": "de"}]}], "vidagData": [{"id": "vidagDatA", "headword": "विदग्धता", "headword_slp1": "vidagDatA", "fold": "vidagData", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "विदग्धता f. Klugheit, Gewandtheit.", "gloss_language": "de"}]}], "vidaTa": [{"id": "vidaTa", "headword": "विदथ", "headword_slp1": "vidaTa", "fold": "vidaTa", "headword_language": "sa", "source": "capeller-sanskrit-german", "senses": [{"gloss": "विद॑थ n. Weisung, Anordnung, Einrichtung;\nVersammlung, (Opfer-) Ge-\nnossenschaft, Gemeide, Feier.", "gloss_language": "de"}], "synonyms": ["विदथः"], "synonyms_slp1": ["vidaTaH"]}], "vidaraRa": [{"id": "vidaraRa", "headword": "विदरण", "headword_slp1": "vidaraRa", "fold": "vidaraRa", "headword_language": "sa", "source": "capeller-sans