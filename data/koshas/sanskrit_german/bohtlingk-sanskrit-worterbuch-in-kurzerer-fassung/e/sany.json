"fold": "sanyuktasamavaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुक्तसमवाय m. Inhärenz in dem Verbundenen (eine der 6 Arten der Wahrnehmung im Nyāya), z. B. die Wahrnehmung der Farbe eines zu Gesicht gekommenen Gefässes.", "gloss_language": "de"}]}], "sanyuktasamavetasamavaya": [{"id": "saMyuktasamavetasamavAya", "headword": "संयुक्तसमवेतसमवाय", "headword_slp1": "saMyuktasamavetasamavAya", "fold": "sanyuktasamavetasamavaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुक्तसमवेतसमवाय m. Inhärenz in demjenigen, was dem Verbindenen inhärirt, z. B. die Wahrnehmung des Gefärbtseins überhaupt an einem zu Gesicht gekommenen Gefässe von bestimmter Farbe.", "gloss_language": "de"}]}], "sanyuktagama": [{"id": "saMyuktAgama", "headword": "संयुक्तागम", "headword_slp1": "saMyuktAgama", "fold": "sanyuktagama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*संयुक्तागम m. Titel eines buddh. Āgama.", "gloss_language": "de"}]}], "sanyuktaBiDarmasastra": [{"id": "saMyuktABiDarmaSAstra", "headword": "संयुक्ताभिधर्मशास्त्र", "headword_slp1": "saMyuktABiDarmaSAstra", "fold": "sanyuktaBiDarmasastra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*संयुक्ताभिधर्मशास्त्र n. Titel eines buddh. Werkes.", "gloss_language": "de"}]}], "sanyuga": [{"id": "saMyuga", "headword": "संयुग", "headword_slp1": "saMyuga", "fold": "sanyuga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुग n. (im BHĀG. P. auch m.)\n— 1〉 Verbindung, Vereinigung.\n— 2〉 Kampf, Schlacht ŚIŚ. 17,55. 18,61.", "gloss_language": "de"}], "synonyms": ["संयुगः"], "synonyms_slp1": ["saMyugaH"]}, {"id": "sAMyuga", "headword": "सांयुग", "headword_slp1": "sAMyuga", "fold": "sanyuga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सांयुग Adj. (f. ई) proeliaris. कु so v. a. Schlachtfeld ŚIŚ. 19,17.", "gloss_language": "de"}]}], "sanyugamurDan": [{"id": "saMyugamUrDan", "headword": "संयुगमूर्धन्", "headword_slp1": "saMyugamUrDan", "fold": "sanyugamurDan", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुगमूर्धन् m. Vordertreffen.", "gloss_language": "de"}]}], "sanyuj": [{"id": "saMyuj", "headword": "संयुज्", "headword_slp1": "saMyuj", "fold": "sanyuj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुज् Adj. durch freundschaftliche oder verwandtschaftliche Bande verknüpft, angehörig, verwandt; [] m. ein Verwandter ŚIŚ. 14,55. Wird auch als f. = संयोग gefasst.", "gloss_language": "de"}]}], "sanyuje": [{"id": "saMyuje", "headword": "संयुजे", "headword_slp1": "saMyuje", "fold": "sanyuje", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयु꣫जे Dat. Infin. zu 1. युज् mit सम् ṚV. 8,41,6.", "gloss_language": "de"}]}], "sanyuti": [{"id": "saMyuti", "headword": "संयुति", "headword_slp1": "saMyuti", "fold": "sanyuti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुति f.\n— 1〉 Summe (zweier Zahlen oder Grössen) BĪJAG. 198.\n— 2〉 Conjunction von Planeten.", "gloss_language": "de"}], "synonyms": ["संयुतिः"], "synonyms_slp1": ["saMyutiH"]}], "sanyuyutsu": [{"id": "saMyuyutsu", "headword": "संयुयुत्सु", "headword_slp1": "saMyuyutsu", "fold": "sanyuyutsu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुयुत्सु Adj. kampfbegierig.", "gloss_language": "de"}]}], "sanyuyusu": [{"id": "saMyuyUzu", "headword": "संयुयूषु", "headword_slp1": "saMyuyUzu", "fold": "sanyuyusu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयुयूषु Adj. mit Acc. in Verbindung zu bringen Wünschend mit (Instr.).", "gloss_language": "de"}]}], "sanyoga": [{"id": "saMyoga", "headword": "संयोग", "headword_slp1": "saMyoga", "fold": "sanyoga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयोग m.\n— 1〉 Verbindung, Zusammenhang, Vereinigung, Zusammentreffen; in der Philosophie die Kategorie der unmittelbaren Berührung, Contact. Construction des Wortes;\n — a〉 mit einem Gen.\n — α〉 Zusammenhang innerhalb eines Ganzen.\n — β〉 Verbindung einzelner Theile, Vereinigung —, das Zusammenkommen von, Zusammenhang zwischen.\n — γ〉 Verbindung —, Vereinigung —, Contact mit. Acc. mit कर् so v. a. unternehmen, sich machen an.\n — b〉 mit सह und Instr. oder mit blossem Instr. = a〉γ〉.\n — c〉 mit Loc. Vereinigung in, so v. a. das Aufgehen in.\n — d〉 am Ende eines Comp. α〉 = a〉α〉. β〉 = a〉β〉. मन्त्र˚ so v. a. Uebereinstimmung der Meinungen im Rathe.\n — γ〉 = a〉γ〉. प्रापितो ऽग्निसंयोगम् so v. a. wurde verbrannt; दाराग्निहोत्रसंयोगं कर् so v. a. ein Weib nehmen und das heilige Feuer unterhalten; ˚संयोगे so v. a. wenn es sich handelt um GAUT. 7,13. 13,19. 16,48. 18,24. ˚संयोगेषु 23,29. अध्ययनाध्व˚ Adj. so v. a. mit Studien beschäftigt oder auf Reisen befindlich 5,21.\n— 2〉 freundschaftliches oder verwandtschaftliches Verhältniss mit (सह), Verschwägerung.\n— 3〉 eheliche Verbindung (GAUT. 4,10), — zwischen (Gen. oder im Comp. vorangehend), fleischliche Vermischung —, Beischlaf mit (सह).\n— 4〉 Summe.\n— 5〉 Consonantenverbindung, eine Gruppe von zwei oder mehr Consonanten.\n— 6〉 ein best. Bündniss.\n— 7〉 das Sichhalten an Etwas, Erwählung ĀPAST. 2,22,5. 23,2.", "gloss_language": "de"}], "synonyms": ["संयोगः"], "synonyms_slp1": ["saMyogaH"]}], "sanyogamantra": [{"id": "saMyogamantra", "headword": "संयोगमन्त्र", "headword_slp1": "saMyogamantra", "fold": "sanyogamantra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयोगमन्त्र m. Heirathsspruch GAUT. 4,7.", "gloss_language": "de"}]}], "sanyogita": [{"id": "saMyogita", "headword": "संयोगित", "headword_slp1": "saMyogita", "fold": "sanyogita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*संयोगित Adj. = संयोजित, संयोगिते HARIV. 14649 fehlerhaft für तं योगिनो.", "gloss_language": "de"}], "synonyms": ["संयोगितः"], "synonyms_slp1": ["saMyogitaH"]}], "sanyogin": [{"id": "saMyogin", "headword": "संयोगिन्", "headword_slp1": "saMyogin", "fold": "sanyogin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयोगिन् Adj.\n— 1〉 in Contact stehend, unmittelbar verbunden, — mit (Instr. oder im Comp. vorangehend). Nom. abstr. ˚गित्व n. SARVAD. 30,4.\n— 2〉 mit dem geliebten Gegenstande verbunden.\n— 3〉 verheirathet.\n— 4〉 mit einem andern Consonanten verbunden, einer Consonanten in einer Consonantengruppe.", "gloss_language": "de"}]}], "sanyojaka": [{"id": "saMyojaka", "headword": "संयोजक", "headword_slp1": "saMyojaka", "fold": "sanyojaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚संयोजक Adj. veranlassend zu GAUT.", "gloss_language": "de"}]}], "sanyojana": [{"id": "saMyojana", "headword": "संयोजन", "headword_slp1": "saMyojana", "fold": "sanyojana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संयो꣫जन n.\n— 1〉 das Vereinigen, Zusammenbringen, — mit (Instr. oder Loc. 267,9).\n— 2〉 *fleischliche [] Vermischung, Beischlaf.\n— 3〉 mit den Genitiven मित्रावरुणयोस्, अश्विनोस् und प्रहितोस् Name von Sāman ĀRṢ. BR.", "gloss_language": "de"}, {"gloss": "संयोजन VII. Alles was an die Welt bindet ebend. 533,25. 553,24. MAHĀVY. 109.", "gloss_language": "de"}], "synonyms": ["संयोजनं"], "synonym