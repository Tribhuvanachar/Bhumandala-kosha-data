{"jap": [{"id": "jap", "headword": "जप्", "headword_slp1": "jap", "fold": "jap", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√जप्, ज꣫पति, जपते (seltener); Partic. जपित und जप्त.\n— 1〉 halblaut —, flüsternd hersagen, hermurmeln (Gebete). जपताम् वरः der Beste unter den stillen Betern 73,15.\n— 2〉 beflüstern, mit halblauter Stimme besprechen.\n— 3〉 halblaut ein Gebet an Jmd richten, halblaut Jmd anrufen.\n— Intens. जञ्जप्य꣫ते, *जञ्जपीति beständig flüstern. Nach den Grammatikern soll ein Tadel darin liegen.\n— Mit अनु [] nachher murmelnd hersagen.\n— Mit अभि beflüstern, besprechen.\n— Mit आ hineinflüstern. क꣫र्ने inʼs Ohr.\n— Mit उप\n— 1〉 zuflüstern, mit Loc. oder Acc. des Ohres.\n— 2〉 Jmd durch Zuflüsterungen auf seine Seite bringen.\n— Mit परि beflüstern, besprechen GOBH. 2,3,18. 4,5,19. VARĀH. BṚH. S. 48,74.\n— Mit प्र herflüstern.\n— Mit प्रति erwiedernd flüstern.\n— Mit सम् ausplaudern, weitererzählen, mittheilen.", "gloss_language": "de"}]}], "japa": [{"id": "japa", "headword": "जप", "headword_slp1": "japa", "fold": "japa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ज꣫प\n— 1〉 Adj. flüsternd, raunend.\n— 2〉 m. das halblaute Aufsagen eines Gebets, Liedes u. s. w. ein auf diese Weise hergesagtes Gebet.", "gloss_language": "de"}], "synonyms": ["जपः"], "synonyms_slp1": ["japaH"]}, {"id": "japA", "headword": "जपा", "headword_slp1": "japA", "fold": "japa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जपा f. Hibiscus rosa-sinensis VARĀH. BṚH. S. 28,14.", "gloss_language": "de"}]}, {"id": "jApa", "headword": "जाप", "headword_slp1": "jApa", "fold": "japa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जाप m. das Flüstern. Auch fehlerhaft für जाप्य und जप.", "gloss_language": "de"}], "synonyms": ["जापः"], "synonyms_slp1": ["jApaH"]}], "japata": [{"id": "japatA", "headword": "जपता", "headword_slp1": "japatA", "fold": "japata", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जपता f. der Zustand dessen, der nur Gebete hermurmelt. NĪLAK. fasst जपताम् (= गायत्रीमात्रसेविनाम्) als Gen. und ergänzt dazu कुले जन्म.", "gloss_language": "de"}]}], "japana": [{"id": "japana", "headword": "जपन", "headword_slp1": "japana", "fold": "japana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जपन n. das Hermurmeln von Gebeten.", "gloss_language": "de"}], "synonyms": ["जपनं"], "synonyms_slp1": ["japanaM"]}, {"id": "jApana", "headword": "जापन", "headword_slp1": "jApana", "fold": "japana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*जापन n. = निरसन und निर्वर्तन.", "gloss_language": "de"}], "synonyms": ["जापनं"], "synonyms_slp1": ["jApanaM"]}], "japaniya": [{"id": "japanIya", "headword": "जपनीय", "headword_slp1": "japanIya", "fold": "japaniya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जपनीय Adj. flüsternd herzusagen.", "gloss_language": "de"}]}], "japamala": [{"id": "japamAlA", "headword": "जपमाला", "headword_slp1": "japamAlA", "fold": "japamala", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जपमाला f. Rosenkranz.", "gloss_language": "de"}]}], "japayajYa": [{"id": "japayajYa", "headword": "जपयज्ञ", "headword_slp1": "japayajYa", "fold": "japayajYa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जपयज्ञ m. ein im Hermurmeln von Gebeten bestehendes Opfer.", "gloss_language": "de"}], "synonyms": ["जपयज्ञः"], "synonyms_slp1": ["japayajYaH"]}], "japahoma": [{"id": "japahoma", "headword": "जपहोम", "headword_