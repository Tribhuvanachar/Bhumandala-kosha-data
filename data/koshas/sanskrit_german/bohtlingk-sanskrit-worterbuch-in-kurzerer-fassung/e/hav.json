ssung", "senses": [{"gloss": "हविष्पात्र꣫ n. ein Gefäss für das Havis.", "gloss_language": "de"}]}], "havispantiya": [{"id": "havizpAntIya", "headword": "हविष्पान्तीय", "headword_slp1": "havizpAntIya", "fold": "havispantiya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हविष्पान्तीय Adj. mit हवि꣫ष्पा꣫न्तम् (ṚV. 10,88,1) beginnend.", "gloss_language": "de"}]}], "havismant": [{"id": "havizmant", "headword": "हविष्मन्त्", "headword_slp1": "havizmant", "fold": "havismant", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हवि꣫ष्मन्त्\n— 1〉 Adj.\n — a〉 der das Havis bereit hat, opferbereit, ein Darbringender.\n — b〉 von Opfergaben begleitet, Havis enthaltend.\n— 2〉 m. N. pr.\n — a〉 verschiedener Ṛṣi.\n — b〉 Pl. bestimmter Manen, Söhne der Aṅgiras.\n— 3〉 f. हविष्मती\n — a〉 Bez. der Wunderkuh Kāmadhenu.\n — b〉 N. pr. einer Tochter des Aṅgiras.", "gloss_language": "de"}], "synonyms": ["हविष्मत्"], "synonyms_slp1": ["havizmat"]}], "havisya": [{"id": "havizya", "headword": "हविष्य", "headword_slp1": "havizya", "fold": "havisya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हविष्य॑\n— 1〉 Adj.\n — a〉 zur Opfergabe geeignet, — bestimmt, — bereit; namentlich Reis, Gerste und andere Körner. In dieser Bed. auch Subst. m. n. Nach den Lexicographen n. = हविस्, घृत u. s. w.\n — b〉 dem das Havis gebührt.\n — c〉 *Adj. von 2〉.\n— 2〉 *f. हविष्या P. 4,4,122.", "gloss_language": "de"}], "synonyms": ["हविष्यं"], "synonyms_slp1": ["havizyaM"]}], "havisyantiya": [{"id": "havizyantIya", "headword": "हविष्यन्तीय", "headword_slp1": "havizyantIya", "fold": "havisyantiya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हविष्यन्तीय Adj. fehlerhaft für हविष्पान्तीय.", "gloss_language": "de"}]}], "havisyanda": [{"id": "havizyanda", "headword": "