{"arsa": [{"id": "arSa", "headword": "अर्श", "headword_slp1": "arSa", "fold": "arsa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्श und अ꣫र्शस् n. Hämorrhoiden, Pl. Hämorrhoidalknoten.", "gloss_language": "de"}], "synonyms": ["अर्शं", "अर्शः"], "synonyms_slp1": ["arSaM", "arSaH"]}, {"id": "ArSa", "headword": "आर्श", "headword_slp1": "ArSa", "fold": "arsa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "आर्श꣫ Adj. dem Antilopenbock gehörig.", "gloss_language": "de"}]}, {"id": "Arza", "headword": "आर्ष", "headword_slp1": "Arza", "fold": "arsa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई) von den Ṛṣi herrührend, sie betreffend, archaistisch. प्रत्यय ein an den Namen eines Ṛṣi gefügtes Suffix. विवाह = GAUT. 4,8.\n— 2〉 m. die von den Ṛṣi eingesetzte Heirathsweise.\n— 3〉 f. ई = संहितापाठ.\n— 4〉 n.\n — a〉 die Hymnen der Ṛṣi.\n — b〉 heilige Abstammung.\n — c〉 der Ṛṣi-Ursprung Autorschaft eines heiligen Liedes.", "gloss_language": "de"}, {"gloss": "आर्ष 3〉 f. ई eine nach der Ārṣa-Ehe verheirathete Frau VIṢṆUS. 24,31.", "gloss_language": "de"}, {"gloss": "आर्ष I. 3.", "gloss_language": "de"}], "synonyms": ["आर्षः"], "synonyms_slp1": ["ArzaH"]}], "arsas": [{"id": "arSas", "headword": "अर्शस्", "headword_slp1": "arSas", "fold": "arsas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्श und अ꣫र्शस् n. Hämorrhoiden, Pl. Hämorrhoidalknoten.", "gloss_language": "de"}]}], "arsasa": [{"id": "arSasa", "headword": "अर्शस", "headword_slp1": "arSasa", "fold": "arsasa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "अर्शस Adj. an Hämorrhoiden leidend.", "gloss_language": "de"}], "synonyms": ["अर्शसः"], "synonyms_slp1": ["arSasaH"]}], "arsasana": [{"id": "arSasAna", "headword": "अर्शसान", "headword_slp1": "arSasAna", "fold": "arsasana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "अर्शसान꣫ Adj. zu schaden suchend, boshaft.", "gloss_language": "de"}], "synonyms": ["अर्शसानः"], "synonyms_slp1": ["arSasAnaH"]}], "arsin": [{"id": "arSin", "headword": "अर्शिन्", "headword_slp1": "arSin", "fold": "arsin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्शिन् Adj. = अर्शस.", "gloss_language": "de"}]}], "arsoGna": [{"id": "arSoGna", "headword": "अर्शोघ्न", "headword_slp1": "arSoGna", "fold": "arsoGna", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. Hämorrhoiden vertreibend.\n— 2〉 *m.\n — a〉 Amorphophallus campanulatus Blume.\n — b〉 ein Theil Buttermilch mit drei Theilen Wasser.\n— 3〉 *f. ई Curculigo orchioides L.", "gloss_language": "de"}], "synonyms": ["अर्शोघ्नः"], "synonyms_slp1": ["arSoGnaH"]}], "arsoGnavalkala": [{"id": "arSoGnavalkalA", "headword": "अर्शोघ्नवल्कला", "headword_slp1": "arSoGnavalkalA", "fold": "arsoGnavalkala", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्शोघ्नवल्कला f. Zanthoxylum rhetsa^1 NIGH. PR.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}]}], "arsoyuj": [{"id": "arSoyuj", "headword": "अर्शोयुज्", "headword_slp1": "arSoyuj", "fold": "arsoyuj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्शोयुज् Adj. = अर्शस.", "gloss_language": "de"}]}], "arsovartman": [{"id": "arSovartman", "headword": "अर्शोवर्त्मन्", "headword_slp1": "arSovartman", "fold": "arsovartman", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "अर्शोवर्त्मन् etwa Gerstenkorn (am Auge).", "gloss_language": "de"}]}], "arsohita": [{"id": "arSohita", "headword": "अर्शोहित", "headword_slp1": "arSohita", "fold": "arsohita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्शोहित m. Semecarpus anacardium L.", "gloss_language": "de"}], "synonyms": ["अर्शोहितः"], "synonyms_slp1": ["arSohitaH"]}], "ars": [{"id": "arz", "headword": "अर्ष्", "headword_slp1": "arz", "fold": "ars", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √अर्ष्, अ꣫र्षति\n— 1〉 dahin schiessen.\n— 2〉 schnell fliessen, strömen.\n— 3〉 Etwas (Acc.) herbeiströmen. []\n— Mit अनु Jmd (Acc.) nachströmen.\n— Mit अभि\n— 1〉 hinströmen zu (Acc.).\n— 2〉 Etwas (Acc.) herbeiströmen.\n— Mit परि\n— 1〉 rings strömen.\n— 2〉 Etwas (Acc.)- umströmen.\n— 3〉 Etwas (Acc.) von allen Seiten herbeiströmen.\n— Mit प्र\n— 1〉 hervorströmen.\n— 2〉 Etwas (Acc.) hervorströmen.\n— Mit वि Etwas (Acc.) durchströmen.\n— Mit सम्\n— 1〉 zusammenkommen mit Jmd (Instr.)\n— 2〉 gemeinsam kommen zu (Acc.).", "gloss_language": "de"}, {"gloss": "2. √अर्ष्, ऋष꣫ति\n— 1〉 stechen, stossen.\n— 2〉 Vollstopfen, füllen MANTRABR. 1,7,5.\n— 3〉 *गतौ.\n— Mit अधि, Partic. अध्यृष्ट der auf einen Andern gestossen ist AIT. ĀR. 52,14.\n— Mit उद् aufspiessen.\n— Mit उप, उपर्षति und उपा˚ anstechen, anspiessen, stacheln.\n— Mit नि\n— 1〉 hineinstecken, — stopfen; verstecken.\n— 2〉 verstopfen, füllen.\n— Mit परि ringsum stopfen, umstecken, umfangen (zur Stütze) AIT. ĀR. 405,11. पर्यारिषन् = पर्यार्षन् TĀṆḌYA-BR. 4,5,11.\n— Mit *प्र, प्रार्षति.\n— Mit वि spiessen, durchbohren.", "gloss_language": "de"}]}], "arsaRa": [{"id": "arzaRa", "headword": "अर्षण", "headword_slp1": "arzaRa", "fold": "arsaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अर्षण und *अर्षणिन् Adj. fliessend