{"Dru": [{"id": "Dru", "headword": "ध्रु", "headword_slp1": "Dru", "fold": "Dru", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. *√ध्रु, ध्रुव꣫ति (गतिकर्मन्, गतिस्थैर्ययोः), ध्रवति (स्थैर्ये, गतौ). ध्रुवन्त् wissend, kennend BHAṬṬ. दुध्राव er tödtete ebend.", "gloss_language": "de"}, {"gloss": "2. ध्रु (metrisch) Adj. = 2. द्रुह् im Du. अ꣫स्मृतध्रू Vgl. 3. ध्रु.", "gloss_language": "de"}]}], "Drut": [{"id": "Drut", "headword": "ध्रुत्", "headword_slp1": "Drut", "fold": "Drut", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ध्रुत् Adj. in वरुणध्रु꣫त्.", "gloss_language": "de"}]}], "Druti": [{"id": "Druti", "headword": "ध्रुति", "headword_slp1": "Druti", "fold": "Druti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ध्रु꣫ति f. Verführung.", "gloss_language": "de"}], "synonyms": ["ध्रुतिः"], "synonyms_slp1": ["DrutiH"]}], "DrupadaKyanftya": [{"id": "DrupadAKyanftya", "headword": "ध्रुपदाख्यनृत्य", "headword_slp1": "DrupadAKyanftya", "fold": "DrupadaKyanftya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ध्रुपदाख्यनृत्य n. ein best. Tanz S. S. S. 272. Vgl. ध्रौपद.", "gloss_language": "de"}]}], "Druv": [{"id": "Druv", "headword": "ध्रुव्", "headword_slp1": "Druv", "fold": "Druv", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√ध्रुव्, ध्रुवति (गतिस्तैर्ययोः).", "gloss_language": "de"}]}], "Druva": [{"id": "Druva", "headword": "ध्रुव", "headword_slp1": "Druva", "fold": "Druva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ध्रुव꣫\n— 1〉 Adj. (f. आ꣫)\n — a〉 am Orte verharrend, stille haltend, bleibend bei (Loc.), feststehend, unbeweglich, bleibend, dauernd, beständig, unveränderlich. ध्रुवाणि नक्षत्राणि heissen die Mondhäuser Rohiṇī und die mit उत्तर zusammengesetzten. स्मृति f. ein festes, starkes Gedächtniss.\n — b〉 bestimmt, festgesetzt.\n — c〉 feststehend, so v. a. sicher, gewiss.\n — d〉 *= पाप. Am Ende eines Comp. einen Tadel ausdrückend.\n— 2〉 ध्रुव꣫म् Adv.\n — a〉 bleibend, für die Dauer.\n — b〉 bestimmt, sicherlich, gewiss, jedenfalls.\n— 3〉 ध्रुवाय Dat. auf die Dauer.\n— 4〉 m.\n — a〉 der Polarstern. Personificirt als ein Sohn Uttānapādaʼs.\n — b〉 Himmelspol.\n — c〉 die (unveränderliche) Länge (der Fixsterne).\n — d〉 Knoten (?).\n — e〉 *Pfahl, Pflock AK. 2,4,1,8. H. an. Med. Verz. d. Oxf. H. No. 414, Śl. 4.\n — f〉 *der indische Feigenbaum.\n — g〉 Nasenspitze (künstliche Deutung).\n — h〉 *ein best. Wasservogel.\n — i〉 der bleibende d. h. aufbewahrte Graha (welcher, Morgens geschöpft, erst Abends geopfert wird) ŚAT. BR. 4,2,3,3. 4,1. 5,1,2,19. KĀTY. ŚR. 9,5,17. VAITĀN.\n — k〉 der Eingangsvers eines Gesanges, der später immer wiederholt wird.\n — l〉 der dritte Theil einer Composition (wohl ein Allegro) S. S. S. 120.\n — m〉 Bez. der Silbe ओम्.\n — n〉 ein best. astrol. Yoga.\n — o〉 Bein.\n — α〉 *Brahmanʼs.\n — β〉 Viṣṇuʼs.\n — γ〉 Śivaʼs.\n — p〉 N. pr.\n — α〉 eines Schlangendämons. []\n — β〉 eines Vasu.\n — γ〉 verschiedener Männer.\n— 5〉 f. आ꣫\n — a〉 der grösste unter den drei Opferlöffeln.\n — b〉 *Desmodium gangeticum.\n — c〉 *Sansevieria ceylonica^1.\n — d〉 *eine tugendhafte Frau.\n — e〉 = 4〉k〉.\n— 6〉 n.\n — a〉 in der Gramm. ein nach dem tönenden Abhinidhāna eintretender Laut.\n — b〉 *Luft, Luftraum.\n — c〉 *eine Art Haus GAL.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}, {"gloss": "ध्रुव, f. आ (sc. वृत्ति) auch eine best. Art des Lebensunterhaltes BAUDH. 3,1,7. 2,7. 10.", "gloss_language": "de"}, {"gloss": "ध्रुव III. 6.", "gloss_language": "de"}], "synonyms": ["ध्रुवं", "ध्रुवः"], "synonyms_slp1": ["DruvaM", "DruvaH"]}], "Druv