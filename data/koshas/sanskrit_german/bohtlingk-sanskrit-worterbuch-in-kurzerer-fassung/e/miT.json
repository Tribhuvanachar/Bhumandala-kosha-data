{"miT": [{"id": "miT", "headword": "मिथ्", "headword_slp1": "miT", "fold": "miT", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√मिथ्, मेथति und मिथति\n— 1〉 sich zugesellen.\n— 2〉 (auf einen Nebenbuhler stossen) hart aneinander kommen, zanken, gegenreden, Jmd (Acc.) Vorwürfe machen, altercari; Med. in Streit gerathen. Nach den Lexicographen मेथति, ˚ते (मेधायाम्; हिंसायाम्, सङ्गे, वध), मेथति (संगमे).\n— Mit अभि Jmd (Acc.). zornig —, beschimpfend anreden VAITĀN.\n— Mit प्रत्यभि mit Schimpfreden antworten.", "gloss_language": "de"}]}], "miTatya": [{"id": "miTatyA", "headword": "मिथत्या", "headword_slp1": "miTatyA", "fold": "miTatya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथत्या꣫ Instr. Adv. abwechselnd oder wetteifernd. मिथति = हिंसा SĀY.", "gloss_language": "de"}]}], "miTas": [{"id": "miTas", "headword": "मिथस्", "headword_slp1": "miTas", "fold": "miTas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथ꣫स् Adv.\n— 1〉 zusammen, — mit (Instr.), gemeinschaftlich, zu —, mit einander, gegenseitig, unter einander.\n— 2〉 wechselsweise, abwechselnd, alternativ.\n— 3〉 unter einander, so v. a. unter vier Augen, im Geheimen.\n— 4〉 durch Zwiespalt BHĀG. P.", "gloss_language": "de"}]}], "miTastur": [{"id": "miTastur", "headword": "मिथस्तुर्", "headword_slp1": "miTastur", "fold": "miTastur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथस्तु꣫र् Adj. auf einander folgend, sich gegenseitig ablösend.", "gloss_language": "de"}]}], "miTaspfDya": [{"id": "miTaspfDya", "headword": "मिथस्पृध्य", "headword_slp1": "miTaspfDya", "fold": "miTaspfDya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथ[ः]स्पृ꣫ध्य Absol. unter sich wetteifernd. Nach den Erklärern Adj.", "gloss_language": "de"}]}], "miTaHspfDya": [{"id": "miTaHspfDya", "headword": "मिथःस्पृध्य", "headword_slp1": "miTaHspfDya", "fold": "miTaHspfDya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथ[ः]स्पृ꣫ध्य Absol. unter sich wetteifernd. Nach den Erklärern Adj.", "gloss_language": "de"}]}], "miTi": [{"id": "miTi", "headword": "मिथि", "headword_slp1": "miTi", "fold": "miTi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथि m. N. pr. eines Fürsten von Mithilā.", "gloss_language": "de"}], "synonyms": ["मिथिः"], "synonyms_slp1": ["miTiH"]}], "miTita": [{"id": "miTita", "headword": "मिथित", "headword_slp1": "miTita", "fold": "miTita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथित m. N. pr. eines Mannes.", "gloss_language": "de"}]}], "miTila": [{"id": "miTila", "headword": "मिथिल", "headword_slp1": "miTila", "fold": "miTila", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 N. pr.\n — α〉 Pl. eines Volkes.\n — β〉 eines Fürsten, Gründers Stadt Mithilā.\n — b〉 ein Fürst von Mithilā. Richtig मैथिल.\n— 2〉 f. आ N. pr. der Hauptstadt der Videha. मिथिलाधिपति m. Bein. Janakaʼs.", "gloss_language": "de"}], "synonyms": ["मिथिलः"], "synonyms_slp1": ["miTilaH"]}], "miTu": [{"id": "miTu", "headword": "मिथु", "headword_slp1": "miTu", "fold": "miTu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मि꣫थु und मि꣫थू Adv.\n— 1〉 abwechselnd.\n— 2〉 falsch, verkehrt.", "gloss_language": "de"}], "synonyms": ["मिथुः"], "synonyms_slp1": ["miTuH"]}, {"id": "miTU", "headword": "मिथू", "headword_slp1": "miTU", "fold": "miTu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मि꣫थु und मि꣫थू Adv.\n— 1〉 abwechselnd.\n— 2〉 falsch, verkehrt.", "gloss_language": "de"}, {"gloss": "मि꣫थू s. u. मि꣫थु.", "gloss_language": "de"}]}], "miTuna": [{"id": "miTuna", "headword": "मिथुन", "headword_slp1": "miTuna", "fold": "miTuna", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुन꣫\n— 1〉 Adj. (f. आ) gepaart, ein Paar bildend; m. Paar (ein männliches und ein weibliches Individuum), [] Paar überh. Gewöhnlich Du., Später meist n. Sg. (auch Zwillingspaar). Am Ende eines adj. Comp. f. आ.\n— 2〉 n.\n — a〉 der andere Theil, Complement.\n — b〉 Paarung, Begattung; auch Paarung im weitesten Sinne.\n — c〉 die Zwillinge im Thierkreise, überh. der dritte Bogen von 30° in einem Kreise. Auch m. GOLĀDHY. 7,28. UTPALA zu VARĀH. BṚH. 1,11.\n — d〉 eine mit einer Praeposition verbundene Wurzel.\n — e〉 Bez. bestimmter Statuetten (Pendants) am Eingange eines Tempels VARĀH. BṚH. S. 50,15.", "gloss_language": "de"}], "synonyms": ["मिथुनं", "मिथुनः"], "synonyms_slp1": ["miTunaM", "miTunaH"]}], "miTunatva": [{"id": "miTunatva", "headword": "मिथुनत्व", "headword_slp1": "miTunatva", "fold": "miTunatva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनत्व꣫ n. und मिथुनभाव m. das Gepaartsein, Bildung eines Paares.", "gloss_language": "de"}]}], "miTunaBava": [{"id": "miTunaBAva", "headword": "मिथुनभाव", "headword_slp1": "miTunaBAva", "fold": "miTunaBava", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनत्व꣫ n. und मिथुनभाव m. das Gepaartsein, Bildung eines Paares.", "gloss_language": "de"}], "synonyms": ["मिथुनभावः"], "synonyms_slp1": ["miTunaBAvaH"]}], "miTunayamaka": [{"id": "miTunayamaka", "headword": "मिथुनयमक", "headword_slp1": "miTunayamaka", "fold": "miTunayamaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनयमक n. eine best. Paronomasie. Beispiel BHAṬṬ. 10,12.", "gloss_language": "de"}]}], "miTunavratin": [{"id": "miTunavratin", "headword": "मिथुनव्रतिन्", "headword_slp1": "miTunavratin", "fold": "miTunavratin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनव्रतिन् Adj. dem Beischlaf huldigend, ihn vollführend.", "gloss_language": "de"}]}], "miTunay": [{"id": "miTunAy", "headword": "मिथुनाय्", "headword_slp1": "miTunAy", "fold": "miTunay", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*!√मिथुनाय्, ˚यते sich paaren, sich begatten.", "gloss_language": "de"}]}], "miTuni": [{"id": "miTunI", "headword": "मिथुनी", "headword_slp1": "miTunI", "fold": "miTuni", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनी꣫ Adv.\n— 1〉 mit कर\n — a〉 Paarung zu Stande bringen, — mit (Instr.), sich paaren lassen AIT. ĀR. 236,14.\n — b〉 paarweise zusammenstellen ŚAṂK. in der Einleitung zu BĀDAR. S. 10, Z. 1.\n— 2〉 mit भु und अस् sich paaren, sich begatten, — mit (Instr.). मिथुनी भुत्वा (!) GAUT.\n— 3〉 mit भु sich paarweise stellen, sich zusammenstellen mit (सह).", "gloss_language": "de"}]}], "miTunicarin": [{"id": "miTunIcArin", "headword": "मिथुनीचारिन्", "headword_slp1": "miTunIcArin", "fold": "miTunicarin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनीचारिन् Adj. sich begattend.", "gloss_language": "de"}]}], "miTuniBava": [{"id": "miTunIBAva", "headword": "मिथुनीभाव", "headword_slp1": "miTunIBAva", "fold": "miTuniBava", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मिथुनीभाव m. Begattung, — mit (Instr.).", "gloss_language": "de"}], "synonyms": ["मिथुनीभावः"], "synonyms_slp1": ["miTunIBAvaH"]}], "miTunecara": [{"id": "miTunecara", "headword": "मिथुनेचर", "hea