{"niDana": [{"id": "niDana", "headword": "निधन", "headword_slp1": "niDana", "fold": "niDana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. निध꣫न (*m.) n.\n— 1〉 das Sichfestsetzen, Aufenthalt.\n— 2〉 Aufenthaltsort, Lagerstätte, Behälter.\n— 3〉 Schluss, Ende.\n— 4〉 Tod, Vernichtung.\n— 5〉 der Schlusssatz (musik.) am Ende eines Sāman, welcher im Chor gesungen wird. Hierher vielleicht auch AV. 9,7,18.\n— 6〉 das achte astrol. Haus.\n— 7〉 *Geschlecht, Familie.\n— 8〉 *Familienhaupt.", "gloss_language": "de"}, {"gloss": "2. *निधन Adj. besitzlos, arm.", "gloss_language": "de"}], "synonyms": ["निधनं", "निधनः"], "synonyms_slp1": ["niDanaM", "niDanaH"]}, {"id": "niDAna", "headword": "निधान", "headword_slp1": "niDAna", "fold": "niDana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निधा꣫न\n— 1〉 n.\n — a〉 das Niedersetzen, Niederlegen, Einsetzen (des Feuers, eines Topfes in die Erde).\n — b〉 das Aufbewahren.\n — c〉 Ort des Niedersetzens. — Niederlegens, Behälter. Ausnahmsweise m.; am Ende eines adj. Comp. f. ई.\n — d〉 ein verborgener Schatz, Schatz überh.\n— 2〉 f. निधानी Bez. der Worte या꣫ जाता꣫ ओ꣫षधयः u. s. w. (TBR. 3,7,4,9) ĀPAST. ŚR. 1,5,5.\n— 3〉 Adj. Etwas (Gen.) in sich bergend.", "gloss_language": "de"}, {"gloss": "निधान III. 1〉d〉 Nom. abstr. ˚ता f. JĀTAKAM. 2,50.", "gloss_language": "de"}], "synonyms": ["निधानं"], "synonyms_slp1": ["niDAnaM"]}, {"id": "niDanA", "headword": "निधना", "headword_slp1": "niDanA", "fold": "niDana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निधना f. Pl. Bez. bestimmter Sprüche KAUŚ. 80,30. 41.", "gloss_language": "de"}]}], "niDanakama": [{"id": "niDanakAma", "headword": "निधनकाम", "headword_slp1": "niDanakAma", "fold": "niDanakama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "न