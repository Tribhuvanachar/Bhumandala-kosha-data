{"iqa": [{"id": "iqa", "headword": "इड", "headword_slp1": "iqa", "fold": "iqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "इड꣫ m.\n— 1〉 in einer Formel als Beiw. Agniʼs.\n— 2〉 N. pr. eines Fürsten, eines Sohnes des Kardama oder des Manu (VP.² 3,234. fg.). Auch इल.", "gloss_language": "de"}], "synonyms": ["इडः"], "synonyms_slp1": ["iqaH"]}, {"id": "iqA", "headword": "इडा", "headword_slp1": "iqA", "fold": "iqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "इ꣫डा, इळा꣫, इला\n— 1〉 Labetrank, Labung.\n— 2〉 Spende, Libation; insbes. eine feierliche Spende aus viererlei Milchstoffen, oder die durch fünfmaliges Schöpfen aus allen Havis gewonnen wird. इडानां संक्षारः Name eines Sāman.\n— 3〉 Erguss des Lobes und der Andacht, personif. als Göttin der heiligen Rede und Handlung.\n— 4〉 Rede überh.\n— 5〉 die Erde MBH. 3,114,28 (= यज्ञा Comm.). 236,10.\n— 6〉 Kuh.\n— 7〉 eine best. Arterie auf der linken Seite des Körpers.\n— 8〉 *der Himmel.\n— 9〉 Bein. der Durgā.\n— 10〉 N. pr.\n — a〉 einer Tochter Manuʼs oder auch Mitra-Varuṇaʼs.\n — b〉 einer Tochter Dakṣaʼs und Gattin Kaśyapaʼs. इरा v. l.\n — c〉 einer Gattin Vasudevaʼs BHĀG. P. 9,24,44.\n — d〉 इड, इल 2〉 als Weib.", "gloss_language": "de"}]}, {"id": "IqA", "headword": "ईडा", "headword_slp1": "IqA", "fold": "iqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "2. ई꣫ड् und *ईडा f. Preis, Lob.", "gloss_language": "de"}]}], "iqaprajas": [{"id": "iqaprajas", "headword": "इडप्रजस्", "headword_slp1": "iqaprajas", "fold": "iqaprajas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "इ꣫डप्रजस् f. Pl. = इडाप्रजस् MAITR. S. 1,5,3.", "gloss_language": "de"}]}, {"id": "iqAprajas", "headword": "इडाप्रजस्", "headword_slp1": "iqAprajas", "fold": "iqaprajas", "headword_language": "sa", "sou