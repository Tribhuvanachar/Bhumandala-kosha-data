{"Gar": [{"id": "Gar", "headword": "घर्", "headword_slp1": "Gar", "fold": "Gar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √घर्, जि꣫घर्ति, *घरति besprengen, beträufeln. *घृत besprengt.\n— *Caus. घारयति dass.\n— Mit अभि, अभि꣫घृत\n— 1〉 gesprengt.\n— 2〉 besprengt.\n— Caus. अभिघारयत्नि\n— 1〉 abtriefen lassen, sprengen.\n— 2〉 beträufeln, besprengen.\n— Mit प्रत्यभि Caus. wiederholt besprengen.\n— Mit आ\n— 1〉 sprengen gegen oder nach (Acc.)\n— 2〉 schnellen nach (Loc.).\n— Caus. sprengen.\n— Mit *प्रा in *प्राघार.\n— Mit व्या Caus.\n— 1〉 umhersprengen.\n— 2〉 besprengen.\n— Mit वि, वि꣫घृत beträufelt.", "gloss_language": "de"}, {"gloss": "2. *√घर्, जिघर्ति (दीप्तौ). घृत brennend, leuchtend.\n— Caus. घारयति (छादने).", "gloss_language": "de"}, {"gloss": "1. √घर् mit अभ्या in पुनरभ्याघारम्.", "gloss_language": "de"}, {"gloss": "1. √घर् mit अभ्या 2.", "gloss_language": "de"}]}], "Garawa": [{"id": "Garawwa", "headword": "घरट्ट", "headword_slp1": "Garawwa", "fold": "Garawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "घरट्ट m. Handmühle Ind. St. 15,455. RĀJAT. 7,1244. 1303. 1589. ĀRYAV. 141,5.", "gloss_language": "de"}], "synonyms": ["घरट्टः"], "synonyms_slp1": ["GarawwaH"]}], "Garawaka": [{"id": "Garawwaka", "headword": "घरट्टक", "headword_slp1": "Garawwaka", "fold": "Garawaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "घरट्टक m. (HEM. PAR. 2,365) und *घरट्टिका f. (DEŚĪN. 3,10) dass.", "gloss_language": "de"}]}], "Garawika": [{"id": "GarawwikA", "headword": "घरट्टिका", "headword_slp1": "GarawwikA", "fold": "Garawika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "घरट्टक m. (HEM. PAR. 2,365) und *घरट्टिका f. (DEŚĪN. 3,10) dass.", "gloss_language": "de"}]}], "GarGawa": [{"id": "GarGawa", "headword": "घर्घट", "