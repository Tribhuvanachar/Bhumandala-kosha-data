{"sarpaRa": [{"id": "SarpaRA", "headword": "शर्पणा", "headword_slp1": "SarpaRA", "fold": "sarpaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*शर्पणा f. gaṇa मध्वादि in der KĀŚ. v. l. शर्याण.", "gloss_language": "de"}]}, {"id": "sarpaRa", "headword": "सर्पण", "headword_slp1": "sarpaRa", "fold": "sarpaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सर्पण n.\n— 1〉 das Schleichen, Sichhinbewegen, langsame Fortbewegung.\n— 2〉 im Ritual das Leisegehen u. s. w. VAITĀN.", "gloss_language": "de"}], "synonyms": ["सर्पणं", "सर्प्पण"], "synonyms_slp1": ["sarpaRaM", "sarppaRa"]}], "sarpaRavant": [{"id": "SarpaRAvant", "headword": "शर्पणावन्त्", "headword_slp1": "SarpaRAvant", "fold": "sarpaRavant", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*शर्पणावन्त् Adj. von शर्पणा ebend. Vgl. शर्यणावन्त्.", "gloss_language": "de"}], "synonyms": ["शर्पणावत्"], "synonyms_slp1": ["SarpaRAvat"]}], "sarp": [{"id": "sarp", "headword": "सर्प्", "headword_slp1": "sarp", "fold": "sarp", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√सर्प्, स꣫र्पति (metrisch auch Med.)\n— 1〉 schleichen, schleifen, gleiten, kriechen, schlüpfen in (Acc.); überh. von leiser und vorsichtiger Fortbewegung (auch von Unbelebtem, z. B. 80,12). सर्पत auch so v. a. begebt euch fort, ziehet ab. स꣫र्पन्त् als n. das Kriechende यथाहिःसप्सर्यन् AIT. ĀR. 409,18. fg. सृ꣫प्त (!) herausgeschlüpft aus (Abl.) hineingeschlüpft in (Loc.).\n— 2〉 im Ritual geräuschlos und in gebückter Stellung, gegenseitig sich anfassend, wegschleichen (namentlich aus dem Sadas nach dem Bahiṣpavamāna).\n— Caus. सर्पयति, Simplex nicht zu belegen.\n— Desid. सि꣫सृप्सति, Simplex nicht zu belegen.\n— Intens. सरीसृप्यते hinundher Schleichen AIT. ĀR. 78,10 Partic. [] मरीसृपतौ kriechend, schleichend.\n— Mit अति hingleiten, hinkriechen über oder an, sich hinausstehlen, über; mit Acc. Auch von Flüssigem.\n— Mit व्यति hinundher fliegen (von Pfeilen).\n— Mit अधि hinübergleiten über (Acc.).\n— Mit समधि dass.\n— Mit अनु\n— 1〉 nachschleichen, nachgehen; mit Acc.\n— 2〉 entlang kriechen.\n— 3〉 sich nähern, heraustreten an (Acc.).\n— Mit समनु herantreten, sich nähern.\n— Mit अप\n— 1〉 sich fortbegeben, zurücktreten, weichen.\n— 2〉 beschleichen, so v. a. belauschen, aushorchen.\n— Caus. in अपस्र्प्य Nachtr. 6.\n— Mit प्रत्यप Caus. zum Zurückweichen zwingen.\n— Mit व्यप sich fortbegeben, sich entfernen, sich auf und davon machen.\n— Mit अभि schleichend —, leise u. s. w. sich nahen; mit Acc.\n— Mit अव\n— 1〉 hinuntergleiten (von der zum Untergang sich neigenden Sonne), zurückweichen (vom Meere) MBH. 13,155,26. काले ऽवसर्पति so v. a. अवसर्पिण्याम्.\n— 2〉 beschleichen.\n— 3〉 allmählich überziehen.\n— Caus. zurückzuweichen veranlassen.\n— Mit अन्वव nachschleichen, nachfolgen.\n— Mit उपाव herbeischleichen.\n— Mit पर्यव dass.\n— Mit प्रत्यव dass.\n— Mit व्यव sich einschleichen in (Acc.).\n— Mit आ herbeischleichen.\n— Mit उदा in अर्बुदोदार्पणी.\n— Mit उपोदा hervorkriechen aus (einer Höhle) 21,12. उपोदा꣫सृप्त ausgekrochen.\n— Mit समा, समा꣫सृप्त der sich verkriechen hat MAITR. S. 3,9,5 (121,14).\n— Mit उद्\n— 1〉 hervorkriechen, sich erheben, sich aufrichten von (Abl.), sich erheben auf oder über (Acc.). करो मुखत्ससर्प die Hand erhob sich zum Munde KĀD. 215,21 (358,6). उत्सृप्य aufwärts gleitend (mit der Hand) GOBH. 2,10,29.\n— 2〉 sich erheben, so v. a. höher werden.\n— 3〉 in die Höhe gelangen, eine hohe Stellung erlangen.\n— 4〉 sich überheben.\n— 5〉 hervorgehen, entstehen aus (Abl.) oder in (Loc.)\n— 6〉 sich langsam fortbewegen.\n— 7〉 उत्सृप्त heraufgekommen, aufgegangen (von der Sonne).\n— Caus. aufsteigen lassen.\n— Desid. sich zu erheben wünschen, — in (Acc.).\n— Mit प्रोद् aus den Fugen kommen.\n— Mit ˚व्युद् sich herausbewegen.\n— Mit समुद्\n— 1〉 sich erheben bis — his, mit Acc.\n— 2〉 einbrechen, beginnen (von der Finsterniss).\n— Mit उप\n— 1〉 hinschleichen zu, sich verkriechen in (Acc.).\n— 2〉 beschleichen, sich sachte heranmachen.\n— 3〉 Jmd belauschen, ausforschen.\n— 4〉 herantreten, sich nähern, sich hinbegeben zu (Acc., Gen. [der Person] oder तत्र), nach einer bestimmten Richtung hin gehen.\n— 5〉 sich eine, Weibe (Acc.) geschlechtlich nähern.\n— 6〉 sich bewegen, ziehen (von Wolken), langsam herankommen [] (von Unbelebtem).\n— 7〉 gerathen in. प्रलयम् so v. a. zu Grunde gehen.\n— 8〉 an Etwas gehen, beginnen; mit Infin. उपसृप्त woran Jmd (im Comp. vorangehend) gegangen ist.\n— Caus.\n— 1〉 kommen lassen zu (Loc.). कर्मणीदृशे मतिम् KĀD. 203,3 (339,13).\n— 2〉 = उद् 4〉. Vielleicht fehlerhaft.\n— Mit समुप herantreten zu (Acc.) sich nähren BĀLAR. 207,15.\n— Mit विनि ĀŚV. ŚR. 6,12,2 (in der gedr. Ausg.) fehlerhaft für विनिस्\n— Mit निस्\n— 1〉 hinausschleichen.\n— 2〉 ausziehen, sich in Bewegung setzen.\n— Mit अभिनिस् sich hinbewegen zu (Acc.).\n— Mit विनिस् hinausschleichen.\n— Mit परि\n— 1〉 umschleichen, sich umherbewegen um (Acc.). umherkriechen auf (Acc.), umherstreichen.\n— 2〉 in Jmds Nähe sich aufhalten, Jmd aufsuchen. Vgl. अकृमिपरिसृप्त Nachtr. 2.\n— Caus. परिसर्पित etwa worauf Ungeziefer herumgekrochen ist CARAKA. 1,26.\n— Mit प्र\n— 1〉 hin-, hineinschleichen, — in (Acc.), beschleichen, schliefen in.\n— 2〉 sich in Bewegung setzen, hinbewegen, — zu (Acc.) VAITĀN.\n— 3〉 hervorbrechen, hervorströmen ŚIŚ. 12,29. 19,77.\n— 4〉 anbrechen, (von der Finsterniss).\n— 5〉 sich verbreiten. प्रसृप्त verbreitet.\n— 6〉 zu Werke gehen, verfahren.\n— 7〉 in einer best. Weise fortfahren.\n— 8〉 fortfahren, so v. a. von Statten gehen.\n— Caus. प्रसर्पित hinschleichen.\n— Mit अनुप्र herzu —, nachschleichen. अनुप्र꣫सृप्त nachschleichend, mit Acc.\n— Mit अभिप्र\n— 1〉 herbeischleichen.\n— 2〉 अभिप्रसृप्त sich hinbegeben habend zu (Acc.) VAITĀN.\n— Mit प्रतिप्र wieder herbeischleichen.\n— Mit विप्र hinundher schleichen, sich hinundher bewegen.\n— Mit संप्र hin-, hineinschlüpfen MBH. 5,110,6.\n— Mit वि\n— 1〉 umherschleichen, einherschleichen, einhergehen, sich hinbewegen (auch von Unbelebtem), — zu (Dat. VAITĀN.). पन्था꣫म् den Weg entlang.\n— 2〉 auseinandergehen, sich zerstreuen.\n— 3〉 sich ausbreiten, sich verbreiten (ŚIŚ. 11,34), — über (Acc.).\n— 4〉 verbreiten, ausbreiten.\n— Caus. verbreiten, ausbreiten.\n— Mit अनुवि sich ausbreiten BHĀVAPR. 2,164.\n— Mit सम्\n— 1〉 sich hin —, hineinschleichen in (Acc.).\n— 2〉 zusammen gehen.\n— 3〉 einherziehen, sich bewegen.\n— 4〉 zu Jmd (Acc.) herantreten.\n— 5〉 sich entfernen von (Abl.) ĀPAST. 1,6,32.\n— Mit अनुसम् nachschleichen.\n— Mit उपसम् sich hinschleichen zu (Acc.).\n— Mit विसम् in तिर्यग्विसंसर्पिन्.", "gloss_language": "de"}, {"gloss": "√सर्प् mit उद् Caus. उत्सर्पित ? DIVYĀVAD. 23,11. fgg.", "gloss_language": "de"}]}], "sarpa": [{"id": "sarpa", "headword": "सर्प", "headword_slp1": "sarpa", "fold": "sarpa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सर्प꣫\n— 1〉 Adj. (f. ई) schleichend, kriechend GAUT. 8,2. Vgl. पीठसर्प und वृक्षसर्प꣫\n— 2〉 m.\n — a〉 Schlange, Natter. Am Ende eines adj. Comp. f. आ\n — b〉 Bez. best. übermenschlicher Wesen (neben Gandharva und ähnlichen Geschlechtern) [] auf Erden, in der Luft, im Himmel und in der Unterwelt. सर्पाणमयनम् eine best. Jahresfeier.\n — c〉 eine best. Constellation, wenn nämlich nur drei ungünstigen Planeten in den drei Kendra stehen.\n — d〉 Mesua roxburghii.\n — e〉 N. pr.\n — α〉 eines der 11 Rudra.\n — β〉 eines Rākṣasa VP. 22,285. 288. 293.\n— 3〉 f. सर्पी Schlangenweibchen.\n— 4〉 n. Name eines Sāman; vgl. सर्पसामन्.", "gloss_language": "de"}], "synonyms": ["सर्पः"], "synonyms_slp1": ["sarpaH"]}, {"id": "sArpa", "headword": "सार्प", "headword_slp1": "sArpa", "fold": "sarpa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. zu den Schlangen (Schlangendämonen) in Beziehung stehend. ˚भ n. = 2〉.\n— 2〉 (*f. ई) n. das unter den Schlangen stehende Mondhaus Aśleṣā VARĀH. YOGAY. 7,5. 9,7.", "gloss_language": "de"}], "synonyms": ["सार्पः", "सार्प्प"], "synonyms_slp1": ["sArpaH", "sArppa"]}], "sarpafsi": [{"id": "sarpafzi", "headword": "सर्पऋषि", "headword_slp1": "sarpafzi", "fold": "sarpafsi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सर्पऋषि m. Schlangen-Ṛṣi.", "gloss_language": "de"}]}], "sarpakaNkalika": [{"id": "sarpakaNkAlikA", "headword": "सर्पकङ्कालिका", "headword_slp1": "sarpakaNkAlikA", "fold": "sarpakaNkalika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*सर्पकङ्कालिका f. und ˚कङ्काली f. eine best. gegen Schlangengift angewandte Pflanze.", "gloss_language": "de"}]}], "sarpakaNkali": [{"id": "sarpakaNkAlI", "headword": "सर्पकङ्काली", "headword_slp1": "sarpakaNkAlI", "fold": "sarpakaNkali", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*सर्पकङ्कालिका f. und ˚कङ्काली f. eine best. gegen Schlangengift angewandte Pflanze.", "gloss_language": "de"}]}], "sarpakowara": [{"id": "sarpakowara", "headword": "सर्पकोटर", "headword_slp1": "sarpakowara", "fold": "sarpakowara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सर्पकोटर n. Schlangenhöhle PAÑCAT. 53,4.", "gloss_language": "de"}]}], "sarpagati": [{"id": "sarpagati", "headword": "सर्पगति", "headword_slp1": "sarpagati", "fold": "sarpagati", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सर्पगति f. Schlangengang, Schlangenwindung (bei Kämpfern).", "gloss_language": "de"}], "synonyms": ["सर्पगतिः"], "synonyms_slp1": ["sarpagatiH"]}], "sarpaganDa": [{"id": "sarpaganDA", "headword": "सर्पगन्धा", "headword_slp1": "sarpaganDA", "fold": "sarpaganDa", "headword_language": "sa", "source": "boht