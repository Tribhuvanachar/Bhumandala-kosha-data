{"Endava": [{"id": "Endava", "headword": "ऐन्दव", "headword_slp1": "Endava", "fold": "Endava", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई) lunaris.\n— 2〉 m. der Planet Mercur.\n— 3〉 *f. ई Serratula anthelmintica^1 RĀJAN. 4,64.\n— 4〉 n.\n — a〉 das Mondhaus Mṛgaśiras.\n — b〉 eine best. Kasteiung, = चान्द्रायण PARĀŚ. 4,12,6.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}], "synonyms": ["ऐंदव", "ऐन्दवं", "ऐन्दवः"], "synonyms_slp1": ["EMdava", "EndavaM", "EndavaH"]}], "Endumateya": [{"id": "Endumateya", "headword": "ऐन्दुमतेय", "headword_slp1": "Endumateya", "fold": "Endumateya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ऐन्दुमतेय m. Metron. Daśarathaʼs BĀLAR. 268,18.", "gloss_language": "de"}], "synonyms": ["ऐन्दुमतेयः"], "synonyms_slp1": ["EndumateyaH"]}], "EnduseKara": [{"id": "EnduSeKara", "headword": "ऐन्दुशेखर", "headword_slp1": "EnduSeKara", "fold": "EnduseKara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. dem Śiva gehörig BĀLAR. 22,10. 78,9.\n— 2〉 n. die Geschichte, wie der Mond zu Śivaʼs Diadem wurde, BĀLAR. 29,15.", "gloss_language": "de"}]}], "Endra": [{"id": "Endra", "headword": "ऐन्द्र", "headword_slp1": "Endra", "fold": "Endra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ऐन्द्र꣫\n— 1〉 Adj. (f. ई) dem Indra gehörig, ihm geweiht, von ihm ausgehend u. s. w. अम्बु, जल, तोय Regenwasser CARAKA. 1,27. 6,30. कार्मुक, धनुस् Regenbogen. दिश् Osten.\n— 2〉 m. der für Indra bestimmte Opfertheil.\n— 3〉 f. ई꣫\n — a〉 ein an Indra gerichteter Vers.\n — b〉 Osten.\n — c〉 *das Mondhaus Jyeṣṭhā.\n — d〉 der 8te Tag in der dunkelen Hälfte des Monats Mārgaśīrṣa (oder Pauṣa).\n — e〉 Indraʼs Energie, personif. als seine Gattin. Auf die Durgā übertragen MĀRK. P. 88,34.\n — f〉 *böses Geschick.\n — g〉 Koloquinthengurke BHĀVAPR. 1,141. CARAKA. 6,27.\n — h〉 *Kardamomen.\n— 4〉 n.\n — a〉 das Mondhaus Jyeṣṭhā.\n — b〉 *wilder Ingwer.\n — c〉 Name verschiedener Sāman.\n — d〉 N. pr. eines Gebets in Bhāratavarṣa VP.² 2,112.", "gloss_language": "de"}], "synonyms": ["ऐंद्र", "ऐन्द्रं", "ऐन्द्रः"], "synonyms_slp1": ["EMdra", "EndraM", "EndraH"]}], "Endrajala": [{"id": "EndrajAla", "headword": "ऐन्द्रजाल", "headword_slp1": "EndrajAla", "fold": "Endrajala", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ऐन्द्रजाल n. Zauberei.", "gloss_language": "de"}]}], "Endrajali": [{"id": "EndrajAli", "headword": "ऐन्द्रजालि", "headword_slp1": "EndrajAli", "fold": "Endrajali", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ऐन्द्रजालि m. Zauberer Ind. St. 15,428.", "gloss_language": "de"}]}], "Endrajalika": [{"id": "EndrajAlika", "headword": "ऐन्द्रजालिक", "headword_slp1": "EndrajAlika", "fold": "Endrajalika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई) mit Zauberei sich abgebend, auf Z. bezüglich.\n— 2〉 m. Zauberer, Gaukler 321,23. UTPALA. zu VARĀH. BṚH. 18,5.", "gloss_language": "de"}], "synonyms": ["ऐंद्रजालिक", "ऐन्द्रजालिकः"], "synonyms_slp1": ["EMdrajAlika", "EndrajAlikaH"]}], "Endrajalya": [{"id": "EndrajAlya", "headword": "ऐन्द्रजाल्य", "headword_slp1": "EndrajAlya", "fold": "Endrajalya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*ऐन्द्रजाल्य m. Patron. von इन्द्रजालि gaṇa कुर्वादि in der KĀŚ.", "gloss_language": "de"}]}], "Endraturiya": [{"id": "EndraturIya", "headword": "ऐन्द्रतुरीय", "headword_slp1": "EndraturIya", "fold": "Endraturiya", "headword_language": "sa", "source": "b