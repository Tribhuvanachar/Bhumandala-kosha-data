{"damB": [{"id": "damB", "headword": "दम्भ्", "headword_slp1": "damB", "fold": "damB", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √दभ्, √दम्भ्, द꣫भति, दभ्नो꣫ति\n— 1〉 Jmd Etwas anhaben, anthun, beschädigen, versehren, benachtheiligen, verletzen. Pass. Schaden nehmen.\n— 2〉 täuschen, im Stich lassen, hintergehen.\n— 3〉 *दम्नोति = गतिकर्मन्.\n— Caus. दम्भ꣫यति, ˚ते abwenden, niederschlagen.\n— Desid. दि꣫प्सति. *धिप्सति, *धीप्सति und *दिदम्भिषति Jmd Etwas anhaben —, Schaden zufügen —, verderben wollen.\n— Mit अभि Desid. in अभिदिप्सु꣫.\n— Mit आ = Simpl. 1〉.\n— Mit उप Caus. Schmälern, zu Nichte machen.", "gloss_language": "de"}, {"gloss": "2. *√दभ्, *√दम्भ्, दाभयति und दम्भयति (नोदे), दम्भयते (संघाते).", "gloss_language": "de"}, {"gloss": "√दम्भ् s. √दभ्.", "gloss_language": "de"}], "synonyms": ["दंभ्"], "synonyms_slp1": ["daMB"]}], "dam": [{"id": "dam", "headword": "दम्", "headword_slp1": "dam", "fold": "dam", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √दम्, दा꣫म्यति\n— 1〉 zahm —, sanft sein. दान्त꣫ gezähmt, zahm, sanft, in seinen Leidenschaften gezügelt.\n— 2〉 zähmen, bändigen, bezwingen.\n— Caus. दम꣫यति bezwingen, bewältigen. दमित gezähmt, bezwungen.\n— Mit आ nach ṚV. 6,3,7. wo aber दंउसुपत्नी zu lesen ist.\n— Mit उद्, उद्दम्य MBH. 12,6595 fehlerhaft für उद्यम्य.\n— Mit प्र Caus., bezwingen, überwältigen BHAṬṬ.", "gloss_language": "de"}, {"gloss": "2. द꣫म् Haus. Nur Gen. Pl. दमा꣫म्. könnte auch auf 1. दम꣫ zurückgeführt werden.", "gloss_language": "de"}]}], "dama": [{"id": "dama", "headword": "दम", "headword_slp1": "dama", "fold": "dama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. दम꣫ m. oder n. Haus, Wohnung, Heimat.", "gloss_language": "de"}, {"gloss": "2. दम꣫\n— 1〉 Adj. am Ende eines Comp. bändigend, bewältigend.\n— 2〉 m.\n — a〉 Selbstzähmung, Selbstbeherrschung.\n — b〉 *das Zähmen, Bändigen.\n — c〉 Züchtigung, Strafe, insbes. Geldbusse.\n — d〉 N. pr. eines Bruders der Damayantī und verschiedener anderer Personen.", "gloss_language": "de"}], "synonyms": ["दमः"], "synonyms_slp1": ["damaH"]}, {"id": "dAma", "headword": "दाम", "headword_slp1": "dAma", "fold": "dama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दाम n., दामा꣫ f. und दामक n. (KĀD. 94,21) Band, Schnur, Guirlande. Am Ende eines adj. Comp. f. आ. — S. auch दामा.", "gloss_language": "de"}]}, {"id": "dAmA", "headword": "दामा", "headword_slp1": "dAmA", "fold": "dama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दाम n., दामा꣫ f. und दामक n. (KĀD. 94,21) Band, Schnur, Guirlande. Am Ende eines adj. Comp. f. आ. — S. auch दामा.", "gloss_language": "de"}, {"gloss": "दामा f. N. pr. einer der Mütter im Gefolge Skandaʼs MBH. 9,46,5. — S. auch u. 1. दाम.", "gloss_language": "de"}]}], "damaka": [{"id": "damaka", "headword": "दमक", "headword_slp1": "damaka", "fold": "damaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚दमक Adj. zähmend, bändigend.", "gloss_language": "de"}], "synonyms": ["दमकः"], "synonyms_slp1": ["damakaH"]}, {"id": "dAmaka", "headword": "दामक", "headword_slp1": "dAmaka", "fold": "damaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दाम n., दामा꣫ f. und दामक n. (KĀD. 94,21) Band, Schnur, Guirlande. Am Ende eines adj. Comp. f. आ. — S. auch दामा.", "gloss_language": "de"}]}], "damaGosa": [{"id": "damaGoza", "headword": "दमघोष", "headword_slp1": "damaGoza", "fold": "damaGosa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दमघोष m. N. pr. eines Fürsten.", "gloss_language": "de"}], "synonyms": ["दमघोषः"], "synonyms_slp1": ["damaG