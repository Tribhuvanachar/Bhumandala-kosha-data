{"gur": [{"id": "gur", "headword": "गुर्", "headword_slp1": "gur", "fold": "gur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√गुर्, गुर꣫ते (ausnahmsweise auch Act., insbes. im ved. Perfect.) *aufheben. Vom Simplex nur ved. Partic. गूर्त꣫ (gebilligt, willkommen, angenehm, gratus.)\n— *Caus. गोरयते (उद्यमने, भक्षणे).\n— Mit अति aufschreien.\n— Mit अप zurückweisen, Missbilligung aussprechen, bedrohen, schmähen.\n— Mit अभि zustimmen, billigen, Beifall bezeigen; mit Acc. अभि꣫गूर्त mit beifälligem Zuruf begleitet.\n— Mit अव mit Drohungen auf Jmd (Loc. oder Dat.) losfahren NYĀYAM. 3,4,18 und Cit. im Comm. dazu. Absol. अवगूर्य auch M. 4,165 zu lesen mit Hdschrr. und MEDHĀT. *Partic. अवगूर्ण.\n— Mit आ Beifall bezeigen, billigen; zusagen, einwilligen; mit Acc. Ohne Obj. die आगुर् aussprechen.\n— Mit उद्\n— 1〉 [] drohend die Stimme erheben.\n— 2〉 aufheben. Verbum fin. nur BHAṬṬ. उद्गूर्ण aufgehoben VEṆĪS. 171. Ind. St. 13,489, N. 2.\n— Mit प्र hinaus rufen.", "gloss_language": "de"}, {"gloss": "√गुर् mit आ II. आगूर्ण unter Drohungen aufgehoben (परश्वध) JĀTAKAM. 9,40.", "gloss_language": "de"}]}, {"id": "gUr", "headword": "गूर्", "headword_slp1": "gUr", "fold": "gur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√गूर्, गूर्यते (हिंसागत्योः), गूरयते (उद्यमने, भक्षणे).", "gloss_language": "de"}]}], "guraRa": [{"id": "guraRa", "headword": "गुरण", "headword_slp1": "guraRa", "fold": "guraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*गुरण n. das Aufheben.", "gloss_language": "de"}], "synonyms": ["गुरणं"], "synonyms_slp1": ["guraRaM"]}, {"id": "gUraRa", "headword": "गूरण", "headword_slp1": "gUraRa", "fold": "guraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "गूरण n.\n— 1〉 Vorwurf, Tadel RĀJAT. 7,1605.\n— 2〉 *= 