{"hetar": [{"id": "hetar", "headword": "हेतर्", "headword_slp1": "hetar", "fold": "hetar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हे꣫तर् und हेत꣫र् Nom. ag. Treiber.", "gloss_language": "de"}, {"gloss": "हे꣫तर् und हेत꣫र् Nom. ag. Treiber.", "gloss_language": "de"}]}], "heti": [{"id": "heti", "headword": "हेति", "headword_slp1": "heti", "fold": "heti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेति꣫\n— 1〉 m. (nur in der der späteren Sprache) und f.\n — a〉 Geschoss, Waffe überh. ŚIŚ. 9,15. 18,12.\n — b〉 Agniʼs Waffe, so v. a. Flamme ŚIŚ. 14,25. 20,60. []\n — c〉 *Sonnenstrahl.\n — d〉 Schuss, so v. a. pfeilschnelle Bewegung, Anprall (der Sehne).\n — e〉 Werkzeug.\n — f〉 *ein junger Schoss.\n— 2〉 m. N. pr.\n — a〉 eines Rākṣasa.\n — b〉 eines Asura.", "gloss_language": "de"}], "synonyms": ["हेतिः"], "synonyms_slp1": ["hetiH"]}], "hetika": [{"id": "hetika", "headword": "हेतिक", "headword_slp1": "hetika", "fold": "hetika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेतिक am Ende eines adj. Comp. = हेति 1〉a〉.", "gloss_language": "de"}]}], "hetita": [{"id": "hetitA", "headword": "हेतिता", "headword_slp1": "hetitA", "fold": "hetita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेतिता f. Nom. abstr. zu हेति 1〉a〉.", "gloss_language": "de"}]}], "hetimant": [{"id": "hetimant", "headword": "हेतिमन्त्", "headword_slp1": "hetimant", "fold": "hetimant", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेतिम꣫न्त् Adj. mit einem Geschoss versehen.", "gloss_language": "de"}], "synonyms": ["हेतिमत्"], "synonyms_slp1": ["hetimat"]}], "hetimantra": [{"id": "hetimantra", "headword": "हेतिमन्त्र", "headword_slp1": "hetimantra", "fold": "hetimantra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेतिमन्त्र m. Bez. eines best. Spruches.", "gloss_language": "de"}]}], "hetu": [{"id": "hetu", "headword": "हेतु", "headword_slp1": "hetu", "fold": "hetu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेतु꣫ m.\n— 1〉 wer oder was Etwas veranlasst, — bewirkt, Veranlassung, Ursache, — von (Gen., Dat., Loc. oder im Comp. vorangehend). न शराः स्तम्भहेतवः so v. a. die Pfeile sind nicht dazu da um den (Köcher) vollzustopfen. हेतोस् (Abl., Gen.), हेतुना, हेतवे, हेतौ und *हेतु꣫म् einer Ursache wegen, in Veranlassung von Etwas, um — Willen, wegen; die Ergänzung im Gen. oder im Comp. vorangehend. Angeblich sagt man auch को हेतुर्वसति in der Bed. von weshalb. Am Ende eines adj. Comp. — zur Ursache habend, bewirkt durch —; angetrieben, angelockt durch —,\n— 2〉 Grund, Argument, Beweis. In der Logik auch Bez. des 2ten Theils im Syllogismus.\n— 3〉 Mittel. Instr. am Ende eines Comp. so v. a. vermittelst, durch.\n— 4〉 Preis, pretium.\n— 5〉 Bedingung 160,23.\n— 6〉 Art und Weise.\n— 7〉 bei den Grammatikern der Agens des causativen verbums.\n— 8〉 bei den Buddhisten Grundursache, Hauptursache im Gegensatz zu प्रत्यय eine hinzukommende Ursache.\n— 9〉 bei den Pāśupata das was das Gebundensein der Seele bewirkt, die Natur, die Sinnenwelt.\n— 10〉 im Drama eine kurze Rede, welche die zur Erreichung eines Zieles erforderlichen Bedingungen angiebt.", "gloss_language": "de"}], "synonyms": ["हेतुः"], "synonyms_slp1": ["hetuH"]}, {"id": "hetU", "headword": "हेतू", "headword_slp1": "hetU", "fold": "hetu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हेतू Adv. mit कर् zur Ursache machen, als U. annehmen.", "gloss_language": "de"}]}], "hetuka": [{"id": "hetuka", "headword": "हेतुक", "headword_slp1": "hetuka", "fold": "hetuka", "headword_language": "sa", "source": "b