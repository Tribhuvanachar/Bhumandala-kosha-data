{"vam": [{"id": "vam", "headword": "वम्", "headword_slp1": "vam", "fold": "vam", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √वम्, व꣫मति, *वमिति erbrechen, ausspeien; von sich geben, entlassen. व꣫चः ein Wort ausspeien, so v. a. von sich thun wollen, bereuen. बलम् so v. a. die Kraft verlieren CARAKA. 5,12. वान्त\n— 1〉 ausgebrochen, ausgespien; was man von sich gegeben —, entlassen hat. वान्ते wenn man vomirt hat.\n— 2〉 der vomirt hat.\n— Caus. वामयति und वमयति ausspeien machen, Erbrechen bewirken. वमित den man hat vomiren lassen CARAKA. 6,3.\n— Mit अभि bespeien, anspeien.\n— Mit आ scheinbar HARIV. 15919, da hier अवमत् st. आवमत् zu lesen ist.\n— Mit उद्\n— 1〉 ausbrechen, ausspeien; Etwas von sich geben, entlassen 321,7. उद्वान्त und *उद्वमित ausgespien, erbrochen.\n— 2〉 von sich geben, so v. a. anstellen, vollbringen.\n— Mit समुद्, समुद्वान्त übergelaufen beim Kochen GOP. BR. 1,3,11. VAITĀN.\n— Mit निस् ausspeien, auswerfen.\n— Mit विनिस् dass.\n— Mit परा wegspeien.", "gloss_language": "de"}, {"gloss": "2. √वम् 1. Sg. Imperf. von 1. वर्. Nach BENFEY. (Gött. Nachr. 1880, No. 5) aus व्रम् entstanden.", "gloss_language": "de"}, {"gloss": "1. √वम् mit उद् VI. mit intransit. Bed. = उद्-सर्य् KIR. 9,27.", "gloss_language": "de"}]}, {"id": "vAm", "headword": "वाम्", "headword_slp1": "vAm", "fold": "vam", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √वाम् Acc., Dat. und Gen. Du. der Pronomens der 2ten Person.", "gloss_language": "de"}, {"gloss": "2. वा꣫म् vielleicht Nom. Du. = आवाम् wir beide.", "gloss_language": "de"}]}], "vama": [{"id": "vama", "headword": "वम", "headword_slp1": "vama", "fold": "vama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वम m. = वाम.", "gloss_language": "de"}], "synonyms": ["वमः"], "synonyms_slp1": ["vamaH"]}, {"id": "vAma", "headword": "वाम", "headword_slp1": "vAma", "fold": "vama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वाम꣫\n— 1〉 Adj. (f. ई꣫ und आ)\n — a〉 werth, lieb; gefällig, gut, schön.\n — b〉 schön, edel.\n — c〉 am Ende eines Comp. zugethan, strebend nach, versessen auf, lüstern nach Etwas.\n— 2〉 m.\n — a〉 *die weibliche Brust.\n — b〉 *der Liebesgott.\n — c〉 Bein. Śivaʼs. Bei den Śaiva eine der fünf Formen ihres Gottes.\n — d〉 N. pr.\n — α〉 eines Rudra.\n — β〉 verschiedener Männer, unter andern auch eines Sohnes des Kṛṣṇa.\n — γ〉 eines Rosses des Mondes VP. 22,299.\n— 3〉 *m. oder n. Chenopodium.\n— 4〉 f. वामा\n — a〉 eine Schöne, ein schönes Weib, Weib überh.\n — b〉 eine Form der Durgā.\n — c〉 eine best. Śakti HEMĀDRI 1,610,15. 611,4. 5.\n — d〉 *Bein. der Lakṣmī und Sarasvatī.\n — e〉 N. pr.\n — α〉 einer der Mütter im Gefolge Skandaʼs.\n — β〉 *der Mutter des Arhant Pārśva.\n — γ〉 eines Flusses VP. 22,151.\n— 5〉 f. वामी nach den Erklärern Stute (RĀJAN. 19,38), Eselin, Kamelstute, Maulthierweibchen oder Mauleselin, das Weibchen des Schakals. Zu belegen nur उष्ट्र˚ (auch HARṢAC. 110,23).\n— 6〉 n. Werthes, Liebes, Kostbares (wie Gold, Metallgefässe, Ross), Gut.\n— 7〉 वा꣫म꣫या Instr. Adv. gefällig, schön.", "gloss_language": "de"}, {"gloss": "2. वा꣫म\n— 1〉 Adj. (f. आ)\n — a〉 link, zur Linken stehend, an der linken Seite befindlich. Das Zucken des linken Auges oder Armes verheisst beim Weibe Glück, das Zucken des linken Armes beim Manne Unglück.\n — b〉 schief, verkehrt. Nur वामम् Adv. seitwärts.\n — c〉 in entgegengesetzter Richtung —, anders verfahrend.\n — d〉 widerstrebend, -spänstig, -wärtig. रतौ वामा so v. a. spröde.\n — e〉 schlecht, böse.\n — f〉 hart, grausam.\n— 2〉 m. oder n. die linke Seite. वामाद्दक्षिणम् von links nach rechts, वामेन zur Linken.\n— 3〉 m.\n — a〉 die linke Hand WEBER, RĀMAT. UP. 300.\n — b〉 *Schlange.\n — c〉 *ein lebende Wesen.\n— 4〉 n.\n — a〉 Widerwärtiges, Unheil.\n — b〉 = 1. वामाचार.", "gloss_language": "de"}, {"gloss": "3. *वाम m. Erbrechen.", "gloss_language": "de"}, {"gloss": "4. *वाम Adj. von वामी Stute. PAT. zu P. 4,2,104, Vārtt. 20.", "gloss_language": "de"}], "synonyms": ["वामं", "वामः"], "synonyms_slp1": ["vAmaM", "vAmaH"]}], "vamaka": [{"id": "vamaka", "headword": "वमक", "headword_slp1": "vamaka", "fold": "vamaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वमक m. N. pr. eines der 7 Ṛṣi im 4ten Manvantara VP. 3,1,18. v. l. वनक u. s. w.", "gloss_language": "de"}]}, {"id": "vAmaka", "headword": "वामक", "headword_slp1": "vAmaka", "fold": "vamaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ˚मिका)\n — a〉 link.\n — b〉 widerwärtig, hart, grausam.\n— 2〉 m.\n — a〉 eine best. Mischlingskaste.\n — b〉 N. pr.\n — α〉 eines Fürsten von Kāśi CARAKA. 1,25.\n — β〉 eines Sohnes des Bhajamāna VP. 24,72.\n — γ〉 eines Cakravartin.\n— 3〉 wohl n. eine best. Gesticulation.", "gloss_language": "de"}], "synonyms": ["वामकः"], "synonyms_slp1": ["vAmakaH"]}], "vamajana": [{"id": "vamajjana", "headword": "वमज्जन", "headword_slp1": "vamajjana", "fold": "vamajana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वमज्जन n. = अव˚ das Untertauchen in (Loc.) ĀPAST.", "gloss_language": "de"}]}], "vamaTu": [{"id": "vamaTu", "headword": "वमथु", "headword_slp1": "vamaTu", "fold": "vamaTu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वमथु m.\n— 1〉 Erbrechen.\n— 2〉 Neigung zum Erbrechen, Uebelkeit CARAKA. 6,3. 23.\n— 3〉 das vom Elephanten aus dem Rüssel gespritzte Wasser HARṢAC. (1936) 106,5.\n— 4〉 *Husten.", "gloss_language": "de"}], "synonyms": ["वमथुः"], "synonyms_slp1": ["vamaTuH"]}], "vamana": [{"id": "vamana", "headword": "वमन", "headword_slp1": "vamana", "fold": "vamana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 *Hanf RĀJAN. 4,77.\n — b〉 Pl. N. pr. eines Volkes.\n— 2〉 f. ई\n — a〉 *Blutegel.\n — b〉 *die Baumwollenstaude Ind. St. 17,28, N. 3.\n — c〉 N. pr. [] einer Yoginī HEMĀDRI 2,a,100,11. fgg.\n— 3〉 n.\n — a〉 Erbrechen; das Vonsichgeben, Ausstossen, Entlassen.\n — b〉 Vomitiv CARAKA. 1,15.\n — c〉 *= अर्दन.\n — d〉 *= आहुति.", "gloss_language": "de"}], "synonyms": ["वमनं", "वमनः"], "synonyms_slp1": ["vamanaM", "vamanaH"]}, {"id": "vAmana", "headword": "वामन", "headword_slp1": "vAmana", "fold": "vamana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वामन꣫\n— 1〉 Adj. (f. आ HEMĀDRI 1,52,19. HEM. PAR. 2,35. ई verdächtig)\n — a〉 klein gewachsen, zwerghaft, klein, kurz (von Tagen NAIṢ.).\n — b〉 gebeugt, geneigt HEM. PAR. 2,35.\n— 2〉 m.\n — a〉 Zwerg.\n — b〉 Bein. Viṣṇuʼs, der als Zwerg vom Daitya Bali sich soviel Land erbat, als er mit drei Schritten ausmessen würde, und darauf die drei Welten durchschritt. Auch auf Śiva übertragen.\n — c〉 als Name Viṣṇuʼs Bez. eines best. Monats. []\n — d〉 ein zwerghafter Stier MAITR. S. 2,6,4 (63,17). TS. 2,1,5,2.\n — e〉 ein Bock mit bestimmten Merkmalen.\n — f〉 Bez. eines unter einer best. Constellation geborenen Menschen.\n — g〉 *= काण्ड.\n — h〉 N. pr.\n — α〉 eines Schlangendämons.\n — β〉 eines Dānava.\n — γ〉 eines Sohnes des Garuḍa.\n — δ〉 eines Sohnes des Hiraṇyagarbha.\n — ε〉 *eines der 18 Diener des Sonnengottes.\n — ζ〉 eines Muni.\n — η〉 Pl. eines Volkes.\n — ϑ〉 verschiedener Manner, insbes. Gelehrter.\n — i〉 des Weltelephanten des Südens oder Westens.\n — ϰ〉 eines Berges.\n— 3〉 f. वामना N. pr. einer Apsaras.", "gloss_language": "de"}, {"gloss": "2. वामन\n— 1〉 Adj.\n — a〉 einem Zwerge eigen, dem Zwerge (Viṣṇu) eigen, ihn betreffend, von ihm handelnd.\n — b〉 vom Weltelephanten Vāmana abstammend.\n— 2〉 f. ई\n — a〉 N. pr. einer Yoginī (Hexe) HEMĀDRI 2,a,100,17. 101,1.\n — b〉 *a disease of the vagina. Richtig वामिनी.\n— 3〉 n.\n — a〉 Titel eines Purāṇa und Upapurāṇa\n — b〉 eines nach Viṣṇu, dem Zwerge, benannten Wallfahrtsortes.", "gloss_language": "de"}], "synonyms": ["वामनः"], "synonyms_slp1": ["vAmanaH"]}], "vamanadravya": [{"id": "vamanadravya", "headword": "वमनद्रव्य", "headword_slp1": "vamanadravya", "fold": "vamanadravya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वमनद्रव्य m. Brechmittel.", "gloss_language": "de"}]}], "vamanarTiya": [{"id": "vamanArTiya", "headword": "वमनार्थिय", "headword_slp1": "vamanArTiya", "fold": "vamanarTiya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वमनार्थिय Adj. als Vomitiv dienend CARAKA. 7,12.", "gloss_language": "de"}]}], "vamaniya": [{"id": "vamanIyA", "headword": "वमनीया", "headword_slp1": "vamanIyA", "fold": "vamaniya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वमनीया f. Fliege RĀJAN. 19,129.", "gloss_language": "de"}]}, {"id": "vAmanIya", "headword": "वामनीय", "headword_slp1": "vAmanIya", "fold": "vamaniya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वामनीय Adj.\n— 1〉 mit Brechmitteln zu behandeln.\n— 2〉 Erbrechen bewirkend.", "gloss_language": "de"}]}], "vami": [{"id": "vami", "headword": "वमि", "headword_slp1": "vami", "fold": "vami", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *m.\n — a〉 Feuer.\n — b〉 Stechapfel.\n— 2〉 f. Erbrechen, Uebelkeit. Auch वमी.", "gloss_language": "de"}], "synonyms": ["वमिः"], "synonyms_slp1": ["vamiH"]}, {"id": "vAmI", "headword": "वामी", "headword_slp1": "vAmI", "fold": "vami", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वामी꣫ Adj. f. und Subst. s. u. 1. वाम꣫.", "glos