{"vft": [{"id": "vft", "headword": "वृत्", "headword_slp1": "vft", "fold": "vft", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वृ꣫त्\n— 1〉 Adj. am Ende eines Comp. einschliessend.\n— 2〉 f. Begleitung, Gefolge; Trupp, Heer.", "gloss_language": "de"}, {"gloss": "2. वृत्\n— 1〉 Adj. am Ende eines Comp. sich drehend, sich bewegend, sich verhaltend u. s. w.; nach Zahlwörtern so v. a. -fach, -fältig.\n— 2〉 Schluss, Ende. Nur im DHĀTUP., wo es den Schluss einer zu einer bestimmten grammatischen Regel gehörenden Reihe von Wurzeln bezeichnet, welche in der Grammatik durch die erste Wurzel mit nachfolgenden आदि oder प्रभृति kurz angegeben wird.", "gloss_language": "de"}]}], "vfta": [{"id": "vfta", "headword": "वृत", "headword_slp1": "vfta", "fold": "vfta", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वृत꣫\n— 1〉 Adj. s. u. 1. und 2. वर्.\n— 2〉 *n. = धन.", "gloss_language": "de"}], "synonyms": ["वृतः"], "synonyms_slp1": ["vftaH"]}, {"id": "vftA", "headword": "वृता", "headword_slp1": "vftA", "fold": "vfta", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वृता꣫ f. etwa Fortschritt, Bewegung.", "gloss_language": "de"}]}, {"id": "vftta", "headword": "वृत्त", "headword_slp1": "vftta", "fold": "vfta", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वृत्त꣫\n— 1〉 Adj. s. u. वर्त्.\n— 2〉 m.\n — a〉 *Schildkröte.\n — b〉 *eine Art Gras.\n — c〉 eine runde Kapelle.\n — d〉 N. pr. eines Schlangendämons MBH. 1,35,10.\n — e〉 MBH. 12,3660 fehlerhaft für वृत्र.\n— 3〉 f. वृत्ता\n — a〉 *Bez. verschiedener Pflanzen, = झिञ्जरिष्टा (RĀJAN. 4,205), मंसरोहिणी (RĀJAN. 12,154), महाकोशातकी (RĀJAN. 7,172) und प्रियङ्गु.\n — b〉 *ein best. Arzeneistoff, = रेणुका RĀJAN. 6,113. Nach Mat. med. vielleicht Piper aurantiacum.\n — c〉 ein best. Metrum.\n— 4〉 n. (adj. Comp. f. आ)\n — a〉 Kreis, Epicykel.\n — b〉 das Vorkommen, Erscheinen, Gebrauchtwerden.\n — c〉 Erscheinung, eine Erscheinen, von (im Comp. vorangehend), auch so v. a. eine Form von.\n — d〉 das Werden wie [] (˚वत्), so v. a. Verwandlung in.\n — e〉 Ereigniss, Begebenheit.\n — f〉 Sache, Angelegenheit.\n — g〉 Lebensart, Lebenswandel, Betragen, Benehmen, Handlungsweise, Thun und Treiben. Ausnahmsweise Pl.\n — h〉 richtiger Wandel, gutes Betragen, richtiges Benehmen, gute Sitten.\n — i〉 Lebensunterhalt. Richtiger वृत्ति.\n — k〉 Rhythmus des Versschlusses.\n — l〉 ein Metrum mit bestimmter Silbenzahl und Metrum überh.\n — m〉 ein aus 10 Trochäen bestehendes Metrum.", "gloss_language": "de"}], "synonyms": ["वृत्तं", "वृत्तः"], "synonyms_slp1": ["vfttaM", "vfttaH"]}], "vftaksaya": [{"id": "vftakzaya", "headword": "वृतक्षय", "headword_slp1": "vftakzaya", "fold": "vftaksaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वृतक्षय m. ein erwählter —, erwünschter Wohnsitz in einer Etymologie.", "gloss_language": "de"}]}], "vftancaya": [{"id": "vftaMcaya", "headword": "वृतंचय", "headword_slp1": "vftaMcaya", "fold": "vftancaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वृतंचय꣫ Adj. ein Heer sammelnd.", "gloss_language": "de"}]}], "vftapatra": [{"id": "vftapattrA", "headword": "वृतपत्त्रा", "headword_slp1": "vftapattrA", "fold": "vftapatra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वृतपत्त्रा f. eine best. Schlingpflanze. Richtig वृत्त˚.", "gloss_language": "de"}]}, {"id": "vfttapattrA", "headword": "वृत्तपत्त्रा", "headword_slp1": "vfttapattrA", "fold": "vftapatra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वृत्तपत्त्रा f. eine best. Schlingpflanze RĀJAN. 3,131.", "gloss_language": "de"}]}], "vftarcis": [{"id": "vftArcis", "headword": "वृतार्चिस्", "headword_slp1": "vftArcis", "fold": "vftarcis", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वृतार्चिस् f. Nacht.", "gloss_language": "de"}]}], "vfti": [{"id": "vfti", "headword": "वृति", "headword_slp1": "vfti", "fold": "vfti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वृति f. Einzäunung, Zaun, Hecke KĀD. 252,1. (411,13). ŚIŚ. 12,37.", "gloss_language": "de"}, {"gloss": "2. वृति f. Wahl Erwählung, ein erwähltes Gnadengeschenk.", "gloss_language": "de"}, {"gloss": "3. वृति f. bisweilen fehlerhaft für वृत्ति.", "gloss_language": "de"}], "synonyms": ["वृतिः"], "synonyms_slp1": ["vftiH"]}, {"id": "vftti", "headword": "वृत्ति", "headword_slp1": "vftti", "fold": "vfti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वृत्ति f.\n— 1〉 das Rollen, Herabrollen (von Thränen).\n— 2〉 Art und Weise zu sein, — zu thun, — zu leben, Verfahren, Benehmen, Ausnahmsweise auch Pl.\n— 3〉 Verfahren —, Benehmen gegen Jmd (Loc. oder im Comp. vorangehend) 40,9.\n— 4〉 ein gutes, achtungsvolles, liebevolles Benehmen, ein Gefühl der Achtung und Liebe für Jmd (Gen. oder im Comp. vorangehend).\n— 5〉 guter Wandel, Richtig v. l. वृत्त.\n— 6〉 allgemeiner Gebrauch, Regel.\n— 7〉 Art und Weise des Verhaltens, Wesen, Natur, Art.\n— 8〉 Zustand.\n— 9〉 das Sichbefinden vorkommen —, Erscheinen in oder an (Loc.). Gewöhnlich am Ende eines adj. Comp.\n— 10〉 das Vorkommen, Dasein.\n— 11〉 das Obliegen, Hingegebensein; die Ergänzung im Loc. oder im Comp. vorangehend. Am Ende eines adj. Comp. so v. a. obliegend, hingegeben.\n— 12〉 Sg. und Pl. Lebensunterhalt, Erwerb, Gewerbe, Mittel zum Leben, Lebensunterhalt mittelst (im Comp. vorangehend). वृत्तिं कर् oder कल्प् Caus. leben von (Instr.) und Jmd (Gen.) einen Lebensunterhalt gewähren, — anweisen.\n— 13〉 Wirkung, Thätigkeit, Function 286,10.\n— 14〉 Stimmung 281,27. 282,2. 285,17.\n— 15〉 das Erscheinen —, Gebrauchtwerden eines Wortes in einer best. Bedeutung (Loc.), die Function eines Wortes.\n— 16〉 Art und Weise —, Tempo der Aussprache, — der Recitation.\n— 17〉 im Drama Stil, Charakter, genre.\n— 18〉 Alliteration, häufige Wiederholung desselben Consonanten.\n— 19〉 Rhythmus des Versschlusses.\n— 20〉 Wortform.\n— 21〉 Commentar zu einem Sūtra.\n— 22〉 N. pr. der Gattin eines Rudra BHĀG. P. ed. Bomb. 3,12,13.", "gloss_language": "de"}], "synonyms": ["वृत्तिः"], "synonyms_slp1": ["vfttiH"]}], "vftinkara": [{"id": "vftiMkara", "headword": "वृतिंकर", "headword_slp1": "vftiMkara", "fold": "vftinkara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वृतिंकर m. Flacourtia sapida (Hecken bildend).", "gloss_language": "de"}], "synonyms": ["वृतिंकरः", "वृतिङ्कर", "वृतिङ्करः"], "synonyms_slp1": ["vftiMkaraH", "vftiNkara", "vftiNkaraH"]}], "vftaka": [{"id": "vfttaka", "headword": "वृत्तक", "headword_slp1": "vfttaka", "fold": "vftaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 am Ende eines adj. Comp. = वृत्त Metrum.\n— 2〉 m. ein buddhistisher oder Jaina-Laie.\n— 3〉 n. eine schlichte und dabei wohlklingende Prosa.", "gloss_language": "de"}], "synonyms": ["वृत्तकं"], "synonyms_slp1": ["vfttakaM"]}], "vftakarkawi": [{"id": "vfttakarkawI", "headword": "वृत्तकर्कटी", "headword_slp1": "vfttakarkawI", "fold": "vftakarkawi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वृत्तकर्कटी f. Melone RĀJAN. 7,197.", "gloss_language": "de"}]}], "vftakaya": [{"id": "vfttakAya", "headword": "वृत्तकाय", "headword_slp1": "vfttakAya", "fold": "vftakaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वृत्तकाय Adj. (f. आ) einen runden Körper habend