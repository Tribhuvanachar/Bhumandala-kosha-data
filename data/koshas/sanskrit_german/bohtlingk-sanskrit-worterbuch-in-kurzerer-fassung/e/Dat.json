{"Datura": [{"id": "DattUra", "headword": "धत्तूर", "headword_slp1": "DattUra", "fold": "Datura", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धत्तूर m.\n— 1〉 Datura alba oder Stechapfel überh. RĀJAN. 10,17. BHĀVAPR. 1,203. Spr. 7716. n. die Frucht.\n— 2〉 Gold Spr. 7716.", "gloss_language": "de"}], "synonyms": ["धत्तूरः"], "synonyms_slp1": ["DattUraH"]}], "Daturaka": [{"id": "DattUrakA", "headword": "धत्तूरका", "headword_slp1": "DattUrakA", "fold": "Daturaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धत्तूरका f. = धत्तूर 1〉.", "gloss_language": "de"}]}], "Dataka": [{"id": "DAtaka", "headword": "धातक", "headword_slp1": "DAtaka", "fold": "Dataka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धातक n. = धाटी GAL. — धातकी s. u. धातकि.", "gloss_language": "de"}]}], "Dataki": [{"id": "DAtaki", "headword": "धातकि", "headword_slp1": "DAtaki", "fold": "Dataki", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. N. pr. eines Fürsten.\n— 2〉 f. ई Grislea tomentosa.", "gloss_language": "de"}]}], "DatakitirTa": [{"id": "DAtakitIrTa", "headword": "धातकितीर्थ", "headword_slp1": "DAtakitIrTa", "fold": "DatakitirTa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धातकितीर्थ n. N. pr. eines Tīrtha.", "gloss_language": "de"}]}], "DatakiKaRqa": [{"id": "DAtakIKaRqa", "headword": "धातकीखण्ड", "headword_slp1": "DAtakIKaRqa", "fold": "DatakiKaRqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धातकीखण्ड und धातकीषण्ड n. (VP. 2,4,74. 80. 85) N. pr. eines von Dhātaki beherrschten Varṣa in Puṣkaradvīpa.", "gloss_language": "de"}, {"gloss": "धातकीखण्ड III. DHARMAŚARM. 4,3.", "gloss_language": "de"}]}], "DatakisaRqa": [{"id": "DAtakIzaRqa", "headword": "धातकीषण्ड", "headword_slp1": "DAtakIzaRqa", "fold": "DatakisaRqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धातकीखण्ड und धातकीषण्ड n. (VP. 2,4,74. 80. 85) N. pr. eines von Dhātaki beherrschten Varṣa in Puṣkaradvīpa.", "gloss_language": "de"}]}], "Datar": [{"id": "DAtar", "headword": "धातर्", "headword_slp1": "DAtar", "fold": "Datar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धात꣫र् Nom. ag.\n— 1〉 m.\n — a〉 Träger. वसुधा˚ der Erde.\n — b〉 Anordner.\n — c〉 Erhalter, Lenker.\n — d〉 Anstifter, Urheber.\n — e〉 Schöpfer.\n — f〉 Schöpfer als eine best. göttliche Person. In der nachvedischen Zeit der Schöpfer der Welt, der Gründer und Erhalter der Weltordnung, = Brahman.\n — g〉 das personificirte Schicksal Spr. 7736.\n — h〉 einer der 49 Winde.\n — i〉 Nebenmann, Buhle.\n — k〉 das 10te und 44te Jahr im 60jährigen Jupitercyclus.\n — l〉 N. pr.\n — α〉 eines Āditya.\n — β〉 eines Sohnes Brahmanʼs and Bruders des Vidhātar und der Lakṣmī. Diese werden auch Kinder Bhṛguʼs von der Khyāti genannt.\n — γ〉 eines Ṛṣi im 4ten Manvantara HARIV. 1,7,20. धामन् v. l.\n — δ〉 eines Autors.\n— 2〉 f. धात्री\n — a〉 Amme.\n — b〉 Hebamme.\n — c〉 Wärterin.\n — d〉 Mutter.\n — e〉 die Erde.\n — f〉 Emblica officinalis.", "gloss_language": "de"}]}], "Datave": [{"id": "DAtave", "headword": "धातवे", "headword_slp1": "DAtave", "fold": "Datave", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. धा꣫तवे Dat. Inf. zu 1. धा AV. 6,81,2.", "gloss_language": "de"}, {"gloss": "2. धा꣫तवे Dat. Inf. zu 3. धा ṚV.", "gloss_language": "de"}]}], "Datu": [{"id": "DAtu", "headword": "धातु", "headword_slp1": "DAtu", "fold": "Datu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. धातु m.\n— 1〉 Satz, Lage.\n— 2〉 Theil, Bestandtheil. Nur am Ende eines adj. Comp.\n— 3〉 Element, Urstoff; Aether, Luft, Feuer, Wasser und Erde. Wenn vom menschlichen Körper die Rede ist, versteht man unter धातु sowohl die fünf Urstoffe als auch die ihm eigenthümlichen Hauptbestandtheile; Speisesaft, Blut, Fleisch, Fett, Knochen, Mark und Samen; statt Speisesaft und Samen auch Epidermis und Haut. Bei Annahme von *zehn Dhātu kommen zu den zuerstgenannten noch Haare, Haut und Sehnen. Unter drei Dhātu (= दोष) versteht man Wind, Galle und Schleim; unter fünf auch Ohr, Nase, Mund, Herz und Unterleib. Das Manas ist ein चेतनाधातु. Nach den Lexicographen: die fünf Sinnesorgane und die von ihnen wahrgenommenen fünf Eigenschaften der Urstoffe.\n— 4〉 ein Grundbestandtheil der Erde, — der Gebirge: Erz, Mineral, Metall; insbes. ein in flüssiger Gestalt hervorquellendes rothes Mineral, Röthel (in dieser Bed. auch *n.) माक्षिको धातुः = धातुमाक्षिक.\n— 5〉 der Urstoff der Wörter, Verbalwurzel, auch Verbalstamm überh.\n— 6〉 bei den Buddhisten Element, Region, Bereich (= राशि und लोकाः der Lexicographen) und Reliquie (der Lexicographen Knochen).", "gloss_language": "de"}, {"gloss": "2. धा꣫तु\n— 1〉 Adj. etwa saugbar, zum Saugen geeignet.\n— 2〉 etwa f. Milchkuh.", "gloss_language": "de"}, {"gloss": "3. धातु n. in Verbindung mit रौहिण Name eines Sāman ĀRṢ. BR.", "gloss_language": "de"}], "synonyms": ["धातुः"], "synonyms_slp1": ["DAtuH"]}], "Datuka": [{"id": "DAtuka", "headword": "धातुक", "headword_slp1": "DAtuka", "fold": "Datuka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 am Ende eines adj. Comp. = 1. धातु\n— 2〉 *Bitumen.", "gloss_language": "de"}], "synonyms": ["धातुकः"], "synonyms_slp1": ["DAtukaH"]}], "Datukalpa": [{"id": "DAtukalpa", "headword": "धातुकल्प", "headword_slp1": "DAtukalpa", "fold": "Datukalpa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धातुकल्प m. T