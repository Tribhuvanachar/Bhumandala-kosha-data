{"Bur": [{"id": "Bur", "headword": "भुर्", "headword_slp1": "Bur", "fold": "Bur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√भुर्, भुरति, ˚ते rasche und kurze Bewegungen machen, zappeln, zucken.\n— Intens. (ज꣫र्भुरीति, ज꣫र्भुरत्, ज꣫र्भुराण) dass. und züngeln (vom Feuer).\n— Mit परि Intens. umherzucken (von Licht).\n— Mit सम् Intens. in schneller Bewegung sein.", "gloss_language": "de"}]}, {"id": "BUr", "headword": "भूर्", "headword_slp1": "BUr", "fold": "Bur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भू꣫र् Indecl. (ursprünglich Nomin. von 2. भू)\n— 1〉 in [] der Formel भू꣫र्भु꣫वः स्वः॑ (VS. 3,5. 37) als Erde gefasst. Bei der Annahme von 14 Welten nimmt भूर् die erste Stelle unter den 7 aufsteigenden Welten ein.\n— 2〉 *Hölle.\n— 3〉 wird als ein geistiger Sohn Brahmanʼs gefasst.", "gloss_language": "de"}]}], "Buraj": [{"id": "Buraj", "headword": "भुरज्", "headword_slp1": "Buraj", "fold": "Buraj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भुरज्, भुर꣫जन्त statt भ्रजन्त = भ्रज्जन्त (intrans.).", "gloss_language": "de"}]}], "Burajanta": [{"id": "Burajanta", "headword": "भुरजन्त", "headword_slp1": "Burajanta", "fold": "Burajanta", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भुरज्, भुर꣫जन्त statt भ्रजन्त = भ्रज्जन्त (intrans.).", "gloss_language": "de"}]}], "BuraRa": [{"id": "BuraRa", "headword": "भुरण", "headword_slp1": "BuraRa", "fold": "BuraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भुरण Adj. rührig = भर्तर् Comm.", "gloss_language": "de"}]}], "BuraRy": [{"id": "BuraRy", "headword": "भुरण्य्", "headword_slp1": "BuraRy", "fold": "BuraRy", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung",