und पिश꣫ङ्गसंदृश् Adj. röthlich —, röthlich gelb aussehend.", "gloss_language": "de"}]}], "pisaNgasva": [{"id": "piSaNgASva", "headword": "पिशङ्गाश्व", "headword_slp1": "piSaNgASva", "fold": "pisaNgasva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिश꣫ङ्गाश्व Adj. röthliche Rosse habend.", "gloss_language": "de"}]}], "pisaNgita": [{"id": "piSaNgita", "headword": "पिशङ्गित", "headword_slp1": "piSaNgita", "fold": "pisaNgita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिशङ्गित Adj. röthlich gelb gefärbt KĀD. 9,22.", "gloss_language": "de"}]}], "pisaNgila": [{"id": "piSaNgila", "headword": "पिशङ्गिल", "headword_slp1": "piSaNgila", "fold": "pisaNgila", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिशङ्गिल꣫ Adj. (f. आ꣫) etwa röthlich.", "gloss_language": "de"}]}], "pisaNgi": [{"id": "piSaNgI", "headword": "पिशङ्गी", "headword_slp1": "piSaNgI", "fold": "pisaNgi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. पिश꣫ङ्गी Adj. s. पिश꣫ङ्ग.", "gloss_language": "de"}, {"gloss": "2. पिशङ्गी Adv. mit कर् röthlich färben MUDRĀR. 63,21 (104,4).", "gloss_language": "de"}]}], "pisaca": [{"id": "piSAca", "headword": "पिशाच", "headword_slp1": "piSAca", "fold": "pisaca", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिशाच꣫\n— 1〉 m. (adj. Comp. f. आ)\n — a〉 eine Klasse dämonischer Wesen zu deren Aufstellung die Irrlichter Veranlassung gegeben haben mögen. Am Ende eines Comp. so v. a. ein Teufel —, ein Dämon von KĀD. 255,11 (417,9).\n — b〉 N. pr. eines Rakṣas.\n— 2〉 f. आ N. pr. einer Tochter Dakṣaʼs und Mutter der Piśāca.\n— 3〉 f. ई\n — a〉 f. zu 1〉a〉. Am Ende eines Comp. so v. a. ein Teufel —, ein Dämon von BĀLAR. 86,11.\n — b〉 *eine Valeriana RĀJAN. 12,101.\n — c〉 N. pr. einer Yoginī HEMĀDRI 2,a,100,2. 4.", "gloss_language": "de"}], "synonyms": ["पिशाचः"], "synonyms_slp1": ["piSAcaH"]}], "pisacaka": [{"id": "piSAcaka", "headword": "पिशाचक", "headword_slp1": "piSAcaka", "fold": "pisacaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *Adj. = पिशाचे कुशलः.\n— 2〉 m. = पिशाच 1〉a〉.\n— 3〉 f. ई\n — a〉 = पिशाच 3〉a〉.\n — b〉 *die Sprache der Piśāca.\n — c〉 N. pr. eines Flusses. Vgl. पिशाचिकी.", "gloss_language": "de"}, {"gloss": "पिशाचक IV. 3〉 lies f. ˚चिका a〉 SUBHĀṢITĀV. 3339.", "gloss_language": "de"}]}], "pisacakapura": [{"id": "piSAcakapura", "headword": "पिशाचकपुर", "headword_slp1": "piSAcakapura", "fold": "pisacakapura", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिशाचकपुर n. N. pr. eines Dorfes.", "gloss_language": "de"}]}], "pisacakin": [{"id": "piSAcakin", "headword": "पिशाचकिन्", "headword_slp1": "piSAcakin", "fold": "pisacakin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*पिशाचकिन् m. Bein. Kuberaʼs.", "gloss_language": "de"}]}], "pisacaksayaRa": [{"id": "piSAcakzayaRa", "headword": "पिशाचक्षयण", "headword_slp1": "piSAcakzayaRa", "fold": "pisacaksayaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिशाचक्ष꣫यण Adj. die Piśāca vernichtend, — vertreibend.", "gloss_language": "de"}]}], "pisacagfhitaka": [{"id": "piSAcagfhItaka", "headword": "पिशाचगृहीतक", "headword_slp1": "piSAcagfhItaka", "fold": "pisacagfhitaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिशाचगृहीतक m. ein Besessener KĀD. 255,14 (418,1)", "gloss_language": "de"}]}], "pisacacarya": [{"id": "piSAcacaryA", "headword": "पिशाचचर्या", "headword_slp1": "piSAcacaryA", "fold": "pisacacarya", "headword_language": "sa", 