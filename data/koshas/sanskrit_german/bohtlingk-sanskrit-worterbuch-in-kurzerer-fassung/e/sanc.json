bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संचार m. (adj. Comp. f. आ)\n— 1〉 das Sichergehen, Umherstreichen, Fahrend, Bewegung überh. रश्मि˚ Bewegung der Zügel, so v. a. das Lenken; वाक्य˚ Gang einer Rede, so v. a. Art und Weise zu reden; पद˚ so v. a. Fluss der Worte.\n— 2〉 Hindurchgang, Passage (auch concret) Spr. 7752.\n— 3〉 Uebergang in (im Comp. vorangehend).\n— 4〉 Weg, [] Pfad, Fährte des Wildes.\n— 5〉 Lebensgang.\n— 6〉 Bez. des हुंकारा.\n— 7〉 fehlerhaft für संचर (Evolution, Entwickelung), संसार und सच्चार.", "gloss_language": "de"}], "synonyms": ["संचारः", "सञ्चार", "सञ्चारः"], "synonyms_slp1": ["saMcAraH", "saYcAra", "saYcAraH"]}], "sancaraRa": [{"id": "saMcaraRa", "headword": "संचरण", "headword_slp1": "saMcaraRa", "fold": "sancaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संच꣫रण\n— 1〉 Adj. (f. ई) worauf man geht, gangbar.\n— 2〉 n. das Befahren des Meeres (Acc.); das Sichbewegen, — von (Abl.), in (Loc. oder im Comp. vorangehend VĀSAV. 185,1), mittels (im Comp. vorangehen).", "gloss_language": "de"}]}, {"id": "saMcAraRa", "headword": "संचारण", "headword_slp1": "saMcAraRa", "fold": "sancaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संचारण n.\n— 1〉 das Hinzuführen, Beimischen SĀH. D. 27,7. 9. VIJÑĀNEŚVARA zu YĀJÑ. 2,246 (nach AUFRECHT.).\n— 2〉 dass Beisichführen.\n— 3〉 das Hineintreiben in (im Comp. vorangehend). VṚṢABH. 29,b,8.", "gloss_language": "de"}, {"gloss": "संचारण VII. das Ueberbringen (einer Botschaft) JĀTAKAM. 23.", "gloss_language": "de"}], "synonyms": ["संचारणं", "सञ्चारण"], "synonyms_slp1": ["saMcAraRaM", "saYcAraRa"]}], "sancaraBagin": [{"id": "saMcaraBAgin", "headword": "संचरभागिन्", "headword_slp1": "saMcaraBAgin", "fold": "sancaraBagin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संचरभागिन् Adj. VASIṢ