{"Dena": [{"id": "Dena", "headword": "धेन", "headword_slp1": "Dena", "fold": "Dena", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *m.\n — a〉 Meer.\n — b〉 Fluss.\n— 2〉 f. धे꣫ना\n — a〉 eine milchend Kuh.\n — b〉 Pl. Milchtrank.\n — c〉 Stute.\n — d〉 *Rede.\n — e〉 *Fluss.\n — f〉 N. pr. der Gattin Bṛhaspatiʼs VAITĀN.\n— 3〉 *f. धेनी Fluss.", "gloss_language": "de"}, {"gloss": "धेन III. 2〉 lies धे꣫ना st. घे꣫ना.", "gloss_language": "de"}], "synonyms": ["धेनः"], "synonyms_slp1": ["DenaH"]}], "Denika": [{"id": "DenikA", "headword": "धेनिका", "headword_slp1": "DenikA", "fold": "Denika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धेनिका f. Koriander BHĀVAPR. 1,166. v. l. धेनुका.", "gloss_language": "de"}]}], "Denu": [{"id": "Denu", "headword": "धेनु", "headword_slp1": "Denu", "fold": "Denu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धेनु꣫\n— 1〉 Adj. milchend.\n— 2〉 f.\n — a〉 eine milchende Kuh, Mutterkuh. In Zusammensetzung mit andern Thiernamen zur Bez. des milchenden Mutterthieres.\n — b〉 Pl. Milchtrank, Milch.\n — c〉 bildliche Bez. der Erde, des Landes.\n — d〉 bildet in Comp. mit असि und खङ्ग Schwert in Deminutiv.\n— 3〉 n. Name eines Sāman. Auch मरुतां धेनु und धेनुपयसी (Du.).", "gloss_language": "de"}], "synonyms": ["धेनुः"], "synonyms_slp1": ["DenuH"]}], "Denuka": [{"id": "Denuka", "headword": "धेनुक", "headword_slp1": "Denuka", "fold": "Denuka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 quidam coeundi modus.\n — b〉 N. pr.\n — α〉 Pl. eines Volkes MBH. 6,50,51.\n — β〉 eines von Kṛṣṇa (Balabhadra) erschlagenen Unholds.\n — γ〉 eines Sohnes des Durdama VP.² 4,54.\n— 2〉 f. धुनुका\n — a〉 Mutterkuh, Mutterthier überh.; auch vom Weibe = *दृष्टपुष्पा GAL.\n — b〉 bildet in Comp. mit असि Schwert ein Deminutiv.\n — c〉 [] eine Ader, welche angeschlagen nur in Intervallen das Blut ausströmt.\n — d〉 Koriander BHĀVAPR. 1,166. v. l. धेनिका.\n — e〉 N. pr.\n — α〉 der Gattin Kīrtimantʼs.\n — β〉 eines Flusses VP. 2,4,36.\n— 3〉 n.\n — a〉 *eine Heerde milchender Kühe.\n — b〉 *quidam coeundi modus.\n — c〉 N. pr. eines Wallfahrtsortes.", "gloss_language": "de"}], "synonyms": ["धेनुकः"], "synonyms_slp1": ["DenukaH"]}, {"id": "DenUka", "headword": "धेनूक", "headword_slp1": "DenUka", "fold": "Denuka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धेनूक in बहु˚.", "gloss_language": "de"}]}], "DenukaDvansin": [{"id": "DenukaDvaMsin", "headword": "धेनुकध्वंसिन्", "headword_slp1": "DenukaDvaMsin", "fold": "DenukaDvansin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धेनुकध्वंसिन् und *धेनुकसूदन m. Bein. Kṛṣṇaʼs.", "gloss_language": "de"}]}], "Denukasudana": [{"id": "DenukasUdana", "headword": "धेनुकसूदन", "headword_slp1": "DenukasUdana", "fold": "Denukasudana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धेनुकध्वंसिन् und *धेनुकसूदन m. Bein. Kṛṣṇaʼs.", "gloss_language": "de"}], "synonyms": ["धेनुकसूदनः"], "synonyms_slp1": ["DenukasUdanaH"]}], "DenukadugDa": [{"id": "DenukAdugDa", "headword": "धेनुकादुग्ध", "headword_slp1": "DenukAdugDa", "fold": "DenukadugDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धेनुकादुग्ध n.\n— 1〉 Kuhmilch.\n— 2〉 eine Gurkenart.", "gloss_language": "de"}]}], "Denukari": [{"id": "DenukAri", "headword": "धेनुकारि", "headword_slp1": "DenukAri", "fold": "Denukari", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धेनुकारि m.\n— 1〉 Bein. Kṛṣṇaʼs.\n— 2〉 ein best. kleiner Raum.", "gloss_language": "de"}]}], "Denukasrama": [{"i