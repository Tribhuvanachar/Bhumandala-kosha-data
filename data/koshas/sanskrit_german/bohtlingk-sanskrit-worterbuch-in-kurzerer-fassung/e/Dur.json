{"Dur": [{"id": "Dur", "headword": "धुर्", "headword_slp1": "Dur", "fold": "Dur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धु꣫र् f. (m. metrisch MBH. 13,53,32)\n— 1〉 derjenige Theil des Joches, welcher auf die Schulter des Zugthieres gelegt wird; uneig. und übertr. die Einem aufgebürdete Last.\n— 2〉 die äusserste Spitze der Deichsel; übertr. die vorderste, oberste Stelle, Spitze, Ehrenplatz.\n— 3〉 Zapfen in अक्ष˚.\n— 4〉 Loc. in Gegenwart von (Gen.) Spr. 7712.\n— 5〉 *Finger.\n— 6〉 Bez. von sechs eigenthümlich zu singenden Versen des Bahiṣpavamāna.\n— 7〉 धुरोःशम्ये (Du.), धुरोः सामनी und धुरां साम Namen von Sāman ĀRṢ. BR.\n— 8〉 *reflection, recollection.\n— 9〉 *a spark of fire.\n— 10〉 a part, a portion.\n— 11〉 wealth.\n— 12〉 a name of the Ganges.", "gloss_language": "de"}]}, {"id": "DUr", "headword": "धूर्", "headword_slp1": "DUr", "fold": "Dur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√धूर्, धूर्यते (हिंसागत्योः).", "gloss_language": "de"}]}], "Dura": [{"id": "Dura", "headword": "धुर", "headword_slp1": "Dura", "fold": "Dura", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धु꣫र\n— 1〉 m. f. (आ) Bürde, Last.\n— 2〉 m. Zapfen (an der Achse).\n— 3〉 f. आ Deichsel.\n— 4〉 n. etwa Achse überh. ṚV. 5,43,8.\n— 5〉 am Ende eines adj. Comp. (f. आ) worin — als Zierde erscheint, ausgezeichnet durch BĀLAR. 8,4.", "gloss_language": "de"}], "synonyms": ["धुरः"], "synonyms_slp1": ["DuraH"]}, {"id": "DurA", "headword": "धुरा", "headword_slp1": "DurA", "fold": "Dura", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धुरा꣫ Adv. gewaltsam.", "gloss_language": "de"}]}], "DuranDara": [{"id": "DuraMDara", "headword": "धुरंधर", "headword_slp1": "DuraMDara", "fold": "DuranDara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj.\n — a〉 das Joch tragend, zum Anspannen geeignet, — an (im Comp. vorangehend).\n — b〉 die ihm aufgeladene Last mit Ergebung tragend.\n — c〉 Jmd (Gen.) aus der Noth helfend.\n— 2〉 m.\n — a〉 *Zugthier.\n — b〉 Vordermann, mit Gen. oder am Ende eines Comp. (Spr. 7697. BĀLAR. 52,16).\n — c〉 *Grislea tomentosa.\n — d〉 N. pr.\n — α〉 Pl. eines Volkes.\n — β〉 eines Rakṣas.", "gloss_language": "de"}], "synonyms": ["धुरन्धर", "धुरन्धरः"], "synonyms_slp1": ["DuranDara", "DuranDaraH"]}], "Duri": [{"id": "Duri", "headword": "धुरि", "headword_slp1": "Duri", "fold": "Duri", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धुरि m. N. pr. eines Sohnes des Vasu Āpa VP.² 2,23.", "gloss_language": "de"}]}], "Durika": [{"id": "DurikA", "headword": "धुरिका", "headword_slp1": "DurikA", "fold": "Durika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धुरिका f. Zäpfchen (an der Achse).", "gloss_language": "de"}]}], "DuriRa": [{"id": "DurIRa", "headword": "धुरीण", "headword_slp1": "DurIRa", "fold": "DuriRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *Adj. zum Anspannen geeignet.\n— 2〉 m.\n — a〉 *Zugthier.\n — b〉 Vordermann.", "gloss_language": "de"}], "synonyms": ["धुरीणः"], "synonyms_slp1": ["DurIRaH"]}], "Duriya": [{"id": "DurIya", "headword": "धुरीय", "headword_slp1": "DurIya", "fold": "Duriya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*धुरीय m. Zugthier.", "gloss_language": "de"}], "synonyms": ["धुरीयः"], "synonyms_slp1": ["DurIyaH"]}], "Durya": [{"id": "Durya", "headword": "धुर्य", "headword_slp1": "Durya", "fold": "Durya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धु꣫र्य\n— 1〉 Adj