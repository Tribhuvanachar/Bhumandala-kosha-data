{"tus": [{"id": "tuS", "headword": "तुश्", "headword_slp1": "tuS", "fold": "tus", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √तुश्, तोशते träufeln (intr.). Nach den Erklärern = पीयते, अभिषूयते oder हन्यते.\n— Mit नि\n— 1〉 herabträufeln (intr.).\n— 2〉 träufeln (trans.), spenden.\n— 3〉 *वधर्मन्\n— Caus. तोशयति\n— 1〉 spenden.\n— 2〉 *वधकर्मन्.", "gloss_language": "de"}, {"gloss": "2. √तुश्, तो꣫शते\n— 1〉 befriedigt sein, sich erlaben an (Instr.)\n— 2〉 beschwichtigen.", "gloss_language": "de"}]}, {"id": "tuz", "headword": "तुष्", "headword_slp1": "tuz", "fold": "tus", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√तुष्, तुष्यति (metrisch auch Med.)\n— 1〉 sich beruhigen, sich zufrieden geben, sich zufrieden fühlen, seine Freude haben, — an Jmd (Gen., Dat., Instr., Loc. oder Acc. mit प्रति) oder Etwas (Instr. oder ausnahmsweise Adv. auf तस्), तुष्ट zufriedengestellt, befriedigt, zufrieden; Construction wie beim Verbum fin. oder mit der Ergänzung componirt.\n— 2〉 Jmd zufrieden stellen, Jmd zu Gefallen sein; mit Acc.\n— Caus. तोषयति und ˚ते (metrisch) beschwichtigen, zufriedenstellen, Jmd zu Gefallen sein; mit Acc. der Person und Instr. der Sache. आत्मानम् sich zufrieden geben. तोषित zufriedengestellt, befriedigt, erfreut, — von oder durch (Instr. oder im Comp. vorangehend).\n— Mit अभि sich zufrieden fühlen, seine Freude haben.\n— Mit उप Caus. (˚तोषयति) zufriedenstellen durch (Instr.).\n— Mit परि sich, vollkommen zufrieden geben mit (Instr.), — fühlen, sich sehr freuen, grosse Freude haben an (Loc. 170,1. ते an dir). परितुष्य Absol. aus Freude. परितुष्ट vollkommen befriedigt, — zufriedengestellt durch (Instr.), — zufrieden, — froh. परितुष्टार्थ HARIV. 6518 fehlerhaft für परिदृष्टार्थ.\n— Caus. [] (˚तोषयति) Jmd vollkommen beschwichtigen, — zufriedenstellen, Jmd überaus zu Gefallen sein, — mit.\n— Mit (Instr.).\n— Mit प्र Gefallen finden an (Instr.).\n— Caus. (प्रतोषयति) Jmd zufriedenstellen durch (Instr.).\n— Mit संप्र sich zufrieden fühlen.\n— Mit सम् sich beruhigen, sich zufrieden fühlen, zufrieden sein mit (Instr.), seine Freude haben an (Instr.). संतुष्य aus Freude. संतुष्ट zufriedengestellt, befriedigt, zufrieden, — mit (Instr. oder im Comp. vorangehend), genügsam.\n— Caus. (संतोषयति und metrisch ˚ते) Jmd zufriedenstellen, zu Gefallen sein, erfreuen durch (Instr.) beschenken mit (Instr.), beschenken mit (Instr.).", "gloss_language": "de"}]}, {"id": "tus", "headword": "तुस्", "headword_slp1": "tus", "fold": "tus", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√तुस्, तोसति (शब्दे).", "gloss_language": "de"}]}, {"id": "tUz", "headword": "तूष्", "headword_slp1": "tUz", "fold": "tus", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√तूष्, तूषति (तुष्टौ).", "gloss_language": "de"}]}], "tusa": [{"id": "tuza", "headword": "तुष", "headword_slp1": "tuza", "fold": "tusa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तु꣫ष m.\n— 1〉 Hülse des Reises, Getraides u. s. w., Spelze.\n— 2〉 *Terminalia bellirica^1.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}], "synonyms": ["तुषः"], "synonyms_slp1": ["tuzaH"]}, {"id": "tUza", "headword": "तूष", "headword_slp1": "tUza", "fold": "tusa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तूष m. n. Zipfel, Einfassung oder Franse eines Gewandes.", "gloss_language": "de"}], "synonyms": ["तूषः"], "synonyms_slp1": ["tUzaH"]}], "tusaKaRqana": [{"id": "tuzaKaRqana", "headword": "तुषखण्डन", "headword_slp1": "tuzaKaRqana", "fold": "tusaKaRqana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuc