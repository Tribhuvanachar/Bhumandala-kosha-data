{"dosa": [{"id": "doza", "headword": "दोष", "headword_slp1": "doza", "fold": "dosa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. दोष\n— 1〉 m. nur. BHĀG. P. Abend, Dunkel. Personif. als einer der 8 Vasu und als Gatte der Nacht.\n— 2〉 दोषा꣫ Abend, Dunkel. दोषा꣫म् und दोषा꣫ (Instr.) am —, bei Abend, im Dunkeln, bei Nacht. Personif. als Gattin Puṣpārṇaʼs und Mutter Pradoṣaʼs.", "gloss_language": "de"}, {"gloss": "2. दोष\n— 1〉 m. und (ausnahmsweise) n. (adj. Comp. f. आ)\n — a〉 Fehler, Schaden Mangel, Gebrechen, Fehlerhaftigkeit, eine fehlerhaft, schlechte, schädliche Eigenschaft Uebelstand.\n — b〉 Schlechtigkeit, Sündhaftigkeit.\n — c〉 Fehler, Verfehlung, Versehen, Vergehen, Verbrechen, Schuld, Sünde.\n — d〉 Nachtheil, Schaden.\n — e〉 üble Folge. दोषेण, दोषात् und दोषतस् als üble Folge von und auch in Folge von (im Comp. vorangehend) überh.\n — f〉 Alteration, Affection.\n — g〉 verdorbene Säfte, ein gestörter Zustand und eine solche Thätigkeit der drei Flüssigkeiten des Körpers, welche Krankheit erzeugen; krankhafte Affection, Krankheitsstoff, Krankheit.\n — h〉 die drei flüssigen Grundstoffe des menschlichen Leibes; Luft (Wind), Galle und Schleim, welche [] bei gestörtem Zustande Krankheit erzeugen.\n— 2〉 m. Kalb.", "gloss_language": "de"}, {"gloss": "2. दोष III. 1〉c〉 दोषं कर् mit Acc. der Person Jmd Etwas (Loc.) als Schuld anrechnen R. ed. Bomb. 4,18,48.", "gloss_language": "de"}], "synonyms": ["दोषः"], "synonyms_slp1": ["dozaH"]}, {"id": "dozA", "headword": "दोषा", "headword_slp1": "dozA", "fold": "dosa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. दोषा꣫ f. Abend s. 1. दोष 2〉.", "gloss_language": "de"}, {"gloss": "2. *दोषा f. = दोषन्.", "gloss_language": "de"}]}], "dosaka": [{"id": "dozaka", "headword": "दोषक", "headword_slp1": "dozaka", "fold": "dosaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*दोषक m. Kalb.", "gloss_language": "de"}], "synonyms": ["दोषकः"], "synonyms_slp1": ["dozakaH"]}], "dosakara": [{"id": "dozakara", "headword": "दोषकर", "headword_slp1": "dozakara", "fold": "dosakara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दोषकर Adj. Schaden verursachend, verderblich für (Gen.).", "gloss_language": "de"}]}, {"id": "dozAkara", "headword": "दोषाकर", "headword_slp1": "dozAkara", "fold": "dosakara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. दोषाकर m. der Mond.", "gloss_language": "de"}, {"gloss": "2. दोषाकर m. eine Fundgrube von allerlei Mängeln.", "gloss_language": "de"}], "synonyms": ["दोषाकरः"], "synonyms_slp1": ["dozAkaraH"]}], "dosaguRa": [{"id": "dozaguRa", "headword": "दोषगुण", "headword_slp1": "dozaguRa", "fold": "dosaguRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दोषगुण n. Sg. Fehler und Verzüge 208,29.", "gloss_language": "de"}]}], "dosaguRikaraRa": [{"id": "dozaguRIkaraRa", "headword": "दोषगुणीकरण", "headword_slp1": "dozaguRIkaraRa", "fold": "dosaguRikaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दोषगुणीकरण n. das aus einem Fehler einen Vorzug Machen Comm. zu KUVALAY. 164,a.", "gloss_language": "de"}]}], "dosagrahin": [{"id": "dozagrAhin", "headword": "दोषग्राहिन्", "headword_slp1": "dozagrAhin", "fold": "dosagrahin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दोषग्राहिन् Adj. das Schlechte aufnehmend, — behaltend.", "gloss_language": "de"}]}], "dosaGna": [{"id": "dozaGna", "headword": "दोषघ्न", "headword_slp1": "dozaGna", "fold": "dosaGna", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दो