onyms_slp1": ["paviH"]}], "pavita": [{"id": "pavita", "headword": "पवित", "headword_slp1": "pavita", "fold": "pavita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*पवित n. schwarzer Pfeffer. Richtig पलित.", "gloss_language": "de"}], "synonyms": ["पवितः"], "synonyms_slp1": ["pavitaH"]}], "pavitar": [{"id": "pavitar", "headword": "पवितर्", "headword_slp1": "pavitar", "fold": "pavitar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पवित꣫र् Nom. ag. Reiniger.", "gloss_language": "de"}]}, {"id": "pavItar", "headword": "पवीतर्", "headword_slp1": "pavItar", "fold": "pavitar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पवीत꣫र् Nom. ag. Läuterer, Reiniger.", "gloss_language": "de"}]}], "pavitra": [{"id": "pavitra", "headword": "पवित्र", "headword_slp1": "pavitra", "fold": "pavitra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पवि꣫त्र\n— 1〉 n.\n — a〉 Reinigungsmittel, Läuterungsmittel überh.; Seihe, Sieb, Seihetuch, Durchschlag, colum zur Läuterung von Flüssigkeiten. insbes. des Soma. Schon zwei Kuśa-Halme bewirken symbolisch Läuterung. Das Wort wird in eigentlichem und übertragenem Sinne auf die verschiedensten [] Dinge angewandt. Nach den Lexicographen geschmolzene Butter (RĀJAN. 15,2), Honig (RĀJAN. 14,110), Wasser, Kupfer, Regen oder das Reiben (वर्षण, घर्षण; vgl. Varsma oder Varsama = पवित्र bei den Maga VP. 25,384).\n — b〉 das Gefäss, in dem die Ehrengabe dargebracht wird.\n — c〉 *die heilige Schnur des Brahmanen.\n — d〉 die sichtende und scheidende Thätigkeit des Geistes.\n — e〉 ein reinigendes Gebet.\n — f〉 आदित्यानां und देवानां पवित्रम् Namen von Sāman ĀRṢ. BR.\n — g〉 ein best. Metrum.\n— 2〉 Adj. (f. आ) reinigend, Segen bringend; rein (eigentlich und übertragen).\n— 3〉 m.\n — a〉 ein best. zu dem Rājasūya gehöriges Soma-Opfer.\n — b〉 *Sesamum indicum RĀJAN. 16,70.\n — c〉 *Nageia putranjiva RĀJAN. 9,145.\n — d〉 N. pr.\n — α〉 Pl. einer Klasse von Göttern im 14ten Manvantara.\n — β〉 eines Mannes.\n— 4〉 f. पवित्रा\n — a〉 *Basilienkraut.\n — b〉 *Gelbwurz RĀJAN. 6,198.\n — c〉 *der kleine Pippala-Baum RĀJAN. 11,123.\n — d〉 N. pr. zweier Flüsse VP. 2,4,43.", "gloss_language": "de"}], "synonyms": ["पवित्रं", "पवित्रः"], "synonyms_slp1": ["pavitraM", "pavitraH"]}, {"id": "pavitrA", "headword": "पवित्रा", "headword_slp1": "pavitrA", "fold": "pavitra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "!√पवित्रा, ˚ति HEMĀDRI 1,499,5. Fehlerhaft für परित्राति; vgl. MBH. 13,62,39.", "gloss_language": "de"}]}, {"id": "pAvitra", "headword": "पावित्र", "headword_slp1": "pAvitra", "fold": "pavitra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पावित्र n. ein best. Metrum. Richtig पवित्र.", "gloss_language": "de"}]}], "pavitraka": [{"id": "pavitraka", "headword": "पवित्रक", "headword_slp1": "pavitraka", "fold": "pavitraka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 n.\n — a〉 Siebchen.\n — b〉 *Messing GAL.\n— 2〉 am Ende eines adj. Comp.\n — a〉 Kuśa-Halme insbes. zwei.\n — b〉 das Gefäss, in welchem die Ehrengabe dargebracht wird.\n— 3〉 *m.\n — a〉 Poa cynosuroides RĀJAN. 8,94.\n — b〉 Artemisia indica RĀJAN. 10,148.\n — c〉 Ficus religiosa RĀJAN. 11,114.\n — d〉 Ficus glomerata RĀJAN. 11,130.", "gloss_language": "de"}], "synonyms": ["पवित्रकं", "पवित्रकः"], "synonyms_slp1": ["pavitrakaM", "pavitrakaH"]}], "pavitragiri": [{"id": "pavitragiri", "headword": "पवित्रगिरि", "headword_slp1": "pavitragiri", "fold": "pavitragiri", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पवित्रगिरि m. N. pr. einer Oertlichkeit.", "gloss_langua