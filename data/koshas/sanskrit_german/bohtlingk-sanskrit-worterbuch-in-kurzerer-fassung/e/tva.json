language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त्वन्मय Adj. aus dir hervorgegangen, — bestehend, nur dich enthaltend VIKRAMĀṄKAC. 9,28. Nom. abstr. ˚ता f. ˚ताम् अव-आप् in dir aufgehen NAIṢ. 3,106.", "gloss_language": "de"}]}], "tvam": [{"id": "tvam", "headword": "त्वम्", "headword_slp1": "tvam", "fold": "tvam", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त्व꣫म्, तुअ꣫म् Nom. Sg. du त्वं कर् Jmd (Acc.) duzen.", "gloss_language": "de"}]}], "tvayata": [{"id": "tvayata", "headword": "त्वयत", "headword_slp1": "tvayata", "fold": "tvayata", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त्व꣫यत Adj. von dir dargereicht.", "gloss_language": "de"}]}], "tvar": [{"id": "tvar", "headword": "त्वर्", "headword_slp1": "tvar", "fold": "tvar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√त्वर्, त्व꣫रते (episch auch Act.) eilen, schnell bei der Hand sein, eilen zu (Dat. oder Loc. eines Nom. act. oder Infin.). त्वरित, तूर्त꣫ (ŚAT. BR.) und तूर्ण (selten) eilend, schnell, geschwind schnell bei der Hand, eilend zu (Loc. eines Nom. act. oder Infin.). त्वरितम् und तूर्णम् Adv. eilends, schnell. त्वरितं त्वरितम् KĀRAṆḌ. 58,3. त्वरितोदित und तूर्णोदित schnell ausgesprochen. Compar. Adv. त्वरिततरम् und तूर्णतरम्.\n— Caus.\n— 1〉 त्वर꣫यति (episch auch Med.) zur Eile antreiben AV. 12,3,31. antreiben zu (Acc. mit oder ohne प्रति, Dat. eines Nom. act. oder Infin.).\n— 2〉 त्वारयति (!) rasch befördern zu दधिभावाय so v. a. schnell in saure Milch verwandeln ŚAṂK. zu BĀDAR. 2,1,24 (S. 476, z. 5).\n— Mit अति sehr eilen, — zu (Infin.).\n— Mit अभि eilen. ˚त्वरित eilend, schnell bei der Hand.\n— Mit परि herumeilen.\n— Mit प्र eilen zu (Dat. eines Nom. act.). प्र꣫तूर्त und प्रतूर्ण (HARṢAC. 16,1) überaus rasch.\n— Mit सम् eilen. संत्वरित eilend, ˚म् eilends, schnell.\n— Caus. संत्वरयति eilen heissen, zur Eile antreiben प्राणाः संत्वरयन्ति माम् so v. a. mir bleibt nicht viel Zeit zum Leben übrig.", "gloss_language": "de"}]}], "tvara": [{"id": "tvara", "headword": "त्वर", "headword_slp1": "tvara", "fold": "tvara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त्वर m. (nur BHĀG. P.) und त्वरा f. Eile, Hast. त्वरेण und त्वरय eiligst, rasch, schnell. विवाहकृते in Betreff der Hochzeit. In der Regel steht die Ergänzung im Loc. oder Infin. oder geht im Comp. voran. त्वरां कर् mit Gen. eilen mit.", "gloss_language": "de"}]}], "tvaraRa": [{"id": "tvaraRa", "headword": "त्वरण", "headword_slp1": "tvaraRa", "fold": "tvaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त्वरण꣫\n— 1〉 Adj. (f. आ꣫) eilend, so v. a. durch Eile oder Anstrengung, von Schweiss entstanden.\n— 2〉 *n. das Eilen.", "gloss_language": "de"}], "synonyms": ["त्वरणं"], "synonyms_slp1": ["tvaraRaM"]}], "tvaraRiya": [{"id": "tvaraRIya", "headword": "त्वरणीय", "headword_slp1": "tvaraRIya", "fold": "tvaraRiya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त्वरणीय Adj. wobei mit Eile zu Werke zu gehen ist.", "gloss_language": "de"}]}], "tvarayaRa": [{"id": "tvarAyaRa", "headword": "त्वरायण", "headword_slp1": "tvarAyaRa", "fold": "tvarayaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*त्वरायण n. nebem तुरायण als v. l. von परायन.", "gloss_language": "de"}]}], "tvarayasy": [{"id": "tvarAyasy", "headword": "त्वरायस्य्", "headword_slp1": "tvarAyasy", "fold": "tvarayasy", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*!√त्वरायस्य्, ˚स्यति eilen.", "gloss_language": "de"}]}], "tvararoha": [{"id": "tvarAroha", "headword": "त्वरारोह", "headword_sl