{"BOma": [{"id": "BOma", "headword": "भौम", "headword_slp1": "BOma", "fold": "BOma", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. भौम꣫\n— 1〉 Adj. (f. ई)\n — a〉 der Erde gehörig, — geweiht (TS. 5,5,18,1. 6,21,1), zur E. in Beziehung stehend, von ihr kommend, auf oder in der E. befindlich, irdisch. नरक m. so v. a. die Hölle auf Erden, ब्रह्मन् n. so v. a. der Veda.\n — b〉 aus Erde bestehend, erdig, irden.\n — c〉 *von Lande einkommend (Abgabe).\n— 2〉 m.\n — a〉 *Ambra (?).\n — b〉 *eine rothblühende Punarnavā RĀJAN. 5,119.\n — c〉 Bez. des 27sten [] Muhūrta.\n — d〉 Metron.\n — α〉 eines best. Erdgenius.\n — β〉 des Atri.\n — γ〉 des Daitya Naraka.\n — δ〉 des Planeten Mars. Sein Tag ist Dienstag.\n— 3〉 *f. ई Metron. der Sītā.\n— 4〉 n.\n — a〉 Pl. Erdenstaub.\n — b〉 Getraide ĀPAST.\n — c〉 Boden, Diele; nur am Ende eines adj. Comp.\n — d〉 Stockwerk; nur am Ende eines adj. Comp.", "gloss_language": "de"}, {"gloss": "2. भौम Adj. zu Mars —, zu seinen Tage (dem Dienstage) in Beziehung stehend, an einem solchen Tage geschehend.", "gloss_language": "de"}, {"gloss": "भौम IV. KAUŚ. 38,12 Bez. des Liedes AV. 12,1.", "gloss_language": "de"}], "synonyms": ["भौमः"], "synonyms_slp1": ["BOmaH"]}], "BOmaka": [{"id": "BOmaka", "headword": "भौमक", "headword_slp1": "BOmaka", "fold": "BOmaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भौमक m. ein in der Erde lebendes Thier.", "gloss_language": "de"}], "synonyms": ["भौमकः"], "synonyms_slp1": ["BOmakaH"]}], "BOmadevalipi": [{"id": "BOmadevalipi", "headword": "भौमदेवलिपि", "headword_slp1": "BOmadevalipi", "fold": "BOmadevalipi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भौमदेवलिपि f. eine best. Art zu schreiben.", "gloss_language": "de"}]}], "BOmana": [{"id": "BOmana", "headword": "भौमन", "headword_slp1": "BOmana", "fold": "BOmana", "headword_l