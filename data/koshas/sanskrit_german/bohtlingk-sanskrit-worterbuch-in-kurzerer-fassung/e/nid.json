{"nid": [{"id": "nid", "headword": "निद्", "headword_slp1": "nid", "fold": "nid", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √निद् (nur in der ältesten Sprache und nur in den Formen निनिदु꣫स्, निदान꣫ und निद्य꣫मान), √निन्द्, नि꣫न्दति (episch auch Med.).\n— 1〉 verspotten, schmähen, verachten, schelten, tadeln, schimpfen auf. निदान꣫ verspottet. निन्दित gescholten, getadelt, mit einem Makel behaftet, verrufen, verboten.\n— 2〉 verspotten, so v. a. übertreffen 251,3. BHOJA-PR. 71,24.\n— Desid. नि꣫नित्सति zu verspotten Lust haben — निनीत्सेत ĀŚV. ŚR. 9,11,1. vielleicht bezichtigen, beschuldigen.\n— Mit परिनि (*पअरिणि) heftig schmähen, — tadeln.\n— Mit *प्र (प्रनि˚ oder प्रणि˚) schelten.\n— Mit प्रति tadeln, schmähen auf.\n— Mit वि tadeln, schmähen, schelten.", "gloss_language": "de"}, {"gloss": "2. नि꣫द्\n— 1〉 f.\n — a〉 Spott, Schmähung, Verachtung.\n — b〉 Spötter, Verächter.\n— 2〉 am Ende eines Comp. Adj. schmähend, verachtend.", "gloss_language": "de"}]}], "nida": [{"id": "nida", "headword": "निद", "headword_slp1": "nida", "fold": "nida", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*निद n. Gift.", "gloss_language": "de"}], "synonyms": ["निदं"], "synonyms_slp1": ["nidaM"]}, {"id": "nidA", "headword": "निदा", "headword_slp1": "nidA", "fold": "nida", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "नि꣫दा f. Schmähung, Verachtung.", "gloss_language": "de"}]}], "nidaRqa": [{"id": "nidaRqa", "headword": "निदण्ड", "headword_slp1": "nidaRqa", "fold": "nidaRqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*निदण्ड Adj. der den Stock niedergelegt hat.", "gloss_language": "de"}]}], "nidadru": [{"id": "nidadru", "headword": "निदद्रु", "headword_slp1": "nidadru", "fold": "nidadru", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*निदद्रु m. Mensch.", "gloss_language": "de"}], "synonyms": ["निदद्रुः"], "synonyms_slp1": ["nidadruH"]}], "nidarsaka": [{"id": "nidarSaka", "headword": "निदर्शक", "headword_slp1": "nidarSaka", "fold": "nidarsaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदर्शक Adj.\n— 1〉 eine Einsicht habend in, schauend.\n— 2〉 anzeigend, verkündend.", "gloss_language": "de"}]}], "nidarsana": [{"id": "nidarSana", "headword": "निदर्शन", "headword_slp1": "nidarSana", "fold": "nidarsana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई)\n — a〉 hindeutend auf, zeigend, verkündend, lehrend.\n — b〉 zusagend, gefallend. निदर्शिन् v. l.\n— 2〉 f. आ die Erweckung des Verhältnisses von Bild und Gegenbild durch eine mögliche oder unmögliche Verknüpfung von Dingen KĀVYAPR. 10,11.\n— 3〉 n. (adj. Comp. f. आ)\n — a〉 das Schauen, Sehen.\n — b〉 Hinweisung auf.\n — c〉 das Zeigen.\n — d〉 Beleg, Beispiel. Nom. abstr. ˚त्व m. NAIṢ. 7,75.\n — e〉 ein Beleg für die Unhaltbarkeit einer ausgesprochenen Ansicht.\n — f〉 Anzeichen, Symptom, Vorzeichen, Vorbedeutung. प्रीति˚ Adj. so v. a. zeugend von Freundschaft.\n — g〉 Schema, System.", "gloss_language": "de"}, {"gloss": "निदर्शन III. Am Ende eines adj. Comp. *Aussehen MAHĀVY. 71,3. fgg.", "gloss_language": "de"}], "synonyms": ["निदर्शनं"], "synonyms_slp1": ["nidarSanaM"]}], "nidarsayitavya": [{"id": "nidarSayitavya", "headword": "निदर्शयितव्य", "headword_slp1": "nidarSayitavya", "fold": "nidarsayitavya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदर्शयितव्य Adj. zu Gesicht zu bringen, vorzuführen, zu zeigen.", "gloss_language": "de"}]}], "nidarsin": [{"id": "nidarSin", "headword": "निदर्शिन्", "headword_slp1": "nidarSin", "fold": "nidarsin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚निदर्शिन् Adj.\n— 1〉 schauend, eine Einsicht habend in, vertraut mit.\n— 2〉 zusagend, gefallend.", "gloss_language": "de"}]}], "nidaGa": [{"id": "nidAGa", "headword": "निदाघ", "headword_slp1": "nidAGa", "fold": "nidaGa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदाघ꣫ m.\n— 1〉 Hitze, die heisse Zeit, Sommer.\n— 2〉 N. pr. verschiedener Männer.", "gloss_language": "de"}], "synonyms": ["निदाघः"], "synonyms_slp1": ["nidAGaH"]}], "nidaGakara": [{"id": "nidAGakara", "headword": "निदाघकर", "headword_slp1": "nidAGakara", "fold": "nidaGakara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*निदाघकर m. die Sonne.", "gloss_language": "de"}], "synonyms": ["निदाघकरः"], "synonyms_slp1": ["nidAGakaraH"]}], "nidaGavaDi": [{"id": "nidAGAvaDi", "headword": "निदाघावधि", "headword_slp1": "nidAGAvaDi", "fold": "nidaGavaDi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदाघावधि m. die heisse Jahreszeit.", "gloss_language": "de"}]}], "nidatar": [{"id": "nidAtar", "headword": "निदातर्", "headword_slp1": "nidAtar", "fold": "nidatar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदात꣫र् Nom. ag. Anbinder.", "gloss_language": "de"}]}], "nidana": [{"id": "nidAna", "headword": "निदान", "headword_slp1": "nidAna", "fold": "nidana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदा꣫न n.\n— 1〉 Band, Strick, Halfter ĀPAST. ŚR. 1,11,5.\n— 2〉 Grundursache, Wesen, Grundform, Ursache überh.\n— 3〉 निदा꣫नेन Instr. ursprünglich, [] wesentlich, eigentlich.\n— 4〉 = निदानस्थान und ein Abschnitt in dieser Lehre.\n— 5〉 bei den Buddhisten eine best. Klasse von Werken KĀRAṆḌ. 81,21.\n— 6〉 Titel eines Werkes über Metra und Stoma.\n— 7〉 *Ende, Untergang.\n— 8〉 *Reinigung; vgl. 7. दा\n— 9〉 *die Forderung des Lohnes für Askese.", "gloss_language": "de"}, {"gloss": "निदान 6〉 vgl. VASIṢṬHA 1,14.", "gloss_language": "de"}, {"gloss": "निदान III. 5. Veranlassung DIVYĀVAD. 123,16. 198,1. 654,21. MAHĀVY. 281,10.", "gloss_language": "de"}], "synonyms": ["निदानं"], "synonyms_slp1": ["nidAnaM"]}], "nidanavant": [{"id": "nidAnavant", "headword": "निदानवन्त्", "headword_slp1": "nidAnavant", "fold": "nidanavant", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदा꣫नवन्त् Adj. auf einem Grunde fussend oder wesenhaft.", "gloss_language": "de"}], "synonyms": ["निदानवत्"], "synonyms_slp1": ["nidAnavat"]}], "nidanasutra": [{"id": "nidAnasUtra", "headword": "निदानसूत्र", "headword_slp1": "nidAnasUtra", "fold": "nidanasutra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदानसूत्र n. = निदान 6〉.", "gloss_language": "de"}]}], "nidanasTana": [{"id": "nidAnasTAna", "headword": "निदानस्थान", "headword_slp1": "nidAnasTAna", "fold": "nidanasTana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदानस्थान n. die Lehre von den Ursachen und dem Wesen der Krankheiten, Pathologie.", "gloss_language": "de"}]}], "nidanarTakara": [{"id": "nidAnArTakara", "headword": "निदानार्थकर", "headword_slp1": "nidAnArTakara", "fold": "nidanarTakara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निदानार्थकर Adj. als Ursache wirkend BHĀVAPR. 2,169.", "gloss_language": "de"}]}], "nidigDa": [{"id": "nidigDa", "headword": "निदिग्ध", "headword_slp1": "nidigDa", "fold": "nidigDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "नि꣫दिग्ध\n— 1〉 Adj. s. u. 1. दिह् mit नि.\n— 2〉 *f. आ Kardam