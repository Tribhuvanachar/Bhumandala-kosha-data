{"hEma": [{"id": "hEma", "headword": "हैम", "headword_slp1": "hEma", "fold": "hEma", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. हैम\n— 1〉 Adj.\n — a〉 von Schnee oder Eis herrührend.\n — b〉 mit Schnee bedeckt.\n — c〉 vom Himālaya kommend, zum H. in Beziehung stehend.\n— 2〉 m. N. pr. eines Berges.", "gloss_language": "de"}, {"gloss": "2. हैम Adj. von Hema —, d. i. Hemacandra verfasst; m. das von ihm verfasste Wörterbuch.", "gloss_language": "de"}, {"gloss": "3. हैम\n— 1〉 Adj. (f. ई) von Gold, Golden.\n— 2〉 *m. Gentiana chirayita^1.\n— 3〉 *f. आ gelber Jasmin. []\n— 4〉 *f. ई\n — a〉 dass.\n — b〉 Pandanus odoratissimus.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}], "synonyms": ["हैमं", "हैमः"], "synonyms_slp1": ["hEmaM", "hEmaH"]}], "hEmakuwa": [{"id": "hEmakUwa", "headword": "हैमकूट", "headword_slp1": "hEmakUwa", "fold": "hEmakuwa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हैमकूट m. Pl. die Bewohner des Hemakūṭa.", "gloss_language": "de"}]}], "hEmagirika": [{"id": "hEmagirika", "headword": "हैमगिरिक", "headword_slp1": "hEmagirika", "fold": "hEmagirika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हैमगिरिक m. Pl. die Bewohner des Hemagiri.", "gloss_language": "de"}]}], "hEmacandri": [{"id": "hEmacandri", "headword": "हैमचन्द्रि", "headword_slp1": "hEmacandri", "fold": "hEmacandri", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हैमचन्द्रि m. Patron. von हेमचन्द्र.", "gloss_language": "de"}]}], "hEmacarci": [{"id": "hEmacarci", "headword": "हैमचर्चि", "headword_slp1": "hEmacarci", "fold": "hEmacarci", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung