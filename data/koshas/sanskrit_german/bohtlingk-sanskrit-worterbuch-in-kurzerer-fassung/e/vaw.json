{"vaw": [{"id": "vaw", "headword": "वट्", "headword_slp1": "vaw", "fold": "vaw", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √वट्, *वटति (वेष्टने, परिभाषणे), *वटयति (ग्रन्थे, वेष्टने, विभाजने). Zu belegen nur वट्यन्ते sie werden zerstossen VIṢṆUS. 43,38. Vgl. चट्.", "gloss_language": "de"}, {"gloss": "2. व꣫ट् ein Opferausruf ĀPAST. ŚR. 1,4,2 (vgl. TAITT. ĀR. 4,9,3).", "gloss_language": "de"}]}, {"id": "vaww", "headword": "वट्ट्", "headword_slp1": "vaww", "fold": "vaw", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√वट्ट्, वट्टति PAT. zu P. 1,3,1, Vārtt. 12.", "gloss_language": "de"}]}, {"id": "vAw", "headword": "वाट्", "headword_slp1": "vAw", "fold": "vaw", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वा꣫ट् ein Opferruf, etwa so v. a. nimm oder bringe.", "gloss_language": "de"}]}], "vawa": [{"id": "vawa", "headword": "वट", "headword_slp1": "vawa", "fold": "vawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 Ficus indica. ˚तरु 111,7.\n — b〉 ein best. Vogel.\n — c〉 Cypraea moneta, Otterköpfchen. Hierher vielleicht ˚भूषण n. PAÑCAD.\n — d〉 Bauer im Schachspiel.\n — e〉 *Schwefel RĀJAN. 13,70.\n — f〉 *= साम्य.\n — g〉 N. pr.\n — α〉 eines Tīrtha VIṢṆUS. 85,5. 66.\n — β〉 eines Wesens im Gefolge Skandaʼs.\n— 2〉 m. f. (ई) n. Strick. Zu belegen nur वट˚.\n— 3〉 (*m.) f. (ई) Klösschen, Knöpfchen, Kügelchen, Pille.\n— 4〉 f. ई\n — a〉 *ein best. Baum RĀJAN. 11,121.\n — b〉 गाढा eine best. Lage im Spiel Caturaṅga.", "gloss_language": "de"}], "synonyms": ["वटः"], "synonyms_slp1": ["vawaH"]}, {"id": "vawwa", "headword": "वट्ट", "headword_slp1": "vawwa", "fold": "vawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वट्ट (बट्ट) m. N. pr. eines Mannes.", "gloss_language": "de"}]}, {"id": "vAwa", "headword": "वाट", "headword_slp1": "vAwa", "fold": "vawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वाट Adj. aus der Ficus indica gemacht.", "gloss_language": "de"}, {"gloss": "2. वाट\n— 1〉 m.\n — a〉 Einzäunung, ein eingehegter Platz. Häufig in Comp. mit dem, was sich innerhalb desselben befindet oder darin vorgeht.\n — b〉 Bezirk.\n — c〉 Weg VĀSAV. 233,3\n — d〉 *= वास्तु.\n— 2〉 f. ई\n — a〉 ein eingehegter Platz, Garten.\n — b〉 *Hütte.\n — c〉 ein best. Vogel CARAKA. 1,27.\n — d〉 = वास्तु.\n— 3〉 *n. = वरण्ड, अङ्ग und अन्नभेद.", "gloss_language": "de"}], "synonyms": ["वाटं", "वाटः"], "synonyms_slp1": ["vAwaM", "vAwaH"]}], "vawaka": [{"id": "vawaka", "headword": "वटक", "headword_slp1": "vawaka", "fold": "vawaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. (VASIṢṬHA 14,37. CARAKA. 6,18), f. वटका (DHŪRTAN. 35) und वटिका (LALIT. 186,11. 226,1. 249,1. PAÑCAT. ed. Bomb. 5,59,9) n. Kügelchen, Pille; Knöpfchen, Klösschen (gewöhnlich aus Mehl von Hülsenfrüchten, eingeweicht, gewürzt und in Oel geschmort). वटकाद्रि Spr. 7616.\n— 2〉 m. ein best. Gewicht, = 8 Māṣa = 2 Śāṇa.\n— 3〉 f. वटिक Schachfigur, insbes. der Bauer.", "gloss_language": "de"}], "synonyms": ["वटकः"], "synonyms_slp1": ["vawakaH"]}, {"id": "vawwaka", "headword": "वट्टक", "headword_slp1": "vawwaka", "fold": "vawaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वट्टक m. Kügelchen BHADRAB. 1,53. 54. 60. Vgl. वटक.", "gloss_language": "de"}], "synonyms": ["वट्टकः"], "synonyms_slp1": ["vawwakaH"]}, {"id": "vAwaka", "headword": "वाटक", "headword_slp1": "vAwaka", "fold": "vawaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. ein eingehegter Platz, Garten HEMĀDRI 1,657,5.\n— 2〉 f. ˚