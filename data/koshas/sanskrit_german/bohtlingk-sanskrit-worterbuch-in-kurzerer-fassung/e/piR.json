ngk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "!√पिण्डय्, ˚यति (angeblich auch पिण्डते)\n— 1〉 zusammenthun, vereinigen. एकत्र so v. a. zusammenaddiren.\n— 2〉 पिण्डित\n — a〉 geballt, massig, klumpig, aufeinandergehäuft, dicht zusammengedrängt. Am Ende eines Comp. gemischt mit VARĀH. BṚH. S. 77,11.\n — b〉 Pl. Zusammengenommen, zu einem Ganzen verbunden, unter einander verbunden, vereinigt, alle zusammen.\n — c〉 in Comp. mit einem Zahlwort sich so und so viele Male wiederholend.\n — d〉 *multiplicirt.\n— Mit अव, ˚पिण्डित als Kügelchen niedergefallen.\n— Mit उद्, उत्पिण्डित geschwollen CARAKA. 2,7. (उत्पिण्डन gedr.).\n— Mit परि, ˚पिण्डित zusammengeballt MAHĀVĪRAC. 79,8. BHĀVAPR. 2,152.\n— Mit सम् zusammenhäufen, aneinanderreihen. संपिण्डित zusammengeballt, -gezogen, vereinigt.", "gloss_language": "de"}]}], "piRqayajYa": [{"id": "piRqayajYa", "headword": "पिण्डयज्ञ", "headword_slp1": "piRqayajYa", "fold": "piRqayajYa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पिण्डयज्ञ m. ein Manenopfer mit Mehlklössen.", "gloss_language": "de"}], "synonyms": ["पिंडयज्ञ", "पिण्डयज्ञः"], "synonyms_slp1": ["piMqayajYa", "piRqayajYaH"]}], "piRqarohaRika": [{"id": "piRqarohaRika", "headword": "पिण्डरोहणिक", "headword_slp1": "piRqarohaRika", "fold": "piRqarohaRika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*पिण्डरोहणिक m. Flacourtia sapida RĀJAN. 9,162.", "gloss_language": "de"}]}], "piRqala": [{"id": "piRqala", "headword": "पिण्डल", "headword_slp1": "piRqala", "fold": "piRqala", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*पिण्डल m. Damm, Wall.", "gloss_language": "de"}], "synonyms": ["पिंडल", "पिंडलः", "पिण्डलः"], "synonyms_slp1": ["piMqala", "piMqalaH", "piRqalaH"]}], "piRqalaksaRasiksa": [{"id": "piRqalakzaRaSikzA", "headword": "पिण्डलक्षणशिक्षा", "headword_slp1"