{"tas": [{"id": "tas", "headword": "तस्", "headword_slp1": "tas", "fold": "tas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√तंस्, √तस्\n— 1〉 nur (उप) अतसत् und ततस्रे 1〉 ausschütten (eines Wunsch).\n— 2〉 *तंसति (अलंकारे).\n— Caus. तसयति\n— 1〉 schütteln, hinundher ziehen.\n— 2〉 *अलकारे.\n— Mit अभि berauben, rauben.\n— Mit आ Caus. ausschütten.\n— Mit उप ruckweise anstossen, — eintreiben, subigere.\n— Mit निस् Caus. (अ꣫ततंसतम्) herausschütteln.\n— Mit परा in ˚तंस.\n— Mit परि Caus. rühren in ˚तंसय꣫ध्यै.\n— Mit वि [] erschüttern, bestürmen. Intens. (˚तंन्तसै꣫ते) ringen, sich bekämpfen ṚV. 6,25,6.", "gloss_language": "de"}, {"gloss": "1. *√तस्, तस्यते (उपक्षये, उपक्षेपे, उत्क्षेपे).", "gloss_language": "de"}, {"gloss": "2. *˚तस् Adj. werfend in *सुखतस्.", "gloss_language": "de"}]}], "tasli": [{"id": "taSlI", "headword": "तश्ली", "headword_slp1": "taSlI", "fold": "tasli", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तश्ली = تثْليث Gedrittschein.", "gloss_language": "de"}]}], "taswar": [{"id": "tazwar", "headword": "तष्टर्", "headword_slp1": "tazwar", "fold": "taswar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त꣫ष्टर् m.\n— 1〉 Werkmeister, Zimmermann, Wagner.\n— 2〉 *Bein. Viśvakarmanʼs.\n— 3〉 N. pr. eines Āditya.", "gloss_language": "de"}]}], "tasara": [{"id": "tasara", "headword": "तसर", "headword_slp1": "tasara", "fold": "tasara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "त꣫सर (*m.) n. Weberschiff. Nach TBR. Comm. 2,670 das Tuch im Webstuhl.", "gloss_language": "de"}], "synonyms": ["तसरः"], "synonyms_slp1": ["tasaraH"]}], "tasira": [{"id": "tasIra", "headword": "तसीर", "headword_slp1": "tasIra", "fold": "tasira", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung"