{"Dira": [{"id": "DIra", "headword": "धीर", "headword_slp1": "DIra", "fold": "Dira", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. धीर Adj. (f. आ)\n— 1〉 anhaltend, beständig, fest, unbeweglich. धीरम् Adv. mit विलोकय् ruhigen Auges.\n— 2〉 lange nachtönend, tief, dumpf. धीरम् und धीर˚ Adv.\n— 3〉 fest auf Etwas (im Comp. vorangehend) bestehend, beharrlich, standhaft, charakterfest, entschlossen, beherzt (auch von einer bes. Art von Heroine).\n— 4〉 *= मन्द und विनीत.", "gloss_language": "de"}, {"gloss": "2. धी꣫र Adj. (f. धीरी꣫ und धीरा) verständig, klug, weise; geschickt, kunstfertig, sich verstehend auf (Loc. eines Nom. act.). Compar. धी꣫रतर.", "gloss_language": "de"}, {"gloss": "3. धी꣫र\n— 1〉 m.\n — a〉 *das Meer.\n — b〉 *eine best. Arzeneipflanze.\n — c〉 *Bein.\n — α〉 eines Buddha.\n — β〉 des Fürsten Bali.\n — d〉 N. pr. verschiedener Männer.\n— 2〉 f. धीरा\n — a〉 *ein berauschendes Getränk.\n — b〉 Bez. verschiedener Pflanzen, = काकोली, क्षीरकाकोली, महाज्योतिष्मती, मेदा, श्वेतवचा und Rosa glandulifera RĀJAN. 3,13. 73. 9,132. BHĀVAPR. 1,170,196.\n — c〉 N. pr. einer Frau.\n— 3〉 *n. Safran.", "gloss_language": "de"}], "synonyms": ["धीरं", "धीरः"], "synonyms_slp1": ["DIraM", "DIraH"]}], "Diragovindasarman": [{"id": "DIragovindaSarman", "headword": "धीरगोविन्दशर्मन्", "headword_slp1": "DIragovindaSarman", "fold": "Diragovindasarman", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धीरगोविन्दशर्मन् m. N. pr. eines Autors.", "gloss_language": "de"}]}], "Diracetas": [{"id": "DIracetas", "headword": "धीरचेतस्", "headword_slp1": "DIracetas", "fold": "Diracetas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "धीरचेतस् Adj. festen Sinnes, beherzt KATHĀS. 18,97. सागर˚ dessen Geist standhaft ist wie das Meer RAGH. 18,3.", "gloss_language": "de"}]}], "DiraRa": [{"id": "DIraRa", "headword": 