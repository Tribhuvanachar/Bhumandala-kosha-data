orterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शिखण्डिमन्त् Adj. reich an Pfauen.", "gloss_language": "de"}], "synonyms": ["शिखण्डिमत्"], "synonyms_slp1": ["SiKaRqimat"]}], "siKara": [{"id": "SiKara", "headword": "शिखर", "headword_slp1": "SiKara", "fold": "siKara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. spitzig, zackig.\n— 2〉 m. n.\n — a〉 Bergspitze (HEMĀDRI 1,394,11. fgg.), Baumgipfel, Giebel, Zinne oder Thurm, Spitze überh., ein spitzer Gegenstand. पृष्ठ˚ ein berghoher Rücken.\n — b〉 *das Sträuben der Härchen am Körper.\n — c〉 *ein Rubinstücken von der Farbe eines reifen Granatkorns.\n — d〉 *Achselgrube (Achsel?).\n— 3〉 m.\n — a〉 eine best. Stellung der Hand.\n — b〉 N. pr. eines Mannes.\n— 4〉 f. आ\n — a〉 Sansevieria roxburghiana.\n — b〉 eine best. mythische Keule.\n— 5〉 f. ई\n — a〉 = 4〉b〉.\n — b〉 *= कर्कटशृङ्गी RĀJAN. 6,158.\n— 6〉 n.\n — a〉 Gewürznelke.\n — b〉 eine best. mythisches Geschoss.", "gloss_language": "de"}], "synonyms": ["शिखरं", "शिखरः"], "synonyms_slp1": ["SiKaraM", "SiKaraH"]}], "siKaradati": [{"id": "SiKaradatI", "headword": "शिखरदती", "headword_slp1": "SiKaradatI", "fold": "siKaradati", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शिखरदती Adj. f. spitzzähnig Citat bei VĀMANA.", "gloss_language": "de"}]}], "siKaravasini": [{"id": "SiKaravAsinI", "headword": "शिखरवासिनी", "headword_slp1": "SiKaravAsinI", "fold": "siKaravasini", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*शिखरवासिनी f. Bein. der Durgā.", "gloss_language": "de"}]}], "siKarasena": [{"id": "SiKarasena", "headword": "शिखरसेन", "headword_slp1": "SiKarasena", "fold": "siKarasena", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शिखरसेन m. N. pr. eines Mannes MUDRĀR. 82,7 (136,14).", "gloss_language": "de"}