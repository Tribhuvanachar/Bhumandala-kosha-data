{"siKa": [{"id": "SiKa", "headword": "शिख", "headword_slp1": "SiKa", "fold": "siKa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शिख m. N. pr. eines Schlangendämons. शि꣫खा f. s. bes.", "gloss_language": "de"}]}, {"id": "SiKA", "headword": "शिखा", "headword_slp1": "SiKA", "fold": "siKa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शि꣫खा f. (adj. Comp. f. आ)\n— 1〉 Strähne —, Strang von Haaren, Haarbusch.\n— 2〉 Pfauenkamm.\n— 3〉 Flamme Spr. 7846.\n— 4〉 Strahl.\n— 5〉 *Zweig.\n— 6〉 *eine faserige Wurzel.\n— 7〉 *Jussiaea repens.\n— 8〉 Spitze überh. (292,17), Saum (eines Gewandes).\n— 9〉 = शिखवृद्ध GAUT. 12,35.\n— 10〉 *Kopf.\n— 11〉 *Brustwarze RĀJAN. 18,40. Vgl. स्तन˚.\n— 12〉 *Fussspitze.\n— 13〉 Bez. eines best. Theiles eines Spruches (der Haarbusch des als Fürsten gedachten Spruches).\n— 14〉 *das Beste in seiner Art.\n— 15〉 Name verschiedener Metra.\n— 16〉 *Liebesfieber.\n— 17〉 N. pr. eines Flusses VP.² 2,193. Richtig शिखी.\n— 18〉 R. 5,12,32 fehlerhaft für शाला.", "gloss_language": "de"}]}, {"id": "sIKA", "headword": "सीखा", "headword_slp1": "sIKA", "fold": "siKa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सीखा f. N. pr. eines Dorfes.", "gloss_language": "de"}]}], "siKaka": [{"id": "SiKaka", "headword": "शिखक", "headword_slp1": "SiKaka", "fold": "siKaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*शिखक m. = लेखक.", "gloss_language": "de"}], "synonyms": ["शिखकः"], "synonyms_slp1": ["SiKakaH"]}], "siKaRqa": [{"id": "SiKaRqa", "headword": "शिखण्ड", "headword_slp1": "SiKaRqa", "fold": "siKaRqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शिखण्ड꣫\n— 1〉 m. (adj. Comp. f. आ)\n — a〉 Haarstrang, -büschel. Vgl. च꣫तुःशिखण्ड.\n — b〉 Pfauenschwanz.\n — c〉 eines best. Pflanze.\n— 2〉 *f. शिखण्डी gaṇa गौरादि.\n — a〉 Abrus precatorius RĀJAN. 3,101.\n — b〉 gelber Jasmin RĀJAN. 10,98.", "gloss_language": "de"}], "synonyms": ["शिखंड", "शिखंडः", "शिखण्डः"], "synonyms_slp1": ["SiKaMqa", "SiKaMqaH", "SiKaRqaH"]}], "siKaRqaka": [{"id": "SiKaRqaka", "headword": "शिखण्डक", "headword_slp1": "SiKaRqaka", "fold": "siKaRqaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 = शिखण्ड 1〉a〉.\n — b〉 = शिखण्ड 1〉b〉.\n — c〉 Du. (nach dem Comm. n.) die unterhalb der Hinterbacke gelegenen Fleischtheile TS. 5,7,15,1.\n — d〉 bei den mystischen Śaiva ein Erlöster best. Art HEMĀDRI 1,823,6. Vgl. शिखण्डिक und शिखण्डिन्\n— 2〉 *f. ˚ण्डिका = शिखण्ड 1〉a〉.", "gloss_language": "de"}], "synonyms": ["शिखंडक", "शिखंडकः", "शिखण्डकः"], "synonyms_slp1": ["SiKaMqaka", "SiKaMqakaH", "SiKaRqakaH"]}, {"id": "SiKARqaka", "headword": "शिखाण्डक", "headword_slp1": "SiKARqaka", "fold": "siKaRqaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*शिखाण्डक m. = शिखण्ड 1〉.", "gloss_language": "de"}], "synonyms": ["शिखाण्डकः"], "synonyms_slp1": ["SiKARqakaH"]}], "siKaRqasTa": [{"id": "SiKaRqAsTa", "headword": "शिखण्डास्थ", "headword_slp1": "SiKaRqAsTa", "fold": "siKaRqasTa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "शिखण्डास्थ꣫ n. Du. Bez. bestimmter Knochen ŚAT. BR. 4,5,7,5. Vgl. शिखण्डक 1〉c〉.", "gloss_language": "de"}]}], "siKaRqika": [{"id": "SiKaRqika", "headword": "शिखण्डिक", "headword_slp1": "SiKaRqika", "fold": "siKaRqika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 *Hahn.\n — b〉 = शिखण्डक 1〉d〉 HEMĀDRI 1,611,9.\n— 2〉 *(wohl n.) eine Art [] Rubin GARBE zu RĀJAN. 13,151.", "gloss_language": "de"}], "synonyms": ["शिखंडिक", "शिखंडिकः", "शिखण्डिकः"], "synonyms_slp1": 