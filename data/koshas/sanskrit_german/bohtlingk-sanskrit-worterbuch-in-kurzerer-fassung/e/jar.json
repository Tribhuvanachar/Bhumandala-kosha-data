{"jaras": [{"id": "jaras", "headword": "जरस्", "headword_slp1": "jaras", "fold": "jaras", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अतिजर und *जरस् Adj. von hohem Alter.", "gloss_language": "de"}, {"gloss": "जर꣫स्\n— 1〉 f. das Altwerden, Absterben, Gebrechlichkeit, Alter.\n— 2〉 m. N. pr. eines Sohnes des Vasudeva.", "gloss_language": "de"}]}], "jar": [{"id": "jar", "headword": "जर्", "headword_slp1": "jar", "fold": "jar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √जर्\n— 1〉 ज꣫रति (nur in der ältesten Sprache)\n — a〉 gebrechlich —, alt machen.\n — b〉 alt werden lassen.\n — c〉 *न्यक्कारे.\n — d〉 ज꣫रन्त् (auch klassisch; f. ज꣫रती)\n — α〉 gebrechlich, alt, greis, dürr (Reis), verfallen, nicht mehr im Gebrauch seiend; m. Greis.\n — β〉 früher, ehemalig.\n— 2〉 जी꣫र्यति (seltener Med.)\n — a〉 gebrechlich werden, in Verfall kommen, sich abnutzen, — aufzehren, morsch werden, dahingehen, altern. जीर्यन्त् und जीर्यमाण (ausnahmsweise) alternd. जागार ist alt geworden AV. 5,19,10. जीर्ण꣫ gebrechlich, abgelebt, abgenutzt, zer-, verfallen, dürr, morsch, dahingegangen, alt geworden, zu Nichte gemacht durch (Instr.), alt (auch als Gegensatz von neu, frisch CARAKA. 1,27). संप्रदाय m. eine alte Ueberlieferung Comm. zu KĀTY. ŚR. 9,4,28. 10,1,13. 19,1,21. 26,4,14.\n — b〉 sich auflösen, verdaut werden CARAKA. 1,27. जीर्ण verdaut. मानसे सुखदुःखानि so v. a. zurückgehalten Spr. 6254.\n— 3〉 *जृणाति (वयोहानौ).\n— Caus.\n— 1〉 जर꣫यति (episch auch Med.)\n — a〉 aufreiben, abnutzen, verzehren, altern machen.\n — b〉 verdauen CARAKA. 1,21.\n — c〉 machen, dass Etwas verdaut wird.\n— 2〉 *जारयति (वयोहानौ).\n— Mit *अनु mit Jmd (Acc.) altern. ˚जीर्ण mit act., pass. und impers. Bed.\n— Mit निस् Caus. (˚जरयति) zerreiben, zermalmen.\n— Mit परि\n— 1〉 ˚जीर्यन्त् alternd. ˚जीर्ण ganz abgenutzt (Kleider LALIT. 332,9), welk, alt (Gemüse).\n— 2〉 ˚जीर्यति, ˚ते verdaut werden.\n— Mit प्र, ˚जीर्यति verdaut werden. ˚जीर्ण verdaut CARAKA. 1,15.\n— Mit सम्, संजीर्यति zusammen alt werden MAITR. S. 1,8,4.", "gloss_language": "de"}, {"gloss": "2. √जर्, ज꣫रते wach —, lebendig werden (vgl. 3. गर्); sich in Bewegung setzen, sich nähern, herbeikommen; mit Acc. ṚV. 8,2,12.\n— Caus. जर꣫यति und जा˚ (Padap. ज˚) in Bewegung setzen, lebendig machen ṚV. 1,48,5. 124,10. 7,75,5.", "gloss_language": "de"}, {"gloss": "3. √जर्, ज꣫रते\n— 1〉 knistern, rauschen (vom Feuer).\n— 2〉 sich hören lassen, rufen, anrufen.\n— Mit प्रति [] entgegenrauschen, zurufen, begrüssen.\n— Mit सम् ertönen.", "gloss_language": "de"}]}], "jara": [{"id": "jara", "headword": "जर", "headword_slp1": "jara", "fold": "jara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. alternd in अ˚. जरं च (जरञ्च) Comm. zu AV. PRĀT. 4,53 fehlerhaft für जरच्च.\n— 2〉 ज꣫र m. Abnutzung, Aufreibung.\n— 3〉 f. जरा꣫\n — a〉 dass. Spr. 236. fg. das Altwerden, Alter. Pl. Spr. 1103, v. l. wohl fehlerhaft. Personificirt als Tochter des Todes.\n — b〉 das Verdautwerden CARAKA. 3,1. 3. 6,26.\n — c〉 *eine Art Dattelbaum.\n — d〉 N. pr. einer Rākṣasī.", "gloss_language": "de"}], "synonyms": ["जरः"], "synonyms_slp1": ["jaraH"]}, {"id": "jarA", "headword": "जरा", "headword_slp1": "jarA", "fold": "jara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. जरा꣫ f. s. जर 3〉.", "gloss_language": "de"}, {"gloss": "2. जरा꣫ f. das Rauschen u. s. w. Ruf, Gruss.", "gloss_language": "de"}]}, {"id": "jAra", "headword": "जार", "headword_slp1": "jAra", "fold": "jara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. जा꣫र Adj. alternd.", "gloss_language": "de"}, {"gloss": "2. जार꣫ m. Buhle. In der alten Sprache nicht nothwendig mit schlimmer Nebenbedeutung. Auch Vertrauter überh. In der späteren Sprache der Buhle einer verheiratheten Frau, Nebenmann. Am Ende eines adj. Comp. f. आ 155,24.", "gloss_language": "de"}], "synonyms": ["जारः"], "synonyms_slp1": ["jAraH"]}], "jaraka": [{"id": "jaraka", "headword": "जरक", "headword_slp1": "jaraka", "fold": "jaraka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*जरक n. Asa foetida NIGH. PR.", "gloss_language": "de"}]}], "jarawi": [{"id": "jarawI", "headword": "जरटी", "headword_slp1": "jarawI", "fold": "jarawi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*जरटी f. = जरडी RĀJAN. 8,131.", "gloss_language": "de"}]}], "jaraWa": [{"id": "jaraWa", "headword": "जरठ", "headword_slp1": "jaraWa", "fold": "jaraWa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj.\n — a〉 alt, bejahrt.\n — b〉 *gelblich.\n — c〉 hart. Richtig जठर.\n — d〉 stark, heftig, intensiv HARṢAC. 32,18 VIKRAMĀṄKAC. 12,78. Nom. abstr. ˚त्व n. 11,44.\n— 2〉 *m. Alter.", "gloss_language": "de"}], "synonyms": ["जरठः"], "synonyms_slp1": ["jaraWaH"]}], "jaraWita": [{"id": "jaraWita", "headword": "जरठित", "headword_slp1": "jaraWita", "fold": "jaraWita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जरठित Adj. stark —, heftig —, intensiv geworden BĀLAR. 126,9.", "gloss_language": "de"}]}], "jaraqi": [{"id": "jaraqI", "headword": "जरडी", "headword_slp1": "jaraqI", "fold": "jaraqi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*जरडी f. eine Grasart RĀJAN. 8,131.", "gloss_language": "de"}]}], "jaraRa": [{"id": "jaraRa", "headword": "जरण", "headword_slp1": "jaraRa", "fold": "jaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "जरण꣫\n— 1〉 Adj.\n — a〉 hinfällig, alt.\n — b〉 auflösend, Verdauung befördernd.\n— 2〉 *m. n.\n — a〉 Kümmel und Nigella indica RĀJAN. 6,57.\n — b〉 Asa foetida RĀJAN. 6,75.\n — c〉 ein Art Salz.\n— 3〉 *m.\n — a〉 der Mond GAL.; vgl. जर्ण.\n — b〉 Cassia sophera^1 RĀJAN. 4,174.\n— 4〉 f. आ꣫\n — a〉 Alter.\n — b〉 *Nigella indica.\n— 5〉 n.\n — a〉 *Alter.\n — b〉 Auflösung.\n — c〉 Verdauung CARAKA. 3,17. ˚शक्ति f. Verdauungskraft 4.\n — d〉 eine der 10 angeblichen Weisen, auf welche eine Eklipse endet.\n — e〉 *Costus speciosus oder Costus arabicus.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}], "synonyms": ["जरणं", "जरणः"], "synonyms_slp1": ["jaraRaM", "jaraRaH"]}, {"id": "jaraRA", "headword": "जरणा", "headword_slp1": "jaraRA", "fold": "jaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. जरणा꣫ f. s. जरण 4〉.", "gloss_language": "de"}, {"gloss": "2. जर꣫णा f. etwa Dürres ṚV. 1,141,7 (121,6 scheint entstellt zu sein).", "gloss_language": "de"}]}, {"id": "jAraRa", "headword": "जारण", "headword_slp1": "jAraRa", "fold": "jaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 das Oxydiren.\n — b〉 *Verdauungsmittel.\n— 2〉 f. आ = 1〉a〉.\n— 3〉 *f. ई eine Art Kümmel RĀJAN. 6,64.", "gloss_language": "de"}], "synonyms": ["जारणं"], "synonyms_slp1": ["jAraRaM"]}], "jaraRadruma": [{"id": "jaraRadruma", "headword": "जरणद्रुम", "headword_slp1": "jaraRadruma", "fold": "jaraRadruma", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*जरणद्रुम m. Vatica robusta RĀJAN. 9,83.", "gloss_language": "de"}], "synonyms": ["जरणद्रुमः"], "synonyms_slp1": ["jaraRadrumaH"]}], "jaraRipra": [{"id": "jaraRiprA", "headword": "जरणिप्रा", "headword_slp1": "jaraRiprA", "fold": "jaraRipra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "sen