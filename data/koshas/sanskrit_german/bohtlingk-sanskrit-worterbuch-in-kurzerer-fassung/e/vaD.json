{"vaD": [{"id": "vaD", "headword": "वध्", "headword_slp1": "vaD", "fold": "vaD", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√वध् (vom Präsensstamm nur je einmal वधति, वध (Conj.), [] वधेयम् und वधेत्; Aor. अवधीत्, Prec. वध्यासम्, Fut. वधिष्यति, Pass. वध्यते und metrisch वध्यति) schlagen (eig. auch den Feind, ein Heer), zerschlagen, erschlagen, tödten, zu Nichte machen. वध्यमान auch fehlerhaft für बाध्यमान und वध्यन्ते für विध्यन्ते. बध् bisweilen auch in vedischen Texten.\n— Caus. वधयति erschlagen, tödten.\n— Desid. बी꣫भत्सते haben wir auf 1. बाध् zurückgeführt.\n— Mit अप\n— 1〉 abhauen, abschlagen.\n— 2〉 abschlagen, so v. a. verjagen, — von (Abl.).\n— Mit अभि auf Jmd (Acc.) schlagen.\n— Mit समभि dass.\n— Mit आ zermalmen, zerstückeln, zerschellen (ein Schiff).-Mit अभ्या schlagen auf (Acc.).\n— Mit उद्\n— 1〉 ausreissen ĀPAST. ŚR. 4,6,1.\n— 2〉 zerreissen.\n— Mit उप\n— 1〉 anschlagen an (Acc.).\n— 2〉 erschlagen, tödten.\n— Mit नि\n— 1〉 niederschleudern auf (Loc.).\n— 2〉 niederschlagen, niederhauen, tödten ŚIŚ. 15,23.\n— Mit निस् vereiteln, zu Nichte machen TS. 3,1,1,3.\n— Mit परा spalten, zerreissen.\n— Mit प्र schlagen (einen Feind).\n— Mit प्रति zurückschlagen, abwehren.\n— Mit वि zerstören.", "gloss_language": "de"}]}], "vaDa": [{"id": "vaDa", "headword": "वध", "headword_slp1": "vaDa", "fold": "vaDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वध꣫ m.\n— 1〉 Tödter, Mörder, Ueberwinder.\n— 2〉 tödtliche Waffe, namentlich Indraʼs Geschoss.\n— 3〉 das Erschlagen, Tödtung, Mord, Untergang. In Comp. mit dem Object und auch mit dem Werkzeuge. In den Gesetzbüchern sowohl Todesstrafe als Leibesstrafe. n. (!) Ind. St. 15,325.\n— 4〉 = वधभूमि Richtplatz.\n— 5〉 Schlag, Verletzung.\n— 6〉 Schlag, so v. a. Lähmung.\n— 7〉 Vernichtung, Zugrunderichtung. बीज˚ GAUT. 3,23.\n— 8〉 Verhinderung, Vereitelung GAUT. 22,28.\n— 9〉 Schwäche, Unvollkommenheit. Deren 28 angenommen VP. 1,5,10.\n— 10〉 Multiplication.\n— 11〉 Product BĪJAG. 32.\n— 12〉 N. pr. eines Rākṣasa VP. 2,285 u. s. w.", "gloss_language": "de"}], "synonyms": ["वधः"], "synonyms_slp1": ["vaDaH"]}, {"id": "vaDA", "headword": "वधा", "headword_slp1": "vaDA", "fold": "vaDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वधा Indecl.", "gloss_language": "de"}]}], "vaDaka": [{"id": "vaDaka", "headword": "वधक", "headword_slp1": "vaDaka", "fold": "vaDaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "व꣫धक m.\n— 1〉 Mörder.\n— 2〉 Henker, Scharfrichter.\n— 3〉 ein best. Schilfrohr.", "gloss_language": "de"}, {"gloss": "वधक VI. zu tödten beabsichtigend [] JĀTAKAM. 25.", "gloss_language": "de"}], "synonyms": ["वधकः"], "synonyms_slp1": ["vaDakaH"]}], "vaDakarmaDikarin": [{"id": "vaDakarmADikArin", "headword": "वधकर्माधिकारिन्", "headword_slp1": "vaDakarmADikArin", "fold": "vaDakarmaDikarin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वधकर्माधिकारिन् m. Henker, Scharfrichter.", "gloss_language": "de"}]}], "vaDakama": [{"id": "vaDakAma", "headword": "वधकाम", "headword_slp1": "vaDakAma", "fold": "vaDakama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वधकाम Adj. Jmd zu tödten wünschend GOBH. 4,8,12.", "gloss_language": "de"}]}], "vaDakamya": [{"id": "vaDakAmyA", "headword": "वधकाम्या", "headword_slp1": "vaDakAmyA", "fold": "vaDakamya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वधकाम्या f. die Absicht zu tödten oder zu schlagen.", "gloss_language": "de"}]}], "vaDajivin": [{"id": "vaDajIvin", "headword": "वधजीविन्", "headword_slp1": "vaDajIvin", "fold": "vaDajivin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fass