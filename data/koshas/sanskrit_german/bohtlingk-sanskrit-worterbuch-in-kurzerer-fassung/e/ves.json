: "de"}]}], "vesanyatva": [{"id": "vezAnyatva", "headword": "वेषान्यत्व", "headword_slp1": "vezAnyatva", "fold": "vesanyatva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वेषान्यत्व n. Wechsel der Tracht, — des Anzuges 106,9.", "gloss_language": "de"}]}], "veska": [{"id": "vezka", "headword": "वेष्क", "headword_slp1": "vezka", "fold": "veska", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वेष्क꣫ m. Schlinge zum Erwürgen.", "gloss_language": "de"}]}], "vesw": [{"id": "vezw", "headword": "वेष्ट्", "headword_slp1": "vezw", "fold": "vesw", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√वेष्ट्, वे꣫ष्टते\n— 1〉 sich winden, — sich schlängeln um.\n— 2〉 sich hängen —, kleben an (Loc.).\n— 3〉 sich häuten (von einer Schlange.)\n— Vgl. विष्ट्.\n— Caus. वेष्टयति, वेष्टयते (metrisch auch in der Bed. des Act.) वेष्टित꣫ Partic.\n— 1〉 überziehen, umwinden (MAITR. S. 2,3,1 [27,5]), umwickeln, umkleiden, bekleiden, umlegen, umstellen, umringen, umziegeln, einschliessen, rund um besetzen, umhüllen, umgeben. आत्मानम् sich einspinnen (von einer Raupe).\n— 2〉 umwinden, umwickeln, umbinden, umlegen.\n— 3〉 winden, (eines Strick).\n— 4〉 zusammenschrumpfen machen. — वेष्टयते auch fehlerhaft für चेष्टयते und वेष्टित für विष्ठित.\n— Mit अनु hängen bleiben.\n— Caus.\n— 1〉 überziehen, umwinden, überdecken.\n— 2〉 überdecken, auflegen, ausbreiten.\n— Mit अप Caus. abstreifen.\n— Mit अभि umwinden (ŚIŚ. 20,51), bedecken, zudecken.\n— Mit आ sich ausbreiten über (Loc.).\n— Caus.\n— 1〉 umhüllen, umgeben, bekleiden, bedecken.\n— 2〉 winden (einen Strick).\n— 3〉 einschliessen, auf einem engen Kreis beschränken.\n— 4〉 schliessen (die Hand). — आवेष्टयति auch fehlerhaft für आचेष्टयति.\n— Mit समा Caus. belegen, bedecken.\n— Mit उद् sich in die Höhe winden.\n— Caus.\n— 1〉 loswinden, auflösen.\n— 2〉 eröffen, aufsiegeln (einen Brief).\n— 3〉 entsetzen (von einer Belagerung) HEM. PAR. 7,110. 8,306.\n— Mit उप Caus.\n— 1〉 umwinden, umbinden.\n— 2〉 उपवेष्टित verbunden mit (im Comp. vorangehend) CARAKA. 6,12.\n— Mit नि Caus. Act. Med.\n— 1〉 einfassen (in die Hand, Loc.), zudeckend packen.\n— 2〉 umwickeln, umbinden.\n— Mit उपनि sich lagern um, umgeben.\n— Mit निस् Caus.\n— 1〉 zurückstreichen.\n— 2〉 abwickeln, so v. a. abnehmen um (Acc.).\n— Mit परि Caus.\n— 1〉 umhüllen, umwinden, umwickeln, umschlingen, umlegen, umstellen, umgeben, zudecken, umringen, überschütten, überziehen, besetzen mit.\n— 2〉 um [] winden, umlegen.\n— 3〉 zusammenschrumpfen machen.\n— Mit संपरि Caus. umwinden.\n— Mit प्र Caus.\n— 1〉 umwinden, umlegen. प्रवेष्टितो रोमभिः mit Haaren besetzt, — bedeckt.\n— 2〉 umwinden, umlegen ĀPAST. ŚR. 7,11,2. MĀN. GṚHY. 1,17.\n— Mit संप्र. Caus. umwinden.\n— Mit प्रति sich zurückschieben.\n— Caus. zurückschieben, -streichen, -biegen.\n— Mit वि Caus.\n— 1〉 wegstreichen, abziehen.\n— 2〉 umwinden, umringen, einschliessen.\n— Mit सम् sich zusammenrollen, zusammenschrumpfen.\n— Caus.\n— 1〉 umwinden, umschlingen, einschliessen, umringen, umhüllen, bedecken.\n— 2〉 umlegen.\n— 3〉 zusammenrollen ŚAṂK. zu BĀDAR. 2,1,19.\n— 4〉 zusammenschrumpfen machen.\n— Mit अभिसम् umhüllen, bedecken TĀṆḌYA-BR. 7,6,11.\n— Mit प्रतिसम् zusammenschrumpfen.", "gloss_language": "de"}]}], "veswa": [{"id": "vezwa", "headword": "वेष्ट", "headword_slp1": "vezwa", "fold": "veswa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वेष्ट m.\n— 1〉 Schlinge, Binde.\n— 2〉 Zahnhöhle.\n— 3〉 Gummi, Harz.\n— 4〉 *Terpentin RĀJAN. 12,157.", "gloss_language": "de"}], "synonyms": ["वेष्टः"], "synonyms_slp1": ["vezwaH"]}], "veswaka": [{"id": "vezwaka", "headword": "वेष्टक", "headword_slp1": "vezwaka", "fold": "veswaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. oder n. Hülle in अङ्गुलि˚ (Nachtr. 2).\n— 2〉 m.\n — a〉 in der Veda-Grammatik doppelte Aufführung eines Wortes, vor und nach इति.\n — b〉 *Benincasa cerifera^1.\n— 3〉 *m. n. Terpentin RĀJAN. 12,157.\n— 4〉 *n.\n — a〉 Kopfbinde, Turban.\n — b〉 Gummi, Harz.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}], "synonyms": ["वेष्टकं", "वेष्टकः"], "synonyms_slp1": ["vezwakaM", "vezwakaH"]}], "veswana": [{"id": "vezwana", "headword": "वेष्टन", "headword_slp1": "vezwana", "fold": "veswana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वेष्टन n.\n— 1〉 das Umwinden, Umschlingen, Umfassen, Umzingeln, Einschliessen. ˚वेष्टनं कर् umwinden, einem Verband machen. कृत˚ Adj. eingeschlossen, umzingelt.\n— 2〉 etwas zum Umwinden u. s. w. Dienendes, Tuck, Band, Binde, Schlinge.\n— 3〉 *Kopfbinde, Turban.\n— 4〉 *Diadem.\n— 5〉 Einfassung, Zaum, Hecke.\n— 6〉 Spanne.\n— 7〉 *das äussere Ohr.\n— 8〉 *eine Art Waffe.\n— 9〉 *Pongamia glabra.\n— 10〉 *Bdellium.\n— 11〉 *= गति (वृति ?).", "gloss_language": "de"}], "synonyms": ["वेष्टनं"], "synonyms_slp1": ["vezwanaM"]}], "veswanaka": [{"id": "vezwanaka", "headword": "वेष्टनक", "headword_slp1": "vezwanaka", "fold": "veswanaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वेष्टनक m. quidam coeundi modus.", "gloss_language": "de"}], "synonyms": ["वेष्टनकः"], "synonyms_slp1": ["vezwanakaH"]}], "veswanaveswanaka": [{"id": "vezwanavezwanaka", "headword": "वेष्टनवेष्टनक", "headword_slp1": "vezwanavezwanaka", "fold": "veswanaveswanaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वेष्टनवेष्टनक m. desgl.", "gloss_language": "de"}]}], "veswanika": [{"id": "vezwanika", "headword": "वेष्टनिक", "headword_slp1": "vezwanika", "fold": "veswanika", "headword_language": "sa", "source": "bohtlin