-fassung", "senses": [{"gloss": "सगद्गदस्वरम् Adv. dass. SĀH. D. 59,4.", "gloss_language": "de"}]}], "saganDa": [{"id": "saganDa", "headword": "सगन्ध", "headword_slp1": "saganDa", "fold": "saganDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगन्ध Adj.\n— 1〉 riechend.\n— 2〉 Gleichen Geruchs mit (Instr. oder im Comp. vorangehend).\n— 3〉 verwandt (nur im Prākrit zu belegen).\n— 4〉 übermüthig MEGH. 9. v. l. सगर्व Man könnte सगर्ध vermuthen.", "gloss_language": "de"}], "synonyms": ["सगंध", "सगन्धः"], "synonyms_slp1": ["sagaMDa", "saganDaH"]}], "saganDin": [{"id": "saganDin", "headword": "सगन्धिन्", "headword_slp1": "saganDin", "fold": "saganDin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚सगन्धिन् Adj. gleichen Geruchs mit.", "gloss_language": "de"}]}], "saganDarvapsaraska": [{"id": "saganDarvApsaraska", "headword": "सगन्धर्वाप्सरस्क", "headword_slp1": "saganDarvApsaraska", "fold": "saganDarvapsaraska", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगन्धर्वाप्सरस्क Adj. mit den Gandharva und Apsaras ĀŚV. GṚHY. 3,9,1.", "gloss_language": "de"}]}], "sagara": [{"id": "sagara", "headword": "सगर", "headword_slp1": "sagara", "fold": "sagara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. स꣫गर m.\n— 1〉 das Luftmeer.\n— 2〉 N. pr. eines mythischen Fürsten, der durch seine 60000 Söhne die Erde aufwühlen liess, um ein zum Opfer bestimmtes Ross wieder aufzufinden. Kapila verbrannte dieselben und Bhagīratha, ein Nachkomme Sagaraʼs, führte die Gaṅgā vom Himmel auf die Erde um sie zu entsündigen. Das Meer, wohin die Gaṅga mit der Asche der Verbrannten geleitet wurde, erhielt ihm zu Ehren den Namen Sāgara. Pl. die Söhne Sagaraʼs.", "gloss_language": "de"}, {"gloss": "2. स꣫गर Adj.\n— 1〉 nach dem Comm. von Lob begleitet (die Feuer). Könnte auch gefrässig, im Frass begriffen bedeuten.\n— 2〉 vergiftet, giftig. Subst. [] vergiftete Speise.", "gloss_language": "de"}, {"gloss": "3. स꣫गर m. und स꣫गरा f. (angeblich Nacht) in einer Formel.", "gloss_language": "de"}], "synonyms": ["सगरः"], "synonyms_slp1": ["sagaraH"]}, {"id": "sagarA", "headword": "सगरा", "headword_slp1": "sagarA", "fold": "sagara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "3. स꣫गर m. und स꣫गरा f. (angeblich Nacht) in einer Formel.", "gloss_language": "de"}]}, {"id": "sAgara", "headword": "सागर", "headword_slp1": "sAgara", "fold": "sagara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉\n — a〉 das Meer. Nach der Legende das von des Söhnen Sagaraʼs ausgehöhlte Becken. [] welches Bhagīratha mit dem Wasser der Gaṅgā füllte. सागरस्य फेनः Os sepiae. Am Ende eines adj. Comp. f. आ\n — b〉 das Meer am Ende eines Comp. als Bild der unübersehbaren Ausdehnung, der Unerschöpflichkeit, Unergründlichkeit und Gefährlichkeit. सैन्य˚ ŚIŚ. 13,27.\n — c〉 Bez. der Zahl vier.\n — d〉 eine best. hohe Zahl, = 10 Padma.\n — e〉 eine Gazellenart.\n — f〉 Titel eines Werkes.\n — g〉 Pl. die Söhne Sagaraʼs 106,21.\n — h〉 N. pr.\n — α〉 eines Schlangendämons KĀRAṆḌ. 68,5.\n — β〉 verschiedener Personen HEM. PAR. 1,472.\n — γ〉 einer Oertlichkeit.\n— 2〉 Adj. (f. ई)\n— 3〉 n. N. pr. einer Stadt.", "gloss_language": "de"}], "synonyms": ["सागरः"], "synonyms_slp1": ["sAgaraH"]}], "sagaras": [{"id": "sagaras", "headword": "सगरस्", "headword_slp1": "sagaras", "fold": "sagaras", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगरस् Adj. = 2. स꣫गर 1〉.", "gloss_language": "de"}]}], "sagari": [{"id": "sagarI", "headword": "सगरी", "headword_slp1": "sagarI", "fold": "sagari", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*सगरी f. N. pr. einer Stadt.", "gloss_language": "de"}]}], "sagarDa": [{"id": "sagarDa", "headword": "सगर्ध", "headword_slp1": "sagarDa", "fold": "sagarDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगर्ध Adj. heftig verlangend nach (Gen.) könnte MEGH. 9 st. सगन्ध vermuthet werden.", "gloss_language": "de"}]}], "sagarBa": [{"id": "sagarBa", "headword": "सगर्भ", "headword_slp1": "sagarBa", "fold": "sagarBa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगर्भ Adj. (f. आ)\n— 1〉 mit einer Leibesfrucht versehen, schwanger, — von (Abl. oder Instr.).\n— 2〉 mit einem unentwickelten Blatte.\n— 3〉 *aus demselben Leibe geboren.", "gloss_language": "de"}], "synonyms": ["सगर्भः"], "synonyms_slp1": ["sagarBaH"]}], "sagarBya": [{"id": "sagarBya", "headword": "सगर्भ्य", "headword_slp1": "sagarBya", "fold": "sagarBya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "स꣫गर्भ्य Adj. = सगर्भ 3〉.", "gloss_language": "de"}], "synonyms": ["सगर्भ्यः"], "synonyms_slp1": ["sagarByaH"]}], "sagarva": [{"id": "sagarva", "headword": "सगर्व", "headword_slp1": "sagarva", "fold": "sagarva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगर्व Adj. (f. आ) hochmüthig, stolz auf (Loc. oder im Comp. vorangehend) MEGH. 9, v. l. Spr. 7847. NAIṢ. 5,54. ˚म् Adv. Chr. 310,29.", "gloss_language": "de"}], "synonyms": ["सगर्व्व"], "synonyms_slp1": ["sagarvva"]}], "sagu": [{"id": "sagu", "headword": "सगु", "headword_slp1": "sagu", "fold": "sagu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगु Adj. sammt Rindern ĀPAST. ŚR. 14,26,1.", "gloss_language": "de"}]}], "saguRa": [{"id": "saguRa", "headword": "सगुण", "headword_slp1": "saguRa", "fold": "saguRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगुण Adj. (f. आ)\n— 1〉 mit einem Stricke —, mit einer Sehne versehen, sammt der Sehne.\n— 2〉 mit seinen besonderen Beigaben —, mit dem was dazu gehört versehen.\n— 3〉 mit Qualitäten versehen.\n— 4〉 mit Vorzügen versehen. Nom. abstr. ˚त्व n.", "gloss_language": "de"}]}], "saguRavati": [{"id": "saguRavatI", "headword": "सगुणवती", "headword_slp1": "saguRavatI", "fold": "saguRavati", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगुणवती f. Titel eines Werkes.", "gloss_language": "de"}]}], "saguRin": [{"id": "saguRin", "headword": "सगुणिन्", "headword_slp1": "saguRin", "fold": "saguRin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगुणिन् Adj. = सगुण 4〉.", "gloss_language": "de"}]}], "sagulika": [{"id": "sagulika", "headword": "सगुलिक", "headword_slp1": "sagulika", "fold": "sagulika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगुलिक Adj. mit Pille KATHĀS. 89,56.", "gloss_language": "de"}]}], "sagfha": [{"id": "sagfha", "headword": "सगृह", "headword_slp1": "sagfha", "fold": "sagfha", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "स꣫गृह Adj. sammt seinen Hause, mit Weib und Kind ĀPAST. ŚR. 6,28,1.", "gloss_language": "de"}]}], "sagfhapatika": [{"id": "sagfhapatika", "headword": "सगृहपतिक", "headword_slp1": "sagfhapatika", "fold": "sagfhapatika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सगृहपतिक Adj. nebst dem Gṛhapati ŚĀṄKH. ŚR. 17,17,4.", "gloss_language": "de"}]}], "sagotra": [{"id": "sagotra", "headword": "सगोत्र", "headword_slp1": "sagotra", "fold": "sagotra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-f