oss_language": "de"}]}], "tejasa": [{"id": "tejasa", "headword": "तेजस", "headword_slp1": "tejasa", "fold": "tejasa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚तेजस n. = तेजस् 7〉 oder 8〉.", "gloss_language": "de"}]}], "tejasamaDisa": [{"id": "tejasAmaDISa", "headword": "तेजसामधीश", "headword_slp1": "tejasAmaDISa", "fold": "tejasamaDisa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तेजसामधीश m. die Sonne HARṢAC. 139,9.", "gloss_language": "de"}]}], "tejasinha": [{"id": "tejasiMha", "headword": "तेजसिंह", "headword_slp1": "tejasiMha", "fold": "tejasinha", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तेजसिंह m. N. pr. eines Mannes.", "gloss_language": "de"}]}], "tejaskara": [{"id": "tejaskara", "headword": "तेजस्कर", "headword_slp1": "tejaskara", "fold": "tejaskara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तेजस्कर Adj. Kraft —, Lebenskraft u. s. w. verleihend.", "gloss_language": "de"}], "synonyms": ["तेजस्करं"], "synonyms_slp1": ["tejaskaraM"]}], "tejaskama": [{"id": "tejaskAma", "headword": "तेजस्काम", "headword_slp1": "tejaskAma", "fold": "tejaskama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ते꣫जस्काम Adj.\n— 1〉 nach Kraft, nach Lebenskraft strebend.\n— 2〉 nach Einfluss, Ansehen, Wirksamkeit, Hoheit strebend.", "gloss_language": "de"}]}], "tejaskaya": [{"id": "tejaskAya", "headword": "तेजस्काय", "headword_slp1": "tejaskAya", "fold": "tejaskaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "तेजस्काय Adj. dessen Körper Licht ist ĀPAST.", "gloss_language": "de"}]}], "tejastva": [{"id": "tejastva", "headword": "तेजस्त्व", "headword_slp1": "tejastva", "fold": "te