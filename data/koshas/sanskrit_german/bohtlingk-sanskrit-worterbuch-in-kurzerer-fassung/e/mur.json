{"mur": [{"id": "mur", "headword": "मुर्", "headword_slp1": "mur", "fold": "mur", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √मुर् s. u. 2. मर्.", "gloss_language": "de"}, {"gloss": "2. *√मुर् मुरति संव्र्ष्टमे.", "gloss_language": "de"}, {"gloss": "3. मु꣫र् nach SĀY. ein Sterblicher, nach BENFEY Mauer, nach GRASSMANN Verderber, Feind.", "gloss_language": "de"}, {"gloss": "4. मुर् Nom. ag. von मुर्च्छ्.", "gloss_language": "de"}, {"gloss": "5. मुर् Nom. ag. von मुर्व्.", "gloss_language": "de"}]}], "mura": [{"id": "mura", "headword": "मुर", "headword_slp1": "mura", "fold": "mura", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. N. pr. eines von Viṣṇu-Kṛṣṇa erschlagenen Daitya. मुरं विद्विषन्त् m. Bein. Viṣṇuʼs NAIṢ. 8,95.\n— 2〉 f. आ\n — a〉 eine best. wohlriechende Pflanze RĀJAN. 12,139. BHĀVAPR. 1,191. 3,30. 101.\n — b〉 N. pr. der Mutter Candraguptaʼs.\n— 3〉 n. das Umfangen.", "gloss_language": "de"}], "synonyms": ["मुरं", "मुरः"], "synonyms_slp1": ["muraM", "muraH"]}, {"id": "mUra", "headword": "मूर", "headword_slp1": "mUra", "fold": "mura", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. मूर꣫ Adj. (f. आ꣫) stumpfsinnig, blöde, dumm.", "gloss_language": "de"}, {"gloss": "2. मूर꣫ Adj. drängend, stürmisch. Nach SĀY. = मारक.", "gloss_language": "de"}, {"gloss": "3. मू꣫र n. = मू꣫ल. Wurzel.", "gloss_language": "de"}]}], "muragaRqa": [{"id": "muragaRqa", "headword": "मुरगण्ड", "headword_slp1": "muragaRqa", "fold": "muragaRqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*मुरगण्ड m. Ausschlag im Gesicht.", "gloss_language": "de"}], "synonyms": ["मुरगंडः", "मुरगण्डः"], "synonyms_slp1": ["muragaMqaH", "muragaRqaH"]}], "muraNgi": [{"id": "muraNgI", "headword": "मुरङ्गी", "headword_slp1": "muraNgI", "fo