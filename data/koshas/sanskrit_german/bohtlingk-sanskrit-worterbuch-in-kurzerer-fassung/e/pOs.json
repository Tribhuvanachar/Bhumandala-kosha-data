{"pOsa": [{"id": "pOza", "headword": "पौष", "headword_slp1": "pOza", "fold": "pOsa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई) zu der Zeit, da der Mond im Mondhause Puṣya steht, in Beziehung stehend, in diese Zeit fallend.\n— 2〉 m.\n — a〉 ein best. Monat, dessen Vollmond im Mondhaus Puṣya steht.\n — b〉 das dritte Jahr im 12jährigen Jupiter-Cyclus.\n— 3〉 f. ई die Vollmondsnacht oder der Vollmondstag im Monat Pauṣa.\n— 4〉 n.\n — a〉 *Festtag oder ein best. F.\n — b〉 *Kampf.\n — c〉 Name verschiedener Sāman.", "gloss_language": "de"}], "synonyms": ["पौषः"], "synonyms_slp1": ["pOzaH"]}], "pOsaDa": [{"id": "pOzaDa", "headword": "पौषध", "headword_slp1": "pOzaDa", "fold": "pOsaDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पौषध m. Fasttag KALPAS. 113, HEM. PAR. 6,86. Auch ˚दिन n. 201. Vgl. पोषध.", "gloss_language": "de"}], "synonyms": ["पौषधः"], "synonyms_slp1": ["pOzaDaH"]}], "pOsamahatmya": [{"id": "pOzamAhAtmya", "headword": "पौषमाहात्म्य", "headword_slp1": "pOzamAhAtmya", "fold": "pOsamahatmya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पौषमाहात्म्य n. Titel eines Werkes.", "gloss_language": "de"}]}], "pOskajiti": [{"id": "pOzkajiti", "headword": "पौष्कजिति", "headword_slp1": "pOzkajiti", "fold": "pOskajiti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "पौष्कजिति m. Patron. Auch Pl.", "gloss_language": "de"}]}], "pOskara": [{"id": "pOzkara", "headword": "पौष्कर", "headword_slp1": "pOzkara", "fold": "pOskara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई)\n — a〉 zur blauen Lotusblüthe in Beziehung stehend, daraus gebildet, — bestehend, — hervorgegangen, darüber handelnd u. s. w. प्रादुर्भाव m. die Ersc