{"yuga": [{"id": "yuga", "headword": "युग", "headword_slp1": "yuga", "fold": "yuga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "युग꣫ n. (in der 1sten und 4ten Bed. ausnahmsweise m.)\n— 1〉 Joch. Damit werden Arme verglichen.\n— 2〉 Paar. Am Ende eines adj. Comp. f. आ.\n— 3〉 Doppel-Śloka, zwei Śloka, durch welche ein und derselbe Satz durchgeht.\n— 4〉 Geschlecht, Generation, Lebensperiode; der durch Abstammung zusammengehörige Stamm.\n— 5〉 eine Periode von fünf (auch sechs Ind. St. 10,379) Jahren, Insbes. ein Lustrum im 60jährigen Jupitercyclus.\n— 6〉 Weltperiode, Weltalter, Cyclus (Kṛta oder Satya, Tretā, Dvāpara und Kali).\n— 7〉 als Längenmaass = 86 Aṅgula ŚULBAS. 1,12 = 4 Hasta nach den Lexicographen.\n— 8〉 Bez. der Zahlen vier und zwölf.\n— 9〉 eine best. Configuration des Mondes.\n— 10〉 eine best. Constellation, wenn nämlich alle Planeten in zwei Häusern stehen.\n— 11〉 *eine best. Heilpflanze, = वृद्धि.\n— 12〉 युगे꣫न TBR. 3,7,10,1 nach dem Comm. = युगपद्.", "gloss_language": "de"}], "synonyms": ["युगं", "युगः"], "synonyms_slp1": ["yugaM", "yugaH"]}], "yugakilaka": [{"id": "yugakIlaka", "headword": "युगकीलक", "headword_slp1": "yugakIlaka", "fold": "yugakilaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*युगकीलक m. Pflock am Joche.", "gloss_language": "de"}], "synonyms": ["युगकीलकः"], "synonyms_slp1": ["yugakIlakaH"]}], "yugaksaya": [{"id": "yugakzaya", "headword": "युगक्षय", "headword_slp1": "yugakzaya", "fold": "yugaksaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "युगक्षय m. Ende eines Yuga, Weltende.", "gloss_language": "de"}], "synonyms": ["युगक्षयः"], "synonyms_slp1": ["yugakzayaH"]}], "yugaDara": [{"id": "yugaDAra", "headword": "युगधार", "headword_slp1": "yugaDAra", "fold": "yugaDara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in