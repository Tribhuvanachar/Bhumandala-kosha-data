{"caw": [{"id": "caw", "headword": "चट्", "headword_slp1": "caw", "fold": "caw", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√चट्, चटति\n— 1〉 sich einstellen, Statt finden PAÑCAT. ed. Bomb. 1,80,12.\n— 2〉 gerathen-, gelangen in. अस्मत्करे in unsere Hand PAÑCAD. sich begeben nach (Loc.) Ind. St. 15,266. fg.\n— 3〉 sich befinden an (Loc.) Spr. 6851. ˚चटित sich befindend an PAÑCAT. 121,1. in Ind. St. 15,331.\n— 4〉 चटित zerbrochen CARAKA. 2,1. verfallen (Gebäude) KĀRAṆḌ. 13,9. 11.\n— 5〉 *वर्षावरणयोः.\n— *Caus. चाटयति (भेदने, वधे)\n— Mit उद् sich hinausbegeben.\n— Caus. उच्चाटयति hinausjagen, -schaffen, verscheuchen.\n— Mit वि zerbrechen (intrans.) BĀLAR. 145,6. Vgl. चत्.", "gloss_language": "de"}]}], "cawa": [{"id": "cawa", "headword": "चट", "headword_slp1": "cawa", "fold": "cawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "चट in क्रमचट.", "gloss_language": "de"}]}, {"id": "cawwa", "headword": "चट्ट", "headword_slp1": "cawwa", "fold": "cawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "चट्ट m. N. pr. eines Mannes HEM. PAR. 3,197.", "gloss_language": "de"}]}, {"id": "cAwa", "headword": "चाट", "headword_slp1": "cAwa", "fold": "cawa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "चाट m.\n— 1〉 Betrüger, Spitzbube VARĀH. YOGAY. 4,50. HEMĀDRI 1,39,17.\n— 2〉 Wahrsager J. A. S. Beng. 47,405,36. 406,42. Hier könnte aber चाटभट als ein Wort gefasst werden und eine niedrige Bevölkerungsklasse bezeichnen Vgl. चारभट.\n— 3〉 *= [] क्षुद्रविषयबोक्तर् Comm. zu MṚCCH. 78,13.", "gloss_language": "de"}], "synonyms": ["चाटः"], "synonyms_slp1": ["cAwaH"]}], "cawaka": [{"id": "cawaka", "headword": "चटक", "headword_slp1": "cawaka", "fold": "cawaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-f