{"Boga": [{"id": "Boga", "headword": "भोग", "headword_slp1": "Boga", "fold": "Boga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. भोग꣫ m.\n— 1〉 Windung, Ring (einer Schlange) MAITR. S. 2,5,3 (50,9) LA. 91,20.\n— 2〉 die sogenannte Haube einer Schlange.\n— 3〉 eine best. Aufstellung der Truppen.\n— 4〉 Schlange SUPARṆ. 8,3.", "gloss_language": "de"}, {"gloss": "2. भो꣫ग\n— 1〉 m. (adj. Comp. f. आ)\n — a〉 das Geniessen, Essen, Speisen.\n — b〉 Genuss, Benutzung, Gebrauch, Verbrauch, Verwendung. Bei den Jaina einmaliger Genuss einer Sache; Vgl. उपभोग.\n — c〉 fleischlicher Genuss.\n — d〉 Regierung, Herrschaft.\n — e〉 Empfindung (von Freude oder Schmerz).\n — f〉 in der Astr. das Durchlaufen eines Gestirns.\n — g〉 Nutzen, Vortheil.\n — h〉 Freude, Lust.\n — i〉 Gegenstand des Genusses.\n — k〉 Besitz, Einkünfte, Ertrag von Ländereien u. s. w.\n — l〉 der auf jedes Mondhaus fallende Theil der Ekliptik, d. i. 13° 20′.\n — m〉 *Hurenlohn.\n — n〉 N. pr. eines Lehrers.\n— 2〉 f. भोगा N. pr. eines Surāṅganā Ind. St. 15,144.\n— 3〉 n. fehlerhaft für भोग्य und भाग्य.", "gloss_language": "de"}, {"gloss": "2. भोग 1〉i〉 deren acht Ind. Antiq. 4,276,a [57]; vgl. 278,b, N. 1.", "gloss_language": "de"}, {"gloss": "2. भोग IV. 5.", "gloss_language": "de"}], "synonyms": ["भोगः"], "synonyms_slp1": ["BogaH"]}], "Bogaka": [{"id": "Bogaka", "headword": "भोगक", "headword_slp1": "Bogaka", "fold": "Bogaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*भोगक m. N. pr. eines Mannes.", "gloss_language": "de"}]}], "Bogakara": [{"id": "Bogakara", "headword": "भोगकर", "headword_slp1": "Bogakara", "fold": "Bogakara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भोगकर Adj. (f. ई) Genuss schaffend.", "gloss_language": "de"}]}], "BogagucCa": [{"id": "BogagucCa", "headword": "भोगगुच्छ", "headword_slp1": "BogagucCa", "fo