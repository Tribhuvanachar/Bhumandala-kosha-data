{"hins": [{"id": "hiMs", "headword": "हिंस्", "headword_slp1": "hiMs", "fold": "hins", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √हिंस् हिन꣫स्ति हिं꣫सन्ति und हिंस꣫न्ति हिंस्ते (episch und metrisch हिंसि) st. हिनस्मि हिंसामि st. हिनस्मि हिंसति st. हिनस्ति हिंससे हिंसते und हिम्सेत हिंसित꣫ Partic. Jmd verletzen (auch tödtlich, sogar schlachten), Jmd ein Leid anthun; Etwas schädigen, stören, zu Nichte machen.\n— Caus. हिंसयति dass.\n— Desid. जि꣫हिंसिषति verletzen u. s. w. wollen.\n— Mit व्यति Act. sich gegenseitig ein Leid anthun.\n— Mit अव in अनवहिंसित Nachtr. 5.\n— Mit आ Jmd ein Leid zufügen; Med. sich befehden.\n— Mit उप = Simplex.\n— Mit नि in निहिंसन.\n— Mit प्रति in प्रतिहिंसा und प्रतिहिंसित (Nachtr. 6).\n— Mit वि = Simplex.\n— Caus. desgl.", "gloss_language": "de"}, {"gloss": "2. हिंस् Adj. ein Leid zufügend in सुहिंस्.", "gloss_language": "de"}]}], "hinsa": [{"id": "hiMsa", "headword": "हिंस", "headword_slp1": "hiMsa", "fold": "hinsa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "हिं꣫स\n— 1〉 Adj. verletzend, schädigend.\n— 2〉 f. हिंसा\n — a〉 Leidzufügung am Leibe oder Gut, Schädigung. Am Ende eines Comp. in der Regel nach dem Geschädigten, aber auch nach dem Schädiger. Personificirt als Gattin Adharmaʼs und als Tochter Lobhaʼs von der Niṣkṛti.\n — b〉 Asteracantha longifolia.", "gloss_language": "de"}]}], "hinsaka": [{"id": "hiMsaka", "headword": "हिंसक", "headword_slp1": "hiMsaka", "fold": "hinsaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. Anderen Leid zufügend, schädigend.\n— 2〉 m. = शत्रु हिंस्रपशु und अथर्वविद्ब्राह्मण.", "gloss_language": "de"}], "synonyms": ["हिंसकः"], "synonyms_slp1": ["hiMsakaH"]}], "hinsana": [{"id": "hiMsana", "headword": "हिंसन", "headword_slp1": "hiMsana", "fold": "hinsana", "headword_language": "sa", "source": "b