": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √दीदि, दीद्यति 3te Pl., दीद्यन्ते, दीदयन्ते (Conj.), दीदिहि꣫ und दिदीहि, अदीदेत्, Partic. दी꣫द्यत् und दी꣫द्यान.\n— 1〉 scheinen, glänzen, leuchten. दीदिहि दीदिदासि (lies दीद्यदसि) दीदयेत्येषो ऽग्न्युपसमिन्धनः (sc. मन्त्रः) ĀPAST. ŚR. 6,13,10.\n— 2〉 Jmd (Dat. oder Loc.) Etwas (Acc.) ausstrahlen.\n— 3〉 leuchten, so v. a. sich bemerklich machen.\n— 4〉 scheinen, so v. a. wohlgefallen. दी꣫द्यान wohlgefällig, bewundert.\n— Mit अभि Etwas herbeistrahlen.\n— Mit आ bescheinen.\n— Mit नि Jmd (Dat. oder Loc.) Etwas (Acc.) herniederstrahlen.\n— Mit प्र hervorleuchten.\n— Mit सम्\n— 1〉 zusammen scheinen.\n— 2〉 Etwas herbeistrahlen.", "gloss_language": "de"}, {"gloss": "2. दीदि Adj. scheinend in दीद्यग्नि.", "gloss_language": "de"}, {"gloss": "3. √दीदि, दीद्ये, Partic. दी꣫द्यत् und दी꣫द्यान. Nur mit अच्छ sich innerlich zuwenden, den Sinn richten auf (Acc.).", "gloss_language": "de"}, {"gloss": "1. दीदि und दीधि bisweilen versechselt, insbes. in Ableitungen.", "gloss_language": "de"}, {"gloss": "1. दीदि und दीधि III. 3. दीधि mit आ 2〉 lies vorsetzen st. versehen.", "gloss_language": "de"}]}], "didfksa": [{"id": "didfkzA", "headword": "दिदृक्षा", "headword_slp1": "didfkzA", "fold": "didfksa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "दिदृक्षा f. adj. Comp. f. आ das Verlangen zu sehen.", "gloss_language": "de"}]}], "didfksita": [{"id": "didfkzita", "headword": "दिदृक्षित", "headword_slp1": "didfkzita", "fold": "didfksita", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. s. u. दर्श् Desid.\n— 2〉 n. das Verlangen zu sehen.", "gloss_language": "de"}]}], "didfksu": [{"id": "didfkzu", "headword": "दिदृक्षु", "headword_slp1": "didfkzu", "fold": "didfksu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": 