es": [{"gloss": "निवेशदेश m. Aufenthaltsort.", "gloss_language": "de"}]}], "nivesana": [{"id": "niveSana", "headword": "निवेशन", "headword_slp1": "niveSana", "fold": "nivesana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निवे꣫शन\n— 1〉 Adj. (f. ई)\n — a〉 hineingehend —, eindringend in (im Comp. vorangehend).\n — b〉 zur Ruhe bringend, in das Haus —, auf das Lager legend.\n — c〉 beherbergend.\n— 2〉 m. N. pr. eines Vṛṣṇi.\n— 3〉 n.\n — a〉 (adj. Comp. f. आ) das Hineingehen Eingang, — in (im Comp. vorangehend).\n — b〉 das Niederstellen, Niedersetzen, Auflegen VIKRAMĀṄKAC. 9,83.\n — c〉 das Einführen, Anbringen, Anwenden.\n — d〉 das Befestigen, Einprägen.\n — e〉 das zur Ruhe Gehen, Haltmachen, zur Ruhe Bringen, Beziehenlassen eines Lagers. निवेशनं कर् Halt machen, ein Lager beziehen.\n — f〉 das Beziehen eines Hauses, Begründen eines Haushalts, Heirathen.\n — g〉 das Ansiedeln, Bevölkern.\n — h〉 Heimat, Lager, Versteck, Nest, Lagerstätte, Wohnstätte, Wohnung überh.\n — i〉 Stadt. Nach den Lexicographen halb so gross wie ein Nigama.", "gloss_language": "de"}], "synonyms": ["निवेशनं"], "synonyms_slp1": ["niveSanaM"]}], "nivesaniya": [{"id": "niveSanIya", "headword": "निवेशनीय", "headword_slp1": "niveSanIya", "fold": "nivesaniya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निवेशनीय Adj. hinzustellen PRASANNAR. 28,14. [] aufzustellen, zu errichten HEMĀDRI 1,123,10.", "gloss_language": "de"}], "synonyms": ["निवेशनीयः"], "synonyms_slp1": ["niveSanIyaH"]}], "nivesayitavya": [{"id": "niveSayitavya", "headword": "निवेशयितव्य", "headword_slp1": "niveSayitavya", "fold": "nivesayitavya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "निवेशयितव्य Adj. zu stellen ŚAṂK. zu BĀDAR. 4,3,2.", "gloss_language": "de"}]}], "nivesavant": [{"id": "niveSavant", "headword": "निवेशवन्त्", "headword_slp1":