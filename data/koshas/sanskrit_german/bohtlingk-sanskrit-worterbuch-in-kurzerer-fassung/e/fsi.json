{"fsi": [{"id": "fzi", "headword": "ऋषि", "headword_slp1": "fzi", "fold": "fsi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ऋ꣫षि m.\n— 1〉 Sänger heiliger Lieder, Dichter, ein Heiliger der Vorzeit. Pl. eine best. Klasse hochverehrter Wesen, deren Zahl häufig als sieben bestimmt wird. in der späteren Kosmologie hat jedes Manvantara seine besondern sieben Ṛṣi.\n— 2〉 ein von einem Sänger der Vorzeit gedichtetes Lied.\n— 3〉 später eine durch Frömmigkeit und Weisheit geheiligte Person, insbes. ein solcher Einsiedler.\n— 4〉 Pl. die sieben Sterne des grossen Bären.\n— 5〉 Bez. der Zahl sieben.\n— 6〉 der Mond.\n— 7〉 *Lichtstrahl.\n— 8〉 an imaginary circle.\n— 9〉 *Cyprinus rishi.", "gloss_language": "de"}, {"gloss": "ऋषि 3〉 nimmt die 7te Stelle unter den Brahmanen ein; steht zwischen dem ऋषिकल्प und dem मुनि HEMĀDRI 1,26,4. 27,1.", "gloss_language": "de"}, {"gloss": "ऋषि I. 4.", "gloss_language": "de"}], "synonyms": ["ऋषिः"], "synonyms_slp1": ["fziH"]}], "fsika": [{"id": "fzika", "headword": "ऋषिक", "headword_slp1": "fzika", "fold": "fsika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m.\n — a〉 ein Ṛṣi niederen Ranges ĀRYAV. 38,10. fgg.\n — b〉 Pl. N. pr. eines Volkes. Sg. ein Fürst dieses Volkes.\n— 2〉 f. आ\n — a〉 ein weiblicher Ṛṣi niederen Ranges ĀRYAV. 39,13.\n — b〉 N. pr. eines Flusses.", "gloss_language": "de"}], "synonyms": ["ऋषिकः"], "synonyms_slp1": ["fzikaH"]}, {"id": "fzIka", "headword": "ऋषीक", "headword_slp1": "fzIka", "fold": "fsika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*ऋषीक m. eine Grasart NIGH. PR.", "gloss_language": "de"}], "synonyms": ["ऋषीकः"], "synonyms_slp1": ["fzIkaH"]}], "fsikulya": [{"id": "fzikulyA", "headword": "ऋषिकुल्या", "headword_slp1": "fzikulyA", "fold": "fsikulya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbu