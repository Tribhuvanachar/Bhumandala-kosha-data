{"moha": [{"id": "moha", "headword": "मोह", "headword_slp1": "moha", "fold": "moha", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मो꣫ह m. (adj. Comp. f. आ NAIṢ. 8,15)\n— 1〉 Verlust der Besinnung, Mangel an klarem Bewusstsein, Verwirrung, das Irrewerden, Irresein, Verblendung, Irrthum. मोहं ब्र sprechen, was Jmd irre macht. मोहस्तत्र न कार्यस्ते lass dich dadurch nicht irre machen. [] मोहात् aus Mangel an klarem Bewusstsein, aus Unverstand. In Comp. mit einem in Gen., Loc. oder Instr. gedachten Worte.\n— 2〉 in der Philosophie eine anhaltende Verfinsterung des Geistes die Einen verhindert die Wahrheit zu erkennen.\n— 3〉 krankhafte, bis an Bewusstlosigkeit grenzende und in diese übergehende Trübung des Geistes, Betäubung, Ohnmacht.\n— 4〉 eine die Verwirrung des Feindes bezweckende Zauberceremonie.\n— 5〉 *Staunen, Wunder.\n— 6〉 personificirt als ein Sohn Brahmanʼs.", "gloss_language": "de"}], "synonyms": ["मोहं", "मोहः"], "synonyms_slp1": ["mohaM", "mohaH"]}], "mohakarin": [{"id": "mohakArin", "headword": "मोहकारिन्", "headword_slp1": "mohakArin", "fold": "mohakarin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*मोहकारिन् m. Caryota urens RĀJAN. 9,95.", "gloss_language": "de"}]}], "mohacuqotara": [{"id": "mohacUqottara", "headword": "मोहचूडोत्तर", "headword_slp1": "mohacUqottara", "fold": "mohacuqotara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मोहचूडोत्तर n. und ˚शास्त्र n. Titel eines Werkes HEMĀDRI 1,135,22 (˚चुद्रोतर gedr.) 134,5.", "gloss_language": "de"}]}], "mohacuqotarasastra": [{"id": "mohacUqottaraSAstra", "headword": "मोहचूडोत्तरशास्त्र", "headword_slp1": "mohacUqottaraSAstra", "fold": "mohacuqotarasastra", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मोहचूडोत्तर n. und ˚शास्त्र n. Titel eines Werkes HEMĀDRI 1,135,22 (˚चुद्रोतर gedr.) 134,5.", "gloss_language": "de"}]}], "mohana": [{"id": "mohana", "headword": "मोहन", "headword_slp1": "mohana", "fold": "mohana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई) irre führend, verwirrend, bethörend, betäubend.\n— 2〉 m.\n — a〉 *Stechapfel.\n — b〉 Name eines der fünf Pfeile des Liebesgottes.\n — c〉 N. pr. verschiedener Männer.\n— 3〉 *f. आ\n — a〉 die Blüthe einer best. Jasminart.\n — b〉 Trigonella corniculata.\n— 4〉 f. ई\n — a〉 *Portulaca quadrifida RĀJAN. 7,135.\n — b〉 ein best. Blendwerk, — Trugbild.\n — c〉 ein best. Zauberspruch.\n — d〉 N. pr.\n — α〉 einer Apsaras.\n — β〉 einer Unholdin, einer Tochter des Garbhahantar.\n— 5〉 n.\n — a〉 das Sichirren, Bethörtsein, Verwirrung.\n — b〉 Betäubung, so v. a. das Betäubtsein.\n — c〉 Betäubung, euphemistisch für Beischlaf.\n — d〉 das Irremachen, Irreführen, Verwirren.\n — e〉 Blendwerk, Täuschung.\n — f〉 Mittel zu verwirren.\n — g〉 eine die Verwirrung eines Feindes bezweckende Zauberceremonie und der dazu verwandte Spruch. So heissen die Lieder AV. 3,1. 2.\n — h〉 N. pr. einer Stadt.", "gloss_language": "de"}], "synonyms": ["मोहनं", "मोहनः"], "synonyms_slp1": ["mohanaM", "mohanaH"]}], "mohanaka": [{"id": "mohanaka", "headword": "मोहनक", "headword_slp1": "mohanaka", "fold": "mohanaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *m. der Monat Caitra. Conj. für मोहनिक.\n— 2〉 f. ˚निका eine best. Pflanze.", "gloss_language": "de"}], "synonyms": ["मोहनकः"], "synonyms_slp1": ["mohanakaH"]}], "mohanadasa": [{"id": "mohanadAsa", "headword": "मोहनदास", "headword_slp1": "mohanadAsa", "fold": "mohanadasa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मोहनदास m. N. pr. eines Mannes.", "gloss_language": "de"}]}], "mohanaprakfti": [{"id": "mohanaprakfti", "headword