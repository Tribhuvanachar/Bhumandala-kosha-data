{"rap": [{"id": "rap", "headword": "रप्", "headword_slp1": "rap", "fold": "rap", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√रप्, र꣫पति schwatzen (leichthin oder unbedacht), flüstern.\n— Intens. रारपीति dass.\n— Mit आ zuflüstern, ansagen.\n— Mit परि in परिरा꣫प् fg.\n— Mit प्र schwatzen.\n— Mit प्रति zuflüstern.", "gloss_language": "de"}]}], "rapas": [{"id": "rapas", "headword": "रपस्", "headword_slp1": "rapas", "fold": "rapas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "र꣫पस् n. Gebrechen, körperlicher Schaden, Verletzung. ṚV. 1,69,8. 6,31,3 nach SĀY. = रक्षस्, nach AUFRECHTʼs sicherer Vermuthung (KUHNʼS Z. 25,601) ist aber विवे꣫र् अ꣫पांसि und अ꣫विवेर् अ꣫पांसि zu trennen.", "gloss_language": "de"}]}], "raps": [{"id": "rapS", "headword": "रप्श्", "headword_slp1": "rapS", "fold": "raps", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√रप्श्, रप्शते (Simplex nur in रय्श꣫दूधन्).\n— Mit प्र hinausreichen.\n— Mit वि zum Ueberschwang oder zum Platzen voll sein, strotzen, — von (Gen.), übergenug habend an (Instr.).", "gloss_language": "de"}]}], "rapsaduDan": [{"id": "rapSadUDan", "headword": "रप्शदूधन्", "headword_slp1": "rapSadUDan", "fold": "rapsaduDan", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "रप्श꣫दूधन् Adj. ein strotzendes Euter habend.", "gloss_language": "de"}]}], "rapsu": [{"id": "rapsu", "headword": "रप्सु", "headword_slp1": "rapsu", "fold": "rapsu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*रप्सु angeblich = रूप.", "gloss_language": "de"}]}], "rapsuda": [{"id": "rapsudA", "headword": "रप्सुदा", "headword_slp1": "rapsudA", "fold": "rapsuda", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassun