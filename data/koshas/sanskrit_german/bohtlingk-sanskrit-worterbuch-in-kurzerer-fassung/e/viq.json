{"viq": [{"id": "viq", "headword": "विड्", "headword_slp1": "viq", "fold": "viq", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√विड्, वेडति (आक्रोशे).", "gloss_language": "de"}]}, {"id": "vIq", "headword": "वीड्", "headword_slp1": "vIq", "fold": "viq", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√वीड्, वीडयति, ˚ते, वीळ꣫यति, ˚ते; act. festmachen, Med. fest —, hart sein. वीळित꣫ hart, fest.", "gloss_language": "de"}]}], "viqa": [{"id": "viqa", "headword": "विड", "headword_slp1": "viqa", "fold": "viqa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. n. eine Art Salz. Auch ˚लवण n. Mat. med. 84. RĀJAN. 6,98. BHĀVAPR. 1,181.\n— 2〉 m. N. pr. eines Landes und dessen Fürsten Ind. Antiq. 6,92. 7,302.\n— 3〉 *n. a part, a fracture, a bit.", "gloss_language": "de"}], "synonyms": ["विडं", "विडः"], "synonyms_slp1": ["viqaM", "viqaH"]}], "viqaganDa": [{"id": "viqaganDa", "headword": "विडगन्ध", "headword_slp1": "viqaganDa", "fold": "viqaganDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*विडगन्ध n. = विड्लवण. Vgl. विङ्गन्ध.", "gloss_language": "de"}]}], "viqaNga": [{"id": "viqaNga", "headword": "विडङ्ग", "headword_slp1": "viqaNga", "fold": "viqaNga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *m. f. (आ) Embelia ribes Mat. med. 187. RĀJAN. 6,49.\n— 2〉 n. die Frucht von Embelia ribes, ein Wurmmittel.\n— 3〉 *Adj. = अभिज्ञ.", "gloss_language": "de"}], "synonyms": ["विडंग", "विडङ्गं", "विडङ्गः"], "synonyms_slp1": ["viqaMga", "viqaNgaM", "viqaNgaH"]}], "viqamba": [{"id": "viqamba", "headword": "विडम्ब", "headword_slp1": "viqamba", "fold": "viqamba", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. am Ende eines Comp. Jmd nachahmend, [] Jmds Benehmen annehmend.\n— 2〉 m.\n — a〉 Verspottung, Verhöhnung.\n — b〉 Entweihung, Entwürdigung (einer Sache).", "gloss_language": "de"}], "synonyms": ["विडंब", "विडंबः", "विडम्बः"], "synonyms_slp1": ["viqaMba", "viqaMbaH", "viqambaH"]}], "viqambaka": [{"id": "viqambaka", "headword": "विडम्बक", "headword_slp1": "viqambaka", "fold": "viqambaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚विडम्बक Adj.\n— 1〉 nachahmend, täuschend ähnlich KĀD. 75,17 (139,1).\n— 2〉 entweihend. शाक˚ so v. a. dem Namen Gemüse Schande bereitend.", "gloss_language": "de"}, {"gloss": "विडम्बक VI. m. Spassmacher JĀTAKAM. 19,31.", "gloss_language": "de"}]}], "viqambana": [{"id": "viqambana", "headword": "विडम्बन", "headword_slp1": "viqambana", "fold": "viqambana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. am Ende eines Comp. Jmd nachahmend, Jmds Benehmen annehmend.\n— 2〉 f. (आ) n.\n — a〉 das Nachmachen, Nachahmen, Nachäffen, das Spielen einer Person (KĀD. 121,20 = 216,9), das dem Scheine nach Etwas Sein, blosse Maske, das dem Scheine nach Annehmen einer Erscheinungsform; insbes. von einem Gotte, der menschliches Aussehen und Benehmen annimmt. ˚नां कर् nachäffen, अर्चाविडम्बनं कर् eine scheinbare, falsche Verehrung an den Tag legen.\n — b〉 Verspottung, Verhöhnung; Spott, Hohn, Schimpf, Lächerlichkeit BHĀM. V. 1,27. ˚नं und ˚नां कर् Jmd verspotten (mit Acc. der Person).\n — c〉 Entweihung, Entwürdigung (einer Sache) BĀLAR. 227,8. 11.\n — d〉 Missbrauch.", "gloss_language": "de"}], "synonyms": ["विडंबन", "विडंबनं", "विडम्बनं"], "synonyms_slp1": ["viqaMbana", "viqaMbanaM", "viqambanaM"]}], "viqambin": [{"id": "viqambin", "headword": "विडम्बिन्", "headword_slp1": "viqambin", "fold": "viqambin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚विडम्बिन् Adj.\n— 1〉 nachahmend, den Schein von Etwas annehmend, täuschend ähnlich KĀD. 16,10 (25,9). VIKRAMĀṄKAC. 11,26. 34.\n— 2〉 verspottend, verhöhnend, so v. a. gleichkommend, übertreffend ŚIŚ. 5,68.\n— 3〉 entweihend, entwürdigend, Unfugtreibend mit Etwas. ऋक्ष˚ so v. a. ein Charlatan von Astrolog.", "gloss_language": "de"}]}], "viqambya": [{"id": "viqambya", "headword": "विडम्ब्य", "headword_slp1": "viqambya", "fold": "viqambya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "विडम्ब्य n. ein Gegenstand des Spottes.", "gloss_language": "de"}]}], "viqayataniya": [{"id": "viqAyatanIyA", "headword": "विडायतनीया", "headword_slp1": "viqAyatanIyA", "fold": "viqayataniya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "विडायतनीया f. eine best. Viṣṭuti LĀṬY. 6,6,7. 8.", "gloss_language": "de"}]}], "viqinaTakavi": [{"id": "viqinATakavi", "headword": "विडिनाथकवि", "headword_slp1": "viqinATakavi", "fold": "viqinaTakavi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "विडिनाथकवि (विळि˚) m. N. pr. eines Autors BURNELL, T.", "gloss_language": "de"}]}], "viqina": [{"id": "viqIna", "headword": "विडीन", "headword_slp1": "viqIna", "fold": "viqina", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "विडीन n. eine Art Flug MBH. 8,41,27.", "gloss_language": "de"}], "synonyms": ["विडीनं"], "synonyms_slp1": ["viqInaM"]}], "viqinaka": [{"id": "viqInaka", "headword": "विडीनक", "headword_slp1": "viqInaka", "fold": "viqinaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "विडीनक n. in डीन˚.", "gloss_language": "de"}]}], "viqu": [{"id": "viqu", "headword": "विडु", "headword_slp1": "viqu", "fold": "viqu", "headword_language": "sa", "source": "bohtlingk-san