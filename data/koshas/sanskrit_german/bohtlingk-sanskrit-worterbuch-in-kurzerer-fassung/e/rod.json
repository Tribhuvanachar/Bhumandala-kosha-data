{"roda": [{"id": "roda", "headword": "रोद", "headword_slp1": "roda", "fold": "roda", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "रो꣫द m. Klageton, das Winseln.", "gloss_language": "de"}], "synonyms": ["रोदः"], "synonyms_slp1": ["rodaH"]}], "rodana": [{"id": "rodana", "headword": "रोदन", "headword_slp1": "rodana", "fold": "rodana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 n.\n — a〉 das Weinen ĀPAST. Pl. SUŚR. 1,373,11. Wird zu den Kinderkrankheiten gezählt.\n — b〉 *Thränen.\n— 2〉 *f. ई Alhagi maurorum^1.\n[1] Correction submitted by Jim Funderburk, Thomas Malten on 20241207. Reference: https://github.com/sanskrit-lexicon/PWK/issues/111.", "gloss_language": "de"}], "synonyms": ["रोदनं"], "synonyms_slp1": ["rodanaM"]}], "rodanika": [{"id": "rodanikA", "headword": "रोदनिका", "headword_slp1": "rodanikA", "fold": "rodanika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*रोदनिका f. Alhagi maurorum RĀJAN. 4,44.", "gloss_language": "de"}]}], "rodara": [{"id": "rodara", "headword": "रोदर", "headword_slp1": "rodara", "fold": "rodara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. ein र im Innern habend.\n— 2〉 Anas casarca (चक्रवाक).", "gloss_language": "de"}]}], "rodas": [{"id": "rodas", "headword": "रोदस्", "headword_slp1": "rodas", "fold": "rodas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "रो꣫दस् n. Du. Himmel und Erde. Am Anfange eines Comp. ŚIŚ. 19,106. रोदोरन्ध्र (ŚIŚ. 18,15), रोदःकुहर (NALOD. 3,32), रोदःकन्दरकुहर (BĀLAR. 95,7) und रोदोगृह (ebend. 126,20) eine zwischen Himmel und Erde gelegene Höhlung u. s. w. In स्वर्गरोदःकुहर BĀLAR. 23,15 hat रोदस् wie auch रोदसी die Bedeutung Erde.", "gloss_language": "de"}]}], "rodasi