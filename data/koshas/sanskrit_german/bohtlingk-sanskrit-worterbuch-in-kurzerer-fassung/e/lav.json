{"lava": [{"id": "lava", "headword": "लव", "headword_slp1": "lava", "fold": "lava", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ल꣫व\n— 1〉 m.\n — a〉 das Schneiden, Abschneiden, Abpflücken (von Blumen). कुसुम˚ so v. a. gepflückte Blumen.\n — b〉 Schur, Wolle; Haar (einer Kuh).\n — c〉 Abschnitt, Stück, eine Partikel von, ein Minimum, ein Bischen, Tropfen. Zum Ueberfluss kann noch लेश angehängt werden. लवम् Adv. ein wenig. Angeblich auch n. Am Ende eines adj. Comp. f. आ. Vgl. पदाति˚.\n — d〉 ein best. sehr kleiner Zeittheil. Häufig personificirt.\n — e〉 bei den Astronomen Grad.\n — f〉 Zähler eines Bruchs.\n — g〉 *Untergang.\n — h〉 *Ausgelassenheit.\n — i〉 N. pr.\n — α〉 eines Sohnes des Rāma und der Sītā.\n — β〉 eines Fürsten von Kāśmīra.\n— 2〉 *n.\n — a〉 Muskatnuss.\n — b〉 Gewürznelke RĀJAN. 12,85.\n — c〉 die Wurzel von Andropogon muricatus RĀJAN. 12,151.", "gloss_language": "de"}], "synonyms": ["लवं", "लवः"], "synonyms_slp1": ["lavaM", "lavaH"]}, {"id": "lAva", "headword": "लाव", "headword_slp1": "lAva", "fold": "lava", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. लाव Adj. (f. ई) am Ende eines Comp.\n— 1〉 schneidend, [] abschneidend, pflückend.\n— 2〉 zerhauend, tödtend.", "gloss_language": "de"}, {"gloss": "2. लाव m. schlechte Schreibart für लाब.", "gloss_language": "de"}], "synonyms": ["लावः"], "synonyms_slp1": ["lAvaH"]}], "lavaka": [{"id": "lavaka", "headword": "लवक", "headword_slp1": "lavaka", "fold": "lavaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *Adj. schneidend, Schnitter.\n— 2〉 Bez. eines best. Stoffes.", "gloss_language": "de"}], "synonyms": ["लवकः"], "synonyms_slp1": ["lavakaH"]}, {"id": "lavAka", "headword": "लवाक", "headword_slp1": "lavAka", "fold": "lavaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung