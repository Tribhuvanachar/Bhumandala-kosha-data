{"laj": [{"id": "laj", "headword": "लज्", "headword_slp1": "laj", "fold": "laj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √लज्, लजते sich schämen BHAṬṬ. *लग्न sich schämend, beschämt.", "gloss_language": "de"}, {"gloss": "2. *√लज्, लजति (भर्त्सने oder भर्जने).", "gloss_language": "de"}, {"gloss": "3. *√लज्, लजयति (प्रकाशने).", "gloss_language": "de"}]}, {"id": "lajj", "headword": "लज्ज्", "headword_slp1": "lajj", "fold": "laj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√लज्ज्, लज्जते (metrisch und ungenau auch Act.).\n— 1〉 verlegen werden (LALIT. 405,14), sich schämen, — von Jmd (Abl.), Jmds (Instr. oder Gen. Spr. 7420 nebst. v. l.), einer Sache (Instr.), zu (Infin.).\n— 2〉 लज्जित\n — a〉 verlegen, sich schämend, beschämt, sich Jmds (Instr.) oder einer Sache (im Comp. vorangehend) schämend.\n — b〉 verschämt, verlegen, so v. a. von Scham —, von Verlegenheit begleitet.\n— Caus. लज्जयति Jmd sich Schämen machen, Jmds Schamgefühl erwecken; mit Acc.\n— Mit अधि, ˚लज्जित sich schämend, beschämt über (Loc.). Vielleicht अतिल˚ zu lesen.\n— Mit वि sich schämen, — zu (Infin.). विलज्जित sich schämend, beschämt, — über (im Comp. vorangehend).\n— Mit सम् sich schämen.", "gloss_language": "de"}]}, {"id": "lAj", "headword": "लाज्", "headword_slp1": "lAj", "fold": "laj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√लाज्, लाजति (भर्जने oder भर्त्सने).", "gloss_language": "de"}]}], "laja": [{"id": "lajja", "headword": "लज्ज", "headword_slp1": "lajja", "fold": "laja", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*लज्ज m. N. pr. eines Mannes; Pl. seine Nachkommen. लज्जा s. bes.", "gloss_language": "de"}]}, {"id": "lajjA", "headword": "लज्जा", "headword_slp1": "lajjA", "fold": "laja", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "लज्जा f.\n— 1〉 Scham, Schamgefühl, Verlegenheit, das Sichschämen einer Sache (im Comp. vorangehend 124,33). पुत्रौ युवां मे का लज्जा ihr seid meine Kinder, warum sollte ich mich schämen? KATHĀS. 2,53. Die personificirte Scham ist eine Gattin Dharmaʼs und Mutter Vinayaʼs.\n— 2〉 *Mimosa pudica RĀJAN. 5,104.", "gloss_language": "de"}]}, {"id": "lAja", "headword": "लाज", "headword_slp1": "lAja", "fold": "laja", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "लाज꣫\n— 1〉 m. f. (आ) Pl. geröstete Körner RĀJAN. 16,94. BHĀVAPR. 2,30. लाजाधारी Adj. f. MĀN. GṚHY. 1,10. 11.\n— 2〉 *n. die Wurzel von Andropogon muricatus.", "gloss_language": "de"}], "synonyms": ["लाजं", "लाजः"], "synonyms_slp1": ["lAjaM", "lAjaH"]}], "lajaka": [{"id": "lajjakA", "headword": "लज्जका", "headword_slp1": "lajjakA", "fold": "lajaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*लज्जका f. der wilde Baumwollenbaum.", "gloss_language": "de"}]}], "lajari": [{"id": "lajjarI", "headword": "लज्जरी", "headword_slp1": "lajjarI", "fold": "lajari", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*लज्जरी f. eine weisse Sinnpflanze.", "gloss_language": "de"}]}], "lajakara": [{"id": "lajjAkara", "headword": "लज्जाकर", "headword_slp1": "lajjAkara", "fold": "lajakara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "लज्जाकर Adj. (f. ई) beschämend, Jmd (im Comp. vorangehend) [] beschämend 248,27.", "gloss_language": "de"}]}], "lajakfti": [{"id": "lajjAkfti", "headword": "लज्जाकृति", "headword_slp1": "lajjAkfti", "fold": "lajakfti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "लज्जाकृति Adj. Scham heuchelnd Spr. 1780.",