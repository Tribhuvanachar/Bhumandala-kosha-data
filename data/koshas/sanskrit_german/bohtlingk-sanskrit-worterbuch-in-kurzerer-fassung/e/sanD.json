aMDAnIya", "headword": "संधानीय", "headword_slp1": "saMDAnIya", "fold": "sanDaniya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*संधानीय Adj.\n— 1〉 mit dem man sich verbünden, — vertragen muss.\n— 2〉 zum Wiederfestmachen —, zum Verheilen beitragend, verheilend CARAKA. 1,4. Comm. zu ĀPAST. ŚR. 14,26,2.", "gloss_language": "de"}]}], "sanDay": [{"id": "saMDay", "headword": "संधय्", "headword_slp1": "saMDay", "fold": "sanDay", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "!√संधय्, ˚यति\n— 1〉 zusammenfügen, in Verbindung bringen mit (Instr.).\n— 2〉 einen Pfeil mit dem Bogen zusammenfügen, so v. a. auflegen.\n— 3〉 sich Etwas aneignen.\n— 4〉 sich aussöhnen, Frieden schliessen. Nur संधितुम्.\n— 5〉 संधित\n — a〉 zusammengefügt.\n — b〉 (mit der Sehne) zusammengefügt. so v. a. aufgelegt (Pfeil); angelegt.\n — c〉 verbunden mit (im Comp. vorangehend). मृत्यु˚ so v. a. dem Tode geweiht.\n — d〉 verbündet, der einen Bund der Frieden geschlossen hat.\n — e〉 geschlossen (ein Bündniss) in सम˚.\n — f〉 durch Mischung u. s. w. bereitet.\n — g〉 fehlerhaft für संदित.\n— Mit अति, ˚संधित betrogen, getäuscht.\n— 1〉 zusammengefügt.\n— 2〉 zum Bundesgenossen gemacht.\n— 3〉 versehen worden mit (Instr.).\n— 4〉 am Ende eines Comp. entschlossen zu, beabsichtigend.\n— 5〉 mit einer Absicht verbunden in अनभिसंधित Nachtr. 6.\n— Mit प्रति, ˚संधित befestigt, verstärkt.", "gloss_language": "de"}, {"gloss": "!√संधय् mit अनु auch fügen, bestimmen. भाविकर्मानुसंधयेत् (विधिः) KĀŚĪKH. 13,95.", "gloss_language": "de"}]}], "sanDartar": [{"id": "saMDartar", "headword": "संधर्तर्", "headword_slp1": "saMDartar", "fold": "sanDartar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधर्तर् Nom. ag. Zusammenhalter ATHARVAŚIKHOP. 235.", "gloss_language": "de"}]}], "sanDatar": [{"id": "saMDAtar", "headword": "संधातर्", "headword_slp1": "saMDAtar", "fold": "sanDatar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सं꣫धातर् Nom. ag.\n— 1〉 mit Acc. der zusammenfügt, Zusammenfüger. Auch als Bein. Śivaʼs und [] Viṣṇuʼs.\n— 2〉 M. 8,342 schlechte Lesart für संदातर्.", "gloss_language": "de"}]}], "sanDatavya": [{"id": "saMDAtavya", "headword": "संधातव्य", "headword_slp1": "saMDAtavya", "fold": "sanDatavya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj.\n — a〉 anzufügen.\n — b〉 mit dem man sich verbünden, vertragen muss.\n— 2〉 n., impers. sich zu verbünden, — mit (सह).", "gloss_language": "de"}], "synonyms": ["सन्धातव्य"], "synonyms_slp1": ["sanDAtavya"]}], "sanDana": [{"id": "saMDAna", "headword": "संधान", "headword_slp1": "saMDAna", "fold": "sanDana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधा꣫न\n— 1〉 Adj. zusammenfügend, heilend.\n— 2〉 m.\n — a〉 ein best. über Waffen gesprochener Zauberspruch.\n — b〉 N. pr. eines Ministers.\n— 3〉 *f. संधानी\n — a〉 das Mischen, Bereiten eines Trankes.\n — b〉 ein Ort, an dem die unedlen Metalle aufbewahrt werden.\n— 4〉 n.\n — a〉 das Zusammenfügen, Vereinigen, Vereinigung VAITĀN. 43,45. MBH. 7,142,45.\n — b〉 Zusammenführung, Vereinigung, Zusammenkommen von Menschen. संधानमायातः so v. a. Zutritt erhalten habend (ein Bote).\n — c〉 Fuge, Gelenk; Berührungspunct.\n — d〉 was eine Vereinigung bewirkt, Mittel der Vereinigung.\n — e〉 das Ansetzen, Wiederansetzen, Zusammenheilen.\n — f〉 das Auflegen eines Pfeils (mit und ohne Hinzufügung dieses Wortes), — auf (Instr.) ŚIŚ. 2,97. 20,8.\n — g〉 das Anreihen von Wörtern u. s. w. Auch = संधि Verbindung der Laute in Wort und Satz.\n — h〉 Vereinigung Entzweiter, Vertrag, Vergleich, Bündniss, Friedensschluss, freundschaftliches Verhältniss, — mit (Instr. oder Instr. mit सह) 109,17. ŚIŚ. 2,97. 20,8. संधानासन n. und यात्रासंधान so v. a. संधायासन und संधायगमन (s. u. संधाय) MBH. 12,69,67.\n — i〉 das Zusammensetzen, Mischen, Bereiten eines Trankes.\n — k〉 *saurer Reisschleim.\n — l〉 *ein geistiges Getränk.\n — m〉 *eine Durst erregende Speise.", "gloss_language": "de"}, {"gloss": "संधान VII. n. das Wahrnehmen DAMAYANTĪK. 222.", "gloss_language": "de"}], "synonyms": ["संधानं", "सन्धान", "सन्धानं"], "synonyms_slp1": ["saMDAnaM", "sanDAna", "sanDAnaM"]}], "sanDanaka": [{"id": "saMDAnaka", "headword": "संधानक", "headword_slp1": "saMDAnaka", "fold": "sanDanaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ˚निका)\n — a〉 zusammenhaltend. नेमि˚ rund umschliessend (ein Verband).\n — b〉 zusammenhaltend, so v. a. erhaltend.\n— 2〉 f. ˚निका ein best. Getränk.", "gloss_language": "de"}]}], "sanDanakarin": [{"id": "saMDAnakArin", "headword": "संधानकारिन्", "headword_slp1": "saMDAnakArin", "fold": "sanDanakarin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधानकारिन् Adj. zusammenfügend, verheilend. भिन्न˚ Getrenntes zusammenfügend.", "gloss_language": "de"}]}], "sanDanakft": [{"id": "saMDAnakft", "headword": "संधानकृत्", "headword_slp1": "saMDAnakft", "fold": "sanDanakft", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधानकृत् Adj. zusammenfügend, heilend.", "gloss_language": "de"}]}], "sanDanatala": [{"id": "saMDAnatAla", "headword": "संधानताल", "headword_slp1": "saMDAnatAla", "fold": "sanDanatala", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधानताल m. und संधानभाव m. ein best. Tact.", "gloss_language": "de"}]}], "sanDanaBava": [{"id": "saMDAnaBAva", "headword": "संधानभाव", "headword_slp1": "saMDAnaBAva", "fold": "sanDanaBava", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung",