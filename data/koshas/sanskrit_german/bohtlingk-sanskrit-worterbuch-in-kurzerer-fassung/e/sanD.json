de"}], "synonyms": ["सन्धाय"], "synonyms_slp1": ["sanDAya"]}], "sanDayin": [{"id": "saMDAyin", "headword": "संधायिन्", "headword_slp1": "saMDAyin", "fold": "sanDayin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधायिन् Adj. Pfeile auflegend ŚIŚ. 19,97.", "gloss_language": "de"}]}], "sanDaraRa": [{"id": "saMDAraRa", "headword": "संधारण", "headword_slp1": "saMDAraRa", "fold": "sanDaraRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. zusammenhaltend, erhaltend.\n— 2〉 f. आ\n — a〉 Haltung, Stellung. मुख˚ Mundstellung.\n — b〉 das Richten der Gedanken auf (im Comp. vorangehend).\n— 3〉 n.\n — a〉 das Tragen. कुक्षि eines Kindes im Mutterleibe.\n — b〉 das Zusammenhalten, Unterhalten. प्राण˚ KĀD. 248,15 (406,4). 2,28,8 (32,18). Am Ende eines adj. Comp. unterhalten von.\n — c〉 das Zurückhalten, Abhalten, Verhalten, Anhalten. प्राण˚ HEMĀDRI 1,468,16.", "gloss_language": "de"}], "synonyms": ["संधारणं", "सन्धारण"], "synonyms_slp1": ["saMDAraRaM", "sanDAraRa"]}], "sanDaraRiya": [{"id": "saMDAraRIya", "headword": "संधारणीय", "headword_slp1": "saMDAraRIya", "fold": "sanDaraRiya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधारणीय Adj. aufrecht —, am Leben zu erhalten KĀD. 2,116,2 (143,1).", "gloss_language": "de"}]}], "sanDarya": [{"id": "saMDArya", "headword": "संधार्य", "headword_slp1": "saMDArya", "fold": "sanDarya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधार्य Adj.\n— 1〉 zu tragen, getragen werden müssend.\n— 2〉 bei sich zu halten, in seiner Nähe zu halten (ein Diener).\n— 3〉 aufrecht zu erhalten, zu behaupten, zu beobachten.\n— 4〉 aufzuhalten in seinen Folgen, unschädlich zu machen HARIV. 2,22,64.", "gloss_language": "de"}], "synonyms": ["सन्धार्य", "सन्धार्य्य"], "synonyms_slp1": ["sanDArya", "sanDAryya"]}], "sanDavacana": [{"id": "saMDAvacana", "headword": "संधावचन", "headword_slp1": "saMDAvacana", "fold": "sanDavacana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधावचन n. = संधाभाषित Text zu Lot. de la b. l. 38.", "gloss_language": "de"}]}], "sanDi": [{"id": "saMDi", "headword": "संधि", "headword_slp1": "saMDi", "fold": "sanDi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधि꣫\n— 1〉 Adj. einen Uebergang enthalten u. s. w.\n— 2〉 m. (ganz vereinzelt f.; s. u. i〉)\n — a〉 Verbindung, Vereinigung, — mit (Instr.) ŚIŚ. 20,9.\n — b〉 Verkehr mit (Instr.).\n — c〉 Vereinigung, so v. a. das Ganze, der Inbegriff in नीति˚\n — d〉 Uebereinstimmung.\n — e〉 Uebereinkunft, Verabredung.\n — f〉 Friede, Bündniss zwischen (Gen.), mit (Instr. oder Instr. mit सह.)\n — g〉 Verbindung der Laute in Wort und Satz, die euphonischen Veränderungen zusammenstossender Laute.\n — h〉 Veranstaltung, Bewirkung DAŚAK. 83,19.\n — i〉 Ort oder Zeit des Zusammentreffens, Berührungspunct, Grenze (ĀPAST. 1,11,9. MBH. 12,69,6. HARIV. 9004); Zwischenraum, Zwischenzeit. f. GARGA in KERNʼs Uebersetzung zu VARĀH. BṚH. S. 30,2.\n — k〉 Fuge, Gelenk. ˚संधीषु Loc. Pl. metrisch.\n — l〉 Berührungspunct von Himmel und Erde, Horizont.\n — m〉 die einem Doppeldreieck gemeinsame Linie ŚULBAS. 3,177. fg.\n — n〉 die Zeit zwischen Tag und Nacht, Uebergangszeit, Dämmerung ĀPAST. 1,9,20. 11,15. 27,5. 30,8.\n — o〉 Nacht.\n — p〉 Falte.\n — q〉 Wand PĀR. GṚHY. 3,4,10. fgg. Hierher oder zu r〉 संधिं च्छिद् (M. 9,276. DAŚAK. 57,3) oder भिद् (Chr. 127,6) eine Wand durchschlagen, eine Bresche machen (von Dieben gesagt.)\n — r〉 eine in der Mauer (von Dieben) gemachte Oeffnung, Bresche.\n — s〉 beim Auge heissen so fünf Verbindung der Bestandtheile desselben. []\n — t〉 die weibliche Scham.\n — u〉 Theil, Stück.\n — v〉 ein best. Stotra am Uebergange zweier Tage. संधिवत् Adv. LĀṬY. 3,1,32.\n — w〉 in der Dramatik Bez.\n — α〉 der fünf Fugen in einem Schauspiel मुख विमुख गर्भ विमर्श und निर्वहण. Im DHŪRTAS. deren nur zwei.\n — β〉 eines der 14 Glieder im Nirvahaṇa (Katastrophe).\n — x〉 = सावकाश.\n — y〉 N. pr. eines Mannes. Zu belegen als Sohn des Prasuśruta.\n — z〉 कर्मसंधिषु Spr. 4735 fehlerhaft für ˚सङ्गिषु.\n— 3〉 f. die Genie der Verbindung.", "gloss_language": "de"}], "synonyms": ["संधिः", "सन्धि", "सन्धिः"], "synonyms_slp1": ["saMDiH", "sanDi", "sanDiH"]}, {"id": "saMDI", "headword": "संधी", "headword_slp1": "saMDI", "fold": "sanDi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधी f. s. u. संधि 2〉k〉.", "gloss_language": "de"}]}], "sanDika": [{"id": "saMDika", "headword": "संधिक", "headword_slp1": "saMDika", "fold": "sanDika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 am Ende eines adj. Comp. von संधि Gelenk.\n— 2〉 m. eine Art Fieber.\n— 3〉 f. आ das Brennen geistiger Getränke.", "gloss_language": "de"}], "synonyms": ["संधिकः", "सन्धिक"], "synonyms_slp1": ["saMDikaH", "sanDika"]}, {"id": "sAMDika", "headword": "सांधिक", "headword_slp1": "sAMDika", "fold": "sanDika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*सांधिक m. Branntweinbrenner.", "gloss_language": "de"}], "synonyms": ["सांधिकः", "सान्धिक", "सान्धिकः"], "synonyms_slp1": ["sAMDikaH", "sAnDika", "sAnDikaH"]}], "sanDiga": [{"id": "saMDiga", "headword": "संधिग", "headword_slp1": "saMDiga", "fold": "sanDiga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "संधिग m. = संधिक 2〉 BHĀVAPR. 3,77.", "gloss_language": "de"}], "synonyms": ["सन्धिग"], "synonyms_slp1": ["sanDiga"]}], "sanDigupta": [{"id": "saMDigupta", "headword": "संधिगुप्त", "headword_slp1": "saMDigupta", "fold": "sanDigupta", "headword_language": "sa", "source": "bohtling