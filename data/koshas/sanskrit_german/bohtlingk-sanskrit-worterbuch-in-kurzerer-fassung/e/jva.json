{"jvar": [{"id": "jvar", "headword": "ज्वर्", "headword_slp1": "jvar", "fold": "jvar", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√ज्वर्, ज्वरति *fiebern.\n— Caus. ज्वरयति Jmd in Fieberhitze versetzen CARAKA. 6,23. ज्वर्यते Pass. in Fieberhitze versetzt werden, Fieber bekommen 3.\n— Mit प्र in प्रज्वार.\n— Mit सम् sich betrüben, — härmen.\n— Mit अनुसम्\n— 1〉 mit einem Andern (Acc.) betrübt [] sein.\n— 2〉 sich betrüben, neidisch sein.\n— Mit अभिसम् sich betrüben über, beneiden; mit Acc.", "gloss_language": "de"}]}], "jvara": [{"id": "jvara", "headword": "ज्वर", "headword_slp1": "jvara", "fold": "jvara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. (adj. Comp. f. आ)\n — a〉 Fieber. Bildlich von Allem, was an Jmd oder Etwas zehrt. Personificirt in den mannichfachsten Formen.\n — b〉 das an der Seele zehrende Fieber, Seelenschmerz, Betrübniss, Trauer.\n— 2〉 f. आ HARIV. 10918 fehlerhaft für जरा.\n— 3〉 Adj. scheinbar MBH. 13,3464, wo die v. l. भृशज्वर hat.", "gloss_language": "de"}], "synonyms": ["ज्वरः"], "synonyms_slp1": ["jvaraH"]}, {"id": "jvAra", "headword": "ज्वार", "headword_slp1": "jvAra", "fold": "jvara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ज्वार in नवज्वार꣫.", "gloss_language": "de"}]}], "jvaraksaya": [{"id": "jvarakzaya", "headword": "ज्वरक्षय", "headword_slp1": "jvarakzaya", "fold": "jvaraksaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "ज्वरक्षय m. Costus speciosus Cit. bei UTPALA zu VARĀH. BṚH. S. 78,1.", "gloss_language": "de"}], "synonyms": ["ज्वरक्षयः"], "synonyms_slp1": ["jvarakzayaH"]}], "jvaraGna": [{"id": "jvaraGna", "headword": "ज्वरघ्न", "headword_slp1": "jvaraGna", "fold": "jvaraGna", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fa