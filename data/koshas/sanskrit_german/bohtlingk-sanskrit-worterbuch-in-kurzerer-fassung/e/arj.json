{"arj": [{"id": "arj", "headword": "अर्ज्", "headword_slp1": "arj", "fold": "arj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √अर्ज्\n— 1〉 अर्जति sich verschaffen NAIṢ. BHAṬṬ.\n— 2〉 *अर्जते (गतिस्थानार्जनोर्जनेषु, auch स्थैर्य st. स्थान und उपार्जन st. ऊर्जन).\n— Caus. अर्जयति und ˚ते\n— 1〉 sich verschaffen, erwerben, erlangen.\n— 2〉 = *सतो गुणान्तराधाने.\n— Mit अति\n— 1〉 hinüberschaffen, zulassen.\n— 2〉 wegschaffen, beseitigen.\n— Mit अप्यति hinzufügen zu.\n— Mit अभ्यति hinüberschaffen in, übertragen auf (Acc.).\n— Mit अनु loslassen.\n— Mit अपि hinwerfen.\n— Caus. dass. GOBH. 1,8,28.\n— Mit अव entlassen.\n— Mit अन्वव\n— 1〉 entlassen nach einer best. Richtung.\n— 2〉 heimsuchen.\n— Mit समव zusammenlassen.\n— Mit समा Caus. अमार्जित erworben, erlangt.\n— Mit उद् herausschaffen.\n— Mit उप hinzubringen, zulassen.\n— Caus. Act. Med. sich verschaffen, erwerben, erlangen.\n— Mit समुप Caus. verschaffen BHĀVAPR. 3,30.\n— Mit प्र Caus. verschaffen.", "gloss_language": "de"}, {"gloss": "2. √अर्ज्, ऋञ्जति, ˚ते s. √रञ्ज्.", "gloss_language": "de"}, {"gloss": "1. √अर्ज् mit निस् herauslassen, — geben TS. 1,5,9,3.", "gloss_language": "de"}, {"gloss": "1. √अर्ज् mit निस् 3.", "gloss_language": "de"}]}], "arjaka": [{"id": "arjaka", "headword": "अर्जक", "headword_slp1": "arjaka", "fold": "arjaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. sich verschaffen, erwerbend.\n— 2〉 [] *m. Ocimum pilosum RĀJAN. 10,159.", "gloss_language": "de"}, {"gloss": "अर्जक 2〉 SUŚR. 2,461,3, wo सहार्जकम् zu lesen ist.", "gloss_language": "de"}, {"gloss": "अर्जक I. 5.", "gloss_language": "de"}], "synonyms": ["अर्जकः", "अर्ज्जक", "अर्ज्जकः"], "synonyms_slp1": ["arjakaH", "arjjaka", "arjjakaH"]}], "arjana": [{"id": "arjana", "headword": "अर्जन", "headword_slp1": "arjana", "fold": "arjana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-