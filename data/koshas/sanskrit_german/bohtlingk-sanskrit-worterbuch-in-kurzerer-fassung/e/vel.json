{"vel": [{"id": "vel", "headword": "वेल्", "headword_slp1": "vel", "fold": "vel", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√वेल्, वेलति (चलने). !√वेलय् s. bes.\nMit उद्, उद्वेलन्त् fehlerhaft für उद्वेल्लन्त्.", "gloss_language": "de"}]}, {"id": "vell", "headword": "वेल्ल्", "headword_slp1": "vell", "fold": "vel", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√वेल्ल्, वेल्लति (auch वेल्लमान soll vorkommen) taumeln, schwanken, sich wiegen, wogen, Gewöhnlich वेल्लन्त्. वेल्लित\n— 1〉 schwankend, wogend.\n— 2〉 gebogen, gekrümmt, sich kräuselnd; sich etwas Anderes legend ŚIŚ. 7,72.\n— Caus. वेल्लयति wellen (einen Teig) BHĀVAPR. 2,24. वेल्लित 18.\n— Mit अनु, ˚वेल्लित untergeschoben.\n— Mit उद् in eine schwankende Bewegung gerathen, sich hinundher bewegen HEM. PAR. 1,263. VĀSAV. 50,2. उद्वेल्लित\n— Mit वि beben, zittern.\n— Mit सम्, संवेल्लित sich kräuselnd KĀD. 2,96,6 (118,6).", "gloss_language": "de"}]}], "vela": [{"id": "vela", "headword": "वेल", "headword_slp1": "vela", "fold": "vela", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वेल\n— 1〉 n. Garten, Park.\n— 2〉 eine best. hohe Zahl (buddh.).", "gloss_language": "de"}], "synonyms": ["वेलं", "वेलः"], "synonyms_slp1": ["velaM", "velaH"]}, {"id": "velA", "headword": "वेला", "headword_slp1": "velA", "fold": "vela", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "वे꣫ला f.\n— 1〉 Endpunct, Grenze.\n— 2〉 Entfernung ŚULBAS. 3,34. 207.\n— 3〉 Grenze des Landes und der See, Gestade, Küste, Ufer, Die personificirte Küste ist eine Tochter Meruʼs und Gattin Samudraʼs.\n— 4〉 Zeitgrenze, Zeitpunct, Zeitraum, Tageszeit, Stunde. का वेला so v. a. was ist die Uhr? HARṢAC. 127,13. का वेला तत्रभवत्याः प्राप्तायाः; so v. a. wie lange ist sie schon da? पश्चिमा Abendstunde. ˚वेलम् Adv. nach einem Zahlwort so v. a. = mal.\n— 5〉 gelegen Stunde, Gelegenheit. वेलायाम् zur rechten Stunde; अन्धवेलायाम् so v. a. wenn es gilt blind zu sein; अर्थवेलायाम् so v. a. wenn es sich um den Sinn handelt; वेलां प्र कर् auf eine Gelegenheit warten, lauern.\n— 6〉 *die Essensstunde eines vornehmen Herrn.\n— 7〉 die letzte Stunde, Todesstunde.\n— 8〉 *ein sanfter Tod.\n— 9〉 die Zeit des Meeres, so v. a. Fluth (Gegensatz Ebbe).\n— 10〉 starke Strömung (eines Flusses). v. l. वेग\n— 11〉 *= रोग oder राग.\n— 12〉 *Zahnfleisch.\n— 13〉 *Rede.\n— 14〉 N. pr.\n — a〉 *der Gattin Buddhaʼs.\n — b〉 einer an einer Küste aufgefundenen Königstochter. Nach ihr ist der der 11te Lambaka im KATHĀS. benannt.", "gloss_language": "de"}]}, {"id": "vella", "headword": "वेल्ल", "headword_slp1": "vella", "fold": "vela", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*वेल्ल n. Embelia ribes. Vgl. कारवेल्ल und ˚वेल्ली.", "gloss_language": "de"}], "synonyms": ["वेल्लं", "वेल्लः"], "synonyms_slp1": ["vellaM", "vellaH"]}], "velay": [{"id": "velay", "headword": "वेलय्", "headword_slp1": "velay", "fold": "velay", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*!√वेलय्, ˚यति (कालोपदेशे).", "gloss_language": "de"}]}, {"id": "velAy", "headword": "वेलाय्", "headword_slp1": "velAy", "fold": "velay", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*!√वेलाय् Denomin. von वेला.", "gloss_language": "de"}]}], "velakula": [{"id": "velAkUla", "headword": "वेलाकूल", "headword_slp1": "velAkUla", "fold": "velakula", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. वेलाकूल n. Küste, Ufer (ausnahmsweise eines Flusses) UTTAMAC. 161. 189. 334. 344.", "gloss_language": "de"}, {"gloss": "2. वेलाकूल\n— 1〉 Adj. an der Küste gelegen.\n— 2〉 *n. N. pr. einer Stadt, = ताम