{"Buya": [{"id": "Buyya", "headword": "भुय्य", "headword_slp1": "Buyya", "fold": "Buya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भुय्य m. N. pr. eines Mannes.", "gloss_language": "de"}]}], "Buyans": [{"id": "BUyaMs", "headword": "भूयंस्", "headword_slp1": "BUyaMs", "fold": "Buyans", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भू꣫यंस्\n— 1〉 Adj. (f. भूयसी)\n — a〉 werdend in ब्रह्म˚.\n — b〉 mehr, zahlreicher, reichlicher, — als (Abl.).\n — c〉 mehr bedeutend, — werth, mächtiger, grösser — als (Abl.)\n — d〉 viel, vielfach, zahlreich.\n — e〉 sehr gross, bedeutend, heftig.\n — f〉 reichlich versehen mit (Instr. oder im Comp. vorangehend).\n— 2〉 भूयस् Adv.\n — a〉 mehr, am meisten.\n — b〉 sehr, in hohem Grade. भूयस्तरम् in höherm Grade als (Abl.).\n — c〉 ferner, weiter, weiterhin, ausserdem, noch. पूर्वम् — भूयः, आदौ — पश्चात् — भूयः.\n — d〉 wieder, [] von Neuem. भूयो, ऽपि, भूयश्चापि, भूयो, भूयः und पुनर्भूयः dass.\n— 3〉 भूयसा instr. Adv.\n — a〉 über die Maassen, in hohem Grade.\n — b〉 meist, in der Regel.\n— 4〉 n. das Werden, Eingehen in ब्रह्म˚.", "gloss_language": "de"}]}], "BuyaHpalayana": [{"id": "BUyaHpalAyana", "headword": "भूयःपलायन", "headword_slp1": "BUyaHpalAyana", "fold": "BuyaHpalayana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "भूयःपलायन n. abermaliges Entfliehen KATHĀS. 38,126.", "gloss_language": "de"}]}], "Buyatva": [{"id": "BUyatva", "headword": "भूयत्व", "headword_slp1": "BUyatva", "fold": "Buyatva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚भूयत्व n. = ˚भूय in ब्रह्म˚.", "gloss_language": "de"}]}], "Buyarupa": [{"id": "BUyarUpa", "headword": "भूयरूप", "headword_slp1": "BUyarUpa", "fold": "Buyarupa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-f