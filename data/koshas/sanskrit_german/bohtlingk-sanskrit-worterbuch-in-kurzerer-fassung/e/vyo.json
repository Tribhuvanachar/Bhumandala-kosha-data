.", "gloss_language": "de"}]}], "vyomanasika": [{"id": "vyomanAsikA", "headword": "व्योमनासिका", "headword_slp1": "vyomanAsikA", "fold": "vyomanasika", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*व्योमनासिका f. Wachtel.", "gloss_language": "de"}]}], "vyomapaYcaka": [{"id": "vyomapaYcaka", "headword": "व्योमपञ्चक", "headword_slp1": "vyomapaYcaka", "fold": "vyomapaYcaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "व्योमपञ्चक n. vielleicht die fünf Oeffnungen im Körper.", "gloss_language": "de"}]}], "vyomapada": [{"id": "vyomapAda", "headword": "व्योमपाद", "headword_slp1": "vyomapAda", "fold": "vyomapada", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "व्योमपाद Adj. dessen Fuss im Luftraum steht [] (Viṣṇu).", "gloss_language": "de"}]}], "vyomapuspa": [{"id": "vyomapuzpa", "headword": "व्योमपुष्प", "headword_slp1": "vyomapuzpa", "fold": "vyomapuspa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "व्योमपुष्प n. eine im Luftraume schwebende Blume, so v. a. Unding HEM. PAR. 2,108. Vgl. खपुष्प.", "gloss_language": "de"}]}], "vyomamaYjara": [{"id": "vyomamaYjara", "headword": "व्योममञ्जर", "headword_slp1": "vyomamaYjara", "fold": "vyomamaYjara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*व्योममञ्जर n. und *व्योममण्डल n. Fahne.", "gloss_language": "de"}], "synonyms": ["व्योममंजर", "व्योममञ्जरं"], "synonyms_slp1": ["vyomamaMjara", "vyomamaYjaraM"]}], "vyomamudgara": [{"id": "vyomamudgara", "headword": "व्योममुद्गर", "headword_slp1": "vyomamudgara", "fold": "vyomamudgara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*व्योममुद्गर m. Windstoss, Wirbelwind.", "gloss_language": "de"}