{"yup": [{"id": "yup", "headword": "युप्", "headword_slp1": "yup", "fold": "yup", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√युप्, *युप्यति (विमोहने d. i. व्याकुलीकरणे. एकीकरणे, समीकरणे); zu belegen nur Perf. und युपित꣫.\n— 1〉 verwischen, so v. a. verscheuchen, dem Auge entziehen.\n— 2〉 verwischen, so v. a. zerstören, verwirren.\n— 3〉 verwischt —, unsichtbar sein.\n— Caus. योप꣫यति verwischen, dem Auge entziehen MAITR. S. 1,2,7 (16,11). MĀN. ŚR. 3,4. Vgl. Caus. von 1. लुप्, लुप् mit मम्, लुभ् und लुभ् mit सम्.\n— Intens. योयुप्य꣫ते glatt streichen, schlichten ĀPAST. ŚR. 2,3,9.\n— Mit आ, आयुपिता योनिः ĀPAST. ŚR. 1,4,11. Druckfehler für अयुपिता योनिः; vgl. MAITR. S. 1,1,2.\n— Caus. turbare.\nMit सम् Caus. verwischen, glatter.", "gloss_language": "de"}]}], "yupa": [{"id": "yUpa", "headword": "यूप", "headword_slp1": "yUpa", "fold": "yupa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "यू꣫प m.\n— 1〉 Pfosten, Balken, Säule; insbes. der Pfosten, an welchen das Opferthier gebunden wird. Nom. abstr. यूपत्व꣫ n. TS. 6,3,4,7.\n— 2〉 eine best. Constellation von der Gattung Ākṛtiyoga, wenn nämlich alle Planeten in den Häusern 1,2,3 und 4 stehen.", "gloss_language": "de"}], "synonyms": ["यूपः"], "synonyms_slp1": ["yUpaH"]}], "yupaka": [{"id": "yUpaka", "headword": "यूपक", "headword_slp1": "yUpaka", "fold": "yupaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. = यूप꣫ 1〉 NYĀYAM. 3,1,16 (metrisch). Insbes. am Ende eines adj. Comp.\n— 2〉 *n. ein best. Holz RĀJAN. 9,27.", "gloss_language": "de"}]}], "yupakawaka": [{"id": "yUpakawaka", "headword": "यूपकटक", "headword_slp1": "yUpakawaka", "fold": "yupakawaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*यूपकटक m. als Erklärung von चषाल.", "gloss_language": "de"}]