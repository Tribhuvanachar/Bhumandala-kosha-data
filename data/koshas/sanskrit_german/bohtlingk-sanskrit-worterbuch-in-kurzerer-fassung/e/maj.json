{"maj": [{"id": "maj", "headword": "मज्", "headword_slp1": "maj", "fold": "maj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*˚मज् Adj. untertauchend in.", "gloss_language": "de"}]}, {"id": "majj", "headword": "मज्ज्", "headword_slp1": "majj", "fold": "maj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√मज्ज् म꣫ज्जति (ausnahmsweise auch Med.)\n— 1〉 untersinken, versinken.\n— 2〉 untergehen, zu Grunde gehen, zur Hölle fahren.\n— 3〉 untertauchen, inʼs Wasser (Loc.) gehen, — sich stürzen, sich baden, sich hineinbegeben in (Loc.)\n— 4〉 मग्न\n — a〉 untergesunken, versunken, — in (Loc. oder im Comp. vorangehend).\n — b〉 untergegangen (Mond), inʼs Unglück gerathen.\n — c〉 untergetaucht, inʼs Wasser gegangen.\n — d〉 eingedrungen —, hineingeschlüpft in (im Comp. vorangehend).\n — e〉 eingefallen, eingedrückt.\n— Caus. मज्ज꣫यति\n— 1〉 untertauchen, eintauchen, versenken, ersäufen.\n— 2〉 überschwemmen.\n— 3〉 infigere, hineinschlagen —, — drängen in (Loc.)\n— 4〉 untergehen lassen, zu Grunde richten.\n— Desid. in मिमङ्क्षा fg.\n— Mit अव unterʼs Wasser drücken Comm. zu ĀPAST. ŚR. 8,8,15. []\n— Mit आ, आमग्न ganz versunken (KĀD. 2,74,21) in (im Comp. vorangehend).\n— Mit उद्\n— 1〉 auftauchen, emportauchen. उन्मग्न aufgetaucht.\n— 2〉 untertauchen.\n— Caus. auftauchen lassen, oben tragen.\n— Mit समुद् untertauchen.\n— Mit उप\n— 1〉 versinken.\n— 2〉 untertauchen ĀPAST. 2,15,10.\n— Mit नि\n— 1〉 versinken, untersinken.\n— 2〉 untertauchen, sich inʼs Wasser (Loc.) stürzen, unter dem Wasser bleiben.\n— 3〉 eindringen, — in (Loc.).\n— 4〉 verschwinden, nicht mehr zu sehen sein.\n— 5〉 versenken, zu Fall bringen.\n— 6〉 निमग्न untergesunken, versunken, — in (Loc. oder im Comp. vorangehend), inʼs Wasser gefallen.\n — b〉 untergegangen (Sonne).\n — c〉 untergetaucht.\n — d〉 eingedrungen, infixus.\n — e〉 eingegangen. परलोकाय in die Welt.\n — f〉 eingesunken, vertieft.\n— Caus.\n— 1〉 inʼs Wasser werfen, ersäufen.\n— 2〉 untertauchen, inʼs Wasser gehen lassen.\n— 3〉 in die Schlacht (Loc.) tauchen, so v. a. inʼs Treffen führen.\n— Mit उपनि daneben untertauchen.\n— Mit विनि, ˚मग्न untergetaucht, gebadet in (Loc.).\nMit संनि untersinken, versinken.\n— Mit निस्\n— 1〉 versinken. निर्मग्न versunken; vom Auge so v. a. ganz gerichtet auf (im Comp. vorangehend).\n— 2〉 überschwemmen.\n— Mit प्र tauchen —, sich stürzen in (Acc.)\n— Mit वि untertauchen, so v. a. sich hineinbegeben in (Loc.).\n— Caus. inʼs Treffen (Loc.) führen. v. l. नि.\n— Mit सम्, संमग्न versunken in (im Comp. vorangehend).", "gloss_language": "de"}]}], "majamudara": [{"id": "majamudAra", "headword": "मजमुदार", "headword_slp1": "majamudAra", "fold": "majamudara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मजमुदार m. Aufseher über die Urkunden.", "gloss_language": "de"}]}], "majiraka": [{"id": "majiraka", "headword": "मजिरक", "headword_slp1": "majiraka", "fold": "majiraka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*मजिरक m. N. pr. eines Mannes.", "gloss_language": "de"}]}, {"id": "mAjiraka", "headword": "माजिरक", "headword_slp1": "mAjiraka", "fold": "majiraka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*माजिरक m. Patron. von मजिरक.", "gloss_language": "de"}]}], "maja": [{"id": "majja", "headword": "मज्ज", "headword_slp1": "majja", "fold": "maja", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "˚मज्ज Adj. untertauchend in उदमज्ज.", "gloss_language": "de"}]}, {"id": "majjA", "headword": "मज्जा", "headword_slp1": "majjA", "fold": "maja", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "मज्जा꣫ f. Mark.", "gloss_language": "de"}]}], "majaka": [{"id": "maj