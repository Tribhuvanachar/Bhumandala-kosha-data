{"kab": [{"id": "kab", "headword": "कब्", "headword_slp1": "kab", "fold": "kab", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*√कब्, कबते (वर्णे). Vgl. कव्.", "gloss_language": "de"}]}], "kabanDa": [{"id": "kabanDa", "headword": "कबन्ध", "headword_slp1": "kabanDa", "fold": "kabanDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "क꣫बन्ध s. क꣫वन्ध.", "gloss_language": "de"}, {"gloss": "क꣫वन्ध (ṚV.), क꣫बन्ध (AV. u. später die Bomb. Ausgg.) []\n— 1〉 m. n. Tonne; bildlich von der Wolke und vom Bauch. Im Epos von der Wolke (auch personif.), die die Sonne beim Auf- und Untergange verhüllen.\n— 2〉 m. n. Rumpf. Am Ende eines adj. Comp. f. आ.\n— 3〉 m. Bein.\n — a〉 des Dämons Danu, dem Indra Kopf und Schenkel in den Leib drückte und dessen lange Arme Rāma und Lakṣmaṇa abhieben.\n — b〉 *Rāhuʼs.\n— 4〉 m. Bez. von 96 best. Ketu.\n— 5〉 m. N. pr. eines Ātharvaṇa und Gandharva. कब꣫न्ध ŚAT. BR. 14.\n— 6〉 *n. Wasser.", "gloss_language": "de"}], "synonyms": ["कबंध", "कबंधं", "कबंधः", "कबन्धं", "कबन्धः"], "synonyms_slp1": ["kabaMDa", "kabaMDaM", "kabaMDaH", "kabanDaM", "kabanDaH"]}, {"id": "kAbanDa", "headword": "काबन्ध", "headword_slp1": "kAbanDa", "fold": "kabanDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "काबन्ध s. कावन्ध.", "gloss_language": "de"}]}], "kabara": [{"id": "kabara", "headword": "कबर", "headword_slp1": "kabara", "fold": "kabara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. आ) gesprenkelt, bunt.\n— 2〉 m. f. (ई) Haarflechte 166,17. Spr. 7809.\n— 3〉 *m. der Etwas hersagt.\n— 4〉 *f. आ und ई Ocimum gratissimum.\n— 5〉 f. ई\n — a〉 *Acacia arabica und *rother Oleander NIGH. PR.\n — b〉 ein Frauenname Ind. St. 14,112.\n— 6〉 *n.\n — a〉 Salz.\n — b〉 Säure.\n — c〉 eine Art Sandelholz GAL.", "gloss_langu