 [{"gloss": "सु꣫ग्रथित Adj. gut geflochten, — geknüpft.", "gloss_language": "de"}]}], "sugranTi": [{"id": "sugranTi", "headword": "सुग्रन्थि", "headword_slp1": "sugranTi", "fold": "sugranTi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*सुग्रन्थि\n— 1〉 m. ein best. Parfum, = चोरक\n— 2〉 n. die Wurzel des langen Pfeffers.", "gloss_language": "de"}], "synonyms": ["सुग्रन्थिः"], "synonyms_slp1": ["sugranTiH"]}], "sugraha": [{"id": "sugraha", "headword": "सुग्रह", "headword_slp1": "sugraha", "fold": "sugraha", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सुग्रह Adj.\n— 1〉 einen guten Griff (Griffstelle) habend.\n— 2〉 leicht zu erlangen, — haben.\n— 3〉 leicht zu verstehen, — einzusehen.", "gloss_language": "de"}]}], "sugrahaRa": [{"id": "sugrahaRa", "headword": "सुग्रहण", "headword_slp1": "sugrahaRa", "fold": "sugrahaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सुग्रहण n. ehrfurchtsvolles Anfassen (der Füsse).", "gloss_language": "de"}]}], "sugrama": [{"id": "sugrAma", "headword": "सुग्राम", "headword_slp1": "sugrAma", "fold": "sugrama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "सुग्राम m. N. pr. eines Dorfes in Magadha HEM. PAR. 1,287.", "gloss_language": "de"}]}], "sugriva": [{"id": "sugrIva", "headword": "सुग्रीव", "headword_slp1": "sugrIva", "fold": "sugriva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 m. (adj. Comp. f. आ)\n — a〉 N. pr.\n — α〉 eines Rosses des Kṛṣṇa.\n — β〉 eines Affen, Bruders des Vālin und Sohnes des Sonnengottes.\n — γ〉 eines göttlichen Wesens.\n — δ〉 *des Vaters des 9ten Arhantʼs der gegenwärtigen Avasarpiṇī.\n — b〉 *Bein. Śivaʼs und Indraʼs.\n — c〉 eine Art Pavillon VĀSTUV. 832.\n — d〉 *a goose, a hero