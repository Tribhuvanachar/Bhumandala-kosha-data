{"aYj": [{"id": "aYj", "headword": "अञ्ज्", "headword_slp1": "aYj", "fold": "aYj", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√अञ्ज् अन꣫क्ति und अङ्क्ते꣫\n— 1〉 salben, bestreichen, beschmieren; Med. sich salben, sich Salbe überstreichen 13,16. 237,18. घृताक्त 192,1. रुधिराक्त 191,22.\n— 2〉 schmücken, ausrüsten; Med. sich schmücken.\n— 3〉 verherrlichen, ehren.\n— 4〉 an den Tag legen.\n— Caus. bestreichen.\n— Mit अनु bestreichen 30,32.\n— Mit अन्तर् in sich aufnehmen.\n— Mit अभि\n— 1〉 salben, bestreichen; Med. sich salben, sich bestreichen 237,18. तैललवणाभ्यक्त 218,4.\n— 2〉 schmücken.\n— Mit आ\n— 1〉 salben.\n— 2〉 glätten, ebnen.\n— 3〉 verherrlichen, ehren.\n— Mit समा gemeinsam salben KAUŚ. 79.\n— Mit उद् (अनक्ति) in die Höhe heben ṚV. 4,6,3. Gehört der Bed. nach zu अच्\n— Mit उप einschmieren.\n— Mit नि\n— 1〉 einsalben.\n— 2〉 Med. hineinschlüpfen in (अन्तर्) न्य॑क्त in einem Andern enthalten, [] inhärirend.\n— Mit प्रति\n— 1〉 bestreichen.\n— 2〉 schmücken.\n— Mit वि\n— 1〉 Med. durchsalben.\n— 2〉 Med. Sich salben, — herausputzen; sich ein Ansehen verschaffen.\n— 3〉 offenbaren, an den Tag legen Spr. 7820. व्यक्त (s. auch bes.) offenbar, sinnlich wahrnehmbar, verständlich. व्यक्तम् Adv. offenbar, deutlich; sicher, gewiss 38,23. 180,2. 319,26. 326,7.\n— Caus. offenbaren, an den Tag legen, klar machen 190,18. Ind. St. 9,20.\n— Mit अनुवि deutlich —, klar werden (!) Comm. zu AV. PRĀT. 4,107.\n— Mit अभिवि Pass. an den Tag treten, erscheinen 267,30. अभिव्यक्त offenbar, deutlich hervortretend. ˚म् Adv. offenbar.\n— Mit सम्\n— 1〉 besalben, schmücken 37,20. 21.\n— 2〉 zubereiten, ausrüsten, ausstatten.\n— 3〉 verherrlichen.\n— 4〉 zusammenfügen, vereinigen.\n— 5〉 belecken, verzehren; Med. sich nähren mit (Instr.), geniessen.", "gloss_language": "de"}, {"gloss": "√अञ्ज् mit परिवि, परिव्यक्तम् Adv. überaus deutlich [] HARIV. 4514.", "gloss_language": "de"}, {"gloss": "√अञ्ज् mit प्रवि, प्रव्यक्त deutlich. Compar. ˚तर SUŚR. 1,258,20.", "gloss_language": "de"}, {"gloss": "√अञ्ज् mit परिवि 3.\n— Mit प्रवि 4.", "gloss_language": "de"}], "synonyms": ["अंज्"], "synonyms_slp1": ["aMj"]}], "aYjaka": [{"id": "aYjaka", "headword": "अञ्जक", "headword_slp1": "aYjaka", "fold": "aYjaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "अञ्जक m. N. pr. eines Sohnes des Vipracitti VP. 1,21,11.", "gloss_language": "de"}], "synonyms": ["अञ्जकः"], "synonyms_slp1": ["aYjakaH"]}], "aYjana": [{"id": "aYjana", "headword": "अञ्जन", "headword_slp1": "aYjana", "fold": "aYjana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 n.\n — a〉 das Salben, Bestreichen, Beschmieren.\n — b〉 das Offenbaren, Klarmachen, insbes. der Bedeutung eines mehrdeutigen Wortes KĀVYAPR. 2,19.\n — c〉 Salbe.\n — d〉 schwarze Augensalbe und die dazu verwandten Stoffe, wie z. B. Antimonium 53,11.\n — e〉 *Dinte.\n — f〉 *Nacht.\n — g〉 *Feuer.\n — h〉 *Bein. Śivaʼs GAL.\n— 2〉 m.\n — a〉 *Hauseidechse.\n — b〉 N. pr.\n — α〉 eines Weltelephanten.\n — β〉 einer mythischen Schlange.\n — γ〉 eines Fürsten von Mithilā VP. 4,5,12.\n — δ〉 eines Berges.\n— 3〉 f. आ\n — a〉 *eine Eidechsenart.\n — b〉 N. pr. einer Frau und einer Aeffin (der Mutter Hanumantʼs).\n— 4〉 f. ई\n — a〉 *eine bossirte weibliche Figur; vgl. अञ्जलिकारिका.\n — b〉 *N. zweier Pflanzen RĀJAN. 4,189. 6,132.\n — c〉 N. pr. der Mutter Hanumantʼs BHĀVAPR. 1,101,3 v. l.", "gloss_language": "de"}, {"gloss": "अञ्जन m. nach dem Comm. = शिग्रु KĀŚĪKH. 1,26. — Zu 1〉f〉 g〉 vgl. ZACH. Beitr.", "gloss_language": "de"}, {"gloss": "अञ्जन I. 5.", "gloss_language": "de"}], "synonyms": ["अंजनः", "अञ्जनं", "अञ्जनः"], "synonyms_slp1": ["aMjanaH", "aYjanaM", "aYjanaH"]}, {"id": "AYjana", "headword": "आञ्जन", "headword_slp1": "AYjana", "fold": "aYjana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. आ꣫ञ्जन\n— 1〉 n.\n — a〉 Salbe, insbes. Augensalbe.\n — b〉 Fett überh.\n— 2〉 f. आञ्जनि eine Schachtel mit Augensalbe.", "gloss_language": "de"}, {"gloss": "2. आञ्जन Adj. die Farbe von Augensalbe habend.", "gloss_language": "de"}], "synonyms": ["आंजन", "आञ्जनः"], "synonyms_slp1": ["AMjana", "AYjanaH"]}], "aYjanaka": [{"id": "aYjanaka", "headword": "अञ्जनक", "headword_slp1": "aYjanaka", "fold": "aYjanaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 *Adj. das Wort अञ्जन enthaltend.\n— 2〉 f. ई eine best. Pflanze.\n— 3〉 f. *अञ्जनिका\n — a〉 eine Eidechsenart.\n — b〉 ein Mausart (fehlerhaft für अञ्जलिका).", "gloss_language": "de"}, {"gloss": "अञ्जनक 4〉 n. = अञ्जन 1〉d〉 GĪT. 12,19.", "gloss_language": "de"}, {"gloss": "अञ्जनक I. 4.", "gloss_language": "de"}, {"gloss": "अञ्जनक, f. ˚निका I. Xanthochymus pictorius DAMAYANTĪK. 157. 185.", "gloss_language": "de"}], "synonyms": ["अंजनकः", "अञ्जनकः"], "synonyms_slp1": ["aMjanakaH", "aYjanakaH"]}], "aYjanakesa": [{"id": "aYjanakeSa", "headword": "अञ्जनकेश", "headword_slp1": "aYjanakeSa", "fold": "aYjanakesa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. (f. ई) eine Mähne so schwarz wie Augensalbe habend.\n— 2〉 *f. ई ein best. vegetabilischer Parfum.", "gloss_language": "de"}]}], "aYjanakosi": [{"id": "aYjanakoSI", "headword": "अञ्जनकोशी", "headword_slp1": "aYjanakoSI", "fold": "aYjanakosi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अञ्जनकोशी (˚केशी ?) f. eine best. Pflanze GAL.", "gloss_language": "de"}]}], "aYjanakesi": [{"id": "aYjanakeSI", "headword": "अञ्जनकेशी", "headword_slp1": "aYjanakeSI", "fold": "aYjanakesi", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*अञ्जनकोशी (˚केशी ?) f. eine best. Pflanze GAL.", "gloss_language": "de"}]}], "aYjanagiri": [{"id": "aY