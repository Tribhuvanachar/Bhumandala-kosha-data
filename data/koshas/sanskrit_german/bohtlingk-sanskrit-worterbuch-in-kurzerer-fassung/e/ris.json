{"ris": [{"id": "riS", "headword": "रिश्", "headword_slp1": "riS", "fold": "ris", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "√रिश्, रिश꣫ति (हिंसायाम्), ˚ते\n— 1〉 rupfen, abreissen; daher abweiden.\n— 2〉 रिष्ट꣫ gezerrt, aus der Lage gebracht, zerrissen, zerbrochen.\n— Mit आ Med. abweiden.\n— Mit वि, वि꣫रिष्ट aus der Lage gezerrt gebrochen (eig. und übertr.) VAITĀN.", "gloss_language": "de"}, {"gloss": "√रिश् mit वि V. विरिष्ट gehört eher zu रिष्.", "gloss_language": "de"}]}, {"id": "riz", "headword": "रिष्", "headword_slp1": "riz", "fold": "ris", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √रिष्, रि꣫ष्यति, रिष्यते (nur intrans.), रिषति, रेषति;\n— 1〉 versehrt werden, Schaden nehmen; versagen, misslingen, zu Schanden werden. रिष्ट꣫ misslungen.\n— 2〉 beschädigen.\n— Caus. रेष꣫यति versehren, Schaden thun, beschädigen, versagen —, fehlen machen. Med. sich Schaden thun; misslingen, zu Schanden werden.\n— Desid. रि꣫रिक्षति beschädigen wollen.\n— Mit अनु (˚रिष्यति) nach Jmd (Acc.) versehrt [] werden, — Schaden nehmen.\nMit अभि misslingen.\n— Mit आ Caus. schädigen.", "gloss_language": "de"}, {"gloss": "2. रि꣫ष् f. Schaden oder Schädiger. रिषे꣫ Dat. Infin.", "gloss_language": "de"}, {"gloss": "√रिष् mit वि, ˚रिष्यति sich verletzen KAUŚ. 59,28. 72,30.", "gloss_language": "de"}]}], "risa": [{"id": "riSA", "headword": "रिशा", "headword_slp1": "riSA", "fold": "risa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "रिशा꣫ f. die Rupfende, Zerrende als Bez. eines best. Thierchens.", "gloss_language": "de"}]}, {"id": "riza", "headword": "रिष", "headword_slp1": "riza", "fold": "risa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "रिष in नघारिष꣫.", "gloss_language": "de"}]}], "risadas": [{"id": "riSAdas", "headword": "रिश