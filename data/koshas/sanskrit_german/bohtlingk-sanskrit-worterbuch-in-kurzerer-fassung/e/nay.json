{"nay": [{"id": "nay", "headword": "नय्", "headword_slp1": "nay", "fold": "nay", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*!√नय्, नयते (गतौ, रक्षणे).", "gloss_language": "de"}]}], "naya": [{"id": "naya", "headword": "नय", "headword_slp1": "naya", "fold": "naya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "नय m.\n— 1〉 Führung (eines Heeres).\n— 2〉 Art und Weise sich zu benehmen, Handlungsweise.\n— 3〉 Sg. und Pl. kluge Aufführung, kluges und angemessenes Benehmen, — gegen (Loc.), Lebensklugheit, Staatsklugheit, Politik. नयेषु auf kluge Weise, नयार्थित auf eine angemessene, höfliche Weise gebeten. []\n— 4〉 Plan.\n— 5〉 leitender Gedanke, Maxime, Grundsatz, Methode, System, Lehre.\n— 6〉 *ein best. Spiel oder *eine Figur in einem solchen Spiele.\n— 7〉 N. pr. eines Sohnes\n — a〉 das Dharma und der Kriyā.\n — b〉 das 13ten Manu.", "gloss_language": "de"}, {"gloss": "नय, über die Bed. des Wortes bei den Jaina s. ZACH. Beitr. Ind. St. 16,351. fg. 17,39. 63.", "gloss_language": "de"}, {"gloss": "नय III. 5.", "gloss_language": "de"}], "synonyms": ["नयः"], "synonyms_slp1": ["nayaH"]}, {"id": "nAya", "headword": "नाय", "headword_slp1": "nAya", "fold": "naya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "नाय꣫ m.\n— 1〉 Führer.\n— 2〉 *Führung, Leitung.\n— 3〉 kluges Benehmen, Staatsklugheit.", "gloss_language": "de"}], "synonyms": ["नायः"], "synonyms_slp1": ["nAyaH"]}], "nayaka": [{"id": "nayaka", "headword": "नयक", "headword_slp1": "nayaka", "fold": "nayaka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*नयक Adj. in der Politik erfahren.", "gloss_language": "de"}], "synonyms": ["नयकः"], "synonyms_slp1": ["nayakaH"]}, {"id": "nAyaka", "headword": "नायक", "headword_slp1": "nAyaka", "fold": "nayaka", "headword_language