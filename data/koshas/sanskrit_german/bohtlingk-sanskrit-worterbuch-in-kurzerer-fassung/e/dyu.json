{"dyu": [{"id": "dyu", "headword": "द्यु", "headword_slp1": "dyu", "fold": "dyu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "3. दि꣫व्, द्यु꣫, दिउ꣫ (Nom. Sg. von द्यो)\n— 1〉 m. f. der Himmel. दिवं गम् oder या zum Himmel gehen; auch so v. a. Sterben.\n— 2〉 m. n. (spät) Tag. [] अ꣫नु द्यू꣫न् Tag für Tag, täglich; अभि꣫ द्यून् im Laufe der Tage, lange Zeit; द्युभि; und उ꣫प द्यु꣫भि; bei Tage und im Laufe der Tage, lange Zeit. Nach den Lexicographen. Nom. द्युस्.\n— 3〉 m.\n — a〉 Helle, Glanz. Nur Instr. Pl. द्यु꣫भिस्.\n — b〉 Feuersglut. Nur Instr. Pl. द्यु꣫भिस्. Nach den Lexicographen Feuer (Nom.) द्युस्\n— 4〉 f. als Personification eine Tochter Prajāpatiʼs.", "gloss_language": "de"}, {"gloss": "1. √द्यु, द्यौति losfahren auf, angreifen BHAṬṬ.\n— Mit प्र, ˚द्यौति als Umschreibung von इयस्पते SĀY. zu ŚAT. BR. 2,2,3,10.", "gloss_language": "de"}, {"gloss": "2. द्यु꣫\n— 1〉 m. (*n.) Himmel. Zu belegen nur द्यो꣫स्, द्युवि, द्यू꣫न् und द्यु꣫भिस्; die beiden ersten Formen könnten auch zu द्यो꣫ gehören.\n— 2〉 m. n. Tag. Zu belegen dieselben Formen wie bei 1〉 und द्यूनि.\n— 3〉 m.\n — a〉 Helle, heller Schein, Glanz, Feuersglut. Zu belegen nur द्यु꣫भिस्.\n — b〉 N. pr. eines Vasu. Zu belegen nur द्यवे MBH. 1,99,15.", "gloss_language": "de"}], "synonyms": ["द्युः"], "synonyms_slp1": ["dyuH"]}, {"id": "dyU", "headword": "द्यू", "headword_slp1": "dyU", "fold": "dyu", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्यू꣫\n— 1〉 Adj. am Ende eines Comp. spielend.\n— 2〉 f. Würfelspiel. Nur द्यु꣫वम् AV. 7,50,9 und द्युवे꣫ 109,5.", "gloss_language": "de"}]}], "dyuka": [{"id": "dyuka", "headword": "द्युक", "headword_slp1": "dyuka", "fold": "dyuka", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*द्युक m. Eule und *द्युकारि m. Krähe fehlerhaft für घूक und घूकारि.", "gloss_language": "de"}], "synonyms": ["द्युकः"], "synonyms_slp1": ["dyukaH"]}], "dyukarRarDa": [{"id": "dyukarRArDa", "headword": "द्युकर्णार्ध", "headword_slp1": "dyukarRArDa", "fold": "dyukarRarDa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युकर्णार्ध m. = अहव्र्यास.", "gloss_language": "de"}]}], "dyukama": [{"id": "dyukAma", "headword": "द्युकाम", "headword_slp1": "dyukAma", "fold": "dyukama", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*द्युकाम m. N. pr. eines Mannes; s. द्यौकामि.", "gloss_language": "de"}]}], "dyuksa": [{"id": "dyukza", "headword": "द्युक्ष", "headword_slp1": "dyukza", "fold": "dyuksa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युक्ष꣫ Adj. (f. आ꣫) himmlisch, licht, glänzend.", "gloss_language": "de"}], "synonyms": ["द्युक्षः"], "synonyms_slp1": ["dyukzaH"]}], "dyuksavacas": [{"id": "dyukzavacas", "headword": "द्युक्षवचस्", "headword_slp1": "dyukzavacas", "fold": "dyuksavacas", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युक्ष꣫वचस् Adj. himmlische Worte redend.", "gloss_language": "de"}]}], "dyuga": [{"id": "dyuga", "headword": "द्युग", "headword_slp1": "dyuga", "fold": "dyuga", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*द्युग m. Vogel.", "gloss_language": "de"}], "synonyms": ["द्युगः"], "synonyms_slp1": ["dyugaH"]}], "dyugaRa": [{"id": "dyugaRa", "headword": "द्युगण", "headword_slp1": "dyugaRa", "fold": "dyugaRa", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युगण m. = अहर्गण 2〉.", "gloss_language": "de"}], "synonyms": ["द्युगणः"], "synonyms_slp1": ["dyugaRaH"]}], "dyugat": [{"id": "dyugat", "headword": "द्युगत्", "headword_slp1": "dyugat", "fold": "dyugat", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युग꣫त् Adv. durch den Himmel hin, — her.", "gloss_language": "de"}]}], "dyucara": [{"id": "dyucara", "headword": "द्युचर", "headword_slp1": "dyucara", "fold": "dyucara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj. im Himmel —, am Himmel —, im Luftraum wandelnd, — sich bewegend.\n— 2〉 m.\n — a〉 Himmelsbewohner.\n — b〉 ein Vidyādhara.\n — c〉 ein Planet GOLĀDHY. 5,26.", "gloss_language": "de"}], "synonyms": ["द्युचरः"], "synonyms_slp1": ["dyucaraH"]}], "dyucari": [{"id": "dyucarI", "headword": "द्युचरी", "headword_slp1": "dyucarI", "fold": "dyucari", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युचरी Adj. mit भू zu einem Vidyādhara werden.", "gloss_language": "de"}]}], "dyucarin": [{"id": "dyucArin", "headword": "द्युचारिन्", "headword_slp1": "dyucArin", "fold": "dyucarin", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युचारिन् m. ein Vidyādhara.", "gloss_language": "de"}]}], "dyujaya": [{"id": "dyujaya", "headword": "द्युजय", "headword_slp1": "dyujaya", "fold": "dyujaya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युजय m. Ersiegung —, Gewinnung des Himmels.", "gloss_language": "de"}], "synonyms": ["द्युजयः"], "synonyms_slp1": ["dyujayaH"]}], "dyujiva": [{"id": "dyujIvA", "headword": "द्युजीवा", "headword_slp1": "dyujIvA", "fold": "dyujiva", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युजीवा (GOLĀDHY. 6,27. 8,61. 65) und द्युज्या f. = अहर्व्यास.", "gloss_language": "de"}]}], "dyujya": [{"id": "dyujyA", "headword": "द्युज्या", "headword_slp1": "dyujyA", "fold": "dyujya", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युजीवा (GOLĀDHY. 6,27. 8,61. 65) und द्युज्या f. = अहर्व्यास.", "gloss_language": "de"}]}], "dyut": [{"id": "dyut", "headword": "द्युत्", "headword_slp1": "dyut", "fold": "dyut", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "1. √द्युत्, द्यो꣫तते (episch auch Act.) Partic. द्यो꣫तमान, द्युतान꣫ द्यु꣫तान, द्योतन्त् und द्युतन्त्; blinken, leuchten, glänzen.\n— Caus. द्योतयति (Med. BHAṬṬ.)\n— 1〉 [] erleuchten, in Glanz versetzen MBH. 1,173,30. द्योतित erleuchtet, leuchtend, glänzend.\n— 2〉 vor Augen bringen, hervortreten lassen, hervorheben, zu verstehen geben.\n— *Desid. दिद्युतिषते und दिद्योतिषते.\n— Intens. द꣫विद्युतति (3te Pl.), दुविद्योत्, द꣫विद्युतत् und *देद्युत्यते; hell strahlen, blinken, blitzen.\n— Mit अभि sein Licht —, seinen Glanz richten auf (Acc.).\n— Caus. beleuchten, erleuchten, in Glanz versetzen.\n— Mit अव Caus. vor Augen bringen, erinnern an (Acc.).\n— Mit आ herleuchten VAITĀN.\n— Mit उद् aufleuchten, erglänzen.\n— Caus. aufleuchten —, erglänzen lassen.\n— Intens. stark aufleuchten.\n— Mit समुद् aufleuchten.\n— Mit निस् Caus. klar machen.\n— Mit प्र zu leuchten, — zu glänzen beginnen.\n— Caus. erleuchten, in hellen Glanz versetzen.\n— Mit संप्र Caus. dass. HEMĀDRI 1,490,8.\n— Mit वि\n— 1〉 blitzen, blinken, glänzen, erglänzen, so v. a. aufgehen (von der Sonne). वि꣫द्योतते es blitzt, विद्यो꣫तमाने wenn es blitzt.\n— 2〉 wegblitzen, so v. a. blitzend wegschleudern.\n— 3〉 erleuchten.\n— Caus. erleuchten, in Glanz versetzen. Vgl. द्युतय्.\n— Intens. blinken.\n— Mit संवि zugleich blitzen TS. 7,5,11,1.\n— Mit सम् zugleich —, in die Wette mit Jmd (Instr.) blinken.", "gloss_language": "de"}, {"gloss": "2. द्यु꣫त् f. das Blinken, Glanz. Vgl. दन्तद्युत्.", "gloss_language": "de"}, {"gloss": "3. √द्युत्, द्युत्त꣫ gebrochen, zerbrochen.\n— Caus. द्योत꣫यति erbrechen.\n— Caus. द्वोत꣫यति erbrechen.\n— Mit व्यभि (द्यौत्) erbrechen ṚV. 4,4,6.\n— Mit आ (दिद्यो꣫त्) anbrüchig werden.", "gloss_language": "de"}, {"gloss": "4. ˚द्युत् Adj. losgehend auf, angreifend BHAṬṬ.", "gloss_language": "de"}, {"gloss": "1. √द्युत् mit अभि Caus. III. *Med. beleuchten, verdeutlichen MAHĀVY. 109.\n— Mit अव Caus. III. beleuchten ĀPAST. GṚHY. 1,22. अवद्युत्य schlechte Lesart.", "gloss_language": "de"}, {"gloss": "2. √द्युत् III. Strahl DHARMAŚARM. 1,16. 12,40.", "gloss_language": "de"}]}], "dyuta": [{"id": "dyuta", "headword": "द्युत", "headword_slp1": "dyuta", "fold": "dyuta", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युत n. δυτον, das 7te astrologische Haus.", "gloss_language": "de"}]}, {"id": "dyUta", "headword": "द्यूत", "headword_slp1": "dyUta", "fold": "dyuta", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्यूत꣫ (*m.) n.\n— 1〉 Würfelspiel, Glücksspiel überh. häufig uneig. vom Kampfe, dessen Ausgang wie beim Würfelspiel ungewiss ist. Das Worum m. Loc. oder im Comp. vorangehend.\n— 2〉 Kampfpreis.", "gloss_language": "de"}], "synonyms": ["द्यूतं", "द्यूतः"], "synonyms_slp1": ["dyUtaM", "dyUtaH"]}], "dyutadyaman": [{"id": "dyutadyAman", "headword": "द्युतद्यामन्", "headword_slp1": "dyutadyAman", "fold": "dyutadyaman", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युत꣫द्यामन् Adj. dessen Bahn blinkt, — glänzt.", "gloss_language": "de"}]}], "dyutay": [{"id": "dyutay", "headword": "द्युतय्", "headword_slp1": "dyutay", "fold": "dyutay", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "!√द्युतय्, ˚यति mit वि blinken, blitzen ṚV. 2,34,2.", "gloss_language": "de"}]}], "dyutaru": [{"id": "dyutaru", "headword": "द्युतरु", "headword_slp1": "dyutaru", "fold": "dyutaru", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युतरु m. der Himmelsbaum, der Pārijāta.", "gloss_language": "de"}]}], "dyutana": [{"id": "dyutAna", "headword": "द्युतान", "headword_slp1": "dyutAna", "fold": "dyutana", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युतान꣫\n— 1〉 Adj. s. u. 1. द्युत्.\n— 2〉 m.\n — a〉 N. pr. eines Ṛṣi.\n — b〉 eine best. diesem Ṛṣi zugeschriebene Litanei.", "gloss_language": "de"}]}], "dyuti": [{"id": "dyuti", "headword": "द्युति", "headword_slp1": "dyuti", "fold": "dyuti", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 f.\n — a〉 Glanz, Pracht, Schönheit 297,3. 300,28.\n — b〉 Würde, Majestät.\n — c〉 in der Dramatik eine drohende Haltung.\n — d〉 als Göttin personificirt.\n— 2〉 m. N. pr.\n — a〉 eines Ṛṣi unter Manu Merusāvarṇa.\n — b〉 eines Sohnes des Manu Tāmasa.", "gloss_language": "de"}], "synonyms": ["द्युतिः"], "synonyms_slp1": ["dyutiH"]}], "dyutikara": [{"id": "dyutikara", "headword": "द्युतिकर", "headword_slp1": "dyutikara", "fold": "dyutikara", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "*द्युतिकर m. der Polarstern.", "gloss_language": "de"}], "synonyms": ["द्युतिकरः"], "synonyms_slp1": ["dyutikaraH"]}], "dyutimati": [{"id": "dyutimati", "headword": "द्युतिमति", "headword_slp1": "dyutimati", "fold": "dyutimati", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "द्युतिमति Adj. von glänzendem Verstande.", "gloss_language": "de"}]}], "dyutimant": [{"id": "dyutimant", "headword": "द्युतिमन्त्", "headword_slp1": "dyutimant", "fold": "dyutimant", "headword_language": "sa", "source": "bohtlingk-sanskrit-worterbuch-in-kurzerer-fassung", "senses": [{"gloss": "— 1〉 Adj.\n — a〉 glänzend, prächtig, herrlich.\n — b〉 würdevoll, imponirend.\n— 2〉 m. N. pr.\n — a〉 verschiedener Männer.\n — b〉 eines Berges.\n— 3〉 f.