{"sawkarmas": [{"id": "zawkarmas", "headword": "षट्कर्मस्", "headword_slp1": "zawkarmas", "fold": "sawkarmas", "headword_language": "sa", "source": "rkmath-encyclopedia-of-hinduism", "senses": [{"gloss": "ṣaṭkarmas\n(‘six purificatory exercises [for the body]’)\n------------------------------------------\nWorks on हठयोग lay great stress on cleansing and strengthening the physical body so that it becomes fit enough for the practice of राजयोग. For this, they prescribe the षट्कर्मस् or six purificatory processes.\nThey are: धौति (washing); बस्ति (cleansing the lower part of the abdomen); नेति (cleaning the nostrils); लौकिकी (movement of stomach-muscles); त्राटक (gazing without winking); कपालभाति (cleansing the inside of cranium).\nSee under each title for details.", "gloss_language": "en"}], "synonyms": ["ShaTkarmas", "ஷட்கர்மஸ்", "షట్కర్మస్", "ṣaṭkarmas"], "synonyms_slp1": ["ShaTkarmas", "ஷட்கர்மஸ்", "షట్కర్మస్", "ṣaṭkarmas"]}], "sawcakraBeda": [{"id": "zawcakraBeda", "headword": "षट्चक्रभेद", "headword_slp1": "zawcakraBeda", "fold": "sawcakraBeda", "headword_language": "sa", "source": "rkmath-encyclopedia-of-hinduism", "senses": [{"gloss": "ṣaṭcakrabheda\n(‘piercing of the six चक्रस् [by the कुण्डलिनी]’)\n------------------------------------------\nSee CAKRAS.", "gloss_language": "en"}], "synonyms": ["ShaTchakrabheda", "ஷட்சக்ரபேத", "షట్చక్రభేద", "ṣaṭcakrabheda"], "synonyms_slp1": ["ShaTchakrabheda", "ஷட்சக்ரபேத", "షట్చక్రభేద", "ṣaṭcakrabheda"]}], "sawsTalasidDanta": [{"id": "zawsTalasidDAnta", "headword": "षट्स्थलसिद्धान्त", "headword_slp1": "zawsTalasidDAnta", "fold": "sawsTalasidDanta", "headword_language": "sa", "source": "rkmath-encyclopedia-of-hinduism", "senses": [{"gloss": "Ṣaṭsthalasiddhānta\n------------------------------------------\nSee under ŚAIVISM.", "gloss_language": "en"}], "synonyms": ["ShaTsthalasiddhAnta", "ஷட்ஸ்தலஸித்தாந்த", "షట్స్థలసిద్ధాన్త", "ṣaṭsthalasiddhānta"], "synonyms_slp1": ["ShaTsthalasiddhAnta", "ஷட்ஸ்தலஸித்தாந்த", "షట్స్థలసిద్ధాన్త",