{"dinakara": [{"id": "dinakara", "headword": "दिनकर", "headword_slp1": "dinakara", "fold": "dinakara", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकर See Divākara.", "gloss_language": "en"}, {"gloss": "दिनकर (?) father of Divākara (Dānadinakara).", "gloss_language": "en"}, {"gloss": "दिनकर son of Nṛsiṃha. See Divākara.", "gloss_language": "en"}, {"gloss": "दिनकर son of Bālakṛṣṇa. See Mahādeva Bhaṭṭa Dinakara.", "gloss_language": "en"}, {"gloss": "दिनकर (?):\n Prabodhasudhākara, vedānta. B. 4, 70.", "gloss_language": "en"}, {"gloss": "Bhavānandīṭīkā.\n Pratyakṣānumāna. Oppert II, 5948.\n Maṅgalavāda. Hall p. 41.", "gloss_language": "en"}, {"gloss": "Māsapraveśasāraṇī jy. Bhk. 37.", "gloss_language": "en"}, {"gloss": "दिवाकर or दिनकर son of Nṛsiṃha, grandson of Kṛṣṇa\nDaivajña:\n Gaṇitatattva, Gaṇitatattvacintāmaṇi, Tattvacintā-\nmaṇi jy.\n Janmapaddhati or Jātakapaddhati.\n Jātakapaddhatiprakāśa.\n Padmajātaka.\n Prauḍhamanoramā Keśavapaddhatiṭīkā.\n Makarandavivaraṇa.\n Varṣagaṇitapaddhati Rathoddhatā.\n Varṣatantra.\n Varṣaphalapaddhati.\n Śrīpatiprakāśa.\n Divākarī. Oudh VIII, 14. C. Mañjubhāṣiṇī.\nOudh VII, 4.", "gloss_language": "en"}, {"gloss": "दिनकर Pratyakṣānumāna. This is a dvandva.", "gloss_language": "en"}, {"gloss": "Rasataraṅgiṇīṭīkā.", "gloss_language": "en"}, {"gloss": "दिवाकर or दिनकर son of Nṛsiṃha, grandson of Kṛṣṇa\nDaivajña, great grandson of Divākara, nephew of Śiva:\n Gaṇitāmṛtasāraṇī.\n Gopālapaddhati (?).\n Gopirājamatakhaṇḍana jy., composed in 1627.\n Jātakapaddhatyudāharaṇa.\n Makarandavivaraṇa and udāharaṇa.\n Rāmavinodaprakāśapaddhati jy.", "gloss_language": "en"}], "synonyms": ["दिनकरः"], "synonyms_slp1": ["dinakaraH"]}], "dinakaraBawa": [{"id": "dinakaraBawwa", "headword": "दिनकरभट्ट", "headword_slp1": "dinakaraBawwa", "fold": "dinakaraBawa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकर भट्ट of the Moḍha family, from Bārejya:\n Kheṭasiddhi jy. composed in 1579.\n Candrārkī.", "gloss_language": "en"}, {"gloss": "दिनकर भट्ट son of Rāmakṛṣṇa Bhaṭṭa, son of Nārā-\nyaṇa Bhaṭṭa, son of Rāmeśvara Bhaṭṭa, brother of\nKamalākara Bhaṭṭa, father of Viśveśvara Bhaṭṭa:\n Ṛgarthasāra and C..\n Karmavipākasāra.\n Dinakaroddyota, written at the instance of Śiva,\n a Chattrapati prince.\n Bhāṭṭadinakara, a C. on the Śāstradīpikā.\n Śāntisāra.\n[]", "gloss_language": "en"}, {"gloss": "दिनकर भट्ट, son of Padmākara Bhaṭṭa:\n Tarkakaumudī Tarkabhāṣāṭīkā.", "gloss_language": "en"}]}], "dinakaramisra": [{"id": "dinakaramiSra", "headword": "दिनकरमिश्र", "headword_slp1": "dinakaramiSra", "fold": "dinakaramisra", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकर मिश्र son of Dharmāṅgada, composed in 1385:\n Subodhinī Raghuvaṃśaṭīkā.\n Śiśupālavadhaṭīkā.", "gloss_language": "en"}]}], "dinakaradeva": [{"id": "dinakaradeva", "headword": "दिनकरदेव", "headword_slp1": "dinakaradeva", "fold": "dinakaradeva", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकरदेव poet. Śp. p. 35.", "gloss_language": "en"}]}], "dinakari": [{"id": "dinakarI", "headword": "दिनकरी", "headword_slp1": "dinakarI", "fold": "dinakari", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकरी See Nyāyasiddhāntamuktāvalīprakāśa.", "gloss_language": "en"}]}], "dinakarikroqapatraRi": [{"id": "dinakarIkroqapattrARi", "headword": "दिनकरीक्रोडपत्त्राणि", "headword_slp1": "dinakarIkroqapattrARi", "fold": "dinakarikroqapatraRi", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकरीक्रोडपत्त्राणि Rādh 2.", "gloss_language": "en"}]}], "dinakariKaRqana": [{"id": "dinakarIKaRqana", "headword": "दिनकरीखण्डन", "headword_slp1": "dinakarIKaRqana", "fold": "dinakariKaRqana", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "दिनकरीखण्डन by Gaṅgārā