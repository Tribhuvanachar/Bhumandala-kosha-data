tyarthasāgara (Oxf. 258^b).\nHe died in 1268:\n C. on Ānandatīrtha's Īśāvāsyopaniṣadbhāṣya.\n C. on Ānandatīrtha's Ṛgvedabhāṣya.\n C. on Ānandatīrtha's Kathālakṣaṇa.\n C. on Ānandatīrtha's Karmanirṇaya.\n Granthamālikāstotra. Burnell 107^b.\n Tattvaprakāśikāvivaraṇa on Ānandatīrtha's Upādhi-\nkhaṇḍana.\n Tattvaprakāśikā on Ānandatīrtha's Brahmasūtra-\nbhāṣya.\n[]\n Tattvavivaraṇa. Oppert II, 4620. 9817.\n C. on Ānandatīrtha's Tattvaviveka.\n C. on Ānandatīrtha's Tattvasaṃkhyāna.\n C. on Ānandatīrtha's Tattvoddyota.\n Nyāyasudhā on the Brahmasūtrānuvyākhyāna of\nĀnandatīrtha.\n Pañjikā on the Anuvyākhyānanyāyavivaraṇa. Bur-\nnell 102^b.\n Nyāyakalpalatā on Ānandatīrtha's Pramāṇalakṣaṇa.\n Padyamālā. Khn. 56. Rice 94. Burnell 107^b\n(Pūjāpathyamālā).\n C. on Ānandatīrtha's Prapañcamithyātvānumāna-\nkhaṇḍana.\n Pramāṇapaddhati.\n Prameyadīpikā on Ānandatīrtha's Bhagavadgītā-\nbhāṣya.\n Nyāyadīpikā on Ānandatīrtha's Bhagavadgītātā-\ntparyanirṇaya.\n Praśnopaniṣadbhāṣyaṭīkā.\n C. on Ānandatīrtha's Māyāvādakhaṇḍana.\n C. on Ānandatīrtha's Viṣṇutattvanirṇaya.\n Vedāntavādāvali.\n Ṣaṭpañcāśikā. Oppert 3698.", "gloss_language": "en"}, {"gloss": "जयतीर्थ read Oxf. 285^b.", "gloss_language": "en"}, {"gloss": "Vādamālā.", "gloss_language": "en"}]}], "jayatirTavijaya": [{"id": "jayatIrTavijaya", "headword": "जयतीर्थविजय", "headword_slp1": "jayatIrTavijaya", "fold": "jayatirTavijaya", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयतीर्थविजय Rice 230.", "gloss_language": "en"}]}], "jayatuNga": [{"id": "jayatuNga", "headword": "जयतुङ्ग", "headword_slp1": "jayatuNga", "fold": "jayatuNga", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयतुङ्ग a work. Quoted in Nirṇayasindhu.", "gloss_language": "en"}]}], "jayatuNgodaya": [{"id": "jayatuNgodaya", "headword": "जयतुङ्गोदय", "headword_slp1": "jayatuNgodaya", "fold": "jayatuNgodaya", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयतुङ्गोदय^1 a work. Śp. p. 98.\n[1] Correction submitted by on 20170911.", "gloss_language": "en"}]}], "jayadata": [{"id": "jayadatta", "headword": "जयदत्त", "headword_slp1": "jayadatta", "fold": "jayadata", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयदत्त son of Vijayadatta:\n Aśvavaidyaka. Quoted Śp. p. 30.", "gloss_language": "en"}], "synonyms": ["जयदत्तः"], "synonyms_slp1": ["jayadattaH"]}], "jayadevadiksita": [{"id": "jayadevadIkzita", "headword": "जयदेवदीक्षित", "headword_slp1": "jayadevadIkzita", "fold": "jayadevadiksita", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयदेव दीक्षित son of Nṛsiṃha, patron of Balabhadra\nŚukla (Kuṇḍatattvapradīpa 1624).", "gloss_language": "en"}]}], "jayadevapaRqita": [{"id": "jayadevapaRqita", "headword": "जयदेवपण्डित", "headword_slp1": "jayadevapaRqita", "fold": "jayadevapaRqita", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयदेव पण्डित guru of Bhagīratha Megha. Hall p. 66.", "gloss_language": "en"}]}], "jayadeva": [{"id": "jayadeva", "headword": "जयदेव", "headword_slp1": "jayadeva", "fold": "jayadeva", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "जयदेव guru of Rucidatta the philosopher. L. 1545.", "gloss_language": "en"}, {"gloss": "Alaṃkāraśataka. Oppert II, 2763.", "gloss_language": "en"}, {"gloss": "Īṣattantra gr. Quoted by Trilocanadāsa Oxf.\n169^a.", "gloss_language": "en"}, {"gloss": "Gaṅgāṣṭapadī kāvya. Kāvyamālā.", "gloss_language": "en"}, {"gloss": "Chandaḥśāstra. Kh. 87. Quoted by Nami 1, 18.\n20, by Janārdana Oxf. 198^a.", "gloss_language": "en"}, {"gloss": "जयदेव with the surname Pakṣadhara, pupil and nephew\nof Harimiśra:\n Tattvacintāmaṇyāloka, called also Cintāmaṇipra-\nkāśa, Maṇyāloka, Āloka.\n[]\n Dravyapadārtha on a work of Vardhamāna. IO. 109.\n Nyāyapadārthamālā. Sūcīpattra 46.\n Nyāyalīlāvatīviveka. IO. 62. 579.\n Upanayalakṣaṇāloka. NP. II, 18.\n Kārakavāda. Oppert 7892.\n Tṛtīyacakravartilakṣaṇāloka. NP. II, 136.\n Dvitīyasvalakṣaṇāloka. NP. II, 138.\n Pakṣatāpūrvapakṣagranthāloka. NP. II, 20.\n Pakṣatāsiddhāntagranthāloka. NP. II, 58.\n Parāmarśasiddhāntagranthāloka. NP. III, 98.\n Pratijñālakṣaṇāloka. NP. III, 108.\n Prathamapragalbhalakṣaṇāloka. NP. II, 64.\n Prathamasvalakṣaṇāloka. NP. II, 138.\n Viruddhapūrvapakṣagranthāloka. NP. III, 96.\n Viruddhasiddhāntagranthāloka. NP. II, 56.\n Viśeṣaniryuktyāloka. NP. II, 68.\n Vyāptyanugamāloka. NP. II, 70.\n Savyabhicārapūrvapakṣagranthāloka. NP. III, 104.\n Savyabhicārasiddhāntagranthāloka. NP. III, 110.\n Sāmānyābhāvāloka. NP. II, 64.\n Hetulakṣaṇāloka. NP. II, 130.", "gloss_language": "en"}, {"gloss": "Praśnanidhi jy. B. 4, 158.", "gloss_language": "en"}, {"gloss": "Rasāmṛta med. B. 4, 238. NW. 588.", "gloss_language": "en"}, {"gloss": "जयदेव son of Nṛsiṃha:\n Nyāyamañjarīsāra. Ben. 184.", "gloss_language": "en"}, {"gloss": "जयदेव son of Bhojadeva and Rāmādevī:\n Gītagovinda. Verses from it in Śp. p. 30. Skm.\nSbhv. A Jayadevapaṇḍitakavi under a king\nof Utkala is mentioned in a verse of the\nAlaṃkāraśekhara, ch. 5.\n Rāmagītagovinda (?). IO. 2718. Oudh V, 6.", "gloss_language": "en"}, {"gloss": "जयदेव son of Mahādeva and Sumitrā:\n Candrāloka.\n Prasannarāghava.", "gloss_language": "en"}, {"gloss": "जयदेव son of Nṛsiṃha etc. delete this.", "gloss_language": "en"}, {"gloss": "जयदेव father of Vināyaka (Cakroddhārasāra).", "gloss_language": "en"}, {"gloss": "जयदेव with the surname Pakṣadhara, paternal uncle\nof Vāsudeva (Tattvacintāmaṇiṭīkā), guru of Rucidatta\n(Tattvacintāmaṇiṭīkā).\n Dravyapadārtha, a C. on Vardhamāna's Kiraṇā-\nvalīprakāśa.", "gloss_language": "en"}, {"gloss": "Ratimañjarī.", "gloss_language": "en"}], "synonyms": ["जयदेवः"], "synonyms_slp1": ["jayadevaH"]}], "jayadevavagisa": [{"id": "jayadevavAgISa", "headword": "जयदेववागीश", "headword_slp1": "jayadevavAgISa", "fold": "ja