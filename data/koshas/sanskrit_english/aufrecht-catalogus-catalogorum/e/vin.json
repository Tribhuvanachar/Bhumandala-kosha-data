{"vinayakapaRqita": [{"id": "vinAyakapaRqita", "headword": "विनायकपण्डित", "headword_slp1": "vinAyakapaRqita", "fold": "vinayakapaRqita", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "नन्द पण्डित called also विनायक पण्डित son of Rāma\nPaṇḍita (who lived in 1568/69):\n Kāśīprakāśa.\n Tattvamuktāvalī.\n Dattakacandrikā.\n Dattakamīmāṃsā or Putrīkaraṇamīmāṃsā.\n Navarātrapradīpa.\n Parāśarasmṛtiṭīkā Vidvanmanoharā.\n Mādhvānanda kāvya.\n Pramitākṣarā, a C. on Vijñāneśvara's Mitākṣarā.\n Viṣṇusmṛtitīkā Keśavavaijayantī, written in\n1622 at the instance of Keśavanāyaka.\n Śuddhicandrikā, a C. on Kauśikāditya's Āśauca-\nnirṇaya.\n Śrāddhakalpalatā.\n Śrāddhamīmāṃsā.\n Saṃskāranirṇaya from his Smṛtisindhu.\n Smṛtisindhu, composed by request of king Hari-\nvaṃśavarman.\n Harivaṃśavilāsa.", "gloss_language": "en"}, {"gloss": "विनायक पण्डित a second name of Nanda Paṇḍita.", "gloss_language": "en"}, {"gloss": "विनायक पण्डित poet. Śp. p. 87. Mentioned in Bho-\njaprabandha Oxf. 150^b.", "gloss_language": "en"}]}], "vinsatika": [{"id": "viMSatikA", "headword": "विंशतिका", "headword_slp1": "viMSatikA", "fold": "vinsatika", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "विंशतिका a description of Ayodhyā, by Umāpati Tripā-\nṭhin. Oudh XVII, 114 (and C.).", "gloss_language": "en"}]}], "vinsatistotra": [{"id": "viMSatistotra", "headword": "विंशतिस्तोत्र", "headword_slp1": "viMSatistotra", "fold": "vinsatistotra", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "विंशतिस्तोत्र twenty stotra. Oppert 6200.", "gloss_language": "en"}]}], "vinsatismfti": [{"id": "viMSatismfti", "headword": "विंशतिस्मृति", "headword_slp1": "viMSatismfti", "fold": "vinsatismfti", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "विंशतिस्मृति twenty lawbooks. Oppert II, 5563. Ṣort\nand sweet.", "gloss_language": "en"}]}], "vinatananda