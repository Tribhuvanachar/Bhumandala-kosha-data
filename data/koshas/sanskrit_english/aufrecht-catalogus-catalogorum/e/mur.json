{"muraliDara": [{"id": "muralIDara", "headword": "मुरलीधर", "headword_slp1": "muralIDara", "fold": "muraliDara", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरलीधर grandson of Kālidāsa Miśra. Mentioned in\nKavīndracandrodaya.", "gloss_language": "en"}], "synonyms": ["मुरलीधरः"], "synonyms_slp1": ["muralIDaraH"]}], "muraliprakasa": [{"id": "muralIprakASa", "headword": "मुरलीप्रकाश", "headword_slp1": "muralIprakASa", "fold": "muraliprakasa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरलीप्रकाश instruction in flute-playing, by Bhāvabhaṭṭa.\nBik. 513.", "gloss_language": "en"}]}], "muraripaWaka": [{"id": "murAripAWaka", "headword": "मुरारिपाठक", "headword_slp1": "murAripAWaka", "fold": "muraripaWaka", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरारि पाठक father of Lakṣmaṇa (Mahābhāṣyādarśa).\nParis (D 234).", "gloss_language": "en"}]}], "murarimisra": [{"id": "murArimiSra", "headword": "मुरारिमिश्र", "headword_slp1": "murArimiSra", "fold": "murarimisra", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरारि मिश्र Mentioned by Sāyaṇa in Saṃxepaśaṅkara-\njaya as an opponent of Śaṅkara. Oxf. 258^b. A Murā-\nrimiśra is quoted by Vardhamāna on Nyāyakusu-\nmāñjali.", "gloss_language": "en"}, {"gloss": "मुरारि मिश्र\n Aṅgatvanirukti mīm.", "gloss_language": "en"}, {"gloss": "मुरारि मिश्र son of Kṛṣṇa Miśra, pupil of Rāmabhadra\nand Keśavamiśra:\n Iṣṭikālanirṇaya.\n[]\n Parvanirṇaya.\n Śubhakarmanirṇaya, written under king Trivikra-\nmanārāyaṇa.\n Bhāṣya on the mantras in Pāraskaragṛhya-\nsūtra.\n Prāyaścittamanohara.", "gloss_language": "en"}, {"gloss": "मुरारि मिश्र Quoted by Jānakīnātha in Nyāyasiddhānta-\nmañjarī.", "gloss_language": "en"}, {"gloss": "मुरारि मिश्र son of Vedamiśra, grandson of Viśvarūpa\nDīkṣita:\n Pāraskaramantrabhāṣya.", "gloss_language": "en"}, {"gloss": "मुरारि मिश्र\n Tripādīnītinayana mīm.", "gloss_language": "en"}]}], "murariBawa": [{"id": "murAriBawwa", "headword": "मुरारिभट्ट", "headword_slp1": "murAriBawwa", "fold": "murariBawa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरारि भट्ट\n Sārasaṃgraha dh.", "gloss_language": "en"}, {"gloss": "मुरारि भट्ट son of Gaṅgādhara, guru of Kauṇḍinya\n(Tarkabhāṣāprakāśikā):\n Tarkabhāṣāṭīkā.", "gloss_language": "en"}]}], "murari": [{"id": "murAri", "headword": "मुरारि", "headword_slp1": "murAri", "fold": "murari", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरारि son of Vardhamāna:\n Anargharāghava nāṭaka. Verses from it Śp. p. 74.\nSkm. Sbhv.", "gloss_language": "en"}, {"gloss": "मुरारि son of Vardhamāna, author of the Anargharā-\nghava. Compare Haravijaya 38, 68.", "gloss_language": "en"}, {"gloss": "Vaidikī Prakriyā.", "gloss_language": "en"}, {"gloss": "मुरारि son of Rudra Śarman, grandson of Harihara:\n Śuddhinibaudha.", "gloss_language": "en"}], "synonyms": ["मुरारिः"], "synonyms_slp1": ["murAriH"]}], "murarivijaya": [{"id": "murArivijaya", "headword": "मुरारिविजय", "headword_slp1": "murArivijaya", "fold": "murarivijaya", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरारिविजय nāṭaka, by Kṛṣṇa Kavi, son of Nṛsiṃha.\nSūcīpattra 93. Peters. 3, 21^a. 337.", "gloss_language": "en"}, {"gloss": "मुरारिविजय nāṭaka, by Kṛṣṇa Kavi. BL. 280.", "gloss_language": "en"}]}], "murarisripatisarvaBOma": [{"id": "murAriSrIpatisArvaBOma", "headword": "मुरारिश्रीपतिसार्वभौम", "headword_slp1": "murAriSrIpatisArvaBOma", "fold": "murarisripatisarvaBOma", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "मुरारिश्रीपति सार्वभौम\n Suprasiddhapadamañjarī lex.", "gloss_language": "en"}]}], "murKa": [{"id": "mUrKa", "headword": "मूर्ख", "headword_slp1": "mUrKa", "fold": "murKa", "headword_language": "sa", "sour