.", "gloss_language": "en"}, {"gloss": "शाकटायनव्याकरण by Abhinavaśākaṭāyana. BC 294.\n405 (and C.). 454 (Paribhāṣāsūtra, Gaṇapāṭha, Uṇādi-\nsūtra, Liṅgānuśāsana).\n C. Amoghavṛtti. Śg. 2, 71 p. 169.\n C. Prakriyāsaṃgraha by Abhayacandrasiddhānta-\nsūri. BC 406.", "gloss_language": "en"}]}, {"id": "SAkawayanavyAkaraRa", "headword": "शाकटयनव्याकरण", "headword_slp1": "SAkawayanavyAkaraRa", "fold": "sakawayanavyakaraRa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "शाकटयनव्याकरण the grammar of the pseudo Śāka-\nṭāyana. Gov. Or. Libr. Madras 95.\n C. Prakriyāsaṃgraha by Abhayacandra. ibid. This\nis probably a popular arrangement of Śāka-\nṭāyana's grammar after the pattern of the\nPrakriyāḥ.\n C. Cintāmaṇi by Yakṣavarman. Bhau Dāji 114.\nGov. Or. Libr. Madras 27. 93.", "gloss_language": "en"}]}], "sakawayanasmfti": [{"id": "SAkawAyanasmfti", "headword": "शाकटायनस्मृति", "headword_slp1": "SAkawAyanasmfti", "fold": "sakawayanasmfti", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "शाकटायनस्मृति Quoted in Pravarādhyāya W. p. 62 (the\nsame passage in Nirṇayasindhu), by Hemādri in Pari-\nśeṣakhaṇḍa p. 215, by Nīlakaṇṭha in Śrāddhama-\nyūkha (same passage as in H.), by Tirpilisūri W. p. 313.", "gloss_language": "en"}]}, {"id": "SakawAyanasmfti", "headword": "शकटायनस्मृति", "headword_slp1": "SakawAyanasmfti", "fold": "sakawayanasmfti", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "शकटायनस्मृति Quoted by Devaṇṇa in Smṛticandrikā.", "gloss_language": "en"}]}], "sakawayanopanisadBasya": [{"id": "SAkawAyanopanizadBAzya", "headword": "शाकटायनोपनिषद्भाष्य", "headword_slp1": "SAkawAyanopanizadBAzya", "fold": "sakawayanopanisadBasya", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "शाकटायनोपनिषद्भाष्य (?) by Śaṅkarācārya. Oppert II,\n4985.", "gloss_language": "en"}]}], "sakaniGaRwu": [{"id": "SAkaniGaRw