{"BanuBawa": [{"id": "BAnuBawwa", "headword": "भानुभट्ट", "headword_slp1": "BAnuBawwa", "fold": "BanuBawa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "भानु भट्ट contemporary of Nārāyaṇadāsa (Praśnārṇava).\nOxf. 334^b.", "gloss_language": "en"}, {"gloss": "भानु भट्ट son of Nīlakaṇṭha Bhaṭṭa, grandson of Śaṅkara\nBhaṭṭa:\n Ekavastrasnānavidhi.\n Dvaitanirṇayasiddhāntasaṃgraha, an epitome of his\ngrandfather's Dharmadvaitanirṇaya.\n Homanirṇaya.", "gloss_language": "en"}]}], "Banu": [{"id": "BAnu", "headword": "भानु", "headword_slp1": "BAnu", "fold": "Banu", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "भानु son of Viśvadhara, brother of Harinātha (Kāvyā-\ndarśamārjana) and Keśava. Oxf. 206^b.\n[]", "gloss_language": "en"}, {"gloss": "भानु poet. Skm.", "gloss_language": "en"}, {"gloss": "Rāmasahasranāmavivaraṇa.", "gloss_language": "en"}, {"gloss": "Karaṇābhīṣṭa jy.", "gloss_language": "en"}], "synonyms": ["भानुः"], "synonyms_slp1": ["BAnuH"]}], "BanupaRqita": [{"id": "BAnupaRqita", "headword": "भानुपण्डित", "headword_slp1": "BAnupaRqita", "fold": "BanupaRqita", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "भानु पण्डित\n Sajjanavallabha jy.", "gloss_language": "en"}, {"gloss": "भानु पण्डित son of Viśvanātha:\n Sajjanavallabha.", "gloss_language": "en"}]}], "Banudiksita": [{"id": "BAnudIkzita", "headword": "भानुदीक्षित", "headword_slp1": "BAnudIkzita", "fold": "Banudiksita", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "भानु दीक्षित\n Gurubālaprabodhinī Amarakośaṭīkā.\n Liṅgabhaṭṭīya lex.", "gloss_language": "en"}, {"gloss": "भानु दीक्षित son of Nārāyaṇa Dīkṣita:\n Mātṛkārṇanighaṇṭu tantr.", "gloss_language": "en"}, {"gloss": "भानु दीक्षित\n Dānaviveka.", "gloss_language": "en"}]}], "Banukara": [{"id": "BAnukara", "headword": "भानुकर", "headword_slp1": "BAnukara", "fold": "Banukara"