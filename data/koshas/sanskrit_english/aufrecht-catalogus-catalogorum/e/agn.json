:\n Avatāratāratamyastotra.\n Āryā.\n Kāyenetivivaraṇa.\n Kṛṣṇapremāmṛta.\n Gīta.\n Gītagovindaprathamāṣṭapadīvivṛti.\n Gokulāṣṭaka.\n Janmāṣṭamīnirṇaya.\n Jalabhedaṭīkā.\n Tāratamyastava and vyākhyā. Aṇutāratamya, Bṛ-\nhattāratamya.\n Dhruvapada.\n Nāmacandrikā.\n Nyāsādeśavivaraṇa.\n Prabodha.\n Premāmṛtabhāṣya.\n Bhaktihaṃsa.\n Bhaktihetunirṇaya.\n Bhagavatsvatantratā.\n Bhagavadgītātātparya.\n Bhagavadgītāhetunirṇaya.\n Bhāgavatatattvadīpikā.\n Bhāgavatadaśamaskandhavivṛti.\n Bhujaṅgaprayātāṣṭaka.\n Yamunāṣṭapadī.\n Rasasarvasva.\n[]\n Rāmanavamīnirṇaya.\n Vallabhāṣṭaka.\n Vidvanmaṇḍana.\n Vivekadhairyāśrayaṭīkā.\n Śikṣāpattra.\n Śṛṅgārarasamaṇḍana.\n Ṣaṭpadī.\n Saṃnyāsanirṇayavivaraṇa.\n Samayapradīpa.\n Sarvottamastotra and C..\n Siddhāntamuktāvalī and C..\n Sevākaumudī.\n Svatantralekhana.\n Svāminīstotra.", "gloss_language": "en"}], "synonyms": ["अग्निकुमारः"], "synonyms_slp1": ["agnikumAraH"]}], "agnicayana": [{"id": "agnicayana", "headword": "अग्निचयन", "headword_slp1": "agnicayana", "fold": "agnicayana", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "अग्निचयन śr. Oppert 1373. 1730. 1731.", "gloss_language": "en"}, {"gloss": "अग्निचयन Taitt. SB. 87.", "gloss_language": "en"}, {"gloss": "अग्निचयन Āpast. Cs. 210.", "gloss_language": "en"}], "synonyms": ["अग्निचयनः"], "synonyms_slp1": ["agnicayanaH"]}], "agnicayanakarika": [{"id": "agnicayanakArikA", "headword": "अग्निचयनकारिका", "headword_slp1": "agnicayanakArikA", "fold": "agnicayanakarika", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "अग्निचयनकारिका Baudh. Burnell 25^b.", "gloss_language": "en"}]}], "agnicayanaprayoga": [{"id": "agnicayanaprayoga", "headword": "अग्निचयनप्रयोग", "headword_slp1": "agnicayanaprayoga", "fold": "agnicayanaprayoga", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "अग्निचयनप्रयोग Āpast. Peters. 2, 176.", "gloss_language": "en"}]}], "agnicitikar