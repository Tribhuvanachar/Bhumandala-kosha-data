{"soma": [{"id": "soma", "headword": "सोम", "headword_slp1": "soma", "fold": "soma", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोम śr. Oppert II, 5365.\n --Āpast. and C. by Nṛsiṃha. B. 1, 152.", "gloss_language": "en"}, {"gloss": "सोम son of Hari, grandson of Nāḍiga, father of Ma-\nhādeva, father of Dharaṇigoṇiga, father of Acyuta\n(Rasasaṃgrahasiddhānta). W. p. 299.", "gloss_language": "en"}, {"gloss": "सोम poet. Śp. p. 96. Sbhv. See Kavirājasoma.", "gloss_language": "en"}, {"gloss": "सोम of Benares:\n Horāsetu.", "gloss_language": "en"}, {"gloss": "सोम son of Mudgala:\n Rāgavibodha music.", "gloss_language": "en"}, {"gloss": "सोम father of Vāgbhaṭa (Vāgbhaṭālaṃkāra).", "gloss_language": "en"}, {"gloss": "सोम as an author of a smṛti, quoted by Hemādri in\nPariśeṣakhaṇḍa 2, 733. 734. 737.", "gloss_language": "en"}, {"gloss": "Tribhāṣyaratna.", "gloss_language": "en"}], "synonyms": ["सोमं", "सोमः"], "synonyms_slp1": ["somaM", "somaH"]}], "somaBagavatacarya": [{"id": "somaBAgavatAcArya", "headword": "सोमभागवताचार्य", "headword_slp1": "somaBAgavatAcArya", "fold": "somaBagavatacarya", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोम भागवताचार्य guru of Kṣemendra. Report XLIV.", "gloss_language": "en"}]}], "somaBawa": [{"id": "somaBawwa", "headword": "सोमभट्ट", "headword_slp1": "somaBawwa", "fold": "somaBawa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोम भट्ट father of Nṛsiṃha Bhaṭṭa (Viṣṇudharmamī-\nmāṃsā). IO. 2461.", "gloss_language": "en"}, {"gloss": "सोम भट्ट is followed by Devanātha in his Adhikaraṇa-\nkaumudī. L. 1883.", "gloss_language": "en"}]}], "somasarman": [{"id": "somaSarman", "headword": "सोमशर्मन्", "headword_slp1": "somaSarman", "fold": "somasarman", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोम शर्मन् of the Bharadvāja race, of Kāmpilya, father\nof Devada