recht-catalogus-catalogorum", "senses": [{"gloss": "सोमदेव एकनाथ\n Rāmaśataka and C..", "gloss_language": "en"}]}], "somanandin": [{"id": "somanandin", "headword": "सोमनन्दिन्", "headword_slp1": "somanandin", "fold": "somanandin", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोमनन्दिन् a grammarian. Quoted by Ujjvaladatta,\nRāyamukuṭa, and in Dhāturatnākara.", "gloss_language": "en"}]}], "somanaTa": [{"id": "somanATa", "headword": "सोमनाथ", "headword_slp1": "somanATa", "fold": "somanaTa", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोमनाथ father of Mahādeva (Prayogavaijayantī). Oxf.\n364^b.", "gloss_language": "en"}, {"gloss": "Anyoktimuktāvalī.\n Anyoktiśataka.\n Śṛṅgāravairāgyamuktāvalī.", "gloss_language": "en"}, {"gloss": "Guṇaratna ny.", "gloss_language": "en"}, {"gloss": "Candrikā bṛhatī gr.\n Chandaḥprakāśaṭīkā.\n Śiśubodha gr.", "gloss_language": "en"}, {"gloss": "Jātimālā.", "gloss_language": "en"}, {"gloss": "Rāgavibodhaviveka. See Soma, son of Mudgala.", "gloss_language": "en"}, {"gloss": "Rāmāryāśataka.\n Vairāgyaśataka", "gloss_language": "en"}, {"gloss": "सोमनाथ guru of Rāmakṛṣṇa (Līlāvatīvṛtti).", "gloss_language": "en"}, {"gloss": "सोमनाथ a Bengali Brahman, father of Lālabhaṭṭa, father\nof Mahādeva, father of Jñāneśvara, father of Gaṇeśa\n(Tithimañjarī).", "gloss_language": "en"}, {"gloss": "Bhaktirahasya.", "gloss_language": "en"}, {"gloss": "सोमनाथ son of Maheśa Bhaṭṭa or Maheśvara Bhaṭṭa:\n Ajñānadhvāntadīpikā.", "gloss_language": "en"}, {"gloss": "C. on Āpastambaśrautasūtra.\n[]", "gloss_language": "en"}, {"gloss": "Śivāvivāhamaṇḍapa.", "gloss_language": "en"}], "synonyms": ["सोमनाथः"], "synonyms_slp1": ["somanATaH"]}], "somanaTapaRqita": [{"id": "somanATapaRqita", "headword": "सोमनाथपण्डित", "headword_slp1": "somanATapaRqita", "fold": "somanaTapaRqita", "headword_language": "sa", "source": "aufrecht-catalogus-catalogorum", "senses": [{"gloss": "सोमना