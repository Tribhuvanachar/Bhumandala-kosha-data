{"mis": [{"id": "miS", "headword": "मिश्", "headword_slp1": "miS", "fold": "mis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिश् (cf. √ मश्, and 1. मिक्ष्) cl. 1. P. मेशति, to sound or to be angry, Dhātup. xvii, 74.", "gloss_language": "en"}]}, {"id": "miz", "headword": "मिष्", "headword_slp1": "miz", "fold": "mis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. मिष् cl. 6. P. (Dhātup. xxviii, 60) मिष॑ति (of the simple verb only pr. p. मिष॑त्; in Gr. also pf. मिमेष; aor. अमेषीत्; fut. मेषिता, मेषिष्यति &c.; cf. उन्- and नि√ मिष्),\nto open the eyes, wink, blink, RV. &c. &c. (generally used in gen. = before the eyes of, in presence of, in spite of, e.g. मिषतो बन्धु-वर्गस्य, the whole number of friends looking on i.e. before their very eyes, in spite of them);\nto rival, emulate (स्पर्धायाम्), Dhātup.", "gloss_language": "en"}, {"gloss": "2. मिष् cl. 1. P. मेषति, to sprinkle, moisten, wet, Dhātup. xvii, 48.", "gloss_language": "en"}]}, {"id": "mis", "headword": "मिस्", "headword_slp1": "mis", "fold": "mis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिस् cl. 4. P. मि॑स्यति to go, Naigh. ii, 14.", "gloss_language": "en"}]}], "misara": [{"id": "miSara", "headword": "मिशर", "headword_slp1": "miSara", "fold": "misara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिशर m. or n. N. of a place, Cat. (cf. मिसर, p. 818, col. 2).", "gloss_language": "en"}]}, {"id": "misara", "headword": "मिसर", "headword_slp1": "misara", "fold": "misara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिसर m. or n. (perhaps = مصر Misr, Egypt?) N. of a place, Cat. (cf. मिशर.)", "gloss_language": "en"}]}], "misi": [{"id": "miSi", "headword": "मिशि", "headword_slp1": "miSi", "fold": "misi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिशि or मिशी, f. (only L.) Anethum Panmori and Anethum Sowa;\n Nardostachys Jatamansi (cf. मिषि