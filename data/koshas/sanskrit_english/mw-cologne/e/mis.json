 {"gloss": "मिश्र् [cf. Gk. μίσγω, μίγνυμι.; Lat. miscere; Slav. měsiti; Lith. mìsti, maisztas; Germ. misken, mischen; Angl.Sax. miscian; Eng. mix.]", "gloss_language": "en"}]}, {"id": "misr", "headword": "मिस्र्", "headword_slp1": "misr", "fold": "misr", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिस्र् See मिश्र्, p. 817, col. 3.", "gloss_language": "en"}]}], "misra": [{"id": "miSra", "headword": "मिश्र", "headword_slp1": "miSra", "fold": "misra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मिश्र॑ mf(आ॑)n. (prob. fr. a lost √ मिश् cf. under मिक्ष्) mixed, mingled, blended, combined, RV. &c. &c. (वचांसि मिश्रा √ 1. कृ, A. -कृणुते, to mingle words, talk together, RV. x, 93, 1)", "gloss_language": "en"}, {"gloss": "manifold, diverse, various, TS. &c. &c.", "gloss_language": "en"}, {"gloss": "mixed or connected or furnished with, accompanied by (instr. with or without समम् gen. or comp.; rarely मिश्र ibc., cf. मिश्र-वात), VS. &c. &c.", "gloss_language": "en"}, {"gloss": "pl. (ifc. after honorific epithets = &c.; e.g. आर्य-मिश्राः, respectable or honourable people &c.; often also in sg. ifc. and rarely ibc. with proper names by way of respect, cf. कृष्ण-, मधु-म्˚ and comp. below)", "gloss_language": "en"}, {"gloss": "mixing, adulterating: (cf. धान्यम्˚)", "gloss_language": "en"}, {"gloss": "मिश्र॑ m. a kind of elephant, L.", "gloss_language": "en"}, {"gloss": "(in music) a kind of measure, Saṃgīt.", "gloss_language": "en"}, {"gloss": "N. of various authors and other men (also abbreviation for some names ending in मिश्र, e.g. for Madana-, Mitra-, Vācaspati-m˚), Cat.", "gloss_language": "en"}, {"gloss": "मिश्र॑ n. principal and interest, Lalit. (cf. -धन)", "gloss_language": "en"}, {"gloss": "a species of radish, L.", "gloss_language": "en"}], "synonyms": ["मिश्रं", "मिश्रः"], "synonyms_slp1": ["miSraM", "miSraH"]}], "misrakesava": [{"id": "miSrakeSava", "headword": "मिश्रकेशव", "headword_slp1": "miSrakeSava", "fo