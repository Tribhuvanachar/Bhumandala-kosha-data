rd": "वीटी", "headword_slp1": "vIwI", "fold": "viwi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वीटि or वीटी, f. the betel plant, Piper Betel, L.", "gloss_language": "en"}]}], "viwikaRWirava": [{"id": "viwikaRWIrava", "headword": "विटिकण्ठीरव", "headword_slp1": "viwikaRWIrava", "fold": "viwikaRWirava", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "विटि—कण्ठीरव m. N. of Varada-rāja (the author of the Madhya-siddhānta-kaumudī), Cat.", "gloss_language": "en"}]}], "viwka": [{"id": "viwka", "headword": "विट्क", "headword_slp1": "viwka", "fold": "viwka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "विट्क , विट्-कारिका, विट्-कृमि &c. See under 3. विष्.", "gloss_language": "en"}, {"gloss": "विट्क (ifc.) = 3. विष्, feces (cf. कर्ण- and भिन्न-वि॑ट्क).", "gloss_language": "en"}]}], "viwkula": [{"id": "viwkula", "headword": "विट्कुल", "headword_slp1": "viwkula", "fold": "viwkula", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "विट्-कुल See under 2. विश्.", "gloss_language": "en"}, {"gloss": "विट्—कुल n. the house of a Vaiśya, ĀśvŚr.", "gloss_language": "en"}]}], "viwWala": [{"id": "viwWala", "headword": "विट्ठल", "headword_slp1": "viwWala", "fold": "viwWala", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "विट्ठल m. (also written विठल, विठ्ठल, and विढ्ढल) N. of a god worshipped at Pandharpur in the Deccan (he is commonly called Viṭho-bā, and stated to be an incarnation of Viṣṇu or Kṛṣṇa himself, who is believed to have visited this city and infused a large portion of his essence into a Brāhman named Puṇḍarīka or Puṇḍalīka, who had gained a great reputation for filial piety; his images represent him standing on a brick [cf. 2. विड्] with his arms akimbo), RTL. 263", "gloss_language": "en"}, {"gloss": "(also with आचार्य, दीक्षित, भट्ट &c.) N. of various authors and teachers (esp. of a grammarian, disparaged by Bhaṭṭoji, and of a son of Vallabhāc