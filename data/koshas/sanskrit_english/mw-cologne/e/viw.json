{"viw": [{"id": "viw", "headword": "विट्", "headword_slp1": "viw", "fold": "viw", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बिट् (or विट्), cl. 1. P. बेटति, to swear, shout, address harshly, Dhātup. ix, 30.", "gloss_language": "en"}, {"gloss": "विट् (prob. artificial; cf. √ बिट् and विड्) cl. 1. P. वेटति, to sound, Dhātup. ix, 29.", "gloss_language": "en"}, {"gloss": "1. विट् (for 2. See p. 995, col. 2), in comp. for 2. विश्.", "gloss_language": "en"}, {"gloss": "2. विट् (for 1. See p. 989, col. 2) in comp. for 3. विष्.", "gloss_language": "en"}]}], "viwa": [{"id": "viwa", "headword": "विट", "headword_slp1": "viwa", "fold": "viwa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "विट m. (derivation doubtful) a voluptuary, sensualist, bon-vivant, boon-companion, rogue, knave, Kāv.; Rājat.; Kathās. &c. (in the drama, esp. in the Mṛcchakaṭikā, he is the companion of a dissolute prince and resembles in some respects the Vidūṣaka, being generally represented as a parasite on familiar terms with his associate, but at the same time accomplished in the arts of poetry, music, and singing; ifc. a term of reproach g. खसूच्य्-आदि, Gaṇar.; L. also ‘the keeper of a prostitute; a catamite; a mouse; Acacia Catechu; the orange tree; a kind of salt; = प्राञ्चल्लोह [?]; = विटप N. of a mountain’)", "gloss_language": "en"}, {"gloss": "विट n. a house, Gal.", "gloss_language": "en"}], "synonyms": ["विटः"], "synonyms_slp1": ["viwaH"]}, {"id": "vIwa", "headword": "वीट", "headword_slp1": "vIwa", "fold": "viwa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वीट n. (only in Siddh.) or वीटा f. a small piece of wood shaped like a barley-corn and about a span long (it was struck with a stick or bat in a kind of game, like tip-cat, played by boys; accord. to some it was a kind of metal ball; others say it was held in the mouth as a form of penance), MBh. i, 5050 (Sch.) &c.", "gloss_language": "en"}]}], "viwakanta": [