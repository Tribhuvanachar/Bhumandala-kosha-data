{"sanGa": [{"id": "saMGa", "headword": "संघ", "headword_slp1": "saMGa", "fold": "sanGa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सं-घ &c. See s.v.", "gloss_language": "en"}, {"gloss": "सं-घ m. (fr. सम् + √ हन्) ‘close contact or combination’, any collection or assemblage, heap, multitude, quantity, crowd, host, number (generally with gen. pl. or ifc., e.g. मुनि-स्˚, ‘a multitude of sages’, BhP.; शत्रु-स्˚, a host of enemies, Rājat.), MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "any number of people living together for a certain purpose, a society, association, company, community", "gloss_language": "en"}, {"gloss": "a clerical community, congregation, church, Mn.; Sāh. &c.", "gloss_language": "en"}, {"gloss": "(esp.) the whole community or collective body or brotherhood of monks (with Buddhists; also applied to a monkish fraternity or sect among Jainas), Buddh.; Sarvad.; MWB. 176.", "gloss_language": "en"}], "synonyms": ["संघः", "सङ्घ", "सङ्घः"], "synonyms_slp1": ["saMGaH", "saNGa", "saNGaH"]}], "sanGata": [{"id": "saMGAta", "headword": "संघात", "headword_slp1": "saMGAta", "fold": "sanGata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सं-घात &c. See s.v.", "gloss_language": "en"}, {"gloss": "सं-घात॑ m. (rarely n.; ifc. f(आ). ) striking or dashing together, killing, crushing, MBh.; Suśr.", "gloss_language": "en"}, {"gloss": "closing (of a door &c.), VS.; TBr.", "gloss_language": "en"}, {"gloss": "combat, war, battle, VS.; Kāṭh.; MBh.", "gloss_language": "en"}, {"gloss": "compressing, condensation, compactness, hardening, Yājñ.; Hariv.; Suśr.; VarBṛS.", "gloss_language": "en"}, {"gloss": "close union or combination, collection, cluster, heap, mass, multitude, TS.; MBh. &c.", "gloss_language": "en"}, {"gloss": "a company of fellow-travellers, caravan, VP.", "gloss_language": "en"}, {"gloss": "a collection of mucus, phlegm (cf. संघाणक), L.", "gloss_language": "en"}, {"gloss": "a bone, L.", "gloss_language": "en"}, {"gloss": "any aggregate of matter, body, Bhag.; Pur.", "gloss_language": "en"}, {"gloss": "intensity, R.; Suśr.", "gloss_language": "en"}, {"gloss": "a poem composed in one and the same metre, Kāvyād.", "gloss_language": "en"}, {"gloss": "(in gram.) a compound as a compact whole (opp. to its single parts), Kāś. on Pāṇ. ii, 3, 56", "gloss_language": "en"}, {"gloss": "a vowel with its consonant (opp. to वर्ण, ‘a letter’), Kāty.", "gloss_language": "en"}, {"gloss": "(in dram.) a partic. gait or mode of walking, W.", "gloss_language": "en"}, {"gloss": "N. of a division of the infernal regions (cf. संहात), Yājñ.; Buddh.", "gloss_language": "en"}, {"gloss": "सं-घात &c. See col. 1.", "gloss_language": "en"}], "synonyms": ["संघातः", "सङ्घात", "सङ्घातः"], "synonyms_slp1": ["saMGAtaH", "saNGAta", "saNGAtaH"]}, {"id": "sAMGAta", "headword": "सांघात", "headword_slp1": "sAMGAta", "fold": "sanGata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सांघात mfn. (fr. सं-घात) = सं-घाते दीयते, or कार्यम्, g. व्युष्टादि.", "gloss_language": "en"}]}], "sanGagupta": [{"id": "saMGagupta", "headword": "संघगुप्त", "headword_slp1": "saMGagupta", "fold": "sanGagupta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सं-घ—गुप्त m. N. of the father of Vāg-bhaṭa, Cat. (cf. संघ-पति).", "gloss_language": "en"}]}], "sanGaguhya": [{"id": "saMGaguhya", "headword": "संघगुह्य", "headword_slp1": "saMGaguhya", "fold": "sanGaguhya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सं-घ—गुह्य m. N. of a man, Buddh.", "gloss_language": "en"}]}], "sanGacarin": [{"id": "saMGacArin", "headword": "संघचारिन्", "headword_slp1": "saMGacArin", "fold": "sanGacarin", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सं-घ—चारिन् mfn. going in flocks or shoals, gregarious, MBh.; R.", "gloss_language": "en"}, {"gloss": "सं-घ—चारिन् m. a fish, L.", "gloss_language": "en"}], "synonyms": ["सङ्घचारिन्"], "synonyms_s