ord": "सज्य", "headword_slp1": "sajya", "fold": "sajya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—ज्य See s.v., col. 2.", "gloss_language": "en"}, {"gloss": "स-ज्य mfn. (fr. 7. स + 3. ज्या॑, q.v.) having a bow-string, strung (as a bow), placed on the bow-string (as an arrow), Kauś.; MBh. : R. &c.", "gloss_language": "en"}]}, {"id": "sAjya", "headword": "साज्य", "headword_slp1": "sAjya", "fold": "sajya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "साज्य mfn. having clarified butter, KātyŚr.", "gloss_language": "en"}]}], "sajyotis": [{"id": "sajyotis", "headword": "सज्योतिस्", "headword_slp1": "sajyotis", "fold": "sajyotis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—ज्योतिस् mfn. having the same or a common light, Pāṇ. vi, 3, 85", "gloss_language": "en"}, {"gloss": "स—ज्योतिस् ind. according to the light (i.e. either by day from the disappearance of the stars till sunset, or by night from sunset till the appearance of the stars), Mn. iv, 106; v, 82 (˚तिषि id., Gaut. ii, 11)", "gloss_language": "en"}, {"gloss": "as long as the sun is in the sky, Gaut. xvi, 31.", "gloss_language": "en"}, {"gloss": "स-ज्योतिस् &c. See col. 1.", "gloss_language": "en"}]}], "sajyotsna": [{"id": "sajyotsnA", "headword": "सज्योत्स्ना", "headword_slp1": "sajyotsnA", "fold": "sajyotsna", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—ज्योत्स्ना f. having moonlight", "gloss_language": "en"}, {"gloss": "(scil. रात्रि) a moonlight night, MW.", "gloss_language": "en"}]}], "sajvara": [{"id": "sajvara", "headword": "सज्वर", "headword_slp1": "sajvara", "fold": "sajvara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—ज्वर mfn. having fever, feverish, Prasaṅg.", "gloss_language": "en"}]}], "saj": [{"id": "saj", "headword": "सज्", "headword_slp1": "saj", "fold": "saj", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सज् See √ सञ्ज्, p. 1132, col. 3.", "gloss_language": "en"}, {"gloss": "2. सञ्ज् (or सज्) cl. 1. P. (Dhātup. xxiii, 18) स॑जति (rarely Ā. ˚ते; pf. ससञ्ज, Br. &c. [in some rare and doubtful cases in MBh. & Ragh. ससज्ज]; 3. pl. सेजुः, ŚBr.; aor. असाङ्क्षीत्, साङ्क्षीत्, Up. &c.; असञ्जि, Br.; अ॑सक्थास्, ˚त, RV.; Br.; Prec. सज्यात् Gr.; fut. सङ्क्ता, सङ्क्ष्यति, ib.; inf. सक्तुम्, MBh.; सङ्क्तोस्, Br.; ind.p. -सज्य, -स॑ङ्गम्, ib. &c.),\nto cling or stick or adhere to, be attached to or engaged in or occupied with (loc.), Br.; Ragh.; Naiṣ. :\nPass. सज्य॑ते (generally सज्जते, ep. also ˚ति), to be attached or fastened, adhere, cling, stick (with न, ‘to fly through without sticking’, as an arrow), ŚBr. &c. &c.;\nto linger, hesitate, MBh.; R.;\nto be devoted to or intent on or occupied with (loc.), MBh.; Kāv. &c.:\nCaus. सञ्जयति (aor. अससञ्जत्; for सज्जयति See √ सज्ज्),\nto cause to stick or cling to, unite or connect with (loc.), Bhag.; Śaṃk. :\nDesid. सिसङ्क्षति See आ-√ सञ्ज्:\nIntens. सासज्यते, सासङ्क्ति Gr.\n [cf. accord. to some, Lat. segnis; Lith. segù, ‘I attach’.]", "gloss_language": "en"}, {"gloss": "सज् in comp. for सत्.", "gloss_language": "en"}]}, {"id": "sajj", "headword": "सज्ज्", "headword_slp1": "sajj", "fold": "saj", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. सज्ज् cl. 1. P. सज्जति, to go, move, Dhātup. vii, 22.", "gloss_language": "en"}, {"gloss": "2. सज्ज् (= √ सञ्ज्; cf. सज्जय), Caus. सज्जयति, to cling, adhere, fasten or fix or attach to (loc.), Kathās.;\nto fix (the mind) upon, BhP.;\nto cause one's self to be embraced (by other men), Mn. viii, 362.", "gloss_language": "en"}, {"gloss": "1. सञ्ज् (or सज्ज्), cl. 1. P. सञ्जति, सज्जति, to go, move, Dhātup. vii, 22.", "gloss_language": "en"}]}], "sajatakama": [{"id": "sajAtakAma", "headword": "सजातकाम", "headword_slp1": "sajAtakAma", "fold": "sajatakama", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स-जात—काम mfn. desirous of dominion over his kin, Kāṭh.", "glo