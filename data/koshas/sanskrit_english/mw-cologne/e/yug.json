{"yuga": [{"id": "yuga", "headword": "युग", "headword_slp1": "yuga", "fold": "yuga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग युग्म, युग्य &c. See p. 854.", "gloss_language": "en"}, {"gloss": "युग॑ n. a yoke, team (exceptionally m.), RV. &c. &c.", "gloss_language": "en"}, {"gloss": "(ifc. f(आ). ) a pair, couple, brace, GṛŚrS.; MBh. &c.", "gloss_language": "en"}, {"gloss": "(also with मानुष or मनुष्य) a race of men, generation (exceptionally m.), RV. &c. &c.", "gloss_language": "en"}, {"gloss": "a period or astronomical cycle of 5 (rarely 6) years, a lustrum (esp. in the cycle of Jupiter), MBh.; Var.; Suśr.", "gloss_language": "en"}, {"gloss": "an age of the world, long mundane period of years (of which there are four, viz. 1. Kṛta or Satya, 2. Tretā, 3. Dvāpara, 4. Kali, of which the first three have already elapsed, while the Kali, which began at midnight between the 17th and 18th of Feb. 3102 B.C. [o.s.], is that in which we live; the duration of each is said to be respectively 1,728,000, 1,296,000, 864,000, and 432,000 years of men, the descending numbers representing a similar physical and moral deterioration of men in each age; the four Yugas comprise an aggregate of 4,320,000 years and constitute a ‘great Yuga’ or Mahā-yuga; cf. IW. 178), AV. &c. &c.", "gloss_language": "en"}, {"gloss": "a measure of length = 86 Aṅgulas, Śulbas. (= 4 Hastas or cubits, L.)", "gloss_language": "en"}, {"gloss": "a symbolical N. for the number ‘four’, Sūryas.", "gloss_language": "en"}, {"gloss": "for the number ‘twelve’, Jyot.", "gloss_language": "en"}, {"gloss": "N. of a partic. position or configuration of the moon, VarBṛS.", "gloss_language": "en"}, {"gloss": "of a partic. Nābhasa constellation (of the class called Sāṃkhya-yoga, when all the planets are situated in two houses), ib.", "gloss_language": "en"}, {"gloss": "of a double Śloka or two Ślokas so connected that the sense is only completed by the two together, Rājat.", "gloss_language": "en"}], "synonyms": ["युगं", "युगः"], "synonyms_slp1": ["yugaM", "yugaH"]}], "yugat": [{"id": "yugat", "headword": "युगत्", "headword_slp1": "yugat", "fold": "yugat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युगत् v.l. for द्यु-गत् (q.v.), Naigh.", "gloss_language": "en"}]}], "yugvan": [{"id": "yugvan", "headword": "युग्वन्", "headword_slp1": "yugvan", "fold": "yugvan", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग्वन् See अभि-, स-, स्व-य्˚.", "gloss_language": "en"}]}], "yugakilaka": [{"id": "yugakIlaka", "headword": "युगकीलक", "headword_slp1": "yugakIlaka", "fold": "yugakilaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—कीलक m. the pin of a yoke, L.", "gloss_language": "en"}], "synonyms": ["युगकीलकः"], "synonyms_slp1": ["yugakIlakaH"]}], "yugaksaya": [{"id": "yugakzaya", "headword": "युगक्षय", "headword_slp1": "yugakzaya", "fold": "yugaksaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—क्षय m. the end of a Yuga, destruction of the world, R.; BhP.", "gloss_language": "en"}], "synonyms": ["युगक्षयः"], "synonyms_slp1": ["yugakzayaH"]}], "yugacarman": [{"id": "yugacarman", "headword": "युगचर्मन्", "headword_slp1": "yugacarman", "fold": "yugacarman", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—चर्मन् n. a leather pad attached to a yoke, MBh.", "gloss_language": "en"}]}], "yugacCidra": [{"id": "yugacCidra", "headword": "युगच्छिद्र", "headword_slp1": "yugacCidra", "fold": "yugacCidra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—च्छिद्र n. a hole in a yoke, ĀpGṛ.", "gloss_language": "en"}]}], "yugadirGa": [{"id": "yugadIrGa", "headword": "युगदीर्घ", "headword_slp1": "yugadIrGa", "fold": "yugadirGa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—दीर्घ mfn. as long as a chariot yoke, Ragh.", "gloss_language": "en"}]}], "yugaDara": [{"id": "yugaDAra", "headword": "युगधार", "headword_slp1": "yugaDAra", "fold": "yugaDara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—धार m. (prob.) the pin by which a yoke is fastened to the pole, MānGṛ.", "gloss_language": "en"}]}], "yugaDur": [{"id": "yugaDur", "headword": "युगधुर्", "headword_slp1": "yugaDur", "fold": "yugaDur", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—धुर् f. the pin of a yoke, ĀpŚr.", "gloss_language": "en"}]}], "yuganDara": [{"id": "yugaMDara", "headword": "युगंधर", "headword_slp1": "yugaMDara", "fold": "yuganDara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—ं-धर mf(आ)n. holding or bearing the yoke (?), MBh.", "gloss_language": "en"}, {"gloss": "युग—ं-धर m. n. the pole of a carriage or wood to which the yoke is fixed, MBh.", "gloss_language": "en"}, {"gloss": "युग—ं-धर m. a partic. magical formula spoken over weapons, R.", "gloss_language": "en"}, {"gloss": "N. of a king, Hariv.; Pur.", "gloss_language": "en"}, {"gloss": "of a mountain, MBh. (with Buddhists one of the 8 mountains, Dharmas. 125)", "gloss_language": "en"}, {"gloss": "of a forest, Pañcar.", "gloss_language": "en"}, {"gloss": "pl. N. of a people, MBh.; VarBṛS.; VP.", "gloss_language": "en"}], "synonyms": ["युगंधरं", "युगंधरः", "युगन्धर", "युगन्धरः"], "synonyms_slp1": ["yugaMDaraM", "yugaMDaraH", "yuganDara", "yuganDaraH"]}], "yugapa": [{"id": "yugapa", "headword": "युगप", "headword_slp1": "yugapa", "fold": "yugapa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—प m. N. of a Gandharva, MBh.; Hariv.", "gloss_language": "en"}]}], "yugapatra": [{"id": "yugapattra", "headword": "युगपत्त्र", "headword_slp1": "yugapattra", "fold": "yugapatra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "युग—पत्त्र m. Bauhinia Variegata, L.", "gloss_language": "en"}]}], "yugapatraka": [{"id": "yugapattraka", "headword": "युगपत्त्रक", "headword_slp1": "yugapat