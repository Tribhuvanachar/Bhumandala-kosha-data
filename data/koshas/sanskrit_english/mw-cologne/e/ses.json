{"sesa": [{"id": "Seza", "headword": "शेष", "headword_slp1": "Seza", "fold": "sesa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष &c. See p. 1088, col. 3.", "gloss_language": "en"}, {"gloss": "शेष m. n. (fr. √ 2. शिष्) remainder, that which remains or is left, leavings, residue (pl. ‘all the others’), surplus, balance, the rest (शेषे loc. ‘for the rest’, ‘in all other cases’; शेषे रात्रौ, ‘during the rest of the night’; मम शेषम् अस्ति, ‘there remains something to happen to me’)", "gloss_language": "en"}, {"gloss": "that which has to be supplied (e.g. any word or words which have been omitted in a sentence; इति शेषः, ‘so it was left to be supplied’, a phrase commonly used by Comm. in supplying any words necessary to elucidate the text)", "gloss_language": "en"}, {"gloss": "that which is saved or spared or allowed to escape (nom. with √ अस्, or √ भू, ‘to be spared’; शेषं-√ कृ, ‘to spare’, ‘allow to escape’; शेषम् अवाप् ‘to escape’), Mn.; MBh.; R. &c.", "gloss_language": "en"}, {"gloss": "remaining (used as an adj. at the end of adj. comp. [f(आ). ], cf. कथा-श्˚, कृत्य-श्˚), AitBr. &c. &c.", "gloss_language": "en"}, {"gloss": "remaining out of or from, left from (with abl. or loc., e.g. प्रयातेभ्यो ये शेषाः, ‘the persons left out of those who had departed’; but mostly ifc. after a pp. in comp., e.g. भुक्त-शेष, ‘remaining from a meal’, ‘remnant of food’; हत-शेषाः, ‘those left out of the slain’, ‘the survivors’ &c.), Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "end, issue, conclusion, finish, result, RV. 77, 15", "gloss_language": "en"}, {"gloss": "last, last-mentioned, Rājat.", "gloss_language": "en"}, {"gloss": "a supplement, appendix, Nir. iii, 13", "gloss_language": "en"}, {"gloss": "a keepsake, token of remembrance, Daś.", "gloss_language": "en"}, {"gloss": "secondary matter, accident, KātyŚr., Sch.", "gloss_language": "en"}, {"gloss": "death, destruction, W.", "gloss_language": "en"}, {"gloss": "effect.", "gloss_language": "en"}, {"gloss": "शेष m. N. of a celebrated mythological thousand-headed serpent regarded as the emblem of eternity (whence he is also called An-anta, ‘the infinite’;\nin the Viṣṇu-Purāṇa he and the serpents Vāsuki and Takṣaka are described as sons of Kadru, but in one place Śeṣa alone is called king of the Nāgas or snakes inhabiting Pātāla, while elsewhere Vāsuki also is described as king of the Nagas and Takṣaka of the serpents;\nthe thousand headed Śeṣa is sometimes represented as forming the couch and canopy of Viṣṇu whilst sleeping during the intervals of creation, sometimes as supporting the seven Pātālas with the seven regions above them and therefore the entire world ;\nhe is said to have taught astronomy to Garga;\naccording to some legends he became incarnate in Bala-rāma q.v.), MBh.;\nHariv.;\nPur. &c. (RTL. 105; 112; 232 n. 1)", "gloss_language": "en"}, {"gloss": "N. of one of the Prajā-patis, R.; VP.", "gloss_language": "en"}, {"gloss": "of a Muni, MW.", "gloss_language": "en"}, {"gloss": "(also with आचार्य, दीक्षित, शास्त्रिन् &c.) of various authors (cf. below)", "gloss_language": "en"}, {"gloss": "of one of the mythical elephants that support the earth, L.", "gloss_language": "en"}, {"gloss": "a kind of metre, L.", "gloss_language": "en"}, {"gloss": "शेष n. See above.", "gloss_language": "en"}], "synonyms": ["शेषं", "शेषः"], "synonyms_slp1": ["SezaM", "SezaH"]}, {"id": "SezA", "headword": "शेषा", "headword_slp1": "SezA", "fold": "sesa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेषा (आ), f. pl. the remains of flowers or other offerings made to an idol and afterwards distributed amongst the worshippers and attendants (sg. ‘a garden made of the remains of flowers’), MBh.; R. &c.", "gloss_language": "en"}]}], "sesyita": [{"id": "SeSyita", "headword": "शेश्यित", "headword_slp1": "SeSyita", "fold": "sesyita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेश्यित, ˚त-वत्. See √ 1. शी.", "gloss_language": "en"}]}], "sesviyamana": [{"id": "SeSvIyamAna", "headword": "शेश्वीयमान", "headword_slp1": "SeSvIyamAna", "fold": "sesviyamana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेश्वीयमान See √ श्वि.", "gloss_language": "en"}]}], "sesi": [{"id": "SezI", "headword": "शेषी", "headword_slp1": "SezI", "fold": "sesi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेषी (ई), f. N. of a woman, Cat.", "gloss_language": "en"}]}], "sesakamalakara": [{"id": "SezakamalAkara", "headword": "शेषकमलाकर", "headword_slp1": "SezakamalAkara", "fold": "sesakamalakara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—कमलाकर m. N. of an author, Cat.", "gloss_language": "en"}]}], "sesakaraRa": [{"id": "SezakaraRa", "headword": "शेषकरण", "headword_slp1": "SezakaraRa", "fold": "sesakaraRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—करण n. the leaving a remnant of (comp.), PārGṛ.", "gloss_language": "en"}, {"gloss": "the doing what remains to be done, MW.", "gloss_language": "en"}]}], "sesakarita": [{"id": "SezakArita", "headword": "शेषकारित", "headword_slp1": "SezakArita", "fold": "sesakarita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—कारित mfn. unfinished, undone, MBh.", "gloss_language": "en"}]}], "sesakala": [{"id": "SezakAla", "headword": "शेषकाल", "headword_slp1": "SezakAla", "fold": "sesakala", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—काल m. the time of end or death, W.", "gloss_language": "en"}], "synonyms": ["शेषकालः"], "synonyms_slp1": ["SezakAlaH"]}], "sesakfsRa": [{"id": "SezakfzRa", "headword": "शेषकृष्ण", "headword_slp1": "SezakfzRa", "fold": "sesakfsRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—कृष्ण m. (also with पण्डित) N. of various authors, Cat.", "gloss_language": "en"}]}], "sesakriya": [{"id": "SezakriyA", "headword": "शेषक्रिया", "headword_slp1": "SezakriyA", "fold": "sesakriya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—क्रिया f. the remainder of a ceremony, Baudh.", "gloss_language": "en"}]}], "sesagovinda": [{"id": "Sezagovinda", "headword": "शेषगोविन्द", "headword_slp1": "Sezagovinda", "fold": "sesagovinda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—गोविन्द m. (with पण्डित) N. of an astronomer, Cat.", "gloss_language": "en"}]}], "sesacakrapaRi": [{"id": "SezacakrapARi", "headword": "शेषचक्रपाणि", "headword_slp1": "SezacakrapARi", "fold": "sesacakrapaRi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—चक्रपाणि m. N. of a grammarian, ib.", "gloss_language": "en"}]}], "sesacintamaRi": [{"id": "SezacintAmaRi", "headword": "शेषचिन्तामणि", "headword_slp1": "SezacintAmaRi", "fold": "sesacintamaRi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—चिन्तामणि m. N. of a poem.", "gloss_language": "en"}]}], "sesajati": [{"id": "SezajAti", "headword": "शेषजाति", "headword_slp1": "SezajAti", "fold": "sesajati", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—जाति f. (in alg.) assimilation of residue, reduction of fractions of residues or successive fractional remainders, Līl.", "gloss_language": "en"}], "synonyms": ["शेषजातिः"], "synonyms_slp1": ["SezajAtiH"]}], "sesatas": [{"id": "Sezatas", "headword": "शेषतस्", "headword_slp1": "Sezatas", "fold": "sesatas", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—तस् ind. otherwise, else, R.", "gloss_language": "en"}]}], "sesata": [{"id": "SezatA", "headword": "शेषता", "headword_slp1": "SezatA", "fold": "sesata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—ता See आयुः- and लावण्य-शेषता.", "gloss_language": "en"}]}], "sesatva": [{"id": "Sezatva", "headword": "शेषत्व", "headword_slp1": "Sezatva", "fold": "sesatva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—त्व n. the state of being a remainder (एन, ‘by the remainder, in every other case’), Bhpr.; KātyŚr., Sch.", "gloss_language": "en"}, {"gloss": "all that is left, residue, MW.", "gloss_language": "en"}, {"gloss": "secondariness, Jaim.; Bādar.", "gloss_language": "en"}], "synonyms": ["शेषत्वं"], "synonyms_slp1": ["SezatvaM"]}], "sesatvavicara": [{"id": "SezatvavicAra", "headword": "शेषत्वविचार", "headword_slp1": "SezatvavicAra", "fold": "sesatvavicara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—त्व—विचार m. N. of a Vedānta wk.", "gloss_language": "en"}]}], "sesadeva": [{"id": "Sezadeva", "headword": "शेषदेव", "headword_slp1": "Sezadeva", "fold": "sesadeva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—देव m. the serpent Śeṣa (worshipped) as a god, Pañcar.", "gloss_language": "en"}]}], "sesaDarma": [{"id": "SezaDarma", "headword": "शेषधर्म", "headword_slp1": "SezaDarma", "fold": "sesaDarma", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—धर्म m. N. of a ch. of the Hari-vaṃśa.", "gloss_language": "en"}]}], "sesanaga": [{"id": "SezanAga", "headword": "शेषनाग", "headword_slp1": "SezanAga", "fold": "sesanaga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—नाग m. the serpent Śeṣa (see above)", "gloss_language": "en"}, {"gloss": "N. of the mythical author of the Paramārtha-sāra, Cat.", "gloss_language": "en"}]}], "sesanarayaRa": [{"id": "SezanArAyaRa", "headword": "शेषनारायण", "headword_slp1": "SezanArAyaRa", "fold": "sesanarayaRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—नारायण m. N. of the author of the Sūkti-ratnākara (a Comm. on the Mahā-bhāṣya; also with -पण्डित).", "gloss_language": "en"}]}], "sesapati": [{"id": "Sezapati", "headword": "शेषपति", "headword_slp1": "Sezapati", "fold": "sesapati", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—पति m. a superintendent, manager, L.", "gloss_language": "en"}], "synonyms": ["शेषपतिः"], "synonyms_slp1": ["SezapatiH"]}], "sesaBaga": [{"id": "SezaBAga", "headword": "शेषभाग", "headword_slp1": "SezaBAga", "fold": "sesaBaga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—भाग m. the rest or remaining part, W.", "gloss_language": "en"}], "synonyms": ["शेषभागः"], "synonyms_slp1": ["SezaBAgaH"]}], "sesaBava": [{"id": "SezaBAva", "headword": "शेषभाव", "headword_slp1": "SezaBAva", "fold": "sesaBava", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—भाव m. the being a remainder, KātyŚr.", "gloss_language": "en"}]}], "sesaBuj": [{"id": "SezaBuj", "headword": "शेषभुज्", "headword_slp1": "SezaBuj", "fold": "sesaBuj", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—भुज् mfn. one who eats leavings, Mn.; BhP.", "gloss_language": "en"}]}], "sesaButa": [{"id": "SezaBUta", "headword": "शेषभूत", "headword_slp1": "SezaBUta", "fold": "sesaButa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—भूत mfn. being left, remaining, ŚāṅkhŚr.", "gloss_language": "en"}, {"gloss": "being secondary or accidental, Jaim., Sch.", "gloss_language": "en"}, {"gloss": "(mc. for शेषा-भ्˚) being (i.e. ‘as if being, as it were’) a garland of flowers (cf. शेषा f.), Mṛcch. x, 44.", "gloss_language": "en"}]}], "sesaBusaRa": [{"id": "SezaBUzaRa", "headword": "शेषभूषण", "headword_slp1": "SezaBUzaRa", "fold": "sesaBusaRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—भूषण m. ‘having the serpent-demon Śeṣa for ornament’, N. of Viṣṇu, Cat.", "gloss_language": "en"}]}], "sesaBojana": [{"id": "SezaBojana", "headword": "शेषभोजन", "headword_slp1": "SezaBojana", "fold": "sesaBojana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शेष—भोजन n. the eating of leavings, eating the remnant of food (after feeding the family-guests &c.), W.", "gloss_language": "en"}