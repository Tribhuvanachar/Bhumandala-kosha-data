{"dru": [{"id": "dru", "headword": "द्रु", "headword_slp1": "dru", "fold": "dru", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. द्रु cl. 5. P. द्रुणोति, to hurt, injure, Dhātup. xxvii, 33 (pf. दुद्राव, Bhaṭṭ.);\nto repent;\nto go, Vop. (cf. 1. द्रू).", "gloss_language": "en"}, {"gloss": "2. द्रु cl. 1. P. (Dhātup. xxii, 47; ep. also Ā.) द्र॑वति, ˚ते, RV. &c. &c. (pf. दुद्राव, Br.; ˚द्रोथ, ˚द्रुम, Pāṇ. vii, 2, 13; ˚द्रुवुर्, MBh.; R. &c.; aor. अदुद्रुवत्, Br.; ˚द्रोत्, Subj. दुद्र॑वत्, RV.; fut. द्रोष्यति, Br.; inf. -द्रोतुम्, Śatr.; ind.p. द्रुत्वा॑ and -द्रुत्य, Br.)\nto run, hasten, flee, RV.; AV.; ŚBr.; MBh.; Kāv. &c.;\nto run up to (acc.), attack, assault, MBh.; R.;\nto become fluid, dissolve, melt, Pañc.; Vet.; BhP. :\nCaus. द्राव॑यति (ep. also ˚ते; द्रवयते See under द्रव॑)\nto cause to run, make flow, RV. viii, 4, 11;\nto make fluid, melt, vi, 4, 3;\nto drive away, put to flight, MBh. (Pass. द्राव्यते, vii, 3515), R.; MBh. :\nDesid. दुद्रूषति Gr.:\nDesid. of Caus. दुद्रावयिषति or दिद्˚, Pāṇ. vii, 4, 81 :\nIntens. दोद्रूयते or दोद्रोति Gr. (दोद्राव, TS.).", "gloss_language": "en"}, {"gloss": "द्रु [cf. 2. द्रा and द्रम्; Zd. dru, drvant.]", "gloss_language": "en"}, {"gloss": "3. द्रु mfn. running, going (cf. मित-, रघु-, शता.)", "gloss_language": "en"}, {"gloss": "द्रु f. going, motion, L.", "gloss_language": "en"}, {"gloss": "4. द्रु॑ m. n. (= 3. दारु) wood or any wooden implement (as a cup, an oar &c.), RV.; TBr.; Mn.", "gloss_language": "en"}, {"gloss": "द्रु॑ m. a tree or branch, HPariś. (cf. इन्द्र-, सु-, हरिद्-, हरि-).", "gloss_language": "en"}], "synonyms": ["द्रुः"], "synonyms_slp1": ["druH"]}, {"id": "drU", "headword": "द्रू", "headword_slp1": "drU", "fold": "dru", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. द्रू cl. 9. P. द्रूणाति, to hurl, throw, MaitrS. (v.l. द्रुण्˚);\n cl. 5. P. द्रूणोति, to kill or to go, Dhātup. xxvii, 33 (v.l.)", "gloss_language": "en"}, {"gloss": "2. द्रू mfn. taking any shape at will, L.", "gloss_language": "en"}, {"gloss": "द्रू f. (?) gold, Uṇ. ii, 57.", "gloss_language": "en"}]}], "druta": [{"id": "druta", "headword": "द्रुत", "headword_slp1": "druta", "fold": "druta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "द्रुत mfn. quick, speedy, swift, MBh.; R.", "gloss_language": "en"}, {"gloss": "quickly or indistinctly spoken, Gīt.", "gloss_language": "en"}, {"gloss": "flown, run away or asunder, Kāv.; Pur.", "gloss_language": "en"}, {"gloss": "dissolved, melted, fluid, Kāv.", "gloss_language": "en"}, {"gloss": "द्रुत m. a scorpion, L.", "gloss_language": "en"}, {"gloss": "a tree (cf. द्रुण and द्रुम), L.", "gloss_language": "en"}, {"gloss": "द्रुत n. a partic. faulty pronunciation of vowels, Pat.", "gloss_language": "en"}], "synonyms": ["द्रुतं", "द्रुतः"], "synonyms_slp1": ["drutaM", "drutaH"]}], "drutam": [{"id": "drutam", "headword": "द्रुतम्", "headword_slp1": "drutam", "fold": "drutam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "द्रुतम् ind. quickly, rapidly, without delay, Mn.; MBh. &c.", "gloss_language": "en"}]}], "drutagati": [{"id": "drutagati", "headword": "द्रुतगति", "headword_slp1": "drutagati", "fold": "drutagati", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "द्रुत—गति mfn. going quickly, hastening, Daś.", "gloss_language": "en"}]}], "drutacOrya": [{"id": "drutacOrya", "headword": "द्रुतचौर्य", "headword_slp1": "drutacOrya", "fold": "drutacOrya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "द्रुत—चौर्य n. a theft rapidly committed, Deśīn.", "gloss_language": "en"}]}], "drutatara": [{"id": "drutatara", "headword": "द्रुततर", "headword_slp1": "drutatara", "fold": "drutatara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "द्रुत—तर mfn. (compar.) quicker, swifter (-गति mfn. quicker in motion, Megh.)", "gloss_language": "en"}]}], "drutataram": [{"id": "drutataram", "headword": "द