{"heti": [{"id": "heti", "headword": "हेति", "headword_slp1": "heti", "fold": "heti", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेति॑ &c. See p. 1303, col. 3.", "gloss_language": "en"}, {"gloss": "हेति॑ f. (fr. √ 1. हि; in later language also m.) a missile weapon, any weapon (also personified), RV. &c. &c.", "gloss_language": "en"}, {"gloss": "stroke, wound, Sāy.", "gloss_language": "en"}, {"gloss": "Agni's weapon, flame, light, MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "a ray of the sun, L.", "gloss_language": "en"}, {"gloss": "rapid motion, shot, impact (of a bow-string), RV.", "gloss_language": "en"}, {"gloss": "an implement, instrument, BhP.", "gloss_language": "en"}, {"gloss": "a young shoot or sprout, L.", "gloss_language": "en"}, {"gloss": "हेति॑ m. N. of the first Rākṣasa king (represented as occupying the Sun's chariot in the month Caitra or Madhu), R.", "gloss_language": "en"}, {"gloss": "of an Asura, BhP.", "gloss_language": "en"}], "synonyms": ["हेतिः"], "synonyms_slp1": ["hetiH"]}], "hetu": [{"id": "hetu", "headword": "हेतु", "headword_slp1": "hetu", "fold": "hetu", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु॑ &c. See p. 1303, col. 3.", "gloss_language": "en"}, {"gloss": "हेतु॑ m. ‘impulse’, motive, cause, cause of, reason for (loc., rarely dat. or gen.;\nहेतुना, हेतोः, हेतवे, हेतौ, ‘for a cause or reason’, ‘by reason of’, ‘on account of’ [with gen. or comp., e.g. मम हेतोः or मद्-धेतोः, ‘on account of me’];\nकं हेतुम् or को हेतुः, ‘wherefore?’ ‘why?’, Pāṇ. ii, 2, 23;\nPat.;\nयतो हेतोः, ‘because’;\nअनेन हेतुना or इति हेतोः, ‘for this reason’;\nमृत्यु-हेतवे, ‘in order to kill’;\nहेतुर् अलौकिकः, ‘a supernatural cause’;\nifc. हेतु also = ‘having as a cause or motive’, ‘caused or effected or actuated or attracted or impelled by’ e.g. कर्म-हेतु, ‘caused by the acts [of a former existence]’, Mn. i, 49;\nमांस-हेतु, ‘attracted by [the smell of] flesh’, MBh. x, 496;\nकर्म-फल-हेतु, ‘impelled by [the expectation of] the consequences of any act’, BhP. ii, 47; 49), RV. &c. &c.", "gloss_language": "en"}, {"gloss": "a logical reason or deduction or argument, the reason for an inference (esp. applied to the second member or Avayava of the five-membered syllogism See न्याय), Nyāyad.; IW. 61", "gloss_language": "en"}, {"gloss": "logic (in general See हेतुविद्या)", "gloss_language": "en"}, {"gloss": "(in gram.) the agent of the causal verb, Pāṇ. i, 4, 55 &c.", "gloss_language": "en"}, {"gloss": "(with Buddhists) primary cause (as opp. to प्रत्यय, q.v.), Sarvad.", "gloss_language": "en"}, {"gloss": "(with Paśu-patis) that which causes the bondage of the soul i.e. the external world and the senses, ib.", "gloss_language": "en"}, {"gloss": "a means (हेतुभिः ifc. ‘by means of’), MBh.", "gloss_language": "en"}, {"gloss": "mode, manner (हेतुभिः ifc. ‘according to’), ib.; Suśr.; Yājñ.", "gloss_language": "en"}, {"gloss": "price, cost, Rājat. v, 71", "gloss_language": "en"}, {"gloss": "condition, MBh.", "gloss_language": "en"}, {"gloss": "(in rhet.) = काव्य-लिङ्ग (q.v.), Bhar.; Kpr.; Sāh.", "gloss_language": "en"}], "synonyms": ["हेतुः"], "synonyms_slp1": ["hetuH"]}], "hetimat": [{"id": "hetimat", "headword": "हेतिमत्", "headword_slp1": "hetimat", "fold": "hetimat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेति—म॑त् mfn. armed with missiles, possessed of weapons, AV.", "gloss_language": "en"}, {"gloss": "illuminated by the sun, BhP.", "gloss_language": "en"}], "synonyms": ["हेतिमन्त्"], "synonyms_slp1": ["hetimant"]}], "hetimantra": [{"id": "hetimantra", "headword": "हेतिमन्त्र", "headword_slp1": "hetimantra", "fold": "hetimantra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेति—मन्त्र m. N. of a Mantra, Cat.", "gloss_language": "en"}]}], "hetika": [{"id": "hetika", "headword": "हेतिक", "headword_slp1": "hetika", "fold": "hetika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतिक (ifc.) = हेति (cf. शक्ति-, स्वधिति-ह्˚).", "gloss_language": "en"}]}], "hetuta": [{"id": "hetutA", "headword": "हेतुता", "headword_slp1": "hetutA", "fold": "hetuta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—ता f.", "gloss_language": "en"}]}], "hetutva": [{"id": "hetutva", "headword": "हेतुत्व", "headword_slp1": "hetutva", "fold": "hetutva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—त्व n. the state of being a हेतु, causation, causativeness, existence of cause or motive, Kāv.; Kathās.; Sarvad.", "gloss_language": "en"}], "synonyms": ["हेतुत्वं"], "synonyms_slp1": ["hetutvaM"]}], "hetutvaKaRqana": [{"id": "hetutvaKaRqana", "headword": "हेतुत्वखण्डन", "headword_slp1": "hetutvaKaRqana", "fold": "hetutvaKaRqana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—त्व—खण्डन n. N. of wk.", "gloss_language": "en"}]}], "hetuduswa": [{"id": "hetuduzwa", "headword": "हेतुदुष्ट", "headword_slp1": "hetuduzwa", "fold": "hetuduswa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—दुष्ट mfn. inconvincible by reasons, unreasonable (said of persons), MBh.", "gloss_language": "en"}]}], "hetudfswi": [{"id": "hetudfzwi", "headword": "हेतुदृष्टि", "headword_slp1": "hetudfzwi", "fold": "hetudfswi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—दृष्टि f. examination of reasons, scepticism, Lalit.", "gloss_language": "en"}], "synonyms": ["हेतुदृष्टिः"], "synonyms_slp1": ["hetudfzwiH"]}], "hetubalika": [{"id": "hetubalika", "headword": "हेतुबलिक", "headword_slp1": "hetubalika", "fold": "hetubalika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—बलिक mfn. strong in argument, Sukh. i.", "gloss_language": "en"}]}], "hetumat": [{"id": "hetumat", "headword": "हेतुमत्", "headword_slp1": "hetumat", "fold": "hetumat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "हेतु—मत् mfn. hav