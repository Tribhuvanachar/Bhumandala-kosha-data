{"gotama": [{"id": "gotama", "headword": "गोतम", "headword_slp1": "gotama", "fold": "gotama", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गो॑—तम (गो॑-), m. (superl.) N. of a Ṛṣi belonging to the family of Aṅgiras with the patr. Rāhū-gaṇa (author of RV. i, 74-93), RV.; AV.; ŚBr. i, xi, xiv; ṢaḍvBr. &c.", "gloss_language": "en"}, {"gloss": "(for गौत्˚) N. of the chief disciple of Mahā-vīra", "gloss_language": "en"}, {"gloss": "of a lawyer (cf. गौतम॑)", "gloss_language": "en"}, {"gloss": "of the founder of the Nyāya phil.", "gloss_language": "en"}, {"gloss": "‘the largest ox’ and ‘N. of the founder of Nyāya phil.’, Naiṣ. xvii, 75", "gloss_language": "en"}, {"gloss": "N. of a son of Karṇika, Buddh.", "gloss_language": "en"}, {"gloss": "? MBh. xiii, 4490 (cf. -दम)", "gloss_language": "en"}, {"gloss": "m. pl. (Pāṇ. ii, 4, 65) the descendants of the Ṛṣi Gotama, RV.; ĀśvŚr. xii, 10; Lāṭy.", "gloss_language": "en"}, {"gloss": "गो॑—तम n. a kind of poison, Gal.", "gloss_language": "en"}, {"gloss": "गो॑-तम &c. See गो॑, p. 364, col. 2.", "gloss_language": "en"}], "synonyms": ["गोतमः"], "synonyms_slp1": ["gotamaH"]}], "gotami": [{"id": "gotamI", "headword": "गोतमी", "headword_slp1": "gotamI", "fold": "gotami", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गो॑—तमी f. v.l. for गौत्˚ in g. गौरादि", "gloss_language": "en"}]}], "gotamagOra": [{"id": "gotamagOra", "headword": "गोतमगौर", "headword_slp1": "gotamagOra", "fold": "gotamagOra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गो—तम—गौर m. = गौर-गोतम, the white Gotama, Gaṇar. 89, Sch.", "gloss_language": "en"}]}], "gotamapfcCa": [{"id": "gotamapfcCA", "headword": "गोतमपृच्छा", "headword_slp1": "gotamapfcCA", "fold": "gotamapfcCa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गो—तम—पृच्छा f. ‘questions of (Mahā-vīra's pupil) Gotama (put forth in a discussion with Pārśva's pupil Keśin)’, N. of a Jain work", "gloss_languag