{"BaNga": [{"id": "BaNga", "headword": "भङ्ग", "headword_slp1": "BaNga", "fold": "BaNga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "भङ्ग॑ &c. See p. 744, col. 3.", "gloss_language": "en"}, {"gloss": "भङ्ग॑ mfn. breaking, bursting (said of the Soma), RV. ix, 61, 13", "gloss_language": "en"}, {"gloss": "भङ्ग॑ m. breaking, splitting, dividing, shattering, breaking down or up, VS. &c. &c.", "gloss_language": "en"}, {"gloss": "a break or breach (lit. and fig.), disturbance, interruption, frustration, humiliation, abatement, downfall, decay, ruin, destruction, Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "fracture (see अस्थि-भ्˚)", "gloss_language": "en"}, {"gloss": "paralysis, palsy, L.", "gloss_language": "en"}, {"gloss": "bending, bowing, stretching out (see कर्ण-, गात्र-, -ग्रीवा-भ्˚)", "gloss_language": "en"}, {"gloss": "knitting, contraction (see भ्रू-भ्˚)", "gloss_language": "en"}, {"gloss": "separation, analysis (of words), Sāh.", "gloss_language": "en"}, {"gloss": "overthrow, rout, defeat (also in a lawsuit), Hit.; Kām.; Yājñ., Sch.", "gloss_language": "en"}, {"gloss": "rejection, refusal, Kālid.", "gloss_language": "en"}, {"gloss": "refutation, Sarvad.", "gloss_language": "en"}, {"gloss": "panic, fear, Rājat.", "gloss_language": "en"}, {"gloss": "pain (see पार्श्व-भ्˚)", "gloss_language": "en"}, {"gloss": "a piece broken off, morsel, fragment, Kālid.; Kād.", "gloss_language": "en"}, {"gloss": "a bend, fold, Sah. (cf. वस्त्र-भ्˚); a wave, Ragh.; Gīt.", "gloss_language": "en"}, {"gloss": "भङ्ग [cf. Lith. bangà]", "gloss_language": "en"}, {"gloss": "a water-course, channel, L.", "gloss_language": "en"}, {"gloss": "fraud, deceit, L.", "gloss_language": "en"}, {"gloss": "a tortuous course, roundabout way of speaking (= or w.r. for भङ्गि), Sarvad.", "gloss_language": "en"}, {"gloss": "toilet, fashion (for भङ्गि?), Var.", "gloss_language": "en"}, {"gloss": "= गमन, L.", "gloss_language": "en"}, {"gloss": "N. of a serpent-demon, MBh."