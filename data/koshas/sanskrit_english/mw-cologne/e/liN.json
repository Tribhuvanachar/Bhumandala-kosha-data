{"liN": [{"id": "liN", "headword": "लिङ्", "headword_slp1": "liN", "fold": "liN", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ् (in gram.) N. of the terminations of the Potential and Precative Moods or N. of those Moods themselves (the Precative being usually distinguished by the fuller term लिङ् आशिषि, or आशिर्-लिन्; cf. under 1. ल).", "gloss_language": "en"}]}], "liNarTavada": [{"id": "liNarTavAda", "headword": "लिङर्थवाद", "headword_slp1": "liNarTavAda", "fold": "liNarTavada", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्—अर्थ-वाद and लिङ्—अर्थ-विचार, m. ‘explanation of the sense of Liṅ’, N. of grammatical treatises.", "gloss_language": "en"}]}], "liNarTavicara": [{"id": "liNarTavicAra", "headword": "लिङर्थविचार", "headword_slp1": "liNarTavicAra", "fold": "liNarTavicara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्—अर्थ-वाद and लिङ्—अर्थ-विचार, m. ‘explanation of the sense of Liṅ’, N. of grammatical treatises.", "gloss_language": "en"}]}], "liNkavarahatirTa": [{"id": "liNkavArAhatIrTa", "headword": "लिङ्कवाराहतीर्थ", "headword_slp1": "liNkavArAhatIrTa", "fold": "liNkavarahatirTa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्क-वाराह-तीर्थ n. N. of a Tīrtha, Cat.", "gloss_language": "en"}]}], "liNK": [{"id": "liNK", "headword": "लिङ्ख्", "headword_slp1": "liNK", "fold": "liNK", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्ख् (cf. √ लख्, लङ्ख्) cl. 1. P. लिङ्खति, to go, move, Dhātup. v, 34.", "gloss_language": "en"}], "synonyms": ["लिंख्"], "synonyms_slp1": ["liMK"]}], "liNg": [{"id": "liNg", "headword": "लिङ्ग्", "headword_slp1": "liNg", "fold": "liNg", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्ग् (cf. आ-√ लिङ्ग्) cl. 1. P. लिङ्गति, to go, Dhātup. v, 48;\n cl. 10. P. लिङ्गयति, to paint, variegate (चित्री-करणे), ib. xxxiii, 65;\nto change or inflect a noun according to its gender, Vop., Sch.", "gloss_language": "en"}], "synonyms": ["लिंग्"], "synonyms_slp1": ["liMg"]}], "liNga": [{"id": "liNga", "headword": "लिङ्ग", "headword_slp1": "liNga", "fold": "liNga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्ग n. (once m. in NṛsUp.; ifc. f(आ). , f(ई). only in विष्णु-लिङ्गी; prob. fr. √ लग्; cf. लक्ष, लक्षण) a mark, spot, sign, token, badge, emblem, characteristic (ifc. = तल्-लिङ्ग, ‘having anything for a mark or sign’), Up.; MBh. &c.", "gloss_language": "en"}, {"gloss": "any assumed or false badge or mark, guise, disguise, MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "a proof, evidence, Kaṇ.; KātyŚr.; Sarvad.", "gloss_language": "en"}, {"gloss": "a sign of guilt, corpus delicti, Yājñ., Sch.", "gloss_language": "en"}, {"gloss": "the sign of gender or sex, organ of generation, Mn.; Hariv.; Pur. &c.", "gloss_language": "en"}, {"gloss": "the male organ or Phallus (esp. that of Śiva worshipped in the form of a stone or marble column which generally rises out of a योनि, q.v., and is set up in temples dedicated to Śiva; formerly 12 principal Śiva-liṅgas existed, of which the best known are Soma-nātha in Gujarāt, Mahā-kāla at Ujjayinī, Viśveśvara at Benares &c.; but the number of Liṅgas in India is estimated at 30 millions, IW. 322 n.; RTL. 78, 1; 90), MBh.; R. &c.", "gloss_language": "en"}, {"gloss": "gender (in gram.; cf. पुं-ल्˚), Prāt.; Pāṇ.", "gloss_language": "en"}, {"gloss": "the image of a god, an idol, VarBṛS.", "gloss_language": "en"}, {"gloss": "(in logic) = व्याप्य, the invariable mark which proves the existence of anything in an object (as in the proposition ‘there is fire because there is smoke’, smoke is the लिङ्ग; cf. IW. 62)", "gloss_language": "en"}, {"gloss": "inference, conclusion, reason (cf. काव्य-ल्˚)", "gloss_language": "en"}, {"gloss": "= लिङ्गशरीर (in Vedānta)", "gloss_language": "en"}, {"gloss": "anything having an origin and therefore liable to be destroyed again, Kap.", "gloss_language": "en"}, {"gloss": "= आकाश, Kāraṇḍ.", "gloss_language": "en"}, {"gloss": "(in Sāṃkhya) = प्रकृति or प्रधान, ‘the eternal procreative germ’, L.", "gloss_language": "en"}, {"gloss": "= व्यक्त, L.", "gloss_language": "en"}, {"gloss": "cf. RTL. 30", "gloss_language": "en"}, {"gloss": "= प्रातिपदिक, the crude base or uninflected stem of a noun (shortened into लि), Vop., Sch.", "gloss_language": "en"}, {"gloss": "(in rhet.) an indication (word that serves to fix the meaning of another word; e.g. in the passage कुपितो मकर-ध्वजः the word कुपित restricts the meaning of मकर-ध्वज to ‘Kāma’) = लिङ्ग-पुराण, BhP.", "gloss_language": "en"}, {"gloss": "the order of the religious student, W.", "gloss_language": "en"}, {"gloss": "a symptom, mark of disease, W.", "gloss_language": "en"}], "synonyms": ["लिंग", "लिंगं", "लिङ्गं"], "synonyms_slp1": ["liMga", "liMgaM", "liNgaM"]}], "liNgakaraRavada": [{"id": "liNgakAraRavAda", "headword": "लिङ्गकारणवाद", "headword_slp1": "liNgakAraRavAda", "fold": "liNgakaraRavada", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्ग—कारण-वाद m. N. of wk.", "gloss_language": "en"}]}], "liNgakaraRatapurvapaksarahasya": [{"id": "liNgakAraRatApUrvapakzarahasya", "headword": "लिङ्गकारणतापूर्वपक्षरहस्य", "headword_slp1": "liNgakAraRatApUrvapakzarahasya", "fold": "liNgakaraRatapurvapaksarahasya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्ग—कार˚ण-ता-पूर्व-पक्ष-रहस्य n. N. of wk.", "gloss_language": "en"}]}], "liNgakaraRatavada": [{"id": "liNgakAraRatAvAda", "headword": "लिङ्गकारणतावाद", "headword_slp1": "liNgakAraRatAvAda", "fold": "liNgakaraRatavada", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लिङ्ग—कार˚ण-ता-वाद m. N. of wk.", "gloss_language": "en"}]}], "liNgakaraRatasidDantarahasya": [{"id": "liNgakAraRatAsidDAntarahasya", "headword": "लिङ्गकारणतासिद्धान्तरहस्य", "headword_slp1": "liNgakAraRatAsidDAntarahasya", "fold": "liNgakaraRatasidDantarahasya", "headword_l