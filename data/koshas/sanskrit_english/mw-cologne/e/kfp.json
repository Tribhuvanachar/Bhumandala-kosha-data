{"kfp": [{"id": "kfp", "headword": "कृप्", "headword_slp1": "kfp", "fold": "kfp", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. कृ॑प् f. (only instr. कृपा॑) beautiful appearance, beauty, splendour, RV.; VS. iv, 25.", "gloss_language": "en"}, {"gloss": "2. कृप् cl. 6. Ā. कृपते (impf. अकृ-पन्त; aor. 3. pl. अकृप्रन् and चकृप॑न्त, 3. sg. अक्रपिष्ट; pr. p. कृ॑पमाण),\nto mourn, long for (acc.), RV.;\nto lament, implore, RV.; AV. v, 19, 3 :\ncl. 10. P. कृपयति (impf. अकृपयत्; p. कृप॑यत् gen. sg. m. कृपयत॑स्, RV. viii, 46, 16),\nto mourn, grieve, lament (with acc.), RV.;\nto pity, BhP. viii, 7, 40;\nto be weak, Dhātup. xxxv, 17 (cf. कृपाय and √ क्रप्.)", "gloss_language": "en"}]}], "kfpaniLa": [{"id": "kfpanILa", "headword": "कृपनीळ", "headword_slp1": "kfpanILa", "fold": "kfpaniLa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृप॑-नीळ mfn. (for कृपा॑-न्˚) one whose home is splendour, dwelling in splendour (N. of Agni), RV. x, 20, 3 [‘the support of sacred rites’, Sāy.]", "gloss_language": "en"}, {"gloss": "कृप—नीळ , see s.v. 1. कृ॑प्.", "gloss_language": "en"}, {"gloss": "कृप॑-नीळ See 1. कृ॑प्.", "gloss_language": "en"}]}], "kfpanila": [{"id": "kfpAnIla", "headword": "कृपानील", "headword_slp1": "kfpAnIla", "fold": "kfpanila", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपा-नील m. N. of a man, Saṃskārak.", "gloss_language": "en"}, {"gloss": "कृपा-नील See s.v. 1. कृ॑प्.", "gloss_language": "en"}, {"gloss": "कृपा-नील See 1. कृ॑प्.", "gloss_language": "en"}]}], "kfpa": [{"id": "kfpa", "headword": "कृप", "headword_slp1": "kfpa", "fold": "kfpa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृ॑प m. N. of a man (described as a friend of Indra), RV. viii, 3, 12 and 4, 2", "gloss_language": "en"}, {"gloss": "कृ॑प mf(ई). N. of the son and daughter of the sage Śaradvat (who performed severe penance;\nthe jealous Indra therefore sent a nymph to tempt him, but without success;\nhowever, twin sons were born to the sage in a clump of grass [शर-स्तम्बे], who were found by king Śāntanu and out of pity [कृपा] taken home and reared;\nthe daughter, Kṛpī, married Droṇa, and had by him a son called Aśvatthāman;\nthe son, Kṛpa, became one of the council at Hastināpura, and is sometimes called Gautama, sometimes Śāradvata;\naccording to Hariv. & VP., Kṛpa and Kṛpī were only distant descendants of Śaradvat;\naccording to others, Kṛpa = Vyāsa or = a son of Kṛṣṇa), MBh. &c.", "gloss_language": "en"}], "synonyms": ["कृपः"], "synonyms_slp1": ["kfpaH"]}, {"id": "kfpA", "headword": "कृपा", "headword_slp1": "kfpA", "fold": "kfpa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपा (आ॑), f., see s.v. below.", "gloss_language": "en"}, {"gloss": "कृपा f. (g. भिदादि) pity, tenderness, compassion (with gen. or loc.; कृपां-√ कृ, to pity [with loc.] Nal. xvii; R.), MBh. &c.", "gloss_language": "en"}, {"gloss": "N. of a river (v.l. रूपा), VP.", "gloss_language": "en"}]}], "kfpacarya": [{"id": "kfpAcArya", "headword": "कृपाचार्य", "headword_slp1": "kfpAcArya", "fold": "kfpacarya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपाचार्य m. N. of Gautama, Gal.", "gloss_language": "en"}]}], "kfpaRa": [{"id": "kfpaRa", "headword": "कृपण", "headword_slp1": "kfpaRa", "fold": "kfpaRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. कृपण॑ mf(आ॑; ई, g. बह्व्-आदि)n. (gaṇas श्रेण्यादि and सुखादि, Pāṇ. viii, 2, 18; Pat.) inclined to grieve, pitiable, miserable, poor, wretched, feeble, ŚBr. xi, xiv; MBh. &c.", "gloss_language": "en"}, {"gloss": "resulting from tears, AV. xi, 8, 28", "gloss_language": "en"}, {"gloss": "low, vile, W.", "gloss_language": "en"}, {"gloss": "miserly, stingy, Pañcat.; Hit.", "gloss_language": "en"}, {"gloss": "कृपण॑ (अस्), m. a poor man, VarBṛS.", "gloss_language": "en"}, {"gloss": "a scraper, niggard, Pañcat.; ŚārṅgP.", "gloss_language": "en"}, {"gloss": "a worm, L.", "gloss_language": "en"}, {"gloss": "N. of a man, VP.", "gloss_language": "en"}, {"gloss": "कृप॑ण (कृप॑णम्), n. wretchedness, misery, RV. x, 99, 9; AitBr. vii, 13; ŚāṅkhŚr.; Mn. iv, 185 &c.", "gloss_language": "en"}, {"gloss": "कृप॑ण m. (स-कृपणम्, ‘miserably, pitiably’), Śāntiś. (cf. कार्पण्य.)", "gloss_language": "en"}, {"gloss": "2. कृपण Nom. Ā. (3. pl. कृप॑णन्त) to long for, desire, RV. x, 74, 3.", "gloss_language": "en"}], "synonyms": ["कृपणः"], "synonyms_slp1": ["kfpaRaH"]}, {"id": "kfpARa", "headword": "कृपाण", "headword_slp1": "kfpARa", "fold": "kfpaRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपाण m. (Pāṇ. vii, 2, 18; Pat.) a sword, Daś.; Prab.", "gloss_language": "en"}, {"gloss": "a sacrificial knife, W.", "gloss_language": "en"}], "synonyms": ["कृपाणः"], "synonyms_slp1": ["kfpARaH"]}], "kfpaRam": [{"id": "kfpaRam", "headword": "कृपणम्", "headword_slp1": "kfpaRam", "fold": "kfpaRam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण॑म् (अम्), ind. miserably, pitiably, MBh.; Pañcat.; Daś.", "gloss_language": "en"}]}], "kfpaRakasin": [{"id": "kfpaRakASin", "headword": "कृपणकाशिन्", "headword_slp1": "kfpaRakASin", "fold": "kfpaRakasin", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—काशि॑न् mfn. looking suppliantly or desirous, TS. iii, 4, 7, 3.", "gloss_language": "en"}]}], "kfpaRatva": [{"id": "kfpaRatva", "headword": "कृपणत्व", "headword_slp1": "kfpaRatva", "fold": "kfpaRatva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—त्व n. misery, wretchedness, MBh. ii, 1361.", "gloss_language": "en"}]}], "kfpaRaDi": [{"id": "kfpaRaDI", "headword": "कृपणधी", "headword_slp1": "kfpaRaDI", "fold": "kfpaRaDi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—धी mfn. little-minded, W.", "gloss_language": "en"}]}], "kfpaRaninda": [{"id": "kfpaRanindA", "headword": "कृपणनिन्दा", "headword_slp1": "kfpaRanindA", "fold": "kfpaRaninda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—निन्दा f. ‘censure of the miser’, N. of a chapter of ŚārṅgP.", "gloss_language": "en"}]}], "kfpaRabudDi": [{"id": "kfpaRabudDi", "headword": "कृपणबुद्धि", "headword_slp1": "kfpaRabudDi", "fold": "kfpaRabudDi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—बुद्धि mfn. = -धी, W.", "gloss_language": "en"}]}], "kfpaRavatsala": [{"id": "kfpaRavatsala", "headword": "कृपणवत्सल", "headword_slp1": "kfpaRavatsala", "fold": "kfpaRavatsala", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—वत्सल mfn. kind to the poor, W.", "gloss_language": "en"}]}], "kfpaRavarRa": [{"id": "kfpaRavarRa", "headword": "कृपणवर्ण", "headword_slp1": "kfpaRavarRa", "fold": "kfpaRavarRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण—वर्ण mfn. looking miserably, Daś.", "gloss_language": "en"}]}], "kfpaRaya": [{"id": "kfpaRAya", "headword": "कृपणाय", "headword_slp1": "kfpaRAya", "fold": "kfpaRaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपणाय Nom. Ā. ˚यते, to lament g. सुखादि.", "gloss_language": "en"}]}], "kfpaRin": [{"id": "kfpaRin", "headword": "कृपणिन्", "headword_slp1": "kfpaRin", "fold": "kfpaRin", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपणिन् mfn. miserable, being in misery, ib.", "gloss_language": "en"}]}], "kfpaRya": [{"id": "kfpaRya", "headword": "कृपण्य", "headword_slp1": "kfpaRya", "fold": "kfpaRya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण्य Nom. P. ˚य॑ति, to wish, desire, pray for, RV. viii, 39, 4;\n = √ अर्च्, Naigh. iii, 14.", "gloss_language": "en"}]}], "kfpaRyu": [{"id": "kfpaRyu", "headword": "कृपण्यु", "headword_slp1": "kfpaRyu", "fold": "kfpaRyu", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपण्यु॑ mfn. ‘one who praises’ (= स्तोतृ), Naigh. iii, 16.", "gloss_language": "en"}]}], "kfpaya": [{"id": "kfpaya", "headword": "कृपय", "headword_slp1": "kfpaya", "fold": "kfpaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपय Nom. P. p. ˚य॑त्, only gen. sg. (m.) ˚यत॑स् See s.v. √ 2. कृप्.", "gloss_language": "en"}]}, {"id": "kfpAya", "headword": "कृपाय", "headword_slp1": "kfpAya", "fold": "kfpaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपाय Nom. Ā. ˚यते (Pot. ˚यीत), to mourn, grieve, lament, Nir. ii, 12;\n to have pity, MBh. : P. ˚य॑ति, to praise (cf. कृपण्यु॑), Naigh. iii, 14.", "gloss_language": "en"}]}], "kfpakara": [{"id": "kfpAkara", "headword": "कृपाकर", "headword_slp1": "kfpAkara", "fold": "kfpakara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपाकर m. ‘a mine of compassion’, extremely compassionate, Hcat.", "gloss_language": "en"}], "synonyms": ["कृपाकरः"], "synonyms_slp1": ["kfpAkaraH"]}], "kfpatman": [{"id": "kfpAtman", "headword": "कृपात्मन्", "headword_slp1": "kfpAtman", "fold": "kfpatman", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपात्मन् mfn. tender-hearted, Bcar.", "gloss_language": "en"}]}], "kfpadfswi": [{"id": "kfpAdfzwi", "headword": "कृपादृष्टि", "headword_slp1": "kfpAdfzwi", "fold": "kfpadfswi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपा-दृष्टि f. a look with favour, kind look, W.", "gloss_language": "en"}], "synonyms": ["कृपादृष्टिः"], "synonyms_slp1": ["kfpAdfzwiH"]}], "kfpadvEta": [{"id": "kfpAdvEta", "headword": "कृपाद्वैत", "headword_slp1": "kfpAdvEta", "fold": "kfpadvEta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "कृपाद्वैत m. ‘unrivalled in compassion’, N. of a Buddha, L.", "gloss_language": "en"}], "synonyms": ["कृपाद्वैतः"], "synonyms_slp1": ["kfpAdvEtaH"]}], "kfpanvita": [{"id": "kfpAnvita", "headword": "कृपान्वित", "headword_slp1": "kfpAnvita", "fold": "kfpanvita", "headword_language": "sa", "source": "mw-cologne"