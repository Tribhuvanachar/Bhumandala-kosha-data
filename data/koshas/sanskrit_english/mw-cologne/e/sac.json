", "source": "mw-cologne", "senses": [{"gloss": "सच॑थ m. companionship, assistance, RV.", "gloss_language": "en"}]}], "sacaTya": [{"id": "sacaTya", "headword": "सचथ्य", "headword_slp1": "sacaTya", "fold": "sacaTya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सचथ्य᳙ mfn. helpful, kind, RV.", "gloss_language": "en"}, {"gloss": "सचथ्य᳙ n. assistance, help, ib.", "gloss_language": "en"}]}], "sacaDyE": [{"id": "sacaDyE", "headword": "सचध्यै", "headword_slp1": "sacaDyE", "fold": "sacaDyE", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सच॑ध्यै See √ सच्.", "gloss_language": "en"}]}], "sacana": [{"id": "sacana", "headword": "सचन", "headword_slp1": "sacana", "fold": "sacana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सचन॑ mfn. ready to befriend or help, kindly disposed, doing kind offices (also ˚ना-वत्), RV.", "gloss_language": "en"}], "synonyms": ["सचनं"], "synonyms_slp1": ["sacanaM"]}], "sacanas": [{"id": "sacanas", "headword": "सचनस्", "headword_slp1": "sacanas", "fold": "sacanas", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स॑चनस् See स॑-चनस् below.", "gloss_language": "en"}, {"gloss": "स॑—चनस् (स॑-), mfn. being in harmony with, RV. i, 127, 11", "gloss_language": "en"}]}], "sacaniya": [{"id": "sacanIya", "headword": "सचनीय", "headword_slp1": "sacanIya", "fold": "sacaniya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सचनीय mfn. to be followed or honoured or served, MW.", "gloss_language": "en"}]}], "sacasya": [{"id": "sacasya", "headword": "सचस्य", "headword_slp1": "sacasya", "fold": "sacasya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सचस्य Nom. Ā. ˚स्य॑ते, to receive assistance or care, RV.", "gloss_language": "en"}]}], "sacaBu": [{"id": "sacABU", "headword": "सचाभू", "headword_slp1": "sacABU", "fold": "sacaBu", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सचा—भू॑ m. a