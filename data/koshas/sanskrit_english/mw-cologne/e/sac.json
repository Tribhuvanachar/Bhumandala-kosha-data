{"sac": [{"id": "Sac", "headword": "शच्", "headword_slp1": "Sac", "fold": "sac", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शच् cl. 1. Ā. शचते, to be strong &c. (in this sense a collateral form of √ शक्);\nto speak out, speak, say, tell, Dhātup. vi, 4.", "gloss_language": "en"}]}, {"id": "zac", "headword": "षच्", "headword_slp1": "zac", "fold": "sac", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "षग्, षघ्, षच् &c. See √ सग् &c.", "gloss_language": "en"}]}, {"id": "sac", "headword": "सच्", "headword_slp1": "sac", "fold": "sac", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. सच् (connected with √ 2. सज्ज्, सञ्ज्, सख्; cf. √ सप्) cl. 1. Ā. (Dhātup. vi, 2) स॑चते (in RV. also P. सचति and सि॑षक्ति, 2. sg. स॑श्चसि, 3. pl. सश्चति, 2. 3. pl. सश्चत, 1. sg. Ā. सश्चे; p. स॑चमान, सचान॑ and स॑श्चत् or सश्च॑त् [q.v.]; pf. Ved. सश्चिम, सश्चुः॑; Ā. सश्चिरे॑, RV.; सेचिरे, AV.; aor. 3. pl. असक्षत, RV.; सक्षत्, सक्षत, सक्षन्ते, सक्षीम॑हि, ib.; असचिष्ट Gr.; fut. सचिता, सचिष्यते, ib.; inf. सच॑ध्यै, RV.),\nto be associated or united with, have to do with, be familiar with, associate one's self with (instr.), RV.; AV.;\n be possessed of, enjoy (instr. or acc.), ib.;\nto take part or participate in, suffer, endure (instr.), RV.;\nto belong to, be attached or devoted to, serve, follow, seek, pursue, favour, assist (acc.), RV.; AV.; VS.;\nto be connected with (instr.), Pat. on Pāṇ. i, 4, 51;\nto fall to the lot of (acc.), ŚBr.;\nto be together, RV.; AV.;\n (सि॑षक्ति), to go after, follow, accompany, adhere or be attached to (acc.), RV.;\nto help any one to anything (two dat.), ib.;\nto abide in (loc.), ib.;\n (3. pl. सश्चति and सश्चत), to follow, obey, RV.;\nto belong to (acc.), ib.;\nto be devoted to or fond of (acc.), ib.", "gloss_language": "en"}, {"gloss": "सच् [cf. Gk. ἕπομαι; Lat. sequor; Lith. sekù.]", "gloss_language": "en"}, {"gloss": "2. सच् (ifc. strong form साच्), in अपत्य-, अयज्ञसच्, आयु-षक् &c. (qq.vv.)", "gloss_language": "en"}, {"gloss": "3. सच् = √ सञ्ज् in आ-√ सच्, to adhere to, MaitrS.; Kāṭh.", "gloss_language": "en"}, {"gloss": "सच् in comp. for सत्.", "gloss_language": "en"}]}, {"id": "sAc", "headword": "साच्", "headword_slp1": "sAc", "fold": "sac", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "साच् strong form of 2. सच् (q.v.)", "gloss_language": "en"}]}], "saci": [{"id": "Saci", "headword": "शचि", "headword_slp1": "Saci", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शचि (L.) f. N. of the wife of Indra (= शची).", "gloss_language": "en"}], "synonyms": ["शचिः"], "synonyms_slp1": ["SaciH"]}, {"id": "SacI", "headword": "शची", "headword_slp1": "SacI", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "श॑ची f. the rendering of powerful or mighty help, assistance, aid (esp. said of the deeds of Indra and the Aśvins, instr. श॑च्या and श॑चीभिस्, often = ‘mightily’ or ‘helpfully’), RV.", "gloss_language": "en"}, {"gloss": "kindness, favour, grace, ib.; AV.; AitBr.", "gloss_language": "en"}, {"gloss": "skill, dexterity, RV.; VS.", "gloss_language": "en"}, {"gloss": "speech, power of speech, eloquence, Naigh.", "gloss_language": "en"}, {"gloss": "N. of the wife of Indra (derived fr. शची-पति, q.v.), ŚāṅkhGṛ.; MBh. &c.", "gloss_language": "en"}, {"gloss": "of the authoress of RV. x, 159 (having the patr. Paulomi), Anukr.", "gloss_language": "en"}, {"gloss": "Asparagus Racemosus, L.", "gloss_language": "en"}, {"gloss": "a kind of coitus, L.", "gloss_language": "en"}]}, {"id": "SAci", "headword": "शाचि", "headword_slp1": "SAci", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. शाचि m. pl. (perhaps connected with 2. शाक) barley or other grain which has the husk removed and is coarsely ground, VS. (Mahīdh.)", "gloss_language": "en"}, {"gloss": "2. शाचि (prob. fr. √ शच् = शक्), and having the sense of ‘strong’ in the following compounds.", "gloss_language": "en"}]}, {"id": "saci", "headword": "सचि", "headword_slp1": "saci", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स॑चि ind. together, along with, ŚBr.", "gloss_language": "en"}], "synonyms": ["सचिः"], "synonyms_slp1": ["saciH"]}, {"id": "sacI", "headword": "सची", "headword_slp1": "sacI", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सची &c. See शची, p. 1048.", "gloss_language": "en"}]}, {"id": "sAci", "headword": "साचि", "headword_slp1": "sAci", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. साचि॑ mfn. following, accompanying, ŚBr.", "gloss_language": "en"}, {"gloss": "साचि॑ m. N. of Agni, L.", "gloss_language": "en"}, {"gloss": "2. साचि॑ ind. (perhaps fr. 7. स + अञ्च्) crookedly, awry, obliquely, sideways, askance, RV. x, 142, 2 (?); PañcavBr.; Kir.", "gloss_language": "en"}]}, {"id": "sAcI", "headword": "साची", "headword_slp1": "sAcI", "fold": "saci", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "साची in comp. for 2. साचि.", "gloss_language": "en"}]}], "sacika": [{"id": "SacikA", "headword": "शचिका", "headword_slp1": "SacikA", "fold": "sacika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शचिका (VarBṛS.) f. N. of the wife of Indra (= शची).", "gloss_language": "en"}]}], "sacisWa": [{"id": "SacizWa", "headword": "शचिष्ठ", "headword_slp1": "SacizWa", "fold": "sacisWa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "श॑चिष्ठ mf(आ)n. most powerful or helpful, RV.", "gloss_language": "en"}]}], "sacitirTa": [{"id": "SacItIrTa", "headword": "शचीतीर्थ", "headword_slp1": "SacItIrTa", "fold": "sacitirTa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शची—तीर्थ n. N. of a Tīrtha, Śak.", "gloss_language": "en"}]}], "sacinandana": [{"id": "SacInandana", "headword": "शचीनन्दन", "headword_slp1": "SacInandana", "fold": "sacinandana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शची—नन्दन m. metron. of Viṣṇu, Cat.", "gloss_language": "en"}]}], "sacinara": [{"id": "SacInara", "headword": "शचीनर", "headword_slp1": "SacInara", "fold": "sacinara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शची—नर m. N. of a king of Kāśmīra, Rājat.", "gloss_language": "en"}]}], "sacipati": [{"id": "SacIpati", "headword": "शचीपति", "headword_slp1": "SacIpati", "fold": "sacipati", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "श॑ची—प॑ति (श॑ची-), m. lord of might or help (applied to Indra and the Aśvins), RV.; AV.", "gloss_language": "en"}, {"gloss": "N. of Indra, MBh.; Kāv. &c. (cf. क्षिति-श्˚).", "gloss_language": "en"}], "synonyms": ["शचीपतिः"], "synonyms_slp1": ["SacIpatiH"]}], "sacipurandara": [{"id": "SacIpuraMdara", "headword": "शचीपुरंदर", "headword_slp1": "SacIpuraMdara", "fold": "sacipurandara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शची-पुरंदर m. du. Śacī and Indra, Ragh.", "gloss_language": "en"}]}], "sacibala": [{"id": "SacIbala", "headword": "शचीबल", "headword_slp1": "SacIbala", "fold": "sacibala", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शची—बल m. an actor who dresses like Śakra, L.", "gloss_language": "en"}]}], "saciramaRa": [{"id": "SacIramaRa", "headword": "शचीरमण", "headword_slp1": "SacIramaRa", "fold": "saciramaRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "शची—रमण m. ‘lover or husband of Śaci’, N. of Indra, Bālar.", "gloss_language": "en"}]}], "sacivat": [{"id": "SacIvat", "headword": "शचीवत्", "headword_slp1": "SacIvat", "fold": "sacivat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "श॑ची—वत् (श॑ची-), mfn. mighty or helpful (often in voc. -वस्), RV.", "gloss_language": "en"}], "synonyms": ["शचीवन्त्"], "synonyms_slp1": ["SacIvant"]}], "sacivasu": [{"id": "SacIvasu",