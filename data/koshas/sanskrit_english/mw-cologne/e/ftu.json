{"ftu": [{"id": "ftu", "headword": "ऋतु", "headword_slp1": "ftu", "fold": "ftu", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "ऋतु॑ (उस्), m. (Uṇ. i, 72) any settled point of time, fixed time, time appointed for any action (esp. for sacrifices and other regular worship), right or fit time, RV.; AV.; VS.", "gloss_language": "en"}, {"gloss": "an epoch, period (esp. a division or part of the year), season (the number of the divisions of the year is in ancient times, three, five, six, seven, twelve, thirteen, and twenty-four; in later time six seasons are enumerated, viz. Vasanta, ‘spring’; Grīṣma, ‘the hot season’; Varṣās (f. pl. nom.), ‘the rainy season’ Śarad, ‘autumn’; Hemanta, ‘winter’; and Śiśira, ‘the cool season’; the seasons are not unfrequently personified, addressed in Mantras, and worshipped by libations), RV.; AV.; VS. &c., MBh.; Mn. &c.", "gloss_language": "en"}, {"gloss": "symbolical expression for the number six, VarBṛS.; Sūryas. &c.", "gloss_language": "en"}, {"gloss": "the menstrual discharge (in women), the time after the courses (favourable for procreation; according to Bhpr. sixteen days after their appearance), Suśr.; MBh.; Mn. &c.", "gloss_language": "en"}, {"gloss": "sexual union at the above time, Mn. ix, 93; MBh.", "gloss_language": "en"}, {"gloss": "fixed order, order, rule [BRD.], RV. i, 162, 19", "gloss_language": "en"}, {"gloss": "light, splendour, L.", "gloss_language": "en"}, {"gloss": "a particular mineral, L.", "gloss_language": "en"}, {"gloss": "N. of a Ṛṣi", "gloss_language": "en"}, {"gloss": "of the twelfth Manu.", "gloss_language": "en"}], "synonyms": ["ऋतुः"], "synonyms_slp1": ["ftuH"]}], "ftukarman": [{"id": "ftukarman", "headword": "ऋतुकर्मन्", "headword_slp1": "ftukarman", "fold": "ftukarman", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "ऋतु—कर्म॑न् n. a right action, TBr.", "gloss_language": "en"}]}], "ftukala": [{"id": "ftukAla", "headword": "ऋतुकाल", "headword_slp1": "ftu