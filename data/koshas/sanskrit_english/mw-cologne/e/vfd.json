{"vfdDapacayitva": [{"id": "vfdDApacAyitva", "headword": "वृद्धापचायित्व", "headword_slp1": "vfdDApacAyitva", "fold": "vfdDapacayitva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्धापचायि-त्व n. the not rendering due respect to old men, MBh. xiii, 6705.", "gloss_language": "en"}]}], "vfdDa": [{"id": "vfdDa", "headword": "वृद्ध", "headword_slp1": "vfdDa", "fold": "vfdDa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. वृद्ध mfn. (fr. √ वर्ध्, p. 926, col. 1) cut, cut off, destroyed, MBh.", "gloss_language": "en"}, {"gloss": "वृद्ध n. what is cut off, a piece, Śulbas. (v.l. वृध्र).", "gloss_language": "en"}, {"gloss": "2. वृद्ध॑ mfn. grown, become larger or longer or stronger, increased, augmented, great, large, RV. &c. &c.", "gloss_language": "en"}, {"gloss": "grown up, full-grown, advanced in years, aged, old, senior (often in comp. with the names of authors, esp. of authors of law-books [cf. IW. 300, 302], to denote either an older recension of their works or the wk. of some older authors of the same name; cf. वृद्ध-कात्यायन, -गर्ग &c.), TS.; Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "(ifc.) older by, Gaut. vi, 15", "gloss_language": "en"}, {"gloss": "experienced, wise, learned, MBh.; Kām.", "gloss_language": "en"}, {"gloss": "eminent in, distinguished by (instr. or comp.), Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "important, VPrāt.", "gloss_language": "en"}, {"gloss": "exalted, joyful, glad (also applied to hymns), RV.", "gloss_language": "en"}, {"gloss": "(in gram., a vowel) increased (by Vṛddhi q.v.) to आ or ऐ or औ, APrāt.; Lāṭy.", "gloss_language": "en"}, {"gloss": "containing (or treated as containing) आ or ऐ or औ in the first syllable, Pāṇ. i, 1, 73 &c.", "gloss_language": "en"}, {"gloss": "वृद्ध॑ m. an old man (ifc. ‘eldest among’), Mn.; MBh. &c. (cf. comp.)", "gloss_language": "en"}, {"gloss": "a religious mendicant, VarBṛS.", "gloss_language": "en"}, {"gloss": "an elephant eighty years old, Gal.", "gloss_language": "en"}, {"gloss": "Argyreia Speciosa or Argentea, L.", "gloss_language": "en"}, {"gloss": "वृद्ध॑ m. and (आ), f. an elder male or female descendant, a patronymic or metron. designating an elder descendant (as opp. to युवन्, q.v.; e.g. गार्ग्य is वृद्ध, गार्ग्यायण is युवन्), Pāṇ. i, 2, 65 &c.", "gloss_language": "en"}, {"gloss": "वृद्ध॑ n. a nominal stem (and some other stems) whose first syllable contains an आ or ऐ or औ, Pāṇ. i, 1, 73 &c.", "gloss_language": "en"}, {"gloss": "the word वृद्ध, ib. v, 3, 62.", "gloss_language": "en"}], "synonyms": ["वृद्धं", "वृद्धः"], "synonyms_slp1": ["vfdDaM", "vfdDaH"]}, {"id": "vfdDA", "headword": "वृद्धा", "headword_slp1": "vfdDA", "fold": "vfdDa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्धा (आ), f. an old woman, MBh.; Kāv. &c.", "gloss_language": "en"}]}], "vfdDi": [{"id": "vfdDi", "headword": "वृद्धि", "headword_slp1": "vfdDi", "fold": "vfdDi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. वृद्धि f. cutting off, abscission, W.", "gloss_language": "en"}, {"gloss": "(in law) forfeiture, deduction, ib.", "gloss_language": "en"}, {"gloss": "2. वृ॑द्धि f. (for 1. See p. 1010) growth, increase, augmentation, rise, advancement, extension, welfare, prosperity, success, fortune, happiness, RV. &c. &c.", "gloss_language": "en"}, {"gloss": "elevation (of ground), VarBṛS.", "gloss_language": "en"}, {"gloss": "prolongation (of life), Pañcat.", "gloss_language": "en"}, {"gloss": "swelling (of the body), Suśr.", "gloss_language": "en"}, {"gloss": "enlargement of the scrotum (either from swelled testicle or hydrocele), ib.", "gloss_language": "en"}, {"gloss": "swelling or rising (of the sea or of the waters), waxing (of the moon), MBh.", "gloss_language": "en"}, {"gloss": "gain, profit, R.; Subh.", "gloss_language": "en"}, {"gloss": "profit from lending money &c., usury, interest, Mn.;\nYājñ.;\nMBh. (the various kinds of interest recognized by Hindū lawyers are, 1. कायिका वृद्धि, ‘body-interest’ i.e. either the advantage arising from the body of an animal pledged as security for a loan, or interest paid repeatedly without reducing the body or principal;\n2. कालिका व्˚, ‘time-interest’ i.e. payable weekly, monthly, annually, &c., but most usually computed by the month;\n3. चक्रव्˚, ‘wheel-interest’ i.e. interest upon interest, compound interest;\n4. कारिता व्˚, ‘stipulated interest’, at a rate higher than the usual legal rate;\n5. शिखा-व्˚, ‘interest growing like a lock of hair’ i.e. at a usurious rate payable daily ;\n6. भोग-लाभ, ‘advantage [accruing to a creditor] from the use’ of objects handed over to him as security, e.g. of lands, gardens, animals, &c.: ‘lawful interest’ is called धर्म-व्˚, ‘usurious interest’ अ-न्याय-व्˚, ‘interest at the highest legal rate’ परम-व्˚), IW. 264", "gloss_language": "en"}, {"gloss": "the second modification or increase of vowels (to which they are subject under certain conditions, e.g. आ is the Vṛddhi of the vowel अ; ऐ of इ, ई, and ए; औ of उ, ऊ, and ओ; cf. 2. वृद्ध and कृत-वृद्धि), VPrāt.; Pāṇ.; Rājat.; Sarvad.", "gloss_language": "en"}, {"gloss": "one of the 8 principal drugs (described as mild, cooling &c.; and a remedy for phlegm, leprosy, and worms), Suśr.; Bhpr.", "gloss_language": "en"}, {"gloss": "N. of the 11th of the astrological Yogas (or the Yoga star of the 11th lunar mansion), L.", "gloss_language": "en"}, {"gloss": "= वृद्धि-श्राद्ध, GṛS.", "gloss_language": "en"}, {"gloss": "वृद्धि m. (with भट्ट) N. of a poet, Cat.", "gloss_language": "en"}], "synonyms": ["वृद्धिः"], "synonyms_slp1": ["vfdDiH"]}], "vfdDakarman": [{"id": "vfdDakarman", "headword": "वृद्धकर्मन्", "headword_slp1": "vfdDakarman", "fold": "vfdDakarman", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कर्मन् m. N. of a king, VP.", "gloss_language": "en"}]}], "vfdDakaka": [{"id": "vfdDakAka", "headword": "वृद्धकाक", "headword_slp1": "vfdDakAka", "fold": "vfdDakaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—काक m. ‘large crow’, a sort of crow or raven, L.", "gloss_language": "en"}], "synonyms": ["वृद्धकाकः"], "synonyms_slp1": ["vfdDakAkaH"]}], "vfdDakatyayana": [{"id": "vfdDakAtyAyana", "headword": "वृद्धकात्यायन", "headword_slp1": "vfdDakAtyAyana", "fold": "vfdDakatyayana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कात्यायन m. the older Kātyāyana or an older recension of K˚'s law-book, Dāyabh.", "gloss_language": "en"}]}], "vfdDakala": [{"id": "vfdDakAla", "headword": "वृद्धकाल", "headword_slp1": "vfdDakAla", "fold": "vfdDakala", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—काल m. old age, Cāṇ.", "gloss_language": "en"}, {"gloss": "N. of a king, Cat.", "gloss_language": "en"}]}], "vfdDakaveri": [{"id": "vfdDakAverI", "headword": "वृद्धकावेरी", "headword_slp1": "vfdDakAverI", "fold": "vfdDakaveri", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कावेरी f. N. of a river", "gloss_language": "en"}]}], "vfdDakaverimahatmya": [{"id": "vfdDakAverImAhAtmya", "headword": "वृद्धकावेरीमाहात्म्य", "headword_slp1": "vfdDakAverImAhAtmya", "fold": "vfdDakaverimahatmya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कावेरी—माहात्म्य n. N. of wk.", "gloss_language": "en"}]}], "vfdDakumarivakyavaranyaya": [{"id": "vfdDakumArIvAkyavaranyAya", "headword": "वृद्धकुमारीवाक्यवरन्याय", "headword_slp1": "vfdDakumArIvAkyavaranyAya", "fold": "vfdDakumarivakyavaranyaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कुमारी-वाक्य-वर-न्याय m. the principle of the boon asked for by the old virgin (who chose accord. to the Mahā-bhāṣya, पुत्रा मे बहुक्षीर-घृतम् ओदनं काञ्चन-पात्र्याम् भुञ्जीरन्, ‘May my sons eat rice with much milk and ghee from a golden vessel’, which, if granted, would have covered all other wishes), A.", "gloss_language": "en"}]}], "vfdDakfcCra": [{"id": "vfdDakfcCra", "headword": "वृद्धकृच्छ्र", "headword_slp1": "vfdDakfcCra", "fold": "vfdDakfcCra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कृच्छ्र n. a partic. penance (performed) by old people, Cat.", "gloss_language": "en"}]}], "vfdDakesava": [{"id": "vfdDakeSava", "headword": "वृद्धकेशव", "headword_slp1": "vfdDakeSava", "fold": "vfdDakesava", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—केशव m. a partic. form of the sun, ib.", "gloss_language": "en"}]}], "vfdDakowarapuspi": [{"id": "vfdDakowarapuzpI", "headword": "वृद्धकोटरपुष्पी", "headword_slp1": "vfdDakowarapuzpI", "fold": "vfdDakowarapuspi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कोटर-पुष्पी f. a kind of plant, L.", "gloss_language": "en"}]}], "vfdDakola": [{"id": "vfdDakola", "headword": "वृद्धकोल", "headword_slp1": "vfdDakola", "fold": "vfdDakola", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कोल m. an old boar, Mṛcch.", "gloss_language": "en"}]}], "vfdDakosa": [{"id": "vfdDakoSa", "headword": "वृद्धकोश", "headword_slp1": "vfdDakoSa", "fold": "vfdDakosa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कोश m. possessing a rich treasure, Kathās.", "gloss_language": "en"}]}], "vfdDakOsika": [{"id": "vfdDakOSika", "headword": "वृद्धकौशिक", "headword_slp1": "vfdDakOSika", "fold": "vfdDakOsika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—कौशिक m. the old or an old recension of Kauśika, Hcat.", "gloss_language": "en"}]}], "vfdDakrama": [{"id": "vfdDakrama", "headword": "वृद्धक्रम", "headword_slp1": "vfdDakrama", "fold": "vfdDakrama", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—क्रम m. the rank due to old age, MBh.", "gloss_language": "en"}]}], "vfdDaksatra": [{"id": "vfdDakzatra", "headword": "वृद्धक्षत्र", "headword_slp1": "vfdDakzatra", "fold": "vfdDaksatra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—क्षत्र m. N. of a man (see वार्द्धक्षत्रि).", "gloss_language": "en"}]}], "vfdDaksetravaralocana": [{"id": "vfdDakzetravaralocana", "headword": "वृद्धक्षेत्रवरलोचन", "headword_slp1": "vfdDakzetravaralocana", "fold": "vfdDaksetravaralocana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—क्षेत्र-वर-लोचन (w.r. -क्षत्र-व्˚) n. a partic. Samādhi, Kāraṇḍ.", "gloss_language": "en"}]}], "vfdDaksema": [{"id": "vfdDakzema", "headword": "वृद्धक्षेम", "headword_slp1": "vfdDakzema", "fold": "vfdDaksema", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—क्षेम m. N. of a man (see वार्द्धक्षेमि).", "gloss_language": "en"}]}], "vfdDagaNga": [{"id": "vfdDagaNgA", "headword": "वृद्धगङ्गा", "headword_slp1": "vfdDagaNgA", "fold": "vfdDagaNga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—गङ्गा f. N. of a river (commonly called the Buḍi Gaṅgā), KālikāP.", "gloss_language": "en"}]}], "vfdDagaNgaDara": [{"id": "vfdDagaNgADara", "headword": "वृद्धगङ्गाधर", "headword_slp1": "vfdDagaNgADara", "fold": "vfdDagaNgaDara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—गङ्गा—धर n. (scil. चूर्ण) a medicinal powder for diarrhoea, ŚārṅgP.", "gloss_language": "en"}]}], "vfdDagarga": [{"id": "vfdDagarga", "headword": "वृद्धगर्ग", "headword_slp1": "vfdDagarga", "fold": "vfdDagarga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—गर्ग m. the older Garga or the older recension of his wk. AV.Pariś.", "gloss_language": "en"}]}, {"id": "vfdDagArga", "headword": "वृद्धगार्ग", "headword_slp1": "vfdDagArga", "fold": "vfdDagarga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वृद्ध—गार्ग mf(ई)n. = -गार्गीय, Cat.", "gloss_language": "en"}]}], "vfdDagarBa": [{"id": "vfdDagarBA", "headword": "वृद्धगर्भा", "headword_slp1": "vfdDagarBA", "fo