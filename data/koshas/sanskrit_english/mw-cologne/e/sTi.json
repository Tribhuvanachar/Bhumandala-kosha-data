_language": "en"}, {"gloss": "faithful to a promise or agreement, L. : upright, virtuous, L.", "gloss_language": "en"}, {"gloss": "prepared for or to (dat.), Yājñ.; Kum.", "gloss_language": "en"}, {"gloss": "being there, existing, present, close at hand, ready (स्थितो ह्य् एषः, ‘I myself am ready’; अग्रजे स्थिते, ‘when the elder brother is there’), Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "belonging to (gen.), R.", "gloss_language": "en"}, {"gloss": "turned or directed to, fixed upon (loc. or comp.), VarBṛS.; Sarvad.", "gloss_language": "en"}, {"gloss": "resting or depending on (loc.), MBh.; R. &c.", "gloss_language": "en"}, {"gloss": "leading or conducive to (dat.), Pañcat.", "gloss_language": "en"}, {"gloss": "one who has desisted or ceased, Pañcad.", "gloss_language": "en"}, {"gloss": "left over, L.", "gloss_language": "en"}, {"gloss": "(in Vedic gram.) not accompanied by इति (in the Pada-pāṭha), standing alone (पदे स्थिते, ‘in the Pada text’), Prāt.", "gloss_language": "en"}, {"gloss": "स्थित (अम्), n. standing still, stopping, Bhartṛ.", "gloss_language": "en"}, {"gloss": "staying, remaining, abiding, R.", "gloss_language": "en"}, {"gloss": "manner of standing, ib.", "gloss_language": "en"}, {"gloss": "perseverance on the right path, ib.", "gloss_language": "en"}, {"gloss": "स्थित , स्थिति &c. See p. 1264.", "gloss_language": "en"}], "synonyms": ["स्थितः"], "synonyms_slp1": ["sTitaH"]}], "sTitata": [{"id": "sTitatA", "headword": "स्थितता", "headword_slp1": "sTitatA", "fold": "sTitata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्थित—ता f. the being in a place (v.l. स्थिति-ता), BṛĀr.", "gloss_language": "en"}]}], "sTitaDi": [{"id": "sTitaDI", "headword": "स्थितधी", "headword_slp1": "sTitaDI", "fold": "sTitaDi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्थित—धी mfn. steady-minded, firm, unmoved, calm, Bhag.", "gloss_language": "en"}]}], "sTitapaWya": [{"id": "sTitapAWya", "headword": "स्थितपा