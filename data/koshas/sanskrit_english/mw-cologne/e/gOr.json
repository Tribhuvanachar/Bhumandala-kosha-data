{"gOra": [{"id": "gOra", "headword": "गौर", "headword_slp1": "gOra", "fold": "gOra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गौर॑ mf(ई॑)n. (in comp. or ifc. g. कडारादि) white, yellowish, reddish, pale red, RV. x, 100, 2; TS. v &c.", "gloss_language": "en"}, {"gloss": "shining, brilliant, clean, beautiful, Caurap.", "gloss_language": "en"}, {"gloss": "गौर॑ m. white, yellowish (the colour), W.", "gloss_language": "en"}, {"gloss": "a kind of buffalo (Bos Gaurus, often classed with the Gavaya), RV.; VS. &c.", "gloss_language": "en"}, {"gloss": "white mustard (the seed of which is used as a weight, = 3 Rāja-sarṣapas), Yājñ. i, 362", "gloss_language": "en"}, {"gloss": "Grislea tomentosa (धव), L.", "gloss_language": "en"}, {"gloss": "a species of rice, Gal.", "gloss_language": "en"}, {"gloss": "the moon, L.", "gloss_language": "en"}, {"gloss": "the planet Jupiter, L.", "gloss_language": "en"}, {"gloss": "N. of the Nāga Śeṣa, Gal.", "gloss_language": "en"}, {"gloss": "of Caitanya (cf. -चन्द्र)", "gloss_language": "en"}, {"gloss": "of a Yoga teacher (son of Śuka and Pīvarī), Hariv. 981", "gloss_language": "en"}, {"gloss": "pl. N. of a family (cf. ˚रात्रेय), Pravar. iv, 1", "gloss_language": "en"}, {"gloss": "गौर॑ n. white mustard, L.", "gloss_language": "en"}, {"gloss": "N. of a potherb, Gal.", "gloss_language": "en"}, {"gloss": "saffron (cf. कनक-), L.", "gloss_language": "en"}, {"gloss": "the filament of a lotus, L.", "gloss_language": "en"}, {"gloss": "gold, L.", "gloss_language": "en"}, {"gloss": "orpiment, Gal.", "gloss_language": "en"}, {"gloss": "गौर, [cf. Lat. gilvus ?]", "gloss_language": "en"}], "synonyms": ["गौरं", "गौरः"], "synonyms_slp1": ["gOraM", "gOraH"]}, {"id": "gOrA", "headword": "गौरा", "headword_slp1": "gOrA", "fold": "gOra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गौरा॑ (आ), f. = री॑, L. (cf. गौला)", "gloss_language": "en"}]}], "gOri": [{"id": "gOrI", "headword": "गौरी", "headword_slp1": "