{"bud": [{"id": "bud", "headword": "बुद्", "headword_slp1": "bud", "fold": "bud", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद् cl. 1. P. Ā. बोदति, ˚ते, to perceive, learn, Dhātup. xxi, 12 (cf. बुन्द् and बुध्)", "gloss_language": "en"}]}], "budDa": [{"id": "budDa", "headword": "बुद्ध", "headword_slp1": "budDa", "fold": "budDa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद्ध बुद्धि. See cols. 2 and 3.", "gloss_language": "en"}, {"gloss": "बुद्ध mfn. awakened, awake, MBh.", "gloss_language": "en"}, {"gloss": "expanded, blown, SāmavBr.", "gloss_language": "en"}, {"gloss": "conscious, intelligent, clever, wise (opp. to मूढ), MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "learnt, known, understood, Āpast.; MBh. (‘by’, usually instr., but also gen. according to Pāṇ. ii, 2, 12; 3, 67, Sch.)", "gloss_language": "en"}, {"gloss": "बुद्ध m. a wise or learned man, sage, W.", "gloss_language": "en"}, {"gloss": "(with Buddhists) a fully enlightened man who has achieved perfect knowledge of the truth and thereby is liberated from all existence and before his own attainment of Nirvāṇa reveals the method of obtaining it, (esp.) the principal Buddha of the present age (born at Kapila-vastu about the year 500 B.C. his father, Śuddhodana, of the Śākya tribe or family, being the Rāja of that district, and his mother, Māyā-devī, being the daughter of Rāja Su-prabuddha, MWB. 19 &c.;\nhence he belonged to the Kṣatriya caste and his original name Śākya-muni or Śākya-siṃha was really his family name, while that of Gautama was taken from the race to which his family belonged;\nfor his other names See ib. 23;\nhe is said to have died when he was 80 years of age, prob. about 420 B.C. ib. 49 n. 1;\nhe was preceded by 3 mythical Buddhas of the present Kalpa, or by 24, reckoning previous Kalpa, or according to others by 6 principal Buddhas, ib. 136;\nsometimes he is regarded as the 9th incarnation of Viṣṇu, Hariv.;\nKāv.;\nVar. &c.)", "gloss_language": "en"}, {"gloss": "बुद्ध n. knowledge, BhP. (B. बुद्धि).", "gloss_language": "en"}], "synonyms": ["बुद्धः"], "synonyms_slp1": ["budDaH"]}], "budbuda": [{"id": "budbuda", "headword": "बुद्बुद", "headword_slp1": "budbuda", "fold": "budbuda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद्बुद m. (onomat.; cf. बुडबुड) a bubble (often as a symbol of anything transitory), RV. (cf. comp.), MBh.; Kāv. &c. (ifc. f(आ). )", "gloss_language": "en"}, {"gloss": "an ornament or decoration resembling a bubble, L.", "gloss_language": "en"}, {"gloss": "an embryo five days old, Nir.; BhP. (n.), Suśr.", "gloss_language": "en"}, {"gloss": "बुद्बुद n. a partic. disease of the eye, Suśr.", "gloss_language": "en"}], "synonyms": ["बुद्बुदः"], "synonyms_slp1": ["budbudaH"]}, {"id": "budbudA", "headword": "बुद्बुदा", "headword_slp1": "budbudA", "fold": "budbuda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद्बुदा f. N. of an Apsaras, MBh.", "gloss_language": "en"}]}], "budbudatva": [{"id": "budbudatva", "headword": "बुद्बुदत्व", "headword_slp1": "budbudatva", "fold": "budbudatva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद्बुद—त्व n. the being a (mere) bubble (as an embryo), MārkP.", "gloss_language": "en"}]}], "budbudayasu": [{"id": "budbudayASu", "headword": "बुद्बुदयाशु", "headword_slp1": "budbudayASu", "fold": "budbudayasu", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद्बुद॑—याशु (˚द॑-), mfn. one whose semen is a (mere) bubble impotent, RV. x, 155, 4.", "gloss_language": "en"}]}], "budbudakarata": [{"id": "budbudAkAratA", "headword": "बुद्बुदाकारता", "headword_slp1": "budbudAkAratA", "fold": "budbudakarata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "बुद्बुदाकार-ता f. the form or nature of a (mere) bubble, A.", "gloss_language": "en"}]}], "budbudaksa": [{"id": "budbudAkza", "headword": "बुद्बुदाक्ष", "headword_