rs, Mn. iii, 199", "gloss_language": "en"}, {"gloss": "सौम्य॑ m. n. a partic. penance (see -कृच्छ्र), Yājñ.; GāruḍaP.", "gloss_language": "en"}, {"gloss": "सौम्य॑ m. N. of a Dvīpa of the earth or of Bharatavarṣa, Pur.", "gloss_language": "en"}, {"gloss": "of the 7th astrol. Yuga, Jyot.", "gloss_language": "en"}, {"gloss": "सौम्य॑ (अम्), n. the nature or condition of Soma, AV.", "gloss_language": "en"}, {"gloss": "gentleness, MBh.; Pañcat. the Nakṣatra Mṛga-śiras (presided over by the Moon), MaitrUp.; Hariv. (accord. to Nīlak. ‘Wednesday’)", "gloss_language": "en"}, {"gloss": "the left eye, L.", "gloss_language": "en"}, {"gloss": "the middle of the hand, L.", "gloss_language": "en"}, {"gloss": "N. of the fifth Muhūrta, Cat.", "gloss_language": "en"}, {"gloss": "(scil. अद्भुत) a partic. kind of omen or prodigy (occurring in the Diva or sky), MW.", "gloss_language": "en"}, {"gloss": "सौम्य &c. See col. 1.", "gloss_language": "en"}], "synonyms": ["सौम्यः"], "synonyms_slp1": ["sOmyaH"]}, {"id": "sOmyA", "headword": "सौम्या", "headword_slp1": "sOmyA", "fold": "sOmya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सौम्या (या), f. N. of various plants (Abrus Precatorius; Glycine Debilis; Ruta Graveolens &c.), L.", "gloss_language": "en"}, {"gloss": "a pearl, L.", "gloss_language": "en"}, {"gloss": "the Nakṣatra Mṛga-śiras, Hariv.", "gloss_language": "en"}, {"gloss": "N. of the five stars in Orion's head (also called इल्वल, q.v.), W.", "gloss_language": "en"}, {"gloss": "a species of the Āryā metre, Col.", "gloss_language": "en"}, {"gloss": "N. of Durgā, Cat.", "gloss_language": "en"}]}], "sOmyi": [{"id": "sOmyI", "headword": "सौम्यी", "headword_slp1": "sOmyI", "fold": "sOmyi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सौम्यी (ई), f. moonshine, MBh.", "gloss_language": "en"}]}], "sOmyakfcCra": [{"id": "sOmyakfcCra", "headword": "सौम्यकृच्छ्र", "headword_slp1": "sOmyakfcCra", "fold": "sOmyakfcCra", "headword_language":