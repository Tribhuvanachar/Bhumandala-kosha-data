{"apita": [{"id": "appitta", "headword": "अप्पित्त", "headword_slp1": "appitta", "fold": "apita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपाम्-पित्त or अप्-पित्त, n. fire\n a plant, L.", "gloss_language": "en"}, {"gloss": "अप्-पित्त n. See 2. अ॑प्.", "gloss_language": "en"}], "synonyms": ["अप्पित्तं"], "synonyms_slp1": ["appittaM"]}, {"id": "apIta", "headword": "अपीत", "headword_slp1": "apIta", "fold": "apita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. अ॑पीत mfn. gone into, entered, ŚBr. x (used for the etym. of स्वपिति), ChUp. (cf. स्वाप्यया.)", "gloss_language": "en"}, {"gloss": "2. अ-पीत mfn. not drunk", "gloss_language": "en"}, {"gloss": "not having drunk, MBh. ii, 1902.", "gloss_language": "en"}], "synonyms": ["अपीतः"], "synonyms_slp1": ["apItaH"]}, {"id": "ApIta", "headword": "आपीत", "headword_slp1": "ApIta", "fold": "apita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. आ-पीत mfn. drunk up, exhausted.", "gloss_language": "en"}, {"gloss": "2. आ-पीत mfn. yellowish, R.", "gloss_language": "en"}, {"gloss": "आ-पीत m. N. of a species of tree Comm.", "gloss_language": "en"}, {"gloss": "आ-पीत n. filament of the lotus, ib.", "gloss_language": "en"}, {"gloss": "a pyritic mineral, L.", "gloss_language": "en"}, {"gloss": "(for 1. आ-पीत See under आ-√ पा, and for 3. आ-पीत under आ-√ प्यत्).", "gloss_language": "en"}, {"gloss": "3. आ॑-पीत mfn. swollen out, puffed up, distended, full, stout, fat, RV. viii, 9, 19", "gloss_language": "en"}, {"gloss": "(for 2. आपीत See s.v.)", "gloss_language": "en"}], "synonyms": ["आपीतं", "आपीतः"], "synonyms_slp1": ["ApItaM", "ApItaH"]}], "api": [{"id": "api", "headword": "अपि", "headword_slp1": "api", "fold": "api", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अ॑पि or sometimes पि (see पि-दृभ्, पि-धा, पि-नह्), expresses placing near or over, uniting to, annexing, reaching to, proximity, &c.", "gloss_language": "en"}, {"gloss": "अपि [cf. Gk. ἐπί; Zend api; Germ. and Eng. prefix be]", "gloss_language": "en"}, {"gloss": "in later Sanskṛt its place seems frequently supplied by अभि.", "gloss_language": "en"}, {"gloss": "(As a separable adv.) and, also, moreover, besides, assuredly, surely", "gloss_language": "en"}, {"gloss": "suppose that, perhaps, Jātakam.", "gloss_language": "en"}, {"gloss": "अपि अपि or अपि-च, as well as", "gloss_language": "en"}, {"gloss": "न वापि or न अपिवा or न नचापि, neither, nor, चापि, (and at the beginning of a sentence) अपि-च, moreover.", "gloss_language": "en"}, {"gloss": "अपि is often used to express emphasis, in the sense of even, also, very", "gloss_language": "en"}, {"gloss": "e.g. अन्यद् अपि, also another, something more", "gloss_language": "en"}, {"gloss": "अद्यापि, this very day, even now", "gloss_language": "en"}, {"gloss": "तथापि, even thus, notwithstanding", "gloss_language": "en"}, {"gloss": "यद्य् अपि, even if, although", "gloss_language": "en"}, {"gloss": "यद्यपि तथापि, although, nevertheless", "gloss_language": "en"}, {"gloss": "न कदाचिद् अपि, never at any time: sometimes in the sense of but, only, at least, e.g. मुहूर्तम् अपि, only a moment.", "gloss_language": "en"}, {"gloss": "अपि may be affixed to an interrogative to make it indefinite, e.g. को ऽपि, any one", "gloss_language": "en"}, {"gloss": "कुत्रापि, anywhere.", "gloss_language": "en"}, {"gloss": "अपि imparts to numerals the notion of totality, e.g. चतुर्णाम् अपि वर्णानाम्, of all the four castes.", "gloss_language": "en"}, {"gloss": "अपि may be interrogative at the beginning of a sentence.", "gloss_language": "en"}, {"gloss": "अपि may strengthen the original force of the Potential, or may soften the Imperative, like the English ‘be pleased to’;", "gloss_language": "en"}, {"gloss": "sometimes it is a mere expletive.", "gloss_language": "en"}, {"gloss": "अपि तु but, but yet.", "gloss_language": "en"}, {"gloss": "(अपि-अपि), as well-as, ib.", "gloss_language": "en"}]}, {"id": "apI", "headword": "अपी", "headword_slp1": "apI", "fold": "api", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. अ॑पी See अ॑प्य.", "gloss_language": "en"}, {"gloss": "2. अपी (√ इ), (Ved.) अ॑प्य्-एति to go in or near;\nto enter into or upon;\nto come near, approach (also in copulation, RV. ii, 43, 2 ind.p. अपी॑त्या);\nto partake, have a share in;\nto join to pour out (as a river).", "gloss_language": "en"}]}, {"id": "Api", "headword": "आपि", "headword_slp1": "Api", "fold": "api", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. आपि॑ m. an ally, a friend, an acquaintance, RV.; VS. (according to Sāy. on RV. ii, 29, 4, from the Caus.) causing to obtain [wealth &c.]", "gloss_language": "en"}, {"gloss": "आपि॑ mfn. ifc. reaching to, entering.", "gloss_language": "en"}, {"gloss": "2. आ-पि॑ mfn. (fr. आ-√ प्यै, accord. to some, ‘swelling’, ‘refreshing’, RV. v, 53, 2).", "gloss_language": "en"}, {"gloss": "आपि &c. See under √ 1. आप्.", "gloss_language": "en"}], "synonyms": ["आपिः"], "synonyms_slp1": ["ApiH"]}, {"id": "ApI", "headword": "आपी", "headword_slp1": "ApI", "fold": "api", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "आपी f. N. of a constellation, L.", "gloss_language": "en"}, {"gloss": "आ-√ पी &c. See under आ-√ प्यै.", "gloss_language": "en"}, {"gloss": "आ-पी mfn. fat, enlarged, increased, T.", "gloss_language": "en"}]}], "apitva": [{"id": "apitva", "headword": "अपित्व", "headword_slp1": "apitva", "fold": "apitva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-त्व॑ n. having part, share, AV.; ŚBr. (cf. अप-पित्व॑.)", "gloss_language": "en"}], "synonyms": ["अपित्वं"], "synonyms_slp1": ["apitvaM"]}, {"id": "apItvA", "headword": "अपीत्वा", "headword_slp1": "apItvA", "fold": "apitva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अ-पीत्वा ind.p. not having drunk, without drinking.", "gloss_language": "en"}]}, {"id": "Apitva", "headword": "आपित्व", "headword_slp1": "Apitva", "fold": "apitva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "आपि—त्व॑ n. confederation, friendship, RV. viii, 4, 3; 20, 22.", "gloss_language": "en"}]}], "apitvin": [{"id": "apitvin", "headword": "अपित्विन्", "headword_slp1": "apitvin", "fold": "apitvin", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-त्वि॑न् mfn. having part, sharing, ŚBr.", "gloss_language": "en"}]}], "apinama": [{"id": "apinAma", "headword": "अपिनाम", "headword_slp1": "apinAma", "fold": "apinama", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-नाम (in the beginning of a phrase), perhaps, in all probability, I wish that, Mṛcch.; Śāk. &c.", "gloss_language": "en"}]}], "apivat": [{"id": "apivat", "headword": "अपिवत्", "headword_slp1": "apivat", "fold": "apivat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अ॑पि-वत् mf(वती)n. See अपि-√ वत्.", "gloss_language": "en"}, {"gloss": "अपि-√ वत् (Opt. cl. 1. pl. -वतेम; pr. p. -व॑तत्)\nto understand, comprehend, RV. vii, 3, 10; 60, 6 :\nCaus. (Imper. 2. sg. -वातय; pr.p. -वात॑यत्; aor. 3. pl. -अवीवतन्, RV. x, 13, 5)\nto cause to understand, make intelligible to (with or without dat.), RV.;\n (1. pl. -वातयामसि) to excite, awaken, RV. i, 128, 2.", "gloss_language": "en"}], "synonyms": ["अपिवन्त्"], "synonyms_slp1": ["apivant"]}], "apikaksa": [{"id": "apikakza", "headword": "अपिकक्ष", "headword_slp1": "apikakza", "fold": "apikaksa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-कक्ष॑ m. the region of the arm-pits and shoulder-blades (especially in animals), RV. iv, 40, 4; x, 134, 7; Lāṭy.", "gloss_language": "en"}, {"gloss": "N. of a man and m. pl. his descendants.", "gloss_language": "en"}], "synonyms": ["अपिकक्षः"], "synonyms_slp1": ["apikakzaH"]}], "apikaksya": [{"id": "apikakzya", "headword": "अपिकक्ष्य", "headword_slp1": "apikakzya", "fold": "apikaksya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-कक्ष्य᳙ (5) mfn. connected with the region of the arm-pits, RV. i, 117, 22.", "gloss_language": "en"}]}], "apikarRa": [{"id": "apikarRa", "headword": "अपिकर्ण", "headword_slp1": "apikarRa", "fold": "apikarRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-कर्ण॑ n. the region of the ears, RV. vi, 48, 16.", "gloss_language": "en"}], "synonyms": ["अपिकर्णं"], "synonyms_slp1": ["apikarRaM"]}], "apikf": [{"id": "apikf", "headword": "अपिकृ", "headword_slp1": "apikf", "fold": "apikf", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ 1. कृ to bring into order, arrange, prepare, TS.; TBr.; PBr.", "gloss_language": "en"}]}], "apikft": [{"id": "apikft", "headword": "अपिकृत्", "headword_slp1": "apikft", "fold": "apikft", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ 2. कृत् (1. sg. -कृन्तामि fut. 1. sg. -कर्त्स्यामि) to cut off, VS.; AV.; TS.; ŚBr.", "gloss_language": "en"}]}], "apiksE": [{"id": "apikzE", "headword": "अपिक्षै", "headword_slp1": "apikzE", "fold": "apiksE", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ क्षै Caus. -क्षापयति, to consume by fire, AV. xii, 5, 44 and 51.", "gloss_language": "en"}]}], "apigam": [{"id": "apigam", "headword": "अपिगम्", "headword_slp1": "apigam", "fold": "apigam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ गम् Ved. to go into, enter, approach, join, [aor. Subj. 3. pl. अ॑पिग्मन्, RV. v, 33, 10] RV. &c.;\nto approach a woman, RV. i, 179, 1.", "gloss_language": "en"}]}], "apiga": [{"id": "apigA", "headword": "अपिगा", "headword_slp1": "apigA", "fold": "apiga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ 1. गा Ved. to enter, get into, mingle with, RV. vii, 21, 5, &c.", "gloss_language": "en"}]}], "apigirRa": [{"id": "apigIrRa", "headword": "अपिगीर्ण", "headword_slp1": "apigIrRa", "fold": "apigirRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-गीर्ण mfn. praised, L.", "gloss_language": "en"}], "synonyms": ["अपिगीर्णं"], "synonyms_slp1": ["apigIrRaM"]}], "apiguRa": [{"id": "apiguRa", "headword": "अपिगुण", "headword_slp1": "apiguRa", "fold": "apiguRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-गुण mfn. excellent, MBh. xii, 2677.", "gloss_language": "en"}]}], "apigrah": [{"id": "apigrah", "headword": "अपिग्रह्", "headword_slp1": "apigrah", "fold": "apigrah", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ ग्रह् (with or without मुखम्, नासिके, &c.), to close (the mouth, nose, &c.), ŚBr.; AitBr.; ChUp.", "gloss_language": "en"}]}], "apigfhya": [{"id": "apigfhya", "headword": "अपिगृह्य", "headword_slp1": "apigfhya", "fold": "apigfhya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. अपि-गृ॑ह्य ind.p. closing the mouth, TS.", "gloss_language": "en"}, {"gloss": "2. अपि-गृह्य [Ved. Pāṇ. iii, 1, 118] or अपि-ग्राह्य [ib. Comm.], अम्, n. impers. (with abl.) the mouth to be closed before (a bad smell, &c.)", "gloss_language": "en"}]}], "apigrahya": [{"id": "apigrAhya", "headword": "अपिग्राह्य", "headword_slp1": "apigrAhya", "fold": "apigrahya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "2. अपि-गृह्य [Ved. Pāṇ. iii, 1, 118] or अपि-ग्राह्य [ib. Comm.], अम्, n. impers. (with abl.) the mouth to be closed before (a bad smell, &c.)", "gloss_language": "en"}]}], "apiGas": [{"id": "apiGas", "headword": "अपिघस्", "headword_slp1": "apiGas", "fold": "apiGas", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "अपि-√ घस् to eat off or away (perf. 3. pl. -जक्षुः), ŚBr.;\n (aor. Ā. 3. sg. -ग्ध [fr. घ्-स्-त], which by, Sāy. is derived fr. √ हन्), RV. i, 158, 5.", "gloss_language": "en"}]}], "apicCila": [{"id": "apicCila", "headword": "अपिच्छिल", "headword_slp1": "apicCila", "fold": "apicCila", "headword_language": "sa"