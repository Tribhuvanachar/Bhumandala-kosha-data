{"psa": [{"id": "psA", "headword": "प्सा", "headword_slp1": "psA", "fold": "psa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. प्सा cl. 2. P. (Dhātup. xxiv, 47) प्सा॑ति (Impv. प्साहि, प्सातु, AV.; pf. पप्सौ Gr.; aor. अप्सासीत्, Bhaṭṭ.; Prec. प्सायात्, ŚBr.; or प्सेयात् Gr.; fut. प्सास्यति, प्साता, ib.; ind.p. -प्सा॑य, Br.; Pass. impf. अप्सीयत, ib.),\nto chew, swallow, devour, eat, consume;\nto go, Naigh. ii, 14. (For भ्सा = भसा = √ भस् + आ; cf. √ म्ना and मन्, √ या and इ &c.)", "gloss_language": "en"}, {"gloss": "2. प्सा f. eating, food, L.", "gloss_language": "en"}, {"gloss": "hunger, L.", "gloss_language": "en"}]}], "psaras": [{"id": "psaras", "headword": "प्सरस्", "headword_slp1": "psaras", "fold": "psaras", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "प्स॑रस् n. a feast, enjoyment, delight, RV. (cf. देव॑-प्सरस्).", "gloss_language": "en"}]}], "psata": [{"id": "psAta", "headword": "प्सात", "headword_slp1": "psAta", "fold": "psata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "प्सात॑ mfn. chewed, eaten, devoured, ŚBr.", "gloss_language": "en"}, {"gloss": "hungry, L.", "gloss_language": "en"}], "synonyms": ["प्सातं"], "synonyms_slp1": ["psAtaM"]}], "psana": [{"id": "psAna", "headword": "प्सान", "headword_slp1": "psAna", "fold": "psana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "प्सान n. eating, food, L.", "gloss_language": "en"}], "synonyms": ["प्सानं"], "synonyms_slp1": ["psAnaM"]}], "psatkara": [{"id": "psAtkAra", "headword": "प्सात्कार", "headword_slp1": "psAtkAra", "fold": "psatkara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "प्सात्-कार m. a partic. sound, L.", "gloss_language": "en"}]}]}