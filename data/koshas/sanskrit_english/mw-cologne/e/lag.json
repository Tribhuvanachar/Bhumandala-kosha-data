{"lag": [{"id": "lag", "headword": "लग्", "headword_slp1": "lag", "fold": "lag", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लग् (cf. √ लक्ष्, लक्ष &c.) cl. 1. P. (Dhātup. xix, 24) लगति (accord. to Nir. iv, 10 also लग्यति; pf. ललाग Gr.; aor. अलगीत्, ib.; fut. लगिता, ib.; लगिष्यति, Pañcat.; ind.p. लगित्वा, -लग्य, Kāv.),\nto adhere, stick, cling or attach one's self to (loc.), MBh.; Kāv. &c. (with हृदि and gen., ‘to penetrate to a person's heart’, Kathās.);\nto take effect upon (loc.), Śiś.;\nto meet, come in contact, cut (as lines), Gol., Sch.;\nto follow closely, ensue or happen immediately, Kathās.;\nto pass away (as time), Pañcat. :\nCaus. orCaus. लगयति, or cl. 10. (Dhātup. xxxiii, 63) लागयति, ‘to taste’ or ‘to obtain’ (आस्वादने, or आसादने). [In Hindī this root often means ‘to begin’.]", "gloss_language": "en"}]}], "laganiya": [{"id": "laganIya", "headword": "लगनीय", "headword_slp1": "laganIya", "fold": "laganiya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लगनीय mfn. to be attached or clung to, Cat.", "gloss_language": "en"}]}], "lagita": [{"id": "lagita", "headword": "लगित", "headword_slp1": "lagita", "fold": "lagita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लगित mfn. attached to, adhered, W.", "gloss_language": "en"}, {"gloss": "obtained, got, ib.", "gloss_language": "en"}, {"gloss": "entered, Hit. (v.l. चलित).", "gloss_language": "en"}], "synonyms": ["लगितं"], "synonyms_slp1": ["lagitaM"]}], "lagna": [{"id": "lagna", "headword": "लग्न", "headword_slp1": "lagna", "fold": "lagna", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. लग्न mfn. (for 2. See p. 895, col. 2) adhered, adhering or clinging to, attached to, sticking or remaining in, fixed on, intent on, clasping, touching, following closely (with gen. or ifc.), MBh.; Kāv. &c. (with पृष्ठे, पृष्ठ-तस्; or पृष्ठ ibc., following on a person's heels; with मार्गे, sticking to i.e. following the road; with हृदये, one who has penetrated the heart)", "gloss_language": "en"}, {"gloss": "one who has entered on a course of action, one who has begun to (inf.), Pañcat.", "gloss_language": "en"}, {"gloss": "meeting, intersecting, cutting (said of lines), Gol.", "gloss_language": "en"}, {"gloss": "immediately ensuing, Pañcat.", "gloss_language": "en"}, {"gloss": "passed (as days), Vet.", "gloss_language": "en"}, {"gloss": "consumed by, spent in (instr.), Kull. on Mn. vii, 127", "gloss_language": "en"}, {"gloss": "auspicious (see comp.)", "gloss_language": "en"}, {"gloss": "furious through being in rut (an elephant), L.", "gloss_language": "en"}, {"gloss": "लग्न m. a bard or minstrel (who awakes the king in the morning), L.", "gloss_language": "en"}, {"gloss": "लग्न m. n. (ifc. f(आ). ) the point of contact or intersection (of two lines), the point where the horizon intersects the ecliptic or path of the planets, Sūryas.; VarBṛS.", "gloss_language": "en"}, {"gloss": "लग्न m. the point or arc of the equator which corresponds to a given point or arc of the ecliptic, ib.", "gloss_language": "en"}, {"gloss": "the division of the equator which rises in succession with each sign in an oblique sphere, ib.", "gloss_language": "en"}, {"gloss": "the point of the ecliptic which at a given time is upon the meridian or at the horizon (क्षितिजे लग्नम्, horizon Lagna; मध्य-लग्नम्, meridian Lagna), ib.", "gloss_language": "en"}, {"gloss": "the moment of the sun's entrance into a zodiacal sign, ib.", "gloss_language": "en"}, {"gloss": "the rising of the sun or of the planets, ib.", "gloss_language": "en"}, {"gloss": "(in astrol.) a scheme or figure of the 12 houses or zodiacal signs (used as a horoscope)", "gloss_language": "en"}, {"gloss": "the whole of the first astrological house", "gloss_language": "en"}, {"gloss": "(also with शुभ, शोभन, अनुकूल &c.) an auspicious moment or time fixed upon as lucky for beginning to perform anything, Rājat.; Kathās.; Hit.", "gloss_language": "en"}, {"gloss": "the decisive moment or time for action, decisive measure, Kathās.", "gloss_language": "en"}, {"gloss": "1. and 2. लग्न . See col. 2 and p. 895, col. 2.", "gloss_language": "en"}, {"gloss": "2. लग्न mfn. (also referable to 1. लज्; for 1. लग्न See p. 893, col. 2) ashamed, Pāṇ. vii, 2, 14, Sch.", "gloss_language": "en"}], "synonyms": ["लग्नं", "लग्नः"], "synonyms_slp1": ["lagnaM", "lagnaH"]}], "lagnakala": [{"id": "lagnakAla", "headword": "लग्नकाल", "headword_slp1": "lagnakAla", "fold": "lagnakala", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लग्न—काल m. the time or moment pointed out by astrologers as auspicious, Kathās.", "gloss_language": "en"}], "synonyms": ["लग्नकालः"], "synonyms_slp1": ["lagnakAlaH"]}], "lagnagraha": [{"id": "lagnagraha", "headword": "लग्नग्रह", "headword_slp1": "lagnagraha", "fold": "lagnagraha", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लग्न—ग्रह mfn. insisting firmly on anything, persistent, obtrusive, ib.", "gloss_language": "en"}]}], "lagnagrahaRa": [{"id": "lagnagrahaRa", "headword": "लग्नग्रहण", "headword_slp1": "lagnagrahaRa", "fold": "lagnagrahaRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लग्न—ग्रहण n. the computation of the moment favourable for any undertaking, Camp.", "gloss_language": "en"}]}], "lagnacandrika": [{"id": "lagnacandrikA", "headword": "लग्नचन्द्रिका", "headword_slp1": "lagnacandrikA", "fold": "lagnacandrika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लग्न—चन्द्रिका f. N. of wk.", "gloss_language": "en"}]}], "lagnacinta": [{"id": "lagnacintA", "headword": "लग्नचिन्ता", "headword_slp1": "lagnacintA", "fold": "lagnacinta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "लग्न—चिन्ता f. thinking of the auspicious moment, Kāv.", "gloss_language": "en"}]}], "lagnadarpaRa": [{"id": "lagnadarpaRa", "headword": "लग्नदर्पण", "headword_slp1": "lagnadarpaRa", "fold": "lagnadarp