esid. Ā. दिदृक्षते (ep. also ˚ति) to wish to see, long for (acc.), RV. iii, 30, 13; ŚBr.; MBh. &c.:\nDesid. of Caus. दिदर्शयिषति, to wish to show, Śaṃk.;\n अदिदर्शयिषीत्, Nid. :\nIntens. दरीदृश्यते, to be always visible, Bhojapr.;\n दरीदर्ष्टि or दरिदर्ष्टि or दर्द्˚, Pāṇ. vii, 4, 90; 91.", "gloss_language": "en"}, {"gloss": "दृश् [cf. Gk. δέρκομαι, δέδορκα, ἔδρακον; Goth. tarhjan.]", "gloss_language": "en"}, {"gloss": "2. दृ॑श् m. (nom. क्, Ved. ङ्, Pāṇ. vii, 1, 83) seeing, viewing, looking at", "gloss_language": "en"}, {"gloss": "knowing, discerning, Yājñ.; MBh. &c. (ifc. cf. आयुर्वेद-द्˚, दिष्ट-द्˚, पृथग्-द्˚, म॑न्त्र-द्˚, सम-द्˚, सर्व-द्˚, सूर्य-द्˚)", "gloss_language": "en"}, {"gloss": "दृ॑श् f. sight, view (dat. दृशे॑ as inf. cf. √ 1. दृश्)", "gloss_language": "en"}, {"gloss": "look, appearance (in ई-द्˚, की-द्˚, ता-द्˚)", "gloss_language": "en"}, {"gloss": "दृ॑श् f. the eye, R.; Var. &c. (also n., BhP. iv, 4, 24)", "gloss_language": "en"}, {"gloss": "दृ॑श् f. theory, doctrine, Vcar.", "gloss_language": "en"}, {"gloss": "(astrol.) the aspect of a planet or the observed spot. [cf. Gk. δρα for δρακ in ὑπόδρα.]", "gloss_language": "en"}]}], "dfsa": [{"id": "dfSa", "headword": "दृश", "headword_slp1": "dfSa", "fold": "dfsa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दृश m. look, appearance (cf. ई-द्˚, की-द्˚, ता-द्˚ &c.)", "gloss_language": "en"}]}, {"id": "dfSA", "headword": "दृशा", "headword_slp1": "dfSA", "fold": "dfsa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दृशा f. the eye, L.", "gloss_language": "en"}]}], "dfsam": [{"id": "dfSam", "headword": "दृशम्", "headword_slp1": "dfSam", "fold": "dfsam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दृशम् ind. = 2. दृश्, ifc. (g. शरद्-आदि)", "gloss_language": "en"}]}], "dfsakaNksya": [{"id": "dfSAkANkzya", "headword": "दृशाकाङ्क्ष्य", "headword_slp1": "dfSAkANkzya", "fold": "dfsakaNksya", "headword_language": "sa", "source": "mw-