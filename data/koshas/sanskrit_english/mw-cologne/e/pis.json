{"pis": [{"id": "piS", "headword": "पिश्", "headword_slp1": "piS", "fold": "pis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. पिश् (पिंश्) cl. 6. P. (Dhātup. xxviii, 143) पिंशति, Ved. also Ā. ˚ते (pf. पिपे॑श, पिपिशे॑, ˚श्रे, RV.; aor. p. पिशान॑, ib.; अपेशीत् Gr. ; fut. पेशिष्यति, पेशिता Gr.),\nto hew out, carve, prepare (esp. meat), make ready, adorn (Ā. also ‘one's self’);\nto form, fashion, mould, RV.; TBr. :\nPass. पिश्य॑ते, AV. :\nCaus. पेशयते aor. अपीपिशत् Gr.:\nDesid. पिपिशिषति or पिपेशिषति, ib. :\nIntens. See पे॑पिशत्, शान.", "gloss_language": "en"}, {"gloss": "पिश् [cf. Gk. ποικίλος; Slav. pišati; Angl.Sax. fâh.]", "gloss_language": "en"}, {"gloss": "2. पि॑श् f. ornament, decoration, RV. vii, 18, 2 (cf. विश्व-, शुक्र-, सु-.).", "gloss_language": "en"}]}, {"id": "piz", "headword": "पिष्", "headword_slp1": "piz", "fold": "pis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिष् cl. 7. P. (Dhātup. xxix, 15) पिनष्टि (rarely Ā.; Subj. 2. 3. sg. पिणक्, RV.; Impv. पिंष॑, AV.; पिंषे; अपिंषत्; पिषेयम्, MBh.; pf. पिपे॑ष, पिपिषे, RV.; aor. अपिक्षन्, ŚBr.; fut. पेक्ष्यति, Up.; पेष्टा Gr.; ind.p. पिष्ट्वा॑, -पे॑षम्, Br.; -पिष्य, MBh.; inf. पेस्टुम्, पे॑ष्टवै॑, Br.),\nto crush, bruise, grind, pound, hurt, injure, destroy (fig. also with gen. Pāṇ. ii, 3, 56), RV. &c. &c.;\n Caus. पेषयति (aor. अपीपिषत् Gr.), to crush, bruise, grind &c., GṛS.; MBh.; Car. (Gr. also ‘to give; to be strong; to dwell’).", "gloss_language": "en"}, {"gloss": "पिष्, [cf. Zd. pish; Gk. πτίσσω [?]; Lat. pinsere, pīsere.]", "gloss_language": "en"}]}, {"id": "pis", "headword": "पिस्", "headword_slp1": "pis", "fold": "pis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिस् cl. 4. P. (Naigh. ii, 14) पि॑स्यति (pf. 3. pl. पिपिसुः), to stretch, expand, ŚBr.;\n cl. 1. पेसति, to go, move, Dhātup. xvii, 69;\n cl. 10. पेसयति id.;\nto hurt;\nto be strong;\nto give or to take;\nto dwell, xxxii, 32 (cf. पिष्, Caus.)", "gloss_language": "en"}]}, {"id": "pIz", "headword": "पीष्", "headword_slp1": "pIz", "fold": "pis", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पीष् = √ पिष् in अपीषन्, AV. iv, 6, 7.", "gloss_language": "en"}]}], "pisa": [{"id": "piSa", "headword": "पिश", "headword_slp1": "piSa", "fold": "pisa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिश॑ m. = रुरु, a sort of deer (probably so called from its colour; cf. next), RV. i, 64, 8 (Sāy.)", "gloss_language": "en"}]}], "pisi": [{"id": "piSI", "headword": "पिशी", "headword_slp1": "piSI", "fold": "pisi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिशी (ई), f. Nardostachys Jatamansi, L.", "gloss_language": "en"}, {"gloss": "पिशी f. of पिश, q.v.", "gloss_language": "en"}]}], "pisaNka": [{"id": "piSaNka", "headword": "पिशङ्क", "headword_slp1": "piSaNka", "fold": "pisaNka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिशङ्क (prob.) = पिशङ्ग, Hir.", "gloss_language": "en"}]}], "pisaNga": [{"id": "piSaNga", "headword": "पिशङ्ग", "headword_slp1": "piSaNga", "fold": "pisaNga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिश॑ङ्ग mf(ई)n. reddish, r˚-brown or -yellow, tawny, RV. &c. &c.", "gloss_language": "en"}, {"gloss": "पिश॑ङ्ग m. a r˚ or tawny colour, W.", "gloss_language": "en"}, {"gloss": "N. of a serpent-demon, TāṇḍBr.; MBh.", "gloss_language": "en"}], "synonyms": ["पिशंग", "पिशङ्गः"], "synonyms_slp1": ["piSaMga", "piSaNgaH"]}], "pisaNgajawa": [{"id": "piSaNgajawa", "headword": "पिशङ्गजट", "headword_slp1": "piSaNgajawa", "fold": "pisaNgajawa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "पिशङ्ग—जट m. ‘having a reddish braid of hair’, N. of an ascetic, Kathās.", "gloss_language": "en"}]}], "pisaNgata": [{"id": "piSaNgatA", "headword": "पिशङ्गता", "headword_slp1": "piSaNgatA", "fold": "pisaNgata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss