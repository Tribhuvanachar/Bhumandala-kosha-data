{"raD": [{"id": "raD", "headword": "रध्", "headword_slp1": "raD", "fold": "raD", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रध् or रन्ध् cl. 4. P. (Dhātup. xxvi, 84) र॑ध्यति (pf. ररन्ध, 1. pl. ररन्धिम or रेध्म Gr.; 3. pl. रारधुः॑, RV.; aor. अरधत्, ib.; Subj. रन्धीस्, Impv. रन्धि for रन्द्धि, ib.; fut. रधिता, रद्धा Gr.; रधिष्यति, रत्स्यति, ib.; inf. रधितुम्, Bhaṭṭ.),\nto become subject to (dat.), be subdued or overthrown, succumb, RV.; AV.;\nto be completed or matured, MW. (cf. √ राध्);\nto bring into subjection, subdue, RV.;\nto deliver into the hand of (dat.), ib.;\nto hurt, torment, Bhaṭṭ. :\nCaus. रन्ध॑यति (Ved. also ˚ते; aor. रीरधत्, RV.; अररन्धत् Gr.),\nto make subject, deliver over to (dat.), RV.; AV.;\nto torment, afflict, R.;\nto destroy, annihilate, BhP.;\nto cook, prepare (food), MānGṛ. :\nDesid. रिरधिषति, रिरत्सति Gr.:\nIntens. रारध्यते, रारद्धि Gr. (in RV. vi, 25, 9 रारन्धि॑ for रारन्द्धि॑, and v, 54, 13 रारन्त for रारन्त्त) to hand over to, deliver.", "gloss_language": "en"}]}, {"id": "rAD", "headword": "राध्", "headword_slp1": "rAD", "fold": "raD", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राध् (cf. √ ऋध् and रध्) cl. 5. 4. P. (Dhātup. xxvii, 16; xxvi, 71) राध्नो॑ति, राध्यति (Ved. also pr. राधति and रा॑ध्यते; pf. ररा॑ध, RV. &c. &c. [2. sg. रराधिथ or रेधिथ, cf. Pāṇ. vi, 4, 123]; aor., अरात्सीत्, राधिषि, AV.; Br.; Prec. राध्यासम्, ib.; fut. राद्धा Gr.; रात्स्यति, AV.; Br.; ind.p. राद्ध्वा॑, -राध्य, Br.),\nto succeed (said of things), be accomplished or finished, VS.; TS.; AV.;\nto succeed (said of persons), be successful with (instr.), thrive, prosper, RV.; TS.; Br.; GṛŚrS.;\nto be ready for, submit to (dat.), AV.;\nto be fit for, partake of, attain to (dat. or loc.), Āpast.; TUp.;\n (राध्यति) to prophesy to (dat.), Pāṇ. i, 4, 39, Kāś.;\nto accomplish, perform, achieve, make ready, prepare, carry out, RV.; VS.; Br.;\nto hit, get at (acc.), TS.;\nto propitiate, conciliate, gratify, RV.; AitBr.;\nto hurt, injure, destroy, exterminate, Bhaṭṭ. (cf. Pāṇ. vi, 4, 123) :\nPass. राध्यते (aor. अ॑राधि), to be conciliated or satisfied, RV. (cf. राध्यते above) :\nCaus. राध॑यति (aor. अरीरधत्, Br.; Pass. राध्यते, MBh.),\nto accomplish, perform, prepare, make ready, AV. &c. &c.;\nto make favourable, propitiate, satisfy, TS.; TBr. :\nDesid. of Caus. रिराधयिषति, Br. :\nDesid. रिरात्सति or -रित्सति, Pāṇ. vii, 4, 54, Vārtt. 1, Pat. :\nIntens. राराध्यते, राराद्धि Gr.", "gloss_language": "en"}, {"gloss": "राध् [cf. √ इरध्; Goth. garêdan, rathjō; Slav. raditi.]", "gloss_language": "en"}]}], "raDita": [{"id": "raDita", "headword": "रधित", "headword_slp1": "raDita", "fold": "raDita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रधित mfn. injured, hurt, MW.", "gloss_language": "en"}]}], "raDitf": [{"id": "raDitf", "headword": "रधितृ", "headword_slp1": "raDitf", "fold": "raDitf", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रधितृ mfn. injurious, hurtful, ib.", "gloss_language": "en"}]}], "raDra": [{"id": "raDra", "headword": "रध्र", "headword_slp1": "raDra", "fold": "raDra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रध्र॑ mfn. willing, pliant, obedient, RV. (others ‘weary’ or ‘wealthy’ or ‘a miser’ or ‘officious’ or ‘active’ &c.)", "gloss_language": "en"}]}], "raDracoda": [{"id": "raDracoda", "headword": "रध्रचोद", "headword_slp1": "raDracoda", "fold": "raDracoda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रध्र—चोद॑ or रध्र—चोदन॑, mfn. furthering or encouraging the obedient, RV.", "gloss_language": "en"}]}], "raDracodana": [{"id": "raDracodana", "headword": "रध्रचोदन", "headword_slp1": "raDracodana", "fold": "raDracodana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रध्र—चोद॑ or रध्र—चोदन॑, mfn. furthering or encouraging the obedient, RV.", "gloss_language": "en"}]}], "raDratur": [{"id": "raDratur", "headword": "रध्रतुर्", "headword_slp1": "raDratur", "fold": "raDratur", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रध्र—तु॑र् mfn. (prob.) id., ib.", "gloss_language": "en"}]}], "raDa": [{"id": "rADa", "headword": "राध", "headword_slp1": "rADa", "fold": "raDa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राध m. n. = रा॑धस्, a gift, favour (only in राधानाम् पतिः N. of Indra), RV.", "gloss_language": "en"}, {"gloss": "राध m. (fr. राधा) N. of the month Vaiśākha (= April-May), Rājat.", "gloss_language": "en"}, {"gloss": "of a man, Buddh.", "gloss_language": "en"}, {"gloss": "(with गौतम) N. of two teachers, Cat.", "gloss_language": "en"}], "synonyms": ["राधः"], "synonyms_slp1": ["rADaH"]}, {"id": "rADA", "headword": "राधा", "headword_slp1": "rADA", "fold": "raDa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राधा f. See below.", "gloss_language": "en"}, {"gloss": "राधा f. prosperity, success, L.", "gloss_language": "en"}, {"gloss": "(also du.) N. of the 21st Nakṣatra Viśākhā (containing 4 stars in the form of a curve supposed to be α, ι, ν Librae, and γ Scorpionis, cf. नक्षत्र), L.", "gloss_language": "en"}, {"gloss": "lightning, L.", "gloss_language": "en"}, {"gloss": "a partic. attitude in shooting (standing with the feet a span apart; cf. -भेधिन्, -वेधिन्), Pracaṇḍ.", "gloss_language": "en"}, {"gloss": "Emblic Myrobolan, L.", "gloss_language": "en"}, {"gloss": "Clitoria Ternatea, L.", "gloss_language": "en"}, {"gloss": "N. of the foster-mother of Karṇa (q.v.; she was the wife of Adhiratha, who was Sūta or charioteer of king Śūra), MBh. (cf. IW. 377)", "gloss_language": "en"}, {"gloss": "of a celebrated cowherdess or Gopī (beloved by Kṛṣṇa, and a principal personage in Jaya-deva's poem Gītagovinda; at a later period worshipped as a goddess, and occasionally regarded as an Avatāra of Lakṣmī, as Kṛṣṇa is of Viṣṇu; also identified with Dākṣāyaṇī), Gīt.; Pañcat. &c. (cf. IW. 332)", "gloss_language": "en"}, {"gloss": "of a female slave, Lalit.", "gloss_language": "en"}]}], "raDagupta": [{"id": "rADagupta", "headword": "राधगुप्त", "headword_slp1": "rADagupta", "fold": "raDagupta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राध—गुप्त m. (for राधा-ग्˚; cf. Pāṇ. vi, 3, 63) N. of a minister of Aśoka, Buddh.", "gloss_language": "en"}]}], "raDaraNka": [{"id": "rADaraNka", "headword": "राधरङ्क", "headword_slp1": "rADaraNka", "fold": "raDaraNka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राध—रङ्क m. = सीर, सीरक, and घनोपल, L.", "gloss_language": "en"}], "synonyms": ["राधरङ्कः"], "synonyms_slp1": ["rADaraNkaH"]}], "raDaraNku": [{"id": "rADaraNku", "headword": "राधरङ्कु", "headword_slp1": "rADaraNku", "fold": "raDaraNku", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राध—रङ्कु m. = सार, सीकर, and जलदोपल.", "gloss_language": "en"}]}], "raDaka": [{"id": "rADaka", "headword": "राधक", "headword_slp1": "rADaka", "fold": "raDaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राधक mfn. liberal, bountiful, MW.", "gloss_language": "en"}]}], "raDana": [{"id": "rADana", "headword": "राधन", "headword_slp1": "rADana", "fold": "raDana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राधन n. (only L.), propitiating, conciliating", "gloss_language": "en"}, {"gloss": "pleasure, satisfaction", "gloss_language": "en"}, {"gloss": "obtaining, acquisition", "gloss_language": "en"}, {"gloss": "the means or instrument of accomplishing anything (-द्रव्य n. = पाचल)", "gloss_language": "en"}], "synonyms": ["राधनं"], "synonyms_slp1": ["rADanaM"]}, {"id": "rADanA", "headword": "राधना", "headword_slp1": "rADanA", "fold": "raDana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "राधना f. speech, L.", "gloss_language": "en"}]}], "raDani": [{"id": "rADanI", "headword": "राधनी", "headword_slp1": "rADanI", "fold": "raDani", "headword_language": "sa", "source": "mw-co