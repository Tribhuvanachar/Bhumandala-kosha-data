{"vaYc": [{"id": "vaYc", "headword": "वञ्च्", "headword_slp1": "vaYc", "fold": "vaYc", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वञ्च् (cf. √ 2. वक्) cl. 1. P. (Dhātup. vii, 7) व॑ञ्चति (Gr. also pf. ववञ्च; fut. वञ्चि॑त, ˚चिष्यति; aor. अवञ्चीत्; Prec. वच्यात्; inf. वञ्चि॑तुम्; ind.p. वञ्चित्वा, वचित्वा, or वक्त्वा),\nto move to and fro, go crookedly, totter, stagger, waver, AV.; VS.; ŚBr.; ŚāṅkhŚr.;\nto go, go to, arrive at (acc.), Bhaṭṭ.;\nto go slyly or secretly, sneak along, VS.;\nto pass over, wander over, go astray, MW. :\nPass. वच्य॑ते, to move or rock to and fro, hurry along, speed, RV.; AV.;\nto be moved (in the heart), be poured forth, issue forth (as hymns or prayers), RV. :\nCaus. वञ्चयति, ˚ते (aor. अववञ्चत्), to move or go away from, avoid, shun, escape (mostly P. and with acc.), MBh.; Kāv. &c.;\nto cause to go astray, deceive, cheat, defraud of (instr. or abl.; in these senses more properly Ā., but sometimes also P.; Pass. वञ्च्यते), ib. :\nDesid. विवञ्चिषते Gr.:\nIntens. वनीवच्यते, वनीवञ्चीति, ib.", "gloss_language": "en"}], "synonyms": ["वंच्"], "synonyms_slp1": ["vaMc"]}], "vaYcaka": [{"id": "vaYcaka", "headword": "वञ्चक", "headword_slp1": "vaYcaka", "fold": "vaYcaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वञ्चक mf(आ)n. (fr. Caus.) deceiving, a deceiver, fraudulent, crafty, Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "वञ्चक m. a jackal, Vās.; Hit.", "gloss_language": "en"}, {"gloss": "a tame or house-ichneumon, L.", "gloss_language": "en"}, {"gloss": "a low or vile man, W.", "gloss_language": "en"}], "synonyms": ["वंचक", "वञ्चकः"], "synonyms_slp1": ["vaMcaka", "vaYcakaH"]}], "vaYcaTa": [{"id": "vaYcaTa", "headword": "वञ्चथ", "headword_slp1": "vaYcaTa", "fold": "vaYcaTa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वञ्चथ m. (only L.) deceit", "gloss_language": "en"}, {"gloss": "a deceiver", "gloss_language": "en"}, {"gloss": "the Indian cuckoo", "gloss