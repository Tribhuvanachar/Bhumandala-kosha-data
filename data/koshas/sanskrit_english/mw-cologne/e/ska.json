{"skand": [{"id": "skand", "headword": "स्कन्द्", "headword_slp1": "skand", "fold": "skand", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्कन्द् (cf. स्कन्ध् and स्कुन्द्) cl. 1. P. (Dhātup. xxiii, 10) स्कन्दति (mc. also ˚ते; चस्क॑न्द, RV. &c.; चस्कन्दे, MBh. &c.; aor. अस्कन्, स्क॑न्, RV.; अ॑स्कान्, स्कान्, Br.; अस्कान्त्सीत्, ib.; अस्कदत् Gr.; Prec. स्कद्यात्, ib.; fut. स्कन्त्ता, ib.; स्कन्त्स्यति, Br.; inf. स्कन्दितुम् Gr.; -स्क॑दे, -स्क॑दस्, RV.; ind.p. स्कन्त्त्वा Gr.; -स्क॑न्द्य or -स्क॑द्य, Br.; -स्क॑न्दम्, AV.; Br.),\nto leap, jump, hop, dart, spring, spurt out, be spilt or effused (esp. said of semen), RV. &c. &c.;\n (Ā.) to emit seminal fluid, VP.;\nto leap upon, cover (said of animals), TBr.; ŚBr.;\nto drop, fall down, perish, be lost, BhP. :\nPass. स्कद्यते (perf. चस्कदे or चस्कन्दे; aor. अस्कन्दि) Gr.:\nCaus. स्कन्दयति (mc. also ˚ते; aor. अचस्क॑न्दत्),\nto cause to jump or leap, R. (in explaining स्कन्द);\nto pour out, effuse, shed, spill, emit (esp. seminal fluid), AitBr.; Mn.;\nto omit, neglect, Mn.; MBh. &c.;\nto cause to coagulate, thicken, Suśr. :\nDesid. चिस्कन्त्सति, Gr.:\nIntens. चनीस्कद्यते, चनीस्कन्दीति (Gr.), क॑निष्कन्, -चनिष्कदत्;\n (RV.), to leap, jump, hop &c.", "gloss_language": "en"}, {"gloss": "स्कन्द्, [Cf. Gk. σκάνδαλον; Lat. scando, de-scendo; scāla for scant(s)la.]", "gloss_language": "en"}], "synonyms": ["स्कंद्"], "synonyms_slp1": ["skaMd"]}], "skantf": [{"id": "skanttf", "headword": "स्कन्त्तृ", "headword_slp1": "skanttf", "fold": "skantf", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्कन्त्तृ mfn. one who leaps &c. (see विष्कन्त्तृ).", "gloss_language": "en"}]}], "skanda": [{"id": "skanda", "headword": "स्कन्द", "headword_slp1": "skanda", "fold": "skanda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्कन्द॑ m. anything which jumps or hops (in तृण-स्कन्द॑, ‘grasshopper’, N. of a man), RV.", "gloss_language": "en"}, {"gloss": "spurting, effusing, effusion, spilling, shedding (cf. अ॑ and घ्रण-स्क्˚)", "gloss_language": "en"}, {"gloss": "perishing, destruction, Gīt.", "gloss_language": "en"}, {"gloss": "quick-silver, L.", "gloss_language": "en"}, {"gloss": "‘Attacker’, N. of Kārttikeya (q.v., son of Śiva or of Agni; he is called god of war as leader of Śiva's hosts against the enemies of the gods ; he is also leader of the demons of illness that attack children [cf. -ग्रह], also god of burglars and thieves; cf. -पुत्र and IW. 427 n. 1), MaitrS.; MBh. &c.", "gloss_language": "en"}, {"gloss": "N. of Śiva, MBh.", "gloss_language": "en"}, {"gloss": "a king prince, L.", "gloss_language": "en"}, {"gloss": "a clever or learned man (cf. स्कन्ध), L.", "gloss_language": "en"}, {"gloss": "the body, L.", "gloss_language": "en"}, {"gloss": "the जादि (pl. Saṃskārak.)", "gloss_language": "en"}], "synonyms": ["स्कंद", "स्कंदः", "स्कन्दः"], "synonyms_slp1": ["skaMda", "skaMdaH", "skandaH"]}, {"id": "skAnda", "headword": "स्कान्द", "headword_slp1": "skAnda", "fold": "skanda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्कान्द mfn. relating to Skanda &c., Sarvad.", "gloss_language": "en"}, {"gloss": "composed by Skanda-svāmin (-भाष्य n. N. of a Commentary)", "gloss_language": "en"}, {"gloss": "स्कान्द n. (with or scil. पुराण) N. of the Skanda-purāṇa.", "gloss_language": "en"}], "synonyms": ["स्कांद", "स्कान्दं"], "synonyms_slp1": ["skAMda", "skAndaM"]}], "skandakavaca": [{"id": "skandakavaca", "headword": "स्कन्दकवच", "headword_slp1": "skandakavaca", "fold": "skandakavaca", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्कन्द—कवच n. N. of wk.", "gloss_language": "en"}]}], "skandagupta": [{"id": "skandagupta", "headword": "स्कन्दगुप्त", "headword_slp1": "skandagupta", "fold": "skandagupta", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्कन्द—गुप्त m. N. of a king, Inscr.; Vās., Introd.", "gloss_language": "en"}, {"gloss": "of an elephant-keeper