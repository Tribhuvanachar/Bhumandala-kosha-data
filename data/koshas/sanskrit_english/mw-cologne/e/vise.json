{"visecaka": [{"id": "visecaka", "headword": "विसेचक", "headword_slp1": "visecaka", "fold": "visecaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—सेचक mfn. = विगतः सेचको यस्मात्, Pat.", "gloss_language": "en"}]}], "visesa": [{"id": "viSeza", "headword": "विशेष", "headword_slp1": "viSeza", "fold": "visesa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-शेष m. (once in Pañcat. n.; ifc. f(आ). ) distinction, difference between (two gen., two loc., or gen. and instr.), GṛŚrS.; MBh. &c.", "gloss_language": "en"}, {"gloss": "characteristic difference, peculiar mark, special property, speciality, peculiarity, Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "a kind, species, individual (e.g. वृक्ष-व्˚, a species of tree, in comp. often also = special, peculiar, particular, different, e.g. छन्दो-व्˚, ‘a particular metre’, विशेष-मण्डन, ‘a peculiar ornament’; अर्घ-विशेषाः, ‘different prices’), MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "(pl.) various objects, Megh.", "gloss_language": "en"}, {"gloss": "distinction, peculiar merit, excellence, superiority (in comp. often = excellent, superior, choice, distinguished, e.g. आकृति-व्˚, ‘an excellent form’ ; cf. विशेष-प्रतिपत्ति), Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "(in gram.) a word which defines or limits the meaning of another word (cf. वि-शेषक and वि-शेषण)", "gloss_language": "en"}, {"gloss": "(in phil.) particularity, individuality, essential difference or individual essence (with the Vaiśeṣikas the 5th category or Padārtha, belonging to the 9 eternal substances or Dravyas, viz. soul, time, place, ether, and the 5 atoms of earth, water, light, air, and mind, which are said to be so essentially different that one can never be the other), IW. 66 &c.", "gloss_language": "en"}, {"gloss": "(in medicine) a favourable turn or crisis of a sickness, Suśr.", "gloss_language": "en"}, {"gloss": "(in rhet.) statement of difference or distinction, individualization, variation, Kuval. (cf. विशेषोक्ति)", "gloss_language": "en"}, {"gloss": "a sectarian mark, any mark on the forehead (= तिलक), L.", "gloss_language": "en"}, {"gloss": "(in geom.) the hypotenuse, Śulbas.", "gloss_language": "en"}, {"gloss": "N. of the primary elements or Mahā-bhūtas (q.v.), MaitrUp.", "gloss_language": "en"}, {"gloss": "the earth as an element, BhP.", "gloss_language": "en"}, {"gloss": "the mundane egg, ib.", "gloss_language": "en"}, {"gloss": "= विराज्, ib.", "gloss_language": "en"}, {"gloss": "वि-शेष mf(आ)n. extraordinary, abundant, Ragh. ii, 14 (B. विशेषात् for विशेषा)", "gloss_language": "en"}, {"gloss": "वि-शेष &c. See p. 990, col. 2.", "gloss_language": "en"}], "synonyms": ["विशेषः"], "synonyms_slp1": ["viSezaH"]}], "visesena": [{"id": "viSezena", "headword": "विशेषेन", "headword_slp1": "viSezena", "fold": "visesena", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-शेषेन ind. or ibc. (exceedingly, especially, particularly, even more, Mn.; MBh. &c.; येन येन विशेषेण, in any way whatever, MBh.)", "gloss_language": "en"}]}], "visesat": [{"id": "viSezAt", "headword": "विशेषात्", "headword_slp1": "viSezAt", "fold": "visesat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-शेषात् ind. (exceedingly, especially, particularly, even more, Mn.; MBh. &c.; आत् ifc., by reason or in consequence of VarBṛS.)", "gloss_language": "en"}]}], "visesakaraRa": [{"id": "viSezakaraRa", "headword": "विशेषकरण", "headword_slp1": "viSezakaraRa", "fold": "visesakaraRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-शेष—करण n. making better, improvement, Mālav.", "gloss_language": "en"}]}], "visesakft": [{"id": "viSezakft", "headword": "विशेषकृत्", "headword_slp1": "viSezakft", "fold": "visesakft", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-शेष—कृत् mfn. making a distinction, distinguishing, RPrāt.", "gloss_language": "en"}]}], "visesagarhaRiya