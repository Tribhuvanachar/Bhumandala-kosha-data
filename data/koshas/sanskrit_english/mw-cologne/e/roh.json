ord_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहाय (fr. रोहत्) Nom. Ā. ˚यते, g. भृशादि.", "gloss_language": "en"}]}], "rohin": [{"id": "rohin", "headword": "रोहिन्", "headword_slp1": "rohin", "fold": "rohin", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहिन् mf(इणी)n. rising, Nir.", "gloss_language": "en"}, {"gloss": "(ifc.) mounting, ascending towards, Śiś.", "gloss_language": "en"}, {"gloss": "grown, shot up, long, tall, MBh.", "gloss_language": "en"}, {"gloss": "(ifc.) grown on or in R.; Ragh.", "gloss_language": "en"}, {"gloss": "growing, increasing (in number), Nidānas.", "gloss_language": "en"}, {"gloss": "रोहिन् m. Andersonia Rohitaka, L.", "gloss_language": "en"}, {"gloss": "Ficus Indica and Religiosa, L.", "gloss_language": "en"}, {"gloss": "रोहिन् mf(इणी)n. See under रोह, col. 2.", "gloss_language": "en"}]}], "rohiRi": [{"id": "rohiRI", "headword": "रोहिणी", "headword_slp1": "rohiRI", "fold": "rohiRi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहिणी (इणी), f., see s.v.", "gloss_language": "en"}, {"gloss": "रोहिणी f. See below.", "gloss_language": "en"}, {"gloss": "रो॑हिणी f. (f. of रोहित, ‘red’, below; also f. of रोहिन् above) a red cow or [later] any cow (represented as a daughter of Surabhi and mother of cattle, esp. of Kāma-dhenu, ‘cow of plenty’; in the Veda, Rohiṇī may perhaps also mean ‘a red mare’), RV. &c. &c.", "gloss_language": "en"}, {"gloss": "N. of the ninth Nakṣatra or lunar asterism and of the lunar day belonging to it (in this sense it may optionally have the accent on the last syllable; it is personified as a daughter of Dakṣa, and as the favourite wife of the Moon, called ‘the Red one’ from the colour of the star Aldebaran or principal star in the constellation which contains 5 stars, prob. α, β, γ, δ, ε, Tauri, and is figured by a wheeled vehicle or sometimes by a temple or fish; it is exceptionally pl., and in TS. & TBr. there are 2 Nakṣatras of this name; it may also be used as an adj. and mean ‘born under the Nakṣatra Rohiṇī’, Pāṇ. iv, 3, 34, Vārtt. 1)", "gloss_language": "en"}, {"gloss": "lightning, L.", "gloss_language": "en"}, {"gloss": "a young girl (in whom menstruation has just commenced; others ‘a girl nine years of age’), Gṛhyās.; Pañcat.", "gloss_language": "en"}, {"gloss": "N. of various plants, Suśr.; Bhpr. (= Helleborus Niger; Acacia Arabica; Gmelina Arborea &c., L.)", "gloss_language": "en"}, {"gloss": "inflammation of the throat (of various kinds), Suśr.", "gloss_language": "en"}, {"gloss": "(in music) a partic. Śruti, Saṃgīt.", "gloss_language": "en"}, {"gloss": "a partic. Mūrchanā, ib.", "gloss_language": "en"}, {"gloss": "a kind of steel, L.", "gloss_language": "en"}, {"gloss": "N. of two wives of Vasudeva and the mother of Bala-rāma, MBh.; Pur.", "gloss_language": "en"}, {"gloss": "of a wife of Kṛṣṇa, Hariv.", "gloss_language": "en"}, {"gloss": "of the wife of Mahā-deva, Pur.", "gloss_language": "en"}, {"gloss": "of a daughter of Hiraṇya-kaśipu, MBh.", "gloss_language": "en"}, {"gloss": "of one of the 16 Vidyā-devīs, L.", "gloss_language": "en"}, {"gloss": "of a river, VP.", "gloss_language": "en"}]}, {"id": "rohiRi", "headword": "रोहिणि", "headword_slp1": "rohiRi", "fold": "rohiRi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहिणि f. (mc. and ibc.) = रोहिणी.", "gloss_language": "en"}], "synonyms": ["रोहिणिः"], "synonyms_slp1": ["rohiRiH"]}], "rohisyE": [{"id": "rohizyE", "headword": "रोहिष्यै", "headword_slp1": "rohizyE", "fold": "rohisyE", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रो॑हिष्यै See √ 1. रुह्.", "gloss_language": "en"}]}], "rohi": [{"id": "rohi", "headword": "रोहि", "headword_slp1": "rohi", "fold": "rohi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहि m. (prob. fr. a √ रुह् for 4. रुध्, ‘to be red’) a kind of deer, R.", "gloss_language": "en"}, {"gloss": "(only L.) a seed", "gloss_language": "en"}, {"gloss": "a tree", "gloss_language": "en"}, {"gloss": "a pious or religious man (= व्रतिन्).", "gloss_language": "en"}], "synonyms": ["रोहिः"], "synonyms_slp1": ["rohiH"]}, {"id": "rohI", "headword": "रोही", "headword_slp1": "rohI", "fold": "rohi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोही f. a doe, MBh. (v.l. रौही)", "gloss_language": "en"}, {"gloss": "N. of a river, ib.", "gloss_language": "en"}]}], "rohimansa": [{"id": "rohimAMsa", "headword": "रोहिमांस", "headword_slp1": "rohimAMsa", "fold": "rohimansa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहि—मांस n. the flesh of the deer called Rohi, R.", "gloss_language": "en"}]}], "rohiRa": [{"id": "rohiRa", "headword": "रोहिण", "headword_slp1": "rohiRa", "fold": "rohiRa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहिण mfn. born under the asterism Rohiṇī, Pāṇ. iv, 3, 37, Sch.", "gloss_language": "en"}, {"gloss": "रोहिण m. N. of Viṣṇu, Hariv.", "gloss_language": "en"}, {"gloss": "of a man g. अश्वादि (pl. his descendants, ĀśvŚr.)", "gloss_language": "en"}, {"gloss": "of various plants, Mālatīm. (Andersonia Rohitaka; Ficus Indica; Andropogon Schoenanthus, L.)", "gloss_language": "en"}, {"gloss": "रोहिण n. N. of the ninth Muhūrta (a part of the forenoon extending to midday, in which Śrāddhas are especially to be performed), W.", "gloss_language": "en"}], "synonyms": ["रोहिणं", "रोहिणः"], "synonyms_slp1": ["rohiRaM", "rohiRaH"]}], "rohiRitva": [{"id": "rohiRitva", "headword": "रोहिणित्व", "headword_slp1": "rohiRitva", "fold": "rohiRitva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहिणि—त्व n. = रोहिणी-त्व, TBr. (cf. Pāṇ. vi, 3, 64, Sch.)", "gloss_language": "en"}]}, {"id": "rohiRItva", "headword": "रोहिणीत्व", "headword_slp1": "rohiRItva", "fold": "rohiRitva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "रोहिणी—त्व॑ n. the state or condition of the Nakṣatr