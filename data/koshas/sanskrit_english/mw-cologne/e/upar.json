aH"]}], "uparaja": [{"id": "uparAja", "headword": "उपराज", "headword_slp1": "uparAja", "fold": "uparaja", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उप-राज m. a viceroy g. काश्यादि, Pāṇ. iv, 2, 116.", "gloss_language": "en"}], "synonyms": ["उपराजः"], "synonyms_slp1": ["uparAjaH"]}], "uparajam": [{"id": "uparAjam", "headword": "उपराजम्", "headword_slp1": "uparAjam", "fold": "uparajam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उप-राजम् ind. near a king, Pāṇ. v, 4, 108, Kāś.", "gloss_language": "en"}]}], "uparaDaya": [{"id": "uparADaya", "headword": "उपराधय", "headword_slp1": "uparADaya", "fold": "uparaDaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उप-राधय mfn. (√ राध्), propitiating, doing homage g. ब्राह्मणादि, Pāṇ. v, 1, 124.", "gloss_language": "en"}]}], "uparamam": [{"id": "uparAmam", "headword": "उपरामम्", "headword_slp1": "uparAmam", "fold": "uparamam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उप-रामम् ind. near Rāma, T.", "gloss_language": "en"}]}], "upari": [{"id": "upari", "headword": "उपरि", "headword_slp1": "upari", "fold": "upari", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उप॑रि ind. (as a separable adverb) above, upon, on, upwards, towards the upper side of (opposed to अधस् and नीचा, e.g. उपरि-√ या, to go upwards; sometimes written with a following word as if compounded with it, see below);", "gloss_language": "en"}, {"gloss": "besides, in addition to, further (सहस्रं शतान्य् उपरि चाष्टौ, 1000 and 800 in addition)", "gloss_language": "en"}, {"gloss": "afterwards (e.g. उपरि पयः पिबेत्, he should drink milk afterwards)", "gloss_language": "en"}, {"gloss": "उपर्य् उपरि, higher and higher", "gloss_language": "en"}, {"gloss": "repeatedly, continuously, RV. &c. (As a separable preposition, with acc. loc., or gen.) over, above, upon, on, at the head of, on the upper side of, beyond (e.g. उपरि शैलं-√ गम्, to go over the mountain; उपरि लङ्कायां सम्प्राप्तः सः, he arrived over Laṅkā; उपर्य् उपरि सर्वेषाम् अतिष्ठत्, he stood at the very head of all; आत्मानं तस्य उपरि क्षिप्त्वा, having thrown himself upon him)", "gloss_language": "en"}, {"gloss": "in connection with, with reference to, with regard to, towards (with gen., e.g. ममोपरि विकारितः, changed in feeling with regard to me; पुत्रस्योपरि क्रुद्धः, enraged towards his son)", "gloss_language": "en"}, {"gloss": "after (with abl., e.g. मुहूर्ताद् उपरि, after a minute; see also तद्-उपरि &c.), RV. &c.;", "gloss_language": "en"}, {"gloss": "उपरि [cf. Zend upairi; Goth. ufar; Old Germ. obar; Mod. Germ. über; Eng. over; Gk. ὑπέρ; Lat. super.]", "gloss_language": "en"}, {"gloss": "उपरि may stand first in a compound, as in the following examples:", "gloss_language": "en"}]}], "uparikaRqa": [{"id": "uparikARqa", "headword": "उपरिकाण्ड", "headword_slp1": "uparikARqa", "fold": "uparikaRqa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उपरि—काण्ड n. the third division of the Maitrāyaṇī Saṃhitā.", "gloss_language": "en"}]}], "uparikuwi": [{"id": "uparikuwI", "headword": "उपरिकुटी", "headword_slp1": "uparikuwI", "fold": "uparikuwi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उपरि—कुटी f. an upper room, L.", "gloss_language": "en"}]}], "upariga": [{"id": "upariga", "headword": "उपरिग", "headword_slp1": "upariga", "fold": "upariga", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उपरि—ग mfn. moving or soaring above, BhP.", "gloss_language": "en"}]}], "uparigata": [{"id": "uparigata", "headword": "उपरिगत", "headword_slp1": "uparigata", "fold": "uparigata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "उपरि—गत mfn. gone up, ascended, BhP.", "gloss_language": "en"}]}], "uparicara": [{"id": "uparicara", "headword": "उपरिचर", "headword_slp1": "uparicara", "fold": "uparicara", "headword_language": "sa", "source": "mw-cologne", "sense