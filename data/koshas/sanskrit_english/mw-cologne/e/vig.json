.", "gloss_language": "en"}]}], "viganDaka": [{"id": "viganDaka", "headword": "विगन्धक", "headword_slp1": "viganDaka", "fold": "viganDaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गन्˚धक m. Terminalia Catappa, L.", "gloss_language": "en"}], "synonyms": ["विगंधक", "विगंधकः", "विगन्धकः"], "synonyms_slp1": ["vigaMDaka", "vigaMDakaH", "viganDakaH"]}], "viganDika": [{"id": "viganDikA", "headword": "विगन्धिका", "headword_slp1": "viganDikA", "fold": "viganDika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गन्धिका f. = हपुषा, L.", "gloss_language": "en"}]}], "viganDi": [{"id": "viganDi", "headword": "विगन्धि", "headword_slp1": "viganDi", "fold": "viganDi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गन्˚धि mfn. ill-smelling, stinking, Bhartṛ.", "gloss_language": "en"}]}], "vigara": [{"id": "vigara", "headword": "विगर", "headword_slp1": "vigara", "fold": "vigara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गर m. ‘not swallowing’, an abstemious man, W.", "gloss_language": "en"}, {"gloss": "a naked ascetic, ib.", "gloss_language": "en"}, {"gloss": "a mountain, ib.", "gloss_language": "en"}], "synonyms": ["विगरः"], "synonyms_slp1": ["vigaraH"]}], "vigarBa": [{"id": "vigarBA", "headword": "विगर्भा", "headword_slp1": "vigarBA", "fold": "vigarBa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गर्भा f. delivered of a living child or fetus, MBh.", "gloss_language": "en"}]}], "vigaTa": [{"id": "vigATA", "headword": "विगाथा", "headword_slp1": "vigATA", "fold": "vigaTa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गाथा and 1.", "gloss_language": "en"}]}], "vigiti": [{"id": "vigIti", "headword": "विगीति", "headword_slp1": "vigIti", "fold": "vigiti", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि—गीति (for 2. See वि-√ गै) f. two kinds of the Āryā metre, Col.", "gloss_