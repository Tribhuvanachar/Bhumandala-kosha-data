loss_language": "en"}, {"gloss": "(in gram.) independence (of a word, as opp. to composition), APrāt.", "gloss_language": "en"}, {"gloss": "separation, resolution, analysis, resolution of a compound word into its constituent parts, the separation or analysis of any word capable of separation (such words are Kṛdantas, Taddhitas, all Samāsas or compound words, Ekaśeṣas, and all derivative verbs like desideratives &c.; the only words incapable of resolution being the simple verb, the singular of the noun, and a few indeclinables not derived from roots; all compounds being called नित्य or ‘fixed’, when their meaning cannot be ascertained through an analysis of their component parts; cf. जमद्-अग्नि), Pāṇ., Sch.; Śaṃk. &c.", "gloss_language": "en"}, {"gloss": "discord, quarrel, contest, strife, war with (instr. with or without सह, सार्धम् or साकम् loc. gen. with उपरि, or comp.), Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "(one of the 6 Guṇas or measures of policy, Mn. vii, 160 [cf. under गुण], also applied to the conflict of hostile planets, in this sense also n., Sūryas.; R.; acc. with √ कृ, to make or wage war)", "gloss_language": "en"}, {"gloss": "separate i.e. individual form or shape, form, figure, the body, Up.; MBh. &c. (also applied to the shape of a rainbow; acc. with √ ग्रह्, परि-√ ग्रह्, √ कृ, उपा-√ दा, to assume a form)", "gloss_language": "en"}, {"gloss": "an ornament, decoration, MBh.; R.", "gloss_language": "en"}, {"gloss": "(in Sāṃkhya) an element", "gloss_language": "en"}, {"gloss": "N. of Śiva, MBh.", "gloss_language": "en"}, {"gloss": "of one of Skanda's attendants, ib.", "gloss_language": "en"}], "synonyms": ["विग्रहः"], "synonyms_slp1": ["vigrahaH"]}, {"id": "vigrAha", "headword": "विग्राह", "headword_slp1": "vigrAha", "fold": "vigraha", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-ग्राह m. a partic. kind of recitation, ĀśvŚr., Sch.", "gloss_language": "en"}]}], "vigriva": [{"id": "vigrIva", "headword": "विग्रीव", "headword_slp1": "vigrIva", "fold": "vigriva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि॑—ग्रीव (वि॑-), mfn. having the neck twisted or cut off, RV.", "gloss_language": "en"}]}], "vigaR": [{"id": "vigaR", "headword": "विगण्", "headword_slp1": "vigaR", "fold": "vigaR", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-√ गण् P. -गणयति (ind.p. -गणय्य),\nto reckon, compute, calculate (Pass. to be reckoned i.e. amount to), Yājñ.; R.;\nto deliberate, consider, ponder, MBh.; Kāv. &c.;\nto regard as, take for (with double acc.), Ragh.; Kathās.;\nto esteem, regard (अ-विगणय्य, ‘not taking notice of’), Kād.; BhP.;\nto disregard, take no notice of Pañcat.; BhP.", "gloss_language": "en"}]}], "vigaRana": [{"id": "vigaRana", "headword": "विगणन", "headword_slp1": "vigaRana", "fold": "vigaRana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-˚गणन n. paying off, discharge (of a debt), Pāṇ. i, 3, 36", "gloss_language": "en"}, {"gloss": "reckoning, computing, W.", "gloss_language": "en"}, {"gloss": "considering, deliberating, ib.", "gloss_language": "en"}], "synonyms": ["विगणनं"], "synonyms_slp1": ["vigaRanaM"]}], "vigaRita": [{"id": "vigaRita", "headword": "विगणित", "headword_slp1": "vigaRita", "fold": "vigaRita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-˚गणित mfn. reckoned, calculated, W.", "gloss_language": "en"}, {"gloss": "considered, weighed, ib.", "gloss_language": "en"}, {"gloss": "reckoned off, discharged (as a debt), ib.", "gloss_language": "en"}]}], "vigadita": [{"id": "vigadita", "headword": "विगदित", "headword_slp1": "vigadita", "fold": "vigadita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "वि-˚गदित mfn. talked or spoken about, spread abroad (as a report), R.", "gloss_language": "en"}]}], "vigam": [{"id": "vigam", "headword": "विगम्", "headword_slp1": "vigam", "fold": "vigam", "headword_language": "sa", "source": "mw-co