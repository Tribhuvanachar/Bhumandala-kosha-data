": "snapita", "headword": "स्नपित", "headword_slp1": "snapita", "fold": "snapita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्नपित mfn. (fr. id.) bathed, washed, sprinkled, wetted, cleansed, L.", "gloss_language": "en"}], "synonyms": ["स्नपितः"], "synonyms_slp1": ["snapitaH"]}, {"id": "snApita", "headword": "स्नापित", "headword_slp1": "snApita", "fold": "snapita", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्नापित mfn. caused to bathe, attended on while bathed, immersed, MW.", "gloss_language": "en"}]}], "snaya": [{"id": "snaya", "headword": "स्नय", "headword_slp1": "snaya", "fold": "snaya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्नय m. bathing, ablution, lustration, L.", "gloss_language": "en"}], "synonyms": ["स्नयः"], "synonyms_slp1": ["snayaH"]}], "snata": [{"id": "snAta", "headword": "स्नात", "headword_slp1": "snAta", "fold": "snata", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्नात॑ mfn. bathed, washed, cleansed or purified from (abl. or comp.), AV. &c. &c. (n. also impers.)", "gloss_language": "en"}, {"gloss": "immersed or versed in (loc. or comp.), Gaut.; R.; BhP.", "gloss_language": "en"}, {"gloss": "स्नात॑ m. one who has finished his religion, an initiated householder, GṛŚrS.", "gloss_language": "en"}], "synonyms": ["स्नातः"], "synonyms_slp1": ["snAtaH"]}], "snatavat": [{"id": "snAtavat", "headword": "स्नातवत्", "headword_slp1": "snAtavat", "fold": "snatavat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्नात—वत् mfn. having bathed or performed religious ablutions, Śiś.", "gloss_language": "en"}]}], "snatavasya": [{"id": "snAtavasya", "headword": "स्नातवस्य", "headword_slp1": "snAtavasya", "fold": "snatavasya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्नात—वस्य mfn. to be put on after an ablution, KātyŚr.", "gloss_language": "en"}]}], "snatavrata": [{"id": "snAtavrata", "