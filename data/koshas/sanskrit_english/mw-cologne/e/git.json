: "गीत—गङ्गा-धर n. ‘the ocean of songs’, N. of a poem by Kalyāṇa.", "gloss_language": "en"}]}], "gitagirisa": [{"id": "gItagirISa", "headword": "गीतगिरीश", "headword_slp1": "gItagirISa", "fold": "gitagirisa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गीत—गिरीश n. N. of a poem by Rāma.", "gloss_language": "en"}]}], "gitagovinda": [{"id": "gItagovinda", "headword": "गीतगोविन्द", "headword_slp1": "gItagovinda", "fold": "gitagovinda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गीत—गोविन्द n. ‘Govinda (i.e. Kṛṣṇa) celebrated in song’, N. of a lyrical drama by Jayadeva (probably written in the beginning of the twelfth century; it is a mystical erotic poem describing the loves of Kṛṣṇa and the Gopīs, especially of Kṛṣṇa and Rādhā, who is supposed to typify the human soul).", "gloss_language": "en"}]}], "gitajYa": [{"id": "gItajYa", "headword": "गीतज्ञ", "headword_slp1": "gItajYa", "fold": "gitajYa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गीत—ज्ञ mfn. versed in the art of singing, acquainted with songs, Yājñ. iii, 116.", "gloss_language": "en"}]}], "gitanftya": [{"id": "gItanftya", "headword": "गीतनृत्य", "headword_slp1": "gItanftya", "fold": "gitanftya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गीत—नृत्य n. sg. song and dance, R. i, 24, 5", "gloss_language": "en"}, {"gloss": "a particular dance.", "gloss_language": "en"}]}], "gitapustaka": [{"id": "gItapustaka", "headword": "गीतपुस्तक", "headword_slp1": "gItapustaka", "fold": "gitapustaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गीत—पुस्तक n. N. of a collection of songs, Buddh.", "gloss_language": "en"}]}], "gitapustakasangraha": [{"id": "gItapustakasaMgraha", "headword": "गीतपुस्तकसंग्रह", "headword_slp1": "gItapustakasaMgraha", "fold": "gitapustakasangraha", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "गीत—पुस्तक—संग्रह m. id., ib.", "