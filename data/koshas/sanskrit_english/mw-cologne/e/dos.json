{"dosa": [{"id": "doza", "headword": "दोष", "headword_slp1": "doza", "fold": "dosa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. दोष m. evening, darkness (only BhP., where personified as one of the 8 Vasus and husband of Night, vi, 6, 11; 14)", "gloss_language": "en"}, {"gloss": "2. दोष m. rarely n. (√ दुष्) fault, vice, deficiency, want, inconvenience, disadvantage, Up.; Mn.; MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "badness, wickedness, sinfulness, Mn.; R.", "gloss_language": "en"}, {"gloss": "offence, transgression, guilt, crime (acc. with √ ऋ or लभ्, to incur guilt), ŚrS.; Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "damage, harm, bad consequence, detrimental effect (नैष दोषः, there is no harm; कोऽत्र द्˚, what does it matter?), Mn.; MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "accusation, reproach (˚षं√ कृ or ˚षेण-√ गम् with acc., to accuse), R.", "gloss_language": "en"}, {"gloss": "alteration, affection, morbid element, disease (esp. of the 3 humours of the body, viz. पित्त, वायु, and श्लेष्मन्, [cf. त्रिदोष and धातु], applied also to the humours themselves), Suśr.", "gloss_language": "en"}, {"gloss": "(also ˚षक) a calf, L.", "gloss_language": "en"}], "synonyms": ["दोषः"], "synonyms_slp1": ["dozaH"]}, {"id": "dozA", "headword": "दोषा", "headword_slp1": "dozA", "fold": "dosa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दोषा॑ f. See next.", "gloss_language": "en"}, {"gloss": "1. दोषा॑ f. darkness, night, RV.; AV. &c. (˚षा॑म् ind. & ˚षा॑ [instr.; cf. g. स्वर्-आदि] ind. in the evening, at dusk, at night)", "gloss_language": "en"}, {"gloss": "Night personified (and regarded with, Prabh. as wife of Puṣpārṇa and mother of Pradoṣa or Evening, Niśitha [!] or Midnight and Vyuṣṭa or Day-break), BhP. iv, 13, 13; 14 (cf. दोष॑स्, पश्चा-दोष, प्र-दोष, प्रति-दोषम्)", "gloss_language": "en"}, {"gloss": "दोषा॑ ind., [instr.; cf. g. स्वर्-आदि] in the evening, at dusk, at night", "gloss_language": "en"}, {"gloss": "2. दोषा f. (for 1. See 1. दोष) the arm, L.", "gloss_language": "en"}]}], "dosam": [{"id": "dozAm", "headword": "दोषाम्", "headword_slp1": "dozAm", "fold": "dosam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दोषा॑म् ind., in the evening, at dusk, at night", "gloss_language": "en"}]}], "dosakara": [{"id": "dozAkara", "headword": "दोषाकर", "headword_slp1": "dozAkara", "fold": "dosakara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. दोषा—कर m. ‘night-maker’, the moon, Satr.", "gloss_language": "en"}, {"gloss": "2. दोषाकर m. a mine or heap of faults, Kathās.", "gloss_language": "en"}], "synonyms": ["दोषाकरः"], "synonyms_slp1": ["dozAkaraH"]}, {"id": "dozakara", "headword": "दोषकर", "headword_slp1": "dozakara", "fold": "dosakara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दोष—कर mf(ई)n. causing evil or harm, pernicious, Var.", "gloss_language": "en"}]}], "dosaklesi": [{"id": "dozAkleSI", "headword": "दोषाक्लेशी", "headword_slp1": "dozAkleSI", "fold": "dosaklesi", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दोषा—क्लेशी f. ‘fading in the evening’, a kind of plant, L.", "gloss_language": "en"}]}], "dosatana": [{"id": "dozAtana", "headword": "दोषातन", "headword_slp1": "dozAtana", "fold": "dosatana", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दोषा—तन mf(ई)n. (fr. दोषा ind.) nocturnal, at evening, Ragh. xiii, 76.", "gloss_language": "en"}], "synonyms": ["दोषातनः"], "synonyms_slp1": ["dozAtanaH"]}], "dosatilaka": [{"id": "dozAtilaka", "headword": "दोषातिलक", "headword_slp1": "dozAtilaka", "fold": "dosatilaka", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "दोषा—तिलक m. ‘night-ornament’, a lamp, L.", "gloss_language": "en"}], "synonyms": ["दोषातिलकः"], "synonyms_slp1": ["dozAtilakaH"]}], "dosaButa": [{"id": "dozABUta", "headword": "दोषाभूत", "headword_slp1": "dozABUta", "fold": "dosaB