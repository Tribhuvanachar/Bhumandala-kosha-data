{"muh": [{"id": "muh", "headword": "मुह्", "headword_slp1": "muh", "fold": "muh", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. मुह् cl. 4. P. (Dhātup. xxvi, 89) मु॑ह्यति (rarely Ā. ˚ते; pf. मुमोह, Br. &c. ; मुमुहे, MBh.; aor. अमुहत्, Br.; fut. मोहिता, मोग्धा, मोढा Gr.; मोहिष्य॑ति, Br.; मोक्ष्यति Gr.; inf. मुहे॑, RV.; ind.p. मोहित्वा, मुहित्वा; मुग्ध्वा, मूढ्वा Gr.; -मो॑हम् Gr.),\nto become stupefied or unconscious, be bewildered or perplexed, err, be mistaken, go astray, RV. &c., &c.;\nto become confused, fail, miscarry (opp. to √ कॢप्), ŚBr. &c. &c.:\nCaus. मोहयति (mc. also ˚ते; aor., अमूमुहत्; Pass., मोह्यते),\nto stupefy, bewilder, confound, perplex, cause to err or fail, RV. &c. &c.;\n (Ā., with अध्वानम्) to cause to go the wrong way, MBh. :\nDesid. मुमोहिषति, मुमुहिषति, मुमुक्षति Gr.:\nIntens. मोमुह्यते (MBh.), मोमोग्धि and मोमोढि (Gr.), to be greatly bewildered or perplexed.", "gloss_language": "en"}, {"gloss": "2. मुह् (nom. मुक् or मुट्, Pāṇ. viii, 2, 33, Sch.) See मनो-मु॑ह्.", "gloss_language": "en"}]}], "muhira": [{"id": "muhira", "headword": "मुहिर", "headword_slp1": "muhira", "fold": "muhira", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मुहिर m. a fool, blockhead, L. (cf. मुहेर)", "gloss_language": "en"}, {"gloss": "मुहिर m. ‘bewilderer’, N. of the god of love, L.", "gloss_language": "en"}], "synonyms": ["मुहिरः"], "synonyms_slp1": ["muhiraH"]}], "muhu": [{"id": "muhu", "headword": "मुहु", "headword_slp1": "muhu", "fold": "muhu", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मु॑हु or मुहु॑, ind. suddenly, in a moment, RV.; ŚBr.", "gloss_language": "en"}], "synonyms": ["मुहुः"], "synonyms_slp1": ["muhuH"]}], "muhuH": [{"id": "muhuH", "headword": "मुहुः", "headword_slp1": "muhuH", "fold": "muhuH", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मुहुः in comp. = मुहुर्.", "gloss_language": "en"}], "synonyms": ["मुहु"], "synonyms_slp1": ["muhu"]}],