{"moha": [{"id": "moha", "headword": "मोह", "headword_slp1": "moha", "fold": "moha", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मो॑ह m. (√ 1. मुह्; ifc. f(आ). ) loss of consciousness, bewilderment, perplexity, distraction, infatuation, delusion, error, folly, AV. &c. &c. (मोहम्-√ ब्रू, to say anything that leads to error; मोहं-√ या, to fall into error; मोहात् ind. through folly or ignorance)", "gloss_language": "en"}, {"gloss": "fainting, stupefaction, a swoon, MBh.; Kāv. &c.", "gloss_language": "en"}, {"gloss": "(in phil.) darkness or delusion of mind (preventing the discernment of truth and leading men to believe in the reality of worldly objects)", "gloss_language": "en"}, {"gloss": "(with Buddhists) ignorance (one of the three roots of vice, Dharmas. 139)", "gloss_language": "en"}, {"gloss": "a magical art employed to bewilder an enemy (= मोहन), Cat.", "gloss_language": "en"}, {"gloss": "wonder, amazement, L.", "gloss_language": "en"}, {"gloss": "Infatuation personified (as the offspring of Brahmā), VP.", "gloss_language": "en"}], "synonyms": ["मोहं", "मोहः"], "synonyms_slp1": ["mohaM", "mohaH"]}], "mohat": [{"id": "mohAt", "headword": "मोहात्", "headword_slp1": "mohAt", "fold": "mohat", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मोहात् ind., through folly or ignorance", "gloss_language": "en"}]}], "mohakara": [{"id": "mohakara", "headword": "मोहकर", "headword_slp1": "mohakara", "fold": "mohakara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मोह—कर mfn. causing bewilderment, infatuating, ib.", "gloss_language": "en"}]}], "mohakalila": [{"id": "mohakalila", "headword": "मोहकलिल", "headword_slp1": "mohakalila", "fold": "mohakalila", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "मोह—कलिल n. thicket or snare of illusion, Bhag.", "gloss_language": "en"}, {"gloss": "spirituous liquor, L.", "gloss_language": "en"}]}], "mohakarin": [{"id": "mohakArin", "he