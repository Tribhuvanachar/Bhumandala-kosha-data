{"spand": [{"id": "spand", "headword": "स्पन्द्", "headword_slp1": "spand", "fold": "spand", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्पन्द् (often confounded with √ स्यन्द्) cl. 1. Ā. (Dhātup. ii, 13) स्पन्दते (rarely ˚ति; only in pres. base and inf. स्पन्दितुम्; Gr. also pf. पस्पन्दे; fut. स्पन्दिता, स्पन्दिष्यते; aor. अस्पन्दिष्ट),\nto quiver, throb, twitch, tremble, vibrate, quake, palpitate, throb with life, quicken (as a child in the womb), PārGṛ.; Car.; MBh. &c.;\nto kick (as an animal), Br.; ĀśvŚr.;\nto make any quick movement, move, be active, Hariv.;\nto flash into life, come suddenly to life, BhP. :\nCaus. स्पन्दयति (aor. अपस्पन्दत्), to cause to quiver or shake, MBh.;\nto move (trans.), ĀśvŚr. :\nDesid. पिस्पन्दिषते Gr.:\nIntens., See पनिष्पद॑.", "gloss_language": "en"}, {"gloss": "स्पन्द् [cf. Gk. σϕενδόνη, σϕαδασμός, σϕεδανός, σϕοδρός; perhaps also Lat. pendo, pondus.]", "gloss_language": "en"}], "synonyms": ["स्पंद्"], "synonyms_slp1": ["spaMd"]}], "spanda": [{"id": "spanda", "headword": "स्पन्द", "headword_slp1": "spanda", "fold": "spanda", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्पन्द m. throbbing, throb, quiver, pulse, tremor, vibration, motion, activity, Kāv.; Rājat.; BhP.", "gloss_language": "en"}, {"gloss": "N. of a Śaiva wk. by Abhinava-gupta.", "gloss_language": "en"}], "synonyms": ["स्पंद", "स्पंदः", "स्पन्दः"], "synonyms_slp1": ["spaMda", "spaMdaH", "spandaH"]}], "spandakarika": [{"id": "spandakArikA", "headword": "स्पन्दकारिका", "headword_slp1": "spandakArikA", "fold": "spandakarika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्पन्द—कारिका f. N. of a metrical version of the Spandasūtra (q.v.)", "gloss_language": "en"}]}], "spandacaritra": [{"id": "spandacaritra", "headword": "स्पन्दचरित्र", "headword_slp1": "spandacaritra", "fold": "spandacaritra", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स्पन्द—चरित्र n. N. of w