"}]}], "saguRanirguRavada": [{"id": "saguRanirguRavAda", "headword": "सगुणनिर्गुणवाद", "headword_slp1": "saguRanirguRavAda", "fold": "saguRanirguRavada", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गुण—निर्गुण-वाद m. N. of a Vedānta wk.", "gloss_language": "en"}]}], "saguRavati": [{"id": "saguRavatI", "headword": "सगुणवती", "headword_slp1": "saguRavatI", "fold": "saguRavati", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गुण—वती f. N. of wk. (on the mystic power of the letters of the alphabet, ascribed to Śaṃkarācārya), Cat.", "gloss_language": "en"}]}], "saguRin": [{"id": "saguRin", "headword": "सगुणिन्", "headword_slp1": "saguRin", "fold": "saguRin", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गु˚णिन् mfn. having good qualities, virtuous, Bhartṛ.", "gloss_language": "en"}]}], "sagulika": [{"id": "sagulika", "headword": "सगुलिक", "headword_slp1": "sagulika", "fold": "sagulika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गुलिक mfn. along with a pill, Kathās.", "gloss_language": "en"}]}], "saguQam": [{"id": "sagUQam", "headword": "सगूढम्", "headword_slp1": "sagUQam", "fold": "saguQam", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गूढम् ind. secretly, privately, MW.", "gloss_language": "en"}]}], "sagfha": [{"id": "sagfha", "headword": "सगृह", "headword_slp1": "sagfha", "fold": "sagfha", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स॑—गृह (स॑-), mfn. together with one's house or family, with wife and children, ĀpŚr.", "gloss_language": "en"}]}], "sagfhapatika": [{"id": "sagfhapatika", "headword": "सगृहपतिक", "headword_slp1": "sagfhapatika", "fold": "sagfhapatika", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गृह-पतिक mfn. with the householder, ŚāṅkhŚr.", "gloss_language": "en"}]}], "sagotra": [{"id": "sagotra", "headword": "सगोत्र", "headword_slp1": "sagotra", "