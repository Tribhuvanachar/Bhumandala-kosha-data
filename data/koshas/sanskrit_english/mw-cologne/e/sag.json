 "mw-cologne", "senses": [{"gloss": "स—गन्ध mfn. having smell, smelling, Suśr.", "gloss_language": "en"}, {"gloss": "odoriferous, fragrant, W.", "gloss_language": "en"}, {"gloss": "having the same smell as (instr. or comp.), VarBṛS.; Vop. (also ˚धिन्, MBh.)", "gloss_language": "en"}, {"gloss": "related, kin, Śak. (in Prākṛt)", "gloss_language": "en"}, {"gloss": "proud, arrogant, Megh. (v.l. -गर्व).", "gloss_language": "en"}], "synonyms": ["सगंध", "सगन्धः"], "synonyms_slp1": ["sagaMDa", "saganDaH"]}], "saganDarva": [{"id": "saganDarva", "headword": "सगन्धर्व", "headword_slp1": "saganDarva", "fold": "saganDarva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गन्धर्व mfn. together with the Gandharvas, MW.", "gloss_language": "en"}]}], "saganDarvapsaraska": [{"id": "saganDarvApsaraska", "headword": "सगन्धर्वाप्सरस्क", "headword_slp1": "saganDarvApsaraska", "fold": "saganDarvapsaraska", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गन्धर्˚वाप्सरस्क mfn. together with the G˚s and Apsarases, MBh.", "gloss_language": "en"}]}], "sagara": [{"id": "sagara", "headword": "सगर", "headword_slp1": "sagara", "fold": "sagara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "1. स॑—गर (स॑-), mfn. (for 2. &c. See below) accompanied by praise (fr. गर, √ 1. गॄ; said of the fires), VS. (Sch.; accord. to others, ‘swallowing’, ‘devouring’, fr. गर, √ 2. गॄ).", "gloss_language": "en"}, {"gloss": "2. स-गर mfn. (fr. 7. स + गर, ‘poison’, √ 2. गॄ; for 1. स-गर See above) containing poison, poisonous (n. ‘poisonous food’), R.; BhP.", "gloss_language": "en"}, {"gloss": "स-गर m. ‘provided with moisture’, the atmosphere, air, RV.; TS.; Kāṭh. (cf. Naigh. i, 3)", "gloss_language": "en"}, {"gloss": "N. of a king of the solar race, sovereign of Ayodhyā (son of Bāhu;\nhe is said to have been called Sa-gara, as born together with a poison given to his mother by the other wife of his father;\nhe was father of Asamañja by Keśinī and of sixty thousand sons by Su-mati;\nthe latter were turned into a heap of ashes by the sage Kapila [see भगीरथ], and their funeral ceremonies could only be performed by the waters of Gaṅgā to be brought from heaven for the purpose of purifying their remains ;\nthis was finally accomplished by the devotion of Bhagīratha, who having led the river to the sea, called it Sāgara in honour of his ancestor: Sagara is described as having subdued the Śakas, Yavanas, and other barbarous tribes;\npl. ‘the sons of Sagara’), MBh.;\nR. &c. (IW. 361)", "gloss_language": "en"}, {"gloss": "N. of a partic. Arhat, MW.", "gloss_language": "en"}, {"gloss": "स॑गर m. and f(आ). (for 1. 2. स-ग्˚ See col. 1) night (?), TS. : ŚBr. (in a formula).", "gloss_language": "en"}], "synonyms": ["सगरः"], "synonyms_slp1": ["sagaraH"]}, {"id": "sAgara", "headword": "सागर", "headword_slp1": "sAgara", "fold": "sagara", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "सागर m. (ifc. f(आ). ; fr. 2. स-गर) the ocean (said to have been named so by Bhagīratha after his son Sagara [see 2. स-गर, p. 1125]; another legend asserts that the bed of the ocean was dug by the sons of Sagara; 3 or 4 or 7 oceans are reckoned, cf. 1. सम्-उद्र; सागरस्य फेनः = समुद्रफ्˚), Mn.; MBh. &c.", "gloss_language": "en"}, {"gloss": "an ocean (as expressing any vast body or inexhaustible mass; often ifc. cf. गुण-शोक-, संसार-स्˚)", "gloss_language": "en"}, {"gloss": "a symbolical expression for the number, ‘four’ (like other words signifying ‘ocean’), Gaṇit.", "gloss_language": "en"}, {"gloss": "a partic. high number (= 10 Padmas), Pur.", "gloss_language": "en"}, {"gloss": "a sort of deer, L.", "gloss_language": "en"}, {"gloss": "N. of a serpent-demon, Kāraṇḍ.", "gloss_language": "en"}, {"gloss": "(with Jainas) of the third Arhat of the past Utsarpiṇī, L.", "gloss_language": "en"}, {"gloss": "of one of the 10 orders of mendicants traced back to disciples of Śaṃkarācārya, Cat.", "gloss_language": "en"}, {"gloss": "of various persons, HPariś.", "gloss_language": "en"}, {"gloss": "of two authors and of a wk. on Dharma, Cat.", "gloss_language": "en"}, {"gloss": "of a place, ib.", "gloss_language": "en"}, {"gloss": "(pl.) the sons of Sagara, MBh.; R.", "gloss_language": "en"}, {"gloss": "सागर n. N. of a town, Buddh.", "gloss_language": "en"}, {"gloss": "सागर mf(ई)n. relating to the sea, marine, Hariv.", "gloss_language": "en"}], "synonyms": ["सागरः"], "synonyms_slp1": ["sAgaraH"]}], "sagaras": [{"id": "sagaras", "headword": "सगरस्", "headword_slp1": "sagaras", "fold": "sagaras", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गरस् mfn. accompanied by praise (applied to Agni; cf. prec.), PañcavBr.", "gloss_language": "en"}]}], "sagarBa": [{"id": "sagarBa", "headword": "सगर्भ", "headword_slp1": "sagarBa", "fold": "sagarBa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गर्भ mf(आ)n. pregnant, impregnated by (abl. or instr.), Hariv.; Kathās. &c.", "gloss_language": "en"}, {"gloss": "(a plant) whose leaves are still undeveloped, KāśīKh.", "gloss_language": "en"}, {"gloss": "स—गर्भ m. = next, L.", "gloss_language": "en"}], "synonyms": ["सगर्भः"], "synonyms_slp1": ["sagarBaH"]}, {"id": "sagarBA", "headword": "सगर्भा", "headword_slp1": "sagarBA", "fold": "sagarBa", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गर्भा (आ), f. a pregnant woman, MW.", "gloss_language": "en"}]}], "sagarBya": [{"id": "sagarBya", "headword": "सगर्भ्य", "headword_slp1": "sagarBya", "fold": "sagarBya", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स॑—गर्भ्य (स॑-), m. a brother of whole blood, one by the same father and mother, VS.; Kāṭh.", "gloss_language": "en"}], "synonyms": ["सगर्भ्यः"], "synonyms_slp1": ["sagarByaH"]}], "sagarva": [{"id": "sagarva", "headword": "सगर्व", "headword_slp1": "sagarva", "fold": "sagarva", "headword_language": "sa", "source": "mw-cologne", "senses": [{"gloss": "स—गर्व mf