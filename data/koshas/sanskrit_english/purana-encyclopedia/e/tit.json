{"titiksa": [{"id": "titikzA", "headword": "तितिक्षा", "headword_slp1": "titikzA", "fold": "titiksa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "तितिक्षा\n\nTITIKṢĀ . One of the sixteen daughters born to dakṣa of his wife prasūti. Of these thirteen were married to Dharmadeva. titikṣā was one of them. The others were śraddhā, maitrī etc. (4th skandha bhāgavata).", "gloss_language": "en"}], "synonyms": ["titikShaa", "titikṣā", "titixaa", "తితిక్షా", "ತಿತಿಕ್ಷಾ"], "synonyms_slp1": ["titikShaa", "titikṣā", "titixaa", "తితిక్షా", "ತಿತಿಕ್ಷಾ"]}], "titiksu": [{"id": "titikzu", "headword": "तितिक्षु", "headword_slp1": "titikzu", "fold": "titiksu", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "तितिक्षु\n\nTITIKṢU . A King born of the family of turvasu. He was the son of uśīnara and father of ruṣadratha. (Chapter 277, agni purāṇa).", "gloss_language": "en"}], "synonyms": ["titikShu", "titikṣu", "titixu", "తితిక్షు", "ತಿತಿಕ್ಷು"], "synonyms_slp1": ["titikShu", "titikṣu", "titixu", "తితిక్షు", "ತಿತಿಕ್ಷು"]}], "titira": [{"id": "tittira", "headword": "तित्तिर", "headword_slp1": "tittira", "fold": "titira", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "तित्तिर\n\nTITTIRA . A place of habitation in ancient bhārata. (Śloka 51, Chapter 50, bhīṣma parva).", "gloss_language": "en"}], "synonyms": ["tittira", "తిత్తిర", "ತಿತ್ತಿರ"], "synonyms_slp1": ["tittira", "తిత్తిర", "ತಿತ್ತಿರ"]}], "titiri_१": [{"id": "tittiri_१", "headword": "तित्तिरि_१", "headword_slp1": "tittiri_१", "fold": "titiri_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "तित्तिरि १\n\nTITTIRI I . A kind of bird. To know about the origin of this bird see under the head triśiras.", "gloss_language": "en"}], "synonyms": ["tittiri", "tittiri_1", "तित्तिरि", "తిత్తిరి", "తిత్తిరి_౧", "ತಿತ್ತಿರಿ", "ತಿತ್ತಿರಿ_೧"], "synonyms_slp1": ["tittiri", "tittiri_1", "tittiri", "తిత్తిరి", "తిత్తిరి_౧