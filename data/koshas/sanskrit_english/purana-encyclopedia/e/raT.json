{"raTacitra": [{"id": "raTacitrA", "headword": "रथचित्रा", "headword_slp1": "raTacitrA", "fold": "raTacitra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथचित्रा\n\nRATHACITRĀ . A river famous in the Purāṇas. (bhīṣma Parva, Chapter 9, Verse 26).", "gloss_language": "en"}], "synonyms": ["rathachitraa", "rathacitrā", "రథచిత్రా", "ರಥಚಿತ್ರಾ"], "synonyms_slp1": ["rathachitraa", "rathacitrā", "రథచిత్రా", "ರಥಚಿತ್ರಾ"]}], "raTaDvaja": [{"id": "raTaDvaja", "headword": "रथध्वज", "headword_slp1": "raTaDvaja", "fold": "raTaDvaja", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथध्वज\n\nRATHADHVAJA . Father of king kuśadhvaja of videha. vedavatī was his grand-daughter. (See under vedavatī).", "gloss_language": "en"}], "synonyms": ["rathadhvaja", "రథధ్వజ", "ರಥಧ್ವಜ"], "synonyms_slp1": ["rathadhvaja", "రథధ్వజ", "ರಥಧ್ವಜ"]}], "raTaDvana": [{"id": "raTaDvAna", "headword": "रथध्वान", "headword_slp1": "raTaDvAna", "fold": "raTaDvana", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथध्वान\n\nRATHADHVĀNA . Another name of Vīrāgni, son of śaṁyu. (Vana Parva, Chapter 219, Verse 9).", "gloss_language": "en"}], "synonyms": ["rathadhvaana", "rathadhvāna", "రథధ్వాన", "ರಥಧ್ವಾನ"], "synonyms_slp1": ["rathadhvaana", "rathadhvāna", "రథధ్వాన", "ರಥಧ್ವಾನ"]}], "raTagraRi": [{"id": "raTAgraRI", "headword": "रथाग्रणी", "headword_slp1": "raTAgraRI", "fold": "raTagraRi", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथाग्रणी\n\nRATHĀGRAṆĪ . A warrior. He had accompanied śatrughna who led the Aśvamedhic horse of rāma. (padma purāṇa, Pātālakhaṇḍa).", "gloss_language": "en"}], "synonyms": ["rathaagraNee", "rathaagraNii", "rathāgraṇī", "రథాగ్రణీ", "ರಥಾಗ್ರಣೀ"], "synonyms_slp1": ["rathaagraNee", "rathaagraNii", "rathāgraṇī", "రథాగ్రణీ", "ರಥಾಗ್ರಣೀ"]}], "raTakfta": [{"id": "raTakfta", "headword": "रथकृत", "headword_slp1": "raTakfta", "fold": "raTakfta", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथकृत\n\nRATHAKṚTA . A yakṣa who rotates in the month of Caitra along with the āditya called dhātā. (bhāgavata 12th skandha).", "gloss_language": "en"}], "synonyms": ["rathakRRita", "rathakRita", "rathakRta", "rathakRuta", "rathakṛta", "రథకృత", "ರಥಕೃತ"], "synonyms_slp1": ["rathakRRita", "rathakRita", "rathakRta", "rathakRuta", "rathakṛta", "రథకృత", "ರಥಕೃತ"]}], "raTaksa": [{"id": "raTAkza", "headword": "रथाक्ष", "headword_slp1": "raTAkza", "fold": "raTaksa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथाक्ष\n\nRATHĀKṢA . A warrior of subrahmaṇya. (śalya Parva, Chapter 45, Verse 63).", "gloss_language": "en"}], "synonyms": ["rathaakSha", "rathaaxa", "rathākṣa", "రథాక్ష", "ರಥಾಕ್ಷ"], "synonyms_slp1": ["rathaakSha", "rathaaxa", "rathākṣa", "రథాక్ష", "ರಥಾಕ್ಷ"]}], "raTantara_१": [{"id": "raTantara_१", "headword": "रथन्तर_१", "headword_slp1": "raTantara_१", "fold": "raTantara_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथन्तर १\n\nRATHANTARA I . A Sāman, which, having assumed form, worships brahmā in his court. (Sabhā Parva, Chapter 11, Verse 30). This rathantara sāman possesses the power to cure fainting fits. Once vasiṣṭha restored indra to consciousness with this Sāman. (śānti Parva, Chapter 281, Verse 21).", "gloss_language": "en"}], "synonyms": ["rathantara", "rathantara_1", "रथन्तर", "రథన్తర", "రథన్తర_౧", "ರಥನ್ತರ", "ರಥನ್ತರ_೧"], "synonyms_slp1": ["rathantara", "rathantara_1", "raTantara", "రథన్తర", "రథన్తర_౧", "ರಥನ್ತರ", "ರಥನ್ತರ_೧"]}], "raTantara_२": [{"id": "raTantara_२", "headword": "रथन्तर_२", "headword_slp1": "raTantara_२", "fold": "raTantara_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथन्तर २\n\nRATHANTARA II . Son of the agni called pāñcajanya. He was also called Tarasāhara. (Vana Parva, Chapter 222, Verse 7).", "gloss_language": "en"}], "synonyms": ["rathantara", "rathantara_2", "रथन्तर", "రథన్తర", "రథన్తర_౨", "ರಥನ್ತರ", "ರಥನ್ತರ_೨"], "synonyms_slp1": ["rathantara", "rathantara_2", "raTantara", "రథన్తర", "రథన్తర_౨", "ರಥನ್ತರ", "ರಥನ್ತರ_೨"]}], "raTantarya": [{"id": "raTantaryA", "headword": "रथन्तर्या", "headword_slp1": "raTantaryA", "fold": "raTantarya", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथन्तर्या\n\nRATHANTARYĀ (rathantarī) . Mother of King duṣyanta. She was the daughter of King īlina and had five sons, i.e. duṣyanta, śūra, bhīma, pravasu and vasu. (Ādi Parva, Chapter 94).", "gloss_language": "en"}], "synonyms": ["rathantaree", "rathantarii", "rathantaryaa", "rathantaryā", "rathantarī", "रथन्तरी", "రథన్తరీ", "రథన్తర్యా", "ರಥನ್ತರೀ", "ರಥನ್ತರ್ಯಾ"], "synonyms_slp1": ["rathantaree", "rathantarii", "rathantaryaa", "rathantaryā", "rathantarī", "raTantarI", "రథన్తరీ", "రథన్తర్యా", "ರಥನ್ತರೀ", "ರಥನ್ತರ್ಯಾ"]}], "raTapraBu": [{"id": "raTapraBu", "headword": "रथप्रभु", "headword_slp1": "raTapraBu", "fold": "raTapraBu", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथप्रभु\n\nRATHAPRABHU . A synonym of Vīrāgni, son of śaṁyu. (Vana Parva, Chapter 219, Verse 9).", "gloss_language": "en"}], "synonyms": ["rathaprabhu", "రథప్రభు", "ರಥಪ್ರಭು"], "synonyms_slp1": ["rathaprabhu", "రథప్రభు", "ರಥಪ್ರಭು"]}], "raTasena": [{"id": "raTasena", "headword": "रथसेन", "headword_slp1": "raTasena", "fold": "raTasena", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथसेन\n\nRATHASENA . A valiant warrior who fought on the Pāṇḍava side against the kauravas. His horses were very magnificent ones. (droṇa parva, Chapter 23, Verse 62).", "gloss_language": "en"}], "synonyms": ["rathasena", "రథసేన", "ರಥಸೇನ"], "synonyms_slp1": ["rathasena", "రథసేన", "ರಥಸೇನ"]}], "raTasTa": [{"id": "raTasTa", "headword": "रथस्थ", "headword_slp1": "raTasTa", "fold": "raTasTa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथस्थ\n\nRATHASTHA . A yakṣa who rotates in the month of jyeṣṭha in the company of the āditya called mitra. (bhāgavata, 12th skandha).", "gloss_language": "en"}], "synonyms": ["rathastha", "రథస్థ", "ರಥಸ್ಥ"], "synonyms_slp1": ["rathastha", "రథస్థ", "ರಥಸ್ಥ"]}, {"id": "raTasTA", "headword": "रथस्था", "headword_slp1": "raTasTA", "fold": "raTasTa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथस्था\n\nRATHASTHĀ . One of the seven tributaries of the gaṅgā. According to the ancients, bathing in the river will wash off all sins. (Ādi Parva, Chapter 169, Verse 20).", "gloss_language": "en"}], "synonyms": ["rathasthaa", "rathasthā", "రథస్థా", "ರಥಸ್ಥಾ"], "synonyms_slp1": ["rathasthaa", "rathasthā", "రథస్థా", "ರಥಸ್ಥಾ"]}], "raTatiraTasanKyanaparva": [{"id": "raTAtiraTasaMKyAnaparva", "headword": "रथातिरथसंख्यानपर्व", "headword_slp1": "raTAtiraTasaMKyAnaparva", "fold": "raTatiraTasanKyanaparva", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथातिरथसंख्यानपर्व\n\nRATHĀTIRATHASAṄKHYĀNAPARVA . A sub-Parva of śānti Parva, Chapters 165-172.", "gloss_language": "en"}], "synonyms": ["rathaatirathasaMkhyaanaparva", "rathaatirathasankhyaanaparva", "rathātirathasaṅkhyānaparva", "रथातिरथसङ्ख्यानपर्व", "రథాతిరథసంఖ్యానపర్వ", "రథాతిరథసఙ్ఖ్యానపర్వ", "ರಥಾತಿರಥಸಂಖ್ಯಾನಪರ್ವ", "ರಥಾತಿರಥಸಙ್ಖ್ಯಾನಪರ್ವ"], "synonyms_slp1": ["rathaatirathasaMkhyaanaparva", "rathaatirathasankhyaanaparva", "rathātirathasaṅkhyānaparva", "raTAtiraTasaNKyAnaparva", "రథాతిరథసంఖ్యానపర్వ", "రథాతిరథసఙ్ఖ్యానపర్వ", "ರಥಾತಿರಥಸಂಖ್ಯಾನಪರ್ವ", "ರಥಾತಿರಥಸಙ್ಖ್ಯಾನಪರ್ವ"]}], "raTavahana": [{"id": "raTavAhana", "headword": "रथवाहन", "headword_slp1": "raTavAhana", "fold": "raTavahana", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथवाहन\n\nRATHAVĀHANA . Brother of the virāṭa King. He fought against the pāṇḍavas. (droṇa parva, Chapter 158, Verse 42).", "gloss_language": "en"}], "synonyms": ["rathavaahana", "rathavāhana", "రథవాహన", "ರಥವಾಹನ"], "synonyms_slp1": ["rathavaahana", "rathavāhana", "రథవాహన", "ರಥವಾಹನ"]}], "raTavarta": [{"id": "raTAvarta", "headword": "रथावर्त", "headword_slp1": "raTAvarta", "fold": "raTavarta", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथावर्त\n\nRATHĀVARTA . A holy place considered to be on the right side of Śākambharīdevī. He who visits this place will, due to the grace of śiva, attain salvation. (Vana Parva, Chapter 84, Verse 23).", "gloss_language": "en"}], "synonyms": ["rathaavarta", "rathāvarta", "రథావర్త", "ರಥಾವರ್ತ"], "synonyms_slp1": ["rathaavarta", "rathāvarta", "రథావర్త", "ರಥಾವರ್ತ"]}], "raTaviti": [{"id": "raTavIti", "headword": "रथवीति", "headword_slp1": "raTavIti", "fold": "raTaviti", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथवीति\n\nRATHAVĪTI . A maharṣi. He lived in a hilly region very far away from the Himālayas. Once the maharṣi called śyāvāśva invited rathavīti to perform a homa at the yajña conducted by King Taranta, and when he came for the homa with his daughter the father of śyāvāśva asked him to marry his daughter to śyāvāśva. rathavīti not only refused, but also dismissed śyāvāśva from the yājñic platform. At last rathavīti married his daughter to śyāvāśva at the request of King Taranta. (ṛgveda, Sāyaṇabhāṣya).", "gloss_language": "en"}], "synonyms": ["rathaveeti", "rathaviiti", "rathavīti", "రథవీతి", "ರಥವೀತಿ"], "synonyms_slp1": ["rathaveeti", "rathaviiti", "rathavīti", "రథవీతి", "ರಥವೀತಿ"]}], "raTitara": [{"id": "raTItara", "headword": "रथीतर", "headword_slp1": "raTItara", "fold": "raTitara", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रथीतर\n\nRATHĪTARA . A king of the solar dynasty. He was the son of pṛṣatāśva. (bhāgavata, 9th skandha).", "gloss_language": "en"}], "synonyms": ["ratheetara", "rathiitara", "rathītara", "రథీతర", "ರಥೀತರ"], "synonyms_slp1": ["ratheetara", "rathiitara", "rathītara", "రథీతర", "ರಥೀತರ"]}]}