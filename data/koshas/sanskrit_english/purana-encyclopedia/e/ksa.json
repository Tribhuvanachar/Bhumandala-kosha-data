{"ksa": [{"id": "kza", "headword": "क्ष", "headword_slp1": "kza", "fold": "ksa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्ष\n\nKṢA {#(kza)#}. This letter means (1) kṣatriya (2) field (3) narasiṁha (the lion-man incarnation of viṣṇu) (4) hari (viṣṇu) (5) Protector of temples and gate keeper. (6) Lightning (7) Destruction (8) A demon.", "gloss_language": "en"}], "synonyms": ["kSha", "kṣa", "xa", "క్ష", "ಕ್ಷ"], "synonyms_slp1": ["kSha", "kṣa", "xa", "క్ష", "ಕ್ಷ"]}], "ksama": [{"id": "kzamA", "headword": "क्षमा", "headword_slp1": "kzamA", "fold": "ksama", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्षमा\n\nKṢAMĀ . Wife of prajāpati pulaha. three sons kardama, urvarīyān and sahiṣṇu were born to pulaha of his wife kṣamā. (viṣṇu purāṇa, aṁśa 1, Stanza 10).", "gloss_language": "en"}], "synonyms": ["kShamaa", "kṣamā", "xamaa", "క్షమా", "ಕ್ಷಮಾ"], "synonyms_slp1": ["kShamaa", "kṣamā", "xamaa", "క్షమా", "ಕ್ಷಮಾ"]}], "ksamaka": [{"id": "kzamaka", "headword": "क्षमक", "headword_slp1": "kzamaka", "fold": "ksamaka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्षमक\n\nKṢAMAKA . A King of the puru dynasty. (agni purāṇa, Chapter 278).", "gloss_language": "en"}], "synonyms": ["kShamaka", "kṣamaka", "xamaka", "క్షమక", "ಕ್ಷಮಕ"], "synonyms_slp1": ["kShamaka", "kṣamaka", "xamaka", "క్షమక", "ಕ್ಷಮಕ"]}], "ksatradeva": [{"id": "kzatradeva", "headword": "क्षत्रदेव", "headword_slp1": "kzatradeva", "fold": "ksatradeva", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्षत्रदेव\n\nKṢATRADEVA . The son of śikhaṇḍī. He was a famous archer. bhagadatta wounded the right hand of kṣatradeva in the bhārata-battle. He fought with lakṣmaṇa and droṇa. lakṣmaṇa killed him. (M. B. Udyoga Parva, Chapters 57 and 171; bhīṣma Parva, Chapter 95; droṇa parva, Chapters 14, 21 and 23; karṇa Parva, Chapter 6).", "gloss_language": "en"}], "synonyms": ["kShatradeva", "kṣatradeva", "xatradeva", "క్షత్రదేవ", "ಕ್ಷತ್ರದೇವ"], "synonyms_slp1": ["kShatradeva", "kṣatradeva", "xatradeva", "క్షత్రదేవ", "ಕ್ಷತ್ರದೇವ"]}], "ksatraDarman": [{"id": "kzatraDarman", "headword": "क्षत्रधर्मन्", "headword_slp1": "kzatraDarman", "fold": "ksatraDarman", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्षत्रधर्मन्\n\nKṢATRADHARMAN . A son of dhṛṣṭadyumna. The teacher droṇa killed him. (M.B. droṇa parva, Chapter 125, Stanza 66).", "gloss_language": "en"}], "synonyms": ["kShatradharman", "kṣatradharman", "xatradharman", "క్షత్రధర్మన్", "ಕ್ಷತ್ರಧರ್ಮನ್"], "synonyms_slp1": ["kShatradharman", "kṣatradharman", "xatradharman", "క్షత్రధర్మన్", "ಕ್ಷತ್ರಧರ್ಮನ್"]}], "ksatraYjaya": [{"id": "kzatraYjaya", "headword": "क्षत्रञ्जय", "headword_slp1": "kzatraYjaya", "fold": "ksatraYjaya", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्षत्रञ्जय\n\nKṢATRAÑJAYA . A son of dhṛṣṭadyumna. droṇa killed him. (M. B. droṇa parva, Chapter 10, Stanza 53).", "gloss_language": "en"}], "synonyms": ["kShatra~njaya", "kṣatrañjaya", "xatra~njaya", "క్షత్రఞ్జయ", "ಕ್ಷತ್ರಞ್ಜಯ"], "synonyms_slp1": ["kShatra~njaya", "kṣatrañjaya", "xatra~njaya", "క్షత్రఞ్జయ", "ಕ್ಷತ್ರಞ್ಜಯ"]}], "ksatravarman": [{"id": "kzatravarman", "headword": "क्षत्रवर्मन्", "headword_slp1": "kzatravarman", "fold": "ksatravarman", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "क्षत्रवर्मन्\n\nKṢATRAVARMAN . A son of dhṛṣṭadyumna. He fought with jayadratha in the battle of bhārata. droṇa killed him. (M.B. droṇa parva, Chapter 186).", "gloss_language": "en"}], "synonyms": ["kShatravarman", "kṣatravarman", "xatravarman", "క్షత్రవర్మన్", "ಕ್ಷತ್ರವರ್ಮನ್"], "synonyms_slp1": ["kShatravarman", "kṣatravarman", "xatravarman", "క్షత్రవర్మన్", "ಕ್ಷತ್ರವರ್ಮನ್"]}], "ksatriya": [{"id": "kzatriya", "headword": "क्षत्रिय", "headword_slp1": "kzatriya", "fold": "ksatriya", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"g