{"nyagroDa": [{"id": "nyagroDa", "headword": "न्यग्रोध", "headword_slp1": "nyagroDa", "fold": "nyagroDa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "न्यग्रोध\n\nNYAGRODHA . A son of ugrasena. When kṛṣṇa killed kaṁsa nyagrodha fought with kṛṣṇa and others and was killed by the blow of Balabhadra's shield. (bhāgavata).", "gloss_language": "en"}], "synonyms": ["nyagrodha", "న్యగ్రోధ", "ನ್ಯಗ್ರೋಧ"], "synonyms_slp1": ["nyagrodha", "న్యగ్రోధ", "ನ್ಯಗ್ರೋಧ"]}], "nyagroDatirTa": [{"id": "nyagroDatIrTa", "headword": "न्यग्रोधतीर्थ", "headword_slp1": "nyagroDatIrTa", "fold": "nyagroDatirTa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "न्यग्रोधतीर्थ\n\nNYAGRODHATĪRTHA . A holy place on the banks of the ancient river dṛṣadvatī in North india. (Vana Parva, Chapter 90, Verse 11).", "gloss_language": "en"}], "synonyms": ["nyagrodhateertha", "nyagrodhatiirtha", "nyagrodhatīrtha", "న్యగ్రోధతీర్థ", "ನ್ಯಗ್ರೋಧತೀರ್ಥ"], "synonyms_slp1": ["nyagrodhateertha", "nyagrodhatiirtha", "nyagrodhatīrtha", "న్యగ్రోధతీర్థ", "ನ್ಯಗ್ರೋಧತೀರ್ಥ"]}]}