{"nipa_१": [{"id": "nIpa_१", "headword": "नीप_१", "headword_slp1": "nIpa_१", "fold": "nipa_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नीप १\n\nNĪPA I . A famous King of the pūru dynasty. A son called brahmadatta was born to the King by his wife kṛti alias Kīrtimatī. brahmadatta begot hundred sons like Kīrtivardhana and all of them became famous by the name Nīpas. (bhāgavata, 9th skandha).", "gloss_language": "en"}], "synonyms": ["neepa", "neepa_1", "niipa", "niipa_1", "nīpa", "nīpa_1", "नीप", "నీప", "నీప_౧", "ನೀಪ", "ನೀಪ_೧"], "synonyms_slp1": ["neepa", "neepa_1", "niipa", "niipa_1", "nīpa", "nīpa_1", "nIpa", "నీప", "నీప_౧", "ನೀಪ", "ನೀಪ_೧"]}], "nipa_२": [{"id": "nIpa_२", "headword": "नीप_२", "headword_slp1": "nIpa_२", "fold": "nipa_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नीप २\n\nNĪPA II . An ancient kingdom in india. The King of this place participated in Yudhiṣṭhira's rājasūya. (Sabhā Parva, Chapter 51, Verse 24).", "gloss_language": "en"}], "synonyms": ["neepa", "neepa_2", "niipa", "niipa_2", "nīpa", "nīpa_2", "नीप", "నీప", "నీప_౨", "ನೀಪ", "ನೀಪ_೨"], "synonyms_slp1": ["neepa", "neepa_2", "niipa", "niipa_2", "nīpa", "nīpa_2", "nIpa", "నీప", "నీప_౨", "ನೀಪ", "ನೀಪ_೨"]}], "nipa_३": [{"id": "nIpa_३", "headword": "नीप_३", "headword_slp1": "nIpa_३", "fold": "nipa_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नीप ३\n\nNĪPA III . A kṣatriya dynasty. King janamejaya belonged to this dynasty. (Udyoga Parva, Chapter 74, Verse 13).", "gloss_language": "en"}], "synonyms": ["neepa", "neepa_3", "niipa", "niipa_3", "nīpa", "nīpa_3", "नीप", "నీప", "నీప_౩", "ನೀಪ", "ನೀಪ_೩"], "synonyms_slp1": ["neepa", "neepa_3", "niipa", "niipa_3", "nīpa", "nīpa_3", "nIpa", "నీప", "నీప_౩", "ನೀಪ", "ನೀಪ_೩"]}], "nipatiTi": [{"id": "nIpAtITi", "headword": "नीपातीथि", "headword_slp1": "nIpAtITi", "fold": "nipatiTi", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नीपातीथि\n\nNĪPĀTĪTHI . A ṛṣi extolled in the ṛgveda. He was a Sūktadraṣṭā (one who realized the Vedic hymns).", "gloss_language": "en"}], "synonyms": ["neepaateethi", "niipaatiithi", "nīpātīthi", "నీపాతీథి", "ನೀಪಾತೀಥಿ"], "synonyms_slp1": ["neepaateethi", "niipaatiithi", "nīpātīthi", "నీపాతీథి", "ನೀಪಾತೀಥಿ"]}]}