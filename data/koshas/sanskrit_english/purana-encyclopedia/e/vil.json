{"vilasa": [{"id": "vilAsa", "headword": "विलास", "headword_slp1": "vilAsa", "fold": "vilasa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "विलास\n\nVILĀSA . A hermit who was the friend of bhāsa. This hermit did penance in Paścimataṭa. It is mentioned in Yogavāsiṣṭha that vilāsa and bhāsa attained heaven by pure knowledge.", "gloss_language": "en"}], "synonyms": ["vilaasa", "vilāsa", "విలాస", "ವಿಲಾಸ"], "synonyms_slp1": ["vilaasa", "vilāsa", "విలాస", "ವಿಲಾಸ"]}], "vilohita": [{"id": "vilohita", "headword": "विलोहित", "headword_slp1": "vilohita", "fold": "vilohita", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "विलोहित\n\nVILOHITA . A rākṣasa (giant) who was the son of kaśyapa. It is mentioned in vāyu purāṇa, Chapter 69, that vilohita had three heads, three legs and three hands.", "gloss_language": "en"}], "synonyms": ["vilohita", "విలోహిత", "ವಿಲೋಹಿತ"], "synonyms_slp1": ["vilohita", "విలోహిత", "ವಿಲೋಹಿತ"]}], "vilohitam": [{"id": "vilohitam", "headword": "विलोहितम्", "headword_slp1": "vilohitam", "fold": "vilohitam", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "विलोहितम्\n\nVILOHITA(M) . A hell. (See the section naraka under kāla).", "gloss_language": "en"}], "synonyms": ["vilohita", "vilohitam", "विलोहित", "विलोहितं", "విలోహిత", "విలోహితం", "విలోహితమ్", "ವಿಲೋಹಿತ", "ವಿಲೋಹಿತಂ", "ವಿಲೋಹಿತಮ್"], "synonyms_slp1": ["vilohita", "vilohitam", "vilohita", "vilohitaM", "విలోహిత", "విలోహితం", "విలోహితమ్", "ವಿಲೋಹಿತ", "ವಿಲೋಹಿತಂ", "ವಿಲೋಹಿತಮ್"]}], "viloma": [{"id": "viloma", "headword": "विलोम", "headword_slp1": "viloma", "fold": "viloma", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "विलोम\n\nVILOMA (vilomā) . A King. In bhāgavata, King viloma is stated as the son of King vahni (Fire) and in viṣṇu purāṇa, as the son of kapotaromā.", "gloss_language": "en"}], "synonyms": ["viloma", "vilomaa", "vilomā", "विलोमा", "విలోమ", "విలోమా", "ವಿಲೋಮ", "ವಿಲ