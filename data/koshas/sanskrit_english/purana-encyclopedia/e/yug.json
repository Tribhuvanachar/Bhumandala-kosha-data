{"yuga": [{"id": "yuga", "headword": "युग", "headword_slp1": "yuga", "fold": "yuga", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "युग\n\nYUGA . See under manvantara.", "gloss_language": "en"}], "synonyms": ["yuga", "యుగ", "ಯುಗ"], "synonyms_slp1": ["yuga", "యుగ", "ಯುಗ"]}], "yuganDara_१": [{"id": "yuganDara_१", "headword": "युगन्धर_१", "headword_slp1": "yuganDara_१", "fold": "yuganDara_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "युगन्धर १\n\nYUGANDHARA I (yugandharas) . In the Purāṇas there are references to a mountain called yugandhara. The inhabitants of that place were known as yugandharas. In mahābhārata, Vana Parva, Chapter 129, Verse 9, there is a statement that these people used to drink the milk of camels and donkeys.", "gloss_language": "en"}], "synonyms": ["yugandhara", "yugandhara_1", "yugandharas", "yugandharas_1", "युगन्धर", "युगन्धरस्", "युगन्धरस्_१", "యుగన్ధర", "యుగన్ధర_౧", "యుగన్ధరస్", "యుగన్ధరస్_౧", "ಯುಗನ್ಧರ", "ಯುಗನ್ಧರ_೧", "ಯುಗನ್ಧರಸ್", "ಯುಗನ್ಧರಸ್_೧"], "synonyms_slp1": ["yugandhara", "yugandhara_1", "yugandharas", "yugandharas_1", "yuganDara", "yuganDaras", "yuganDaras_१", "యుగన్ధర", "యుగన్ధర_౧", "యుగన్ధరస్", "యుగన్ధరస్_౧", "ಯುಗನ್ಧರ", "ಯುಗನ್ಧರ_೧", "ಯುಗನ್ಧರಸ್", "ಯುಗನ್ಧರಸ್_೧"]}], "yuganDara_२": [{"id": "yuganDara_२", "headword": "युगन्धर_२", "headword_slp1": "yuganDara_२", "fold": "yuganDara_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "युगन्धर २\n\nYUGANDHARA II . A warrior who fought against the kauravas from the Pāṇḍava party. He attacked Droṇācārya in the battle and was killed by him in the end. (M.B. droṇa parva, Chapter 16, Verse 30).", "gloss_language": "en"}], "synonyms": ["yugandhara", "yugandhara_2", "युगन्धर", "యుగన్ధర", "యుగన్ధర_౨", "ಯುಗನ್ಧರ", "ಯುಗನ್ಧರ_೨"], "synonyms_slp1": ["yugandhara", "yugandhara_2", "yuganDara", "యుగన్ధర", "యుగన్ధర_౨", "ಯುಗನ್ಧರ", "ಯುಗನ್ಧರ_೨"]}], "yugapa": [{"id": "yugapa", "headword": "युगप", "headword_s