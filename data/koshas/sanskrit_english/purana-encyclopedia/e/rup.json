{"rupaka": [{"id": "rUpaka", "headword": "रूपक", "headword_slp1": "rUpaka", "fold": "rupaka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रूपक\n\nRŪPAKA . See under pattu (ten)", "gloss_language": "en"}], "synonyms": ["roopaka", "ruupaka", "rūpaka", "రూపక", "ರೂಪಕ"], "synonyms_slp1": ["roopaka", "ruupaka", "rūpaka", "రూపక", "ರೂಪಕ"]}], "rupavahika": [{"id": "rUpavAhika", "headword": "रूपवाहिक", "headword_slp1": "rUpavAhika", "fold": "rupavahika", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रूपवाहिक\n\nRŪPAVĀHIKA . A country in ancient india. Mention is made about this country in mahābhārata, bhīṣma Parva, Chapter 50, Stanza 43.", "gloss_language": "en"}], "synonyms": ["roopavaahika", "ruupavaahika", "rūpavāhika", "రూపవాహిక", "ರೂಪವಾಹಿಕ"], "synonyms_slp1": ["roopavaahika", "ruupavaahika", "rūpavāhika", "రూపవాహిక", "ರೂಪವಾಹಿಕ"]}], "rupavati": [{"id": "rUpavatI", "headword": "रूपवती", "headword_slp1": "rUpavatI", "fold": "rupavati", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रूपवती\n\nRŪPAVATĪ . A harlot who lived in tretāyuga. It is mentioned in padma purāṇa, pātāla Khaṇḍa, that rūpavatī and her lover devadāsa attained salvation by adopting the life of a house-holder in the forest.", "gloss_language": "en"}], "synonyms": ["roopavatee", "ruupavatii", "rūpavatī", "రూపవతీ", "ರೂಪವತೀ"], "synonyms_slp1": ["roopavatee", "ruupavatii", "rūpavatī", "రూపవతీ", "ರೂಪವತೀ"]}], "rupavidya": [{"id": "rUpavidyA", "headword": "रूपविद्या", "headword_slp1": "rUpavidyA", "fold": "rupavidya", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रूपविद्या\n\nRŪPAVIDYĀ . The figure of devī. The figure of devī, shown as sitting with twelve hands, is called rūpavidyā. (agni purāṇa, Chapter 50).", "gloss_language": "en"}], "synonyms": ["roopavidyaa", "ruupavidyaa", "rūpavidyā", "రూపవిద్యా", "ರೂಪವಿದ್ಯಾ"], "synonyms_slp1": ["roopavidyaa", "ruupavidyaa", "rūpavidyā", "రూపవిద్యా", "ರೂಪವಿದ್ಯಾ"]}], "rupiRa": [{"id": "rUpiRa", "headword": "रूपिण", "headword_slp1": "rUpiRa", "fold": "rupiRa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "रूपिण\n\nRŪPIṆA . A son born to the emperor ajamīḍha by his wife keśinī. He had two brothers named jahnu and vraja. (M.B. Ādi Parva, Chapter 94, Stanza 32).", "gloss_language": "en"}], "synonyms": ["roopiNa", "ruupiNa", "rūpiṇa", "రూపిణ", "ರೂಪಿಣ"], "synonyms_slp1": ["roopiNa", "ruupiNa", "rūpiṇa", "రూపిణ", "ರೂಪಿಣ"]}]}