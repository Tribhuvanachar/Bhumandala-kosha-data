{"pinaka": [{"id": "pinAka", "headword": "पिनाक", "headword_slp1": "pinAka", "fold": "pinaka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिनाक\n\nPINĀKA . The bow of śiva. Pīnāka was formerly the three-forked spike of śiva. Once it fell down from the hands of śiva and on falling down took the shape of a bow. From then onwards it was used as a bow. See under Pāśupata. (Chapter 38. Sabhā Parva: Chapter 141, anuśāsana parva; Chapter 289. śānti Parva).", "gloss_language": "en"}], "synonyms": ["pinaaka", "pināka", "పినాక", "ಪಿನಾಕ"], "synonyms_slp1": ["pinaaka", "pināka", "పినాక", "ಪಿನಾಕ"]}], "pinaki_१": [{"id": "pinAkI_१", "headword": "पिनाकी_१", "headword_slp1": "pinAkI_१", "fold": "pinaki_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिनाकी १\n\nPINĀKĪ I . One of the eleven Ṛudras. He was the grandson of brahmā and the son of sthāṇu. pinākī attended the Janmotsava of arjuna. (Chapter 66, Ādi Parva; Chapter 208, śānti Parva; Chapter 122, Ādi Parva).", "gloss_language": "en"}], "synonyms": ["pinaakee", "pinaakee_1", "pinaakii", "pinaakii_1", "pinākī", "pinākī_1", "पिनाकी", "పినాకీ", "పినాకీ_౧", "ಪಿನಾಕೀ", "ಪಿನಾಕೀ_೧"], "synonyms_slp1": ["pinaakee", "pinaakee_1", "pinaakii", "pinaakii_1", "pinākī", "pinākī_1", "pinAkI", "పినాకీ", "పినాకీ_౧", "ಪಿನಾಕೀ", "ಪಿನಾಕೀ_೧"]}], "pinaki_२": [{"id": "pinAkI_२", "headword": "पिनाकी_२", "headword_slp1": "pinAkI_२", "fold": "pinaki_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिनाकी २\n\nPINĀKĪ II . śiva got this name because he wields the bow named pināka.", "gloss_language": "en"}], "synonyms": ["pinaakee", "pinaakee_2", "pinaakii", "pinaakii_2", "pinākī", "pinākī_2", "पिनाकी", "పినాకీ", "పినాకీ_౨", "ಪಿನಾಕೀ", "ಪಿನಾಕೀ_೨"], "synonyms_slp1": ["pinaakee", "pinaakee_2", "pinaakii", "pinaakii_2", "pinākī", "pinākī_2", "pinAkI", "పినాకీ", "పినాకీ_౨", "ಪಿನಾಕೀ", "ಪಿನಾಕೀ_೨"]}], "pingaksa": [{"id": "piMgAkza", "headword": "पिंगाक्ष", "headword_slp1": "piMgAkza", "fold": "pingaksa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगाक्ष\n\nPIṄGĀKṢA . See under durmukha.", "gloss_language": "en"}], "synonyms": ["piMgaakSha", "piMgaaxa", "pingaakSha", "piṅgākṣa", "पिङ्गाक्ष", "పింగాక్ష", "పిఙ్గాక్ష", "ಪಿಂಗಾಕ್ಷ", "ಪಿಙ್ಗಾಕ್ಷ"], "synonyms_slp1": ["piMgaakSha", "piMgaaxa", "pingaakSha", "piṅgākṣa", "piNgAkza", "పింగాక్ష", "పిఙ్గాక్ష", "ಪಿಂಗಾಕ್ಷ", "ಪಿಙ್ಗಾಕ್ಷ"]}], "pingaksi": [{"id": "piMgAkzI", "headword": "पिंगाक्षी", "headword_slp1": "piMgAkzI", "fold": "pingaksi", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगाक्षी\n\nPIṄGĀKṢĪ . A female follower of subrahmaṇya. (Śloka 18, Chapter 46, śalya Parva).", "gloss_language": "en"}], "synonyms": ["piMgaakShee", "piMgaakShii", "piMgaaxii", "pingaakShee", "pingaakShii", "piṅgākṣī", "पिङ्गाक्षी", "పింగాక్షీ", "పిఙ్గాక్షీ", "ಪಿಂಗಾಕ್ಷೀ", "ಪಿಙ್ಗಾಕ್ಷೀ"], "synonyms_slp1": ["piMgaakShee", "piMgaakShii", "piMgaaxii", "pingaakShee", "pingaakShii", "piṅgākṣī", "piNgAkzI", "పింగాక్షీ", "పిఙ్గాక్షీ", "ಪಿಂಗಾಕ್ಷೀ", "ಪಿಙ್ಗಾಕ್ಷೀ"]}], "pingala_१": [{"id": "piMgala_१", "headword": "पिंगल_१", "headword_slp1": "piMgala_१", "fold": "pingala_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल १\n\nPIṄGALA I . A deva who is an attendant of the Sungod. sūrya (Sun-god) rides in a one-wheeled chariot drawn by seven horses and he bears in his hands two lotuses. On his right side stands the attendant daṇḍī with an ink-pot and a writing stick and on his left side stands the attendant piṅgala with a stick. Both these are demi god attendants of sūrya. (Chapter 51, agni purāṇa).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_1", "pingala", "pingala_1", "piṅgala", "piṅgala_1", "पिंगल", "पिङ्गल", "पिङ्गल_१", "పింగల", "పింగల_౧", "పిఙ్గల", "పిఙ్గల_౧", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೧", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೧"], "synonyms_slp1": ["piMgala", "piMgala_1", "pingala", "pingala_1", "piṅgala", "piṅgala_1", "piMgala", "piNgala", "piNgala_१", "పింగల", "పింగల_౧", "పిఙ్గల", "పిఙ్గల_౧", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೧", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೧"]}, {"id": "piMgalA_१", "headword": "पिंगला_१", "headword_slp1": "piMgalA_१", "fold": "pingala_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगला १\n\nPIṄGALĀ I . A prostitute. (See under ṛṣabha II).", "gloss_language": "en"}], "synonyms": ["piMgalaa", "piMgalaa_1", "pingalaa", "pingalaa_1", "piṅgalā", "piṅgalā_1", "पिंगला", "पिङ्गला", "पिङ्गला_१", "పింగలా", "పింగలా_౧", "పిఙ్గలా", "పిఙ్గలా_౧", "ಪಿಂಗಲಾ", "ಪಿಂಗಲಾ_೧", "ಪಿಙ್ಗಲಾ", "ಪಿಙ್ಗಲಾ_೧"], "synonyms_slp1": ["piMgalaa", "piMgalaa_1", "pingalaa", "pingalaa_1", "piṅgalā", "piṅgalā_1", "piMgalA", "piNgalA", "piNgalA_१", "పింగలా", "పింగలా_౧", "పిఙ్గలా", "పిఙ్గలా_౧", "ಪಿಂಗಲಾ", "ಪಿಂಗಲಾ_೧", "ಪಿಙ್ಗಲಾ", "ಪಿಙ್ಗಲಾ_೧"]}], "pingala_२": [{"id": "piMgala_२", "headword": "पिंगल_२", "headword_slp1": "piMgala_२", "fold": "pingala_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल २\n\nPIṄGALA II . A prominent serpent born to the sage kaśyapa of his wife kadrū. (Śloka 9, Chapter 35, Ādi Parva).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_2", "pingala", "pingala_2", "piṅgala", "piṅgala_2", "पिंगल", "पिङ्गल", "पिङ्गल_२", "పింగల", "పింగల_౨", "పిఙ్గల", "పిఙ్గల_౨", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೨", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೨"], "synonyms_slp1": ["piMgala", "piMgala_2", "pingala", "pingala_2", "piṅgala", "piṅgala_2", "piMgala", "piNgala", "piNgala_२", "పింగల", "పింగల_౨", "పిఙ్గల", "పిఙ్గల_౨", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೨", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೨"]}, {"id": "piMgalA_२", "headword": "पिंगला_२", "headword_slp1": "piMgalA_२", "fold": "pingala_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगला २\n\nPIṄGALĀ II . A prostitute of the country of Avantī. piṅgalā was born as the daughter of King candrāṅgada in her next birth because of the virtuous act she did in doing service to the sage ṛṣabha. The King named the girl Kīrtimālinī and bhadrāyu married her. (See under bhadrāyu).", "gloss_language": "en"}], "synonyms": ["piMgalaa", "piMgalaa_2", "pingalaa", "pingalaa_2", "piṅgalā", "piṅgalā_2", "पिंगला", "पिङ्गला", "पिङ्गला_२", "పింగలా", "పింగలా_౨", "పిఙ్గలా", "పిఙ్గలా_౨", "ಪಿಂಗಲಾ", "ಪಿಂಗಲಾ_೨", "ಪಿಙ್ಗಲಾ", "ಪಿಙ್ಗಲಾ_೨"], "synonyms_slp1": ["piMgalaa", "piMgalaa_2", "pingalaa", "pingalaa_2", "piṅgalā", "piṅgalā_2", "piMgalA", "piNgalA", "piNgalA_२", "పింగలా", "పింగలా_౨", "పిఙ్గలా", "పిఙ్గలా_౨", "ಪಿಂಗಲಾ", "ಪಿಂಗಲಾ_೨", "ಪಿಙ್ಗಲಾ", "ಪಿಙ್ಗಲಾ_೨"]}], "pingala_३": [{"id": "piMgala_३", "headword": "पिंगल_३", "headword_slp1": "piMgala_३", "fold": "pingala_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल ३\n\nPIṄGALA III . A sage. He was a Yajvā (priest) in the sarpasatra of janamejaya. (Śloka 6, Chapter 53, Ādi Parva).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_3", "pingala", "pingala_3", "piṅgala", "piṅgala_3", "पिंगल", "पिङ्गल", "पिङ्गल_३", "పింగల", "పింగల_౩", "పిఙ్గల", "పిఙ్గల_౩", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೩", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೩"], "synonyms_slp1": ["piMgala", "piMgala_3", "pingala", "pingala_3", "piṅgala", "piṅgala_3", "piMgala", "piNgala", "piNgala_३", "పింగల", "పింగల_౩", "పిఙ్గల", "పిఙ్గల_౩", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೩", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೩"]}, {"id": "piMgalA_३", "headword": "पिंगला_३", "headword_slp1": "piMgalA_३", "fold": "pingala_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगला ३\n\nPIṄGALĀ III . A woman of the city of ayodhyā. Once this woman approached śrī rāma with amorous intentions and śrī rāma who was strictly observing a vow of one-wife refused to satisfy her desire and said:-“During the incarnation of kṛṣṇa you will be born as a servant maid of kaṁsa and then I will in my form as kṛṣṇa accept you.” sītā on hearing this cursed Piṇgalā. She said “Oh beautiful woman who has approached my husband with amorous intentions, you will have three bends in your body when you are born next as the servant maid of kaṁsa.” piṅgalā weeping bitterly craved for pardon and then sītā said that kṛṣṇa would make her perfect. (vilāsa Kāṇḍa, ānanda rāmāyaṇa).", "gloss_language": "en"}], "synonyms": ["piMgalaa", "piMgalaa_3", "pingalaa", "pingalaa_3", "piṅgalā", "piṅgalā_3", "पिंगला", "पिङ्गला", "पिङ्गला_३", "పింగలా", "పింగలా_౩", "పిఙ్గలా", "పిఙ్గలా_౩", "ಪಿಂಗಲಾ", "ಪಿಂಗಲಾ_೩", "ಪಿಙ್ಗಲಾ", "ಪಿಙ್ಗಲಾ_೩"], "synonyms_slp1": ["piMgalaa", "piMgalaa_3", "pingalaa", "pingalaa_3", "piṅgalā", "piṅgalā_3", "piMgalA", "piNgalA", "piNgalA_३", "పింగలా", "పింగలా_౩", "పిఙ్గలా", "పిఙ్గలా_౩", "ಪಿಂಗಲಾ", "ಪಿಂಗಲಾ_೩", "ಪಿಙ್ಗಲಾ", "ಪಿಙ್ಗಲಾ_೩"]}], "pingala_४": [{"id": "piMgala_४", "headword": "पिंगल_४", "headword_slp1": "piMgala_४", "fold": "pingala_४", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल ४\n\nPIṄGALA IV . A King of the Yakṣas. He is a friend of śiva. He acts as body-guard to śiva who spends his time in cremation grounds. This yakṣa gives happiness to all in the world. (Śloka 51, Chapter 23, Vana Parva).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_4", "pingala", "pingala_4", "piṅgala", "piṅgala_4", "पिंगल", "पिङ्गल", "पिङ्गल_४", "పింగల", "పింగల_౪", "పిఙ్గల", "పిఙ్గల_౪", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೪", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೪"], "synonyms_slp1": ["piMgala", "piMgala_4", "pingala", "pingala_4", "piṅgala", "piṅgala_4", "piMgala", "piNgala", "piNgala_४", "పింగల", "పింగల_౪", "పిఙ్గల", "పిఙ్గల_౪", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೪", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೪"]}], "pingala_५": [{"id": "piMgala_५", "headword": "पिंगल_५", "headword_slp1": "piMgala_५", "fold": "pingala_५", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल ५\n\nPIṄGALA V . A lion, who is a character in the book pañcatantra. (See under pañcatantra).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_5", "pingala", "pingala_5", "piṅgala", "piṅgala_5", "पिंगल", "पिङ्गल", "पिङ्गल_५", "పింగల", "పింగల_౫", "పిఙ్గల", "పిఙ్గల_౫", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೫", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೫"], "synonyms_slp1": ["piMgala", "piMgala_5", "pingala", "pingala_5", "piṅgala", "piṅgala_5", "piMgala", "piNgala", "piNgala_५", "పింగల", "పింగల_౫", "పిఙ్గల", "పిఙ్గల_౫", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೫", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೫"]}], "pingala_६": [{"id": "piMgala_६", "headword": "पिंगल_६", "headword_slp1": "piMgala_६", "fold": "pingala_६", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल ६\n\nPIṄGALA VI . A brahmin of very bad manners. This brahmin was killed by his own wife who was a prostitute. In their next birth piṅgala became a vulture and the prostitute, a parrot. Both had memories of their previous birth and the vulture (piṅgala) with vengeance killed the parrot. After that piṅgala was eaten one day by a tiger A brahmin residing on the shores of gaṅgā read to their souls the fifth chapter of gītā and they got salvation and entered Pitṛloka (world of the Manes). (Chapter 40, sṛṣṭi Khaṇḍa, padma purāṇa).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_6", "pingala", "pingala_6", "piṅgala", "piṅgala_6", "पिंगल", "पिङ्गल", "पिङ्गल_६", "పింగల", "పింగల_౬", "పిఙ్గల", "పిఙ్గల_౬", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೬", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೬"], "synonyms_slp1": ["piMgala", "piMgala_6", "pingala", "pingala_6", "piṅgala", "piṅgala_6", "piMgala", "piNgala", "piNgala_६", "పింగల", "పింగల_౬", "పిఙ్గల", "పిఙ్గల_౬", "ಪಿಂಗಲ", "ಪಿಂಗಲ_೬", "ಪಿಙ್ಗಲ", "ಪಿಙ್ಗಲ_೬"]}], "pingala_७": [{"id": "piMgala_७", "headword": "पिंगल_७", "headword_slp1": "piMgala_७", "fold": "pingala_७", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "पिंगल ७\n\nPIṄGALA VII . A rākṣasa (demon). Once when this demon was going through a forest he met a forester. The latter got afraid and climbed up a śamī tree. Then a branch broke and it fell on the head of Gaṇeśa sitting beneath that tree. It was an act of worship and because of that both the forester and the demon were elevated. (Gaṇeśa purāṇa).", "gloss_language": "en"}], "synonyms": ["piMgala", "piMgala_7", "pingala", "pinga