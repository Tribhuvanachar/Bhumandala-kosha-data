{"sujanu": [{"id": "sujAnu", "headword": "सुजानु", "headword_slp1": "sujAnu", "fold": "sujanu", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुजानु\n\nSUJĀNU . A great saint. This hermit stopped śrī kṛṣṇa on his way to hastināpura and conversed with him. (mahābhārata, Dākṣiṇātyapāṭha, Udyoga Parva, Chapter 83).", "gloss_language": "en"}], "synonyms": ["sujaanu", "sujānu", "సుజాను", "ಸುಜಾನು"], "synonyms_slp1": ["sujaanu", "sujānu", "సుజాను", "ಸುಜಾನು"]}], "sujata_१": [{"id": "sujAta_१", "headword": "सुजात_१", "headword_slp1": "sujAta_१", "fold": "sujata_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुजात १\n\nSUJĀTA I . One of the hundred sons of dhṛtarāṣṭra. He attacked Bhīmasena in the battle of bhārata and Bhīmasena killed him. (M.B. śalya Parva, Chapter 26, Verse 5).", "gloss_language": "en"}], "synonyms": ["sujaata", "sujaata_1", "sujāta", "sujāta_1", "सुजात", "సుజాత", "సుజాత_౧", "ಸುಜಾತ", "ಸುಜಾತ_೧"], "synonyms_slp1": ["sujaata", "sujaata_1", "sujāta", "sujāta_1", "sujAta", "సుజాత", "సుజాత_౧", "ಸುಜಾತ", "ಸುಜಾತ_೧"]}], "sujata_२": [{"id": "sujAta_२", "headword": "सुजात_२", "headword_slp1": "sujAta_२", "fold": "sujata_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुजात २\n\nSUJĀTA II . A monkey King. sujāta was one of the sons born to pulaha by his wife śvetā. (brahmāṇḍa purāṇa, 2: 7, 180-181).", "gloss_language": "en"}], "synonyms": ["sujaata", "sujaata_2", "sujāta", "sujāta_2", "सुजात", "సుజాత", "సుజాత_౨", "ಸುಜಾತ", "ಸುಜಾತ_೨"], "synonyms_slp1": ["sujaata", "sujaata_2", "sujāta", "sujāta_2", "sujAta", "సుజాత", "సుజాత_౨", "ಸುಜಾತ", "ಸುಜಾತ_೨"]}], "sujata": [{"id": "sujAtA", "headword": "सुजाता", "headword_slp1": "sujAtA", "fold": "sujata", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुजाता\n\nSUJĀTĀ . The daughter of the hermit uddālaka. (See under khagodara).", "gloss_language": "en"}], "synonyms": ["sujaataa", "sujātā", "సుజాతా", "ಸುಜಾತಾ"], "synonyms_slp1": ["sujaataa", "sujātā", "సుజాతా", "ಸುಜಾತಾ"]}], "sujyesWa": [{"id": "sujyezWa", "headword": "सुज्येष्ठ", "headword_slp1": "sujyezWa", "fold": "sujyesWa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुज्येष्ठ\n\nSUJYEṢṬHA . A King who was the son of agnimitra and the father of vasumitra. (bhāgavata, skandha 12).", "gloss_language": "en"}], "synonyms": ["sujyeShTha", "sujyeṣṭha", "సుజ్యేష్ఠ", "ಸುಜ್ಯೇಷ್ಠ"], "synonyms_slp1": ["sujyeShTha", "sujyeṣṭha", "సుజ్యేష్ఠ", "ಸುಜ್ಯೇಷ್ಠ"]}]}