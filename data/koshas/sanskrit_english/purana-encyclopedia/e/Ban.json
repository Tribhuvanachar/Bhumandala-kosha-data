ia", "senses": [{"gloss": "भानुदत्त\n\nBHĀNUDATTA . A brother of śakuni. In the mahābhārata battle he fought against bhīma and died. (Śloka 24, Chapter 157, droṇa parva, M.B.).", "gloss_language": "en"}], "synonyms": ["bhaanudatta", "bhānudatta", "భానుదత్త", "ಭಾನುದತ್ತ"], "synonyms_slp1": ["bhaanudatta", "bhānudatta", "భానుదత్త", "ಭಾನುದತ್ತ"]}], "Banudeva": [{"id": "BAnudeva", "headword": "भानुदेव", "headword_slp1": "BAnudeva", "fold": "Banudeva", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुदेव\n\nBHĀNUDEVA . A warrior of pāñcāla state. karṇa killed him in battle. (Śloka 15, Chapter 48. karṇa Parva).", "gloss_language": "en"}], "synonyms": ["bhaanudeva", "bhānudeva", "భానుదేవ", "ಭಾನುದೇವ"], "synonyms_slp1": ["bhaanudeva", "bhānudeva", "భానుదేవ", "ಭಾನುದೇವ"]}], "Banukopa": [{"id": "BAnukopa", "headword": "भानुकोप", "headword_slp1": "BAnukopa", "fold": "Banukopa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुकोप\n\nBHĀNUKOPA . A demon. He fought against subrahmaṇya. (asura Khaṇḍa, skanda purāṇa).", "gloss_language": "en"}], "synonyms": ["bhaanukopa", "bhānukopa", "భానుకోప", "ಭಾನುಕೋಪ"], "synonyms_slp1": ["bhaanukopa", "bhānukopa", "భానుకోప", "ಭಾನುಕೋಪ"]}], "Banuman_१": [{"id": "BAnumAn_१", "headword": "भानुमान्_१", "headword_slp1": "BAnumAn_१", "fold": "Banuman_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुमान् १\n\nBHĀNUMĀN I . A king of the dynasty of śrī rāma. He was the father of a King called Śakradyumna. (Navama skanda, bhāgavata).", "gloss_language": "en"}], "synonyms": ["bhaanumaan", "bhaanumaan_1", "bhānumān", "bhānumān_1", "भानुमान्", "భానుమాన్", "భానుమాన్_౧", "ಭಾನುಮಾನ್", "ಭಾನುಮಾನ್_೧"], "synonyms_slp1": ["bhaanumaan", "bhaanumaan_1", "bhānumān", "bhānumān_1", "BAnumAn", "భానుమాన్", "భానుమాన్_౧", "ಭಾನುಮಾನ್", "ಭಾನುಮಾನ್_೧"]}], "Banuman_२": [{"id": "BAnumAn_२", "headword": "भानुमान्_२", "headword_slp1": "BAnumAn_२", "fold": "Banuman_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुमान् २\n\nBHĀNUMĀN II . A son born to kṛṣṇa of satyabhāmā. (Daśama skandha, Bhāgvata).", "gloss_language": "en"}], "synonyms": ["bhaanumaan", "bhaanumaan_2", "bhānumān", "bhānumān_2", "भानुमान्", "భానుమాన్", "భానుమాన్_౨", "ಭಾನುಮಾನ್", "ಭಾನುಮಾನ್_೨"], "synonyms_slp1": ["bhaanumaan", "bhaanumaan_2", "bhānumān", "bhānumān_2", "BAnumAn", "భానుమాన్", "భానుమాన్_౨", "ಭಾನುಮಾನ್", "ಭಾನುಮಾನ್_೨"]}], "Banuman_३": [{"id": "BAnumAn_३", "headword": "भानुमान्_३", "headword_slp1": "BAnumAn_३", "fold": "Banuman_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुमान् ३\n\nBHĀNUMĀN III . A prince of kaliṅga. He fought on the side of the kauravas and was killed by Bhīmasena. (Chapter 54, bhīṣma parva, M.B.)", "gloss_language": "en"}], "synonyms": ["bhaanumaan", "bhaanumaan_3", "bhānumān", "bhānumān_3", "भानुमान्", "భానుమాన్", "భానుమాన్_౩", "ಭಾನುಮಾನ್", "ಭಾನುಮಾನ್_೩"], "synonyms_slp1": ["bhaanumaan", "bhaanumaan_3", "bhānumān", "bhānumān_3", "BAnumAn", "భానుమాన్", "భానుమాన్_౩", "ಭಾನುಮಾನ್", "ಭಾನುಮಾನ್_೩"]}], "Banumati_१": [{"id": "BAnumatI_१", "headword": "भानुमती_१", "headword_slp1": "BAnumatI_१", "fold": "Banumati_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुमती १\n\nBHĀNUMATĪ I . The daughter of bhānu, a leader of the Yādavas. When śrī kṛṣṇa went with his retinue of Yādavas to visit the holy palace called piṇḍāraka the Yādavas conducted a wine festival. During that festival a demon of the name nikumbha carried away bhānumatī. This was because of a curse to bhānumatī from durvāsas whom bhānumatī did not respect once when they met at the garden of raivata. durvāsas had after the curse consoled her by assuring her that she would be saved and married by sahadeva, one of the pāṇḍavas. True to this, bhānumatī was married to sahadeva in the presence of nārada and kṛṣṇa. (viṣṇu Parva, Chapter 90).", "gloss_language": "en"}], "synonyms": ["bhaanumatee", "bhaanumatee_1", "bhaanumatii", "bhaanumatii_1", "bhānumatī", "bhānumatī_1", "भानुमती", "భానుమతీ", "భానుమతీ_౧", "ಭಾನುಮತೀ", "ಭಾನುಮತೀ_೧"], "synonyms_slp1": ["bhaanumatee", "bhaanumatee_1", "bhaanumatii", "bhaanumatii_1", "bhānumatī", "bhānumatī_1", "BAnumatI", "భానుమతీ", "భానుమతీ_౧", "ಭಾನುಮತೀ", "ಭಾನುಮತೀ_೧"]}], "Banumati_२": [{"id": "BAnumatI_२", "headword": "भानुमती_२", "headword_slp1": "BAnumatI_२", "fold": "Banumati_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुमती २\n\nBHĀNUMATĪ II . Daughter of kṛtavīrya. She was the wife of Ahaṁyati, a king of the pūru line of monarchs. They had a son named sārvabhauma.", "gloss_language": "en"}], "synonyms": ["bhaanumatee", "bhaanumatee_2", "bhaanumatii", "bhaanumatii_2", "bhānumatī", "bhānumatī_2", "भानुमती", "భానుమతీ", "భానుమతీ_౨", "ಭಾನುಮತೀ", "ಭಾನುಮತೀ_೨"], "synonyms_slp1": ["bhaanumatee", "bhaanumatee_2", "bhaanumatii", "bhaanumatii_2", "bhānumatī", "bhānumatī_2", "BAnumatI", "భానుమతీ", "భానుమతీ_౨", "ಭಾನುಮತೀ", "ಭಾನುಮತೀ_೨"]}], "Banumati_३": [{"id": "BAnumatI_३", "headword": "भानुमती_३", "headword_slp1": "BAnumatI_३", "fold": "Banumati_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुमती ३\n\nBHĀNUMATĪ III . Daughter of aṅgiras. She was extraordinarily beautiful. (Śloka 3, Chapter 218, Vana Parva, M.B.).", "gloss_language": "en"}], "synonyms": ["bhaanumatee", "bhaanumatee_3", "bhaanumatii", "bhaanumatii_3", "bhānumatī", "bhānumatī_3", "भानुमती", "భానుమతీ", "భానుమతీ_౩", "ಭಾನುಮತೀ", "ಭಾನುಮತೀ_೩"], "synonyms_slp1": ["bhaanumatee", "bhaanumatee_3", "bhaanumatii", "bhaanumatii_3", "bhānumatī", "bhānumatī_3", "BAnumatI", "భానుమతీ", "భానుమతీ_౩", "ಭಾನುಮತೀ", "ಭಾನುಮತೀ_೩"]}], "Banusena": [{"id": "BAnusena", "headword": "भानुसेन", "headword_slp1": "BAnusena", "fold": "Banusena", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भानुसेन\n\nBHĀNUSENA . A son of karṇa. He was killed in the battle by Bhīmasena. (Śloka 27, Chapter 48, karṇa Parva, M.B.).", "gloss_language": "en"}], "synonyms": ["bhaanusena", "bhānusena", "భానుసేన", "ಭಾನುಸೇನ"], "synonyms_slp1": ["bhaanusena", "bhānusena", "భానుసేన", "ಭಾನುಸೇನ"]}]}