{"Dvajavati": [{"id": "DvajavatI", "headword": "ध्वजवती", "headword_slp1": "DvajavatI", "fold": "Dvajavati", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ध्वजवती\n\nDHVAJAVATĪ . The daughter of the hermit Harimedha, who lived in the sky, according to the order of the Sun. (M.B. Udyoga Parva, Chapter 110, Stanza 13).", "gloss_language": "en"}], "synonyms": ["dhvajavatee", "dhvajavatii", "dhvajavatī", "ధ్వజవతీ", "ಧ್ವಜವತೀ"], "synonyms_slp1": ["dhvajavatee", "dhvajavatii", "dhvajavatī", "ధ్వజవతీ", "ಧ್ವಜವತೀ"]}], "Dvajini": [{"id": "DvajinI", "headword": "ध्वजिनी", "headword_slp1": "DvajinI", "fold": "Dvajini", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ध्वजिनी\n\nDHVAJINĪ . A country in ancient india. (M.B. bhīṣma Parva, Chapter 83).", "gloss_language": "en"}], "synonyms": ["dhvajinee", "dhvajinii", "dhvajinī", "ధ్వజినీ", "ಧ್ವಜಿನೀ"], "synonyms_slp1": ["dhvajinee", "dhvajinii", "dhvajinī", "ధ్వజినీ", "ಧ್ವಜಿನೀ"]}], "Dvani": [{"id": "Dvani", "headword": "ध्वनि", "headword_slp1": "Dvani", "fold": "Dvani", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ध्वनि\n\nDHVANI . The son of āpa who is one of the eight Vasus. āpa had four sons called vaitaṇḍa, śrama, śānta and dhvani. (viṣṇu purāṇa, Āṁśa 1, Chapter 15).", "gloss_language": "en"}], "synonyms": ["dhvani", "ధ్వని", "ಧ್ವನಿ"], "synonyms_slp1": ["dhvani", "ధ్వని", "ಧ್ವನಿ"]}], "Dvanya": [{"id": "Dvanya", "headword": "ध्वन्य", "headword_slp1": "Dvanya", "fold": "Dvanya", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ध्वन्य\n\nDHVANYA . A king. He was the son of lakṣmaṇa. (See ṛgveda Index).", "gloss_language": "en"}], "synonyms": ["dhvanya", "ధ్వన్య", "ಧ್ವನ್ಯ"], "synonyms_slp1": ["dhvanya", "ధ్వన్య", "ಧ್ವನ್ಯ"]}], "Dvasanti": [{"id": "Dvasanti", "headword": "ध्वसन्ति", "headword_slp1": "Dvasanti", "fold": "Dvasanti", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ध्वसन्ति\n\nDHVASANTI . A hermit of the period of the ṛgveda. aśvinīdevas rescued the hermits turvīti, dabhīti, dhvasanti and puruṣanti from danger. ṛgveda, Maṇḍala 1, Anuvāka 16, Sūkta 112).", "gloss_language": "en"}], "synonyms": ["dhvasanti", "ధ్వసన్తి", "ಧ್ವಸನ್ತಿ"], "synonyms_slp1": ["dhvasanti", "ధ్వసన్తి", "ಧ್ವಸನ್ತಿ"]}]}