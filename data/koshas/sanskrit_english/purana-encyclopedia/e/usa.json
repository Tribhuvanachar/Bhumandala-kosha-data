{"usa_१": [{"id": "uzA_१", "headword": "उषा_१", "headword_slp1": "uzA_१", "fold": "usa_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उषा १\n\nUṢĀ I . The daughter of Bāṇāsura and the wife of aniruddha.1) Genealogy. Descended from viṣṇu in the following order:-brahmā-kaśyapa-hiraṇyakaśipu-PrahlādaVirocana-mahābali-bāṇa-uṣā.\n2) marriage of uṣā. See under aniruddha.", "gloss_language": "en"}], "synonyms": ["uShaa", "uShaa_1", "uṣā", "uṣā_1", "उषा", "ఉషా", "ఉషా_౧", "ಉಷಾ", "ಉಷಾ_೧"], "synonyms_slp1": ["uShaa", "uShaa_1", "uṣā", "uṣā_1", "uzA", "ఉషా", "ఉషా_౧", "ಉಷಾ", "ಉಷಾ_೧"]}], "usa_२": [{"id": "uzA_२", "headword": "उषा_२", "headword_slp1": "uzA_२", "fold": "usa_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उषा २\n\nUṢĀ II . The daughter of a hermit. The king of Śālva once attacked satyaratha, the king of vidarbha, and killed him. The queens of the king of vidarbha went to the forest. One of them who was pregnant gave birth to a child on the bank of a river. When she got down into the river to drink water, a crocodile swallowed her. Then a hermit's daughter named uṣā brought up the child. (śiva purāṇa).", "gloss_language": "en"}], "synonyms": ["uShaa", "uShaa_2", "uṣā", "uṣā_2", "उषा", "ఉషా", "ఉషా_౨", "ಉಷಾ", "ಉಷಾ_೨"], "synonyms_slp1": ["uShaa", "uShaa_2", "uṣā", "uṣā_2", "uzA", "ఉషా", "ఉషా_౨", "ಉಷಾ", "ಉಷಾ_೨"]}], "usa_३": [{"id": "uzA_३", "headword": "उषा_३", "headword_slp1": "uzA_३", "fold": "usa_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उषा ३\n\nUṢĀ III . The night is called uṣā and the day, Ghuṣṭi. The time between uṣā and Ghuṣṭi is called sandhyā. (viṣṇu purāṇa, Aṁ a 2, Chapter 8).", "gloss_language": "en"}], "synonyms": ["uShaa", "uShaa_3", "uṣā", "uṣā_3", "उषा", "ఉషా", "ఉషా_౩", "ಉಷಾ", "ಉಷಾ_೩"], "synonyms_slp1": ["uShaa", "uShaa_3", "uṣā", "uṣā_3", "uzA", "ఉషా", "ఉషా_౩", "ಉಷಾ", "ಉಷಾ_೩"]}], "usangu_१": [{"id": "uzaMgu_१", "headword": "उषंगु_१", "