{"suyajYa": [{"id": "suyajYA", "headword": "सुयज्ञा", "headword_slp1": "suyajYA", "fold": "suyajYa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुयज्ञा\n\nSUYAJÑĀ . Daughter of King prasenajit of the pūru dynasty. She was wedded to King mahābhauma and King Ayutanāyī was their son. (Ādi Parva, Chapter 95, Verse 20).", "gloss_language": "en"}], "synonyms": ["suyaj~naa", "suyajñā", "సుయజ్ఞా", "ಸುಯಜ್ಞಾ"], "synonyms_slp1": ["suyaj~naa", "suyajñā", "సుయజ్ఞా", "ಸುಯಜ್ಞಾ"]}], "suyaju": [{"id": "suyaju", "headword": "सुयजु", "headword_slp1": "suyaju", "fold": "suyaju", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुयजु\n\nSUYAJU . A King who was the grandson of Emperor bharata and son of Bhumanyu. His mother was puṣkariṇī. (Ādi Parva, Chapter 94, Verse 24).", "gloss_language": "en"}], "synonyms": ["suyaju", "సుయజు", "ಸುಯಜು"], "synonyms_slp1": ["suyaju", "సుయజు", "ಸುಯಜು"]}], "suyama": [{"id": "suyama", "headword": "सुयम", "headword_slp1": "suyama", "fold": "suyama", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुयम\n\nSUYAMA . Third son of the rākṣasa called śataśṛṅga. sudeva, the army-chief of King ambarīṣa, killed suyama. (M.B. Southern text, śānti Parva, Chapter 98).", "gloss_language": "en"}], "synonyms": ["suyama", "సుయమ", "ಸುಯಮ"], "synonyms_slp1": ["suyama", "సుయమ", "ಸುಯಮ"]}], "suyasa_१": [{"id": "suyaSA_१", "headword": "सुयशा_१", "headword_slp1": "suyaSA_१", "fold": "suyasa_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुयशा १\n\nSUYAŚĀ I . A daughter of King Bāhuda and wife of parīkṣit, son of Anaśvā. The couple had a son called Bhīmasena. (Ādi Parva, Chapter 95, Verse 41).", "gloss_language": "en"}], "synonyms": ["suyashaa", "suyashaa_1", "suyaśā", "suyaśā_1", "सुयशा", "సుయశా", "సుయశా_౧", "ಸುಯಶಾ", "ಸುಯಶಾ_೧"], "synonyms_slp1": ["suyashaa", "suyashaa_1", "suyaśā", "suyaśā_1", "suyaSA", "సుయశా", "సుయశా_౧", "ಸುಯಶಾ", "ಸುಯಶಾ_೧"]}], "suyasa_२": [{"id": "suyaSA_२", "headword": "सुयशा_२", "headword_slp1": "suyaSA_२", "fold": "suyasa_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "सुयशा २\n\nSUYAŚĀ II . Consort of King divodāsa of kāśī. (For details see under nikumbha).", "gloss_language": "en"}], "synonyms": ["suyashaa", "suyashaa_2", "suyaśā", "suyaśā_2", "सुयशा", "సుయశా", "సుయశా_౨", "ಸುಯಶಾ", "ಸುಯಶಾ_೨"], "synonyms_slp1": ["suyashaa", "suyashaa_2", "suyaśā", "suyaśā_2", "suyaSA", "సుయశా", "సుయశా_౨", "ಸುಯಶಾ", "ಸುಯಶಾ_೨"]}]}