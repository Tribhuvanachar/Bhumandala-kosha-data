{"syena_१": [{"id": "Syena_१", "headword": "श्येन_१", "headword_slp1": "Syena_१", "fold": "syena_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "श्येन १\n\nŚYENA I . A class of birds. A daughter named “Śyenī” was born to kaśyapa prajāpati by his wife tāmrā. Śyenas were the sons of śyenī. (M.B. Ādi Parva, Chapter 66, Verse 56).", "gloss_language": "en"}], "synonyms": ["shyena", "shyena_1", "śyena", "śyena_1", "श्येन", "శ్యేన", "శ్యేన_౧", "ಶ್ಯೇನ", "ಶ್ಯೇನ_೧"], "synonyms_slp1": ["shyena", "shyena_1", "śyena", "śyena_1", "Syena", "శ్యేన", "శ్యేన_౧", "ಶ್ಯೇನ", "ಶ್ಯೇನ_೧"]}], "syena_२": [{"id": "Syena_२", "headword": "श्येन_२", "headword_slp1": "Syena_२", "fold": "syena_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "श्येन २\n\nŚYENA II . An ancient sage. mahābhārata, Sabhā Parva Chapter 7, Verse 11, describes him as shining in Indra's assembly.", "gloss_language": "en"}], "synonyms": ["shyena", "shyena_2", "śyena", "śyena_2", "श्येन", "శ్యేన", "శ్యేన_౨", "ಶ್ಯೇನ", "ಶ್ಯೇನ_೨"], "synonyms_slp1": ["shyena", "shyena_2", "śyena", "śyena_2", "Syena", "శ్యేన", "శ్యేన_౨", "ಶ್ಯೇನ", "ಶ್ಯೇನ_೨"]}], "syenacitra": [{"id": "Syenacitra", "headword": "श्येनचित्र", "headword_slp1": "Syenacitra", "fold": "syenacitra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "श्येनचित्र\n\nŚYENACITRA . A King in ancient india. This King had never eaten meat. (M.B. anuśāsana parva, Chapter 115, Verse 63).", "gloss_language": "en"}], "synonyms": ["shyenachitra", "śyenacitra", "శ్యేనచిత్ర", "ಶ್ಯೇನಚಿತ್ರ"], "synonyms_slp1": ["shyenachitra", "śyenacitra", "శ్యేనచిత్ర", "ಶ್ಯೇನಚಿತ್ರ"]}], "syenagami": [{"id": "SyenagAmI", "headword": "श्येनगामी", "headword_slp1": "SyenagAmI", "fold": "syenagami", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "श्येनगामी\n\nŚYENAGĀMĪ . A military commander of khara the rākṣasa. In his battle with śrī rāma, khara had twelve military commande