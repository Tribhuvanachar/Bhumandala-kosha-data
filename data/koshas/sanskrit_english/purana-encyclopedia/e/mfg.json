{"mfgaDuma": [{"id": "mfgaDUma", "headword": "मृगधूम", "headword_slp1": "mfgaDUma", "fold": "mfgaDuma", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगधूम\n\nMṚGADHŪMA . A sacred place on the border of kurukṣetra. If one goes there and worships mahādeva one will get the benefit of conducting an Aśvamedhayajña. (Śloka 101, Chapter 83, Vana Parva).", "gloss_language": "en"}], "synonyms": ["mRRigadhuuma", "mRgadhooma", "mRgadhuuma", "mRigadhuuma", "mRugadhuuma", "mṛgadhūma", "మృగధూమ", "ಮೃಗಧೂಮ"], "synonyms_slp1": ["mRRigadhuuma", "mRgadhooma", "mRgadhuuma", "mRigadhuuma", "mRugadhuuma", "mṛgadhūma", "మృగధూమ", "ಮೃಗಧೂಮ"]}], "mfgamanda": [{"id": "mfgamandA", "headword": "मृगमन्दा", "headword_slp1": "mfgamandA", "fold": "mfgamanda", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगमन्दा\n\nMṚGAMANDĀ . A daughter of kaśyapa. (See under mṛgas).", "gloss_language": "en"}], "synonyms": ["mRRigamandaa", "mRgamandaa", "mRigamandaa", "mRugamandaa", "mṛgamandā", "మృగమన్దా", "ಮೃಗಮನ್ದಾ"], "synonyms_slp1": ["mRRigamandaa", "mRgamandaa", "mRigamandaa", "mRugamandaa", "mṛgamandā", "మృగమన్దా", "ಮೃಗಮನ್ದಾ"]}], "mfgankaka": [{"id": "mfgAMkaka", "headword": "मृगांकक", "headword_slp1": "mfgAMkaka", "fold": "mfgankaka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगांकक\n\nMṚGĀṄKAKA . A sword. Once kubera cursed a yakṣa and making him a lion posted it to guard the palace- gates of mahābali. He said he would be released from the curse when any man on earth defeated it. Once a brahmin warrior named śrīdatta defeated this lion and at once the lion changed into a yakṣa and the yakṣa presented śrīdatta with the sword named mṛgāṅkaka. (Kathāpīṭhalambaka, kathāsaritsāgara).", "gloss_language": "en"}], "synonyms": ["mRRigaaMkaka", "mRRigaankaka", "mRgaaMkaka", "mRgaankaka", "mRigaaMkaka", "mRigaankaka", "mRugaaMkaka", "mRugaankaka", "mṛgāṅkaka", "मृगाङ्कक", "మృగాంకక", "మృగాఙ్కక", "ಮೃಗಾಂಕಕ", "ಮೃಗಾಙ್ಕಕ"], "synonyms_slp1": ["mRRigaaMkaka", "mRRigaankaka", "mRgaaMkaka", "mRgaankaka", "mRigaaMkaka", "mRigaankaka", "mRugaaMkaka", "mRugaankaka", "mṛgāṅkaka", "mfgANkaka", "మృగాంకక", "మృగాఙ్కక", "ಮೃಗಾಂಕಕ", "ಮೃಗಾಙ್ಕಕ"]}], "mfgankavati": [{"id": "mfgAMkavatI", "headword": "मृगांकवती", "headword_slp1": "mfgAMkavatI", "fold": "mfgankavati", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगांकवती\n\nMṚGĀṄKAVATĪ . Daughter of an ancient King called Śrī Bimbaki. (See under śrīdatta).", "gloss_language": "en"}], "synonyms": ["mRRigaaMkavatii", "mRRigaankavatii", "mRgaaMkavatee", "mRgaaMkavatii", "mRgaankavatee", "mRgaankavatii", "mRigaaMkavatii", "mRigaankavatii", "mRugaaMkavatii", "mRugaankavatii", "mṛgāṅkavatī", "मृगाङ्कवती", "మృగాంకవతీ", "మృగాఙ్కవతీ", "ಮೃಗಾಂಕವತೀ", "ಮೃಗಾಙ್ಕವತೀ"], "synonyms_slp1": ["mRRigaaMkavatii", "mRRigaankavatii", "mRgaaMkavatee", "mRgaaMkavatii", "mRgaankavatee", "mRgaankavatii", "mRigaaMkavatii", "mRigaankavatii", "mRugaaMkavatii", "mRugaankavatii", "mṛgāṅkavatī", "mfgANkavatI", "మృగాంకవతీ", "మృగాఙ్కవతీ", "ಮೃಗಾಂಕವತೀ", "ಮೃಗಾಙ್ಕವತೀ"]}], "mfgas": [{"id": "mfgas", "headword": "मृगस्", "headword_slp1": "mfgas", "fold": "mfgas", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगस्\n\nMṚGAS (deer) . All the animals originated from Kaśyapaprajāpati. Kaśyapaprajāpati, son of marīci, married the eight daughters of dakṣa named tāmrā etc. From tāmrā were born birds. krodhavaśā gave birth to ten girls named mṛgī, mṛgamandā, Harī, Bhadramadā, mātaṅgī, śārdūlī, śvetā, surabhi, surasā and kadrū. mṛgas (deer) are the children of mṛgī. (vālmīki rāmāyaṇa, araṇya Kāṇḍa, sarga 4).", "gloss_language": "en"}], "synonyms": ["deer", "mRRigas", "mRgas", "mRigas", "mRugas", "mṛgas", "देएर्", "దేఏర్", "మృగస్", "ದೇಏರ್", "ಮೃಗಸ್"], "synonyms_slp1": ["deer", "mRRigas", "mRgas", "mRigas", "mRugas", "mṛgas", "deer", "దేఏర్", "మృగస్", "ದೇಏರ್", "ಮೃಗಸ್"]}], "mfgasvapnodBavaparva": [{"id": "mfgasvapnodBavaparva", "headword": "मृगस्वप्नोद्भवपर्व", "headword_slp1": "mfgasvapnodBavaparva", "fold": "mfgasvapnodBavaparva", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगस्वप्नोद्भवपर्व\n\nMṚGASVAPNODBHAVAPARVA . A subsidiary Parva of the Vana Parva of mahābhārata. Chapter 258 of Vana Parva constitutes this Parva.", "gloss_language": "en"}], "synonyms": ["mRRigasvapnodbhavaparva", "mRgasvapnodbhavaparva", "mRigasvapnodbhavaparva", "mRugasvapnodbhavaparva", "mṛgasvapnodbhavaparva", "మృగస్వప్నోద్భవపర్వ", "ಮೃಗಸ್ವಪ್ನೋದ್ಭವಪರ್ವ"], "synonyms_slp1": ["mRRigasvapnodbhavaparva", "mRgasvapnodbhavaparva", "mRigasvapnodbhavaparva", "mRugasvapnodbhavaparva", "mṛgasvapnodbhavaparva", "మృగస్వప్నోద్భవపర్వ", "ಮೃಗಸ್ವಪ್ನೋದ್ಭವಪರ್ವ"]}], "mfgavati": [{"id": "mfgAvatI", "headword": "मृगावती", "headword_slp1": "mfgAvatI", "fold": "mfgavati", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगावती\n\nMṚGĀVATĪ . See under udayana.", "gloss_language": "en"}], "synonyms": ["mRRigaavatii", "mRgaavatee", "mRgaavatii", "mRigaavatii", "mRugaavatii", "mṛgāvatī", "మృగావతీ", "ಮೃಗಾವತೀ"], "synonyms_slp1": ["mRRigaavatii", "mRgaavatee", "mRgaavatii", "mRigaavatii", "mRugaavatii", "mṛgāvatī", "మృగావతీ", "ಮೃಗಾವತೀ"]}], "mfgavyaDa": [{"id": "mfgavyADa", "headword": "मृगव्याध", "headword_slp1": "mfgavyADa", "fold": "mfgavyaDa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगव्याध\n\nMṚGAVYĀDHA . The disguise śiva took when he went to test the devotion of paraśurāma. paraśurāma once went to the forests and did penance to please śiva to learn archery from him. śiva in the form of a mṛgavyādha (forest hunter) appeared before paraśurāma and tested his sincerity in his penance in several ways. śiva was pleased to find Paraśurāma's devotion to śiva unwavering and blessed him. He gave instructions in archery and also permitted him to go round the earth. (Chapter 65, brahmāṇḍa purāṇa).", "gloss_language": "en"}], "synonyms": ["mRRigavyaadha", "mRgavyaadha", "mRigavyaadha", "mRugavyaadha", "mṛgavyādha", "మృగవ్యాధ", "ಮೃಗವ್ಯಾಧ"], "synonyms_slp1": ["mRRigavyaadha", "mRgavyaadha", "mRigavyaadha", "mRugavyaadha", "mṛgavyādha", "మృగవ్యాధ", "ಮೃಗವ್ಯಾಧ"]}], "mfgavyaDa_२": [{"id": "mfgavyADa_२", "headword": "मृगव्याध_२", "headword_slp1": "mfgavyADa_२", "fold": "mfgavyaDa_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगव्याध २\n\nMṚGAVYĀDHA II . One of the ekādaśarudras (eleven Rudras). (Śloka 2, Chapter 66, Ādi Parva).", "gloss_language": "en"}], "synonyms": ["mRRigavyaadha", "mRRigavyaadha_2", "mRgavyaadha", "mRgavyaadha_2", "mRigavyaadha", "mRigavyaadha_2", "mRugavyaadha", "mRugavyaadha_2", "mṛgavyādha", "mṛgavyādha_2", "मृगव्याध", "మృగవ్యాధ", "మృగవ్యాధ_౨", "ಮೃಗವ್ಯಾಧ", "ಮೃಗವ್ಯಾಧ_೨"], "synonyms_slp1": ["mRRigavyaadha", "mRRigavyaadha_2", "mRgavyaadha", "mRgavyaadha_2", "mRigavyaadha", "mRigavyaadha_2", "mRugavyaadha", "mRugavyaadha_2", "mṛgavyādha", "mṛgavyādha_2", "mfgavyADa", "మృగవ్యాధ", "మృగవ్యాధ_౨", "ಮೃಗವ್ಯಾಧ", "ಮೃಗವ್ಯಾಧ_೨"]}], "mfgi": [{"id": "mfgI", "headword": "मृगी", "headword_slp1": "mfgI", "fold": "mfgi", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मृगी\n\nMṚGĪ . The mother of all types of deer. (See under mṛgas).", "gloss_language": "en"}], "synonyms": ["mRRigii", "mRgee", "mRgii", "mRigii", "mRugii", "mṛgī", "మృగీ", "ಮೃಗೀ"], "synonyms_slp1": ["mRRigii", "mRgee", "mRgii", "mRigii", "mRugii", "mṛgī", "మృగీ", "ಮೃಗೀ"]}]}