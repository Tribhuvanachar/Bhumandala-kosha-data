{"Dumapa": [{"id": "DUmapa", "headword": "धूमप", "headword_slp1": "DUmapa", "fold": "Dumapa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "धूमप\n\nDHŪMAPA . A set of deified manes (pitṛs) who form a gaṇa (Śiva's hosts of deities). This Gaṇa is seen to have attended the sacrifice of dakṣa. (M.B. śānti Parva, Chapter 284, Stanza 8.)", "gloss_language": "en"}], "synonyms": ["dhoomapa", "dhuumapa", "dhūmapa", "ధూమప", "ಧೂಮಪ"], "synonyms_slp1": ["dhoomapa", "dhuumapa", "dhūmapa", "ధూమప", "ಧೂಮಪ"]}], "Dumapala": [{"id": "DUmapAlA", "headword": "धूमपाला", "headword_slp1": "DUmapAlA", "fold": "Dumapala", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "धूमपाला\n\nDHŪMAPĀLĀ . A river. (M.B. bhīṣma parva, Chapter 9, Stanza 18).", "gloss_language": "en"}], "synonyms": ["dhoomapaalaa", "dhuumapaalaa", "dhūmapālā", "ధూమపాలా", "ಧೂಮಪಾಲಾ"], "synonyms_slp1": ["dhoomapaalaa", "dhuumapaalaa", "dhūmapālā", "ధూమపాలా", "ಧೂಮಪಾಲಾ"]}], "Dumavati": [{"id": "DUmAvatI", "headword": "धूमावती", "headword_slp1": "DUmAvatI", "fold": "Dumavati", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "धूमावती\n\nDHŪMĀVATĪ . A holy place. The wishes of those who take three days' fast in this holy place are realised. (M.B. Vana Parva, Chapter 84, Stanza 22).", "gloss_language": "en"}], "synonyms": ["dhoomaavatee", "dhuumaavatii", "dhūmāvatī", "ధూమావతీ", "ಧೂಮಾವತೀ"], "synonyms_slp1": ["dhoomaavatee", "dhuumaavatii", "dhūmāvatī", "ధూమావతీ", "ಧೂಮಾವತೀ"]}], "Dumini": [{"id": "DUminI", "headword": "धूमिनी", "headword_slp1": "DUminI", "fold": "Dumini", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "धूमिनी\n\nDHŪMINĪ . The wife of King ajamīḍha of puru dynasty By this wife, a son named ṛkṣa was born to ajamīḍha. (M.B. Ādi Parva, Chapter 94, Stanza 32).", "gloss_language": "en"}], "synonyms": ["dhoominee", "dhuuminii", "dhūminī", "ధూమినీ", "ಧೂಮಿನೀ"], "synonyms_slp1": ["dhoominee", "dh