{"gfdDrakuwa": [{"id": "gfdDrakUwa", "headword": "गृद्ध्रकूट", "headword_slp1": "gfdDrakUwa", "fold": "gfdDrakuwa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गृद्ध्रकूट\n\nGṚDDHRAKŪṬA . A mountain of northern india. The Laṁśūras gave protection to bṛhadratha at this mountain. (Śloka 82, Chapter 49, śānti Parva).", "gloss_language": "en"}], "synonyms": ["gRRiddhrakuuTa", "gRddhrakooTa", "gRddhrakuuTa", "gRiddhrakuuTa", "gRuddhrakuuTa", "gṛddhrakūṭa", "గృద్ధ్రకూట", "ಗೃದ್ಧ್ರಕೂಟ"], "synonyms_slp1": ["gRRiddhrakuuTa", "gRddhrakooTa", "gRddhrakuuTa", "gRiddhrakuuTa", "gRuddhrakuuTa", "gṛddhrakūṭa", "గృద్ధ్రకూట", "ಗೃದ್ಧ್ರಕೂಟ"]}], "gfdDrapatra": [{"id": "gfdDrapatra", "headword": "गृद्ध्रपत्र", "headword_slp1": "gfdDrapatra", "fold": "gfdDrapatra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गृद्ध्रपत्र\n\nGṚDDHRAPATRA . A soldier of Skandadeva, (Śloka 74, Chapter 45, śalya Parva).", "gloss_language": "en"}], "synonyms": ["gRRiddhrapatra", "gRddhrapatra", "gRiddhrapatra", "gRuddhrapatra", "gṛddhrapatra", "గృద్ధ్రపత్ర", "ಗೃದ್ಧ್ರಪತ್ರ"], "synonyms_slp1": ["gRRiddhrapatra", "gRddhrapatra", "gRiddhrapatra", "gRuddhrapatra", "gṛddhrapatra", "గృద్ధ్రపత్ర", "ಗೃದ್ಧ್ರಪತ್ರ"]}], "gfdDravawa": [{"id": "gfdDravawa", "headword": "गृद्ध्रवट", "headword_slp1": "gfdDravawa", "fold": "gfdDravawa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गृद्ध्रवट\n\nGṚDDHRAVAṬA . A mount of the Himālayas. This mount is the abode of mahādeva. Those brahmins who visit this place would get mokṣa and those of other castes would be absolved of all sins. (Śloka 91, Chapter 84, Vana Parva).", "gloss_language": "en"}], "synonyms": ["gRRiddhravaTa", "gRddhravaTa", "gRiddhravaTa", "gRuddhravaTa", "gṛddhravaṭa", "గృద్ధ్రవట", "ಗೃದ್ಧ್ರವಟ"], "synonyms_slp1": ["gRRiddhravaTa", "gRddhravaTa", "gRiddhravaTa", "gRuddhravaTa", "gṛddhravaṭa", "గృద్ధ్రవట", "ಗೃದ್ಧ್ರವಟ"]}], "gfdDrika": [{"id": "gfdDrikA", "headwor