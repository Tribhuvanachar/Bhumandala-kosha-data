{"dEtyadipa": [{"id": "dEtyadIpa", "headword": "दैत्यदीप", "headword_slp1": "dEtyadIpa", "fold": "dEtyadipa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "दैत्यदीप\n\nDAITYADĪPA . One of the sons of garuḍa. Mention is made about daityadīpa in mahābhārata, Udyoga Parva, Chapter 101, Stanza 11.", "gloss_language": "en"}], "synonyms": ["daityadeepa", "daityadiipa", "daityadīpa", "దైత్యదీప", "ದೈತ್ಯದೀಪ"], "synonyms_slp1": ["daityadeepa", "daityadiipa", "daityadīpa", "దైత్యదీప", "ದೈತ್ಯದೀಪ"]}], "dEtyasena": [{"id": "dEtyasenA", "headword": "दैत्यसेना", "headword_slp1": "dEtyasenA", "fold": "dEtyasena", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "दैत्यसेना\n\nDAITYASENĀ . Sister of devasenā, the wife of subrahmaṇya. Keśi, an asura, married her. (For detailed story, see devasenā).", "gloss_language": "en"}], "synonyms": ["daityasenaa", "daityasenā", "దైత్యసేనా", "ದೈತ್ಯಸೇನಾ"], "synonyms_slp1": ["daityasenaa", "daityasenā", "దైత్యసేనా", "ದೈತ್ಯಸೇನಾ"]}]}