{"hema": [{"id": "hemA", "headword": "हेमा", "headword_slp1": "hemA", "fold": "hema", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हेमा\n\nHEMĀ . A lover (wife) of maya, the asura. (For details see maya, indra, para 61 and sub para 3 of para, 24, rāma and svayamprabhā.).", "gloss_language": "en"}], "synonyms": ["hemaa", "hemā", "హేమా", "ಹೇಮಾ"], "synonyms_slp1": ["hemaa", "hemā", "హేమా", "ಹೇಮಾ"]}], "hemacandra": [{"id": "hemacandra", "headword": "हेमचन्द्र", "headword_slp1": "hemacandra", "fold": "hemacandra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हेमचन्द्र\n\nHEMACANDRA . A King, son of King viśāla and father of sucandra. (bhāgavata, 9th skandha).", "gloss_language": "en"}], "synonyms": ["hemacandra", "hemachandra", "హేమచన్ద్ర", "ಹೇಮಚನ್ದ್ರ"], "synonyms_slp1": ["hemacandra", "hemachandra", "హేమచన్ద్ర", "ಹೇಮಚನ್ದ್ರ"]}], "hemaguha": [{"id": "hemaguha", "headword": "हेमगुह", "headword_slp1": "hemaguha", "fold": "hemaguha", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हेमगुह\n\nHEMAGUHA . A nāga born in Kaśyapa's dynasty. (Ādi Parva, Chapter 35, Verse 9).", "gloss_language": "en"}], "synonyms": ["hemaguha", "హేమగుహ", "ಹೇಮಗುಹ"], "synonyms_slp1": ["hemaguha", "హేమగుహ", "ಹೇಮಗುಹ"]}], "hemakanta": [{"id": "hemakAnta", "headword": "हेमकान्त", "headword_slp1": "hemakAnta", "fold": "hemakanta", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हेमकान्त\n\nHEMAKĀNTA . Son of King Kuśaketu of vaṅga. He committed the sin of brahmahatyā as he killed the sage, Śatārcas. Later on he redeemed himself from the sin by giving water to trita, a brahmin. (skanda purāṇa).", "gloss_language": "en"}], "synonyms": ["hemakaanta", "hemakānta", "హేమకాన్త", "ಹೇಮಕಾನ್ತ"], "synonyms_slp1": ["hemakaanta", "hemakānta", "హేమకాన్త", "ಹೇಮಕಾನ್ತ"]}], "hemakuRqala": [{"id": "hemakuRqala", "headword": "हेमकुण्डल", "headword_slp1": "hemakuRqala", "fold": "hemakuRqa