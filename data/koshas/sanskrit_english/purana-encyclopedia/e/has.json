{"hasini": [{"id": "hAsinI", "headword": "हासिनी", "headword_slp1": "hAsinI", "fold": "hasini", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हासिनी\n\nHĀSINĪ . An apsarā woman of Alakāpurī. She once danced in Kubera's assembly to welcome sage aṣṭāvakra (anuśāsana parva, Chapter 19, Verse 45).", "gloss_language": "en"}], "synonyms": ["haasinee", "haasinii", "hāsinī", "హాసినీ", "ಹಾಸಿನೀ"], "synonyms_slp1": ["haasinee", "haasinii", "hāsinī", "హాసినీ", "ಹಾಸಿನೀ"]}], "hastamalaka": [{"id": "hastAmalaka", "headword": "हस्तामलक", "headword_slp1": "hastAmalaka", "fold": "hastamalaka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तामलक\n\nHASTĀMALAKA . A disciple of Śrī śaṅkara. (See under śaṅkarācārya, para 7).", "gloss_language": "en"}], "synonyms": ["hastaamalaka", "hastāmalaka", "హస్తామలక", "ಹಸ್ತಾಮಲಕ"], "synonyms_slp1": ["hastaamalaka", "hastāmalaka", "హస్తామలక", "ಹಸ್ತಾಮಲಕ"]}], "hasti_१": [{"id": "hasti_१", "headword": "हस्ति_१", "headword_slp1": "hasti_१", "fold": "hasti_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्ति १\n\nHASTI I . A King born in the lunar dynasty. (Ādi Parva, Chapter 94 Verse 58).", "gloss_language": "en"}], "synonyms": ["hasti", "hasti_1", "हस्ति", "హస్తి", "హస్తి_౧", "ಹಸ್ತಿ", "ಹಸ್ತಿ_೧"], "synonyms_slp1": ["hasti", "hasti_1", "hasti", "హస్తి", "హస్తి_౧", "ಹಸ್ತಿ", "ಹಸ್ತಿ_೧"]}], "hasti_२": [{"id": "hasti_२", "headword": "हस्ति_२", "headword_slp1": "hasti_२", "fold": "hasti_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्ति २\n\nHASTI II . Another king of the lunar dynasty. His father was suhotra and mother suvarṇā, who belonged to the ikṣvāku dynasty. This hasti married yaśodharā, daughter of King trigarta, and a son called Vikaṇṭha was born to them. hastināpura was the city newly built by hasti. (Ādi Parva Chapter 95, Verse 34).", "gloss_language": "en"}], "synonyms": ["hasti", "hasti_2", "हस्ति", "హస్తి", "హస్తి_౨", "ಹಸ್ತಿ", "ಹಸ್ತಿ_೨"], "synonyms_slp1": ["hasti", "hasti_2", "hasti", "హస్తి", "హస్తి_౨", "ಹಸ್ತಿ", "ಹಸ್ತಿ_೨"]}], "hastiBadra": [{"id": "hastiBadra", "headword": "हस्तिभद्र", "headword_slp1": "hastiBadra", "fold": "hastiBadra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तिभद्र\n\nHASTIBHADRA . A nāga born in the kaśyapa dynasty. (Udyoga Parva, Chapter 103, Verse 13).", "gloss_language": "en"}], "synonyms": ["hastibhadra", "హస్తిభద్ర", "ಹಸ್ತಿಭದ್ರ"], "synonyms_slp1": ["hastibhadra", "హస్తిభద్ర", "ಹಸ್ತಿಭದ್ರ"]}], "hastikasyapa": [{"id": "hastikaSyapa", "headword": "हस्तिकश्यप", "headword_slp1": "hastikaSyapa", "fold": "hastikasyapa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तिकश्यप\n\nHASTIKAŚYAPA . A great sage who lived in North india in very olden days. He once met and talked with śrī kṛṣṇa, who was doing tapas on the mountains. (anuśāsana parva, Chapter 139, Verse 11).", "gloss_language": "en"}], "synonyms": ["hastikashyapa", "hastikaśyapa", "హస్తికశ్యప", "ಹಸ್ತಿಕಶ್ಯಪ"], "synonyms_slp1": ["hastikashyapa", "hastikaśyapa", "హస్తికశ్యప", "ಹಸ್ತಿಕಶ್ಯಪ"]}], "hastinapura": [{"id": "hastinApura", "headword": "हस्तिनापुर", "headword_slp1": "hastinApura", "fold": "hastinapura", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तिनापुर\n\nHASTINĀPURA . Capital city of the pāṇḍavas. (See under hasti II).", "gloss_language": "en"}], "synonyms": ["hastinaapura", "hastināpura", "హస్తినాపుర", "ಹಸ್ತಿನಾಪುರ"], "synonyms_slp1": ["hastinaapura", "hastināpura", "హస్తినాపుర", "ಹಸ್ತಿನಾಪುರ"]}], "hastipada": [{"id": "hastipada", "headword": "हस्तिपद", "headword_slp1": "hastipada", "fold": "hastipada", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तिपद\n\nHASTIPADA . A nāga born in the kaśyapa dynasty. (Ādi Parva, Chapter 35 Verse 9).", "gloss_language": "en"}], "synonyms": ["hastipada", "హస్తిపద", "ಹಸ್ತಿಪದ"], "synonyms_slp1": ["hastipada", "హస్తిపద", "ಹಸ್ತಿಪದ"]}], "hastipiRqa": [{"id": "hastipiRqa", "headword": "हस्तिपिण्ड", "headword_slp1": "hastipiRqa", "fold": "hastipiRqa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तिपिण्ड\n\nHASTIPIṆḌA . A nāga born in the kaśyapa dynasty (Ādi Parva, Chapter 35, Verse 14).", "gloss_language": "en"}], "synonyms": ["hastipiNDa", "hastipiṇḍa", "హస్తిపిణ్డ", "ಹಸ್ತಿಪಿಣ್ಡ"], "synonyms_slp1": ["hastipiNDa", "hastipiṇḍa", "హస్తిపిణ్డ", "ಹಸ್ತಿಪಿಣ್ಡ"]}], "hastisoma": [{"id": "hastisomA", "headword": "हस्तिसोमा", "headword_slp1": "hastisomA", "fold": "hastisoma", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "हस्तिसोमा\n\nHASTISOMĀ . A famous river mentioned frequently in the Purāṇas. (bhīṣma parva, Chapter 9, Verse 19)", "gloss_language": "en"}], "synonyms": ["hastisomaa", "hastisomā", "హస్తిసోమా", "ಹಸ್ತಿಸೋಮಾ"], "synonyms_slp1": ["hastisomaa", "hastisomā", "హస్తిసోమా", "ಹಸ್ತಿಸೋಮಾ"]}]}