{"gOram": [{"id": "gOram", "headword": "गौरम्", "headword_slp1": "gOram", "fold": "gOram", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरम्\n\nGAURA(M) . A mountain in the kuśa island. (bhīṣma Parva, Chapter 12, Verse 4).", "gloss_language": "en"}], "synonyms": ["gaura", "gauram", "गौर", "गौरं", "గౌర", "గౌరం", "గౌరమ్", "ಗೌರ", "ಗೌರಂ", "ಗೌರಮ್"], "synonyms_slp1": ["gaura", "gauram", "gOra", "gOraM", "గౌర", "గౌరం", "గౌరమ్", "ಗೌರ", "ಗೌರಂ", "ಗೌರಮ್"]}], "gOramuKa": [{"id": "gOramuKa", "headword": "गौरमुख", "headword_slp1": "gOramuKa", "fold": "gOramuKa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरमुख\n\nGAURAMUKHA . A son of sage śamīka. It was Śamīka's son Śṛṅgī, who cursed parīkṣit to death by snake-bite. (See parīkṣit). Śṛṅgī cursed that parīkṣit, who had thrown a dead snake on the neck of his father while in meditation, would be bitten to death by snake within seven days. Śṛṅgī sent word about the curse through his disciple gauramukha to parīkṣit. (Ādi Parva, Chapter 42, Verses 14-22).", "gloss_language": "en"}], "synonyms": ["gauramukha", "గౌరముఖ", "ಗೌರಮುಖ"], "synonyms_slp1": ["gauramukha", "గౌరముఖ", "ಗೌರಮುಖ"]}], "gOrapraBa": [{"id": "gOrapraBa", "headword": "गौरप्रभ", "headword_slp1": "gOrapraBa", "fold": "gOrapraBa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरप्रभ\n\nGAURAPRABHA . Son born to śuka (Vyāsa's son) by his wife pīvarī. śuka had four sons called kṛṣṇa, gauraprabha, bhūri and devaśruta and a daughter kīrti. (devībhāgavata, Prathama skandha).", "gloss_language": "en"}], "synonyms": ["gauraprabha", "గౌరప్రభ", "ಗೌರಪ್ರಭ"], "synonyms_slp1": ["gauraprabha", "గౌరప్రభ", "ಗೌರಪ್ರಭ"]}], "gOrapfsWa": [{"id": "gOrapfzWa", "headword": "गौरपृष्ठ", "headword_slp1": "gOrapfzWa", "fold": "gOrapfsWa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरपृष्ठ\n\nGAURAPṚṢṬHA . A royal sage who worships yama at his sabhā (assembly). (Sabhā Parva, Chapter 8, Verse 21).", "gloss_language": "en"}], "synonyms": ["gaurapRRiShTha", "gaurapRShTha", "gaurapRiShTha", "gaurapRuShTha", "gaurapṛṣṭha", "గౌరపృష్ఠ", "ಗೌರಪೃಷ್ಠ"], "synonyms_slp1": ["gaurapRRiShTha", "gaurapRShTha", "gaurapRiShTha", "gaurapRuShTha", "gaurapṛṣṭha", "గౌరపృష్ఠ", "ಗೌರಪೃಷ್ಠ"]}], "gOrasiras": [{"id": "gOraSiras", "headword": "गौरशिरस्", "headword_slp1": "gOraSiras", "fold": "gOrasiras", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरशिरस्\n\nGAURAŚIRAS . A sage of ancient days, who worshipped indra in his assembly. (Sabhā Parva, Chapter 7, Verse 11).", "gloss_language": "en"}], "synonyms": ["gaurashiras", "gauraśiras", "గౌరశిరస్", "ಗೌರಶಿರಸ್"], "synonyms_slp1": ["gaurashiras", "gauraśiras", "గౌరశిరస్", "ಗೌರಶಿರಸ್"]}], "gOravahana": [{"id": "gOravAhana", "headword": "गौरवाहन", "headword_slp1": "gOravAhana", "fold": "gOravahana", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरवाहन\n\nGAURAVĀHANA . A King, who was present at the rājasūya sacrifice of yudhiṣṭhira. (Sabhā Parva, Chapter 34, Verse 12).", "gloss_language": "en"}], "synonyms": ["gauravaahana", "gauravāhana", "గౌరవాహన", "ಗೌರವಾಹನ"], "synonyms_slp1": ["gauravaahana", "gauravāhana", "గౌరవాహన", "ಗೌರವಾಹನ"]}], "gOri_१": [{"id": "gOrI_१", "headword": "गौरी_१", "headword_slp1": "gOrI_१", "fold": "gOri_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरी १\n\nGAURĪ I . See pārvatī.", "gloss_language": "en"}], "synonyms": ["gauree", "gauree_1", "gaurii", "gaurii_1", "gaurī", "gaurī_1", "गौरी", "గౌరీ", "గౌరీ_౧", "ಗೌರೀ", "ಗೌರೀ_೧"], "synonyms_slp1": ["gauree", "gauree_1", "gaurii", "gaurii_1", "gaurī", "gaurī_1", "gOrI", "గౌరీ", "గౌరీ_౧", "ಗೌರೀ", "ಗೌರೀ_೧"]}], "gOri_२": [{"id": "gOrI_२", "headword": "गौरी_२", "headword_slp1": "gOrI_२", "fold": "gOri_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गौरी २\n\nGAURĪ II . A female attendan