{"Balandana": [{"id": "Balandana", "headword": "भलन्दन", "headword_slp1": "Balandana", "fold": "Balandana", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भलन्दन\n\nBHALANDANA . A king. Though by birth he was a brahmin he became a vaiśya because of doing things belonging to the vaiśya community like trade and commerce. (mārkaṇḍeya purāṇa). According to the bhāgavata, viṣṇu purāṇa and vāyu purāṇa bhalandana was the son of nābhāga.", "gloss_language": "en"}], "synonyms": ["bhalandana", "భలన్దన", "ಭಲನ್ದನ"], "synonyms_slp1": ["bhalandana", "భలన్దన", "ಭಲನ್ದನ"]}], "Balata": [{"id": "BallAta", "headword": "भल्लात", "headword_slp1": "BallAta", "fold": "Balata", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भल्लात\n\nBHALLĀTA . A king of the line of bharata. He was the son of King Viśvaksena and father of King bṛhadaśva. (Navama skandha, bhāgavata).", "gloss_language": "en"}], "synonyms": ["bhallaata", "bhallāta", "భల్లాత", "ಭಲ್ಲಾತ"], "synonyms_slp1": ["bhallaata", "bhallāta", "భల్లాత", "ಭಲ್ಲಾತ"]}], "Balawam": [{"id": "BallAwam", "headword": "भल्लाटम्", "headword_slp1": "BallAwam", "fold": "Balawam", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भल्लाटम्\n\nBHALLĀṬA(M) . A place of habitation in ancient india. Bhīmasena conquered this Iand during his victory march. (Śloka 5, Chapter 30, Sabhā Parva, M.B.).", "gloss_language": "en"}], "synonyms": ["bhallaaTa", "bhallaaTam", "bhallāṭa", "bhallāṭam", "भल्लाट", "भल्लाटं", "భల్లాట", "భల్లాటం", "భల్లాటమ్", "ಭಲ್ಲಾಟ", "ಭಲ್ಲಾಟಂ", "ಭಲ್ಲಾಟಮ್"], "synonyms_slp1": ["bhallaaTa", "bhallaaTam", "bhallāṭa", "bhallāṭam", "BallAwa", "BallAwaM", "భల్లాట", "భల్లాటం", "భల్లాటమ్", "ಭಲ್ಲಾಟ", "ಭಲ್ಲಾಟಂ", "ಭಲ್ಲಾಟಮ್"]}], "Baluki_१": [{"id": "BAluki_१", "headword": "भालुकि_१", "headword_slp1": "BAluki_१", "fold": "Baluki_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भालुकि १\n\nBHĀLUKI I . A ṛṣi, who was a member of Yudhiṣṭhira's assembly. (Sabhā Parva, Chapter 4, Verse 15).", "gloss_language": "en"}], "synonyms": ["bhaaluki", "bhaaluki_1", "bhāluki", "bhāluki_1", "भालुकि", "భాలుకి", "భాలుకి_౧", "ಭಾಲುಕಿ", "ಭಾಲುಕಿ_೧"], "synonyms_slp1": ["bhaaluki", "bhaaluki_1", "bhāluki", "bhāluki_1", "BAluki", "భాలుకి", "భాలుకి_౧", "ಭಾಲುಕಿ", "ಭಾಲುಕಿ_೧"]}], "Baluki_२": [{"id": "BAluki_२", "headword": "भालुकि_२", "headword_slp1": "BAluki_२", "fold": "Baluki_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भालुकि २\n\nBHĀLUKI II . A maharṣi. He also accompanied the pāṇḍavas to dvaitavana. (Vana Parva, Chapter 27).", "gloss_language": "en"}], "synonyms": ["bhaaluki", "bhaaluki_2", "bhāluki", "bhāluki_2", "भालुकि", "భాలుకి", "భాలుకి_౨", "ಭಾಲುಕಿ", "ಭಾಲುಕಿ_೨"], "synonyms_slp1": ["bhaaluki", "bhaaluki_2", "bhāluki", "bhāluki_2", "BAluki", "భాలుకి", "భాలుకి_౨", "ಭಾಲುಕಿ", "ಭಾಲುಕಿ_೨"]}], "Baluki_३": [{"id": "BAluki_३", "headword": "भालुकि_३", "headword_slp1": "BAluki_३", "fold": "Baluki_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भालुकि ३\n\nBHĀLUKI III . An ācārya. He was a disciple of Lāṅgali, a member of the sāma line of disciples of vyāsa. (vāyu purāṇa).", "gloss_language": "en"}], "synonyms": ["bhaaluki", "bhaaluki_3", "bhāluki", "bhāluki_3", "भालुकि", "భాలుకి", "భాలుకి_౩", "ಭಾಲುಕಿ", "ಭಾಲುಕಿ_೩"], "synonyms_slp1": ["bhaaluki", "bhaaluki_3", "bhāluki", "bhāluki_3", "BAluki", "భాలుకి", "భాలుకి_౩", "ಭಾಲುಕಿ", "ಭಾಲುಕಿ_೩"]}]}