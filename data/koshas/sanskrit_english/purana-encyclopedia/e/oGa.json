{"oGaraTa": [{"id": "oGaraTa", "headword": "ओघरथ", "headword_slp1": "oGaraTa", "fold": "oGaraTa", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ओघरथ\n\nOGHARATHA . Son of the King named oghavān. (M.B. anuśāsana parva, Chapter 2, Verse 38).", "gloss_language": "en"}], "synonyms": ["ogharatha", "ఓఘరథ", "ಓಘರಥ"], "synonyms_slp1": ["ogharatha", "ఓఘరథ", "ಓಘರಥ"]}], "oGavan_१": [{"id": "oGavAn_१", "headword": "ओघवान्_१", "headword_slp1": "oGavAn_१", "fold": "oGavan_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ओघवान् १\n\nOGHAVĀN I . Grandson of King nṛga. He had a son named ogharatha and a daughter named oghavatī. (M.B. anuśāsana parva, Chapter 2).", "gloss_language": "en"}], "synonyms": ["oghavaan", "oghavaan_1", "oghavān", "oghavān_1", "ओघवान्", "ఓఘవాన్", "ఓఘవాన్_౧", "ಓಘವಾನ್", "ಓಘವಾನ್_೧"], "synonyms_slp1": ["oghavaan", "oghavaan_1", "oghavān", "oghavān_1", "oGavAn", "ఓఘవాన్", "ఓఘవాన్_౧", "ಓಘವಾನ್", "ಓಘವಾನ್_೧"]}], "oGavan_२": [{"id": "oGavAn_२", "headword": "ओघवान्_२", "headword_slp1": "oGavAn_२", "fold": "oGavan_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ओघवान् २\n\nOGHAVĀN II . A warrior on the side of the kauravas. (M.B. karṇa Parva, Chapter 5, Verse 42).", "gloss_language": "en"}], "synonyms": ["oghavaan", "oghavaan_2", "oghavān", "oghavān_2", "ओघवान्", "ఓఘవాన్", "ఓఘవాన్_౨", "ಓಘವಾನ್", "ಓಘವಾನ್_೨"], "synonyms_slp1": ["oghavaan", "oghavaan_2", "oghavān", "oghavān_2", "oGavAn", "ఓఘవాన్", "ఓఘవాన్_౨", "ಓಘವಾನ್", "ಓಘವಾನ್_೨"]}], "oGavati_१": [{"id": "oGavatI_१", "headword": "ओघवती_१", "headword_slp1": "oGavatI_१", "fold": "oGavati_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "ओघवती १\n\nOGHAVATĪ I . There are seven sarasvatī rivers in the world. These are suprabhā, kāñcanākṣī, viśālā, manoramā, sarasvatī, oghavatī and sureṇu. In the mahābhārata, śalya Parva, Chapter 38 we find that oghavatī was invoked and brought to kuru