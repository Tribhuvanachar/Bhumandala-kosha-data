{"gopalaka": [{"id": "gopAlaka", "headword": "गोपालक", "headword_slp1": "gopAlaka", "fold": "gopalaka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपालक\n\nGOPĀLAKA . A son born to caṇḍamahāsena of his wife aṅgāravatī. Besides gopālaka he had another son named pālaka. (kathāsaritsāgara, Kathāmukhalaṁbaka, Taraṅga 3).", "gloss_language": "en"}], "synonyms": ["gopaalaka", "gopālaka", "గోపాలక", "ಗೋಪಾಲಕ"], "synonyms_slp1": ["gopaalaka", "gopālaka", "గోపాలక", "ಗೋಪಾಲಕ"]}], "gopali": [{"id": "gopAlI", "headword": "गोपाली", "headword_slp1": "gopAlI", "fold": "gopali", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपाली\n\nGOPĀLĪ . I. A nymph. Once when arjuna went to devaloka this celestial maiden gave a performance in dancing in his honour. (Chapter 43, Vana Parva).", "gloss_language": "en"}], "synonyms": ["gopaalee", "gopaalii", "gopālī", "గోపాలీ", "ಗೋಪಾಲೀ"], "synonyms_slp1": ["gopaalee", "gopaalii", "gopālī", "గోపాలీ", "ಗೋಪಾಲೀ"]}], "gopali_२": [{"id": "gopAlI_२", "headword": "गोपाली_२", "headword_slp1": "gopAlI_२", "fold": "gopali_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपाली २\n\nGOPĀLĪ II . A follower of Skandadeva. (Śloka 4, Chapter 46, śalya Parva).", "gloss_language": "en"}], "synonyms": ["gopaalee", "gopaalee_2", "gopaalii", "gopaalii_2", "gopālī", "gopālī_2", "गोपाली", "గోపాలీ", "గోపాలీ_౨", "ಗೋಪಾಲೀ", "ಗೋಪಾಲೀ_೨"], "synonyms_slp1": ["gopaalee", "gopaalee_2", "gopaalii", "gopaalii_2", "gopālī", "gopālī_2", "gopAlI", "గోపాలీ", "గోపాలీ_౨", "ಗೋಪಾಲೀ", "ಗೋಪಾಲೀ_೨"]}], "goparaswra": [{"id": "goparAzwra", "headword": "गोपराष्ट्र", "headword_slp1": "goparAzwra", "fold": "goparaswra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपराष्ट्र\n\nGOPARĀṢṬRA . A place of habitation in the north-east part of ancient india. (Śloka 44, Chapter 9, bhīṣma Parva).", "gloss_language": "en"}], "synonyms": ["goparaaShTra", "goparāṣṭra", "గోపరాష్ట్ర", "ಗೋಪರಾಷ್ಟ್ರ"], "synonyms_slp1": ["goparaaShTra", "goparāṣṭra", "గోపరాష్ట్ర", "ಗೋಪರಾಷ್ಟ್ರ"]}], "gopati_१": [{"id": "gopati_१", "headword": "गोपति_१", "headword_slp1": "gopati_१", "fold": "gopati_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपति १\n\nGOPATI I . A demon. He was a co-worker of another demon named kālaketu. śrī kṛṣṇa killed gopati on the banks of the river irāvatī on the mountain mahendra. (Chapter 38, Sabhā Parva).", "gloss_language": "en"}], "synonyms": ["gopati", "gopati_1", "गोपति", "గోపతి", "గోపతి_౧", "ಗೋಪತಿ", "ಗೋಪತಿ_೧"], "synonyms_slp1": ["gopati", "gopati_1", "gopati", "గోపతి", "గోపతి_౧", "ಗೋಪತಿ", "ಗೋಪತಿ_೧"]}], "gopati_२": [{"id": "gopati_२", "headword": "गोपति_२", "headword_slp1": "gopati_२", "fold": "gopati_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपति २\n\nGOPATI II . A deva gandharva. He was born to kaśyapa of his wife muni. (Śloka 42, Chapter 65, Vana Parva). This gandharva participated in the birthday celebrations of arjuna. (Śloka 55, Chapter 122, Ādi Parva).", "gloss_language": "en"}], "synonyms": ["gopati", "gopati_2", "गोपति", "గోపతి", "గోపతి_౨", "ಗೋಪತಿ", "ಗೋಪತಿ_೨"], "synonyms_slp1": ["gopati", "gopati_2", "gopati", "గోపతి", "గోపతి_౨", "ಗೋಪತಿ", "ಗೋಪತಿ_೨"]}], "gopati_३": [{"id": "gopati_३", "headword": "गोपति_३", "headword_slp1": "gopati_३", "fold": "gopati_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "गोपति ३\n\nGOPATI III . A son of the celebrated emperor, śibi. When paraśurāma killed and made extinct all kṣatriya kings it was a herd of cows that brought up this child. (Śloka 78, Chapter 49, śānti Parva).", "gloss_language": "en"}], "synonyms": ["gopati", "gopati_3", "गोपति", "గోపతి", "గోపతి_౩", "ಗೋಪತಿ", "ಗೋಪತಿ_೩"], "synonyms_slp1": ["gopati", "gopati_3", "gopati", "గోపతి", "గోపతి_౩", "ಗೋಪತಿ", "ಗೋಪತಿ_೩"]}], "gopati_४": [{"id": "gopati_४", "headword": "गोपति_४", "headword_slp1": "gopati_४", "f