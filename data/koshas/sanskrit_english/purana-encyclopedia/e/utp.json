{"utpalavana": [{"id": "utpalAvana", "headword": "उत्पलावन", "headword_slp1": "utpalAvana", "fold": "utpalavana", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उत्पलावन\n\nUTPALĀVANA . A holy bath in the Panjab. At this place viśvāmitra performed a sacrifice. (M.B. Vana Parva, Chapter 87, Stanza 15).", "gloss_language": "en"}], "synonyms": ["utpalaavana", "utpalāvana", "ఉత్పలావన", "ಉತ್ಪಲಾವನ"], "synonyms_slp1": ["utpalaavana", "utpalāvana", "ఉత్పలావన", "ಉತ್ಪಲಾವನ"]}], "utpalini": [{"id": "utpalinI", "headword": "उत्पलिनी", "headword_slp1": "utpalinI", "fold": "utpalini", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उत्पलिनी\n\nUTPALINĪ . A river flowing near the forest known as Naimiṣāraṇya. arjuna had seen this river. (mahābhārata, Ādi Parva, Chapter 214, Stanza 6).", "gloss_language": "en"}], "synonyms": ["utpalinee", "utpalinii", "utpalinī", "ఉత్పలినీ", "ಉತ್ಪಲಿನೀ"], "synonyms_slp1": ["utpalinee", "utpalinii", "utpalinī", "ఉత్పలినీ", "ಉತ್ಪಲಿನೀ"]}], "utpataka": [{"id": "utpAtaka", "headword": "उत्पातक", "headword_slp1": "utpAtaka", "fold": "utpataka", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उत्पातक\n\nUTPĀTAKA . A holy bath. Those who bathe in this tīrtha (bath) will get the merits of a fast. (M.B. anuśāsana parva, Chapter 25, Stanza 41).", "gloss_language": "en"}], "synonyms": ["utpaataka", "utpātaka", "ఉత్పాతక", "ಉತ್ಪಾತಕ"], "synonyms_slp1": ["utpaataka", "utpātaka", "ఉత్పాతక", "ಉತ್ಪಾತಕ"]}]}