{"vahana": [{"id": "vAhana", "headword": "वाहन", "headword_slp1": "vAhana", "fold": "vahana", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वाहन\n\nVĀHANA (conveyance) . To know about the conveyances of rudra, yama and so on, see under jaladhi.", "gloss_language": "en"}], "synonyms": ["chonveyanche", "conveyance", "vaahana", "vāhana", "चोन्वेयन्चे", "చోన్వేయన్చే", "వాహన", "ಚೋನ್ವೇಯನ್ಚೇ", "ವಾಹನ"], "synonyms_slp1": ["chonveyanche", "conveyance", "vaahana", "vāhana", "conveyance", "చోన్వేయన్చే", "వాహన", "ಚೋನ್ವೇಯನ್ಚೇ", "ವಾಹನ"]}], "vahi": [{"id": "vahi", "headword": "वहि", "headword_slp1": "vahi", "fold": "vahi", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वहि\n\nVAHI . A devil living in the river vipāśā. The devil had a friend called hīka. Their sons are called the Vāhīkas. The Vāhīkas are not considered to be the creation of the prajāpatis. (M.B. karṇa Parva, Chapter 44, Stanza 1).", "gloss_language": "en"}], "synonyms": ["vahi", "వహి", "ವಹಿ"], "synonyms_slp1": ["vahi", "వహి", "ವಹಿ"]}], "vahika": [{"id": "vAhika", "headword": "वाहिक", "headword_slp1": "vAhika", "fold": "vahika", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वाहिक\n\nVĀHIKA . A Brahmin who was well-versed in the Vedas. This Brahmin earned his bread by selling salt. In his life, he had committed sins. At last he was killed by a lion. The flesh of his dead body fell in the gaṅgā in consequence of which he got remission of his sins. (skanda purāṇa 2: 4: 1-28).", "gloss_language": "en"}], "synonyms": ["vaahika", "vāhika", "వాహిక", "ವಾಹಿಕ"], "synonyms_slp1": ["vaahika", "vāhika", "వాహిక", "ವಾಹಿಕ"]}], "vahinara": [{"id": "vahInara", "headword": "वहीनर", "headword_slp1": "vahInara", "fold": "vahinara", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वहीनर\n\nVAHĪNARA . A king who lives in the palace of yama. (mahābhārata, Sabhā Parva, Chapter 8, Stanza 15).", "gloss_language": "en"}], "synonyms": ["vaheenara", "vahiinara", "vahīnara", "వహీనర", "ವಹೀನರ"], "synonyms_slp1": ["vaheenara", "vahiinara", "vahīnara", "వహీనర", "ವಹೀನರ"]}], "vahini_१": [{"id": "vAhinI_१", "headword": "वाहिनी_१", "headword_slp1": "vAhinI_१", "fold": "vahini_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वाहिनी १\n\nVĀHINĪ I . A division of army. (See under akṣauhiṇī).", "gloss_language": "en"}], "synonyms": ["vaahinee", "vaahinee_1", "vaahinii", "vaahinii_1", "vāhinī", "vāhinī_1", "वाहिनी", "వాహినీ", "వాహినీ_౧", "ವಾಹಿನೀ", "ವಾಹಿನೀ_೧"], "synonyms_slp1": ["vaahinee", "vaahinee_1", "vaahinii", "vaahinii_1", "vāhinī", "vāhinī_1", "vAhinI", "వాహినీ", "వాహినీ_౧", "ವಾಹಿನೀ", "ವಾಹಿನೀ_೧"]}], "vahini_२": [{"id": "vAhinI_२", "headword": "वाहिनी_२", "headword_slp1": "vAhinI_२", "fold": "vahini_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वाहिनी २\n\nVĀHINĪ II . Wife of kuru, a king of the Lunar dynasty. Five sons such as aśvavān and others were born to kuru by his wife vāhinī. (M.B. Ādi Parva, Chapter 94, Stanza 50).", "gloss_language": "en"}], "synonyms": ["vaahinee", "vaahinee_2", "vaahinii", "vaahinii_2", "vāhinī", "vāhinī_2", "वाहिनी", "వాహినీ", "వాహినీ_౨", "ವಾಹಿನೀ", "ವಾಹಿನೀ_೨"], "synonyms_slp1": ["vaahinee", "vaahinee_2", "vaahinii", "vaahinii_2", "vāhinī", "vāhinī_2", "vAhinI", "వాహినీ", "వాహినీ_౨", "ವಾಹಿನೀ", "ವಾಹಿನೀ_೨"]}], "vahni_१": [{"id": "vahni_१", "headword": "वह्नि_१", "headword_slp1": "vahni_१", "fold": "vahni_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "वह्नि १\n\nVAHNI I . An asura. It is mentioned in mahābhārata, śānti Parva, Chapter 227, Stanza 52 that this asura had been a lokapāla (indra, agni, yama and varuṇa were called lokapālas) in olden days.", "gloss_language": "en"}], "synonyms": ["vahni", "vahni_1", "वह्नि", "వహ్ని", "వహ్ని_౧", "ವಹ್ನಿ", "ವಹ್ನಿ_೧"], "synonyms_slp1": ["vahni", "vahni_1", "vahni", "వహ్ని", "వహ్ని_౧", "ವಹ್ನಿ", "ವಹ್