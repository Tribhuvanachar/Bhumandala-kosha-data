{"Bogavan": [{"id": "BogavAn", "headword": "भोगवान्", "headword_slp1": "BogavAn", "fold": "Bogavan", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भोगवान्\n\nBHOGAVĀN . A mountain--mahābhārata, Sabhā Parva, Chapter 30, Verse 12 says that in the course of his triumphant over-running of the eastern lands, Bhīmasena conquered this mountain also.", "gloss_language": "en"}], "synonyms": ["bhogavaan", "bhogavān", "భోగవాన్", "ಭೋಗವಾನ್"], "synonyms_slp1": ["bhogavaan", "bhogavān", "భోగవాన్", "ಭೋಗವಾನ್"]}], "Bogavati_१": [{"id": "BogavatI_१", "headword": "भोगवती_१", "headword_slp1": "BogavatI_१", "fold": "Bogavati_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भोगवती १\n\nBHOGAVATĪ I . nāgaloka or pātāla. When sugrīva sent monkeys in all directions in search of sītā, he gave instructions to them to go and search for her in Bhogavatīpura. vālmīki rāmāyaṇa, 41st sarga, Kiṣkindhākāṇḍa describes the place as the city infested with serpents (nāgas) and guarded by them. vāsuki, King of serpents, lives there.", "gloss_language": "en"}], "synonyms": ["bhogavatee", "bhogavatee_1", "bhogavatii", "bhogavatii_1", "bhogavatī", "bhogavatī_1", "भोगवती", "భోగవతీ", "భోగవతీ_౧", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೧"], "synonyms_slp1": ["bhogavatee", "bhogavatee_1", "bhogavatii", "bhogavatii_1", "bhogavatī", "bhogavatī_1", "BogavatI", "భోగవతీ", "భోగవతీ_౧", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೧"]}], "Bogavati_२": [{"id": "BogavatI_२", "headword": "भोगवती_२", "headword_slp1": "BogavatI_२", "fold": "Bogavati_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भोगवती २\n\nBHOGAVATĪ II . gaṅgā of pātāla. (M.B. Sabhā Parva, Dākṣiṇātya Pāṭha, Chapter 38).", "gloss_language": "en"}], "synonyms": ["bhogavatee", "bhogavatee_2", "bhogavatii", "bhogavatii_2", "bhogavatī", "bhogavatī_2", "भोगवती", "భోగవతీ", "భోగవతీ_౨", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೨"], "synonyms_slp1": ["bhogavatee", "bhogavatee_2", "bhogavatii", "bhogavatii_2", "bhogavatī", "bhogavatī_2", "BogavatI", "భోగవతీ", "భోగవతీ_౨", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೨"]}], "Bogavati_३": [{"id": "BogavatI_३", "headword": "भोगवती_३", "headword_slp1": "BogavatI_३", "fold": "Bogavati_३", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भोगवती ३\n\nBHOGAVATĪ III . A place of holy bath at prayāga. It is better known as vāsuki tīrtha. mahābhārata Vana Parva, Chapter 85 says that a bath at this tīrtha is as efficacious as an aśvamedha yajña.", "gloss_language": "en"}], "synonyms": ["bhogavatee", "bhogavatee_3", "bhogavatii", "bhogavatii_3", "bhogavatī", "bhogavatī_3", "भोगवती", "భోగవతీ", "భోగవతీ_౩", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೩"], "synonyms_slp1": ["bhogavatee", "bhogavatee_3", "bhogavatii", "bhogavatii_3", "bhogavatī", "bhogavatī_3", "BogavatI", "భోగవతీ", "భోగవతీ_౩", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೩"]}], "Bogavati_४": [{"id": "BogavatI_४", "headword": "भोगवती_४", "headword_slp1": "BogavatI_४", "fold": "Bogavati_४", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भोगवती ४\n\nBHOGAVATĪ IV . Another name for the river sarasvatī. (M.B. Vana Parva, Chapter 24, Verse 20).", "gloss_language": "en"}], "synonyms": ["bhogavatee", "bhogavatee_4", "bhogavatii", "bhogavatii_4", "bhogavatī", "bhogavatī_4", "भोगवती", "భోగవతీ", "భోగవతీ_౪", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೪"], "synonyms_slp1": ["bhogavatee", "bhogavatee_4", "bhogavatii", "bhogavatii_4", "bhogavatī", "bhogavatī_4", "BogavatI", "భోగవతీ", "భోగవతీ_౪", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೪"]}], "Bogavati_५": [{"id": "BogavatI_५", "headword": "भोगवती_५", "headword_slp1": "BogavatI_५", "fold": "Bogavati_५", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "भोगवती ५\n\nBHOGAVATĪ V . A female attendant of subrahmaṇya. (M.B. śalya Parva, Chapter 46, Verse 8).", "gloss_language": "en"}], "synonyms": ["bhogavatee", "bhogavatee_5", "bhogavatii", "bhogavatii_5", "bhogavatī", "bhogavatī_5", "भोगवती", "భోగవతీ", "భోగవతీ_౫", "ಭೋಗವತೀ", "ಭೋಗವತೀ_೫"], "synonyms_slp1": ["bhogavatee", "bhogavatee_5", "b