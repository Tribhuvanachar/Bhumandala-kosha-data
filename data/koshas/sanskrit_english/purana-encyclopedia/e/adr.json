{"adra": [{"id": "adra", "headword": "अद्र", "headword_slp1": "adra", "fold": "adra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "अद्र\n\nADRA . A King of the Solar dynasty. (See sūrya Vaṁśa).", "gloss_language": "en"}], "synonyms": ["adra", "అద్ర", "ಅದ್ರ"], "synonyms_slp1": ["adra", "అద్ర", "ಅದ್ರ"]}], "adri": [{"id": "adri", "headword": "अद्रि", "headword_slp1": "adri", "fold": "adri", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "अद्रि\n\nADRI was a King, the son of Viṣvagaśvā and father of Yuvanāśvā. (M.B. Vana Parva, Chapter 202, Verse 3).", "gloss_language": "en"}], "synonyms": ["adri", "అద్రి", "ಅದ್ರಿ"], "synonyms_slp1": ["adri", "అద్రి", "ಅದ್ರಿ"]}], "adrika": [{"id": "adrikA", "headword": "अद्रिका", "headword_slp1": "adrikA", "fold": "adrika", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "अद्रिका\n\nADRIKĀ . A nymph (devastrī). There is a story in devībhāgavata about her being cursed by a Brahmin and turned into a fish.", "gloss_language": "en"}], "synonyms": ["adrikaa", "adrikā", "అద్రికా", "ಅದ್ರಿಕಾ"], "synonyms_slp1": ["adrikaa", "adrikā", "అద్రికా", "ಅದ್ರಿಕಾ"]}]}