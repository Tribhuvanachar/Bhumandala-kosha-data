{"upendra": [{"id": "upendra", "headword": "उपेन्द्र", "headword_slp1": "upendra", "fold": "upendra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उपेन्द्र\n\nUPENDRA . A synonym of viṣṇu. Mahāviṣṇu once took birth by aditi the wife of Kaśyapaprajāpati. In that birth Mahāviṣṇu had the name upendra. He was known as vāmana too. (bhāgavata, 10th skandha).", "gloss_language": "en"}], "synonyms": ["upendra", "ఉపేన్ద్ర", "ಉಪೇನ್ದ್ರ"], "synonyms_slp1": ["upendra", "ఉపేన్ద్ర", "ಉಪೇನ್ದ್ರ"]}, {"id": "upendrA", "headword": "उपेन्द्रा", "headword_slp1": "upendrA", "fold": "upendra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उपेन्द्रा\n\nUPENDRĀ . A river. (mahābhārata, bhīṣma parva, Chapter 9, Stanza 27).", "gloss_language": "en"}], "synonyms": ["upendraa", "upendrā", "ఉపేన్ద్రా", "ಉಪೇನ್ದ್ರಾ"], "synonyms_slp1": ["upendraa", "upendrā", "ఉపేన్ద్రా", "ಉಪೇನ್ದ್ರಾ"]}], "upendrabala": [{"id": "upendrabala", "headword": "उपेन्द्रबल", "headword_slp1": "upendrabala", "fold": "upendrabala", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "उपेन्द्रबल\n\nUPENDRABALA . Son of a minister of the King named Śrī datta. (See under Śrī datta).", "gloss_language": "en"}], "synonyms": ["upendrabala", "ఉపేన్ద్రబల", "ಉಪೇನ್ದ್ರಬಲ"], "synonyms_slp1": ["upendrabala", "ఉపేన్ద్రబల", "ಉಪೇನ್ದ್ರಬಲ"]}]}