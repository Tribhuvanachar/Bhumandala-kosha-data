{"nemi": [{"id": "nemi", "headword": "नेमि", "headword_slp1": "nemi", "fold": "nemi", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नेमि\n\nNEMI . The real name of daśaratha. (See under daśaratha).", "gloss_language": "en"}], "synonyms": ["nemi", "నేమి", "ನೇಮಿ"], "synonyms_slp1": ["nemi", "నేమి", "ನೇಮಿ"]}], "nemicakra": [{"id": "nemicakra", "headword": "नेमिचक्र", "headword_slp1": "nemicakra", "fold": "nemicakra", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नेमिचक्र\n\nNEMICAKRA . A king, who once ruled hastināpura. Once, when hastināpura was washed away by floods of yamunā nemicakra built a new city in kauśāmbī. (bhāgavata, 9th skandha).", "gloss_language": "en"}], "synonyms": ["nemicakra", "nemichakra", "నేమిచక్ర", "ನೇಮಿಚಕ್ರ"], "synonyms_slp1": ["nemicakra", "nemichakra", "నేమిచక్ర", "ನೇಮಿಚಕ್ರ"]}], "nemihansapada": [{"id": "nemihaMsapada", "headword": "नेमिहंसपद", "headword_slp1": "nemihaMsapada", "fold": "nemihansapada", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "नेमिहंसपद\n\nNEMIHAṀSAPADA . An important place in ancient india. The place is near Akṣaprapatanam in the Ānarta region. It was here that kṛṣṇa killed gopati and tālaketu.", "gloss_language": "en"}], "synonyms": ["nemihaMsapada", "nemihaṁsapada", "నేమిహంసపద", "ನೇಮಿಹಂಸಪದ"], "synonyms_slp1": ["nemihaMsapada", "nemihaṁsapada", "నేమిహంసపద", "ನೇಮಿಹಂಸಪದ"]}]}