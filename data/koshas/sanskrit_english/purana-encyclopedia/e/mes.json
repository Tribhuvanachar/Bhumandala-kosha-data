{"mesa_१": [{"id": "meza_१", "headword": "मेष_१", "headword_slp1": "meza_१", "fold": "mesa_१", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मेष १\n\nMEṢA I . A synonym for indra. Once indra taking the shape of a goat went and drank the soma of the sage medhātithi. Then that sage called indra ‘goat’ (meṣa) and that name of meṣa stuck to him. (Sūkta 51, Anuvāka 10, Maṇḍala 11, ṛgveda).", "gloss_language": "en"}], "synonyms": ["meSha", "meSha_1", "meṣa", "meṣa_1", "मेष", "మేష", "మేష_౧", "ಮೇಷ", "ಮೇಷ_೧"], "synonyms_slp1": ["meSha", "meSha_1", "meṣa", "meṣa_1", "meza", "మేష", "మేష_౧", "ಮೇಷ", "ಮೇಷ_೧"]}], "mesa_२": [{"id": "meza_२", "headword": "मेष_२", "headword_slp1": "meza_२", "fold": "mesa_२", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मेष २\n\nMEṢA II . A soldier of subrahmaṇya. (Śloka 64, Chapter 45, śalya Parva).", "gloss_language": "en"}], "synonyms": ["meSha", "meSha_2", "meṣa", "meṣa_2", "मेष", "మేష", "మేష_౨", "ಮೇಷ", "ಮೇಷ_೨"], "synonyms_slp1": ["meSha", "meSha_2", "meṣa", "meṣa_2", "meza", "మేష", "మేష_౨", "ಮೇಷ", "ಮೇಷ_೨"]}], "mesahft": [{"id": "mezahft", "headword": "मेषहृत्", "headword_slp1": "mezahft", "fold": "mesahft", "headword_language": "sa", "source": "purana-encyclopedia", "senses": [{"gloss": "मेषहृत्\n\nMEṢAHṚT . A son of garuḍa. (Śloka 12. Chapter 101, śalya Parva).", "gloss_language": "en"}], "synonyms": ["meShahRRit", "meShahRit", "meShahRt", "meShahRut", "meṣahṛt", "మేషహృత్", "ಮೇಷಹೃತ್"], "synonyms_slp1": ["meShahRRit", "meShahRit", "meShahRt", "meShahRut", "meṣahṛt", "మేషహృత్", "ಮೇಷಹೃತ್"]}]}