{"ravipula": [{"id": "ravipulA", "headword": "रविपुला", "headword_slp1": "ravipulA", "fold": "ravipula", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रः + -विपुला N. of metre.", "gloss_language": "en"}]}], "ravaH": [{"id": "ravaH", "headword": "रवः", "headword_slp1": "ravaH", "fold": "ravaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रवः [रु-अप्]\n—1 A cry, shriek, scream, yell, roar (of animals &c.); नरवरो रवरोषितकेसरी\n R.; रवः श्रवणभैरवः Ve. 3. 4.\n—2 Singing, humming sound (of birds); R. 9. 29.\n—3 Clamour.\n—4 Noise or sound in general; घण्टा˚, भूषण˚, चाप˚ &c. —5 Thunder.", "gloss_language": "en"}], "synonyms": ["रव"], "synonyms_slp1": ["rava"]}, {"id": "rAvaH", "headword": "रावः", "headword_slp1": "rAvaH", "fold": "ravaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रावः [रु-घञ्]\n—1 A cry, scream, shriek, roar, the cry of any animal.\n—2 Sound in general; मुरजवाद्यरावः; मधुरिपुरावम् Gīt. 11.", "gloss_language": "en"}], "synonyms": ["राव"], "synonyms_slp1": ["rAva"]}], "ravaRa": [{"id": "ravaRa", "headword": "रवण", "headword_slp1": "ravaRa", "fold": "ravaRa", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रवण a. [रु-युच् Uṇ. 2. 71] Crying, roaring, screaming.\n—2 Sonorous, sounding; उत्कण्ठावर्धनैः शुभ्रं रवणैरम्बरं ततम् Bk. 7. 14.\n—3 Sharp, hot.\n—4 Fickle, unsteady.\n—5 Jesting.", "gloss_language": "en"}], "synonyms": ["रवणं", "रवणः"], "synonyms_slp1": ["ravaRaM", "ravaRaH"]}, {"id": "rAvaRa", "headword": "रावण", "headword_slp1": "rAvaRa", "fold": "ravaRa", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रावण a. [रु-णिच् ल्यु] Crying, screaming, roaring, bewailing;\n इत्युक्त्वा परुषं वाक्यं रावणः शत्रुरावणः Rām. 3. 56. 26 (com.\n शत्रून् रावयति क्रोशयति शत्ररावणः).", "gloss_language": "en"}], "synonyms": ["रावणः"], "synonyms_slp1": ["rAvaRaH"]}], "ravaRaH": [{"id": "ravaRaH", "headword": "रवणः", "headword_slp1": "ravaRaH", "fold": "ravaRaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रवण + .{@-णः@}\n—1 a camel; स्वनाम निन्ये रवणः स्फुटार्थताम् Śi. 12. 2.\n—2 The cuckoo.\n—3 A bee.\n—4 Sound.\n—5 A big cucumber.", "gloss_language": "en"}], "synonyms": ["रवण", "रवणं"], "synonyms_slp1": ["ravaRa", "ravaRaM"]}, {"id": "rAvaRaH", "headword": "रावणः", "headword_slp1": "rAvaRaH", "fold": "ravaRaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रावण + .{@-णः@} N. of a celebrated demon, king of Laṅkā and the chief of\n the Rākṣhasas; स रावणो नाम निकामभीषणं बभूव रक्षः क्षतरक्षणं\n दिवः Śi. 1. 48. [He was the son of Viśravas by Keśinī or Kaikaśī\n and so half-brother of Kuber. He is called Paulastya as being\n a grandson of the sage Pulastya. Laṅkā was originally occupied by Kubera,\n but Rāvaṇa ousted him from it and made it his own capital. He had ten\n heads (and hence his names Daśagrīva, Daśavadana &c.) and twenty arms,\n and according to some, four legs (cf. R. 12. 88 and Malli.). He is represented\n to have practised the most austere penance for ten thousand years in order\n to propitiate the god Brahman, and to have offered one head at the end\n of each one thousand years. Thus he offered nine of his heads and was\n going to offer the tenth when the God was pleased and granted him immunity\n from death by either god or man. On the strength of this boon he grew\n very tyrannical and oppressed all beings. His power became so great that\n even the gods are said to have acted as his domestic servants. He conquered\n almost all the kings of the day, but is said to have been imprisoned by\n Kārtavīrya for some time when he went to attack his territory. On one\n occasion he tried to uplift the Kailāsa mountain, but Śiva pressed it\n down so as to crush his fingers under it. He, therefore, hymned Śiva\n for one thousand years so loudly that the God gave him the name Rāvaṇa\n and freed him from his painful position. But though he was so powerful\n and invincible, the day of retribution drew near. While Rāma −who was\n Viṣṇu descended on earth for the destruction of this very demon− was\n passing his years of exile in the forest, Rāvaṇa carried off his wife\n Sītā and urged her to become his wife but she persistently refused and\n remained loyal to her husband. At last Rāma assisted by his monkey-troops\n invaded Laṅkā, annihilated Rāvaṇaʼs troops and killed the demon himself.\n He was a worthy opponent of Rāma, and hence the expression:− रामरावणयोर्युद्धं\n रामरावणयोरिव ।].", "gloss_language": "en"}], "synonyms": ["रावण"], "synonyms_slp1": ["rAvaRa"]}], "ravaRam": [{"id": "ravaRam", "headword": "रवणम्", "headword_slp1": "ravaRam", "fold": "ravaRam", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रवण + .{@-णम्@} Brass, bell-metal.", "gloss_language": "en"}]}, {"id": "rAvaRam", "headword": "रावणम्", "headword_slp1": "rAvaRam", "fold": "ravaRam", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रावण + .{@-णम्@}\n—1 The act of screaming.\n—2 N. of a Muhūrta.\n.━{@Comp.@}: रावणारिः, रावणगङ्गा", "gloss_language": "en"}]}], "ravaRakaH": [{"id": "ravaRakaH", "headword": "रवणकः", "headword_slp1": "ravaRakaH", "fold": "ravaRakaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रवणकः A filter of bamboo.", "gloss_language": "en"}], "synonyms": ["रवणक"], "synonyms_slp1": ["ravaRaka"]}], "ravaTaH": [{"id": "ravaTaH", "headword": "रवथः", "headword_slp1": "ravaTaH", "fold": "ravaTaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रवथः (रु-अथः Uṇ. 3. 112) The Indian cuckoo.", "gloss_language": "en"}], "synonyms": ["रवथ"], "synonyms_slp1": ["ravaTa"]}], "raviH": [{"id": "raviH", "headword": "रविः", "headword_slp1": "raviH", "fold": "raviH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "रविः [cf. Uṇ. 4. 150]\n—1 The sun; सहस्रगुणमुत्स्रष्टुमादत्ते हि रसं रविः R. 1. 18.\n—2 A mountain.\n—3 The Arka pl