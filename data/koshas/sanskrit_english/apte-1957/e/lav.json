_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावणिक a. (-की f.)\n [लवणे संस्कृतं ठण्]\n—1 Salted, dressed with salt.\n—2 Dealing in salt.\n—3 Lovely, beautiful, charming; लीलयैव सुतनोस्तुलयित्वा गौरवाढ्यमपि\n लावणिकेन Śi. 10. 38 (where it means ‘a salt-merchant’ also)", "gloss_language": "en"}], "synonyms": ["लावणिकं", "लावणिकः"], "synonyms_slp1": ["lAvaRikaM", "lAvaRikaH"]}], "lavaRikaH": [{"id": "lAvaRikaH", "headword": "लावणिकः", "headword_slp1": "lAvaRikaH", "fold": "lavaRikaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावणिक + .{@-कः@} A salt-merchant.", "gloss_language": "en"}], "synonyms": ["लावणिक", "लावणिकं"], "synonyms_slp1": ["lAvaRika", "lAvaRikaM"]}], "lavaRikam": [{"id": "lAvaRikam", "headword": "लावणिकम्", "headword_slp1": "lAvaRikam", "fold": "lavaRikam", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावणिक + .{@-कम्@} A salt-vessel, salt-cellar.", "gloss_language": "en"}]}], "lavaRyam": [{"id": "lAvaRyam", "headword": "लावण्यम्", "headword_slp1": "lAvaRyam", "fold": "lavaRyam", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावण्यम् [लवणस्य भावः ष्यञ्]\n—1 Saltness.\n—2 Beauty, loveliness, charm; तथापि तस्या लावण्यं रेखया किंचिदन्वितम्\n Ś. 6. 13, 7. 18; (लावण्य is thus defined in Śabdak.:− मुक्ताफलेषु\n छायायास्तरलत्वमिवान्तरा । प्रतिभाति यदङ्गेषु तल्लावण्यमिहोच्यते ॥).\n Shri Kshitishachandra points out in his Mañjūṣā that the word does\n not seem to have any connection with लवण (salt). The word रामण्यक\n (= beauty) occurs in the Rāmāyaṇa (वनरामण्यकं यत्र जलरामण्यकं\n तथा Araṇyakāṇḍa 25. 5). ‘रलयोरभेद इति न्यायेन सन्निहितयोरनुनासिकयोरेकस्य विषमीकरणप्रक्रियया चाननुनासिकीकरणेन लावण्यमिति निष्पन्नमिति प्रतिभाति’ ।\n Amaruśataka gives a verse containing a pun on the word लावण्य\n (saltness, loveliness):− पीता यतःप्रभृति कामपिपासितेन तस्या मयाधररसः\n प्रचुरः प्रियायाः । तृष्णा तदा प्रभृति मे द्विगुणत्वमेति लावण्यमस्ति\n बहु तत्र किमत्र चित्रम् ॥\n.━{@Comp.@}: लावण्यार्जितम्, लावण्यकलित, लावण्यलक्ष्मीः", "gloss_language": "en"}]}], "lavaRyarjitam": [{"id": "lAvaRyArjitam", "headword": "लावण्यार्जितम्", "headword_slp1": "lAvaRyArjitam", "fold": "lavaRyarjitam", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावण्यम् + -अर्जितम् the private property of a married woman given to her\n at her marriage by her father or mother-in-law.", "gloss_language": "en"}]}], "lavaRyakalita": [{"id": "lAvaRyakalita", "headword": "लावण्यकलित", "headword_slp1": "lAvaRyakalita", "fold": "lavaRyakalita", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावण्यम् + -कलित a. endowed with beauty.", "gloss_language": "en"}]}], "lavaRyalaksmiH": [{"id": "lAvaRyalakzmIH", "headword": "लावण्यलक्ष्मीः", "headword_slp1": "lAvaRyalakzmIH", "fold": "lavaRyalaksmiH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावण्यम् + -लक्ष्मीः great beauty.", "gloss_language": "en"}]}], "lavaRyamaya": [{"id": "lAvaRyamaya", "headword": "लावण्यमय", "headword_slp1": "lAvaRyamaya", "fold": "lavaRyamaya", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावण्यमय, लावण्यवत् a. Lovely, handsome.", "gloss_language": "en"}]}], "lavaRyavat": [{"id": "lAvaRyavat", "headword": "लावण्यवत्", "headword_slp1": "lAvaRyavat", "fold": "lavaRyavat", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावण्यमय, लावण्यवत् a. Lovely, handsome.", "gloss_language": "en"}], "synonyms": ["लावण्यवन्त्"], "synonyms_slp1": ["lAvaRyavant"]}], "lavanakaH": [{"id": "lavAnakaH", "headword": "लवानकः", "headword_slp1": "lavAnakaH", "fold": "lavanakaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "लावाणकः, लवानकः [लू-आनकः Uṇ. 3. 84] N. of a district near Magadha.", "gloss_language": "en"}], "synonyms": ["लवानक"], "synonyms_slp1": ["lavAnaka"]}], "lavikaH": [{"id": "lAvikaH", "headword": "लाविकः", "headword_slp1": "lAvikaH", "fold": "lavikaH", "headword_lan