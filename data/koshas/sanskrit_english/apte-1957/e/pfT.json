sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -कुल a. belonging to a different family.", "gloss_language": "en"}]}], "pfTaksetraH": [{"id": "pfTakkzetrAH", "headword": "पृथक्क्षेत्राः", "headword_slp1": "pfTakkzetrAH", "fold": "pfTaksetraH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -क्षेत्राः m. (pl.) children of one father by different wives,\n or by wives of different classes.", "gloss_language": "en"}]}], "pfTakcara": [{"id": "pfTakcara", "headword": "पृथक्चर", "headword_slp1": "pfTakcara", "fold": "pfTakcara", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -चर a. going alone or separately.", "gloss_language": "en"}]}], "pfTagjanaH": [{"id": "pfTagjanaH", "headword": "पृथग्जनः", "headword_slp1": "pfTagjanaH", "fold": "pfTagjanaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -जनः —1 a low man, an unenlightened,\n[]\n vulgar man, the mob, low people; न पृथग्जनवच्छुचो वशं वशिनामुत्तम\n गन्तुमर्हसि R. 8. 90; Ki. 1. 4. 24.\n—2 a fool, a block-head, an ignorant man; विविनक्ति न बुद्धिदुर्विधः\n स्वयमेव स्वहितं पृथग्जनः Śi. 16. 39.\n—3 a wicked man, sinner.", "gloss_language": "en"}], "synonyms": ["पृथग्जन"], "synonyms_slp1": ["pfTagjana"]}], "pfTagDarmin": [{"id": "pfTagDarmin", "headword": "पृथग्धर्मिन्", "headword_slp1": "pfTagDarmin", "fold": "pfTagDarmin", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -धर्मिन् a. one holding ‘dual’ (द्वैत) doctrine; Mb. 12. 232. 33.", "gloss_language": "en"}]}], "pfTakparRi": [{"id": "pfTakparRI", "headword": "पृथक्पर्णी", "headword_slp1": "pfTakparRI", "fold": "pfTakparRi", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -पर्णी N. of a plant, Hemionitis Cordifolia (Mar. पिठवण).", "gloss_language": "en"}]}], "pfTakpiRqaH": [{"id": "pfTakpiRqaH", "headword": "पृथक्पिण्डः", "headword_slp1": "pfTakpiRqaH", "fold": "pfTakpiRqaH", "headword_language": "s