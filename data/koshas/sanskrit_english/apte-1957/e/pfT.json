d_slp1": "pfTakCayyA", "fold": "pfTakCaya", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -शय्या sleeping apart.", "gloss_language": "en"}]}], "pfTaksTitiH": [{"id": "pfTaksTitiH", "headword": "पृथक्स्थितिः", "headword_slp1": "pfTaksTitiH", "fold": "pfTaksTitiH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक् + -स्थितिः f. separate existence.", "gloss_language": "en"}], "synonyms": ["पृथक्स्थिति"], "synonyms_slp1": ["pfTaksTiti"]}], "pfTaktvam": [{"id": "pfTaktvam", "headword": "पृथक्त्वम्", "headword_slp1": "pfTaktvam", "fold": "pfTaktvam", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "—1 Separateness, severalty.\n—2 Individuality.\n.━{@Comp.@}: पृथक्त्वनिवेशः", "gloss_language": "en"}]}], "pfTaktvanivesaH": [{"id": "pfTaktvaniveSaH", "headword": "पृथक्त्वनिवेशः", "headword_slp1": "pfTaktvaniveSaH", "fold": "pfTaktvanivesaH", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथक्त्वम् + -निवेशः Subsistence on separateness; पृथक्त्वनिवेशात् संख्यया\n कर्मभेदः स्यात् and also संख्यायाश्च पृथक्त्वनिवेशात् Ms. 10. 5. 17;\n यावति संभवति तावति पृथक्त्वनिवेश एव युक्तः ŚB. on MS. 5. 3. 2.\n Hence पृथक्त्वनिवेशिन्. It is considered to be a characteristic\n feature of संख्या; ŚB. on MS. 5. 3. 2. पृथक्त्वेन (Instr. used\n as adv.) Individually, separately; यथा लोके पृथक्त्वेनापि कुर्वाणानां\n बहुवचनं दृश्यते, देवश्चेद् वर्षेद् बहवः कृषिं कुर्युः ŚB. on MS. 10. 6. 45.", "gloss_language": "en"}]}], "pfTavi": [{"id": "pfTavI", "headword": "पृथवी", "headword_slp1": "pfTavI", "fold": "pfTavi", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथवी See पृथिवी.", "gloss_language": "en"}]}], "pfTa": [{"id": "pfTA", "headword": "पृथा", "headword_slp1": "pfTA", "fold": "pfTa", "headword_language": "sa", "source": "apte-1957", "senses": [{"gloss": "पृथा N. of Kuntī, one of the two wives of Pāṇḍu.\n.━{@Comp.@}: पृथाजः, पृथातनयः, पृथासुतः, पृथासूनुः, पृथ