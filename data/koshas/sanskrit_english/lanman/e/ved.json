{"veda": [{"id": "veda", "headword": "वेद", "headword_slp1": "veda", "fold": "veda", "headword_language": "sa", "source": "lanman", "senses": [{"gloss": "véda, m.\n —1. understanding, knowledge;\n--2. esp. the sacred knowledge, handed\ndown in triple form of ṛc, yajus, and\nsāman, see these, and cf. (trayī) vidyā;\n--later, the well-known collections called\nRigveda, Yajurveda, and Sāmaveda\n(635, 6), the holy scriptures, held to be a\nrevelation and so called śruti, 58^18.\n[√1vid.]", "gloss_language": "en"}, {"gloss": "vedá, m. tuft of strong grass (kuśa or\nmuñja) tied so as to form a broom, 62^18.", "gloss_language": "en"}], "synonyms": ["वेदः"], "synonyms_slp1": ["vedaH"]}], "vedatraya": [{"id": "vedatraya", "headword": "वेदत्रय", "headword_slp1": "vedatraya", "fold": "vedatraya", "headword_language": "sa", "source": "lanman", "senses": [{"gloss": "veda-traya, n. the three Vedas.", "gloss_language": "en"}]}], "vedanindaka": [{"id": "vedanindaka", "headword": "वेदनिन्दक", "headword_slp1": "vedanindaka", "fold": "vedanindaka", "headword_language": "sa", "source": "lanman", "senses": [{"gloss": "veda-nindaka, m. one who scoffs at\nthe Veda, infidel.", "gloss_language": "en"}], "synonyms": ["वेदनिंदक", "वेदनिन्दकः"], "synonyms_slp1": ["vedaniMdaka", "vedanindakaH"]}], "vedapuRya": [{"id": "vedapuRya", "headword": "वेदपुण्य", "headword_slp1": "vedapuRya", "fold": "vedapuRya", "headword_language": "sa", "source": "lanman", "senses": [{"gloss": "veda-puṇya, n. Veda-merit, sanctity\nacquired by Veda-study.", "gloss_language": "en"}]}], "vedabahya": [{"id": "vedabAhya", "headword": "वेदबाह्य", "headword_slp1": "vedabAhya", "fold": "vedabahya", "headword_language": "sa", "source": "lanman", "senses": [{"gloss": "veda-bāhya, a. being outside of the\nVeda, i. e. extra-Vedic, differing from or\nconflicting with the Veda. [1265, veda-\nbeing in an abl. relation.]", "gloss_language": "en"}], "synonyms": ["वेदबाह्यः"], "synonyms_slp1": ["vedabAhyaH"]}], "vedavid": [{"id": "ved