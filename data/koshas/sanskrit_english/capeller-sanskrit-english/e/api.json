{"api": [{"id": "api", "headword": "अपि", "headword_slp1": "api", "fold": "api", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "अ॑पि (prep. w. loc., or ˚— in verbs & nouns) close by or to,\nwithin, before;\n adv. further, also, too;\n even (w. न = Lat. quidem);\nat least, however, but (between words, clauses and sentences, or after,\nr. before an emphasized word). Converts an interrog. into an indefinite;\nafter numerals = all;\n at the beginning of a sent. it is a particle of\ninterrogation, with an optat. it expresses hope, fear, or desire. —\nअपि च or चापि further, moreover. अपि—अपि (or च) as well—as.\nअपि च — ज चापि rather than. येऽपि—तेऽपि they too—who. यद्यपि\nhowever, although. तथापि even so, nevertheless.", "gloss_language": "en"}]}, {"id": "Api", "headword": "आपि", "headword_slp1": "Api", "fold": "api", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "आपि॑ m. friend, ally;\n abstr. आपित्व॑ n.", "gloss_language": "en"}], "synonyms": ["आपिः"], "synonyms_slp1": ["ApiH"]}], "apit": [{"id": "apit", "headword": "अपित्", "headword_slp1": "apit", "fold": "apit", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "अपि॑त् a. barren, dry.", "gloss_language": "en"}]}], "apitfdevatya": [{"id": "apitfdevatya", "headword": "अपितृदेवत्य", "headword_slp1": "apitfdevatya", "fold": "apitfdevatya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "अ॑पितृदेवत्य a. not having the Manes as deity.", "gloss_language": "en"}]}], "apitrya": [{"id": "apitrya", "headword": "अपित्र्य", "headword_slp1": "apitrya", "fold": "apitrya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "अपित्र्य a. not paternal.", "gloss_language": "en"}]}], "apitva": [{"id": "apitva", "headword": "अपित्व", "headword_slp1": "apitva", "fold": "apitva", "headword_language": "sa", "source": "capeller-sanskrit-english", "sen