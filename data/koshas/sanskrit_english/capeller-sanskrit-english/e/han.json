ms": ["हंसवत्"], "synonyms_slp1": ["haMsavat"]}], "hansasaci": [{"id": "haMsasAci", "headword": "हंससाचि", "headword_slp1": "haMsasAci", "fold": "hansasaci", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हंससा॑चि m. a kind of bird.", "gloss_language": "en"}]}], "hansavali": [{"id": "haMsAvalI", "headword": "हंसावली", "headword_slp1": "haMsAvalI", "fold": "hansavali", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हंसावली f. = हंसमाला.", "gloss_language": "en"}]}], "hanho": [{"id": "haMho", "headword": "हंहो", "headword_slp1": "haMho", "fold": "hanho", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हंहो a. vocative particle.", "gloss_language": "en"}]}], "han": [{"id": "han", "headword": "हन्", "headword_slp1": "han", "fold": "han", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 हन् ह॑न्ति हते जि॑घ्नते जि॑घ्न˚ति (हनति),\npp. हत॑ (q.v.) smite, beat, strike, strike down, hew off, hit,\npierce, hurt, injure, throw (a spear or an arrow) upon (gen. or dat.),\nslay, kill, destroy (आत्मानमात्मना one's self), suppress, give up,\nabandon. C. घातयति (q.v.). D. जि॑घांसति (˚ते) wish to strike\ndown or kill. I. ज॑ङ्घन्ति (जङ्घन्यते) tread upon (loc. or acc.)\nstrike, slay, destroy;\n vex, afflict. — अप beat off or out, repel,\ndestroy, unhusk (corn). अभि strike at, beat (drum), smite, afflict,\nvisit, touch. D. wish to strike down. अव throw down, strike, hit;\nscare away, repel, keep off. आ strike at (loc. or dat., M. strike a\npart of one's own body);\n hit, beat, attack, assault. अभ्या hit,\nstrike, wound, impede. प्रत्या ward off, repel. व्या strike, hit,\nimpede, hinder, keep off. समा beat (together), strike at, hew down,\nkill.\n[]\nउद् force up, raise;\n root up or out;\n dig or throw up;\n M. hang\none's self. उप beat, strike, touch;\n stick on, fix, fasten;\n hit, hurt,\nafflict, damage, destroy. नि strike in or down, hurl upon (loc.);\n hit\nat, touch;\n attack, assail;\n slay, destroy, bring to nought. अभिनि\nspit, put on;\n strike at (acc.). प्रणि bring to nought, destroy (acc.\nor gen.). प्रतिनि strike against (acc.). विनि beat, strike down,\nkill, destroy. संनि strike at, attack, kill. निस् dash out or off,\ndrive away, slay, destroy. परा strike off or down, overthrow;\n hit,\ntouch. परि strike around, encompass;\n extinguish (fire). प्र beat,\nstrike at (acc.), hew down, kill. अभिप्र, (*निप्र w. gen.), &\nविप्र overwhelm. प्रति strike against (gen.), strike at, attack\n(acc.);\n strike down, break;\n pierce, broach;\n beat back, repel, hinder;\nfrustrate, destroy. वि strike apart, break down, destroy;\n spread,\nextend;\n tear or beat off, repel, resist, frustrate. सम् strike\ntogether, join or unite closely, conglomerate;\n strike or break down. P.\nthicken (intr.), become firm or solid. — Cf. अभि॑हत, आ॑हत,\nउ॑द्धत, वि॑हत, संहत, समुद्धत.", "gloss_language": "en"}, {"gloss": "2 हन् f. घ्नी (—˚) killing, slayer.", "gloss_language": "en"}]}], "hanana": [{"id": "hanana", "headword": "हनन", "headword_slp1": "hanana", "fold": "hanana", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "ह॑नन a. (f. ई) & n. striking down, killing,\ndestroying.", "gloss_language": "en"}], "synonyms": ["हननं", "हननः"], "synonyms_slp1": ["hananaM", "hananaH"]}], "haniyans": [{"id": "hanIyaMs", "headword": "हनीयंस्", "headword_slp1": "hanIyaMs", "fold": "haniyans", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "ह॑नीयंस् (compar.) slaying more or most.", "gloss_language": "en"}]}], "hanu": [{"id": "hanu", "headword": "हनु", "headword_slp1": "hanu", "fold": "hanu", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "ह॑नु f. the jaw.", "gloss_language": "en"}], "synonyms": ["हनुः"], "synonyms_slp1": ["hanuH"]}], "hanumant": [{"id": "hanumant", "headword": "हनुमन्त्", "headword_slp1