{"ksi": [{"id": "kzi", "headword": "क्षि", "headword_slp1": "kzi", "fold": "ksi", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 क्षि क्षे॑ति क्षिय॑ति क्ष॑यति abide, dwell, inhabit;\nrule, be master of (gen.). C. क्षय॑यति & क्षेपयति pacify. — अधि\ndwell in, rest on, spread over (acc. or loc.). आ dwell in, inhabit, be\nor become possessed of (acc.), exist. उप dwell in or near, remain\nwith, rest or depend on (acc.), परि dwell about (acc.). प्रति\nsettle at (acc). सम् dwell together with (instr.).", "gloss_language": "en"}, {"gloss": "2 क्षि क्षिणाति क्षिणो॑ति (क्षयति), pp. क्षित॑ & क्षीण॑\n(q.v.) destroy, injure, exhaust;\n P. क्षीय॑ते (क्षी॑यते) be\nexhausted, perish, cease, wane (moon). C. क्षययति & क्षपयति, ˚ते\n= S. tr.;\n w. कालम् etc. pass, spend. — अप & उप P. = S. P.\nपरि destroy;\n P. suffer loss, become poor. —प्र, सम् A. & P. = S.\n— Cf. परिक्षीण, प्र॑क्षीण.", "gloss_language": "en"}], "synonyms": ["क्षिः"], "synonyms_slp1": ["kziH"]}], "ksit": [{"id": "kzit", "headword": "क्षित्", "headword_slp1": "kzit", "fold": "ksit", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "क्षित् a. & s. dwelling, ruling;\n inhabitant, ruler.", "gloss_language": "en"}]}], "ksita": [{"id": "kzita", "headword": "क्षित", "headword_slp1": "kzita", "fold": "ksita", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "क्षित॑ pp. exhausted, afflicted, wretched.", "gloss_language": "en"}], "synonyms": ["क्षितः"], "synonyms_slp1": ["kzitaH"]}], "ksiti": [{"id": "kziti", "headword": "क्षिति", "headword_slp1": "kziti", "fold": "ksiti", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 क्षिति॑ f. abode, settlement, the earth;\n pl. the\nsettlements, i.e. tribes, nations, men, people.", "gloss_language": "en"}, {"gloss": "2 क्षि॑ति f. destruction, decay, end.", "gloss_language": "en"}], "synonyms": ["क्षितिः"], "synonyms_slp1": ["kziti