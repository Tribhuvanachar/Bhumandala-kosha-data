 "gloss_language": "en"}]}], "padasreRi": [{"id": "padaSreRi", "headword": "पदश्रेणि", "headword_slp1": "padaSreRi", "fold": "padasreRi", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदश्रेणि f. = पद॑पङ्क्ति.", "gloss_language": "en"}]}], "padasTa": [{"id": "padasTa", "headword": "पदस्थ", "headword_slp1": "padasTa", "fold": "padasTa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदस्थ a. going (lit. standing) on foot;\n having a rank\nor position.", "gloss_language": "en"}]}], "padakranta": [{"id": "padAkrAnta", "headword": "पदाक्रान्त", "headword_slp1": "padAkrAnta", "fold": "padakranta", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदाक्रान्त a. following at one's heels.*", "gloss_language": "en"}]}], "padaNka": [{"id": "padANka", "headword": "पदाङ्क", "headword_slp1": "padANka", "fold": "padaNka", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदाङ्क m. footmark.", "gloss_language": "en"}], "synonyms": ["पदांक", "पदाङ्कः"], "synonyms_slp1": ["padAMka", "padANkaH"]}], "padati": [{"id": "padAti", "headword": "पदाति", "headword_slp1": "padAti", "fold": "padati", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदाति a. going on foot;\n m. pedestrian, foot-soldier.", "gloss_language": "en"}], "synonyms": ["पदातिः"], "synonyms_slp1": ["padAtiH"]}], "padadi": [{"id": "padAdi", "headword": "पदादि", "headword_slp1": "padAdi", "fold": "padadi", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदादि m. the beginning of a verse or word.", "gloss_language": "en"}], "synonyms": ["पदादिः"], "synonyms_slp1": ["padAdiH"]}], "padanuga": [{"id": "padAnuga", "headword": "पदानुग", "headword_slp1": "padAnuga", "fold": "padanuga", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पदानुग a. = पदाक्रान्त +