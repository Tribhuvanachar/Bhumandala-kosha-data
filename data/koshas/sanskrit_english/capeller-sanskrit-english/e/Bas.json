{"Bas": [{"id": "Baz", "headword": "भष्", "headword_slp1": "Baz", "fold": "Bas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भष् भषति भष˚ते bark.", "gloss_language": "en"}]}, {"id": "Bas", "headword": "भस्", "headword_slp1": "Bas", "fold": "Bas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 भस् ब॑भस्ति ब॑प्सति pp. भसित (q.v.) chew,\ndevour, consume.", "gloss_language": "en"}, {"gloss": "2 भस् (only loc. भसि) ashes.", "gloss_language": "en"}]}, {"id": "BAz", "headword": "भाष्", "headword_slp1": "BAz", "fold": "Bas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भाष् भाषते (भाष˚ति), pp. भाषित (q.v.) speak,\ntalk, say, tell (acc. of pers. & th.);\n name, call (2 acc.). C.\nभाषयति, ˚ते cause to speak;\n tell, say. — अनु call after or to\n(acc.), speak to or about (acc.);\n pronounce, confess. अप abuse,\nrevile. अभि speak, say, tell (acc. of th. or - & - pers.), proclaim,\nconfess. आ speak to, address (acc.), converse with (सह);\n say, tell\n(1 or 2 acc.);\n name, call;\n exclaim, promise. व्या & समा address, speak\nto, communicate. परि speak to, admonish, remind,\n[]\npronounce,\nexplain, teach. प्र speak out, name, proclaim, communicate, expound,\nexplain, converse with (acc.). प्रति speak back, answer (acc. of pers.\nor th.);\n relate, communicate. वि revile, abuse;\n P. admit an\nalternative, be optional (g.). सम् talk to, converse with (instr.\n±सह), address, salute, persuade. C. = S. — Cf. विभाषित.", "gloss_language": "en"}]}, {"id": "BAs", "headword": "भास्", "headword_slp1": "BAs", "fold": "Bas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 भा॑स् n. (older than) f. light, brightness.", "gloss_language": "en"}, {"gloss": "2 भास् भा॑सति भा॑स˚ते pp. भासित॑ (q.v.) shine,\nbe bright, appear as or like (nom. or instr.), become clear or obvious,\nbe imagined or conceived. C. भासयति, ˚ते make shine, illuminate,\ncause to appear as (instr.), show, manifest. — अव M. shine, light,\nbecome manifest, appear as (instr. or adv. in वत्). C. shine upon,\nillumine. आ M. appear as (इव). उद् shine forth, make a show, catch\nthe eye. C. illumine (M.), illustrate, embellish. समुद् shine with\n(instr.). निस् C. illumine. परि M. appear, look like (इव). C.\nbeautify, adorn. प्र shine, be bright, appear like (इव). C.\nillumine, illustrate. प्रति M. shine forth, become manifest, appear\nlike (nom.) or as (instr. of an abstr.), be brilliant, make a show. C.\nshow, manifest. वि shine, be bright.", "gloss_language": "en"}]}], "Basa": [{"id": "Baza", "headword": "भष", "headword_slp1": "Baza", "fold": "Basa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भष॑ a. barking.", "gloss_language": "en"}], "synonyms": ["भषः"], "synonyms_slp1": ["BazaH"]}, {"id": "BAzA", "headword": "भाषा", "headword_slp1": "BAzA", "fold": "Basa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भाषा f. speech, language, esp. vernacular l., dialect;\ndescription, definition;\n accusation, plaint.", "gloss_language": "en"}]}, {"id": "BAsa", "headword": "भास", "headword_slp1": "BAsa", "fold": "Basa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भास॑ m. light, brightness;\n a cert. bird of prey (f.\nभासी their mother), a man's name.", "gloss_language": "en"}], "synonyms": ["भासः"], "synonyms_slp1": ["BAsaH"]}], "Basaka": [{"id": "Bazaka", "headword": "भषक", "headword_slp1": "Bazaka", "fold": "Basaka", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भषक m. barker, dog.", "gloss_language": "en"}], "synonyms": ["भषकः"], "synonyms_slp1": ["BazakaH"]}, {"id": "BAzaka", "headword": "भाषक", "headword_slp1": "BAzaka", "fold": "Basaka", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भाषक a. speaking, talking about (—˚).