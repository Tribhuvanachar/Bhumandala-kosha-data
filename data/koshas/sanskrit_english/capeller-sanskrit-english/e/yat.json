ms": ["यतरः"], "synonyms_slp1": ["yataraH"]}], "yataraTa": [{"id": "yataraTA", "headword": "यतरथा", "headword_slp1": "yataraTA", "fold": "yataraTa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "यतर॑था adv. in which (rel.) of two ways.", "gloss_language": "en"}]}], "yatavrata": [{"id": "yatavrata", "headword": "यतव्रत", "headword_slp1": "yatavrata", "fold": "yatavrata", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "यतव्रत a. observing vows;\n devout, firm, constant.", "gloss_language": "en"}]}], "yatas": [{"id": "yatas", "headword": "यतस्", "headword_slp1": "yatas", "fold": "yatas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "य॑तस् adv. ( = abl. of य॑) from whom, what or which,\n(from) where (repeated from whom etc. soever);\n wherefore, why, because,\nas;\n since (±प्रभृति);\n as soon as;\n that, so that, in order that. —\nCf. त॑तस्.", "gloss_language": "en"}]}], "yatasruc": [{"id": "yatasruc", "headword": "यतस्रुच्", "headword_slp1": "yatasruc", "fold": "yatasruc", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "यत॑स्रुच् a. lifting up or stretching out the sacrificial\nladle.", "gloss_language": "en"}]}], "yatatman": [{"id": "yatAtman", "headword": "यतात्मन्", "headword_slp1": "yatAtman", "fold": "yatatman", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "यतात्मन् a. self-restrained.", "gloss_language": "en"}]}], "yatatmavant": [{"id": "yatAtmavant", "headword": "यतात्मवन्त्", "headword_slp1": "yatAtmavant", "fold": "yatatmavant", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "यता˚त्मवन्त् a. self-restrained.", "gloss_language": "en"}], "synonyms": ["यतात्मवत्"], "synonyms_slp1": ["yatAtmavat"]}], "yati": [{"id": "yati", "headword": "यति", "headword_slp1": "yati", "fold": "yati", "headword_language": "sa", "source": "c