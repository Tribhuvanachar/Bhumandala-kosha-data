{"hfs": [{"id": "hfz", "headword": "हृष्", "headword_slp1": "hfz", "fold": "hfs", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हृष् हृष्यति हृष्य˚ते (ह॑र्षते, हृष्यति, हृष्य˚ते\n(ह॑र्ष˚ति), pp. हृष्ट & हृषित॑ (q.v.) be excited (with pleasure or\nfear), be delighted or amazed;\n bristle, stand on end (the hair). C.\nहर्ष॑यति, हर्ष॑य˚ते cause (the hair) to bristle or stand erect;\nexcite, make impatient, rejoice (tr. & intr.). I. (जर्हृषन्त &\nज॑र्हृषाण) be very impatient or much excited. — अनु be excited or\nrejoice with (acc.). अभि & समभि C. gladden. उद् be excited,\nimpatient, or glad. C. excite, gladden. परि & संपरि C. delight\ngreatly, enrapture. प्र be merry, rejoice. संप्र the same;\n C.\ngladden. प्रति be glad in return. सम् be excited, rejoice, exult. C.\ngladden, delight. — Cf. परिहृष्ट, प्रहृष्ट, प्रोद्धृषित (add.),\nसंहृष्ट.", "gloss_language": "en"}]}], "hfsita": [{"id": "hfzita", "headword": "हृषित", "headword_slp1": "hfzita", "fold": "hfsita", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हृषित॑ a. standing on end, erect, stiff (hair);\nunwithered, fresh (flowers);\n enraptured, delighted.", "gloss_language": "en"}], "synonyms": ["हृषितं"], "synonyms_slp1": ["hfzitaM"]}], "hfsitasragrajohina": [{"id": "hfzitasragrajohIna", "headword": "हृषितस्रग्रजोहीन", "headword_slp1": "hfzitasragrajohIna", "fold": "hfsitasragrajohina", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हृषितस्रग्रजोहीन a. having unwithered\ngarlands and free from dust.", "gloss_language": "en"}]}], "hfsika": [{"id": "hfzIka", "headword": "हृषीक", "headword_slp1": "hfzIka", "fold": "hfsika", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "हृषीक n. organ of sense.", "gloss_language": "en"}], "synonyms": ["हृषीकं"], "synonyms_slp1": ["hfzIkaM"]}], "hfsikesa": [{"id": "hfzIkeSa", "headword": "हृषीकेश", "headword_slp1": "hfzIkeSa