{"pas": [{"id": "paS", "headword": "पश्", "headword_slp1": "paS", "fold": "pas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 पश् only pres. प॑श्यति, only pres. प॑श्य˚ते (cf. स्पश् &\nद्ण्ष्) see, behold, perceive, look, look on, try, examine, ponder;\n regard\nor consider as, take for (2 acc. or acc. & adv. in वत्), see with the\nspiritual eye (of seers and poets), find out, invent. — अति look\nbeyond. अनु look at, behold, discover, regard or consider as etc. = S.\nअव look at, observe. उद् look up, foresee, expect, behold, perceive.\nपरि look over, survey, descry, discover, learn, understand, know as\n(2 acc.). प्र look forward, foresee, view, behold, know, recognize,\ntake for (2 acc.). प्रति look at, behold, experience, learn. वि see\nin different places or in detail, discern, distinguish;\n perceive,\nobserve, know, understand. अभिवि behold, perceive. सम् see\n(together or at the same time), look over, survey, observe, consider,\ntry, examine, perceive, behold, know, understand;\n M. look at each other,\nbe together.", "gloss_language": "en"}, {"gloss": "2 प॑श् (only instr. पड्भि॑स्) look, eye.", "gloss_language": "en"}, {"gloss": "3 प॑श् (only instr. पड्भि॑स्) bond, rope.", "gloss_language": "en"}]}], "pasavya": [{"id": "paSavya", "headword": "पशव्य", "headword_slp1": "paSavya", "fold": "pasavya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पशव्य॑ a. belonging to or fit for cattle;\n n. a herd or\ndrove of cattle.", "gloss_language": "en"}], "synonyms": ["पशव्यं"], "synonyms_slp1": ["paSavyaM"]}], "pasu": [{"id": "paSu", "headword": "पशु", "headword_slp1": "paSu", "fold": "pasu", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "प॑शु m. cattle (singly or coll.), animal. esp. domestic a.\nor sacrificial victim (sometimes including man, sometimes said\ncontemptuously of a man. — Abstr. ˚ता† f., ˚त्व† n.", "gloss_language": "en"}, {"gloss"