{"pat": [{"id": "pat", "headword": "पत्", "headword_slp1": "pat", "fold": "pat", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पत् प॑तति (प॑त˚ते) pp. पतित॑ (q.v.) fly, soar,\nrush;\n come down, descend, fall or sink (lit. & fig. ±अधस्), lose\ncaste, rank, or position;\n fall or light upon (loc.);\n incur or get into\n(loc.);\n come to pass, happen. C. पात॑यति, प॑तति (˚ते), pp.\nपतित॑ (q.v.) fly, soar, rush;\n come down, descend, fall or sink (lit.\n& fig. ±अधस्), lose caste, rank, or position;\n fall or light upon\n(loc.);\n incur or get into (loc.);\n come to pass, happen. C. पात॑य˚ते\n(& पतयति q.v.) cause to fly or fall, pour out or shed (water,\ntears, etc.);\n hurl, cast, throw;\n put, turn, direct to, impose or inflict\nupon (loc.);\n throw down, fell, ruin, cut off or asunder, divide\n(द्वेधा॑);\n M. rush on, hasten. D. पिपतिषति & पित्सति being about\nto fly or to fall in. —अच्छ fly towards (acc.). अति fly or fall\nbeyond or past. अनु fly to, through, or after;\n go after, follow,\npursue. अन्तर् fly into (loc.). अभि fly or hasten near, go towards\nor against;\n fall down or upon, come into (acc.). C. throw on (dat. or\nloc.);\n throw down, kill. समभि rush upon (acc.). अव fly, jump,\nfall down or upon (acc.). आ fly or hasten near, fall into or upon\n(acc. or loc.);\n happen, occur, fall to one's (gen) share. C. throw or\ncut down, let fall, shed (tears). अभ्या hasten near, rush upon (acc.).\nसमा fly or hasten near, rush upon (acc.);\n come to, obtain;\n have\nsexual intercourse with (सह). उद् fly or spring up, come forth,\nrise, start, set out, escape. C. cause to fly up, lift, raise. अभ्युद्\nfly or jump up. C. cause to fly up to (acc.). समुद् fly or spring up\n(together) etc. = उद् S. उप fly near, hasten towards (acc. or loc.).\nनि fly down, alight, descend, fall or rush upon (acc. or loc.), get or\nfall into (loc.), tumble down, throw one's self down (पादयोस्);\nhappen, occur (w. gen. = come into the mind*), fall to the share of\n(loc.), fall into ruin, be lost or in vain. C. cause to fall, let fall,\ndrop, throw down;\n put in, turn upon (loc.);\n fell, destroy, kill;\n put\ndown, establish (g.). प्रणि throw one's self down, bow to (acc., dat.,\nor loc.). C. cause to fall down or bow. विनि fly, fall, rush, descend\nupon or into (loc.);\n attack, assail. C. throw down, cut off or\n[]\nsplit (the head), inflict (punishment);\n destroy, ruin, kill. संनि\nfly, fall, or descend upon (loc.);\n assemble, meet, encounter;\n come\ntogether with (instr. ±सह). C. throw down, shoot off;\n collect,\nunite, bring together. निस् & विनिस् fly or rush out, come forth,\ndepart, retreat, escape. परा fly away or past, fall out or down,\ndepart, escape, retreat, stay away, fail;\n fly along, hasten;\n come near,\narrive. परि fly or run about, round, or to and fro;\n leap down from\n(abl.), rush or fall upon (loc.). C. cause to fall down, shoot off,\nthrow into. प्र fly forth or along, hasten to (loc.);\n fall down, rush\nupon, come into (loc.). C. cause to flee, pursue. वि fly along or\nthrough;\n split, burst asunder (intr.). C. cause to fly away, shoot off;\nrend asunder, throw down, destroy, kill. सम् fly or rush together;\nmeet, encounter (of friends & foes);\n hasten on or towards (acc.), come\nto, arrive at (acc. or loc.);\n fall down upon, get into (loc.), happen,\npass, occur. C. hurl upon, throw down into (loc.).", "gloss_language": "en"}]}], "pataga": [{"id": "pataga", "headword": "पतग", "headword_slp1": "pataga", "fold": "pataga", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतग m. a winged animal, bird.", "gloss_language": "en"}], "synonyms": ["पतगः"], "synonyms_slp1": ["patagaH"]}], "patagapati": [{"id": "patagapati", "headword": "पतगपति", "headword_slp1": "patagapati", "fold": "patagapati", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतगपति m. the king of the birds, E. of Garuḍa.", "gloss_language": "en"}]}], "patagaraja": [{"id": "patagarAja", "headword": "पतगराज", "headword_slp1": "patagarAja", "fold": "patagaraja", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतग˚राज m. the king of the birds, E. of Garuḍa.", "gloss_language": "en"}]}], "patagesvara": [{"id": "patageSvara", "headword": "पतगेश्वर", "headword_slp1": "patageSvara", "fold": "patagesvara", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतगेश्वर m. = prec., also E. of Jaṭāyu.", "gloss_language": "en"}]}], "patanga": [{"id": "pataMga", "headword": "पतंग", "headword_slp1": "pataMga", "fold": "patanga", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतंग॑ a. flying;\n m. bird, insect, esp. grasshopper,\nbutterfly, or moth (also पत॑ग).", "gloss_language": "en"}], "synonyms": ["पतंगः", "पतङ्ग", "पतङ्गं", "पतङ्गः"], "synonyms_slp1": ["pataMgaH", "pataNga", "pataNgaM", "pataNgaH"]}], "patangara": [{"id": "pataMgara", "headword": "पतंगर", "headword_slp1": "pataMgara", "fold": "patangara", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतंगर॑ a. bird-like.", "gloss_language": "en"}]}], "patangaraja": [{"id": "pataMgarAja", "headword": "पतंगराज", "headword_slp1": "pataMgarAja", "fold": "patangaraja", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "पतंगराज m. = पतगराज.", "gloss_language": "en"}]}], "patangavfti": [{"id": "pataMgavftti", "headword": "पतंगवृत्ति", "headword_slp1": "pataMgavftti", "fold": "patangavfti", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 पतंगवृत्ति f. rashness, temerity, lit. the way of\na moth (attracted by a light).", "gloss_language": "en"}, {"gloss": "2 पतंगवृत्ति a. very thoughtless or rash (cf.\nprec.).", "gloss_language": "en"}]}], "pataYjala": [{"id": "pataYjala", "headword": "पतञ्जल", "headword_slp1": "pataYjala", "fold": "pata