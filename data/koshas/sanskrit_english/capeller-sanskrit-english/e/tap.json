{"tap": [{"id": "tap", "headword": "तप्", "headword_slp1": "tap", "fold": "tap", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तप् त॑पति (त॑प˚ते), pp. तप्त॑ (q.v.) be warm or\nhot, burn (instr.), shine;\n castigate one's self, do penance, suffer;\nheat, burn (tr.), distress, pain, torment. P. तप्य॑ते (also\nत॑प्यते, ˚ति) has only the intr. mgs. C. तापयति, ˚ते make hot,\nconsume by heat, distress, pain, castigate (one's self). — अति make\nwarm or hot, trouble, distress. अनु heat, pain;\n P. suffer pain,\nrepent, long for (acc.). प्रत्यनु & समनु P. repent. अभि make hot,\nshine upon, pain, ache;\n P. suffer pain. आ glow, shine, heat;\n P. suffer\npain, w. तपस् castigate one's self. अभ्या heat, pain, torment. उद्\nthe same. उप make hot, vex, hurt;\n also = P. suffer, pain, get unwell\n(A. also impers. w. gen. or acc. of pers.). निस् (निष्) heat, singe.\nपरि burn all round, set on fire, kindle;\n also = P. feel pain, suffer,\ndo penance (±तपस्). C. pain, afflict. प्र A. give out heat, burn,\nshine (l.&f.);\n shine upon, warm, heat, singe, roast, pain, torment;\nalso = P. feel pain, suffer, castigate one's self. C. heat, warm,\nillumine, kindle;\n pain, distress. प्रति give out heat towards, make\nhot or warm. वि give out strong heat, burn;\n pervade, penetrate. सम्\nheat, burn, pain, torment (also C.);\n suffer pain, repent. P. be\ndistressed, grieve, do penance. अभिसम् vex, distress. — Cf.\nउ॑त्तप्त, उपतप्त, प्रतपन्त्, प्रतप्त, संतप्त.", "gloss_language": "en"}]}], "tapa": [{"id": "tapa", "headword": "तप", "headword_slp1": "tapa", "fold": "tapa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तप a. heating, burning, tormenting (—˚);\n m. heat, fire,\npenance, religious austerity.", "gloss_language": "en"}], "synonyms": ["तपः"], "synonyms_slp1": ["tapaH"]}, {"id": "tApa", "headword": "ताप", "headword_slp1": "tApa", "fold": "tapa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "ताप m. heat, ardour, pain, affliction.", "gloss_language": "en"}], "synonyms": ["तापः"], "synonyms_slp1": ["tApaH"]}], "tapaHklama": [{"id": "tapaHklama", "headword": "तपःक्लम", "headword_slp1": "tapaHklama", "fold": "tapaHklama", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपःक्लम a. exhausted by austerities.", "gloss_language": "en"}]}], "tapaHksama": [{"id": "tapaHkzama", "headword": "तपःक्षम", "headword_slp1": "tapaHkzama", "fold": "tapaHksama", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपःक्षम a. fit to bear austerities.", "gloss_language": "en"}]}], "tapati": [{"id": "tapatI", "headword": "तपती", "headword_slp1": "tapatI", "fold": "tapati", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपती f. N. of a daughter of the Sun & of a river.", "gloss_language": "en"}]}], "tapana": [{"id": "tapana", "headword": "तपन", "headword_slp1": "tapana", "fold": "tapana", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑पन a. warming, burning, shining (of the sun);\n vexing,\ntormenting. m. the sun, a cert. hot hell. f. तपनी॑ heat, ardour. n.\nतपन॑ the same + pain, penance, religious austerity.", "gloss_language": "en"}], "synonyms": ["तपनः"], "synonyms_slp1": ["tapanaH"]}, {"id": "tApana", "headword": "तापन", "headword_slp1": "tApana", "fold": "tapana", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तापन f. ई heating, burning, distressing, illumining\n(—˚). m. the sun;\n n. burning, distressing, chastisement, penance;\n a\ncert. hell.", "gloss_language": "en"}], "synonyms": ["तापनः"], "synonyms_slp1": ["tApanaH"]}], "tapaniya": [{"id": "tapanIya", "headword": "तपनीय", "headword_slp1": "tapanIya", "fold": "tapaniya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपनीय m. a sort of rice;\n n. (purified) gold.", "gloss_language": "en"}], "synonyms": ["तपनीयं"], "synonyms_slp1": ["tapanIyaM"]}, {"id": "tApanIya", "headword": "तापनीय", "headword_slp1": "tApanIya", "fold": "tapaniya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तापनीय a. made of (pure) gold;\n m. pl. a cert. Vedic\nschool.", "gloss_language": "en"}]}], "tapaniyasoka": [{"id": "tapanIyASoka", "headword": "तपनीयाशोक", "headword_slp1": "tapanIyASoka", "fold": "tapaniyasoka", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपनीयाशोक m. a kind of Acoka.*", "gloss_language": "en"}]}], "tapascaraRa": [{"id": "tapaScaraRa", "headword": "तपश्चरण", "headword_slp1": "tapaScaraRa", "fold": "tapascaraRa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपश्चरण n. ˚श्चर्या f. the practice of penance.", "gloss_language": "en"}]}], "tapas": [{"id": "tapas", "headword": "तपस्", "headword_slp1": "tapas", "fold": "tapas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑पस् n. warmth, heat, ardour;\n pain, grief;\n religious\nausterity, penance, meditation;\n (*m.) a cert. month or season.", "gloss_language": "en"}]}], "tapasy": [{"id": "tapasy", "headword": "तपस्य्", "headword_slp1": "tapasy", "fold": "tapasy", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपस्य् त॑पस्यति do penance.", "gloss_language": "en"}]}], "tapasya": [{"id": "tapasya", "headword": "तपस्य", "headword_slp1": "tapasya", "fold": "tapasya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तपस्य॑ a. produced by heat;\n m. a cert. cool month, a\nman's name;\n f. आ & n. penance, austerity.", "gloss_language": "en"}], "synonyms": ["तपस्यं", "तपस्यः"], "synonyms_slp1": ["tapasyaM", "tapasyaH"]}, {"id": "tApasya", "headword": "तापस्य", "headword_slp1": "tApasya", "fold": "tapasya", "headword_language": "sa", "s