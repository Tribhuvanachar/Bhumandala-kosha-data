cite, explain.\nपरि overlook, neglect, despise, condemn;\n name, term;\n speak to (acc.),\nanswer. प्र relate, tell;\n consider as, take for, call, name. संप्र\nexplain, suppose. प्रति see, perceive, behold, expect;\n cause to\nappear, show. वि appear, shine, see, behold, look at, observe;\n also =\nC. cause to appear, show, reveal;\n proclaim, announce, tell. सम् view,\nbehold, survey, examine, observe;\n enumerate, report;\n call, name, term.\n— Cf. अभिच॑ष्टे, विच॑ष्टे.", "gloss_language": "en"}]}], "caksaRa": [{"id": "cakzaRa", "headword": "चक्षण", "headword_slp1": "cakzaRa", "fold": "caksaRa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "च॑क्षण n. appearance, aspect.", "gloss_language": "en"}], "synonyms": ["चक्षणं"], "synonyms_slp1": ["cakzaRaM"]}], "caksaRi": [{"id": "cakzaRi", "headword": "चक्षणि", "headword_slp1": "cakzaRi", "fold": "caksaRi", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "चक्ष॑णि m. who illuminates.", "gloss_language": "en"}]}], "caksan": [{"id": "cakzan", "headword": "चक्षन्", "headword_slp1": "cakzan", "fold": "caksan", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "च॑क्षन् n. eye.", "gloss_language": "en"}]}], "caksas": [{"id": "cakzas", "headword": "चक्षस्", "headword_slp1": "cakzas", "fold": "caksas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "च॑क्षस् n. brightness, clearness;\n seeing or being seen\n(dat. as infin.).", "gloss_language": "en"}]}], "caksu": [{"id": "cakzu", "headword": "चक्षु", "headword_slp1": "cakzu", "fold": "caksu", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "च॑क्षु m. eye.", "gloss_language": "en"}], "synonyms": ["चक्षुः"], "synonyms_slp1": ["cakzuH"]}], "caksurvisaya": [{"id": "cakzurvizaya", "headword": "चक्षुर्विषय", "headword_slp1": "cakzurvizaya", "fold": "caksurvisaya", "headword_language": "sa", "s