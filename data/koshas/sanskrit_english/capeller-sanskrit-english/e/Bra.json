{"Brans": [{"id": "BraMS", "headword": "भ्रंश्", "headword_slp1": "BraMS", "fold": "Brans", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भ्रंश् भ्र॑शते भ्रश्यते (˚ति), pp. भ्रष्ट॑\n(q.v.) fall, drop, bounce against (loc.) or from (abl.);\n sink, decline,\ndecay, disappear, be gone or lost;\n be deprived of, lose (abl.). C.\nभ्रंशयति cause to fall, throw down, drop (trans.);\n precipitate,\noverthrow, cause to be lost, deprive of (abl.). — प्र fall down,\ndisappear, vanish, be deprived of. C. bring to fall, deprive of (abl.).\nवि fail, have no success in (loc.);\n turn away from, abandon (abl.). C.\ncut or break off, fell, ruin, destroy;\n deprive of (abl.). सम् fall\ndown. — Cf. अपभ्रष्ट, परिभ्रष्ट, प्रभ्रष्ट, विभ्रष्ट.", "gloss_language": "en"}]}], "Bransa": [{"id": "BraMSa", "headword": "भ्रंश", "headword_slp1": "BraMSa", "fold": "Bransa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भ्रंश m. fall, ruin, disappearance, loss;\n aberration or\ndeviation from (—˚).", "gloss_language": "en"}], "synonyms": ["भ्रंशः"], "synonyms_slp1": ["BraMSaH"]}], "Bransana": [{"id": "BraMSana", "headword": "भ्रंशन", "headword_slp1": "BraMSana", "fold": "Bransana", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भ्रंशन a. causing to fall, throwing down;\n n. being\ndeprived or depriving of (abl.).", "gloss_language": "en"}]}], "Bransin": [{"id": "BraMSin", "headword": "भ्रंशिन्", "headword_slp1": "BraMSin", "fold": "Bransin", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भ्रंशिन् a. falling, dropping down from (abl.), sinking,\ndeclining, perishing;\n causing to fall, destroying.", "gloss_language": "en"}]}], "Braj": [{"id": "Braj", "headword": "भ्रज्", "headword_slp1": "Braj", "fold": "Braj", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "भ्र॑ज् f. stiffness.", "gloss_language"