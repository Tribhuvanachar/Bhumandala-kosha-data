{"tans": [{"id": "taMs", "headword": "तंस्", "headword_slp1": "taMs", "fold": "tans", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "†तंस् तस् pour out (fig.);\n C. तंसयति shake.\n—अभि shake out of, rob. परि C. shake, stir. वि the same. — Cf.\nअवतंसय्.", "gloss_language": "en"}]}], "tan": [{"id": "tan", "headword": "तन्", "headword_slp1": "tan", "fold": "tan", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "1 तन् तनो॑ति तनुते॑ pp. तत॑ (q.v.) extend, stretch,\nspread (intr. & tr.);\n last, continue;\n protract, prolong, lengthen;\n spin\nout, weave (l.&f.);\n prepare, arrange, direct, accomplish, perform,\ncompose, make. P. ताय॑ते be extended, increase, grow. — अधि\nstring (the bow), cover. अनु extend along (intr.), continue;\n carry on,\nmaintain. अभि extend or reach over (acc);\n spread out, unfold, place\nin front. अव sink down;\n overspread, cover;\n loosen, let off (esp. the\nbow-string). आ spread over, penetrate, cover (esp. with light);\nexpand, diffuse, stretch (a bow);\n bring forth, produce, effect, show,\nbetray. अन्वा stretch or reach over;\n spread (tr. & intr.). व्या\ndiffuse, produce, effect. समा the same, stretch (esp. the bow).\nपरि stretch around, surround, envelop. प्र spread, extend (tr. &\nintr.);\n cause, produce;\n show, betray. वि spread over, cover, fill,\nstretch out (a cord, web, etc.) string (a bow);\n diffuse, extend;\nprepare, arrange, sacrifice;\n produce, effect;\n make, render (2 acc.).\nसम् join one's self with, hold together;\n cover, fill;\n connect,\ncontinue, protract;\n effect, accomplish;\n exhibit, evince. अनुसम् add,\njoin, annex;\n spread, expand;\n carry on, prosecute. — Cf. आ॑तत,\nप्रवितत, वि॑तत, स॑तत.", "gloss_language": "en"}, {"gloss": "2 त॑न् (only dat. & instr.) spreading, continuation,\npropagation, offspring;\n instr. त॑ना (तना॑) adv. uninterruptedly,\ncontinually.", "gloss_language": "en"}, {"gloss": "3 †तन् तन्यति roar.", "gloss_language": "en"}]}], "tana": [{"id": "tana", "headword": "तन", "headword_slp1": "tana", "fold": "tana", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑न n. आ f. offspring, child.", "gloss_language": "en"}], "synonyms": ["तनः"], "synonyms_slp1": ["tanaH"]}, {"id": "tAna", "headword": "तान", "headword_slp1": "tAna", "fold": "tana", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तान m. thread, fibre;\n n. expanse.", "gloss_language": "en"}], "synonyms": ["तानं", "तानः"], "synonyms_slp1": ["tAnaM", "tAnaH"]}], "tanaya": [{"id": "tanaya", "headword": "तनय", "headword_slp1": "tanaya", "fold": "tanaya", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑नय a. propagating a race or belonging to a family. m.\nson (du. also son and daughter);\n f. तनया daughter;\n n. posterity,\noffspring, child, descendant.", "gloss_language": "en"}], "synonyms": ["तनयः"], "synonyms_slp1": ["tanayaH"]}], "tanayitnu": [{"id": "tanayitnu", "headword": "तनयित्नु", "headword_slp1": "tanayitnu", "fold": "tanayitnu", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "तनयित्नु॑ a. roaring, thundering.", "gloss_language": "en"}]}], "tanas": [{"id": "tanas", "headword": "तनस्", "headword_slp1": "tanas", "fold": "tanas", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑नस् n. posterity, offspring.", "gloss_language": "en"}]}], "taniman": [{"id": "taniman", "headword": "तनिमन्", "headword_slp1": "taniman", "fold": "taniman", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑निमन् m. thinness, weakness;\n n. the liver.", "gloss_language": "en"}]}], "tanisWa": [{"id": "tanizWa", "headword": "तनिष्ठ", "headword_slp1": "tanizWa", "fold": "tanisWa", "headword_language": "sa", "source": "capeller-sanskrit-english", "senses": [{"gloss": "त॑निष्ठ superl. & compar. to seq. तनु॑ (