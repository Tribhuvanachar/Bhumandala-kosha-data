{"moGa": [{"id": "moGa", "headword": "मोघ", "headword_slp1": "moGa", "fold": "moGa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मोघ [mōgha], a. [मुह्-घ अच् वा कुत्वम्]", "gloss_language": "en"}, {"gloss": "Vain, useless, fruitless, unprofitable, unsuccessful; याच्ञा मोघा वरमधिगुणे नाधमे लब्धकामा Me.6; मोघवृत्ति कलभस्य चेष्टितम् R.11.39;14.65; मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः Bg.9.12.", "gloss_language": "en"}, {"gloss": "Aimless, purposeless, indefinite.", "gloss_language": "en"}, {"gloss": "Left, abandoned.", "gloss_language": "en"}, {"gloss": "Idle.-घः A fence, an enclosure, a hedge. -घा The trumpet flower. -घम् ind. In vain, to no purpose, uselessly.-Comp. -कर्मन् a. engaging in useless rites. -पुष्पा a barren woman.", "gloss_language": "en"}], "synonyms": ["mogha"], "synonyms_slp1": ["mogha"]}], "moGayate": [{"id": "moGAyate", "headword": "मोघायते", "headword_slp1": "moGAyate", "fold": "moGayate", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मोघायते [mōghāyatē], Den. Ā. To become useless or insignificant.", "gloss_language": "en"}], "synonyms": ["moghaayate", "moghāyate"], "synonyms_slp1": ["moghaayate", "moghāyate"]}], "moGikf": [{"id": "moGIkf", "headword": "मोघीकृ", "headword_slp1": "moGIkf", "fold": "moGikf", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मोघीकृ [mōghīkṛ], 8 U. To render useless, frustrate.", "gloss_language": "en"}], "synonyms": ["moghiikR", "moghīkṛ"], "synonyms_slp1": ["moghiikR", "moghīkṛ"]}], "moGoliH": [{"id": "moGoliH", "headword": "मोघोलिः", "headword_slp1": "moGoliH", "fold": "moGoliH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मोघोलिः [mōghōliḥ], A hedge, fence.", "gloss_language": "en"}], "synonyms": ["mogholi", "mogholiH", "mogholiḥ", "मोघोलि"], "synonyms_slp1": ["mogholi", "mogholiH", "mogholiḥ", "moGoli"]}]}