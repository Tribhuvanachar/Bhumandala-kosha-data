_slp1": ["laTabha", "laṭabha"]}], "lawaha": [{"id": "lawaha", "headword": "लटह", "headword_slp1": "lawaha", "fold": "lawaha", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "लटह [laṭaha] लडह [laḍaha], लडह a. Beautiful, handsome (a Prākṛita word); see लटभ.", "gloss_language": "en"}], "synonyms": ["laTaha", "laṭaha"], "synonyms_slp1": ["laTaha", "laṭaha"]}], "law": [{"id": "law", "headword": "लट्", "headword_slp1": "law", "fold": "law", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "लट् [laṭ], 1 P. (लटति) To be a child.", "gloss_language": "en"}, {"gloss": "To act like a child.", "gloss_language": "en"}, {"gloss": "To talk like a child, prattle.", "gloss_language": "en"}, {"gloss": "To cry.", "gloss_language": "en"}, {"gloss": "लट् [laṭ], A technical term used by Pāṇdenote the Present tense or its terminations.", "gloss_language": "en"}], "synonyms": ["laT", "laṭ"], "synonyms_slp1": ["laT", "laṭ"]}], "lawvaH": [{"id": "lawvaH", "headword": "लट्वः", "headword_slp1": "lawvaH", "fold": "lawvaH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "लट्वः [laṭvḥ], [लटेः क्वन् Uṇ.1.14]", "gloss_language": "en"}, {"gloss": "A horse.", "gloss_language": "en"}, {"gloss": "A dancing boy.", "gloss_language": "en"}, {"gloss": "N. of a Rāga in music.", "gloss_language": "en"}, {"gloss": "N. of a caste.", "gloss_language": "en"}, {"gloss": "ट्वा A kind of bird.", "gloss_language": "en"}, {"gloss": "A curl on the forehead.", "gloss_language": "en"}, {"gloss": "A sparrow.", "gloss_language": "en"}, {"gloss": "A kind of musical instrument.", "gloss_language": "en"}, {"gloss": "A game.", "gloss_language": "en"}, {"gloss": "Safflower.", "gloss_language": "en"}, {"gloss": "An unchaste woman.", "gloss_language": "en"}], "synonyms": ["laTva", "laTvaH", "laṭva", "laṭvaḥ", "लट्व"], "synonyms_slp1": ["laTva", "laTvaH", "laṭva", "laṭvaḥ", "lawva"]}], "lawvaka": [{"id": "lawvAkA", "headword": "लट्वाका", "headword_slp1": "lawvAkA", "f