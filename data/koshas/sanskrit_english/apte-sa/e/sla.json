{"slaksRa": [{"id": "SlakzRa", "headword": "श्लक्ष्ण", "headword_slp1": "SlakzRa", "fold": "slaksRa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लक्ष्ण [ślakṣṇa], a. [श्लिष्-क्स्न नि˚ Uṇ.3.19]", "gloss_language": "en"}, {"gloss": "Soft, gentle, mild, bland (as words &c.); उवाच वचनं श्लक्ष्णं भूतभावनम- व्ययम् Mb.1.7.19.", "gloss_language": "en"}, {"gloss": "Smooth, polished; यस्यामति- श्लक्ष्णतया गृहेषु विधातुमालेख्यमशक्नुवन्तः Śi.3.46; शाल्मली- फलके श्लक्ष्णे नेनिज्यान्नेजकः शनैः Ms.8.396.", "gloss_language": "en"}, {"gloss": "Small, fine, thin, delicate; श्लक्ष्णं यत् परिहितमेतयोः किलान्तर्धानार्थं तदुदकसेकसक्तमूर्वोः Śi.8.65.", "gloss_language": "en"}, {"gloss": "Beautiful, charming.", "gloss_language": "en"}, {"gloss": "Candid, honest, frank. -Comp. त्वच् m. Bauhinia Tomentosa (Mar. आपटा). -पत्रकः ebony. -पिष्ट a. ground fine. -वाच् kindly speaking.", "gloss_language": "en"}], "synonyms": ["shlaxNa", "ślakṣṇa"], "synonyms_slp1": ["shlaxNa", "ślakṣṇa"]}], "slaksRaka": [{"id": "SlakzRaka", "headword": "श्लक्ष्णक", "headword_slp1": "SlakzRaka", "fold": "slaksRaka", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लक्ष्णक [ślakṣṇaka], a.", "gloss_language": "en"}, {"gloss": "Smooth, soft.", "gloss_language": "en"}, {"gloss": "Beautiful, charming. -कम् The Arecanut.", "gloss_language": "en"}], "synonyms": ["shlaxNaka", "ślakṣṇaka"], "synonyms_slp1": ["shlaxNaka", "ślakṣṇaka"]}], "slaNk": [{"id": "SlaNk", "headword": "श्लङ्क्", "headword_slp1": "SlaNk", "fold": "slaNk", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लङ्क् [ślaṅk], 1 Ā. (श्लङ्कते) To go, move.", "gloss_language": "en"}], "synonyms": ["shlank", "ślaṅk"], "synonyms_slp1": ["shlank", "ślaṅk"]}], "slaNg": [{"id": "SlaNg", "headword": "श्लङ्ग्", "headword_slp1": "SlaNg", "fold": "slaNg", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लङ्ग् [ślaṅg], 1 Ā. (श्लङ्गते) To go, move.", "gloss_language": "en"}], "synonyms": ["shlang", "ślaṅg"], "synonyms_slp1": ["shlang", "ślaṅg"]}], "slaTa": [{"id": "SlaTa", "headword": "श्लथ", "headword_slp1": "SlaTa", "fold": "slaTa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लथ [ślatha], a.", "gloss_language": "en"}, {"gloss": "Untied, unfastened.", "gloss_language": "en"}, {"gloss": "Loose, relaxed, loosened, slipped off; वृन्ताच्छ्लथं हरति पुष्पमनोकहानाम् R.5. 69;19.26.", "gloss_language": "en"}, {"gloss": "Dishevelled (as hair). -Comp. -उद्यमa. relaxing one's efforts. -बन्धनम् having the muscles relaxed; Ṛs. -लम्बिन् a. hanging loosely down; श्लथलम्बिनीर्जटाः Ku.5.47.", "gloss_language": "en"}], "synonyms": ["shlatha", "ślatha"], "synonyms_slp1": ["shlatha", "ślatha"]}], "slaT": [{"id": "SlaT", "headword": "श्लथ्", "headword_slp1": "SlaT", "fold": "slaT", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लथ् [ślath], 1 P. (श्लथति)", "gloss_language": "en"}, {"gloss": "To be loose or slackened; श्लथद्दुकूलं कबरीं च विच्युताम् Bhāg.8.12.21.", "gloss_language": "en"}, {"gloss": "To be weak or infirm.", "gloss_language": "en"}, {"gloss": "To hurt, kill. -Caus. (श्लथयति-ते) To slacken, loosen, relax (fig. also); श्लथयितुं क्षणमक्षमताङ्गना न सहसा सहसा कृतवेपथुः Śi.6.57; परित्राणस्नेहः श्लथयितुमशक्यः खलु यथा G. L.37.", "gloss_language": "en"}], "synonyms": ["shlath", "ślath"], "synonyms_slp1": ["shlath", "ślath"]}], "slaK": [{"id": "SlAK", "headword": "श्लाख्", "headword_slp1": "SlAK", "fold": "slaK", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाख् [ślākh], 1 P. (श्लाखति) To pervade, penetrate.", "gloss_language": "en"}], "synonyms": ["shlaakh", "ślākh"], "synonyms_slp1": ["shlaakh", "ślākh"]}], "slaGanam": [{"id": "SlAGanam", "headword": "श्लाघनम्", "headword_slp1": "SlAGanam", "fold": "slaGanam", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाघनम् [ślāghanam], [श्लाघ्-ल्युट्]", "gloss_language": "en"}, {"gloss": "Praising, eulogizing.", "gloss_language": "en"}, {"gloss": "Flattering. a. Boasting, a boaster; Mb.5.", "gloss_language": "en"}], "synonyms": ["shlaaghana", "shlaaghanam", "ślāghana", "ślāghanam", "श्लाघन"], "synonyms_slp1": ["shlaaghana", "shlaaghanam", "ślāghana", "ślāghanam", "SlAGana"]}], "slaGa": [{"id": "SlAGA", "headword": "श्लाघा", "headword_slp1": "SlAGA", "fold": "slaGa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाघा [ślāghā], [श्लाघ्-अ]", "gloss_language": "en"}, {"gloss": "Praise, eulogy, commendation; कर्णजयद्रथयोर्वा कात्र श्लाघा Ve.2.", "gloss_language": "en"}, {"gloss": "Self-praise, boast; हते जरति गाङ्गेये पुरस्कृत्य शिखण्डिनम् । या श्लाघा पाण्डुपुत्राणां सैवास्माकं भविष्यति ॥ Ve.2.4.", "gloss_language": "en"}, {"gloss": "Flattery.", "gloss_language": "en"}, {"gloss": "Service.", "gloss_language": "en"}, {"gloss": "Wish, desire.", "gloss_language": "en"}, {"gloss": "Pleasure, delight in anything.-Comp. -विपर्ययः absence of boasting; त्यागे श्लाघाविपर्ययः R.1.22.", "gloss_language": "en"}], "synonyms": ["shlaaghaa", "ślāghā"], "synonyms_slp1": ["shlaaghaa", "ślāghā"]}], "slaGita": [{"id": "SlAGita", "headword": "श्लाघित", "headword_slp1": "SlAGita", "fold": "slaGita", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाघित [ślāghita], p. p. Praised, eulogized, commended.", "gloss_language": "en"}], "synonyms": ["shlaaghita", "ślāghita"], "synonyms_slp1": ["shlaaghita", "ślāghita"]}], "slaGin": [{"id": "SlAGin", "headword": "श्लाघिन्", "headword_slp1": "SlAGin", "fold": "slaGin", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाघिन् [ślāghin], a.", "gloss_language": "en"}, {"gloss": "Haughty; अभिगर्जन्ति हरयः श्लाघिनः पर- शङ्कया Bhāg.8.2.6.", "gloss_language": "en"}, {"gloss": "Proud, boasting.", "gloss_language": "en"}, {"gloss": "Celebrated, famous.", "gloss_language": "en"}], "synonyms": ["shlaaghin", "ślāghin"], "synonyms_slp1": ["shlaaghin", "ślāghin"]}], "slaG": [{"id": "SlAG", "headword": "श्लाघ्", "headword_slp1": "SlAG", "fold": "slaG", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाघ् [ślāgh], 1 Ā. (श्लाघते) To praise, extol, commend, applaud; शिरसा श्लाघते पुर्वं (गुणं) परं (दोषं) कण्ठे नियच्छति Subhāṣ.; यथैव श्लाध्यते गङ्गा पादेन परमेष्ठिनः Ku.6.7 (some read श्लाघते for श्लाघ्यते and give it the next sense).", "gloss_language": "en"}, {"gloss": "To boast of, be proud of; श्लाघिष्ये केन को बन्धून्नेष्यत्युन्नति- मुन्नतः Bk.16.4.", "gloss_language": "en"}, {"gloss": "To flatter, coax (with dat.); गोपी कृष्णाय श्लाघते Sk.; श्लाघमानः परस्त्रीभ्यस्तत्रागाद्राक्षसाधिपः Bk.8.73.", "gloss_language": "en"}], "synonyms": ["shlaagh", "ślāgh"], "synonyms_slp1": ["shlaagh", "ślāgh"]}], "slaGya": [{"id": "SlAGya", "headword": "श्लाघ्य", "headword_slp1": "SlAGya", "fold": "slaGya", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "श्लाघ्य [ślāghya], [श्लाघ्-ण्यत्] Praised, praiseworthy; श्लाघ्यान्वयेति नयनोत्सवकारिणीति Māl.6.17; U.4.9,13.", "gloss_language": "en"}, {"gloss": "Respectable, venerable.", "gloss_language": "en"}, {"gloss": "Laudable, commendable.", "gloss_language": "en"}], "synonyms": ["shlaaghya", "ślāghya"], "synonyms_slp1": ["shlaaghya", "ślāghya"]}]}