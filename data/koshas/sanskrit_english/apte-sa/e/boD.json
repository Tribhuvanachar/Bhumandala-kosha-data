using.", "gloss_language": "en"}, {"gloss": "कः A spy.", "gloss_language": "en"}, {"gloss": "A teacher, instructor.", "gloss_language": "en"}, {"gloss": "A minstrel, bard.", "gloss_language": "en"}], "synonyms": ["bodhaka"], "synonyms_slp1": ["bodhaka"]}], "boDatas": [{"id": "boDatas", "headword": "बोधतस्", "headword_slp1": "boDatas", "fold": "boDatas", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "बोधतस् [bōdhatas], ind. Through wisdom or understanding.", "gloss_language": "en"}], "synonyms": ["bodhatas"], "synonyms_slp1": ["bodhatas"]}], "boDana": [{"id": "boDana", "headword": "बोधन", "headword_slp1": "boDana", "fold": "boDana", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "बोधन [bōdhana], a. [बुध्-णिच् ल्यु-ल्युट् वा]", "gloss_language": "en"}, {"gloss": "Informing, acquainting.", "gloss_language": "en"}, {"gloss": "Explaining, indicating.", "gloss_language": "en"}, {"gloss": "Arousing, waking.", "gloss_language": "en"}, {"gloss": "Kindling, inflaming. -नः The planet Mercury (बुधः); बुध इव शिशिरांशोर्बोधनस्येव देवः V.5.21.", "gloss_language": "en"}, {"gloss": "नम् Informing, teaching, instruction, giving a knowledge of; भयरुषोश्च तदिङ्गितबोधनम् R.9.49.", "gloss_language": "en"}, {"gloss": "Denoting, signifying.", "gloss_language": "en"}, {"gloss": "Arousing, awakening; समयेन तेन चिरसुप्तमनोभवबोधनं सममबोधिषत Śi.9.24.", "gloss_language": "en"}, {"gloss": "Observing, perceiving.", "gloss_language": "en"}, {"gloss": "Waking, being awake.", "gloss_language": "en"}, {"gloss": "Making attentive.", "gloss_language": "en"}, {"gloss": "Burning incence.", "gloss_language": "en"}, {"gloss": "नी The eleventh day in the bright half of Kārtika when Viṣṇu rises from his four months' sleep; शयनीबोधनीमध्ये या कृष्णैकादशी भवेत् । सैवोपोष्या गृहस्थेन नान्या कृष्णा कदाचन Tithyādi.", "gloss_language": "en"}, {"gloss": "Long pepper.", "gloss_language": "en"}, {"gloss": "Understanding, knowledge.", "gloss_language": "en"}], "synonyms": ["b