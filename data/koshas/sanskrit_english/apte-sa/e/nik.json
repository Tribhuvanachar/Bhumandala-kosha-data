age": "en"}, {"gloss": "A streak or line of gold made on a touchstone; कनकनिकषरुचिशुचिवसनेन श्वसिति न सा परिजनहसनेन Gīt. 7.6; कनकनिकषस्निग्धा विद्युत् प्रिया न ममोर्वशी V.4.1;5.19.-Comp. उपलः, -ग्रावन् m., -पाषाणः a touch-stone, whetstone; तत्प्रेमहेमनिकषोपलतां तनोति Gīt.11; तत्त्वनिकषग्रावा तु तेषां विपद् H.1.183.2.79.", "gloss_language": "en"}, {"gloss": "निकषणः (णम्) the touch-stone; य एकः शूराणां गुरु- समरकण्डूनिकषणः Ve.3.16.", "gloss_language": "en"}, {"gloss": "Rubbing off.", "gloss_language": "en"}], "synonyms": ["nikarShaNa", "nikarṣaṇa"], "synonyms_slp1": ["nikarShaNa", "nikarṣaṇa"]}], "nikarsaRam": [{"id": "nikarzaRam", "headword": "निकर्षणम्", "headword_slp1": "nikarzaRam", "fold": "nikarsaRam", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "निकर्षणम् [nikarṣaṇam], 1 An open space for recreation, or a playground in or near a town.", "gloss_language": "en"}, {"gloss": "A court at the entrance of a house.", "gloss_language": "en"}, {"gloss": "Neighbourhood.", "gloss_language": "en"}, {"gloss": "An uncultivated or unploughed plot of ground.", "gloss_language": "en"}], "synonyms": ["nikarShaNa", "nikarShaNam", "nikarṣaṇa", "nikarṣaṇam", "निकर्षण"], "synonyms_slp1": ["nikarShaNa", "nikarShaNam", "nikarṣaṇa", "nikarṣaṇam", "nikarzaRa"]}], "nikasa": [{"id": "nikazA", "headword": "निकषा", "headword_slp1": "nikazA", "fold": "nikasa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "निकषा [nikaṣā], N. of the mother of Rāvaṇa or of imps in general. -ind. Near, hard, close by, at hand (with acc.); निकषा सौधभित्तिम् Dk.; विलङ्घ्य लङ्कां निकषा हनिष्यति Śi.1.68. -Comp. -आत्मजः a demon.", "gloss_language": "en"}], "synonyms": ["nikaShaa", "nikaṣā"], "synonyms_slp1": ["nikaShaa", "nikaṣā"]}, {"id": "nIkASa", "headword": "नीकाश", "headword_slp1": "nIkASa", "fold": "nikasa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "नीकाश [nīkāśa], a. See निकाश; resembling; आकर्णमुल्लसितमम्बु विकासिकाशनीकाशमाप समतां सित