{"jaqa": [{"id": "jaqa", "headword": "जड", "headword_slp1": "jaqa", "fold": "jaqa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "जड [jaḍa], a. [जलति घनीभवति जल् अच् लस्य डः Tv.]", "gloss_language": "en"}, {"gloss": "Cold, frigid, chilly; Māl.9.13; U.6.13.", "gloss_language": "en"}, {"gloss": "Dull, paralysed, motionless, benumbed; चिन्ताजडं दर्शनम् Ś.4.5; U.3.41; 6.28;6.39; परामृशन् हर्षजडेन पाणिना R.3.68;2.42.", "gloss_language": "en"}, {"gloss": "Dull, senseless, stupid, irrational, dull-witted; जडा- नन्धान् पङ्गून ... त्रातुम् G. L.15, so जडधी, जडमति &c. Y.2. 25; Ms.2.11; जडबुद्धिः, जडप्रकृतिः, Ratn.2 (between verses 12 and 13); also जडाशयः Ks.6.58,132.", "gloss_language": "en"}, {"gloss": "Dulled made senseless or apathetic, devoid of appreciation or taste; वेदाभ्यासजडः कथं नु विषयव्यावृत्त- कौतूहलः V.1.9.", "gloss_language": "en"}, {"gloss": "Stunning, benumbing, stupefying.", "gloss_language": "en"}, {"gloss": "Dumb.", "gloss_language": "en"}, {"gloss": "Unable to learn the Vedas (Dāyabhāga).", "gloss_language": "en"}, {"gloss": "डः Cold, frost, winter.", "gloss_language": "en"}, {"gloss": "Idiocy, stupidity.", "gloss_language": "en"}, {"gloss": "Dulness, apathy, sluggishness.", "gloss_language": "en"}, {"gloss": "डम् Water.", "gloss_language": "en"}, {"gloss": "Lead.-Comp. -क्रिय a. slow, dilatory.", "gloss_language": "en"}, {"gloss": "भरतः an idiot.", "gloss_language": "en"}, {"gloss": "N. of a man simulating stupidity; Jābāla Up.", "gloss_language": "en"}], "synonyms": ["jaDa", "jaḍa"], "synonyms_slp1": ["jaDa", "jaḍa"]}], "jaqata": [{"id": "jaqatA", "headword": "जडता", "headword_slp1": "jaqatA", "fold": "jaqata", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "जडता [jaḍatā] त्वम् [tvam], त्वम् 1 Dulness, aversion to work, slothfulness.", "gloss_language": "en"}, {"gloss": "Ignorance, stupidity; Pt.1.", "gloss_language": "en"}, {"gloss": "(In Rhet.) Dulness, regarded as one of the 33 subordinate feelings; S. D.