anguage": "en"}, {"gloss": "Fresh butter.", "gloss_language": "en"}, {"gloss": "Gold.", "gloss_language": "en"}, {"gloss": "Clearness of the eyes.", "gloss_language": "en"}, {"gloss": "A shining or luminous body, light; ऋते कृशानोर्न हि मन्त्रपूतमर्हन्ति तेजांस्यपराणि हव्यम् Ku.1.51; Ś.4.2.", "gloss_language": "en"}, {"gloss": "The heating and strengthening faculty of the human frame seated in the bile (पित्त).", "gloss_language": "en"}, {"gloss": "The brain.", "gloss_language": "en"}, {"gloss": "Violence, fierceness.", "gloss_language": "en"}, {"gloss": "Impatience.", "gloss_language": "en"}, {"gloss": "Anger; मित्रैः सह विरोधं च प्राप्नुते तेजसा वृतः Md.3.28.18.", "gloss_language": "en"}, {"gloss": "The sun; उपप्लवांस्तथा घोरान् शशिनस्तेजसस्तथा Mb.12. 31.36. -Comp. -कर a.", "gloss_language": "en"}, {"gloss": "illuminating.", "gloss_language": "en"}, {"gloss": "granting vital power or strength. -पदम् a mark of dignity; तेजःपदं मणिमयं च हृतं शिरोभ्यः Bhāg.1.15.14. -बीजम् marrow.", "gloss_language": "en"}, {"gloss": "भङ्गः disgrace, destruction of dignity.", "gloss_language": "en"}, {"gloss": "depression, discouragement. -भीरः f. shadow.-मण्डलम् a halo of light; सर्वा एतस्मिंस्तेजोमण्डल एकीभवन्ति Praśna. Up.4.2. -मात्रा sense-organ; स एतास्तेजोमात्राः समभ्याददानो हृदयमेवान्ववक्रामति Bṛi. Up.4.4.1. -मूर्तिः the sun; Ms.3.93.", "gloss_language": "en"}, {"gloss": "रूपम् the Supreme Spirit, Brahman.", "gloss_language": "en"}, {"gloss": "the nature of light.", "gloss_language": "en"}, {"gloss": "वृत्तम् noble behaviour; Ms.9.33.", "gloss_language": "en"}, {"gloss": "superior power or lustre.", "gloss_language": "en"}], "synonyms": ["tejas"], "synonyms_slp1": ["tejas"]}], "tejasvat": [{"id": "tejasvat", "headword": "तेजस्वत्", "headword_slp1": "tejasvat", "fold": "tejasvat", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "तेजस्वत् [tējasvat] तेजोवत् [tējōvat], तेजोवत् a.", "gloss_language": "en"}, {"gloss": "Bright, brilliant, splendid.", "gloss_langu