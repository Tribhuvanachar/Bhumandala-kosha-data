{"gahana": [{"id": "gahana", "headword": "गहन", "headword_slp1": "gahana", "fold": "gahana", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "गहन [gahana], a.", "gloss_language": "en"}, {"gloss": "Deep, dense, thick; वनान्निष्क्रम्य गहनाद्बहवः कुरुसैनिकाः Mb.4.67.2.", "gloss_language": "en"}, {"gloss": "Impervious, impenetrable, impassable, inaccessible.", "gloss_language": "en"}, {"gloss": "Hard to be understood, inexplicable, mysterious; सेवाधर्मः परमगहनो योगिनामप्यगम्यः Pt.1.11,285; Bh.2.58; गहना कर्मणो गतिः Bg.4.17; Śānti.1.8.", "gloss_language": "en"}, {"gloss": "Grave, dignified; भूम्ना रसानां गहनाः प्रयोगाः Māl.1.4.", "gloss_language": "en"}, {"gloss": "Impassioned, replete with love, strong; क्व च नु गहनाः कौतुकरसाः U.6.33.", "gloss_language": "en"}, {"gloss": "Hard, difficult, causing pain or trouble; गहनसंसारः Śānti.3.15; U.7.6. (v. l.).", "gloss_language": "en"}, {"gloss": "Deepened, intensified; महामोहगहनः (विकारः) Māl.1.3.", "gloss_language": "en"}, {"gloss": "नम् An abyss, depth; अम्भः किमासीद्गहनं गभीरम् Rv.1.129.1.", "gloss_language": "en"}, {"gloss": "A wood, thicket, deep or impenetrable forest; यदनुगमनाय निशि गहनमपि शीलितम् Gīt.7; Bv.1.25.", "gloss_language": "en"}, {"gloss": "A hiding-place.", "gloss_language": "en"}, {"gloss": "A cave.", "gloss_language": "en"}, {"gloss": "Pain, distress.", "gloss_language": "en"}, {"gloss": "An ornament.", "gloss_language": "en"}, {"gloss": "Water.", "gloss_language": "en"}, {"gloss": "An inaccessible place; धिष्ण्यानामस्म्यहं मेरुर्गहनानां हिमालयः Bhāg.11.16.21. -नः The Supreme Being.", "gloss_language": "en"}], "synonyms": ["gahana"], "synonyms_slp1": ["gahana"]}], "gahiya": [{"id": "gahIya", "headword": "गहीय", "headword_slp1": "gahIya", "fold": "gahiya", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "गहीय [gahīya], a.", "gloss_language": "en"}, {"gloss": "Relating to a cave or thicket.", "gloss_language": "en"}], "synonyms": ["gahiiya", "gahīya"], "synonyms_slp1":