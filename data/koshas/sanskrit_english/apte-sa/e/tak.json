ss_language": "en"}, {"gloss": "N. of the architect of the gods.", "gloss_language": "en"}, {"gloss": "N. of one of the principal Nāgas or serpents of the Pātāla, son of Kaśyapa and Kadru (saved at the intercession of the sage Āstika from being burnt down in the serpent-sacrifice performed by king Janamejaya, in which many others of his race were burnt down to ashes).", "gloss_language": "en"}], "synonyms": ["takṣaka", "takṣakaḥ", "taxaka", "taxakaH", "तक्षक"], "synonyms_slp1": ["takṣaka", "takṣakaḥ", "taxaka", "taxakaH", "takzaka"]}], "taksaRam": [{"id": "takzaRam", "headword": "तक्षणम्", "headword_slp1": "takzaRam", "fold": "taksaRam", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "तक्षणम् [takṣaṇam], (तक्ष् भावे-ल्युट्] Paring, cutting; दारवाणां च तक्षणम् Ms.5.115; Y.1 185. -णी A carpenter's adze.", "gloss_language": "en"}], "synonyms": ["takṣaṇa", "takṣaṇam", "taxaNa", "taxaNam", "तक्षण"], "synonyms_slp1": ["takṣaṇa", "takṣaṇam", "taxaNa", "taxaNam", "takzaRa"]}], "taksan": [{"id": "takzan", "headword": "तक्षन्", "headword_slp1": "takzan", "fold": "taksan", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "तक्षन् [takṣan], m. [तक्ष्-कनिन्]", "gloss_language": "en"}, {"gloss": "A carpenter, wood-cutter (whether by caste or profession); तक्षा रिष्टं रुतं भिषग् Rv.9.112.1; तक्षाणः पलगण्डाश्च ... Śiva. B.31.18; अताक्षा तक्षा K. P. 'one not a तक्षन् by caste is called तक्षन् when he acts like or follows the profession of a तक्षन् (carpenter); Śi.12.25.", "gloss_language": "en"}, {"gloss": "N. of the architect of the gods.", "gloss_language": "en"}], "synonyms": ["takṣan", "taxan"], "synonyms_slp1": ["takṣan", "taxan"]}], "taks": [{"id": "takz", "headword": "तक्ष्", "headword_slp1": "takz", "fold": "taks", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "तक्ष् [takṣ], 1, 5. P. (तक्षति, तक्ष्णोति, तष्ट)", "gloss_language": "en"}, {"gloss": "To chop, cut off, pare, chisel, slice, split; आत्मानं तक्षति ह्येष