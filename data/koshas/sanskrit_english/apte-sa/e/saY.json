"headword_slp1": "saYjIv", "fold": "saYjiv", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "संजीव् [sañjīv], 1 P.", "gloss_language": "en"}, {"gloss": "To live together.", "gloss_language": "en"}, {"gloss": "To live, exist (by any profession).", "gloss_language": "en"}, {"gloss": "To be restored to life. -Caus.", "gloss_language": "en"}, {"gloss": "To revive, restore or bring to life, reanimate; (इदं सर्वं चराचरम्) संजीवयति चाजस्रं प्रमापयति चाव्ययः Ms.1.57.", "gloss_language": "en"}, {"gloss": "To maintain, nourish.", "gloss_language": "en"}], "synonyms": ["saMjiiv", "sanjiiv", "sañjīv", "saṃjīv", "संजीव्"], "synonyms_slp1": ["saMjiiv", "sanjiiv", "sañjīv", "saṃjīv", "saMjIv"]}], "saYj": [{"id": "saYj", "headword": "सञ्ज्", "headword_slp1": "saYj", "fold": "saYj", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "सञ्ज् [sañj], 1 P. (सजति, सक्त; the स् of the root being changed to ष् after a preposition ending in इ or उ)", "gloss_language": "en"}, {"gloss": "To stick or adhere to, cling to; तुल्यगन्धिषु मत्तेभकटेषु फलरेणवः (ससञ्जुः) R.4.47.", "gloss_language": "en"}, {"gloss": "To go, move.", "gloss_language": "en"}, {"gloss": "To fasten.-Pass. (सज्यते)", "gloss_language": "en"}, {"gloss": "To be attached to, cling or adhere to.", "gloss_language": "en"}, {"gloss": "To linger, hesitate.", "gloss_language": "en"}], "synonyms": ["sanj", "sañj"], "synonyms_slp1": ["sanj", "sañj"]}], "saYjYa": [{"id": "saYjYa", "headword": "सञ्ज्ञ", "headword_slp1": "saYjYa", "fold": "saYjYa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "संज्ञ [sañjña], a.", "gloss_language": "en"}, {"gloss": "Knock-kneed.", "gloss_language": "en"}, {"gloss": "Being conscious.", "gloss_language": "en"}, {"gloss": "Named, called; see संज्ञा below. -ज्ञम् A yellow fragrant wood.", "gloss_language": "en"}], "synonyms": ["saMJNa", "sanjNJa", "sañjña", "saṃjña", "संज्ञ"], "synonyms_slp1": ["saMJNa", "sanjNJa", "sañjña", "saṃjña", "saMjYa"]}, {"id": "saYjYA", "headword": "सञ्ज्ञा", "headword_slp1": "saYjYA", "fold": "saYjYa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "संज्ञा [sañjñā], 9 Ā.", "gloss_language": "en"}, {"gloss": "To know, understand, be aware of.", "gloss_language": "en"}, {"gloss": "To recognize.", "gloss_language": "en"}, {"gloss": "To live in harmony, agree together (with acc. or instr.); पित्रा पितरं वा संजानीते Sk.", "gloss_language": "en"}, {"gloss": "To watch, be on the alert; संजानानान् परिहरन् रावणानुचरान् बहून् Bk.8.27.", "gloss_language": "en"}, {"gloss": "To accede or agree to.", "gloss_language": "en"}, {"gloss": "To remember, think of (Paras); मातुः मातरं वा संजानाति Sk.", "gloss_language": "en"}, {"gloss": "To direct, appoint. Caus.", "gloss_language": "en"}, {"gloss": "To inform.", "gloss_language": "en"}, {"gloss": "To appease, gratify, console.", "gloss_language": "en"}, {"gloss": "(a) To quiet, pacify (a sacrificial animal). (b) To kill.", "gloss_language": "en"}, {"gloss": "To command, enjoin.", "gloss_language": "en"}, {"gloss": "To animate.", "gloss_language": "en"}, {"gloss": "To make intelligible, cause to be understood, inform.", "gloss_language": "en"}, {"gloss": "To make a sign to (any one), communicate by signs.", "gloss_language": "en"}, {"gloss": "संज्ञा [sañjñā], 1 Consciousness, अकरुण पुनः संज्ञाव्याधिं विधाय किमीहसे Māl.9.42; रतिखेदसमुत्पन्ना निद्रा संज्ञाविपर्ययः Ku.6.44. संज्ञा लभ्, आपद् or प्रतिपद् 'to regain or recover one's consciousness, come to one's senses'.", "gloss_language": "en"}, {"gloss": "Knowledge, understanding; नायका मम सैन्यस्य संज्ञार्थं तान् व्रवीमि ते Bg.1.7; Mb.12.153.63.", "gloss_language": "en"}, {"gloss": "Intellect, mind; लोकतन्त्रं हि संज्ञाश्च सर्वमन्ने प्रतिष्ठितम् Mb.13.63.5.", "gloss_language": "en"}, {"gloss": "A hint, sign, token, gesture; मुखापिंतैकाङ्गुलिसंज्ञयैव मा चापलायेति गणान् व्यनैषीत् Ku.3.41; उपलभ्य ततश्च धर्मसंज्ञाम् Bu. Ch.5.21; Bhāg. 6.7.17.", "gloss_language": "en"}, {"gloss": "A name, designation, an appellation; oft. at the end of comp. in this sense; द्वन्द्वैर्विमुक्ताः सुखदुःखसंज्ञैः Bg.15.5.", "gloss_language": "en"}, {"gloss": "(In gram.) Any name or noun having a special meaning, a proper name.", "gloss_language": "en"}, {"gloss": "The technical name for an affix.", "gloss_language": "en"}, {"gloss": "The Gāyatrī Mantra; see गायत्री.", "gloss_language": "en"}, {"gloss": "A track, footstep.", "gloss_language": "en"}, {"gloss": "Direction.", "gloss_language": "en"}, {"gloss": "A technical term.", "gloss_language": "en"}, {"gloss": "N. of the daughter of Viśvakarman and wife of the sun, and mother of Yama, Yamī, and the two Aśvins. [A legend relates that संज्ञा on one occasion wished to go to her father's house and asked her husband's permission, which was not granted. Resolved to carry out her purpose, she created, by means of her superhuman power, a woman exactly like herself who was, as it were, her own shadow (and was therefore called Chhāyā), and putting her in her own place, went away without the knowledge of the sun. Chhāya bore to the sun three children (see छाया), and lived quite happily with him, so that when Saṁjñā returned, he would not admit her. Thus repudiated and disappointed, she assumed the form of a mare and roamed over the earth. The sun, however, in course of time, came to know the real state of things, and discovered that his wife had assumed the form of a mare. He accordingly assumed the form of a horse, and was united with his wife, who bore to him, two sonsthe Aśvinīkumāras or Aśvins q. v.]-Comp. -अधिकारः a leading rule which gives a particular name to the rules falling under it, and which exercises influence over them. -विपर्ययः loss of consciousness; रतिखेदसमुत्पन्ना निद्रा संज्ञाविपर्ययः Ku.6.44. -विषयः an epithet, an attribute. -सुतः an epithet of Saturn.-सूत्रम् any Sūtra which teaches the meaning of a technical term.", "gloss_language": "en"}], "synonyms": ["saMJNaa", "sanjNJaa", "sañjñā", "saṃjñā", "संज्ञा"], "synonyms_slp1": ["saMJNaa", "sanjNJaa", "sañjñā", "saṃjñā", "saMjYA"]}], "saYjYaka": [{"id": "saYjYaka", "headword": "सञ्ज्ञक", "headword_slp1": "saYjYaka", "fold": "saYjYaka", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "संज्ञक [sañjñaka], a. Killing, destroying (नाशक); कदा वयं करिष्यामः संन्यासं दुःखसंज्ञकम् Mb.12.279.3.", "gloss_language": "en"}], "synonyms": ["saMJNaka", "sanjNJaka", "sañjñaka", "saṃjñaka", "संज्ञक"], "synonyms_slp1": ["saMJNaka", "sanjNJaka", "sañjñaka", "saṃjñaka", "saMjYaka"]}], "saYjYapanam": [{"id": "saYjYapanam", "headword": "सञ्ज्ञपनम्", "headword_slp1": "saYjYapanam", "fold": "saYjYapanam", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "संज्ञपनम् [sañjñapanam], 1 Killing; दृष्ट्वा संज्ञपनं योगं पशूनां स पतिर्मखे Bhāg.4.5.24.", "gloss_language": "en"}, {"gloss": "Deception, defrauding.", "gloss_language": "en"}], "synonyms": ["saMJNapana", "saMJNapanam", "sanjNJapana", "sanjNJapanam", "sañjñapana", "sañjñapanam", "saṃjñapana", "saṃjñapanam", "संज्ञपन", "संज्ञपनम्", "सञ्ज्ञपन"], "synonyms_slp1": ["saMJNapana", "saMJNapanam", "sanjNJapana", "sanjNJapanam", "sañjñapana", "sañjñapanam", "saṃjñapana", "saṃjñapanam", "saMjYapana", "saMjYapanam", "saYjYapana"]}, {"id": "saYjYApanam", "headword": "सञ्ज्ञापनम्", "headword_slp1": "saYjYApanam", "fold": "saYjYapanam", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "संज्ञापनम् [sañjñāpanam], 1 Informing.", "gloss_language": "en"}, {"gloss": "Teaching.", "gloss_language": "en"}, {"gloss": "Killing, slaughter.", "gloss_language": "en"}], "synonyms": ["saMJNaapana", "saMJNaapanam", "sanjNJaapana", "sanjNJaapanam", "sañjñāpana", "sañjñāpanam", "saṃjñāpana", "saṃjñāpanam", "संज्ञापन", "संज्ञापनम्", "सञ्ज्ञापन"], "synonyms_slp1": ["saMJNaapana", "saMJNaapanam", "sanjNJaapana", "sanjNJaapanam", "sañjñāpana", "sañjñāpanam", "saṃjñāpana", "saṃjñāpanam", "saMjYApana", "saMjYApanam", "saYjYApana"]}], "saYjYapita": [{"id": "saYjYapita", "he