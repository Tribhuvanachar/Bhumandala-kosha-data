_language": "en"}, {"gloss": "Distinguished, perceived, seen, discovered.", "gloss_language": "en"}, {"gloss": "Discernible by.", "gloss_language": "en"}, {"gloss": "Dismayed, perplexed, embarrassed, puzzled.", "gloss_language": "en"}, {"gloss": "Vexed, annoyed.", "gloss_language": "en"}, {"gloss": "Undistinguished.", "gloss_language": "en"}], "synonyms": ["vilakṣita", "vilaxita"], "synonyms_slp1": ["vilakṣita", "vilaxita"]}], "vilaks": [{"id": "vilakz", "headword": "विलक्ष्", "headword_slp1": "vilakz", "fold": "vilaks", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "विलक्ष् [vilakṣ], 1 U.", "gloss_language": "en"}, {"gloss": "To see, observe, perceive, notice.", "gloss_language": "en"}, {"gloss": "To characterize, distinguish.", "gloss_language": "en"}, {"gloss": "To be confused, be bewildered; निर्व्यापारविलक्षितानि सान्त्वय बलानि U.6; see विलक्ष below.", "gloss_language": "en"}], "synonyms": ["vilakṣ", "vilax"], "synonyms_slp1": ["vilakṣ", "vilax"]}], "vilag": [{"id": "vilag", "headword": "विलग्", "headword_slp1": "vilag", "fold": "vilag", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "विलग् [vilag], 1 P. To stick or adhere to, cling to; केचिद्विलग्ना दशनान्तरेषु Bg.11.27.", "gloss_language": "en"}], "synonyms": ["vilag"], "synonyms_slp1": ["vilag"]}], "vilagna": [{"id": "vilagna", "headword": "विलग्न", "headword_slp1": "vilagna", "fold": "vilagna", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "विलग्न [vilagna], a.", "gloss_language": "en"}, {"gloss": "Clinging or sticking to, resting on, fastened on; आकुटिलपक्ष्मविलग्नम् Ś.7.25; Śi.9.2.", "gloss_language": "en"}, {"gloss": "Cast, fixed, directed; पुरोविलग्नैर्हरदृष्टिपातैः सुवर्णसूत्रैरिव कृष्यमाणः Ku. 7.5.", "gloss_language": "en"}, {"gloss": "Gone by, elapsed (as time).", "gloss_language": "en"}, {"gloss": "Thin, slender, delicate; मध्येन सा वेदिविलग्नमध्या Ku.1.39; V.4.37.", "gloss_language": "en"}, {"gloss": "Pendulous, flaccid (as breasts