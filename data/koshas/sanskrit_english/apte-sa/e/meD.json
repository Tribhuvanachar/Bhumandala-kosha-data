{"meDaH": [{"id": "meDaH", "headword": "मेधः", "headword_slp1": "meDaH", "fold": "meDaH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मेधः [mēdhḥ], 1 A sacrifice, as in नरमेध, अश्वमेध, एकविंशति- मेधान्ते Mb.14.29.18. (com. मेधो युद्धयज्ञः । 'यज्ञो वै मेधः' इति श्रुतेः ।).", "gloss_language": "en"}, {"gloss": "A sacrificial animal or victim.", "gloss_language": "en"}, {"gloss": "An offering, oblation.", "gloss_language": "en"}, {"gloss": "Ved. The juice of meat, broth.", "gloss_language": "en"}, {"gloss": "Ved. Sap, pith, essence. -Comp. -जः an epithet of Viṣṇu.", "gloss_language": "en"}], "synonyms": ["medha", "medhaH", "medhaḥ", "मेध"], "synonyms_slp1": ["medha", "medhaH", "medhaḥ", "meDa"]}], "meDa": [{"id": "meDA", "headword": "मेधा", "headword_slp1": "meDA", "fold": "meDa", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मेधा [mēdhā], [मेध्-अञ्] (changed to मेधस् in Bah. comp. when preceded by सु, दुस् and the negative particle अ)", "gloss_language": "en"}, {"gloss": "Retentive faculty, retentiveness (of memory); धी- र्धारणावती मेधा Ak.", "gloss_language": "en"}, {"gloss": "Intellect, intelligence in general; यत् सप्तान्नानि मेधया तपसाजनयत् पिता Bṛi. Up.1.5.1; Bg. 1.34; आयुष्मन्तं सुतं सूते यशोमेधासमन्वितम् Ms.3.263; Y. 3.173.", "gloss_language": "en"}, {"gloss": "A form of Sarasvathī.", "gloss_language": "en"}, {"gloss": "A sacrifice.", "gloss_language": "en"}, {"gloss": "Strength, power (Ved.). -Comp. -अतिथिः N. of a learned commentator on Manusmṛiti. -जननम् N. of a rite for producing mental and bodily strength.-जित् m. an epithet of Kātyāyana. -रुद्रः an epithet of Kālidāsa.", "gloss_language": "en"}], "synonyms": ["medhaa", "medhā"], "synonyms_slp1": ["medhaa", "medhā"]}], "meDavat": [{"id": "meDAvat", "headword": "मेधावत्", "headword_slp1": "meDAvat", "fold": "meDavat", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "मेधावत् [mēdhāvat], a. Wise, intelligent.", "gloss_language": "en"}], "s