{"stu": [{"id": "stu", "headword": "स्तु", "headword_slp1": "stu", "fold": "stu", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "स्तु [stu], 2 U. (स्तौति-स्तवीति, स्तुते-स्तुवीते; तुष्टाव-तुष्टुवे, अस्तावीत्- अस्तोष्ट, स्तोष्यति-ते, स्तोतुम्, स्तुत; desid. तुष्टूषति-ते; the स् of स्तु is changed to ष् after a preposition ending in इ or उ)", "gloss_language": "en"}, {"gloss": "To praise, laud, eulogize, extol, glorify, celebrate; किं निन्दाम्यथवा स्तवामि कथय क्षीरार्णव त्वामहम् Bv. 1.41; Mu.3.16; Bk.8.92;15.7.", "gloss_language": "en"}, {"gloss": "To celebrate or praise in song, to hymn, worship by hymns.", "gloss_language": "en"}, {"gloss": "To praise in ऋक् verses set to music; इह एतौ स्तौतिशंसतिशब्दौ समाने$पि स्तुत्यर्थत्वे व्यवस्थितविषयौ । प्रगीतेषु मन्त्रवाक्येषु स्तौति- शब्दः अप्रगीतेषु शंसतिशब्दः ŚB. on MS.7.2.17.", "gloss_language": "en"}], "synonyms": ["stu"], "synonyms_slp1": ["stu"]}], "stukaH": [{"id": "stukaH", "headword": "स्तुकः", "headword_slp1": "stukaH", "fold": "stukaH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "स्तुकः [stukḥ], A collection of hair, a knot or braid of hair.", "gloss_language": "en"}], "synonyms": ["stuka", "stukaH", "stukaḥ", "स्तुक"], "synonyms_slp1": ["stuka", "stukaH", "stukaḥ", "stuka"]}], "stuka": [{"id": "stukA", "headword": "स्तुका", "headword_slp1": "stukA", "fold": "stuka", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "स्तुका [stukā], 1 A knot or braid of hair.", "gloss_language": "en"}, {"gloss": "A bunch of curly hair between the horns of a bull.", "gloss_language": "en"}, {"gloss": "Hip; thigh.", "gloss_language": "en"}], "synonyms": ["stukaa", "stukā"], "synonyms_slp1": ["stukaa", "stukā"]}], "stuc": [{"id": "stuc", "headword": "स्तुच्", "headword_slp1": "stuc", "fold": "stuc", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "स्तुच् [stuc], 1 Ā. (स्तोचते)", "gloss_language": "en"}, {"gloss": "To be bright, to shine, be pellu