{"sEkya": [{"id": "SEkya", "headword": "शैक्य", "headword_slp1": "SEkya", "fold": "sEkya", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "शैक्य [śaikya], a.", "gloss_language": "en"}, {"gloss": "Suspended in a loop.", "gloss_language": "en"}, {"gloss": "Pointed, peaked; शैक्यां व्यालीमिवात्युग्रां वज्रकल्पामयोमयीम् Mb.9.11.51.", "gloss_language": "en"}, {"gloss": "क्यः A kind of sling (Mar. कावड, शिकें); धारयन्ति महीं द्यां च शैक्यो वागमृतं तथा Mb.12.342.17.", "gloss_language": "en"}, {"gloss": "A pot kept in such sling; शैक्यं रुक्मसहस्रस्य बहुरत्नविभूषितम् Mb.2.49.27 (see Nīlakaṇṭha com.). -अयसम् Damasked steel; शकदेवाय चिक्षेप सर्वशैक्यायसीं गदाम् Mb.6.54.24; शैक्यायसानि वर्माणि कांस्यानि च समन्ततः 7.119.42 (com. शैक्यायसानि शोणितायोमयानि).", "gloss_language": "en"}], "synonyms": ["shaikya", "śaikya"], "synonyms_slp1": ["shaikya", "śaikya"]}], "sEksaH": [{"id": "SEkzaH", "headword": "शैक्षः", "headword_slp1": "SEkzaH", "fold": "sEksaH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "शैक्षः [śaikṣḥ], [शिक्षां वेत्त्यधीते वा अण्]", "gloss_language": "en"}, {"gloss": "A student who studies Śikṣā or the science of pronunciation, one who has just entered upon the study of the Vedas.", "gloss_language": "en"}, {"gloss": "(Hence) A novice, tyro. -a. Well familiar with the studies or sciences; expert; Mb.6.97.28 (com. शैक्षं शस्त्रादिशिक्षा- संपन्नम्).", "gloss_language": "en"}], "synonyms": ["shaixa", "shaixaH", "śaikṣa", "śaikṣaḥ", "शैक्ष"], "synonyms_slp1": ["shaixa", "shaixaH", "śaikṣa", "śaikṣaḥ", "SEkza"]}], "sEksikaH": [{"id": "SEkzikaH", "headword": "शैक्षिकः", "headword_slp1": "SEkzikaH", "fold": "sEksikaH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "शैक्षिकः [śaikṣikḥ], One skilled in Śikṣā.", "gloss_language": "en"}], "synonyms": ["shaixika", "shaixikaH", "śaikṣika", "śaikṣikaḥ", "शैक्षिक"], "synonyms_slp1": ["shaixika", "shaixikaH", "śaikṣika", "śaikṣikaḥ", "SEkzika"]}], "sEksyam": [{"id