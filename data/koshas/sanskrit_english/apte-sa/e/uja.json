{"ujaya": [{"id": "ujjaya", "headword": "उज्जय", "headword_slp1": "ujjaya", "fold": "ujaya", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "उज्जय [ujjaya] यि [yi] नी [nī], (यि) नी N. of a city, the modern Ujjain in Mālvā, the capital of Vikramāditya. It is one of the seven sacred cities of the Hindus (cf. अवन्ति), and the first meridian of their geographers from which they calculate longitude; सौधोत्सङ्गप्रणयविमुखो मा स्म भूरुज्जयिन्याः Me.27.", "gloss_language": "en"}], "synonyms": ["ujjaya"], "synonyms_slp1": ["ujjaya"]}], "ujas": [{"id": "ujjas", "headword": "उज्जस्", "headword_slp1": "ujjas", "fold": "ujas", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "उज्जस् [ujjas], 4. P. Caus.", "gloss_language": "en"}, {"gloss": "To kill, destroy, extirpate (with gen.); बिडौजसोज्जासयितुं जगद् द्रुहाम् Śi.1.37. ... मन्योरुज्जा- सयात्मनः Bk.8.12.", "gloss_language": "en"}, {"gloss": "Cause to run away. सद्यस्तद् येदिलस्याप्यतुलमथोज्जासयित्वा जवेन Śiva. B.4.8.", "gloss_language": "en"}], "synonyms": ["ujjas"], "synonyms_slp1": ["ujjas"]}], "ujagara": [{"id": "ujjAgara", "headword": "उज्जागर", "headword_slp1": "ujjAgara", "fold": "ujagara", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "उज्जागर [ujjāgara], a. Excited, irritated.", "gloss_language": "en"}], "synonyms": ["ujjaagara", "ujjāgara"], "synonyms_slp1": ["ujjaagara", "ujjāgara"]}], "ujanakaH": [{"id": "ujjAnakaH", "headword": "उज्जानकः", "headword_slp1": "ujjAnakaH", "fold": "ujanakaH", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "उज्जानकः [ujjānakḥ], N. of a province in the North.", "gloss_language": "en"}], "synonyms": ["ujjaanaka", "ujjaanakaH", "ujjānaka", "ujjānakaḥ", "उज्जानक"], "synonyms_slp1": ["ujjaanaka", "ujjaanakaH", "ujjānaka", "ujjānakaḥ", "ujjAnaka"]}], "ujasanam": [{"id": "ujjAsanam", "headword": "उज्जासनम्", "headword_slp1": "ujjAsanam", "fold": "ujasanam", "headword_language": "sa", "source": "apte-sa", "sens