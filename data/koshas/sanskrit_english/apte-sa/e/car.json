adword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "चार्वाकः [cārvākḥ], [चारुः लोकसंमतो वाकोवाक्यं यस्य, पृषो˚ Tv.]", "gloss_language": "en"}, {"gloss": "N. of a sophistical philosopher (said to have been a pupil of Brihaspati), who propounded the grossest form of atheism or materialism (for a summary of the doctrines of Chārvāka; see Sarva. S.1.).", "gloss_language": "en"}, {"gloss": "A follower of the philosophy of Chārvākā चार्वाकाणामिवैषां हि भयं न परलोकतः Rāj. T.4.345.", "gloss_language": "en"}, {"gloss": "N. of a Rākṣasa described in the Mahābhārata, as a friend of Duryodhana and an enemy of the Pāndavas. [When Yudhiṣṭhira entered Hastināpura in triumph, he assumed the form of a Brāhmaṇa and reviled him and the assembled Brāhmaṇas, but he was soon detected, and the real Brāhmaṇas, filled with fury, are said to have killed him on the spot. He also tried to deceive Yudhiṣṭhira at the end of the great war by telling him that Bhīma was slain by Duryodhana; see Ve.6]. -Comp. -मतम्.", "gloss_language": "en"}], "synonyms": ["chaarvaaka", "chaarvaakaH", "cārvāka", "cārvākaḥ", "चार्वाक"], "synonyms_slp1": ["chaarvaaka", "chaarvaakaH", "cārvāka", "cārvākaḥ", "cArvAka"]}], "carvi": [{"id": "cArvI", "headword": "चार्वी", "headword_slp1": "cArvI", "fold": "carvi", "headword_language": "sa", "source": "apte-sa", "senses": [{"gloss": "चार्वी [cārvī], 1 A beautiful woman.", "gloss_language": "en"}, {"gloss": "Moonlight.", "gloss_language": "en"}, {"gloss": "Intelligence.", "gloss_language": "en"}, {"gloss": "Splendour, lustre, brilliancy.", "gloss_language": "en"}, {"gloss": "N. of the wife of Kubera.", "gloss_language": "en"}], "synonyms": ["chaarvii", "cārvī"], "synonyms_slp1": ["chaarvii", "cārvī"]}]}