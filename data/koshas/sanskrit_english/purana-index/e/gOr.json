{"gOra": [{"id": "gOra", "headword": "गौर", "headword_slp1": "gOra", "fold": "gOra", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--a वैकुण्ठ god. Br. II. ३६. ५१.", "gloss_language": "en"}, {"gloss": "(II)--a son of शुक and पीवरी. Br. III. 8. ९३; १०. ८१; M. १५. १०; वा. ७०. ८५; ७३. ३०.", "gloss_language": "en"}, {"gloss": "(III)--a Mt. of gold to the north of the कैलास; with हरिताल trees; celebrated for golden crests; at its foot was lake Bindusaras where भगीरथ was engaged in austerities. Here Indra performed a number of sacrifices. Br. II. १८. २४-8; M. १२१. २४; वा. ४७. २३-5.", "gloss_language": "en"}]}], "gOras": [{"id": "gOras", "headword": "गौरस्", "headword_slp1": "gOras", "fold": "gOras", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a पारशर branch. वा. ७०. ८७.", "gloss_language": "en"}]}], "gOragrivas": [{"id": "gOragrIvas", "headword": "गौरग्रीवस्", "headword_slp1": "gOragrIvas", "fold": "gOragrivas", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--आत्रेय gotrakaras. M. १९७. 2.", "gloss_language": "en"}]}], "gOrajinas": [{"id": "gOrajinas", "headword": "गौरजिनस्", "headword_slp1": "gOrajinas", "fold": "gOrajinas", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--आत्रेय gotrakaras. M. १९७. 2.", "gloss_language": "en"}]}], "gOraviti": [{"id": "gOravIti", "headword": "गौरवीति", "headword_slp1": "gOravIti", "fold": "gOraviti", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a sage not to have marriage alliances with Angiras and सङ्कृति. M. १९६. ३२.", "gloss_language": "en"}]}], "gOrika": [{"id": "gOrika", "headword": "गौरिक", "headword_slp1": "gOrika", "fold": "gOrika", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of गौरी and an emperor also called मान्धाता (s.v.). वा. ८८. ६६.", "gloss_language": "en"}]}], "gOri": [{"id": "gOrI", "headword": "गौरी", "headword_slp1": "gOrI", "fold": "gOri", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--is पार्वती;\n1: भा. X. ५३. २५; Br. II. २५. १८; वा. ४३. ३८; १०६. ५८; Vi. V. ३२. १२.\na शक्ति;\n2: Br. IV. ४४. ५८.\nthe goddess enshrined at कञ्य-kubja; Icon of, in a palace.\n3: M. १३. २९; ६०. १७; १५५. ३०; १९३. २४; २६९. ५४-5; २८५. 7.\n[page१-560+ २६]", "gloss_language": "en"}, {"gloss": "(II)--a daughter of Antinara; the wife of Yuva- नाश्व; cursed by her husband, became the river बाहुदा; mother of Gaurika मान्धातृ. Br. III. ६३. ६७; M. ४९. 8; वा. ८८. ६५-6.", "gloss_language": "en"}, {"gloss": "(III)--the wife of विराज;\n1: वा. २८. १२.\nson, सुधाम.\n2: Br. II. ११. १४.", "gloss_language": "en"}, {"gloss": "(V)--a daughter of रण्ति and mother of मान्- धात. वा. ९९. १३०.", "gloss_language": "en"}, {"gloss": "(VI)--a R. in क्रौञ्चद्वीप. Br. II. १९. ७५; M. १२२. ८८; वा. ४९. ६९; Vi. II. 4. ५५.", "gloss_language": "en"}]}, {"id": "gOri", "headword": "गौरि", "headword_slp1": "gOri", "fold": "gOri", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(IV)--good to marry; for a son of such marriage would purify twenty-one generations of his and six on his mother's side. वा. ८३. १२, ४४.", "gloss_language": "en"}]}], "gOrikalpa": [{"id": "gOrIkalpa", "headword": "गौरीकल्प", "headword_slp1": "gOrIkalpa", "fold": "gOrikalpa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--the २८थ् kalpa is so called. M. २९०. १०.", "gloss_language": "en"}]}], "gOritirTam": [{"id": "gOrItIrTam", "headword": "गौरीतीर्थम्", "headword_slp1": "gOrItIrTam", "fold": "gOritirTam", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--sacred to पितृस्. M. २२. ३१.", "gloss_language": "en"}]}], "gOrilokam": [{"id": "gOrIlokam", "headword": "गौरीलोकम्", "headword_slp1": "gOrIlokam", "fold": "gOrilokam", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--शिवलोकम् sacred to पार्वती. Br. III. ३२. 3; M. ६३. २८; १०१. १६.", "glos