{"guru": [{"id": "guru", "headword": "गुरु", "headword_slp1": "guru", "fold": "guru", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--a son of सङ्कृति. भा. XI. २१. 2.", "gloss_language": "en"}, {"gloss": "(II)--a son of Bhautya Manu. Br. IV. 1. ११४. वा. ११०. ५१. [page१-538+ ३३]", "gloss_language": "en"}, {"gloss": "(III)--devotion to, praised by Kaca; his daughter cannot be married by a pupil, as she stands in relation of a sister.\n1: M. २५. ६९; २६. 6-8, १२-16.\nGuru (शुश्रूष) service of the teacher pleases Hari. कृष्ण's discourse on service to guru, and his tribute to his teacher सान्दीपानि. It is said that guru's blessings make a man rise to his full stature.\n2: भा. X. ८०. २८-43.\nDifferent kinds of guru--महागुरु, आचार्य, देशीक and others.\n3: Br. IV. 8. 3-6.\nImplicit obedience to. Transgressing his orders leads one to be born an aerial spirit: fit to be honoured like a king and a god.\n4: Ib. ४३. ३७-59.", "gloss_language": "en"}, {"gloss": "(IV)--the planet बृहस्पति. M. ९३. १४.", "gloss_language": "en"}, {"gloss": "(V)--a sage. M. १९६. ४५.", "gloss_language": "en"}]}], "guruRqas": [{"id": "guruRqas", "headword": "गुरुण्डस्", "headword_slp1": "guruRqas", "fold": "guruRqas", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--ten of them were kings;\n1: भा. XII. 1. ३०.\nrule after तुषारस्, along with वृषलस्. These were mlecchas for ३११ years.\n2: Br. III. ७४. १७३ and 7; M. २७३. १९, २२-3.", "gloss_language": "en"}]}], "gurutalpaka": [{"id": "gurutalpaka", "headword": "गुरुतल्पक", "headword_slp1": "gurutalpaka", "fold": "gurutalpaka", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--defiler of the preceptor's bed; a heinous sin. वा. ६०. ७५; ७८. ३४; १०१. १५३; १०५. १३.", "gloss_language": "en"}]}], "gurudaksiRa": [{"id": "gurudakziRA", "headword": "गुरुदक्षिणा", "headword_slp1": "gurudakziRA", "fold": "gurudaksiRa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--the Preceptor's fee, offered by कृष्ण and राम;\n1: Vi. V. २१. २४.\nby केशिध्वज to खाण्डिक्य.\n2: Ib. VI. 6. ३९, ४३ and ४८.", "gloss_language": "en"}]}], "guruDi": [{"id": "guruDI", "headword": "गुरुधी", "headword_slp1": "guruDI", "fold": "guruDi", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of महायशस्. M. ४९. ३७. [page१-539+ ३१]", "gloss_language": "en"}]}], "gurupriti": [{"id": "guruprIti", "headword": "गुरुप्रीति", "headword_slp1": "guruprIti", "fold": "gurupriti", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of सङ्कृति. Vi. IV. १९. २२.", "gloss_language": "en"}]}], "guruvita": [{"id": "guruvIta", "headword": "गुरुवीत", "headword_slp1": "guruvIta", "fold": "guruvita", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a मन्त्रकृत्. M. १४५. १०२.", "gloss_language": "en"}]}], "guruvirya": [{"id": "guruvIrya", "headword": "गुरुवीर्य", "headword_slp1": "guruvIrya", "fold": "guruvirya", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of साङ्कृति. वा. ९९. १६०.", "gloss_language": "en"}]}], "gurusevi": [{"id": "gurusevi", "headword": "गुरुसेवि", "headword_slp1": "gurusevi", "fold": "gurusevi", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a वानर chief. Br. III. 7. २३६.", "gloss_language": "en"}]}], "gurvaksa": [{"id": "gurvakza", "headword": "गुर्वक्ष", "headword_slp1": "gurvakza", "fold": "gurvaksa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of Bali. M. 6. ११.", "gloss_language": "en"}]}]}