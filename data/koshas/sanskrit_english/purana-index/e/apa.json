oss": "--a son of ऊत्तानपाद and सूनृता. M. 4. ३५.", "gloss_language": "en"}]}], "apasyanta": [{"id": "apasyanta", "headword": "अपस्यन्त", "headword_slp1": "apasyanta", "fold": "apasyanta", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of उत्तानपाद and सूनृता. M. 4. ३५.", "gloss_language": "en"}]}], "apasyOsa": [{"id": "apasyOza", "headword": "अपस्यौष", "headword_slp1": "apasyOza", "fold": "apasyOsa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a मन्त्रकृत्। M. १४५. १०४.", "gloss_language": "en"}]}], "apasvanta": [{"id": "apasvAnta", "headword": "अपस्वान्त", "headword_slp1": "apasvAnta", "fold": "apasvanta", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of शक्रजित् and a loveable man. वा. ९६. ५३.", "gloss_language": "en"}]}], "apahariRi": [{"id": "apahAriRI", "headword": "अपहारिणी", "headword_slp1": "apahAriRI", "fold": "apahariRi", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a ब्रह्मराक्षसी. Br. III. 7. ९९.", "gloss_language": "en"}]}], "apagneya": [{"id": "apAgneya", "headword": "अपाग्नेय", "headword_slp1": "apAgneya", "fold": "apagneya", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a त्रयार्षेय. M. १९६. ४३. [page१-074+ २३]", "gloss_language": "en"}]}], "apaNkteyas": [{"id": "apANkteyas", "headword": "अपाङ्क्तेयस्", "headword_slp1": "apANkteyas", "fold": "apaNkteyas", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a list of those unfit for interdining. वा. ८३. ६०-70.", "gloss_language": "en"}]}], "apaRqu": [{"id": "apARqu", "headword": "अपाण्डु", "headword_slp1": "apARqu", "fold": "apaRqu", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a sage. M. १९६. ४५.", "gloss_language": "en"}]}], "apana": [{"id": "apAna", "headword": "अपान", "headword_slp1": "apAna", "fold": "apana", "headword_language": "sa", "source": "purana-index", "senses": [{