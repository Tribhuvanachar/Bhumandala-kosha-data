ers; the तोरण is of ३४ हस्तस्। M. २६९. २८, ३२, ४७. [page३-252+ २८]", "gloss_language": "en"}]}], "vimanam": [{"id": "vimAnam", "headword": "विमानम्", "headword_slp1": "vimAnam", "fold": "vimanam", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--Indra took दिती and the Maruts in it to heaven;\n1: M. 7. ६४.\nविवस्वान् took सम्ज्ञा with him.\n2: Ib. ११. ३७.", "gloss_language": "en"}]}], "vimanas": [{"id": "vimAnas", "headword": "विमानस्", "headword_slp1": "vimAnas", "fold": "vimanas", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--vehicles of gods;\n1: वा. ३०. ९६.\nbuilt by विश्वकर्म.\n2: Br. III. १०. ११९; १६. १४ and ५१; ५९. १८; IV. १७. १६; वा. ६६. ३०.", "gloss_language": "en"}]}], "vimocana (ni)": [{"id": "vimocanA (nI)", "headword": "विमोचना (नी)", "headword_slp1": "vimocanA (nI)", "fold": "vimocana (ni)", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--R. a main stream of साल्मलिद्वीप. Vi. II. 4. २८; वा. ४९. ४२; Br. II. १९. ४६.", "gloss_language": "en"}]}], "vimoha(na)": [{"id": "vimoha(na)", "headword": "विमोह(न)", "headword_slp1": "vimoha(na)", "fold": "vimoha(na)", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--(Vimocana-वा। प्।) the name of a hell. He who transgresses boundary limits goes to this as also thieves. Br. IV. 2. १४७ and १५९; वा. १०१. १४६, १५७.", "gloss_language": "en"}]}], "vimsa": [{"id": "vimSa", "headword": "विम्श", "headword_slp1": "vimSa", "fold": "vimsa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I) (विविम्श)--the father of a son कल्याण by name. वा. ८६. 6.", "gloss_language": "en"}, {"gloss": "(II)--a son of चक्षुष and father of विविम्शक. Vi. IV. 1. २६.", "gloss_language": "en"}]}], "vimsaja": [{"id": "vimSaja", "headword": "विम्शज", "headword_slp1": "vimSaja", "fold": "vimsaja", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--the fourth king of विदिश. वा. ९९. ३६८.",