{"dama": [{"id": "dama", "headword": "दम", "headword_slp1": "dama", "fold": "dama", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--a son of Marutta, and father of राज्य- vardhana. भा. IX. 2. २९.", "gloss_language": "en"}, {"gloss": "(II)--a son of क्रिया. Br. II. 9. ६०.", "gloss_language": "en"}, {"gloss": "(III)--a सुधामान God. Br. II. ३६. ३७.", "gloss_language": "en"}, {"gloss": "(IV)--a god of the आभूतरय group. Br. II. ३६. ५५.", "gloss_language": "en"}, {"gloss": "(V)--a वैकुण्ठ God. Br. II. ३६. ५७.", "gloss_language": "en"}, {"gloss": "(VI)--a son of नरिष्यन्त, a दण्डधर and father of विक्रान्त. (राष्त्रवर्धन-ब्र्। प्।; Rajavardhana- वि। प्।). Br. III. ६१. 8; वा. ८६. १२; Vi. IV. 1. ३६.", "gloss_language": "en"}, {"gloss": "(VII)--an आर्षेय pravara of भार्गवस्. M. १९५. ३६.", "gloss_language": "en"}, {"gloss": "(VIII)--a son of मणिवर. वा. ६९. १६०.", "gloss_language": "en"}, {"gloss": "(IX)--a Mukhya गण. वा. १००. १८.", "gloss_language": "en"}, {"gloss": "(X)--a son of रिष्यन्त. वा. ७०. ३०. [page२-073+ ३२]", "gloss_language": "en"}]}, {"id": "dAma", "headword": "दाम", "headword_slp1": "dAma", "fold": "dama", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a Sukha God. Br. IV. 1. १८.", "gloss_language": "en"}]}], "damaGosa": [{"id": "damaGoza", "headword": "दमघोष", "headword_slp1": "damaGoza", "fold": "damaGosa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a king of the Cedis; queen श्रुतश्रवा;\n1: भा. IX. २४. ३९. Br. III. ७१. १५९. Vi. IV. १४. ४४.\n(पटुश्रवा and रुजकन्या) father of शिशुपाल (Caidya:\n2: भा. VII. 1. १७. वा. ९६. १५८.\ns.v.), performed preliminaries to the marriage of his son with रुक्मिणी; when he went to कुण्डिन, he was entertain- ed by her father भीष्मक.\n3: भा. X. ५३. १४-16.\nHe was stationed on the south during the siege of Gomanta by जरासन्ध;\n4: Ib. X. ५२. ११ [8].\nwent to स्यमन्तपञ्चक for the सोलर् eclipse.\n5: Ib. X. ८२. २६.", "gloss_language": "en"}]}]