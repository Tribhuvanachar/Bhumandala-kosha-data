{"aksa": [{"id": "akza", "headword": "अक्ष", "headword_slp1": "akza", "fold": "aksa", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)\n1: भा. IX. 9. १७; M. २२०. 8; वा. ८८. १७४; Vi. IV. 4. ३७; Br. III. ६३. १७३.\n--the game of dice. ऋतुपर्ण, an expert in it. Taught the game to Nala; to be avoided by a king.\n2: M. १५४. ५२०; २२०. 8.", "gloss_language": "en"}, {"gloss": "(II)--a दानव. Br. III. 6. ११.", "gloss_language": "en"}, {"gloss": "(III)--a son of सत्यभामा and कृष्ण. Br. III. ७१. २४७; वा. ९६. २३८.", "gloss_language": "en"}]}], "aksapada": [{"id": "akzapAda", "headword": "अक्षपाद", "headword_slp1": "akzapAda", "fold": "aksapada", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of सोमशर्मन्, the अवतार् of the Lord at प्रभास, contemporary with the २७थ् Vya1sa. वा. २३. २१६.", "gloss_language": "en"}]}], "aksamala": [{"id": "akzamAlA", "headword": "अक्षमाला", "headword_slp1": "akzamAlA", "fold": "aksamala", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--of शेष; see अक्षसूत्र। वा. ५०. ५०. [page१-006+ ३०]", "gloss_language": "en"}]}], "aksara": [{"id": "akzara", "headword": "अक्षर", "headword_slp1": "akzara", "fold": "aksara", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--Father of सुयज्ञ. Br. III. ७०. २३.", "gloss_language": "en"}, {"gloss": "(II)--an epithet of Hari--(ety.)\n1: M. २४८. ३९.\nis Brahma.\n2: वा. ३२. 1.", "gloss_language": "en"}, {"gloss": "(III)--rises out of the neck of ब्रह्मा in the con- templation of creation.\n1: वा. २६. १४.\nA system of letters formed by ब्रह्मा.\n2: भा. XII. 6. ४३-44.", "gloss_language": "en"}, {"gloss": "(IV)--a term for महान्. वा. १०२. २१.", "gloss_language": "en"}]}], "aksari": [{"id": "akzarI", "headword": "अक्षरी", "headword_slp1": "akzarI", "fold": "aksari", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--the highest yogi. वा. १९. ४३; २०, 4.", "gloss_language": "en"}]}]