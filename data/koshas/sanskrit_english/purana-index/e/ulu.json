{"uluka": [{"id": "ulUka", "headword": "उलूक", "headword_slp1": "ulUka", "fold": "uluka", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--the son of Bala, and a righteous person; Father of वज्रनाभ. Br. III. ६३. २०५.", "gloss_language": "en"}, {"gloss": "(II)--a son of हिरण्याक्ष. M. 6. १४.", "gloss_language": "en"}, {"gloss": "(III)--a son of सहिष्णु of the २६थ् द्वपर। वा. २३. २१३.", "gloss_language": "en"}, {"gloss": "(IV)--a son of सोमशर्म; an अवतार् of the Lord. वा. २३. २१६.", "gloss_language": "en"}, {"gloss": "(V)--a विद्याधर chief in the वेणुमन्त hill. वा. ३९. ३८.", "gloss_language": "en"}]}], "ulukas": [{"id": "ulUkas", "headword": "उलूकस्", "headword_slp1": "ulUkas", "fold": "ulukas", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--son of भासि, owls as children of शुकी;\n1: Br. III. 7. ४५५; M. 6. ३१; २३७. १२; २४०. १८.\nof ताम्रा line.\n2: Vi. I. २१. १६.\n[page१-245+ २७]", "gloss_language": "en"}]}], "ulukajit": [{"id": "ulUkajit", "headword": "उलूकजित्", "headword_slp1": "ulUkajit", "fold": "ulukajit", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of धूमिनी, sister of भण्ड; served as a commander भण्ड, and killed by a देवी of ललिता. Br. IV. २१. ८४; २८. 6, ३८ and १००.", "gloss_language": "en"}]}], "ulukika": [{"id": "ulUkikA", "headword": "उलूकिका", "headword_slp1": "ulUkikA", "fold": "ulukika", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--Life sucked out by infant कृष्ण. भा. II. 7. २७.", "gloss_language": "en"}]}], "uluki": [{"id": "ulUkI", "headword": "उलूकी", "headword_slp1": "ulUkI", "fold": "uluki", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a mindborn mother. M. १७९. १५.", "gloss_language": "en"}]}], "uluKala": [{"id": "ulUKala", "headword": "उलूखल", "headword_slp1": "ulUKala", "fold": "uluKala", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "(I)--the mortar; pregna