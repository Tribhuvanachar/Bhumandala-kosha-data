{"miTi": [{"id": "miTi", "headword": "मिथि", "headword_slp1": "miTi", "fold": "miTi", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of Ni (e) mi, born out of the churning of अरणि; see Janaka: founded the city of मिथिला. Br. III. ६४. 4; वा. ८९. 4-6; Vi. IV. 5. २३.", "gloss_language": "en"}]}], "miTila": [{"id": "miTilA", "headword": "मिथिला", "headword_slp1": "miTilA", "fold": "miTila", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--founded by Janaka-Vaideha: capital of the Videhas whose king was Janaka: here शतधन्वन् lost his horse and ran on foot afraid of कृष्ण: बलराम visited it and lived there for some time. भा. IX. १३. १३; X. ५७. २०-26; Br. III. ६४. 6; ७१. ८०; वा. ९६. ७४; ९९. ३२४.", "gloss_language": "en"}]}], "miTilavanam": [{"id": "miTilAvanam", "headword": "मिथिलावनम्", "headword_slp1": "miTilAvanam", "fold": "miTilavanam", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--शतधनु was killed by कृष्ण in. Vi. IV. १३. ९३.", "gloss_language": "en"}]}], "miTilesvara": [{"id": "miTileSvara", "headword": "मिथिलेश्वर", "headword_slp1": "miTileSvara", "fold": "miTilesvara", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--also Maithila--King of मिथिला. Br. III. ३९. 2, 8.", "gloss_language": "en"}]}], "miTilopavanam": [{"id": "miTilopavanam", "headword": "मिथिलोपवनम्", "headword_slp1": "miTilopavanam", "fold": "miTilopavanam", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--Here कृष्ण vanquished Bhoja. Br. III. ७१. ७६.", "gloss_language": "en"}]}]}