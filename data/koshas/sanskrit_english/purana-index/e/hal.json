oss_language": "en"}]}], "haleya": [{"id": "hAleya", "headword": "हालेय", "headword_slp1": "hAleya", "fold": "haleya", "headword_language": "sa", "source": "purana-index", "senses": [{"gloss": "--a son of अरिष्टकर्मन्, and father of Talaka. भा. XII. 1. २५.", "gloss_language": "en"}]}]}