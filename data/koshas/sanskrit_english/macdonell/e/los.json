{"loswa": [{"id": "lozwa", "headword": "लोष्ट", "headword_slp1": "lozwa", "fold": "loswa", "headword_language": "sa", "source": "macdonell", "senses": [{"gloss": "लोष्ट loṣ-ṭá, m. n. [√ ruj] lump of earth, 🞄clod;\n m. N.: -ka, m. clod;\n -guṭikā, f. pellet 🞄of clay;\n -ghāta, m. blow with a clod: 🞄-m, abs. with han, kill with clods = stone to 🞄death;\n -dhara, m. N.;\n -maya, a. made of 🞄clay;\n -vat, ad. like a clod, as on a lump of 🞄clay.", "gloss_language": "en"}], "synonyms": ["लोष्टं", "लोष्टः"], "synonyms_slp1": ["lozwaM", "lozwaH"]}], "loswasa": [{"id": "lozwaSa", "headword": "लोष्टश", "headword_slp1": "lozwaSa", "fold": "loswasa", "headword_language": "sa", "source": "macdonell", "senses": [{"gloss": "लोष्टश loṣṭa-śa, m. N..", "gloss_language": "en"}]}], "loswra": [{"id": "lozwra", "headword": "लोष्ट्र", "headword_slp1": "lozwra", "fold": "loswra", "headword_language": "sa", "source": "macdonell", "senses": [{"gloss": "लोष्ट्र loṣ-ṭra, (prob. incorr.) = loṣṭa.", "gloss_language": "en"}]}]}