िन्, ई, इनी, इ, fr. बुक above.", "gloss_language": "en"}]}], "bukaRa": [{"id": "bukkaRa", "headword": "बुक्कण", "headword_slp1": "bukkaRa", "fold": "bukaRa", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "बुक्कण, अस्, m., N. of a king (the patron of\nMādhavācārya and Sāyaṇācārya, see above).", "gloss_language": "en"}]}], "bukan": [{"id": "bukkan", "headword": "बुक्कन्", "headword_slp1": "bukkan", "fold": "bukan", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "बुक्कन्, आ, m. the heart.", "gloss_language": "en"}]}, {"id": "bUkkan", "headword": "बूक्कन्", "headword_slp1": "bUkkan", "fold": "bukan", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "बूक्कन् = बुक्कन्, q. v.", "gloss_language": "en"}]}], "bukana": [{"id": "bukkana", "headword": "बुक्कन", "headword_slp1": "bukkana", "fold": "bukana", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "बुक्कन, अम्, n. the barking of a dog; the noise\nmade by other animals.", "gloss_language": "en"}], "synonyms": ["बुक्कनं"], "synonyms_slp1": ["bukkanaM"]}], "bukasa": [{"id": "bukkasa", "headword": "बुक्कस", "headword_slp1": "bukkasa", "fold": "bukasa", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "बुक्कस बुक्कस, अस्, m. a Caṇḍāla, man of\nthe lowest class [cf. पुक्कश, पुक्कस]; (ई), f. =\nकाली, (perhaps) black colour; the indigo plant (=\nपुक्कश, पुक्कस).", "gloss_language": "en"}], "synonyms": ["बुक्कसः"], "synonyms_slp1": ["bukkasaH"]}], "bukamahipati": [{"id": "bukkamahIpati", "headword": "बुक्कमहीपति", "headword_slp1": "bukkamahIpati", "fold": "bukamahipati", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "बुक्क-महीपति; for ‘भूपात’ read भूपति.", "gloss_language": "en"}]}]}