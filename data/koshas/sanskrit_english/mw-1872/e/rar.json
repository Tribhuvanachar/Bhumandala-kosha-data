 [{"gloss": "रारस्यमान, अस्, आ, अम् (fr. the Intens.), crying\nout or howling very loud.", "gloss_language": "en"}]}, {"id": "rArAsyamAna", "headword": "रारास्यमान", "headword_slp1": "rArAsyamAna", "fold": "rarasyamana", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "रारास्यमान, अस्, आ, अम्, crying aloud, uttering\nloud lamentations.", "gloss_language": "en"}]}], "raraRa": [{"id": "rarARa", "headword": "रराण", "headword_slp1": "rarARa", "fold": "raraRa", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "रराण, अस्, आ, अम्, Ved. giving, bountiful, (see\nṚg-veda I. 117, 24.)", "gloss_language": "en"}]}], "rara": [{"id": "rArA", "headword": "रारा", "headword_slp1": "rArA", "fold": "rara", "headword_language": "sa", "source": "mw-1872", "senses": [{"gloss": "रारा रारा. See राढा, p. 841, col. 2.", "gloss_language": "en"}]}]}