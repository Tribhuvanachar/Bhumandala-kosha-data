{"luYc": [{"id": "luYc", "headword": "लुञ्च्", "headword_slp1": "luYc", "fold": "luYc", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "लुञ्च् लुञ्च्, i. 1, Par.\n 1. To pull out, Bhaṭṭ. 15, 3.\n 2. To pare, to peel, Pañc. 121, 13.\n --With the prep. अव अव, To pull off, MBh. 3, 10760.\n --With वि वि, To pull out, Bhaṭṭ. 18, 38.\n --Cf. probably O.H.G. liuhhan; A.S. lyccan, evellere; Lat. runcare.", "gloss_language": "en"}], "synonyms": ["लुंच्"], "synonyms_slp1": ["luMc"]}], "luYcaka": [{"id": "luYcaka", "headword": "लुञ्चक", "headword_slp1": "luYcaka", "fold": "luYcaka", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "लुञ्चक लुञ्च् + अक, adj. One who pulls out.\n --Comp.", "gloss_language": "en"}]}], "luYcana": [{"id": "luYcana", "headword": "लुञ्चन", "headword_slp1": "luYcana", "fold": "luYcana", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "लुञ्चन लुञ्च् + अन, n. Pulling out, Daśak. in Chr. 185, 3.", "gloss_language": "en"}], "synonyms": ["लुंचन", "लुंचनं"], "synonyms_slp1": ["luMcana", "luMcanaM"]}], "luYj": [{"id": "luYj", "headword": "लुञ्ज्", "headword_slp1": "luYj", "fold": "luYj", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "लुञ्ज् लुञ्ज्, see लञ्ज्.", "gloss_language": "en"}]}]}