language": "en"}], "synonyms": ["अंकुरित"], "synonyms_slp1": ["aMkurita"]}], "aNkusa": [{"id": "aNkuSa", "headword": "अङ्कुश", "headword_slp1": "aNkuSa", "fold": "aNkusa", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "अङ्कुश अङ्कुश, i. e. अङ्कु (in the Ved. अङ्कूय from अञ्च्, cf. अङ्क) + श, m. and n.\n 1. A hook.\n 2. A goad for driving elephants with.\n --Comp.", "gloss_language": "en"}], "synonyms": ["अंकुश", "अंकुशः", "अङ्कुशः"], "synonyms_slp1": ["aMkuSa", "aMkuSaH", "aNkuSaH"]}], "aNkoWa": [{"id": "aNkoWa", "headword": "अङ्कोठ", "headword_slp1": "aNkoWa", "fold": "aNkoWa", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "अङ्कोठ अङ्कोठ, and अङ्कोल अङ्कोल, m. A plant, Alangium hexapetalum.", "gloss_language": "en"}], "synonyms": ["अंकोठ", "अङ्कोठः"], "synonyms_slp1": ["aMkoWa", "aNkoWaH"]}], "aNkusagraha": [{"id": "aNkuSagraha", "headword": "अङ्कुशग्रह", "headword_slp1": "aNkuSagraha", "fold": "aNkusagraha", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "अङ्कुश- + ग्रह अङ्कुश- + ग्रह, m. a mahout, or elephant's driver, MBh. 3, 978.", "gloss_language": "en"}], "synonyms": ["अंकुशग्रह", "अङ्कुशग्रहः"], "synonyms_slp1": ["aMkuSagraha", "aNkuSagrahaH"]}], "aNkapala": [{"id": "aNkapAla", "headword": "अङ्कपाल", "headword_slp1": "aNkapAla", "fold": "aNkapala", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "अङ्क- + पाल अङ्क- + पाल, f. ली, embrace.", "gloss_language": "en"}]}], "aNkapali": [{"id": "aNkapAlI", "headword": "अङ्कपाली", "headword_slp1": "aNkapAlI", "fold": "aNkapali", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "अङ्क-पाली अङ्क-पाली, f. embrace.", "gloss_language": "en"}], "synonyms": ["अंकपाली"], "synonyms_slp1": ["aMkapAlI"]}], "aNkabanDa": [{"id": "aNkabanDa", "headword": "अङ्कबन्ध", "headword_slp1": "aNkabanDa", "fold": "aNkabanDa", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "अङ्क- + बन्ध अङ्क- + बन्ध, m. branding with a d