 [{"id": "vanAhira", "headword": "वनाहिर", "headword_slp1": "vanAhira", "fold": "vanahira", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वनाहिर वनाहिर, m. A hog.", "gloss_language": "en"}], "synonyms": ["वनाहिरः"], "synonyms_slp1": ["vanAhiraH"]}], "vani": [{"id": "vani", "headword": "वनि", "headword_slp1": "vani", "fold": "vani", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वनि वन् + इ, m.\n 1. Fire or its deity.\n 2. Desire, wish.", "gloss_language": "en"}], "synonyms": ["वनिः"], "synonyms_slp1": ["vaniH"]}], "vanin": [{"id": "vanin", "headword": "वनिन्", "headword_slp1": "vanin", "fold": "vanin", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वनिन् वनिन्, i. e. वन + इन्, adj. Abounding in water, Chr. 291, 12 = Rigv. i. 64, 12.", "gloss_language": "en"}]}], "vanika": [{"id": "vanIka", "headword": "वनीक", "headword_slp1": "vanIka", "fold": "vanika", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वनीक वनीक, and वनीयक वनीयक (vb. वन्), m. A beggar.", "gloss_language": "en"}], "synonyms": ["वनीकः"], "synonyms_slp1": ["vanIkaH"]}], "vanecara": [{"id": "vanecara", "headword": "वनेचर", "headword_slp1": "vanecara", "fold": "vanecara", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वनेचर वनेचर, i. e. वन + इ-चर,\n I. adj. Who or what abides in a forest. Rām. 3, 51, 34.\n II. m.\n 1. A forester, Kirāt. 1, 1.\n 2. A demon.\n 3. A wild beast, Lass. 47, 10.", "gloss_language": "en"}], "synonyms": ["वनेचरः"], "synonyms_slp1": ["vanecaraH"]}], "vand": [{"id": "vand", "headword": "वन्द्", "headword_slp1": "vand", "fold": "vand", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन्द् वन्द् (akin to वद्), i. 1. Ātm.\n 1. To salute respectfully, Vikr. 81, 11; MBh. 2, 23.\n 2. To praise, Rām. 2, 16, 27.\n 3. To venerate, Megh. 12.\n --Comp. ptcple. of the fut. pass. जगद्वन्द्य, i. e. जगत्-, adj. To be praised by mankind, epithet of Kṛṣṇa, MBh. 2, 23.\n -