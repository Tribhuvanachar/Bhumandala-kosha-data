ms": ["वनपांसुलः"], "synonyms_slp1": ["vanapAMsulaH"]}], "vandipaWa": [{"id": "vandipAWa", "headword": "वन्दिपाठ", "headword_slp1": "vandipAWa", "fold": "vandipaWa", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन्दिपाठ वन्दिपाठ, i. e. वन्दिन्-, m. a panegyric, an eulogium.", "gloss_language": "en"}], "synonyms": ["वन्दिपाठः"], "synonyms_slp1": ["vandipAWaH"]}], "vanapriya": [{"id": "vanapriya", "headword": "वनप्रिय", "headword_slp1": "vanapriya", "fold": "vanapriya", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन- + प्रिय वन- + प्रिय, m. the Indian cuckoo.", "gloss_language": "en"}], "synonyms": ["वनप्रियं", "वनप्रियः"], "synonyms_slp1": ["vanapriyaM", "vanapriyaH"]}], "vanamala": [{"id": "vanamAlA", "headword": "वनमाला", "headword_slp1": "vanamAlA", "fold": "vanamala", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन- + माला वन- + माल, f. ला, the chaplet worn by Kṛṣṇa.", "gloss_language": "en"}]}], "vandanamala": [{"id": "vandanamAlA", "headword": "वन्दनमाला", "headword_slp1": "vandanamAlA", "fold": "vandanamala", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन्दन- + माला वन्दन- + माल, f. ला, the ornamented arc of a gateway (cf. मालक).", "gloss_language": "en"}], "synonyms": ["वंदनमाला"], "synonyms_slp1": ["vaMdanamAlA"]}], "vandanamalika": [{"id": "vandanamAlikA", "headword": "वन्दनमालिका", "headword_slp1": "vandanamAlikA", "fold": "vandanamalika", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन्दन- + मालिका वन्दन- + मालिक, f. का, the ornamented arc of a gateway; cf. मालक.", "gloss_language": "en"}], "synonyms": ["वंदनमालिका"], "synonyms_slp1": ["vaMdanamAlikA"]}], "vanamalin": [{"id": "vanamAlin", "headword": "वनमालिन्", "headword_slp1": "vanamAlin", "fold": "vanamalin", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "वन- + मालिन् वन- + मालिन्, m. Kṛṣṇa.", "gloss_language": "en"}]}], "vanaraji": [{"id": "vanarAji", "headwor