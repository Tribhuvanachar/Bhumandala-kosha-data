e": "benfey", "senses": [{"gloss": "धर धर, i. e. धृ + अ,\n I. adj., f. रा.\n 1. Bearing, especially latter part of comp. adj., e. g. Arj. 6, 10.\n 2. Preserving, MBh. 6, 3005.\n 3. Possessed of, Rām. 1, 9, 27.\n 4. Observing, Pañc. 187, 12.\n II. m. The name of a वसु, MBh. 1, 2582.\n III. f. रा, The earth, Man. 6, 26.\n --Comp.", "gloss_language": "en"}], "synonyms": ["धरः"], "synonyms_slp1": ["DaraH"]}, {"id": "DAra", "headword": "धार", "headword_slp1": "DAra", "fold": "Dara", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "धार धार, i. e.\n I. धृ + अ, latter part of comp. words, Holding, bearing, e. g. छत्त्र-, m. The bearer of the royal parasol, Pañc. 156, 22; दण्ड-, adj. Holding the staff, as symbol of judicature, Rājat. 4, 108.\n II. धारा + अ.\n 1. adj. Coming down in a shower, Suśr. 1, 170, 1.\n 2. m. A shower, Hariv. 6333.\n --Cf. धारा.", "gloss_language": "en"}], "synonyms": ["धारं", "धारः"], "synonyms_slp1": ["DAraM", "DAraH"]}, {"id": "DArA", "headword": "धारा", "headword_slp1": "DArA", "fold": "Dara", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "धारा धारा (akin to धा̆व्,), f.\n 1. A torrent, MBh. 6, 5785.\n 2. A river, Hariv. 8325.\n 3. A shower, Mṛcch. 76, 15.\n 4. A drop, Mṛcch. 91, 4; Bhartṛ. 2, 89.\n 5. A multitude, Rām. 6, 88, 3.\n 6. pl. A horse's pace, as the trot, canter, etc., Śiś. 5, 60.\n 7. The sharp edge of a sword or any cutting instrument, Rām. 2, 23, 35.\n 8. The circumference of a wheel, Ragh. 13, 15.\n --Comp.", "gloss_language": "en"}]}], "DaraRiDara": [{"id": "DaraRIDara", "headword": "धरणीधर", "headword_slp1": "DaraRIDara", "fold": "DaraRiDara", "headword_language": "sa", "source": "benfey", "senses": [{"gloss": "धरणी- + धर धरणी- + धर,\n I. adj. holding the earth, MBh. 13, 6159.\n II. m. 1. a mountain, Rām. 6, 16, 4. 2. a king, Rājat. 3, 63.", "gloss_language": "en"}], "synonyms": ["धरणीधरः"], "synonyms_slp1": ["DaraRIDaraH"]}], "DaraDara": [{"id": "DarADara", "headword": "धराधर", "headword_