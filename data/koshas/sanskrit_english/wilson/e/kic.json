{"kicaka": [{"id": "kIcaka", "headword": "कीचक", "headword_slp1": "kIcaka", "fold": "kicaka", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-कः)\n1 A bamboo whistling or rattling in the wind.\n2 Any hollow bamboo.\n3 A reed.\n4 A Daitya or infernal demon so named.\n5 A particular Rākṣasa or goblin.\n6 A kind of tree.\n7 A prince, the son of KEKAYA.\nE.\nचीक to touch, to sound, वुन् Uṇādi affix, and the radical consonants transposed.", "gloss_language": "en"}], "synonyms": ["कीचकः"], "synonyms_slp1": ["kIcakaH"]}], "kicakajit": [{"id": "kIcakajit", "headword": "कीचकजित्", "headword_slp1": "kIcakajit", "fold": "kicakajit", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-जित्)\nA name of BHĪMA.\nE.\nकीचक a goblin, and जित् who conquers.", "gloss_language": "en"}]}], "kicakanisudana": [{"id": "kIcakanisUdana", "headword": "कीचकनिसूदन", "headword_slp1": "kIcakanisUdana", "fold": "kicakanisudana", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-नः)\nBHĪMA: see the preceding.", "gloss_language": "en"}], "synonyms": ["कीचकनिसूदनः"], "synonyms_slp1": ["kIcakanisUdanaH"]}], "kicakaBid": [{"id": "kIcakaBid", "headword": "कीचकभिद्", "headword_slp1": "kIcakaBid", "fold": "kicakaBid", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-भित्)\nSee the two words preceding.", "gloss_language": "en"}]}]}