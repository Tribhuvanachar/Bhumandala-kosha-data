{"Caya": [{"id": "CAyA", "headword": "छाया", "headword_slp1": "CAyA", "fold": "Caya", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "f. (-या)\n1 Shade.\n2 Shadow, reflected image.\n3 The wife of the sun.\n4 Beauty, splendor, lustre.\n5 Light.\n6 Nourishing, cherishing.\n7 A bribe.\n8 A straight or continuous line.\n9 A name of the goddess DURGĀ.\n10 Darkness, obscurity.\n11 The shadow of a Gnomon, especially as indicative of the position of the sun.\nE.\nछो to cut, (to cut off the light, &c.) and य Uṇādi aff.", "gloss_language": "en"}]}], "Cayakara": [{"id": "CAyAkara", "headword": "छायाकर", "headword_slp1": "CAyAkara", "fold": "Cayakara", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "mfn. (-रः-री-रं)\nShading, shadowing.\nm. (-रः)\n1 A catta or umbrella bearer.\n2 A species of metre.\nE.\nछाया shade, and कर who makes.", "gloss_language": "en"}], "synonyms": ["छायाकरः"], "synonyms_slp1": ["CAyAkaraH"]}], "Cayatanaya": [{"id": "CAyAtanaya", "headword": "छायातनय", "headword_slp1": "CAyAtanaya", "fold": "Cayatanaya", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-यः)\nA name of SATURN.\nE.\nछाया the wife of SŪRYA, and तनय a son; also similar compounds, as छायात्मज, छायासुत, &c.", "gloss_language": "en"}], "synonyms": ["छायातनयः"], "synonyms_slp1": ["CAyAtanayaH"]}], "Cayataru": [{"id": "CAyAtaru", "headword": "छायातरु", "headword_slp1": "CAyAtaru", "fold": "Cayataru", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-रुः)\nA large tree, one that gives shade or shelter.\nE.\nछाया, and तरु a tree.", "gloss_language": "en"}], "synonyms": ["छायातरुः"], "synonyms_slp1": ["CAyAtaruH"]}], "Cayatmaja": [{"id": "CAyAtmaja", "headword": "छायात्मज", "headword_slp1": "CAyAtmaja", "fold": "Cayatmaja", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-जः)\nSATURN: see छायातनय.", "gloss_language": "en"}], "synonyms": ["छायात्मजः"], "synonyms_slp1": ["CAyAtmajaH"]}],