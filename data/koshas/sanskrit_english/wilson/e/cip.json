{"cipiwa": [{"id": "cipiwa", "headword": "चिपिट", "headword_slp1": "cipiwa", "fold": "cipiwa", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "mfn. (-टः-टा-टं)\nFlat-nosed.\nE.\nनि preposition, पिटञ् affix in this sense, and नि changed to चि.\nm. (-टः)\nRice or grain flattened.\nE.\nपिट to flatten, क affix, the derivative reduplicated, and च substituted for the radical; also with कन् added चिपिटक; also the pen. becoming उ, चिपुट.", "gloss_language": "en"}], "synonyms": ["चिपिटः"], "synonyms_slp1": ["cipiwaH"]}], "cipiwaka": [{"id": "cipiwaka", "headword": "चिपिटक", "headword_slp1": "cipiwaka", "fold": "cipiwaka", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-कः)\nSee the preceding.", "gloss_language": "en"}], "synonyms": ["चिपिटकः"], "synonyms_slp1": ["cipiwakaH"]}], "cipuwa": [{"id": "cipuwa", "headword": "चिपुट", "headword_slp1": "cipuwa", "fold": "cipuwa", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "m. (-टः)\nSee चिपिट.", "gloss_language": "en"}], "synonyms": ["चिपुटः"], "synonyms_slp1": ["cipuwaH"]}], "cipya": [{"id": "cipya", "headword": "चिप्य", "headword_slp1": "cipya", "fold": "cipya", "headword_language": "sa", "source": "wilson", "senses": [{"gloss": "n. (-प्यं)\nA whitlow.", "gloss_language": "en"}]}]}