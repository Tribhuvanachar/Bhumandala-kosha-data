्याम्"], "synonyms_slp1": ["na sudurByAM kevalAByAm ७.१.६८", "७.१.६८", "७.१.६८ na sudurByAM kevalAByAm"]}], "na liNi": [{"id": "na liNi", "headword": "न लिङि", "headword_slp1": "na liNi", "fold": "na liNi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The इट् is not lengthened after वॄ , वृञ् and after roots ending in long ॠ in the endings of the Benedictive.\n\nTerms: इट् augment", "gloss_language": "en"}], "synonyms": ["न लिङि ७.२.३९", "७.२.३९", "७.२.३९ न लिङि"], "synonyms_slp1": ["na liNi ७.२.३९", "७.२.३९", "७.२.३९ na liNi"]}], "na vfdByascaturByaH": [{"id": "na vfdByaScaturByaH", "headword": "न वृद्भ्यश्चतुर्भ्यः", "headword_slp1": "na vfdByaScaturByaH", "fold": "na vfdByascaturByaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The परस्मैपद आर्धधातुक affixes beginning with स् do not get the इट् augment after वृत् and the three roots (वृध् , शृध् and स्यन्द्) that follow it.\n\nTerms: इट् augment", "gloss_language": "en"}], "synonyms": ["न वृद्भ्यश्चतुर्भ्यः ७.२.५९", "७.२.५९", "७.२.५९ न वृद्भ्यश्चतुर्भ्यः"], "synonyms_slp1": ["na vfdByaScaturByaH ७.२.५९", "७.२.५९", "७.२.५९ na vfdByaScaturByaH"]}], "na yvaByan padantaByam purvO tu taByamEc": [{"id": "na yvAByAM padAntAByAm pUrvO tu tAByAmEc", "headword": "न य्वाभ्यां पदान्ताभ्याम् पूर्वौ तु ताभ्यामैच्", "headword_slp1": "na yvAByAM padAntAByAm pUrvO tu tAByAmEc", "fold": "na yvaByan padantaByam purvO tu taByamEc", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "Before a तद्धित affix with an indicatory ञ् , ण् or क् the वृद्धि is not substituted for the first vowel in a compound when it follows a word ending in य् or व् but ऐ and औ are respectively placed before the semi-vowels.\n\nTerms: तद्धित changes", "gloss_language": "en"}], "synonyms": ["न य्वाभ्यां पदान्ताभ्याम् पूर्वौ तु ताभ्यामैच् ७.३.३", "७.३.३", "७.३.३ न य्वाभ्यां पदान्ताभ्याम् पूर्वौ तु ताभ्यामैच्"], "synonyms_slp1": ["na yvAByAM padAntAByAm pUrvO tu tAByAmEc ७.३.३", "७.३.३", "७.३.३ na yvAByAM padAntAByAm pUrvO tu tAByAmEc"]}], "na karmavyatihare": [{"id": "na karmavyatihAre", "headword": "न कर्मव्यतिहारे", "headword_slp1": "na karmavyatihAre", "fold": "na karmavyatihare", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The prohibition and the augment ordained by न य्वाभ्यां पदान्ताभ्याम् पूर्वौ तु ताभ्यामैच् ७.३.३, do not apply to a word which expresses the reciprocity of an action.\n\nTerms: Peculiar वृद्धि", "gloss_language": "en"}], "synonyms": ["न कर्मव्यतिहारे ७.३.६", "७.३.६", "७.३.६ न कर्मव्यतिहारे"], "synonyms_slp1": ["na karmavyatihAre ७.३.६", "७.३.६", "७.३.६ na karmavyatihAre"]}], "na yasayoH": [{"id": "na yAsayoH", "headword": "न यासयोः", "headword_slp1": "na yAsayoH", "fold": "na yasayoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The इ is not substituted for the अ of य् and स् with the augment क् when the feminine आ follows.\n\nTerms: Feminine इ", "gloss_language": "en"}], "synonyms": ["न यासयोः ७.३.४५", "७.३.४५", "७.३.४५ न यासयोः"], "synonyms_slp1": ["na yAsayoH ७.३.४५", "७.३.४५", "७.३.४५ na yAsayoH"]}], "na kvadeH": [{"id": "na kvAdeH", "headword": "न क्वादेः", "headword_slp1": "na kvAdeH", "fold": "na kvadeH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "A guttural is not substituted for the final च् or ज् of a root which begins with a guttral, before the affix having an indicatory ध् and before ण्यत्।\n\nTerms: Guttarlisation", "gloss_language": "en"}], "synonyms": ["न क्वादेः ७.३.५९", "७.३.५९", "७.३.५९ न क्वादेः"], "synonyms_slp1": ["na kvAdeH ७.३.५९", "७.३.५९", "७.३.५९ na kvAdeH"]}], "na kapi": [{"id": "na kapi", "headword": "न कपि", "headword_slp1": "na kapi", "fold": "na kapi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "But before the समासान्त affix कप् coming after बहुव्रीहि समास , the अण् vowels are not shortened.\n\nTerms: Shortening", "gloss_language": "en"}], "synonyms": ["न कपि ७.४.१४", "७.४.१४", "७.४.१४ न कपि"], "synonyms_slp1": ["na kapi ७.४.१४", "७.४.१४", "७.४.१४ na kapi"]}], "na cCandasyaputrasya": [{"id": "na cCandasyaputrasya", "headword": "न च्छन्दस्यपुत्रस्य", "headword_slp1": "na cCandasyaputrasya", "fold": "na cCandasyaputrasya", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "In the छन्दस् (Vedas) the above rules causing lengthening or the substitution of long ई for the final vowel of the अङ्ग (stem), do not apply, except in the case of पुत्र।\n\nTerms: Long ई", "gloss_language": "en"}], "synonyms": ["न च्छन्दस्यपुत्रस्य ७.४.३५", "७.४.३५", "७.४.३५ न च्छन्दस्यपुत्रस्य"], "synonyms_slp1": ["na cCandasyaputrasya ७.४.३५", "७.४.३५", "७.४.३५ na cCandasyaputrasya"]}], "na kavateryaNi": [{"id": "na kavateryaNi", "headword": "न कवतेर्यङि", "headword_slp1": "na kavateryaNi", "fold": "na kavateryaNi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The Palatal is not substituted for the Guttural of the reduplicate of कु (कवते) in the intensive.\n\nTerms: Reduplicate", "gloss_language": "en"}], "synonyms": ["न कवतेर्यङि ७.४.६३", "७.४.६३", "७.४.६३ न कवतेर्यङि"], "synonyms_slp1": ["na kavateryaNi ७.४.६३", "७.४.६३", "७.४.६३ na kavateryaNi"]}], "na cavahahEvayukte": [{"id": "na cavAhAhEvayukte", "headword": "न चवाहाहैवयुक्ते", "headword_slp1": "na cavAhAhEvayukte", "fold": "na cavahahEvayukte", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "when there is in connection with the सर्वनाम any of these - 1. च 'and' 2. वा 'or' 3. ह 'Oh!' 4. अह 'wonderful' or 5. एव 'only'.\n\nTerms: सर्वनाम", "gloss_language": "en"}], "synonyms": ["न चवाहाहैवयुक्ते ८.१.२४", "८.१.२४", "८.१.२४ न चवाहाहैवयुक्ते"], "synonyms_slp1": ["na cavAhAhEvayukte ८.१.२४", "८.१.२४", "८.१.२४ na cavAhAhEvayukte"]}], "na luw": [{"id": "na luw", "headword": "न लुट्", "headword_slp1": "na luw", "fold": "na luw", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "By the लुट् (Periphrastic Future) is not unaccented when it is preceded by a word which is not a finite verb.\n\nTerms: Accent", "gloss_language": "en"}], "synonyms": ["न लुट् ८.१.२९", "८.१.२९", "८.१.२९ न लुट्"], "synonyms_slp1": ["na luw ८.१.२९", "८.१.२९", "८.१.२९ na luw"]}], "na mu ne": [{"id": "na mu ne", "headword": "न मु ने", "headword_slp1": "na mu ne", "fold": "na mu ne", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The sūtra अदसोऽसेर्दादु दो मः ८.२.८०, teaching the substitution of मु for the दस् of the pronoun अदस् is however not treated as असिद्ध in relation to the case-ending ना।\n\nTerms: असिद्ध", "gloss_language": "en"}], "synonyms": ["न मु ने ८.२.३", "८.२.३", "८.२.३ न मु ने"], "synonyms_slp1": ["na mu ne ८.२.३", "८.२.३", "८.२.३ na mu ne"]}], "na NisambudDyoH": [{"id": "na NisambudDyoH", "headword": "न ङिसम्बुद्ध्योः", "headword_slp1": "na NisambudDyoH", "fold": "na NisambudDyoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "(But such न्) is not elided in the Locative -7th case and Vocative Case singular.\n\nTerms: न् Elision", "gloss_language": "en"}], "synonyms": ["न ङिसम्बुद्ध्योः ८.२.८", "८.२.८", "८.२.८ न ङिसम्बुद्ध्योः"], "synonyms_slp1": ["na NisambudDyoH ८.२.८", "८.२.८", "८.२.८ na NisambudDyoH"]}], "na DyaKyapfmurCimadam": [{"id": "na DyAKyApFmUrCimadAm", "headword": "न ध्याख्यापॄमूर्छिमदाम्", "headword_slp1": "na DyAKyApFmUrCimadAm", "fold": "na DyaKyapfmurCimadam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The निष्ठा त is not changed to न after 1. ध्या 2. ख्या 3. पॄ 4. मूर्छि and 5. मद।\n\nTerms: निष्ठा changes", "gloss_language": "en"}], "synonyms": ["न ध्याख्यापॄमूर्छिमदाम् ८.२.५७", "८.२.५७", "८.२.५७ न ध्याख्यापॄमूर्छिमदाम्"], "synonyms_slp1": ["na DyAKyApFmUrCimadAm ८.२.५७", "८.२.५७", "८.२.५७ na DyAKyApFmUrCimadAm"]}], "na BakurCuram": [{"id": "na BakurCurAm", "headword": "न भकु