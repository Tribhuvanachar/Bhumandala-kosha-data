{"yavadavaDaraRe": [{"id": "yAvadavaDAraRe", "headword": "यावदवधारणे", "headword_slp1": "yAvadavaDAraRe", "fold": "yavadavaDaraRe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The indeclinable word यावत् when it signifies limitation, is invariably compounded with a word ending in a case-affix which is in construction with it, and the compound so formed is called अव्ययीभाव।\n\nTerms: अव्ययीभाव समास", "gloss_language": "en"}], "synonyms": ["यावदवधारणे २.१.८", "२.१.८", "२.१.८ यावदवधारणे"], "synonyms_slp1": ["yAvadavaDAraRe २.१.८", "२.१.८", "२.१.८ yAvadavaDAraRe"]}], "yavatpuranipatayorlaw": [{"id": "yAvatpurAnipAtayorlaw", "headword": "यावत्पुरानिपातयोर्लट्", "headword_slp1": "yAvatpurAnipAtayorlaw", "fold": "yavatpuranipatayorlaw", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix लट् (Present Tense) comes after a root with the force of futurity when it has in construction with it the particles यावत् and पुरा।\n\nTerms: उणादि", "gloss_language": "en"}], "synonyms": ["यावत्पुरानिपातयोर्लट् ३.३.४", "३.३.४", "३.३.४ यावत्पुरानिपातयोर्लट्"], "synonyms_slp1": ["yAvatpurAnipAtayorlaw ३.३.४", "३.३.४", "३.३.४ yAvatpurAnipAtayorlaw"]}], "yavati vindajivoH": [{"id": "yAvati vindajIvoH", "headword": "यावति विन्दजीवोः", "headword_slp1": "yAvati vindajIvoH", "fold": "yavati vindajivoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix णमुल् comes after the verb विद् 'to know' and जीव् 'to live' when the word यावत् is combined with them.\n\nTerms: णमुल्", "gloss_language": "en"}], "synonyms": ["यावति विन्दजीवोः ३.४.३०", "३.४.३०", "३.४.३० यावति विन्दजीवोः"], "synonyms_slp1": ["yAvati vindajIvoH ३.४.३०", "३.४.३०", "३.४.३० yAvati vindajIvoH"]}], "yavayavakasaswikadat‌": [{"id": "yavayavakazazwikAdat‌", "headword": "यवयवकषष्टिकादत्‌", "headword_slp1": "yavayavakazazwikAdat‌", "fold": "yavayavakasaswikadat‌", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix यत् comes in the sense of 'a place of growing, when it is a field' after the words 1. यव 2. यवक and 3. षष्टिक।\n\nTerms: यत्", "gloss_language": "en"}], "synonyms": ["यवयवकषष्टिकादत्‌ ५.२.३", "५.२.३", "५.२.३ यवयवकषष्टिकादत्‌"], "synonyms_slp1": ["yavayavakazazwikAdat‌ ५.२.३", "५.२.३", "५.२.३ yavayavakazazwikAdat‌"]}], "yavadiByaH kan": [{"id": "yAvAdiByaH kan", "headword": "यावादिभ्यः कन्", "headword_slp1": "yAvAdiByaH kan", "fold": "yavadiByaH kan", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix कन् comes after the words याव etc. without changing their sense.\n\nTerms: कन्", "gloss_language": "en"}], "synonyms": ["यावादिभ्यः कन् ५.४.२९", "५.४.२९", "५.४.२९ यावादिभ्यः कन्"], "synonyms_slp1": ["yAvAdiByaH kan ५.४.२९", "५.४.२९", "५.४.२९ yAvAdiByaH kan"]}], "yavadyaTaByam": [{"id": "yAvadyaTAByAm", "headword": "यावद्यथाभ्याम्", "headword_slp1": "yAvadyaTAByAm", "fold": "yavadyaTaByam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The finite verb retains its accent in connection with यावत् and यथा।\n\nTerms: Accent", "gloss_language": "en"}], "synonyms": ["यावद्यथाभ्याम् ८.१.३६", "८.१.३६", "८.१.३६ यावद्यथाभ्याम्"], "synonyms_slp1": ["yAvadyaTAByAm ८.१.३६", "८.१.३६", "८.१.३६ yAvadyaTAByAm"]}]}