, "५.३.२५ किमश्च"], "synonyms_slp1": ["kimaSca ५.३.२५", "५.३.२५", "५.३.२५ kimaSca"]}], "kimetiNavyayaGadamvadravyaprakarse": [{"id": "kimettiNavyayaGAdAmvadravyaprakarze", "headword": "किमेत्तिङव्ययघादाम्वद्रव्यप्रकर्षे", "headword_slp1": "kimettiNavyayaGAdAmvadravyaprakarze", "fold": "kimetiNavyayaGadamvadravyaprakarse", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "To the affixes तर and तम (घ -- तरप्तमपौ घः १.१.२२) ordained to come after the word किम् -- अतिशायने तमबिष्ठनौ ५.३.५५, or after a word ending in ए -- घकालतनेषु कालनाम्नः ६.३.१७, or after a finite verb -- तिङश्च ५.३.५६, द्विवचनविभज्योपपदे तरबीयसुनौ ५.३.५७, or after an indeclinable, is added the affix आम् , but not if the excess belongs to a substance (and not to an action or quality)\n\nTerms: तर and तम", "gloss_language": "en"}], "synonyms": ["किमेत्तिङव्ययघादाम्वद्रव्यप्रकर्षे ५.४.११", "५.४.११", "५.४.११ किमेत्तिङव्ययघादाम्वद्रव्यप्रकर्षे"], "synonyms_slp1": ["kimettiNavyayaGAdAmvadravyaprakarze ५.४.११", "५.४.११", "५.४.११ kimettiNavyayaGAdAmvadravyaprakarze"]}], "kimaH ksepe": [{"id": "kimaH kzepe", "headword": "किमः क्षेपे", "headword_slp1": "kimaH kzepe", "fold": "kimaH ksepe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The समासान्त affix is not applied to a word preceded by किम् in the sense of reproach.\n\nTerms: समासान्त", "gloss_language": "en"}], "synonyms": ["किमः क्षेपे ५.४.७०", "५.४.७०", "५.४.७० किमः क्षेपे"], "synonyms_slp1": ["kimaH kzepe ५.४.७०", "५.४.७०", "५.४.७० kimaH kzepe"]}], "kimaH kaH": [{"id": "kimaH kaH", "headword": "किमः कः", "headword_slp1": "kimaH kaH", "fold": "kimaH kaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "क is substituted for किम् before a विभक्ति affix.\n\nTerms: सर्वनाम", "gloss_language": "en"}], "synonyms": ["किमः कः ७.२.१०३", "७.२.१०३", "७.२.१०३ किमः कः"], "synonyms_slp1": ["kimaH kaH ७.२.१०३", "७.२.१०३", "७.२.१०३ kimaH kaH"]}], "kimvftan ca cidutaram