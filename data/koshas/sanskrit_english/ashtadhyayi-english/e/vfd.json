aKopaDAt‌"]}], "vfdDasya ca": [{"id": "vfdDasya ca", "headword": "वृद्धस्य च", "headword_slp1": "vfdDasya ca", "fold": "vfdDasya ca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "ज्य is also substituted for वृद्ध when the affixes इष्ठन् and इयसुन् follow.\n\nTerms: इष्ठन् and इयसुन्", "gloss_language": "en"}], "synonyms": ["वृद्धस्य च ५.३.६२", "५.३.६२", "५.३.६२ वृद्धस्य च"], "synonyms_slp1": ["vfdDasya ca ५.३.६२", "५.३.६२", "५.३.६२ vfdDasya ca"]}], "vfdDireci": [{"id": "vfdDireci", "headword": "वृद्धिरेचि", "headword_slp1": "vfdDireci", "fold": "vfdDireci", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The वृद्धि is the single substitute of अ or आ of a preceding word and the initial dipthong of the succeeding (अ or आ + dipthong = वृद्धि)।\n\nTerms: संहितायाम्", "gloss_language": "en"}], "synonyms": ["वृद्धिरेचि ६.१.८८", "६.१.८८", "६.१.८८ वृद्धिरेचि"], "synonyms_slp1": ["vfdDireci ६.१.८८", "६.१.८८", "६.१.८८ vfdDireci"]}], "vfdDinimitasya ca tadDitasyaraktavikare": [{"id": "vfdDinimittasya ca tadDitasyAraktavikAre", "headword": "वृद्धिनिमित्तस्य च तद्धितस्यारक्तविकारे", "headword_slp1": "vfdDinimittasya ca tadDitasyAraktavikAre", "fold": "vfdDinimitasya ca tadDitasyaraktavikare", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The feminine is not changed into masculine when it is formed by such a तद्धित affix which causes the वृद्धि of the first syllable with exception however of तद्धित-substitute meaning 'coloured therewith' and 'made thereof'.\n\nTerms: Masculisation", "gloss_language": "en"}], "synonyms": ["वृद्धिनिमित्तस्य च तद्धितस्यारक्तविकारे ६.३.३९", "६.३.३९", "६.३.३९ वृद्धिनिमित्तस्य च तद्धितस्यारक्तविकारे"], "synonyms_slp1": ["vfdDinimittasya ca tadDitasyAraktavikAre ६.३.३९", "६.३.३९", "६.३.३९ vfdDinimittasya ca tadDitasyAraktavikAre"]}]}