{"vfdDiradEc": [{"id": "vfdDirAdEc", "headword": "वृद्धिरादैच्", "headword_slp1": "vfdDirAdEc", "fold": "vfdDiradEc", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "आ, ऐ and औ are called वृद्धि।\n\nTerms: वृद्धि", "gloss_language": "en"}], "synonyms": ["वृद्धिरादैच् १.१.१", "१.१.१", "१.१.१ वृद्धिरादैच्"], "synonyms_slp1": ["vfdDirAdEc १.१.१", "१.१.१", "१.१.१ vfdDirAdEc"]}], "vfdDiryasyacamadistad vfdDam": [{"id": "vfdDiryasyAcAmAdistad vfdDam", "headword": "वृद्धिर्यस्याचामादिस्तद् वृद्धम्", "headword_slp1": "vfdDiryasyAcAmAdistad vfdDam", "fold": "vfdDiryasyacamadistad vfdDam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "That word, among the vowels of which the first is a वृद्धि , is called वृद्धम्। \n\nTerms: वृद्धम्", "gloss_language": "en"}], "synonyms": ["वृद्धिर्यस्याचामादिस्तद् वृद्धम् १.१.७३", "१.१.७३", "१.१.७३ वृद्धिर्यस्याचामादिस्तद् वृद्धम्"], "synonyms_slp1": ["vfdDiryasyAcAmAdistad vfdDam १.१.७३", "१.१.७३", "१.१.७३ vfdDiryasyAcAmAdistad vfdDam"]}], "vfdDo yuna talaksaRascedeva visesaH": [{"id": "vfdDo yUnA tallakzaRaScedeva viSezaH", "headword": "वृद्धो यूना तल्लक्षणश्चेदेव विशेषः", "headword_slp1": "vfdDo yUnA tallakzaRaScedeva viSezaH", "fold": "vfdDo yuna talaksaRascedeva visesaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The वृद्ध (or patronymic गोत्र word becomes एकशेष and is retained, when compounded) with a patronymic word युवन् , provided that the specific difference in form between them be in their signs (affix) only.\n\nTerms: वृद्ध", "gloss_language": "en"}], "synonyms": ["वृद्धो यूना तल्लक्षणश्चेदेव विशेषः १.२.६५", "१.२.६५", "१.२.६५ वृद्धो यूना तल्लक्षणश्चेदेव विशेषः"], "synonyms_slp1": ["vfdDo yUnA tallakzaRaScedeva viSezaH १.२.६५", "१.२.६५", "१.२.६५ vfdDo yUnA tallakzaRaScedeva viSezaH"]}], "vfdByaH syasanoH": [{"id": "vfdByaH syasanoH", "headword": "वृद्भ्यः स्यसनोः", "headword_slp1": "vfdByaH syasanoH", "fold": "vfdByaH syasa