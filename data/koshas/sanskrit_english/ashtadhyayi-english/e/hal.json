७७ hali ca"]}], "hali sarvesam": [{"id": "hali sarvezAm", "headword": "हलि सर्वेषाम्", "headword_slp1": "hali sarvezAm", "fold": "hali sarvesam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "(The य् when preceded by 1. भो 2. भगो 3. अघो 4. अ or 5. आ , is elided) before a consonant according to the opinion of all आचार्रचा-s.\n\nTerms: व् and य् elision", "gloss_language": "en"}], "synonyms": ["हलि सर्वेषाम् ८.३.२२", "८.३.२२", "८.३.२२ हलि सर्वेषाम्"], "synonyms_slp1": ["hali sarvezAm ८.३.२२", "८.३.२२", "८.३.२२ hali sarvezAm"]}], "halasca ijupaDat‌": [{"id": "halaSca ijupaDAt‌", "headword": "हलश्च इजुपधात्‌", "headword_slp1": "halaSca ijupaDAt‌", "fold": "halasca ijupaDat‌", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The कृत् affix, coming after a verb, which begins with a consonant and has a penultimate इच् vowel, changes optionally its न् , which is preceded by a vowel, into ण् , when it comes after उपसर्ग having a cause of change.\n\nTerms: सन्धि-हल्-कृत्-उपसर्ग", "gloss_language": "en"}], "synonyms": ["हलश्च इजुपधात्‌ ८.४.३१", "८.४.३१", "८.४.३१ हलश्च इजुपधात्‌"], "synonyms_slp1": ["halaSca ijupaDAt‌ ८.४.३१", "८.४.३१", "८.४.३१ halaSca ijupaDAt‌"]}], "halo yaman yami lopaH": [{"id": "halo yamAM yami lopaH", "headword": "हलो यमां यमि लोपः", "headword_slp1": "halo yamAM yami lopaH", "fold": "halo yaman yami lopaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After a consonant, the following semi-vowel or a nasal is elided optionally, when the same letters follow it\n\nTerms:", "gloss_language": "en"}], "synonyms": ["हलो यमां यमि लोपः ८.४.६४", "८.४.६४", "८.४.६४ हलो यमां यमि लोपः"], "synonyms_slp1": ["halo yamAM yami lopaH ८.४.६४", "८.४.६४", "८.४.६४ halo yamAM yami lopaH"]}]}