{"naksatre ca lupi": [{"id": "nakzatre ca lupi", "headword": "नक्षत्रे च लुपि", "headword_slp1": "nakzatre ca lupi", "fold": "naksatre ca lupi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "When an affix declaring the time of an Asterism is elided by लुप् -- लुबविशेषे ४.२.४, the 7th and the 3rd case-affixes are used after the word, whose affix is also elided.\n\nTerms: विभक्ति-3, 7", "gloss_language": "en"}], "synonyms": ["नक्षत्रे च लुपि २.३.४५", "२.३.४५", "२.३.४५ नक्षत्रे च लुपि"], "synonyms_slp1": ["nakzatre ca lupi २.३.४५", "२.३.४५", "२.३.४५ nakzatre ca lupi"]}], "naksatreRa yuktaH kalaH": [{"id": "nakzatreRa yuktaH kAlaH", "headword": "नक्षत्रेण युक्तः कालः", "headword_slp1": "nakzatreRa yuktaH kAlaH", "fold": "naksatreRa yuktaH kalaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix अण् already ordained -- प्राग्दीव्यतोऽण् ४.१.८३, comes after a word in the Instrumental -3rd case in construction which is the name of a lunar mansion, to signify a time connected with the asterism.\n\nTerms: अण्", "gloss_language": "en"}], "synonyms": ["नक्षत्रेण युक्तः कालः ४.२.३", "४.२.३", "४.२.३ नक्षत्रेण युक्तः कालः"], "synonyms_slp1": ["nakzatreRa yuktaH kAlaH ४.२.३", "४.२.३", "४.२.३ nakzatreRa yuktaH kAlaH"]}], "naksatreByo bahulam": [{"id": "nakzatreByo bahulam", "headword": "नक्षत्रेभ्यो बहुलम्", "headword_slp1": "nakzatreByo bahulam", "fold": "naksatreByo bahulam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "There is diversely लुक् elision of the affix denoting 'born therein' after an asterism.\n\nTerms: लुक्", "gloss_language": "en"}], "synonyms": ["नक्षत्रेभ्यो बहुलम् ४.३.३७", "४.३.३७", "४.३.३७ नक्षत्रेभ्यो बहुलम्"], "synonyms_slp1": ["nakzatreByo bahulam ४.३.३७", "४.३.३७", "४.३.३७ nakzatreByo bahulam"]}], "naksatradGaH": [{"id": "nakzatrAdGaH", "headword": "नक्षत्राद्घः", "headword_slp1": "nakzatrAdGaH", "fold": "naksatradGaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix घ comes in the छन्दस् (Vedas) after the word नक्षत्र without altering the meaning.\n\nTerms: घ", "gloss_language": "en"}], "synonyms": ["नक्षत्राद्घः ४.४.१४१", "४.४.१४१", "४.४.१४१ नक्षत्राद्घः"], "synonyms_slp1": ["nakzatrAdGaH ४.४.१४१", "४.४.१४१", "४.४.१४१ nakzatrAdGaH"]}], "naksatradva": [{"id": "nakzatrAdvA", "headword": "नक्षत्राद्वा", "headword_slp1": "nakzatrAdvA", "fold": "naksatradva", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "ष् is optionally substituted for the स् when the preceding word is the name of a Lunar mansion.\n\nTerms: षत्व change", "gloss_language": "en"}], "synonyms": ["नक्षत्राद्वा ८.३.१००", "८.३.१००", "८.३.१०० नक्षत्राद्वा"], "synonyms_slp1": ["nakzatrAdvA ८.३.१००", "८.३.१००", "८.३.१०० nakzatrAdvA"]}]}