{"acitahastiDenosWak": [{"id": "acittahastiDenozWak", "headword": "अचित्तहस्तिधेनोष्ठक्", "headword_slp1": "acittahastiDenozWak", "fold": "acitahastiDenosWak", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix ठक् comes in the sense of 'collection thereof' after the names of things without consciousness and after 1. हस्ति and 2. धेनु।\n\nTerms: ठक्", "gloss_language": "en"}], "synonyms": ["अचित्तहस्तिधेनोष्ठक् ४.२.४७", "४.२.४७", "४.२.४७ अचित्तहस्तिधेनोष्ठक्"], "synonyms_slp1": ["acittahastiDenozWak ४.२.४७", "४.२.४७", "४.२.४७ acittahastiDenozWak"]}], "acitadadesakalawWak": [{"id": "acittAdadeSakAlAwWak", "headword": "अचित्ताददेशकालाट्ठक्", "headword_slp1": "acittAdadeSakAlAwWak", "fold": "acitadadesakalawWak", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After a word denoting a thing not having consciousness, but not being the name of a country or time, the affix ठक् is used in the sense of 'this is his object of devotion or love'.\n\nTerms: ठक्", "gloss_language": "en"}], "synonyms": ["अचित्ताददेशकालाट्ठक् ४.३.९६", "४.३.९६", "४.३.९६ अचित्ताददेशकालाट्ठक्"], "synonyms_slp1": ["acittAdadeSakAlAwWak ४.३.९६", "४.३.९६", "४.३.९६ acittAdadeSakAlAwWak"]}], "aci sirsaH": [{"id": "aci SIrzaH", "headword": "अचि शीर्षः", "headword_slp1": "aci SIrzaH", "fold": "aci sirsaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "There is the substitution of शीर्ष for शीरस् when a तद्धित-affix beginning with a vowel follows.\n\nTerms: तद्धित", "gloss_language": "en"}], "synonyms": ["अचि शीर्षः ६.१.६२", "६.१.६२", "६.१.६२ अचि शीर्षः"], "synonyms_slp1": ["aci SIrzaH ६.१.६२", "६.१.६२", "६.१.६२ aci SIrzaH"]}], "aci snuDatuBruvan yvoriyaNuvaNO": [{"id": "aci SnuDAtuBruvAM yvoriyaNuvaNO", "headword": "अचि श्नुधातुभ्रुवां य्वोरियङुवङौ", "headword_slp1": "aci SnuDAtuBruvAM yvoriyaNuvaNO", "fold": "aci snuDatuBruvan yvoriyaNuvaNO", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "Before an affix beginning with a vowel there are substituted for उ of नु , the characteristic of the roots of the स्वादिगणः (5th Conjugation) for the final इ , ई , उ and ऊ of a root, as well as for ऊ of भ्रू , the इय् (for इ or ई) and उव् (for उ or ऊ).\n\nTerms: इवङ्-उवङ्", "gloss_language": "en"}], "synonyms": ["अचि श्नुधातुभ्रुवां य्वोरियङुवङौ ६.४.७७", "६.४.७७", "६.४.७७ अचि श्नुधातुभ्रुवां य्वोरियङुवङौ"], "synonyms_slp1": ["aci SnuDAtuBruvAM yvoriyaNuvaNO ६.४.७७", "६.४.७७", "६.४.७७ aci SnuDAtuBruvAM yvoriyaNuvaNO"]}], "aci ra ftaH": [{"id": "aci ra ftaH", "headword": "अचि र ऋतः", "headword_slp1": "aci ra ftaH", "fold": "aci ra ftaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "र् is substituted for ऋ of तिसृ and चतसृ before the case-affixes beginning with a vowel.\n\nTerms: सर्वनाम", "gloss_language": "en"}], "synonyms": ["अचि र ऋतः ७.२.१००", "७.२.१००", "७.२.१०० अचि र ऋतः"], "synonyms_slp1": ["aci ra ftaH ७.२.१००", "७.२.१००", "७.२.१०० aci ra ftaH"]}], "aci viBasa": [{"id": "aci viBAzA", "headword": "अचि विभाषा", "headword_slp1": "aci viBAzA", "fold": "aci viBasa", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "ल् is optionally changed to ल् before an affix beginning with a vowel.\n\nTerms: र् changed to ल्", "gloss_language": "en"}], "synonyms": ["अचि विभाषा ८.२.२१", "८.२.२१", "८.२.२१ अचि विभाषा"], "synonyms_slp1": ["aci viBAzA ८.२.२१", "८.२.२१", "८.२.२१ aci viBAzA"]}]}