{"saBa rajamanusyapurva": [{"id": "saBA rAjA'manuzyapUrvA", "headword": "सभा राजाऽमनुष्यपूर्वा", "headword_slp1": "saBA rAjA'manuzyapUrvA", "fold": "saBa rajamanusyapurva", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "A तत्-पुरुष compound ending with the word सभा 'court' is neuter, provided that it is preceded by (a word synonymous with) the word राजा or by a word denoting a non-human-being. \n\nTerms: समास-तत्-पुरुष-gender", "gloss_language": "en"}], "synonyms": ["सभा राजाऽमनुष्यपूर्वा २.४.२३", "२.४.२३", "२.४.२३ सभा राजाऽमनुष्यपूर्वा"], "synonyms_slp1": ["saBA rAjA'manuzyapUrvA २.४.२३", "२.४.२३", "२.४.२३ saBA rAjA'manuzyapUrvA"]}], "saBaya yaH": [{"id": "saBAyA yaH", "headword": "सभाया यः", "headword_slp1": "saBAyA yaH", "fold": "saBaya yaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix यत् comes in the sense of 'excellent with regard thereto' after the word सभा ।\n\nTerms: यत्", "gloss_language": "en"}], "synonyms": ["सभाया यः ४.४.१०५", "४.४.१०५", "४.४.१०५ सभाया यः"], "synonyms_slp1": ["saBAyA yaH ४.४.१०५", "४.४.१०५", "४.४.१०५ saBAyA yaH"]}], "saBayan napunsake": [{"id": "saBAyAM napuMsake", "headword": "सभायां नपुंसके", "headword_slp1": "saBAyAM napuMsake", "fold": "saBayan napunsake", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "Before the word सभा when it is exhibited as Neuter, the first member of the compound gets the acute accent (उदात्त) on the last syllable.\n\nTerms: समास end acute-1st-term", "gloss_language": "en"}], "synonyms": ["सभायां नपुंसके ६.२.९८", "६.२.९८", "६.२.९८ सभायां नपुंसके"], "synonyms_slp1": ["saBAyAM napuMsake ६.२.९८", "६.२.९८", "६.२.९८ saBAyAM napuMsake"]}]}