", "senses": [{"gloss": "The affixes which are used when the sense is that of present time, may, optionally in like manner, be used when the sense is that of past or future time not remote from the present.\n\nTerms:", "gloss_language": "en"}], "synonyms": ["वर्तमानसामीप्ये वर्तमानवद्वा ३.३.१३१", "३.३.१३१", "३.३.१३१ वर्तमानसामीप्ये वर्तमानवद्वा"], "synonyms_slp1": ["vartamAnasAmIpye vartamAnavadvA ३.३.१३१", "३.३.१३१", "३.३.१३१ vartamAnasAmIpye vartamAnavadvA"]}], "varsapramaRa ulopascasyanyatarasyam": [{"id": "varzapramARa UlopaScAsyAnyatarasyAm", "headword": "वर्षप्रमाण ऊलोपश्चास्यान्यतरस्याम्", "headword_slp1": "varzapramARa UlopaScAsyAnyatarasyAm", "fold": "varsapramaRa ulopascasyanyatarasyam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix णमुल् comes after the verb पुर् 'to fill' when the word so formed expresses a measure of rainfall and optionally the long ऊ of this पुर् is elided.\n\nTerms: णमुल्", "gloss_language": "en"}], "synonyms": ["वर्षप्रमाण ऊलोपश्चास्यान्यतरस्याम् ३.४.३२", "३.४.३२", "३.४.३२ वर्षप्रमाण ऊलोपश्चास्यान्यतरस्याम्"], "synonyms_slp1": ["varzapramARa UlopaScAsyAnyatarasyAm ३.४.३२", "३.४.३२", "३.४.३२ varzapramARa UlopaScAsyAnyatarasyAm"]}], "varRadanudatatopaDato naH": [{"id": "varRAdanudAttAttopaDAtto naH", "headword": "वर्णादनुदात्तात्तोपधात्तो नः", "headword_slp1": "varRAdanudAttAttopaDAtto naH", "fold": "varRadanudatatopaDato naH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix ङीप् is optionally used after a प्रातिपदिक (Nominal Stem) expressive of colour ending with a gravely accented vowel and having the letter त् as its penultimate letter and the letter न् is substituted in the room of त्।\n\nTerms: विभक्ति-ङीप्", "gloss_language": "en"}], "synonyms": ["वर्णादनुदात्तात्तोपधात्तो नः ४.१.३९", "४.१.३९", "४.१.३९ वर्णादनुदात्तात्तोपधात्तो नः"], "synonyms_slp1": ["varRAdanudAttAttopaDAtto naH ४.१.३९", "४.१.३९", "४.१.३९ varRAdanudAttAttopaDAtto naH"]}], 