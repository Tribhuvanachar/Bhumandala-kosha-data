{"saDakataman karaRam": [{"id": "sADakatamaM karaRam", "headword": "साधकतमं करणम्", "headword_slp1": "sADakatamaM karaRam", "fold": "saDakataman karaRam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "That which is especially auxiliary in the accomplishment of the action is called Instrument or करण कारक।\n\nTerms: कारक-सम्प्रदान", "gloss_language": "en"}], "synonyms": ["साधकतमं करणम् १.४.४२", "१.४.४२", "१.४.४२ साधकतमं करणम्"], "synonyms_slp1": ["sADakatamaM karaRam १.४.४२", "१.४.४२", "१.४.४२ sADakatamaM karaRam"]}], "saDunipuRaByam arcayan saptamyaprateH": [{"id": "sADunipuRAByAm arcAyAM saptamyaprateH", "headword": "साधुनिपुणाभ्याम् अर्चायां सप्तम्यप्रतेः", "headword_slp1": "sADunipuRAByAm arcAyAM saptamyaprateH", "fold": "saDunipuRaByam arcayan saptamyaprateH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "In conjunction with the words साधु 'good' and निपुण 'skilfull' when they denote respect, the 7th case-affix is used, provided that the word प्रति is not used.\n\nTerms: विभक्ति-7", "gloss_language": "en"}], "synonyms": ["साधुनिपुणाभ्याम् अर्चायां सप्तम्यप्रतेः २.३.४३", "२.३.४३", "२.३.४३ साधुनिपुणाभ्याम् अर्चायां सप्तम्यप्रतेः"], "synonyms_slp1": ["sADunipuRAByAm arcAyAM saptamyaprateH २.३.४३", "२.३.४३", "२.३.४३ sADunipuRAByAm arcAyAM saptamyaprateH"]}], "saDa madasTayosCandasi": [{"id": "saDa mAdasTayoSCandasi", "headword": "सध मादस्थयोश्छन्दसि", "headword_slp1": "saDa mAdasTayoSCandasi", "fold": "saDa madasTayosCandasi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "सध is substituted for सह in the छन्दस् (Vedas) when माद and स्थ follow.\n\nTerms: Some Substitution", "gloss_language": "en"}], "synonyms": ["सध मादस्थयोश्छन्दसि ६.३.९६", "६.३.९६", "६.३.९६ सध मादस्थयोश्छन्दसि"], "synonyms_slp1": ["saDa mAdasTayoSCandasi ६.३.९६", "६.३.९६", "६.३.९६ saDa mAdasTayoSCandasi"]}]}