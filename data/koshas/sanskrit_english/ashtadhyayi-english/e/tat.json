sh", "senses": [{"gloss": "The word तत्र 'there' which is a word ending with Locative -7th-case-affix सप्तम्यास्त्रल् ५.३.१०, is compounded with a word ending in क्त and the resulting compound is तत्-पुरुष ।\n\nTerms: समास-तत्-पुरुष", "gloss_language": "en"}], "synonyms": ["तत्र २.१.४६", "२.१.४६", "२.१.४६ तत्र"], "synonyms_slp1": ["tatra २.१.४६", "२.१.४६", "२.१.४६ tatra"]}], "tatra tenedamiti sarupe": [{"id": "tatra tenedamiti sarUpe", "headword": "तत्र तेनेदमिति सरूपे", "headword_slp1": "tatra tenedamiti sarUpe", "fold": "tatra tenedamiti sarupe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "Two homonymous words (both being in the locative case or both being in the instrumental case) are compounded, the sense being 'this happens therein or with that'. The compound so formed is बहुव्रीही।\n\nTerms: समास-बहुव्रीही", "gloss_language": "en"}], "synonyms": ["तत्र तेनेदमिति सरूपे २.२.२७", "२.२.२७", "२.२.२७ तत्र तेनेदमिति सरूपे"], "synonyms_slp1": ["tatra tenedamiti sarUpe २.२.२७", "२.२.२७", "२.२.२७ tatra tenedamiti sarUpe"]}], "tatpurusonaY‌ karmaDarayaH": [{"id": "tatpuruzo'naY‌ karmaDArayaH", "headword": "तत्पुरुषोऽनञ्‌ कर्मधारयः", "headword_slp1": "tatpuruzo'naY‌ karmaDArayaH", "fold": "tatpurusonaY‌ karmaDarayaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "A तत्-पुरुष compound, with the exception of that which is formed by the particle नञ् , and or the कर्मधारय compound, becomes neuter gender, in the cases explained in the following sūtras.\n\nTerms: समास-तत्-पुरुष", "gloss_language": "en"}], "synonyms": ["तत्पुरुषोऽनञ्‌ कर्मधारयः २.४.१९", "२.४.१९", "२.४.१९ तत्पुरुषोऽनञ्‌ कर्मधारयः"], "synonyms_slp1": ["tatpuruzo'naY‌ karmaDArayaH २.४.१९", "२.४.१९", "२.४.१९ tatpuruzo'naY‌ karmaDArayaH"]}], "tatropapadan saptamisTam‌": [{"id": "tatropapadaM saptamIsTam‌", "headword": "तत्रोपपदं सप्तमीस्थम्‌", "headword_slp1": "tatropapadaM saptamIsTam‌", "fold": "tatropapadan saptamisTam‌", "headword_language"