{"nalopo naYaH": [{"id": "nalopo naYaH", "headword": "नलोपो नञः", "headword_slp1": "nalopo naYaH", "fold": "nalopo naYaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The न of the Negative Particle नञ् is elided when it is the first member of a compound.\n\nTerms: नुट् Augment", "gloss_language": "en"}], "synonyms": ["नलोपो नञः ६.३.७३", "६.३.७३", "६.३.७३ नलोपो नञः"], "synonyms_slp1": ["nalopo naYaH ६.३.७३", "६.३.७३", "६.३.७३ nalopo naYaH"]}], "nalopaH supsvarasanjYatugviDisu kfti": [{"id": "nalopaH supsvarasaMjYAtugviDizu kfti", "headword": "नलोपः सुप्स्वरसंज्ञातुग्विधिषु कृति", "headword_slp1": "nalopaH supsvarasaMjYAtugviDizu kfti", "fold": "nalopaH supsvarasanjYatugviDisu kfti", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The elision of a final न् -- नलोपः प्रातिपदिकान्तस्य ८.२.७, is considered as if not to have taken effect, in applying the following rules - 1. rules regarding case-endings 2. rules regarding accents 3. rules regarding any technical term of Grammar and 4. rules regarding the augment त् before a कृत् affix.\n\nTerms: असिद्ध", "gloss_language": "en"}], "synonyms": ["नलोपः सुप्स्वरसंज्ञातुग्विधिषु कृति ८.२.२", "८.२.२", "८.२.२ नलोपः सुप्स्वरसंज्ञातुग्विधिषु कृति"], "synonyms_slp1": ["nalopaH supsvarasaMjYAtugviDizu kfti ८.२.२", "८.२.२", "८.२.२ nalopaH supsvarasaMjYAtugviDizu kfti"]}], "nalopaH pratipadikantasya": [{"id": "nalopaH prAtipadikAntasya", "headword": "नलोपः प्रातिपदिकान्तस्य", "headword_slp1": "nalopaH prAtipadikAntasya", "fold": "nalopaH pratipadikantasya", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The न् at the end of a nominal-stem, which is a पद -- शेषो घ्यसखि १.४.७, is elided.\n\nTerms: Accent", "gloss_language": "en"}], "synonyms": ["नलोपः प्रातिपदिकान्तस्य ८.२.७", "८.२.७", "८.२.७ नलोपः प्रातिपदिकान्तस्य"], "synonyms_slp1": ["nalopaH prAtipadikAntasya ८.२.७", "८.२.७", "८.२.७ nalopaH prAtipadikAntasya"]}]}