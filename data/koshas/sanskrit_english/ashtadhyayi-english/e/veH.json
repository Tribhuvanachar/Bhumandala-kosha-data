{"veH sabdakarmaRaH": [{"id": "veH SabdakarmmaRaH", "headword": "वेः शब्दकर्म्मणः", "headword_slp1": "veH SabdakarmmaRaH", "fold": "veH sabdakarmaRaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After the verb कृ preceded by वि , even when the fruit of the action does not accrue to the agent, and when the sense is that of 'making sound' (literally having 'sound' for its object), the आत्मनेपद affix is used.\n\nTerms: आत्मनेपद", "gloss_language": "en"}], "synonyms": ["वेः शब्दकर्म्मणः १.३.३४", "१.३.३४", "१.३.३४ वेः शब्दकर्म्मणः"], "synonyms_slp1": ["veH SabdakarmmaRaH १.३.३४", "१.३.३४", "१.३.३४ veH SabdakarmmaRaH"]}], "veH padaviharaRe": [{"id": "veH pAdaviharaRe", "headword": "वेः पादविहरणे", "headword_slp1": "veH pAdaviharaRe", "fold": "veH padaviharaRe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After the verb क्रम् preceded by वि , the आत्मनेपद is used, when in the sense of 'placing of foot-steps'.\n\nTerms: आत्मनेपद", "gloss_language": "en"}], "synonyms": ["वेः पादविहरणे १.३.४१", "१.३.४१", "१.३.४१ वेः पादविहरणे"], "synonyms_slp1": ["veH pAdaviharaRe १.३.४१", "१.३.४१", "१.३.४१ veH pAdaviharaRe"]}], "veH salacCaNkawacO": [{"id": "veH SAlacCaNkawacO", "headword": "वेः शालच्छङ्कटचौ", "headword_slp1": "veH SAlacCaNkawacO", "fold": "veH salacCaNkawacO", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affixes शालच् (शाल) and शङ्कटच् (शङ्कट) come after the preposition वि without changing the sense.\n\nTerms: शालच् (शाल) and शङ्कटच् (शङ्कट)", "gloss_language": "en"}], "synonyms": ["वेः शालच्छङ्कटचौ ५.२.२८", "५.२.२८", "५.२.२८ वेः शालच्छङ्कटचौ"], "synonyms_slp1": ["veH SAlacCaNkawacO ५.२.२८", "५.२.२८", "५.२.२८ veH SAlacCaNkawacO"]}], "veH skanderanisWayam": [{"id": "veH skanderanizWAyAm", "headword": "वेः स्कन्देरनिष्ठायाम्", "headword_slp1": "veH skanderanizWAyAm", "fold": "veH skanderanisWayam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "ष् is optionally the substitute of the स् of स्कन्द् after the उपसर्ग (Preposition) वि but not in the participles in त and तवत।\n\nTerms: षत्व change", "gloss_language": "en"}], "synonyms": ["वेः स्कन्देरनिष्ठायाम् ८.३.७३", "८.३.७३", "८.३.७३ वेः स्कन्देरनिष्ठायाम्"], "synonyms_slp1": ["veH skanderanizWAyAm ८.३.७३", "८.३.७३", "८.३.७३ veH skanderanizWAyAm"]}], "veH skaBnaternityam": [{"id": "veH skaBnAternityam", "headword": "वेः स्कभ्नातेर्नित्यम्", "headword_slp1": "veH skaBnAternityam", "fold": "veH skaBnaternityam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "ष् is always the substitute of the स् of स्कम्भ after the उपसर्ग (Preposition) वि।\n\nTerms: cerebral change", "gloss_language": "en"}], "synonyms": ["वेः स्कभ्नातेर्नित्यम् ८.३.७७", "८.३.७७", "८.३.७७ वेः स्कभ्नातेर्नित्यम्"], "synonyms_slp1": ["veH skaBnAternityam ८.३.७७", "८.३.७७", "८.३.७७ veH skaBnAternityam"]}]}