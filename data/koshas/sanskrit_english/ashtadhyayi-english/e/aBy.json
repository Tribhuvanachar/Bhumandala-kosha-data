yayi-english", "senses": [{"gloss": "The acute accent falls on the first syllable of the reduplicate verbs when followed by an affix beginning with a vowel (the vowel being not नुट्) and being a सार्वधातुक Personal-ending.\n\nTerms: accent-तिङ्", "gloss_language": "en"}], "synonyms": ["अभ्यस्तानामादिः ६.१.१८९", "६.१.१८९", "६.१.१८९ अभ्यस्तानामादिः"], "synonyms_slp1": ["aByastAnAmAdiH ६.१.१८९", "६.१.१८९", "६.१.१८९ aByastAnAmAdiH"]}], "aByasasyasavarRe": [{"id": "aByAsasyAsavarRe", "headword": "अभ्यासस्यासवर्णे", "headword_slp1": "aByAsasyAsavarRe", "fold": "aByasasyasavarRe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "इवङ् and उवङ् are substituted for the इ and उ of a reduplicate, before a non-homogeneous vowel.\n\nTerms: इवङ्-उवङ्", "gloss_language": "en"}], "synonyms": ["अभ्यासस्यासवर्णे ६.४.७८", "६.४.७८", "६.४.७८ अभ्यासस्यासवर्णे"], "synonyms_slp1": ["aByAsasyAsavarRe ६.४.७८", "६.४.७८", "६.४.७८ aByAsasyAsavarRe"]}], "aByasaca": [{"id": "aByAsAcca", "headword": "अभ्यासाच्च", "headword_slp1": "aByAsAcca", "fold": "aByasaca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "A guttural is substituted for the ह् in हन् 'to kill' after reduplication also.\n\nTerms: Guttarlisation", "gloss_language": "en"}], "synonyms": ["अभ्यासाच्च ७.३.५५", "७.३.५५", "७.३.५५ अभ्यासाच्च"], "synonyms_slp1": ["aByAsAcca ७.३.५५", "७.३.५५", "७.३.५५ aByAsAcca"]}], "aByase carca": [{"id": "aByAse carcca", "headword": "अभ्यासे चर्च्च", "headword_slp1": "aByAse carcca", "fold": "aByase carca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The चर् is also substitute of झल् letters occuring in a reduplicate syllable, as well as जश्।\n\nTerms:", "gloss_language": "en"}], "synonyms": ["अभ्यासे चर्च्च ८.४.५४", "८.४.५४", "८.४.५४ अभ्यासे चर्च्च"], "synonyms_slp1": ["aByAse carcca ८.४.५४", "८.४.५४", "८.४.५४ aByAse carcca"]}]}