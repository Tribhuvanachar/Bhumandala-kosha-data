{"ojasahomBasa vartate": [{"id": "ojassaho'mBasA vartate", "headword": "ओजस्सहोऽम्भसा वर्तते", "headword_slp1": "ojassaho'mBasA vartate", "fold": "ojasahomBasa vartate", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix ठक् comes in the sense of 'it exists' after the words 1. ओजस् 2. सहस् and 3. अभस् being in the Instrumental -3rd case in construction.\n\nTerms: ठक्", "gloss_language": "en"}], "synonyms": ["ओजस्सहोऽम्भसा वर्तते ४.४.२७", "४.४.२७", "४.४.२७ ओजस्सहोऽम्भसा वर्तते"], "synonyms_slp1": ["ojassaho'mBasA vartate ४.४.२७", "४.४.२७", "४.४.२७ ojassaho'mBasA vartate"]}], "ojasohani yatKO": [{"id": "ojaso'hani yatKO", "headword": "ओजसोऽहनि यत्खौ", "headword_slp1": "ojaso'hani yatKO", "fold": "ojasohani yatKO", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affixes यत् and ख come with the force of मतुप् after the word ओजस् when 'a day' is meant.\n\nTerms: यत् and ख", "gloss_language": "en"}], "synonyms": ["ओजसोऽहनि यत्खौ ४.४.१३०", "४.४.१३०", "४.४.१३० ओजसोऽहनि यत्खौ"], "synonyms_slp1": ["ojaso'hani yatKO ४.४.१३०", "४.४.१३०", "४.४.१३० ojaso'hani yatKO"]}], "ojaHsahomBastamasaH tftiyayaH": [{"id": "ojaHsaho'mBastamasaH tftIyAyAH", "headword": "ओजःसहोऽम्भस्तमसः तृतीयायाः", "headword_slp1": "ojaHsaho'mBastamasaH tftIyAyAH", "fold": "ojaHsahomBastamasaH tftiyayaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The Instrumental -3rd case endings after 1. ओजस् 2. सहस् 3. अम्भस् and 4. तमस् are not elided before the second member of a compound.\n\nTerms: विभक्ति-Non-elision", "gloss_language": "en"}], "synonyms": ["ओजःसहोऽम्भस्तमसः तृतीयायाः ६.३.३", "६.३.३", "६.३.३ ओजःसहोऽम्भस्तमसः तृतीयायाः"], "synonyms_slp1": ["ojaHsaho'mBastamasaH tftIyAyAH ६.३.३", "६.३.३", "६.३.३ ojaHsaho'mBastamasaH tftIyAyAH"]}]}