{"aNo donasyaviharaRe": [{"id": "ANo do'nAsyaviharaRe", "headword": "आङो दोऽनास्यविहरणे", "headword_slp1": "ANo do'nAsyaviharaRe", "fold": "aNo donasyaviharaRe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After the verb दा 'to give', preceded by अङ् , and when not meaning 'to open the mouth', the आत्मनेपद affix is used, even when the fruit of the action does not accrue to the agent.\n\nTerms: आत्मनेपद", "gloss_language": "en"}], "synonyms": ["आङो दोऽनास्यविहरणे १.३.२०", "१.३.२०", "१.३.२० आङो दोऽनास्यविहरणे"], "synonyms_slp1": ["ANo do'nAsyaviharaRe १.३.२०", "१.३.२०", "१.३.२० ANo do'nAsyaviharaRe"]}], "aNo yamahanaH": [{"id": "ANo yamahanaH", "headword": "आङो यमहनः", "headword_slp1": "ANo yamahanaH", "fold": "aNo yamahanaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After the verb यम् 'to stop' and हन् 'to injure', when used intransitively and preceded by अन् , the आत्मनेपद affix is used.\n\nTerms: आत्मनेपद", "gloss_language": "en"}], "synonyms": ["आङो यमहनः १.३.२८", "१.३.२८", "१.३.२८ आङो यमहनः"], "synonyms_slp1": ["ANo yamahanaH १.३.२८", "१.३.२८", "१.३.२८ ANo yamahanaH"]}], "aNonunasikasCandasi": [{"id": "ANo'nunAsikaSCandasi", "headword": "आङोऽनुनासिकश्छन्दसि", "headword_slp1": "ANo'nunAsikaSCandasi", "fold": "aNonunasikasCandasi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "For the adverb आ , is substituted in the छन्दस् the nasalised आँ , when a vowel follows it, and it retains its original form.\n\nTerms: संहितायाम्", "gloss_language": "en"}], "synonyms": ["आङोऽनुनासिकश्छन्दसि ६.१.१२६", "६.१.१२६", "६.१.१२६ आङोऽनुनासिकश्छन्दसि"], "synonyms_slp1": ["ANo'nunAsikaSCandasi ६.१.१२६", "६.१.१२६", "६.१.१२६ ANo'nunAsikaSCandasi"]}], "aNo yi": [{"id": "ANo yi", "headword": "आङो यि", "headword_slp1": "ANo yi", "fold": "aNo yi", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The augment नुम् is added to लभ् 'to get' preceded by आ before an affix beginning with य।\n\nTerms: नुम् augment", "gloss_language": "en"}], "synonyms": ["आङो यि ७.१.६५", "७.१.६५", "७.१.६५ आङो यि"], "synonyms_slp1": ["ANo yi ७.१.६५", "७.१.६५", "७.१.६५ ANo yi"]}], "aNo nastriyam": [{"id": "ANo nA'striyAm", "headword": "आङो नाऽस्त्रियाम्", "headword_slp1": "ANo nA'striyAm", "fold": "aNo nastriyam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "ना is substituted for the ending आ of the Instrumental -3rd case singular, after the घि अङ्ग (stems) when they are not feminine.\n\nTerms: घि विभक्ति", "gloss_language": "en"}], "synonyms": ["आङो नाऽस्त्रियाम् ७.३.१२०", "७.३.१२०", "७.३.१२० आङो नाऽस्त्रियाम्"], "synonyms_slp1": ["ANo nA'striyAm ७.३.१२०", "७.३.१२०", "७.३.१२० ANo nA'striyAm"]}]}