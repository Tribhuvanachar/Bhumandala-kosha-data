{"Buvadayo DatavaH": [{"id": "BUvAdayo DAtavaH", "headword": "भूवादयो धातवः", "headword_slp1": "BUvAdayo DAtavaH", "fold": "Buvadayo DatavaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The words beginning with भू 'to become' and denoting action, are called धातु or verbal roots.\n\nTerms: धातु", "gloss_language": "en"}], "synonyms": ["भूवादयो धातवः १.३.१", "१.३.१", "१.३.१ भूवादयो धातवः"], "synonyms_slp1": ["BUvAdayo DAtavaH १.३.१", "१.३.१", "१.३.१ BUvAdayo DAtavaH"]}], "BuvaH praBavaH": [{"id": "BuvaH praBavaH", "headword": "भुवः प्रभवः", "headword_slp1": "BuvaH praBavaH", "fold": "BuvaH praBavaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The source of the agent of the verb भू 'to become' is called अपादान।\n\nTerms: कारक-अपादान", "gloss_language": "en"}], "synonyms": ["भुवः प्रभवः १.४.३१", "१.४.३१", "१.४.३१ भुवः प्रभवः"], "synonyms_slp1": ["BuvaH praBavaH १.४.३१", "१.४.३१", "१.४.३१ BuvaH praBavaH"]}], "Buvo Bave": [{"id": "Buvo BAve", "headword": "भुवो भावे", "headword_slp1": "Buvo BAve", "fold": "Buvo Bave", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After the root भू 'to be', in construction with a case-inflected word as its उपपद and when used without a preposition, the affix क्यप् is used to denote condition - भाव।\n\nTerms: Irregular", "gloss_language": "en"}], "synonyms": ["भुवो भावे ३.१.१०७", "३.१.१०७", "३.१.१०७ भुवो भावे"], "synonyms_slp1": ["Buvo BAve ३.१.१०७", "३.१.१०७", "३.१.१०७ Buvo BAve"]}], "Buvasca": [{"id": "BuvaSca", "headword": "भुवश्च", "headword_slp1": "BuvaSca", "fold": "Buvasca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix इष्णुच् in the sense of 'the agent having such a habit etc.' comes in the छन्दस् (Vedas) after the verb भू 'to be' etc.\n\nTerms: छन्दस् इष्णुच्", "gloss_language": "en"}, {"gloss": "The affix ङीष् is always used in the छन्दस् (Vedas) in forming the feminine after the word भु।\n\nTerms: विभक्ति-ङीष्", "gloss_language": "en"}], "synonyms": ["भुवश्च ३.२.१३८", "भुवश्च ४.१.४७", "३.२.१३८", "३.२.१३८ भुवश्च", "४.१.४७", "४.१.४७ भुवश्च"], "synonyms_slp1": ["BuvaSca ३.२.१३८", "BuvaSca ४.१.४७", "३.२.१३८", "३.२.१३८ BuvaSca", "४.१.४७", "४.१.४७ BuvaSca"]}], "BuvaH sanjYantarayoH": [{"id": "BuvaH saMjYA'ntarayoH", "headword": "भुवः संज्ञाऽन्तरयोः", "headword_slp1": "BuvaH saMjYA'ntarayoH", "fold": "BuvaH sanjYantarayoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix क्विप् comes after the verb भू 'to be' when the word so formed denotes a name or surety.\n\nTerms: क्विप्", "gloss_language": "en"}], "synonyms": ["भुवः संज्ञाऽन्तरयोः ३.२.१७९", "३.२.१७९", "३.२.१७९ भुवः संज्ञाऽन्तरयोः"], "synonyms_slp1": ["BuvaH saMjYA'ntarayoH ३.२.१७९", "३.२.१७९", "३.२.१७९ BuvaH saMjYA'ntarayoH"]}], "Buvo vugluNliwoH": [{"id": "Buvo vugluNliwoH", "headword": "भुवो वुग्लुङ्लिटोः", "headword_slp1": "Buvo vugluNliwoH", "fold": "Buvo vugluNliwoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "भू gets the augment व् (वुक्) before the tense-affixes of the Aorist and the Perfect, when beginning with a vowel.\n\nTerms: Semi-vowel substitution", "gloss_language": "en"}], "synonyms": ["भुवो वुग्लुङ्लिटोः ६.४.८८", "६.४.८८", "६.४.८८ भुवो वुग्लुङ्लिटोः"], "synonyms_slp1": ["Buvo vugluNliwoH ६.४.८८", "६.४.८८", "६.४.८८ Buvo vugluNliwoH"]}], "Buvasca mahavyahfteH": [{"id": "BuvaSca mahAvyAhfteH", "headword": "भुवश्च महाव्याहृतेः", "headword_slp1": "BuvaSca mahAvyAhfteH", "fold": "Buvasca mahavyahfteH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "In the छन्दस् (Vedas), both रु and र् may replace the final of the word भुवस् when used as a महाव्याहृति।\n\nTerms: Final Changes", "gloss_language": "en"}], "synonyms": ["भुवश्च महाव्याहृतेः ८.२.७१", "८.२.७१", "८.२.७१ भुवश्च महाव्याहृतेः"], "synonyms_slp1": ["BuvaSca mahAvyAhfteH ८.२.७१", "८.२.७१", "८.२.७१ BuvaSca 