{"mayuravyansakadayasca": [{"id": "mayUravyaMsakAdayaSca", "headword": "मयूरव्यंसकादयश्च", "headword_slp1": "mayUravyaMsakAdayaSca", "fold": "mayuravyansakadayasca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "And the words मयूर-व्यंसका 'cunning like a peacock' etc. are तत्-पुरुष compounds.\n\nTerms: समास-तत्-पुरुष", "gloss_language": "en"}], "synonyms": ["मयूरव्यंसकादयश्च २.१.७२", "२.१.७२", "२.१.७२ मयूरव्यंसकादयश्च"], "synonyms_slp1": ["mayUravyaMsakAdayaSca २.१.७२", "२.१.७२", "२.१.७२ mayUravyaMsakAdayaSca"]}], "mayaw ca": [{"id": "mayaw ca", "headword": "मयट् च", "headword_slp1": "mayaw ca", "fold": "mayaw ca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "After a word denoting a cause or a man viewed as a cause, there is the affix मयट् in the sense of 'come thence'.\n\nTerms: मयट्", "gloss_language": "en"}], "synonyms": ["मयट् च ४.३.८२", "४.३.८२", "४.३.८२ मयट् च"], "synonyms_slp1": ["mayaw ca ४.३.८२", "४.३.८२", "४.३.८२ mayaw ca"]}], "mayaqvEtayorBasayamaBaksyacCadanayoH": [{"id": "mayaqvEtayorBAzAyAmaBakzyAcCAdanayoH", "headword": "मयड्वैतयोर्भाषायामभक्ष्याच्छादनयोः", "headword_slp1": "mayaqvEtayorBAzAyAmaBakzyAcCAdanayoH", "fold": "mayaqvEtayorBasayamaBaksyacCadanayoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix मयट् comes optionally after any base, in these two meanings of 'product' and 'part' in secular language when neither food nor clothing is spoken of.\n\nTerms: मयट्", "gloss_language": "en"}], "synonyms": ["मयड्वैतयोर्भाषायामभक्ष्याच्छादनयोः ४.३.१४३", "४.३.१४३", "४.३.१४३ मयड्वैतयोर्भाषायामभक्ष्याच्छादनयोः"], "synonyms_slp1": ["mayaqvEtayorBAzAyAmaBakzyAcCAdanayoH ४.३.१४३", "४.३.१४३", "४.३.१४३ mayaqvEtayorBAzAyAmaBakzyAcCAdanayoH"]}], "mayayamaR": [{"id": "mAyAyAmaR", "headword": "मायायामण्", "headword_slp1": "mAyAyAmaR", "fold": "mayayamaR", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix अण् comes in the sense of 'glamour' after the word असुर in the Genitive 6th-Case in construction, in the छन्दस् (Vedas).\n\nTerms: अण्", "gloss_language": "en"}], "synonyms": ["मायायामण् ४.४.१२४", "४.४.१२४", "४.४.१२४ मायायामण्"], "synonyms_slp1": ["mAyAyAmaR ४.४.१२४", "४.४.१२४", "४.४.१२४ mAyAyAmaR"]}], "maye ca": [{"id": "maye ca", "headword": "मये च", "headword_slp1": "maye ca", "fold": "maye ca", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix य comes in the छन्दस् (Vedas) after the word सोम with the force of मतुप्।\n\nTerms: य", "gloss_language": "en"}], "synonyms": ["मये च ४.४.१३८", "४.४.१३८", "४.४.१३८ मये च"], "synonyms_slp1": ["maye ca ४.४.१३८", "४.४.१३८", "४.४.१३८ maye ca"]}], "mayateridanyatarasyam": [{"id": "mayateridanyatarasyAm", "headword": "मयतेरिदन्यतरस्याम्", "headword_slp1": "mayateridanyatarasyAm", "fold": "mayateridanyatarasyam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "इ may optionally be substituted for the आ of मा (मयति) before ल्यप् ।\n\nTerms: अ augment", "gloss_language": "en"}], "synonyms": ["मयतेरिदन्यतरस्याम् ६.४.७०", "६.४.७०", "६.४.७० मयतेरिदन्यतरस्याम्"], "synonyms_slp1": ["mayateridanyatarasyAm ६.४.७०", "६.४.७०", "६.४.७० mayateridanyatarasyAm"]}], "maya uYo vo va": [{"id": "maya uYo vo vA", "headword": "मय उञो वो वा", "headword_slp1": "maya uYo vo vA", "fold": "maya uYo vo va", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "व् is optionally the substitute of the Particle उ when it is preceded by मय् consonant (all consonants with the exception of the semi-vowels, sibilants, ह and ञ) and is followed by a vowel.\n\nTerms: व् substitution", "gloss_language": "en"}], "synonyms": ["मय उञो वो वा ८.३.३३", "८.३.३३", "८.३.३३ मय उञो वो वा"], "synonyms_slp1": ["maya uYo vo vA ८.३.३३", "८.३.३३", "८.३.३३ maya uYo vo vA"]}]}