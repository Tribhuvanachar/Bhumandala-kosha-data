language": "en"}], "synonyms": ["ह्रस्वान्तेऽन्त्यात्‌ पूर्वम् ६.२.१७४", "६.२.१७४", "६.२.१७४ ह्रस्वान्तेऽन्त्यात्‌ पूर्वम्"], "synonyms_slp1": ["hrasvAnte'ntyAt‌ pUrvam ६.२.१७४", "६.२.१७४", "६.२.१७४ hrasvAnte'ntyAt‌ pUrvam"]}], "hrasvanadyapo nuw": [{"id": "hrasvanadyApo nuw", "headword": "ह्रस्वनद्यापो नुट्", "headword_slp1": "hrasvanadyApo nuw", "fold": "hrasvanadyapo nuw", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The augment न् is added before the Genitive 6th-Case plural ending आम् after the अङ्ग (stems) ending in a short vowel after अङ्ग (stems) called नदी -- यू स्त्र्याख्यौ नदी १.४.३ etc., and after the अङ्ग (stems) ending in the feminine affix आ।\n\nTerms: नुम् / नुट् augment", "gloss_language": "en"}], "synonyms": ["ह्रस्वनद्यापो नुट् ७.१.५४", "७.१.५४", "७.१.५४ ह्रस्वनद्यापो नुट्"], "synonyms_slp1": ["hrasvanadyApo nuw ७.१.५४", "७.१.५४", "७.१.५४ hrasvanadyApo nuw"]}], "hrasvasya guRaH": [{"id": "hrasvasya guRaH", "headword": "ह्रस्वस्य गुणः", "headword_slp1": "hrasvasya guRaH", "fold": "hrasvasya guRaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "For the short इ and उ final in a nominal-stem, a गुण is substituted in the Vocative Case singular.\n\nTerms: गुण in Feminine", "gloss_language": "en"}], "synonyms": ["ह्रस्वस्य गुणः ७.३.१०८", "७.३.१०८", "७.३.१०८ ह्रस्वस्य गुणः"], "synonyms_slp1": ["hrasvasya guRaH ७.३.१०८", "७.३.१०८", "७.३.१०८ hrasvasya guRaH"]}], "hrasvaH": [{"id": "hrasvaH", "headword": "ह्रस्वः", "headword_slp1": "hrasvaH", "fold": "hrasvaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "A short is substituted for the long vowel of the reduplicate.\n\nTerms: Reduplicate", "gloss_language": "en"}], "synonyms": ["ह्रस्वः ७.४.५९", "७.४.५९", "७.४.५९ ह्रस्वः"], "synonyms_slp1": ["hrasvaH ७.४.५९", "७.४.५९", "७.४.५९ hrasvaH"]}], "hrasvadaNgat‌": [{"id": "hrasvAdaNgAt‌", "headword": "ह्रस्वादङ्गात्‌", "headword_slp1": "hrasvAdaNgAt‌", "fold