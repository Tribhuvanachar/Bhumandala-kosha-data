{"ahansuBamoryus": [{"id": "ahaMSuBamoryus", "headword": "अहंशुभमोर्युस्", "headword_slp1": "ahaMSuBamoryus", "fold": "ahansuBamoryus", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix युस् (यु) comes in the sense of मतुप् after the word अहम् and the indeclinable शुभम् 'good'.\n\nTerms: युस्", "gloss_language": "en"}], "synonyms": ["अहंशुभमोर्युस् ५.२.१४०", "५.२.१४०", "५.२.१४० अहंशुभमोर्युस्"], "synonyms_slp1": ["ahaMSuBamoryus ५.२.१४०", "५.२.१४०", "५.२.१४० ahaMSuBamoryus"]}], "ahasarvEkadesasanKyatapuRyaca ratreH": [{"id": "ahassarvEkadeSasaMKyAtapuRyAcca rAtreH", "headword": "अहस्सर्वैकदेशसंख्यातपुण्याच्च रात्रेः", "headword_slp1": "ahassarvEkadeSasaMKyAtapuRyAcca rAtreH", "fold": "ahasarvEkadesasanKyatapuRyaca ratreH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The affix अच् comes after the word रात्रि when preceded by अहन् or सर्व or a word denoting a portion of night, or संख्यात or पुण्य when the compound is a तत्-पुरुष as well as when a numeral or an indeclinable precedes रात्रि।\n\nTerms: अच्", "gloss_language": "en"}], "synonyms": ["अहस्सर्वैकदेशसंख्यातपुण्याच्च रात्रेः ५.४.८७", "५.४.८७", "५.४.८७ अहस्सर्वैकदेशसंख्यातपुण्याच्च रात्रेः"], "synonyms_slp1": ["ahassarvEkadeSasaMKyAtapuRyAcca rAtreH ५.४.८७", "५.४.८७", "५.४.८७ ahassarvEkadeSasaMKyAtapuRyAcca rAtreH"]}], "ahasTaH": [{"id": "AhasTaH", "headword": "आहस्थः", "headword_slp1": "AhasTaH", "fold": "ahasTaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "For the ह of the root आह् there is substituted थ before a झल् (all consonant except semi-vowels and nasals) letter.\n\nTerms: ह changed to थ", "gloss_language": "en"}], "synonyms": ["आहस्थः ८.२.३५", "८.२.३५", "८.२.३५ आहस्थः"], "synonyms_slp1": ["AhasTaH ८.२.३५", "८.२.३५", "८.२.३५ AhasTaH"]}], "ahan": [{"id": "ahan", "headword": "अहन्", "headword_slp1": "ahan", "fold": "ahan", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "रु is also substituted for the न् of अहन् at the end of a word.\n\nTerms: रु substitution", "gloss_language": "en"}], "synonyms": ["अहन् ८.२.६८", "८.२.६८", "८.२.६८ अहन्"], "synonyms_slp1": ["ahan ८.२.६८", "८.२.६८", "८.२.६८ ahan"]}]}