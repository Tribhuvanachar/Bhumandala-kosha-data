nses": [{"gloss": "स is substituted for समान् in the छन्दस् (Vedas), but not before 1. मूर्धन् 2. प्रभृति and 3. उदर्क।\n\nTerms: स Substitute", "gloss_language": "en"}], "synonyms": ["समानस्य छन्दस्यमूर्धप्रभृत्युदर्केषु ६.३.८४", "६.३.८४", "६.३.८४ समानस्य छन्दस्यमूर्धप्रभृत्युदर्केषु"], "synonyms_slp1": ["samAnasya CandasyamUrDapraBftyudarkezu ६.३.८४", "६.३.८४", "६.३.८४ samAnasya CandasyamUrDapraBftyudarkezu"]}], "samaH sami": [{"id": "samaH sami", "headword": "समः समि", "headword_slp1": "samaH sami", "fold": "samaH sami", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "समि is substituted for सम् before this अञ्च् when no affix (or व affix) follows.\n\nTerms: Some Substitution", "gloss_language": "en"}], "synonyms": ["समः समि ६.३.९३", "६.३.९३", "६.३.९३ समः समि"], "synonyms_slp1": ["samaH sami ६.३.९३", "६.३.९३", "६.३.९३ samaH sami"]}], "samprasaraRasya": [{"id": "samprasAraRasya", "headword": "सम्प्रसारणस्य", "headword_slp1": "samprasAraRasya", "fold": "samprasaraRasya", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The vowel substituted for a semi-vowel is lengthened when it stands as the first member of a compound.\n\nTerms: संहिता Lengthening", "gloss_language": "en"}], "synonyms": ["सम्प्रसारणस्य ६.३.१३९", "६.३.१३९", "६.३.१३९ सम्प्रसारणस्य"], "synonyms_slp1": ["samprasAraRasya ६.३.१३९", "६.३.१३९", "६.३.१३९ samprasAraRasya"]}], "samita yajYe": [{"id": "SamitA yajYe", "headword": "शमिता यज्ञे", "headword_slp1": "SamitA yajYe", "fold": "samita yajYe", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "शमिता is formed irregularly by the elision of णि before an इट् augmented affix when meaning a sacrificial act.\n\nTerms: आर्धधातुक changes", "gloss_language": "en"}], "synonyms": ["शमिता यज्ञे ६.४.५४", "६.४.५४", "६.४.५४ शमिता यज्ञे"], "synonyms_slp1": ["SamitA yajYe ६.४.५४", "६.४.५४", "६.४.५४ SamitA yajYe"]}], "sama akam": [{"id": "sAma Akam", "headword": "साम आकम्", "