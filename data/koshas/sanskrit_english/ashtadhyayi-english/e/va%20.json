tadhyayi-english", "senses": [{"gloss": "The ह of 1. द्रुह् 2. मुह् 3.ष्णुह् and 4. ष्णिह् is optionally changed to ध before a झल् (all consonant except semi-vowels and nasals) letter or at the end of a word.\n\nTerms: ह changed to ध", "gloss_language": "en"}], "synonyms": ["वा द्रुहमुहष्णुहष्णिहाम् ८.२.३३", "८.२.३३", "८.२.३३ वा द्रुहमुहष्णुहष्णिहाम्"], "synonyms_slp1": ["vA druhamuhazRuhazRihAm ८.२.३३", "८.२.३३", "८.२.३३ vA druhamuhazRuhazRihAm"]}], "va sari": [{"id": "vA Sari", "headword": "वा शरि", "headword_slp1": "vA Sari", "fold": "va sari", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The विसर्ग is optionally the substitute of विसर्ग when followed by a sibilant (शर्).\n\nTerms: विसर्ग सन्धि", "gloss_language": "en"}], "synonyms": ["वा शरि ८.३.३६", "८.३.३६", "८.३.३६ वा शरि"], "synonyms_slp1": ["vA Sari ८.३.३६", "८.३.३६", "८.३.३६ vA Sari"]}], "va BavakaraRayoH": [{"id": "vA BAvakaraRayoH", "headword": "वा भावकरणयोः", "headword_slp1": "vA BAvakaraRayoH", "fold": "va BavakaraRayoH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "Optionally when the compound denotes a condition or an instrument, the न् of पान is changed to ण , when it is a second member, the cause of change occurring in the first member in a compound.\n\nTerms: सन्धि-हल्-समास-word", "gloss_language": "en"}], "synonyms": ["वा भावकरणयोः ८.४.१०", "८.४.१०", "८.४.१० वा भावकरणयोः"], "synonyms_slp1": ["vA BAvakaraRayoH ८.४.१०", "८.४.१०", "८.४.१० vA BAvakaraRayoH"]}], "va ninsaniksanindam": [{"id": "vA niMsanikzanindAm", "headword": "वा निंसनिक्षनिन्दाम्", "headword_slp1": "vA niMsanikzanindAm", "fold": "va ninsaniksanindam", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "The न् of निस् , निक्ष and निन्द is changed to a ण optionally, when preceded by an उपसर्ग having in it a cause of change.\n\nTerms: सन्धि-हल्-कृत्-उपसर्ग", "gloss_language": "en"}], "synonyms": ["वा निंसनिक्षनिन्दाम् ८.४.३३", "८.४.३