eadword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "For the letters 1. ब 2. ग 3. ड or 4. द in the beginning of a mono-syllable and belonging to a root, and which ends in 1. झ 2. भ 3. घ 4. ढ or 5. ध there is substituted 1. भ 2. घ 3. ढ or 4. ध respectively before स् or ध्व or at the end of a word.\n\nTerms: Some substitution", "gloss_language": "en"}], "synonyms": ["एकाचो बशो भष् झषन्तस्य स्ध्वोः ८.२.३७", "८.२.३७", "८.२.३७ एकाचो बशो भष् झषन्तस्य स्ध्वोः"], "synonyms_slp1": ["ekAco baSo Baz Jazantasya sDvoH ८.२.३७", "८.२.३७", "८.२.३७ ekAco baSo Baz Jazantasya sDvoH"]}], "ekajutarapade RaH": [{"id": "ekAjuttarapade RaH", "headword": "एकाजुत्तरपदे णः", "headword_slp1": "ekAjuttarapade RaH", "fold": "ekajutarapade RaH", "headword_language": "sa", "source": "ashtadhyayi-english", "senses": [{"gloss": "In a compound, the second member of which is a monosyllable, there is ण in the room of न of the second member, provided that the न is at the end of a प्रातिपदिक , or is the augment नुम् , or occurs in a विभक्ति; and when the first member contains a cause of change.\n\nTerms: सन्धि-हल्-आगमन-विभक्ति", "gloss_language": "en"}], "synonyms": ["एकाजुत्तरपदे णः ८.४.१२", "८.४.१२", "८.४.१२ एकाजुत्तरपदे णः"], "synonyms_slp1": ["ekAjuttarapade RaH ८.४.१२", "८.४.१२", "८.४.१२ ekAjuttarapade RaH"]}]}