{"barasi": [{"id": "barAsI", "headword": "बरासी", "headword_slp1": "barAsI", "fold": "barasi", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Barāsī is found in the kāṭhaka Saṃhitā and the Pañcaviṃśa Brāhmana denoting a garment of some kind.\nFoot notes xv. 4.\nxviii. 9, 16 (where the commentator explains it as made of bark); xxi. 3, 4.", "gloss_language": "en"}], "synonyms": ["baraasee", "baraasi", "baraasii", "barāsi", "barāsī", "बरासि", "బరాసి", "బరాసీ", "ಬರಾಸಿ", "ಬರಾಸೀ"], "synonyms_slp1": ["baraasee", "baraasi", "baraasii", "barāsi", "barāsī", "barAsi", "బరాసి", "బరాసీ", "ಬರಾಸಿ", "ಬರಾಸೀ"]}], "baru": [{"id": "baru", "headword": "बरु", "headword_slp1": "baru", "fold": "baru", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Baru is the name of the author of a hymn of the Rigveda according to the Brāhmaṇas of that veda.\nFoot notes x. 96.\naitareya brāhmaṇa, vi. 25; kauṣītaki brāhmaṇa, xxv. 8.", "gloss_language": "en"}], "synonyms": ["baru", "బరు", "ಬರು"], "synonyms_slp1": ["baru", "బరు", "ಬರು"]}], "barku varsRa": [{"id": "barku vArzRa", "headword": "बर्कु वार्ष्ण", "headword_slp1": "barku vArzRa", "fold": "barku varsRa", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Barku Vārṣṇa (‘descendant of vṛṣan’) is the name of a teacher in the Śatapatha brāhmaṇa.\nFoot notes i. 1, 1, 10; Bṛhadāraṇyaka upaniṣad, iv. 1, 8 (Mādhyaṃdina = iv. 1, 4 kāṇva).", "gloss_language": "en"}], "synonyms": ["barku vaarShNa", "barku vārṣṇa", "బర్కు వార్ష్ణ", "ಬರ್ಕು ವಾರ್ಷ್ಣ"], "synonyms_slp1": ["barku vaarShNa", "barku vārṣṇa", "బర్కు వార్ష్ణ", "ಬರ್ಕು ವಾರ್ಷ್ಣ"]}], "barhis": [{"id": "barhis", "headword": "बर्हिस्", "headword_slp1": "barhis", "fold": "barhis", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Barhis is found repeatedly in the Rigveda and later denoting the litter of grass strewn on the sacrificial ground on which the gods are summoned to seat themselves.\nFoot notes i. 63, 7; 108, 4; iii. 4, 4, etc.\ntaittirīya Saṃhitā, vi. 2, 4, 5; Vājasaneyi Saṃhitā, ii. 1; xviii. 1, etc.", "gloss_language": "en"}], "synonyms": ["barhi", "barhis", "बर्हि", "బర్హి", "బర్హిస్", "ಬರ್ಹಿ", "ಬರ್ಹಿಸ್"], "synonyms_slp1": ["barhi", "barhis", "barhi", "బర్హి", "బర్హిస్", "ಬರ್ಹಿ", "ಬರ್ಹಿಸ್"]}], "barhat-sama": [{"id": "bArhat-sAmA", "headword": "बार्हत्-सामा", "headword_slp1": "bArhat-sAmA", "fold": "barhat-sama", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bārhat-sāmā is an anomalously formed word meaning ‘daughter of Bṛhatsāman’ in the Atharvaveda, where her name occurs in a hymn for easy conception.\nFoot notes v. 25, 9. Cf Whitney, Translation of the Atharvaveda, 267.", "gloss_language": "en"}], "synonyms": ["baarhat", "baarhat-saamaa", "baarhatsaamaa", "bārhat", "bārhat-sāmā", "bārhatsāmā", "saamaa", "sāmā", "बार्हत्", "बार्हत्सामा", "सामा", "బార్హత్", "బార్హత్-సామా", "బార్హత్సామా", "సామా", "ಬಾರ್ಹತ್", "ಬಾರ್ಹತ್-ಸಾಮಾ", "ಬಾರ್ಹತ್ಸಾಮಾ", "ಸಾಮಾ"], "synonyms_slp1": ["baarhat", "baarhat-saamaa", "baarhatsaamaa", "bārhat", "bārhat-sāmā", "bārhatsāmā", "saamaa", "sāmā", "bArhat", "bArhatsAmA", "sAmA", "బార్హత్", "బార్హత్-సామా", "బార్హత్సామా", "సామా", "ಬಾರ್ಹತ್", "ಬಾರ್ಹತ್-ಸಾಮಾ", "ಬಾರ್ಹತ್ಸಾಮಾ", "ಸಾಮಾ"]}], "barhas-patya": [{"id": "bArhas-patya", "headword": "बार्हस्-पत्य", "headword_slp1": "bArhas-patya", "fold": "barhas-patya", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bārhas-patya, ‘descendant of bṛhaspati,’ is the patronymic of the mythical śaṃyu.\nFoot notes taittirīya Saṃhitā, ii. 6, 10, 1; v. 2, 6, 4; Satapatha brāhmaṇa, i. 9, 1, 24; nirukta, iv. 21, etc.", "gloss_language": "en"}], "synonyms": ["baarha", "baarhas", "baarhas-patya", "baarhaspatya", "bārha", "bārhas", "bārhas-patya", "bārhaspatya", "patya", "पत्य", "बार्ह", "बार्हस्", "बार्हस्पत्य", "పత్య", "బార్హ", "బార్హస్", "బార్హస్-పత్య", "బార్హస్పత్య", "ಪತ್