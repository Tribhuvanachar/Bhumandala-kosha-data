{"ny-anka": [{"id": "ny-aMka", "headword": "न्य्-अंक", "headword_slp1": "ny-aMka", "fold": "ny-anka", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Ny-aṅka in the dual denotes in the taittirīya Saṃhitā and brāhmaṇa some part of the chariot, parallel with aṅka. The pañcaviṃśa brāhmaṇa has Nyaṅkū, the dual of nyaṅku.\nFoot notes i. 7, 7, 2.\ni. 3, 5, 4; ii. 7, 8, 1.\ni. 7, 5; Lāṭyāyana Srauta sūtra, ii. 8, 9.", "gloss_language": "en"}], "synonyms": ["aMka", "anka", "aṅka", "ny", "ny-aMka", "ny-anka", "ny-aṅka", "nyaMka", "nyanka", "nyaṅka", "अंक", "अङ्क", "न्यंक", "न्यङ्क", "न्य्", "न्य्-अङ्क", "అంక", "అఙ్క", "న్యంక", "న్యఙ్క", "న్య్", "న్య్-అంక", "న్య్-అఙ్క", "ಅಂಕ", "ಅಙ್ಕ", "ನ್ಯಂಕ", "ನ್ಯಙ್ಕ", "ನ್ಯ್", "ನ್ಯ್-ಅಂಕ", "ನ್ಯ್-ಅಙ್ಕ"], "synonyms_slp1": ["aMka", "anka", "aṅka", "ny", "ny-aMka", "ny-anka", "ny-aṅka", "nyaMka", "nyanka", "nyaṅka", "aMka", "aNka", "nyaMka", "nyaNka", "ny", "ny-aNka", "అంక", "అఙ్క", "న్యంక", "న్యఙ్క", "న్య్", "న్య్-అంక", "న్య్-అఙ్క", "ಅಂಕ", "ಅಙ್ಕ", "ನ್ಯಂಕ", "ನ್ಯಙ್ಕ", "ನ್ಯ್", "ನ್ಯ್-ಅಂಕ", "ನ್ಯ್-ಅಙ್ಕ"]}], "ny-astika": [{"id": "ny-astikA", "headword": "न्य्-अस्तिका", "headword_slp1": "ny-astikA", "fold": "ny-astika", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Ny-astikā seems in the Atharvaveda to denote a plant of some kind, identified by the scholiast with the Śaṅkhapuṣpikā (Andropogon aciculatus).\nFoot notes vi. 139, 1. Cf. Whitney, Translation of the Atharvaveda, 385; Bloomfield, ymns of the Atharvaveda, 539, 540.", "gloss_language": "en"}], "synonyms": ["astikaa", "astikā", "ny", "ny-astikaa", "ny-astikā", "nyastikaa", "nyastikā", "अस्तिका", "न्यस्तिका", "न्य्", "అస్తికా", "న్యస్తికా", "న్య్", "న్య్-అస్తికా", "ಅಸ್ತಿಕಾ", "ನ್ಯಸ್ತಿಕಾ", "ನ್ಯ್", "ನ್ಯ್-ಅಸ್ತಿಕಾ"], "synonyms_slp1": ["astikaa", "astikā", "ny", "ny-astikaa", "ny-astikā", "nyastikaa", "nyastikā", "astikA", "nyastikA", "ny", "అస్తికా", "న్యస్తికా", "న్య్", "న్య్-అస్తికా", "ಅಸ್ತಿಕಾ", "ನ್ಯಸ್ತಿಕಾ", "ನ್ಯ್",