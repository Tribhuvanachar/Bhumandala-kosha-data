{"ambarisa": [{"id": "ambarIza", "headword": "अम्बरीष", "headword_slp1": "ambarIza", "fold": "ambarisa", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Ambarīṣa is mentioned as a vārṣāgira in the Rigveda along with ṛjrāśva, sahadeva, surādhas, and bhayamāna.\nFoot notes i. 100, 17. Cf. Ludwig, Translation of the Rigveda, 3, 140.", "gloss_language": "en"}], "synonyms": ["ambareeSha", "ambariiSha", "ambarīṣa", "अंबरीष", "అంబరీష", "అమ్బరీష", "ಅಂಬರೀಷ", "ಅಮ್ಬರೀಷ"], "synonyms_slp1": ["ambareeSha", "ambariiSha", "ambarīṣa", "aMbarIza", "అంబరీష", "అమ్బరీష", "ಅಂಬರೀಷ", "ಅಮ್ಬರೀಷ"]}], "ambasWa": [{"id": "ambazWa", "headword": "अम्बष्ठ", "headword_slp1": "ambazWa", "fold": "ambasWa", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Ambaṣṭha. See āmbaṣṭhya.", "gloss_language": "en"}], "synonyms": ["ambaShTha", "ambaṣṭha", "अंबष्ठ", "అంబష్ఠ", "అమ్బష్ఠ", "ಅಂಬಷ್ಠ", "ಅಮ್ಬಷ್ಠ"], "synonyms_slp1": ["ambaShTha", "ambaṣṭha", "aMbazWa", "అంబష్ఠ", "అమ్బష్ఠ", "ಅಂಬಷ್ಠ", "ಅಮ್ಬಷ್ಠ"]}], "amba": [{"id": "Amba", "headword": "आम्ब", "headword_slp1": "Amba", "fold": "amba", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Āmba denotes in the taittirīya and kāṭhaka Saṃhitās a grain, called nāmba in the Śatapatha brāhmaṇa\nFoot notes i. 8, 10, 1.\nxv. 5.\nv. 3, 3, 8.", "gloss_language": "en"}], "synonyms": ["aamba", "āmba", "आंब", "ఆంబ", "ఆమ్బ", "ಆಂಬ", "ಆಮ್ಬ"], "synonyms_slp1": ["aamba", "āmba", "AMba", "ఆంబ", "ఆమ్బ", "ಆಂಬ", "ಆಮ್ಬ"]}], "ambasWya": [{"id": "AmbazWya", "headword": "आम्बष्ठ्य", "headword_slp1": "AmbazWya", "fold": "ambasWya", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Āmbaṣṭhya is mentioned in the aitareya brāhmaṇa (viii. 21) as a king, whose priest for the rājasūya, or royal inauguration, was nārada. Presumably the name is local, meaning ‘King of the Ambaṣṭhas,’ as interpreted in the St. Petersburg Dictionary. Later t