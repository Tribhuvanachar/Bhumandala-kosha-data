{"bfhac-Candas": [{"id": "bfhac-Candas", "headword": "बृहच्-छन्दस्", "headword_slp1": "bfhac-Candas", "fold": "bfhac-Candas", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bṛhac-chandas is found in one passage of the Atharvaveda as an epithet of śālā, ‘house.’ It is apparently an error for bṛhad-chadis, ‘broad-roofed,’ which in any case is the sense.\nFoot notes iii. 12, 3.\nCf. Whitney, Translation of the Atharvaveda, 105.\nBloomfield, Hymns of the Atharvaveda, 345.", "gloss_language": "en"}], "synonyms": ["Chanda", "Chandas", "bRRihach", "bRRihach-Chanda", "bRRihach-Chandas", "bRRihachChanda", "bRRihachChandas", "bRhach", "bRhach-Chanda", "bRhach-Chandas", "bRhachChanda", "bRhachChandas", "bRihach", "bRihach-Chanda", "bRihach-Chandas", "bRihachChanda", "bRihachChandas", "bRuhach", "bRuhach-Chanda", "bRuhach-Chandas", "bRuhachChanda", "bRuhachChandas", "bṛhac", "bṛhac-chanda", "bṛhac-chandas", "bṛhacchanda", "bṛhacchandas", "chanda", "chandas", "छन्द", "छन्दस्", "बृहच्", "बृहच्-छन्द", "बृहच्छन्द", "बृहच्छन्दस्", "ఛన్ద", "ఛన్దస్", "బృహచ్", "బృహచ్-ఛన్ద", "బృహచ్-ఛన్దస్", "బృహచ్ఛన్ద", "బృహచ్ఛన్దస్", "ಛನ್ದ", "ಛನ್ದಸ್", "ಬೃಹಚ್", "ಬೃಹಚ್-ಛನ್ದ", "ಬೃಹಚ್-ಛನ್ದಸ್", "ಬೃಹಚ್ಛನ್ದ", "ಬೃಹಚ್ಛನ್ದಸ್"], "synonyms_slp1": ["Chanda", "Chandas", "bRRihach", "bRRihach-Chanda", "bRRihach-Chandas", "bRRihachChanda", "bRRihachChandas", "bRhach", "bRhach-Chanda", "bRhach-Chandas", "bRhachChanda", "bRhachChandas", "bRihach", "bRihach-Chanda", "bRihach-Chandas", "bRihachChanda", "bRihachChandas", "bRuhach", "bRuhach-Chanda", "bRuhach-Chandas", "bRuhachChanda", "bRuhachChandas", "bṛhac", "bṛhac-chanda", "bṛhac-chandas", "bṛhacchanda", "bṛhacchandas", "chanda", "chandas", "Canda", "Candas", "bfhac", "bfhac-Canda", "bfhacCanda", "bfhacCandas", "ఛన్ద", "ఛన్దస్", "బృహచ్", "బృహచ్-ఛన్ద", "బృహచ్-ఛన్దస్", "బృహచ్ఛన్ద", "బృహచ్ఛన్దస్", "ಛನ್ದ", "ಛನ್ದಸ್", "ಬೃಹಚ್", "ಬೃಹಚ್-ಛನ್ದ", "ಬೃಹಚ್-ಛನ್ದಸ್", "ಬೃಹಚ್ಛನ್ದ", "ಬೃಹಚ್ಛನ್ದಸ್"]}], "bfhat-saman": [{"id": "bfhat-sAman", "headword": "बृहत्-सामन्", "headword_slp1": "bfhat-sAman", "fold": "bfhat-saman", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bṛhat-sāman is mentioned in the Atharvaveda (v. 19, 2) as an āṅgirasa who was oppressed by Kṣatriyas. The latter are said to have been ruined in consequence. Cf. sṛñjaya and bārhatsāmā.", "gloss_language": "en"}], "synonyms": ["bRRihat", "bRRihat-saaman", "bRRihatsaaman", "bRhat", "bRhat-saaman", "bRhatsaaman", "bRihat", "bRihat-saaman", "bRihatsaaman", "bRuhat", "bRuhat-saaman", "bRuhatsaaman", "bṛhat", "bṛhat-sāman", "bṛhatsāman", "saaman", "sāman", "बृहत्", "बृहत्सामन्", "सामन्", "బృహత్", "బృహత్-సామన్", "బృహత్సామన్", "సామన్", "ಬೃಹತ್", "ಬೃಹತ್-ಸಾಮನ್", "ಬೃಹತ್ಸಾಮನ್", "ಸಾಮನ್"], "synonyms_slp1": ["bRRihat", "bRRihat-saaman", "bRRihatsaaman", "bRhat", "bRhat-saaman", "bRhatsaaman", "bRihat", "bRihat-saaman", "bRihatsaaman", "bRuhat", "bRuhat-saaman", "bRuhatsaaman", "bṛhat", "bṛhat-sāman", "bṛhatsāman", "saaman", "sāman", "bfhat", "bfhatsAman", "sAman", "బృహత్", "బృహత్-సామన్", "బృహత్సామన్", "సామన్", "ಬೃಹತ್", "ಬೃಹತ್-ಸಾಮನ್", "ಬೃಹತ್ಸಾಮನ್", "ಸಾಮನ್"]}], "bfhad-ukTa": [{"id": "bfhad-ukTa", "headword": "बृहद्-उक्थ", "headword_slp1": "bfhad-ukTa", "fold": "bfhad-ukTa", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bṛhad-uktha is mentioned in an obscure hymn of the Rigveda as a priest; in two hymns of the tenth Maṇḍala he is definitely a ṛṣi. He is also mentioned in the aitareya brāhmaṇa as having consecrated durmukha pāñcāla, and is called Vāmadeva's son in the Śatapatha brāhmaṇa. In the pañcaviṃśa brāhmaṇa he appears as Vāmneya, ‘descendant of Vāmnī.’ Hopkins suggestion that he may have been there thought of as Vāmadevya also is quite probable.\nFoot notes v. 19, 3, where Roth, St. Petersburg Dictionary, s.v. treats it as adjectival. Cf. Oldenberg, Zeitschrift der Deutschen Morgenländischen Gesellschaft. 42, 214; Ludwig, Translation of the Rigveda, 3, 126.\nx. 54, 6; 56, 7.\nviii. 23.\nxiii. 2, 2, 14.\nxiv. 9, 37, 38.\nTransactions of the Connecticut Academy of Arts and Sciences, 15, 55, n. 2.\npañcaviṃśa brāhmaṇa, xiii. 9, 27, is parallel with xiv. 9, 38.", "gloss_language": "en"}], "synonyms": ["bRRihad", "bRRihad-uktha", "bRRihaduktha", "bRhad", "bRhad-uktha", "bRhaduktha", "bRihad", "bRihad-uktha", "bRihaduktha", "bRuhad", "bRuhad-uktha", "bRuhaduktha", "bṛhad", "bṛhad-uktha", "bṛhaduktha", "uktha", "उक्थ", "बृहदुक्थ", "बृहद्", "ఉక్థ", "బృహదుక్థ", "బృహద్", "బృహద్-ఉక్థ", "ಉಕ್ಥ", "ಬೃಹದುಕ್ಥ", "ಬೃಹದ್", "ಬೃಹದ್-ಉಕ್ಥ"], "synonyms_slp1": ["bRRihad", "bRRihad-uktha", "bRRihaduktha", "bRhad", "bRhad-uktha", "bRhaduktha", "bRihad", "bRihad-uktha", "bRihaduktha", "bRuhad", "bRuhad-uktha", "bRuhaduktha", "bṛhad", "bṛhad-uktha", "bṛhaduktha", "uktha", "ukTa", "bfhadukTa", "bfhad", "ఉక్థ", "బృహదుక్థ", "బృహద్", "బృహద్-ఉక్థ", "ಉಕ್ಥ", "ಬೃಹದುಕ್ಥ", "ಬೃಹದ್", "ಬೃಹದ್-ಉಕ್ಥ"]}], "bfhad-giri": [{"id": "bfhad-giri", "headword": "बृहद्-गिरि", "headword_slp1": "bfhad-giri", "fold": "bfhad-giri", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bṛhad-giri is said in the pañcaviṃśa brāhmaṇa (viii. 1, 4) to have been one of the three Yatis who survived the slaughter of them by indra. A sāman, or Chant, of his is mentioned in the same brāhmaṇa (xiii. 4, 15-17).", "gloss_language": "en"}], "synonyms": ["bRRihad", "bRRihad-giri", "bRRihadgiri", "bRhad", "bRhad-giri", "bRhadgiri", "bRihad", "bRihad-giri", "bRihadgiri", "bRuhad", "bRuhad-giri", "bRuhadgiri", "bṛhad", "bṛhad-giri", "bṛhadgiri", "giri", "गिरि", "बृहद्", "बृहद्गिरि", "గిరి", "బృహద్", "బృహద్-గిరి", "బృహద్గిరి", "ಗಿರಿ", "ಬೃಹದ್", "ಬೃಹದ್-ಗಿರಿ", "ಬೃಹದ್ಗಿರಿ"], "synonyms_slp1": ["bRRihad", "bRRihad-giri", "bRRihadgiri", "bRhad", "bRhad-giri", "bRhadgiri", "bRihad", "bRihad-giri", "bRihadgiri", "bRuhad", "bRuhad-giri", "bRuhadgiri", "bṛhad", "bṛhad-giri", "bṛhadgiri", "giri", "giri", "bfhad", "bfhadgiri", "గిరి", "బృహద్", "బృహద్-గిరి", "బృహద్గిరి", "ಗಿರಿ", "ಬೃಹದ್", "ಬೃಹದ್-ಗಿರಿ", "ಬೃಹದ್ಗಿರಿ"]}], "bfhad-diva": [{"id": "bfhad-diva", "headword": "बृहद्-दिव", "headword_slp1": "bfhad-diva", "fold": "bfhad-diva", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bṛhad-diva appears in a hymn of the Rigveda as its author, calling himself an atharvan. He is mentioned in the aitareya brāhmaṇa, and is named in the vaṃśa (list of teachers) of the śāṅkhāyana Āraṇyaka as a pupil of sumnayu.\nFoot notes x. 120, 8. 9.\niv. 14.\nxv. 1.\nCf. Ludwig, Translation of the Rigveda, 3, 133; Macdonell, Vedic Mythology, p. 141.", "gloss_language": "en"}], "synonyms": ["bRRihad", "bRRihad-diva", "bRRihaddiva", "bRhad", "bRhad-diva", "bRhaddiva", "bRihad", "bRihad-diva", "bRihaddiva", "bRuhad", "bRuhad-diva", "bRuhaddiva", "bṛhad", "bṛhad-diva", "bṛhaddiva", "diva", "दिव", "बृहद्", "बृहद्दिव", "దివ", "బృహద్", "బృహద్-దివ", "బృహద్దివ", "ದಿವ", "ಬೃಹದ್", "ಬೃಹದ್-ದಿವ", "ಬೃಹದ್ದಿವ"], "synonyms_slp1": ["bRRihad", "bRRihad-diva", "bRRihaddiva", "bRhad", "bRhad-diva", "bRhaddiva", "bRihad", "bRihad-diva", "bRihaddiva", "bRuhad", "bRuhad-diva", "bRuhaddiva", "bṛhad", "bṛhad-diva", "bṛhaddiva", "diva", "diva", "bfhad", "bfhaddiva", "దివ", "బృహద్", "బృహద్-దివ", "బృహద్దివ", "ದಿವ", "ಬೃಹದ್", "ಬೃಹದ್-ದಿವ", "ಬೃಹದ್ದಿವ"]}], "bfhad-raTa": [{"id": "bfhad-raTa", "headword": "बृहद्-रथ", "headword_slp1": "bfhad-raTa", "fold": "bfhad-raTa", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bṛhad-ratha is mentioned twice in the Rigveda, in both cases beside navavāstva. The name may thus be an epithet of navavāstva.\nFoot notes i. 36, 18; x. 49, 6. Cf. Ludwig, Translation of the Rigveda, 3, 147, 148.", "gloss_language": "en"}], "synonyms": ["bRRihad", "bRRihad-ratha", "bRRihadratha", "bRhad", "bRhad-ratha", "bRhadratha", "bRihad", "bRihad-ratha", "bRihadratha", "bRuhad", "bRuhad-ratha", "bRuhadratha", "bṛhad", "bṛhad-ratha", "bṛhadratha", "ratha", "बृहद्", "बृहद्रथ", "रथ", "బృహద్", "బృహద్-రథ", "బృహద్రథ", "రథ", 