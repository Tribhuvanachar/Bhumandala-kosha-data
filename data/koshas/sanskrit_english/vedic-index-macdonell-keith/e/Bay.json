{"Baya-da asamatya": [{"id": "Baya-da AsamAtya", "headword": "भय-द आसमात्य", "headword_slp1": "Baya-da AsamAtya", "fold": "Baya-da asamatya", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bhaya-da Āsamātya (‘descendant of Asamāti’) is the name of a king in the Jaiminīya upaniṣad brāhmaṇa. Oertel, however, seems to take the name as Abhayada, but this is not probable, for Bhayada is a name in the Purāṇas.\nFoot notes iv. 8, 7.\nJournal of the American Oriental Society, 16, 247.", "gloss_language": "en"}], "synonyms": ["bhaya", "bhaya-da aasamaatya", "bhaya-da āsamātya", "bhayada aasamaatya", "bhayada āsamātya", "da aasamaatya", "da āsamātya", "द आसमात्य", "भय", "भयद आसमात्य", "ద ఆసమాత్య", "భయ", "భయ-ద ఆసమాత్య", "భయద ఆసమాత్య", "ದ ಆಸಮಾತ್ಯ", "ಭಯ", "ಭಯ-ದ ಆಸಮಾತ್ಯ", "ಭಯದ ಆಸಮಾತ್ಯ"], "synonyms_slp1": ["bhaya", "bhaya-da aasamaatya", "bhaya-da āsamātya", "bhayada aasamaatya", "bhayada āsamātya", "da aasamaatya", "da āsamātya", "da AsamAtya", "Baya", "Bayada AsamAtya", "ద ఆసమాత్య", "భయ", "భయ-ద ఆసమాత్య", "భయద ఆసమాత్య", "ದ ಆಸಮಾತ್ಯ", "ಭಯ", "ಭಯ-ದ ಆಸಮಾತ್ಯ", "ಭಯದ ಆಸಮಾತ್ಯ"]}], "Bayamana": [{"id": "BayamAna", "headword": "भयमान", "headword_slp1": "BayamAna", "fold": "Bayamana", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bhayamāna is, according to Sāyaṇa, the name of a man in one hymn of the Rigveda, which is ascribed by the Anukramaṇī (Index) to his authorship. The interpretation is, however, uncertain.\nFoot notes i. 100, 17. Cf. Muir, Sanskrit Texts, 12, 266.", "gloss_language": "en"}], "synonyms": ["bhayamaana", "bhayamāna", "భయమాన", "ಭಯಮಾನ"], "synonyms_slp1": ["bhayamaana", "bhayamāna", "భయమాన", "ಭಯಮಾನ"]}], "Baya-jatya": [{"id": "BAya-jAtya", "headword": "भाय-जात्य", "headword_slp1": "BAya-jAtya", "fold": "Baya-jatya", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Bhāya-jātya, ‘descendant of Bhayajāta,’ is the patronymic of Nikothaka in the vaṃśa brā