{"trE-kakuda": [{"id": "trE-kakuda", "headword": "त्रै-ककुद", "headword_slp1": "trE-kakuda", "fold": "trE-kakuda", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Trai-kakuda. See trikakud.", "gloss_language": "en"}], "synonyms": ["kakuda", "trai", "trai-kakuda", "traikakuda", "ककुद", "त्रै", "त्रैककुद", "కకుద", "త్రై", "త్రై-కకుద", "త్రైకకుద", "ಕಕುದ", "ತ್ರೈ", "ತ್ರೈ-ಕಕುದ", "ತ್ರೈಕಕುದ"], "synonyms_slp1": ["kakuda", "trai", "trai-kakuda", "traikakuda", "kakuda", "trE", "trEkakuda", "కకుద", "త్రై", "త్రై-కకుద", "త్రైకకుద", "ಕಕುದ", "ತ್ರೈ", "ತ್ರೈ-ಕಕುದ", "ತ್ರೈಕಕುದ"]}], "trEtana": [{"id": "trEtana", "headword": "त्रैतन", "headword_slp1": "trEtana", "fold": "trEtana", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Traitana appears in the Rigveda as a dāsa, an enemy of dīrghatamas, who seems to have engaged him in single combat and defeated him. The St. Petersburg Dictionary suggests that he is rather a supernatural being allied to trita (cf. the Avestan Thrita and Thraetaona).\nFoot notes i. 158, 5.\nMacdonell, Vedic Mythology, p. 68. Cf. Ludwig, Translation of the Rigveda, 3, 151; Oldenberg, Religion des veda, 144.", "gloss_language": "en"}], "synonyms": ["traitana", "త్రైతన", "ತ್ರೈತನ"], "synonyms_slp1": ["traitana", "త్రైతన", "ತ್ರೈತನ"]}], "trE-Datva": [{"id": "trE-DAtva", "headword": "त्रै-धात्व", "headword_slp1": "trE-DAtva", "fold": "trE-Datva", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Trai-dhātva (‘descendant of Tridhātu,’) is the patronymic of Tryaruṇa in the pañcaviṃśa brāhmaṇa (xiii. 3, 12).", "gloss_language": "en"}], "synonyms": ["dhaatva", "dhātva", "trai", "trai-dhaatva", "trai-dhātva", "traidhaatva", "traidhātva", "त्रै", "त्रैधात्व", "धात्व", "త్రై", "త్రై-ధాత్వ", "త్రైధాత్వ", "ధాత్వ", "ತ್ರೈ", "ತ್ರೈ-ಧಾತ್ವ", "ತ್ರೈಧಾತ್ವ", "ಧಾತ್ವ"], "synonyms_slp1": ["dhaatva", "dhātva", "trai", "trai-dhaatva", "trai-dhātva", "traidhaatva", "traidhātva", "trE", "trEDAtva", "DAtva", "త్రై", "త్రై-ధాత్వ", "త్రైధాత్వ", "ధాత్వ", "ತ್ರೈ", "ತ್ರೈ-ಧಾತ್ವ", "ತ್ರೈಧಾತ್ವ", "ಧಾತ್ವ"]}], "trE-pada": [{"id": "trE-pada", "headword": "त्रै-पद", "headword_slp1": "trE-pada", "fold": "trE-pada", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Trai-pada, neut., occurs as a measure of distance, ‘threequarters’ of a yojana, in the Pañcāviṃśa brāhmaṇa, where half a yojana is termed gavyūti and a quarter krośa.\nFoot notes xvi. 13. Cf. śāṅkhāyana śrauta sūtra, xiv. 41, 12.", "gloss_language": "en"}], "synonyms": ["pada", "trai", "trai-pada", "traipada", "त्रै", "त्रैपद", "पद", "త్రై", "త్రై-పద", "త్రైపద", "పద", "ತ್ರೈ", "ತ್ರೈ-ಪದ", "ತ್ರೈಪದ", "ಪದ"], "synonyms_slp1": ["pada", "trai", "trai-pada", "traipada", "trE", "trEpada", "pada", "త్రై", "త్రై-పద", "త్రైపద", "పద", "ತ್ರೈ", "ತ್ರೈ-ಪದ", "ತ್ರೈಪದ", "ಪದ"]}], "trEvaRi": [{"id": "trEvaRi", "headword": "त्रैवणि", "headword_slp1": "trEvaRi", "fold": "trEvaRi", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Traivaṇi is mentioned as a pupil of Aupacandhani or aupajandhani in the first two Vaṃśas (lists of teachers) in the Bṛhadāraṇyaka upaniṣad. In the Mādhyaṃdina recension his name occurs twice in the second vaṃśa, in both cases as a pupil of aupajandhani.\nFoot notes ii. 6, 3 (kāṇva = ii. 5, 21 Mādhyaṃdina); iv. 6, 3 (= iv. 5, 27).\niv. 5, 27.", "gloss_language": "en"}], "synonyms": ["traivaNi", "traivaṇi", "త్రైవణి", "ತ್ರೈವಣಿ"], "synonyms_slp1": ["traivaNi", "traivaṇi", "త్రైవణి", "ತ್ರೈವಣಿ"]}], "trE-vfsRa": [{"id": "trE-vfzRa", "headword": "त्रै-वृष्ण", "headword_slp1": "trE-vfzRa", "fold": "trE-vfsRa", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Trai-vṛṣṇa, ‘descendant of Trivṛṣan,’ is the patronymic of Trayaruṇa in the Rigveda (v. 27, 1).", "gloss_language": "en"}], "synonyms": ["trai", "trai-vRRiShNa", "trai-vRShNa", "trai-vRiShNa", "trai-vRuShNa", "trai-vṛṣṇa", "tr