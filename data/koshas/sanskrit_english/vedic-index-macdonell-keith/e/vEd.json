{"vEdurya": [{"id": "vEdUrya", "headword": "वैदूर्य", "headword_slp1": "vEdUrya", "fold": "vEdurya", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Vaidūrya, ‘beryl,’ is first found in the late Adbhuta brāhmaṇa.\nFoot notes Weber, Indische Studien, 1, 40; Omina und Portenta, 325 et seq.", "gloss_language": "en"}], "synonyms": ["vaidoorya", "vaiduurya", "vaidūrya", "వైదూర్య", "ವೈದೂರ್ಯ"], "synonyms_slp1": ["vaidoorya", "vaiduurya", "vaidūrya", "వైదూర్య", "ವೈದೂರ್ಯ"]}], "vEda": [{"id": "vEda", "headword": "वैद", "headword_slp1": "vEda", "fold": "vEda", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Vaida, ‘descendant of Vida,’ is the patronymic of hiraṇyadant in the aitareya brāhmaṇa and the aitareya Āraṇyaka. The word is also written Baida.\nFoot notes iii. 6, 4; Āśvalāyana Śranta sūtra, xii. 10, 9.\nii. 1, 5.", "gloss_language": "en"}], "synonyms": ["vaida", "వైద", "ವೈದ"], "synonyms_slp1": ["vaida", "వైద", "ವೈದ"]}], "vEdaTina": [{"id": "vEdaTina", "headword": "वैदथिन", "headword_slp1": "vEdaTina", "fold": "vEdaTina", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Vaidathina, ‘descendant of Vidathin,’ is the patronymic of ṛjiśvan in the Rigveda (iv. 16, 11; v. 29, 13).", "gloss_language": "en"}], "synonyms": ["vaidathina", "వైదథిన", "ವೈದಥಿನ"], "synonyms_slp1": ["vaidathina", "వైదథిన", "ವೈದಥಿನ"]}], "vEdad-asvi": [{"id": "vEdad-aSvi", "headword": "वैदद्-अश्वि", "headword_slp1": "vEdad-aSvi", "fold": "vEdad-asvi", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Vaidad-aśvi, ‘descendant of Vidadaśva,’ is the patronymic of taranta in the Rigveda. In the pañcaviṃśa brāhmaṇa and the Jaiminīya brāhmaṇa the Vaidadaśvis are taranta and Purumīlha. The latter is not a vaidadaśvi in the Rigveda, a clear sign of the worthlessness of the legends relative to these two men in the Brāhmaṇas.\nFoot notes v. 61, 10.\nxiii. 7, 12. Cf. Śāṭyāyanaka in Sāyaṇa on Rv. ix. 58, 3.\ni. 151; iii. 139, where Vaitadaśvi is the form. Cf. Ārṣeya brāhmaṇa, p. 54 (ed. Burnell).\nCf. Max Müller, Sacred Books of the East, 32, 360; Oldenberg, Zeitschrift der Deutschen Morgenländischen Gesell schaft, 42, 232, n.; ṛgveda-Noten, 1, 354; Sieg, Die Sagenstoffe des ṛgveda, 62 et seq..", "gloss_language": "en"}], "synonyms": ["ashvi", "aśvi", "vaidad", "vaidad-ashvi", "vaidad-aśvi", "vaidadashvi", "vaidadaśvi", "अश्वि", "वैददश्वि", "वैदद्", "అశ్వి", "వైదదశ్వి", "వైదద్", "వైదద్-అశ్వి", "ಅಶ್ವಿ", "ವೈದದಶ್ವಿ", "ವೈದದ್", "ವೈದದ್-ಅಶ್ವಿ"], "synonyms_slp1": ["ashvi", "aśvi", "vaidad", "vaidad-ashvi", "vaidad-aśvi", "vaidadashvi", "vaidadaśvi", "aSvi", "vEdadaSvi", "vEdad", "అశ్వి", "వైదదశ్వి", "వైదద్", "వైదద్-అశ్వి", "ಅಶ್ವಿ", "ವೈದದಶ್ವಿ", "ವೈದದ್", "ವೈದದ್-ಅಶ್ವಿ"]}], "vEdaBfti-putra": [{"id": "vEdaBftI-putra", "headword": "वैदभृती-पुत्र", "headword_slp1": "vEdaBftI-putra", "fold": "vEdaBfti-putra", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Vaidabhṛtī-putra, ‘son of a female descendant of Vedabhṛt,’ is the name of a teacher in the last vaṃśa (list of teachers) of the Mādhyaṃdina recension of the Bṛhadāraṇyaka upaniṣad (vi. 4, 32). Cf. vaiṭṭabhaṭīputra.", "gloss_language": "en"}], "synonyms": ["putra", "vaidabhRRiti", "vaidabhRRitii", "vaidabhRRitii-putra", "vaidabhRRitiiputra", "vaidabhRiti", "vaidabhRitii", "vaidabhRitii-putra", "vaidabhRitiiputra", "vaidabhRtee", "vaidabhRtee-putra", "vaidabhRteeputra", "vaidabhRti", "vaidabhRtii", "vaidabhRtii-putra", "vaidabhRtiiputra", "vaidabhRuti", "vaidabhRutii", "vaidabhRutii-putra", "vaidabhRutiiputra", "vaidabhṛti", "vaidabhṛtī", "vaidabhṛtī-putra", "vaidabhṛtīputra", "पुत्र", "वैदभृति", "वैदभृती", "वैदभृतीपुत्र", "పుత్ర", "వైదభృతి", "వైదభృతీ", "వైదభృతీ-పుత్ర", "వైదభృతీపుత్ర", "ಪುತ್ರ", "ವೈದಭೃತಿ", "ವೈದಭೃತೀ", "ವೈದಭೃತೀ-ಪುತ್ರ", "ವೈದಭೃತೀಪುತ್ರ"], "synonyms_slp1": ["putra", "vaidabhRRiti", "vaidabhRRitii", "vaidabhRRitii-putra", "vaidabh