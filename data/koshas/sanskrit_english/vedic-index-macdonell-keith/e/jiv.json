nt", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Jīvant appears to denote a certain plant in one passage of the Atharvaveda, where the edition of Roth and Whitney has the unjustified emendation Jīvala.\nFoot notes xix. 39, 3. Cf. Whitney, Translation of the Atharvaveda, 960.\nWith this conjectural form, cf. Jīvalā, an epithet of a plant in Av. vi. 59, 3; viii. 2, 6; 7, 6; xix. 39. 3.", "gloss_language": "en"}], "synonyms": ["jeevant", "jiivant", "jīvant", "జీవన్త్", "ಜೀವನ್ತ್"], "synonyms_slp1": ["jeevant", "jiivant", "jīvant", "జీవన్త్", "ಜೀವನ್ತ್"]}], "jivala calaki": [{"id": "jIvala callaki", "headword": "जीवल चल्लकि", "headword_slp1": "jIvala callaki", "fold": "jivala calaki", "headword_language": "sa", "source": "vedic-index-macdonell-keith", "senses": [{"gloss": "Jīvala Callaki, ‘descendant of Celaka,’ is mentioned in the Śatapatha brāhmaṇa as reproving takṣan.\nFoot notes ii. 3, 1, 31-35. Cf. Lévi, La Doctrine du Sacrifice, 140.", "gloss_language": "en"}], "synonyms": ["jeevala challaki", "jiivala challaki", "jīvala callaki", "జీవల చల్లకి", "ಜೀವಲ ಚಲ್ಲಕಿ"], "synonyms_slp1": ["jeevala challaki", "jiivala challaki", "jīvala callaki", "జీవల చల్లకి", "ಜೀವಲ ಚಲ್ಲಕಿ"]}]}