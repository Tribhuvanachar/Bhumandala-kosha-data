ु", "headword_slp1": "sinDu", "fold": "sinDu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sindhu (IE 7-1-2), ‘four’.", "gloss_language": "en"}], "synonyms": ["सिंधु", "सिंधुः", "सिन्धुः"], "synonyms_slp1": ["siMDu", "siMDuH", "sinDuH"]}], "sindura": [{"id": "sindUra", "headword": "सिन्दूर", "headword_slp1": "sindUra", "fold": "sindura", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sindūra (IA 19), corruption of sindhura, an elephant.", "gloss_language": "en"}], "synonyms": ["सिंदूर", "सिंदूरः", "सिन्दूरं", "सिन्दूरः"], "synonyms_slp1": ["siMdUra", "siMdUraH", "sindUraM", "sindUraH"]}], "sina": [{"id": "sinna", "headword": "सिन्न", "headword_slp1": "sinna", "fold": "sina", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sinna , same as cinna (q. v.).", "gloss_language": "en"}]}]}