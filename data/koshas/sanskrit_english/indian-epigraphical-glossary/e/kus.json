{"kusa": [{"id": "kuSa", "headword": "कुश", "headword_slp1": "kuSa", "fold": "kusa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuśa, cf. kuśa-kkāṇam (SITI), Tamil, tax on the potters.", "gloss_language": "en"}], "synonyms": ["कुशं", "कुशः"], "synonyms_slp1": ["kuSaM", "kuSaH"]}], "kusala": [{"id": "kuSala", "headword": "कुशल", "headword_slp1": "kuSala", "fold": "kusala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuśala (IA 17), used in the sense of puṇya, religious merit; cf. kuśala-mūla.", "gloss_language": "en"}], "synonyms": ["कुशलं", "कुशलः"], "synonyms_slp1": ["kuSalaM", "kuSalaH"]}], "kusalamula": [{"id": "kuSalamUla", "headword": "कुशलमूल", "headword_slp1": "kuSalamUla", "fold": "kusalamula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuśala-mūla (CII 2-1; ML), ‘the root of merit’; used to indicate ‘a pious deed’.", "gloss_language": "en"}]}], "kusalin": [{"id": "kuSalin", "headword": "कुशलिन्", "headword_slp1": "kuSalin", "fold": "kusalin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kuśalin (CII 3; SII 3; IA 9), ‘being in good health’, used in the preamble of charters to indicate the genuineness and validity of the grant made by the donors when they were in a healthy state of body and mind; epithet of a donor of copper-plate grants to indicate that the charters were issued when the donor was not subject to any disease like madness.", "gloss_language": "en"}]}], "kusutra": [{"id": "kusUtra", "headword": "कुसूत्र", "headword_slp1": "kusUtra", "fold": "kusutra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kusūtra, (LP), wrong.", "gloss_language": "en"}]}], "kusalataputahastodakena": [{"id": "kuSalatApUtahastodakena", "headword": "कुशलतापूतहस्तोदकेन", "headword_slp1": "kuSalatApUtahastodakena", "fold": "kusalataputahastodakena", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuśa-latā-pūta-hast-odakena , cf. udaka-pūrvam, etc. See Ind. Ep., p. 395", "gloss_language": "en"}]}], "kusakaRam": [{"id": "kuSakkARam", "headword": "कुशक्काणम्", "headword_slp1": "kuSakkARam", "fold": "kusakaRam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuśa-kkāṇam (SITI), Tamil; tax on potters; also known as tirigaiāyam, śakkara-kkāṇikkai.", "gloss_language": "en"}]}]}