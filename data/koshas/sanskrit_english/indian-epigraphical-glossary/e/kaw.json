{"kawaka": [{"id": "kawaka", "headword": "कटक", "headword_slp1": "kawaka", "fold": "kawaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kaṭaka (EI 8, 17), the camp or capital.\n (SITI), a fortified place; a cantonment; a military camp.\n Cf. kaṭakaṃ kartavyam (LP), ‘an army should be sent [against one]’.", "gloss_language": "en"}], "synonyms": ["कटकं", "कटकः"], "synonyms_slp1": ["kawakaM", "kawakaH"]}], "kawakaDiraja": [{"id": "kawakADirAja", "headword": "कटकाधिराज", "headword_slp1": "kawakADirAja", "fold": "kawakaDiraja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kaṭak-ādhirāja (EI 4), same as Kaṭakarāja, etc.; a military officer in charge of the royal camp.", "gloss_language": "en"}]}], "kawakaDisa": [{"id": "kawakADISa", "headword": "कटकाधीश", "headword_slp1": "kawakADISa", "fold": "kawakaDisa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kaṭakādhīśa (HD), same as Kaṭakarāja, etc.", "gloss_language": "en"}]}], "kawakanayaka": [{"id": "kawakanAyaka", "headword": "कटकनायक", "headword_slp1": "kawakanAyaka", "fold": "kawakanayaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kaṭaka-nāyaka (EI 23), same as Kaṭakarāja, etc.", "gloss_language": "en"}]}], "kawakaraja": [{"id": "kawakarAja", "headword": "कटकराज", "headword_slp1": "kawakarAja", "fold": "kawakaraja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kaṭakarāja (EI 9; HD), officer in charge of the royal camp; same as Kaṭakādhīśa, etc. Cf. Ep. Ind., Vol. IV, p. 309, note 1.", "gloss_language": "en"}]}], "kawakavarika": [{"id": "kawakavArika", "headword": "कटकवारिक", "headword_slp1": "kawakavArika", "fold": "kawakavarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kaṭaka-vārika (EI 30), probably, officials serving under the superinten