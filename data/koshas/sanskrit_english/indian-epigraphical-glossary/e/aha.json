{"ahaqa": [{"id": "AhAqa", "headword": "आहाड", "headword_slp1": "AhAqa", "fold": "ahaqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āhāḍa (EI 1), probably, a quarry.", "gloss_language": "en"}]}], "ahanvira": [{"id": "ahaMvIra", "headword": "अहंवीर", "headword_slp1": "ahaMvIra", "fold": "ahanvira", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ahaṃvīra, see Amīra. Cf. Ep. Ind., Vol. XXXIV, p. 178.", "gloss_language": "en"}]}], "ahan": [{"id": "ahan", "headword": "अहन्", "headword_slp1": "ahan", "fold": "ahan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ahan (CII 3), ‘a day’; used to denote the solar, or more properly civil, day.", "gloss_language": "en"}]}], "ahara": [{"id": "AhAra", "headword": "आहार", "headword_slp1": "AhAra", "fold": "ahara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āhāra (IE 8-4; EI 27; CII 1, 3, 4), a district; cf. āharaṇī.\n Cf. grām-āhāra (IE 8-4), a group of villages.\n (IA 17), cf. s-āhāra in Buddhist literature explained as sa-janapada. Āhāra = [land for] food; cf. bhoga.", "gloss_language": "en"}], "synonyms": ["आहारः"], "synonyms_slp1": ["AhAraH"]}], "aharaRi": [{"id": "AharaRI", "headword": "आहरणी", "headword_slp1": "AharaRI", "fold": "aharaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āharaṇī (IE 8-4; EI 16), a district or its subdivision; cf. Hastakavapr-āharaṇī (Ep. Ind., Vol. XI, p. 109); also cf. āhāra.", "gloss_language": "en"}]}], "aharavisaya": [{"id": "AhAravizaya", "headword": "आहारविषय", "headword_slp1": "AhAravizaya", "fold": "aharavisaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āhāra-viṣaya (IE 8-4), originally an āhāra, but later a viṣaya; cf. Kheṭak-āhāra-viṣaya.", "gloss_language": "en"}]}], "ahavaniya": [{"id": "AhavanIya", "headword": "आहवनीय", "headword_slp1": "AhavanIya", "fold": "ahavaniya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āhavanīya (EI 32), the sacred fire.", "gloss_language": "en"}], "synonyms": ["आहवनीयः"], "synonyms_slp1": ["AhavanIyaH"]}], "aharitakasakapuspagrahaRa": [{"id": "aharItakaSAkapuzpagrahaRa", "headword": "अहरीतकशाकपुष्पग्रहण", "headword_slp1": "aharItakaSAkapuzpagrahaRa", "fold": "aharitakasakapuspagrahaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-harītaka-śāka-puṣpa-grahaṇa , refers to the freedom of the gift land from the supply of myrobalan, vegetables and flowers to the king or landlord on occasions or to the touring officers on their visit. Cf. Prakrit a-haritaka-sāka-pupha-gahaṇa (Select Inscriptions, p. 439).", "gloss_language": "en"}]}], "aharitaparRasakapuspaPaladugDadaDiGftatakragrahaRa": [{"id": "aharItaparRaSAkapuzpaPaladugDadaDiGftatakragrahaRa", "headword": "अहरीतपर्णशाकपुष्पफलदुग्धदधिघृततक्रग्रहण", "headword_slp1": "aharItaparRaSAkapuzpaPaladugDadaDiGftatakragrahaRa", "fold": "aharitaparRasakapuspaPaladugDadaDiGftatakragrahaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-harīta-parṇa-śāka-puṣpa-phala-dugdha-dadhi-ghṛta-takra-grahaṇa , similar to a-harītaka-śāka-puṣpa-grahaṇa and a-dugdha-dadhi-grahaṇa, etc. See Ep. Ind., Vol. XXXI, p. 5.", "gloss_language": "en"}]}], "ahastapraksepaRiya": [{"id": "ahastaprakzepaRIya", "headword": "अहस्तप्रक्षेपणीय", "headword_slp1": "ahastaprakzepaRIya", "fold": "ahastapraksepaRiya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-hasta-prakṣepaṇīya (EI 11, 23), same as a a-bhaṭa-praveśa, etc. Cf. samasta-rājakīyānām=a-hasta-prakṣepaṇīya.", "gloss_language": "en"}]}]}