{"mata": [{"id": "mata", "headword": "मत", "headword_slp1": "mata", "fold": "mata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mata, cf. guru-mata (CII 1), ‘a matter considered to be serious’. []\n (LP), a signature; cf. the use of the word with the signature as in mataṃ mama amukasya found copied in many copper-plate grants.", "gloss_language": "en"}], "synonyms": ["मतं", "मतः"], "synonyms_slp1": ["mataM", "mataH"]}, {"id": "matta", "headword": "मत्त", "headword_slp1": "matta", "fold": "mata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "matta (LP), a signature; corrupt form of mata, ‘approved’, written along with the signature as in mataṃ mama amukasya. See mata.", "gloss_language": "en"}], "synonyms": ["मत्तः"], "synonyms_slp1": ["mattaH"]}], "mataNga": [{"id": "mAtaNga", "headword": "मातङ्ग", "headword_slp1": "mAtaNga", "fold": "mataNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mātaṅga (IE 7-1-2), ‘eight’.", "gloss_language": "en"}], "synonyms": ["मातंग", "मातंगः", "मातङ्गः"], "synonyms_slp1": ["mAtaMga", "mAtaMgaH", "mAtaNgaH"]}], "matapitfpadanuDyata": [{"id": "mAtApitfpAdAnuDyAta", "headword": "मातापितृपादानुध्यात", "headword_slp1": "mAtApitfpAdAnuDyAta", "fold": "matapitfpadanuDyata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mātā-pitṛ-pād-ānudhyāta (IE 8-2), ‘meditating on or favoured by the feet of one's parents’; epithet of rulers; cf. mātā-pitṛ-pād-ānudhyāna-rata.", "gloss_language": "en"}]}], "mataraH": [{"id": "mAtaraH", "headword": "मातरः", "headword_slp1": "mAtaraH", "fold": "mataraH", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mātaraḥ (CII 3), the Divine Mothers, sometimes indicated as seven in number; cf. Mātṛ and Mātṛ-gaṇa.", "gloss_language": "en"}], "synonyms": ["मातर"], "synonyms_slp1": ["mAtara"]}], "matisaciva": [{"id": "matisaciva", "headword": "मतिसचिव", "headword_slp1": "matisaciva", "fold": "matisaciva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Matisaciva (IE 8-3; HD), counsellor or minister; cf. Karma-saciva, administrative officer. See Ep. Ind., Vol. VIII, p. 44.", "gloss_language": "en"}]}], "matf": [{"id": "mAtf", "headword": "मातृ", "headword_slp1": "mAtf", "fold": "matf", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mātṛ (EI 9), the Divine Mothers, often described as seven in number; cf. mātṛ-maṇḍala, various forms of the Mother-goddess installed around a Śiva temple.", "gloss_language": "en"}]}], "matra": [{"id": "mAtra", "headword": "मात्र", "headword_slp1": "mAtra", "fold": "matra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mātra, designation of a class of officers; cf. Mahāmātra in a similar sense. See Ep. Ind., Vol. XVIII, p. 117 (mentioned along with Mūlaprakṛti; cf. Prakṛti).", "gloss_language": "en"}], "synonyms": ["मात्रं", "मात्रः"], "synonyms_slp1": ["mAtraM", "mAtraH"]}], "matfgaRa": [{"id": "mAtfgaRa", "headword": "मातृगण", "headword_slp1": "mAtfgaRa", "fold": "matfgaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mātṛ-gaṇa (IA 7), the Divine Mothers, often described as seven in number. Cf. mātṛ-maṇḍala.", "gloss_language": "en"}], "synonyms": ["मातृगणः"], "synonyms_slp1": ["mAtfgaRaH"]}], "matsyakara": [{"id": "matsyAkara", "headword": "मत्स्याकर", "headword_slp1": "matsyAkara", "fold": "matsyakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "matsy-ākara, cf. sa-matsy-ākara (IE 8-5), ‘together with the sources of fish’, the fishing right belonging to the king or landlord; cf. jala-kara.", "gloss_language": "en"}]}], "matsyanyaya": [{"id": "mAtsyanyAya", "headword": "मात्स्यन्याय", "headword_slp1": "mAtsyanyAya", "fold": "matsyanyaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mātsya-nyāya (EI 4), ‘the law of the fish’; anarchy.", "gloss_language": "en"}], "synonyms": ["मात्स्यन्यायः"], "synonyms_slp1": ["mAtsyanyAyaH"]}], "matal": [{"id": "mattal", "headword": "मत्तल्", "headword_slp1": "mattal", "fold": "matal", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mattal (EI 16; IA 11), land measure; same as mattar.", "gloss_language": "en"}]}], "matar": [{"id": "mattar", "headword": "मत्तर्", "headword_slp1": "mattar", "fold": "matar", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mattar (EI 16, 20), Kannaḍa; land measure; same as mar̤uturu or nivartana; cf. gaṇṭi-mattar (IA 9).", "gloss_language": "en"}]}], "mataru": [{"id": "mattaru", "headword": "मत्तरु", "headword_slp1": "mattaru", "fold": "mataru", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mattaru (IE 8-6; CITD), same as mattar or nivartana.", "gloss_language": "en"}]}]}