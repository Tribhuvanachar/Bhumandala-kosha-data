{"mudal": [{"id": "mudal", "headword": "मुदल्", "headword_slp1": "mudal", "fold": "mudal", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudal, cf. Evi-mudal (EI 25), an official designation.", "gloss_language": "en"}, {"gloss": "mudal (SII 3), Tamil; cost.", "gloss_language": "en"}]}], "mudala": [{"id": "mudala", "headword": "मुदल", "headword_slp1": "mudala", "fold": "mudala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudala (Ep. Ind., Vol. XXXI, p. 18), used in some Orissan inscriptions in the sense of a royal order [regarding the grant of land or its execution]. Cf. ibid., Vol. XXVIII, p. 305.", "gloss_language": "en"}]}], "mudali": [{"id": "mudali", "headword": "मुदलि", "headword_slp1": "mudali", "fold": "mudali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudali, Mudaliyār (SII 12; SITI), Tamil; a chief.\n (EI 25), same as Maṭhādhipati.", "gloss_language": "en"}]}], "mudiraTa": [{"id": "mudiraTa", "headword": "मुदिरथ", "headword_slp1": "mudiraTa", "fold": "mudiraTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudiratha (EI 33), Od̤iyā; same as Mudrāhasta.", "gloss_language": "en"}]}], "mudita": [{"id": "muditA", "headword": "मुदिता", "headword_slp1": "muditA", "fold": "mudita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "muditā (CII 4), cheerfulness; one of the Buddhist bhāvanās.", "gloss_language": "en"}]}], "mudra": [{"id": "mudrA", "headword": "मुद्रा", "headword_slp1": "mudrA", "fold": "mudra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudrā (CII 4), the position of fingers in worship.\n (LP), the government seal.", "gloss_language": "en"}]}], "mudraDikarin": [{"id": "mudrADikArin", "headword": "मुद्राधिकारिन्", "headword_slp1": "mudrADikArin", "fold": "mudraDikarin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudrādhikārin (EI 30), officer in charge of the royal seal; also called Mudr-ādhyakṣa, etc. Mudrādhikāri-saciva, may be Mudrādhikārin and Saciva.", "gloss_language": "en"}]}], "mudraDikfta": [{"id": "mudrADikfta", "headword": "मुद्राधिकृत", "headword_slp1": "mudrADikfta", "fold": "mudraDikfta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudr-ādhikṛta (EI 14, 15), same as Mudr-ādhikārin, etc.", "gloss_language": "en"}]}], "mudraDyaksa": [{"id": "mudrADyakza", "headword": "मुद्राध्यक्ष", "headword_slp1": "mudrADyakza", "fold": "mudraDyaksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudr-ādhyakṣa, same as Mudr-ādhikārin, etc.; cf. Rājamudrādhikārin. See Ghoshal, H. Rev. Syst., p. 96.", "gloss_language": "en"}], "synonyms": ["मुद्राध्यक्षः"], "synonyms_slp1": ["mudrADyakzaH"]}], "mudrahasta": [{"id": "mudrAhasta", "headword": "मुद्राहस्त", "headword_slp1": "mudrAhasta", "fold": "mudrahasta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mudrāhasta (EI 33), official designation; same as Oḍiyā Mudiratha, designation of a class of servants in the temple of Jagannātha at Purī.", "gloss_language": "en"}]}], "mudrapavara": [{"id": "mudrApavAra", "headword": "मुद्रापवार", "headword_slp1": "mudrApavAra", "fold": "mudrapavara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudr-āpavāra (IE 8-8; EI 30), the crime of using counterfeit coins or the misuse of official seals.", "gloss_language": "en"}]}], "mudrasaNKa": [{"id": "mudrASaNKa", "headword": "मुद्राशङ्ख", "headword_slp1": "mudrASaNKa", "fold": "mudrasaNKa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudrā-śaṅkha, cf. Tamil muttirai-ccaṅgu (SITI), a variety of conch-shell; conch-shell marked with a seal.", "gloss_language": "en"}]}], "mudravatara": [{"id": "mudrAvatAra", "headword": "मुद्रावतार", "headword_slp1": "mudrAvatAra", "fold": "mudravatara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudr-āvatāra, cf. Tamil muttir-āvatāram (SITI), an ear-ornament.", "gloss_language": "en"}]}], "mudravyapara": [{"id": "mudrAvyApAra", "headword": "मुद्राव्यापार", "headword_slp1": "mudrAvyApAra", "fold": "mudravyapara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudrā-vyāpāra (IE 8-2); 8-3; BL), ‘the affairs associated with the royal seal’; often used in connection with the function of the viceroy described as conducting the said business; cf. samasta-mudrā-vyāpārān paripanthayati, śrī-śrīkaraṇ-ādi-samasta-mudrāvyāpārān paripanthyati. Cf. Ep. Ind., Vol. XXXIII, p. 154. See also vyāpāra.", "gloss_language": "en"}]}], "muduqa": [{"id": "muduqa", "headword": "मुदुड", "headword_slp1": "muduqa", "fold": "muduqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Muduḍa (EI 27), same as Mutuḍa; probably, a village headman.", "gloss_language": "en"}]}], "mudariraman": [{"id": "mudarriraman", "headword": "मुदर्रिरमन्", "headword_slp1": "mudarriraman", "fold": "mudariraman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudar̤r̤iraman, mudal-tiramam (SITI), Tamil; tax (payable in cash) of uncertain import; tiramam is the coin called dramma (from Greek drachma).", "gloss_language": "en"}]}], "mudaltiramam": [{"id": "mudaltiramam", "headword": "मुदल्तिरमम्", "headword_slp1": "mudaltiramam", "fold": "mudaltiramam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mudal-tiramam, mudar̤r̤iramam , Tamil; ‘tax payable in cash’; cf. tiramam = dramma (q. v.).", "gloss_language": "en"}]}]}