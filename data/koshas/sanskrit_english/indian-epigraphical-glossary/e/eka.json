{"ekaBoga": [{"id": "ekaBoga", "headword": "एकभोग", "headword_slp1": "ekaBoga", "fold": "ekaBoga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "eka-bhoga (EI 16; SITI; ASLV), a tenure indicating exclusive ownership of a property invested in a single individual; sole possession and enjoyment of a village by a single person (without any joint owner); cf. ekabhoga-ir̤aiyili, tax-free land or village in the sole enjoyment of a single owner. Same as eka-bhogya. Cf. gaṇa-bhoga.\n (SITI), single crop; same as Tamil oru-pū.", "gloss_language": "en"}]}], "ekaBogya": [{"id": "ekaBogya", "headword": "एकभोग्य", "headword_slp1": "ekaBogya", "fold": "ekaBogya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "eka-bhogya (EI 13, 14), a tenure; same as eka-bhoga.", "gloss_language": "en"}]}], "ekada": [{"id": "ekadA", "headword": "एकदा", "headword_slp1": "ekadA", "fold": "ekada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekadā (CII 1), sometimes.", "gloss_language": "en"}]}], "ekadasaprasuti": [{"id": "ekAdaSaprasUti", "headword": "एकादशप्रसूति", "headword_slp1": "ekAdaSaprasUti", "fold": "ekadasaprasuti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekādaśa-prasūti (LP), probably, eleven births.", "gloss_language": "en"}]}], "ekadasarudraBiksa": [{"id": "ekAdaSarudraBikzA", "headword": "एकादशरुद्रभिक्षा", "headword_slp1": "ekAdaSarudraBikzA", "fold": "ekadasarudraBiksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekādaśa-Rudra-bhikṣā (EI 32), arrangement of free supply of food to Śaiva ascetics in the name of the eleven Rudras; land granted for such an arrangement.", "gloss_language": "en"}]}], "ekadasasata": [{"id": "ekAdaSaSata", "headword": "एकादशशत", "headword_slp1": "ekAdaSaSata", "fold": "ekadasasata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekādaśa-śata (ML), same as ekādaś-ottara-śata, one hundred^1 and eleven.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "ekadasivrata": [{"id": "ekAdaSIvrata", "headword": "एकादशीव्रत", "headword_slp1": "ekAdaSIvrata", "fold": "ekadasivrata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekādaśī-vrata (EI 31; CII 4), name of a vrata rite.", "gloss_language": "en"}]}], "ekaDana": [{"id": "ekaDana", "headword": "एकधन", "headword_slp1": "ekaDana", "fold": "ekaDana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "eka-dhana (LP), joint family.", "gloss_language": "en"}], "synonyms": ["एकधनः"], "synonyms_slp1": ["ekaDanaH"]}], "ekalamurti": [{"id": "ekalamUrti", "headword": "एकलमूर्ति", "headword_slp1": "ekalamUrti", "fold": "ekalamurti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekala-mūrti (HA), a single Jina image without any ornamental parikara.", "gloss_language": "en"}]}], "ekamuswi": [{"id": "ekamuzwi", "headword": "एकमुष्टि", "headword_slp1": "ekamuzwi", "fold": "ekamuswi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "eka-muṣṭi, cf. eka-muṣṭyā (LP), ‘collectively’.", "gloss_language": "en"}]}], "ekaNga": [{"id": "ekANga", "headword": "एकाङ्ग", "headword_slp1": "ekANga", "fold": "ekaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ekāṅga (HD), probably, an officer belonging to a body organized in military fashion for collecting revenue or performing police duties. See Rājataraṅgiṇī, V. 249; VII. 1604.", "gloss_language": "en"}], "synonyms": ["एकांग", "एकाङ्गं", "एकाङ्गः"], "synonyms_slp1": ["ekAMga", "ekANgaM", "ekANgaH"]}], "ekaNgin": [{"id": "ekANgin", "headword": "एकाङ्गिन्", "headword_slp1": "ekANgin", "fold": "ekaNgin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ekāṅgin (SITI), a single person; one who has no family, especially the Vaiṣṇava devotee in charge of temples.", "gloss_language": "en"}]}], "ekapatra": [{"id": "ekapAtra", "headword": "एकपात्र", "headword_slp1": "ekapAtra", "fold": "ekapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ekapātra (EI 27), probably, Yāvadeka-pātra (q. v.); official designation^1; cf. Pātra and Mahāpātra.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "ekasawa": [{"id": "ekaSAwa", "headword": "एकशाट", "headword_slp1": "ekaSAwa", "fold": "ekasawa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Eka-śāṭa (EI 29), same as Eka-cīvara; epithet of a monk who has taken a vow to wear only one piece of cloth.", "gloss_language": "en"}]}], "ekatirTi": [{"id": "ekatIrTI", "headword": "एकतीर्थी", "headword_slp1": "ekatIrTI", "fold": "ekatirTi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "eka-tīrthī (HA), a sculpture showing only one Jina (Tīrthaṅkara) together with his parikara.", "gloss_language": "en"}]}], "ekatya": [{"id": "ekatya", "headword": "एकत्य", "headword_slp1": "ekatya", "fold": "ekatya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekatya (CII 1), ‘of one kind’.", "gloss_language": "en"}]}], "ekavali": [{"id": "ekAvalI", "headword": "एकावली", "headword_slp1": "ekAvalI", "fold": "ekavali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ekāvalī, ekāvallī (SITI), necklace of a single string.", "gloss_language": "en"}]}]}