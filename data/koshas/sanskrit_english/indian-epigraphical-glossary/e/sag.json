{"sagara": [{"id": "sagara", "headword": "सगर", "headword_slp1": "sagara", "fold": "sagara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sagara (IE 7-1-2), confused with sāgara and rarely used to indicate ‘seven’.", "gloss_language": "en"}], "synonyms": ["सगरः"], "synonyms_slp1": ["sagaraH"]}, {"id": "sAgara", "headword": "सागर", "headword_slp1": "sAgara", "fold": "sagara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sāgara (IE 7-1-2), ‘four’; used in the sense of ‘seven’ by some late writers (IA 19).", "gloss_language": "en"}], "synonyms": ["सागरः"], "synonyms_slp1": ["sAgaraH"]}], "sagotra": [{"id": "sagotra", "headword": "सगोत्र", "headword_slp1": "sagotra", "fold": "sagotra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sagotra (CII 3, etc.), belonging to the lineage of the person from whom the gotra name is derived.", "gloss_language": "en"}], "synonyms": ["सगोत्रं", "सगोत्रः"], "synonyms_slp1": ["sagotraM", "sagotraH"]}], "sagamaniramapravesa": [{"id": "sAgamaniramapraveSa", "headword": "सागमनिरमप्रवेश", "headword_slp1": "sAgamaniramapraveSa", "fold": "sagamaniramapravesa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "s-āgama-nirama-praveśa , ‘together with approaches, ingress and egress’; epithet of gift land. Cf. Ind. Ep., p. 394.", "gloss_language": "en"}]}], "sagartavaskara": [{"id": "sagartAvaskara", "headword": "सगर्तावस्कर", "headword_slp1": "sagartAvaskara", "fold": "sagartavaskara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-gart-āvaskara (Ep. Ind., Vol. XXXV, p. 135), mentioned along with s-oṣara. The word avaskara (also avakara) probably means ‘a mound’.", "gloss_language": "en"}]}], "sagartosara": [{"id": "sagartozara", "headword": "सगर्तोषर", "headword_slp1": "sagartozara", "fold": "sagartosara", "headword_language