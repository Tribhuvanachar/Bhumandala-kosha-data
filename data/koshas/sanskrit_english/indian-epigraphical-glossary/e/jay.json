{"jaya": [{"id": "jayA", "headword": "जया", "headword_slp1": "jayA", "fold": "jaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayā (IA 23), hemp.\n (EI 12), name of a tithi.", "gloss_language": "en"}]}], "jayaDara": [{"id": "jayaDara", "headword": "जयधर", "headword_slp1": "jayaDara", "fold": "jayaDara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Jayadhara (IE 8-2), royal title; translated from Greek Nikephoros.", "gloss_language": "en"}]}], "jayaGaRwa": [{"id": "jayaGaRwA", "headword": "जयघण्टा", "headword_slp1": "jayaGaRwA", "fold": "jayaGaRwa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jaya-ghaṇṭā (EI 15; IA 12), a gong.", "gloss_language": "en"}]}], "jayamya": [{"id": "jAyAmya", "headword": "जायाम्य", "headword_slp1": "jAyAmya", "fold": "jayamya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jāyāmya (IA 19), a kind of charm.", "gloss_language": "en"}]}], "jayanapati": [{"id": "jayanapati", "headword": "जयनपति", "headword_slp1": "jayanapati", "fold": "jayanapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Jayanapati (EI 13), probably, an officer in charge of armour or the armoury. Cf. jayanaśālā-karaṇa.", "gloss_language": "en"}]}], "jayanasalakaraRa": [{"id": "jayanaSAlAkaraRa", "headword": "जयनशालाकरण", "headword_slp1": "jayanaSAlAkaraRa", "fold": "jayanasalakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayanaśālā-karaṇa cf. karaṇa (LP), explained as ‘the armour department’. Cf. Jayanapati.", "gloss_language": "en"}]}], "jayantapura": [{"id": "jayantapura", "headword": "जयन्तपुर", "headword_slp1": "jayantapura", "fold": "jayantapura", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayantapura (EI 4), probably, the same as brahmapurī.", "gloss_language": "en"}]}], "jayanti": [{"id": "jayantI", "headword": "जयन्ती", "headword_slp1": "jayantI", "fold": "jayanti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayantī (EI 9, IA 26), the twelfth tithi; the 12th tithi of a lunar month joined with the Punarvasu nakṣatra.", "gloss_language": "en"}], "synonyms": ["जयंती"], "synonyms_slp1": ["jayaMtI"]}], "jayantivrata": [{"id": "jayantIvrata", "headword": "जयन्तीव्रत", "headword_slp1": "jayantIvrata", "fold": "jayantivrata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayantī-vrata (IA 6), a festival in which maṇḍapanirmāṇa-jāgaraṇa-pratimādān-ādi (erection of a shed, watching through the night, distribution of images, etc.) take place.", "gloss_language": "en"}]}], "jayapala": [{"id": "jayapAla", "headword": "जयपाल", "headword_slp1": "jayapAla", "fold": "jayapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Jayapāla (SITI), a class of merchants.", "gloss_language": "en"}], "synonyms": ["जयपालः"], "synonyms_slp1": ["jayapAlaH"]}], "jayapara": [{"id": "jAyApara", "headword": "जायापर", "headword_slp1": "jAyApara", "fold": "jayapara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Jāyāpara (LL), probably, a householder.", "gloss_language": "en"}]}], "jayapatra": [{"id": "jayapatra", "headword": "जयपत्र", "headword_slp1": "jayapatra", "fold": "jayapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jaya-patra, jayarekha-patra (SITI), a certificate of victory in a dispute; a copy of the judgement. See jayarekha-patrikā.\n (EI 5), a certificate of success.", "gloss_language": "en"}], "synonyms": ["जयपत्रं"], "synonyms_slp1": ["jayapatraM"]}], "jayareKapatrika": [{"id": "jayareKapatrikA", "headword": "जयरेखपत्रिका", "headword_slp1": "jayareKapatrikA", "fold": "jayareKapatrika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayarekha-patrikā (ASLV), a certificate of victory. See jayapatra, jayarekha-patra.", "gloss_language": "en"}]}], "jayaskanDavara": [{"id": "jayaskanDAvAra", "headword": "जयस्कन्धावार", "headword_slp1": "jayaskanDAvAra", "fold": "jayaskanDavara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jaya-skandhāvāra (EI 30, 33; CII 3; BL) ‘camp of victory’; the royal camp or capital; epithet of royal camps or residences; same as skandhāvāra.", "gloss_language": "en"}]}], "jayastamBa": [{"id": "jayastamBa", "headword": "जयस्तम्भ", "headword_slp1": "jayastamBa", "fold": "jayastamBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jaya-stambha (EI 23, 30, 33; CII 4; SII 1, 11-1), a pillar of victory; cf. dharma-jaya-stambha (IA 19).", "gloss_language": "en"}], "synonyms": ["जयस्तंभ", "जयस्तम्भः"], "synonyms_slp1": ["jayastaMBa", "jayastamBaH"]}], "jayika": [{"id": "jayika", "headword": "जयिक", "headword_slp1": "jayika", "fold": "jayika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jayika (IE 8-8), the party that comes off victorious in a dispute.", "gloss_language": "en"}]}]}