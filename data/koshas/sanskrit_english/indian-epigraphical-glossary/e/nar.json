{"naraDipati": [{"id": "narADipati", "headword": "नराधिपति", "headword_slp1": "narADipati", "fold": "naraDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Narādhipati (IA 15), royal title; same as Narapati.", "gloss_language": "en"}], "synonyms": ["नराधिपतिः"], "synonyms_slp1": ["narADipatiH"]}], "narapati": [{"id": "narapati", "headword": "नरपति", "headword_slp1": "narapati", "fold": "narapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Narapati (IE 8-2; EI 12, 19; HD; SITI), ‘lord of men’, ‘leader of the infantry’; title borne by the Col̤̣a monarchs; Vijayanagara rulers, etc., in view of the large infantry they possessed; cf. the titles Aśvapati and Gajapati, and also Aśvapati-gajapati-narapati-rāja-tray-ādhipati which was the title of some kings. See Ind. Ant., Vol. XV, p. 7; JBORS, Vol. V, p. 588.", "gloss_language": "en"}], "synonyms": ["नरपतिः"], "synonyms_slp1": ["narapatiH"]}], "narasvamin": [{"id": "narasvAmin", "headword": "नरस्वामिन्", "headword_slp1": "narasvAmin", "fold": "narasvamin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Narasvāmin, probably ‘a Jāgīrdār’; cf. ˚grāme mahattama-narasvāminaḥ (Ep. Ind., Vol. XXV, p. 51).", "gloss_language": "en"}]}], "nargavuRqa": [{"id": "nArgAvuRqa", "headword": "नार्गावुण्ड", "headword_slp1": "nArgAvuRqa", "fold": "nargavuRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Nār-gāvuṇḍa (EI 23, 27), village headman; also called Nāḍa-gauḍa; cf. Nār-gāvuṇḍa-svāmya-bhūta, ‘being in the possession of the Nār-gāvuṇḍas’.", "gloss_language": "en"}]}], "narikela": [{"id": "nArikela", "headword": "नारिकेल", "headword_slp1": "nArikela", "fold": "narikela", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nārikela, cf. sa-guvāka-nārikela (EI 8-5); coconut palms [which the ordinary tenants had no right to enjoy].", "gloss_language": "en"}], "synonyms": ["नारिकेलः"], "synonyms_slp1": ["nArikelaH"]}], "narmasaciva": [{"id": "narmasaciva", "headword": "नर्मसचिव", "headword_slp1": "narmasaciva", "fold": "narmasaciva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Narma-saciva (EI 13), minister of amusement.", "gloss_language": "en"}], "synonyms": ["नर्मसचिवः", "नर्म्मसचिव"], "synonyms_slp1": ["narmasacivaH", "narmmasaciva"]}], "narkiqa": [{"id": "narkiqA", "headword": "नर्किडा", "headword_slp1": "narkiqA", "fold": "narkiqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nar̤-kiḍā (SII 12), a tax.", "gloss_language": "en"}]}]}