{"nivanda": [{"id": "nivanda", "headword": "निवन्द", "headword_slp1": "nivanda", "fold": "nivanda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivanda (SITI), allocated duties of servants in temples; temple expenses; same as Sanskrit nibandha.", "gloss_language": "en"}]}], "nivapata": [{"id": "nIvapAta", "headword": "नीवपात", "headword_slp1": "nIvapAta", "fold": "nivapata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nīva-pāta (LP), the falling of rain-water from the eaves; cf. Gujarātī nev or nevāṃ.", "gloss_language": "en"}]}], "nivartana": [{"id": "nivartana", "headword": "निवर्तन", "headword_slp1": "nivartana", "fold": "nivartana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivartana (IE 8-6; EI 21, 26, 28; CII 4), an area of land, which was not the same in different ages and localities^1. See Ind. Ep., pp. 409-10; also Matsya Purāṇa, 283. 14-15, representing a gocarman as (2/3) of a nivartana (210×210 sq. cubits).\n (CITD), same as mar̤uturu, the identification of the two being established by bilingual Sanskrit-Telugu inscriptions.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}], "synonyms": ["निवर्त्तन"], "synonyms_slp1": ["nivarttana"]}], "nivartanin": [{"id": "nivartanin", "headword": "निवर्तनिन्", "headword_slp1": "nivartanin", "fold": "nivartanin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivartanin (CII 4), name of a land measure, same as nivartana.", "gloss_language": "en"}]}], "nivedanaka": [{"id": "nivedanaka", "headword": "निवेदनक", "headword_slp1": "nivedanaka", "fold": "nivedanaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivedanaka (EI 13), cf. Vāmanasvāmi-pādānāṃ nivedanaka-nimittam, ‘in order to be presented at the feet of Vāmanasvāmin.’", "gloss_language": "en"}]}], "nivedya": [{"id": "nivedya", "headword": "निवेद्य", "headword_slp1": "nivedya", "fold": "nivedya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivedya (EI 15), same as naivedya; the food offering to a god.", "gloss_language": "en"}], "synonyms": ["निवेद्यं"], "synonyms_slp1": ["nivedyaM"]}], "nivesa": [{"id": "niveSa", "headword": "निवेश", "headword_slp1": "niveSa", "fold": "nivesa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niveśa (EI 28), a house-site.", "gloss_language": "en"}], "synonyms": ["निवेशः"], "synonyms_slp1": ["niveSaH"]}], "nivesana": [{"id": "niveSana", "headword": "निवेशन", "headword_slp1": "niveSana", "fold": "nivesana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niveśana (LL), a house.", "gloss_language": "en"}], "synonyms": ["निवेशनं"], "synonyms_slp1": ["niveSanaM"]}], "nivesita": [{"id": "niveSita", "headword": "निवेशित", "headword_slp1": "niveSita", "fold": "nivesita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niveśita (CII 1), written [on stone].\n Cf. prāsādo = yaṃ niveśitaḥ (Select Inscriptions, p. 295, text line 19); erected.", "gloss_language": "en"}]}], "nivi": [{"id": "nIvI", "headword": "नीवी", "headword_slp1": "nIvI", "fold": "nivi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nīvī (EI 17), a permanent endowment; same as akṣaya-nīvī.", "gloss_language": "en"}]}], "niviDarma": [{"id": "nIvIDarma", "headword": "नीवीधर्म", "headword_slp1": "nIvIDarma", "fold": "niviDarma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nīvī-dharma (EI 15, 17; HRS), the custom regarding permanent endowments; the condition that the donee should not destroy the principal but should only enjoy the income arising from it.", "gloss_language": "en"}]}], "nivita": [{"id": "nivIta", "headword": "निवीत", "headword_slp1": "nivIta", "fold": "nivita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivīta, cf. s-oṣar-āvaṣkara-sthāna-nivīta-lavaṇākara (EI 22).", "gloss_language": "en"}], "synonyms": ["निवीतं", "निवीतः"], "synonyms_slp1": ["nivItaM", "nivItaH"]}], "nivft": [{"id": "nivft", "headword": "निवृत्", "headword_slp1": "nivft", "fold": "nivft", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nivṛt (EI 8), a district.", "gloss_language": "en"}]}]}