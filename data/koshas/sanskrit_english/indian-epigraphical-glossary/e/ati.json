{"atibrahmaRya": [{"id": "atibrahmaRya", "headword": "अतिब्रह्मण्य", "headword_slp1": "atibrahmaRya", "fold": "atibrahmaRya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ati-brahmaṇya (CII 3), probably meaning ‘extremely friendly to the Brāhmaṇas’ and not ‘a devout worshipper of the god Brahman’. See Parama-brahmaṇya.", "gloss_language": "en"}]}], "atiDfti": [{"id": "atiDfti", "headword": "अतिधृति", "headword_slp1": "atiDfti", "fold": "atiDfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atidhṛti (IE 7-1-2), ‘nineteen’.", "gloss_language": "en"}], "synonyms": ["अतिधृतिः"], "synonyms_slp1": ["atiDftiH"]}], "atijagali": [{"id": "atijagalI", "headword": "अतिजगली", "headword_slp1": "atijagalI", "fold": "atijagali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atijagatī (IE 7-1-2), ‘thirteen’.", "gloss_language": "en"}]}], "atipara": [{"id": "atipara", "headword": "अतिपर", "headword_slp1": "atipara", "fold": "atipara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atipara (EI 24), an inveterate foe.", "gloss_language": "en"}], "synonyms": ["अतिपरः"], "synonyms_slp1": ["atiparaH"]}], "atiprasaNga": [{"id": "atiprasaNga", "headword": "अतिप्रसङ्ग", "headword_slp1": "atiprasaNga", "fold": "atiprasaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atiprasaṅga (Ep. Ind., Vol. IV, p. 347, note 5), a case in which a grammatical rule exceeds its sphere.", "gloss_language": "en"}], "synonyms": ["अतिप्रसंग", "अतिप्रसंगः", "अतिप्रसङ्गः"], "synonyms_slp1": ["atiprasaMga", "atiprasaMgaH", "atiprasaNgaH"]}], "atiratra": [{"id": "atirAtra", "headword": "अतिरात्र", "headword_slp1": "atirAtra", "fold": "atiratra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atirātra (CII 3), name of a particular sacrifice.", "gloss_language": "en"}], "synonyms": ["अतिरात्रः"], "synonyms_slp1": ["atirAtraH"]}], "atireka": [{"id": "atireka", "headword": "अतिरेक", "headword_slp1": "atireka", "fold": "atireka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atireka (CII 1), excess; cf. mano-'tireka, ‘enthusiasm’.", "gloss_language": "en"}], "synonyms": ["अतिरेकः"], "synonyms_slp1": ["atirekaH"]}], "atisatra": [{"id": "atisattra", "headword": "अतिसत्त्र", "headword_slp1": "atisattra", "fold": "atisatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atisattra (EI 27), name of a sacrifice.", "gloss_language": "en"}]}], "atita": [{"id": "atIta", "headword": "अतीत", "headword_slp1": "atIta", "fold": "atita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atīta (IA 17), ‘expired’; cf. Śaka-nṛpa-kāl-ātīta-saṃvatsareṣu. The word gateṣu, sometimes additionally used, refers to the expiry of the expired years.", "gloss_language": "en"}], "synonyms": ["अतीतं", "अतीतः"], "synonyms_slp1": ["atItaM", "atItaH"]}], "atilarajya": [{"id": "atIlarAjya", "headword": "अतीलराज्य", "headword_slp1": "atIlarAjya", "fold": "atilarajya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atīta-rājya (IA 19), indicates that so many years ‘since [the commencement of] the reign have [now] passed’; used in connection with the regnal reckoning of Govindapāla and Lakṣmaṇasena and rarely with the years of an era (e. g. the Vikrama-saṃvat associated with the reign of a legendary king named Vikramāditya). See also gata-rājya and vinaṣṭa-rājya. Cf. JAS, Letters, Vol. XX, 1954, pp. 43 ff.", "gloss_language": "en"}]}], "atiTi": [{"id": "atiTi", "headword": "अतिथि", "headword_slp1": "atiTi", "fold": "atiTi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atithi (EI 10; CII 3, 4), reception of guests; one of the five daily rites (mahāyajñas) of a Brāhmaṇa. See sattra.", "gloss_language": "en"}], "synonyms": ["अतिथिः"], "synonyms_slp1": ["atiTiH"]}], "atiTya": [{"id": "AtiTya", "headword": "आतिथ्य", "headword_slp1": "AtiTya", "fold": "atiTya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ātithya (HRS), land assigned to government officers for public charities, as indicated by the Arthaśāstra.", "gloss_language": "en"}], "synonyms": ["आतिथ्यं", "आतिथ्यः"], "synonyms_slp1": ["AtiTyaM", "AtiTyaH"]}], "ativahika": [{"id": "AtivAhika", "headword": "आतिवाहिक", "headword_slp1": "AtivAhika", "fold": "ativahika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ātivāhika (HRS), escorting fee paid by the merchants, as indicated by the Arthaśāstra. See Ghoshal, H. Rev. Syst., pp. 77.", "gloss_language": "en"}]}], "atiyatra": [{"id": "atiyAtra", "headword": "अतियात्र", "headword_slp1": "atiyAtra", "fold": "atiyatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atiyātra (EI 30), same as atiyātrika; exit tax.", "gloss_language": "en"}]}], "atiyatrika": [{"id": "atiyAtrika", "headword": "अतियात्रिक", "headword_slp1": "atiyAtrika", "fold": "atiyatrika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "atiyātrika (IE 8-8), tax for crossing the boundary; see śulk-ātiyātrika, ‘the boundary-crossing fee’; also atiyātra.", "gloss_language": "en"}]}], "atirE": [{"id": "AtIrE", "headword": "आतीरै", "headword_slp1": "AtIrE", "fold": "atirE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ātīrai (SITI), Tamil; probably, the expenses for the ārdrā festival in the month of Mārgal̤̣i.", "gloss_language": "en"}]}], "atirEpawam": [{"id": "attirEppAwwam", "headword": "अत्तिरैप्पाट्टम्", "headword_slp1": "attirEppAwwam", "fold": "atirEpawam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "attir̤ai-ppāṭṭam (SITI), Tamil; tax on cattle; cf. ādiraipāṭṭam.", "gloss_language": "en"}]}]}