{"vasa": [{"id": "vasA", "headword": "वसा", "headword_slp1": "vasA", "fold": "vasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Va-sā (PJS), probably, an abbreviation of Vaṇik-sādhu, ‘a merchant’.", "gloss_language": "en"}]}], "vasadBogamaryada": [{"id": "vasadBogamaryAdA", "headword": "वसद्भोगमर्यादा", "headword_slp1": "vasadBogamaryAdA", "fold": "vasadBogamaryada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasad-bhoga-maryādā (IA 5), explained as ‘the condition that the gift villages should be enjoyed only by those residing therein’; the custom relating to the enjoyment of the gift land by the donee^1 by residing therein; but see vasad-bhogya-maryādā.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "vasadBogyamaryada": [{"id": "vasadBogyamaryAdA", "headword": "वसद्भोग्यमर्यादा", "headword_slp1": "vasadBogyamaryAdA", "fold": "vasadBogyamaryada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasad-bhogya-maryādā (EI 24), interpreted as ‘with the tenants’ occupancy rights assured’; same as vasad-bhoga-maryādā.", "gloss_language": "en"}]}], "vasadi": [{"id": "vasadi", "headword": "वसदि", "headword_slp1": "vasadi", "fold": "vasadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasadi (EI 10), Sanskrit vasati; a Jain temple; cf. vasahī.", "gloss_language": "en"}]}], "vasagarika": [{"id": "vAsAgArika", "headword": "वासागारिक", "headword_slp1": "vAsAgArika", "fold": "vasagarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāsāgārika (IE 8-3; EI 30), officer in charge of the king's bed-chamber. See Vitān-ādhipa, Śayyāpāla, Śayyāgrāhaka.", "gloss_language": "en"}]}], "vasahi": [{"id": "vasahI", "headword": "वसही", "headword