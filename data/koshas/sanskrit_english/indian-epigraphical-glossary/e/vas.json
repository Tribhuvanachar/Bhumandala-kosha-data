s_language": "en"}]}], "vasanika": [{"id": "vAsanikA", "headword": "वासनिका", "headword_slp1": "vAsanikA", "fold": "vasanika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāsanikā (EI 23), a dwelling.", "gloss_language": "en"}]}], "vasantagaruvu": [{"id": "vasantagaruvu", "headword": "वसन्तगरुवु", "headword_slp1": "vasantagaruvu", "fold": "vasantagaruvu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasantagaruvu (ASLV), a rest house.", "gloss_language": "en"}]}], "vasantamaRqapa": [{"id": "vasantamaRqapa", "headword": "वसन्तमण्डप", "headword_slp1": "vasantamaRqapa", "fold": "vasantamaRqapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasanta-maṇḍapa (SITI), maṇḍapa in the midst of a pleasure garden where the spring-festival of a deity is celebrated.", "gloss_language": "en"}]}], "vasantotsava": [{"id": "vasantotsava", "headword": "वसन्तोत्सव", "headword_slp1": "vasantotsava", "fold": "vasantotsava", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasant-otsava (BL), spring festival.", "gloss_language": "en"}], "synonyms": ["वसंतोत्सव", "वसन्तोत्सवः"], "synonyms_slp1": ["vasaMtotsava", "vasantotsavaH"]}], "vasapaka": [{"id": "vAsApaka", "headword": "वासापक", "headword_slp1": "vAsApaka", "fold": "vasapaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāsāpaka (EI 6, 12; CII 4; IA 12, 13), explained as ‘officials whose duty was to assign places of residence to strangers’; also spelt Vāsāvaka; cf. also the tax called vāsāvakī (EI 33). Cf. Ind. Ant., Vol. XIII, p. 69, note 11.", "gloss_language": "en"}]}], "vasavaka": [{"id": "vAsAvaka", "headword": "वासावक", "headword_slp1": "vAsAvaka", "fold": "vasavaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāsāvaka (CII 4), same as Vāsāpaka.", "gloss_language": "en"}]}], "vasavaki": [{"id": "vasAvakI", "headword": "वसावकी", "headword_slp1": "vasAvakI", "fold": "vasavaki", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasāvakī (EI 33), name of a tax; cf. the official designation Vāsāpaka or Vāsāvaka.", "gloss_language": "en"}]}], "vasati": [{"id": "vasati", "headword": "वसति", "headword_slp1": "vasati", "fold": "vasati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasati, modified to basadi (EI 10), basahi (HA), pasti, basti (SITI), etc.; a Jain temple.", "gloss_language": "en"}], "synonyms": ["वसतिः"], "synonyms_slp1": ["vasatiH"]}], "vasatidaRqa": [{"id": "vasatidaRqa", "headword": "वसतिदण्ड", "headword_slp1": "vasatidaRqa", "fold": "vasatidaRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasati-daṇḍa (EI 25), obligation of the villagers to supply food to the royal officers camping in their village; explained by some as ‘the tax for the lodging of touring royal officers’ (CII 4); but probably refers to an obligation and not a tax.", "gloss_language": "en"}]}], "vaselakuwunbika": [{"id": "vAselakuwuMbika", "headword": "वासेलकुटुंबिक", "headword_slp1": "vAselakuwuMbika", "fold": "vaselakuwunbika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāsela-kuṭuṃbika (LP), resident farmers; cf. Gujarātī Vasṇārā-kaṇbī.", "gloss_language": "en"}]}], "vastavya": [{"id": "vAstavya", "headword": "वास्तव्य", "headword_slp1": "vAstavya", "fold": "vastavya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāstavya (EI 16), a community of the Kāyasthas.\n (Ep. Ind., Vol. XXXIV, p. 172, note 3), rarely also called sāmānya; ‘resident’.", "gloss_language": "en"}], "synonyms": ["वास्तव्यः"], "synonyms_slp1": ["vAstavyaH"]}], "vastu": [{"id": "vAstu", "headword": "वास्तु", "headword_slp1": "vAstu", "fold": "vastu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāstu (EI 15, 32), homestead land.", "gloss_language": "en"}]}], "vastuBumi": [{"id": "vAstuBUmi", "headword": "वास्तुभूमि", "headword_slp1": "vAstuBUmi", "fold": "vastuBumi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāstu-bhūmi (IE 8-1), homestead land.", "gloss_language": "en"}]}], "vastuka": [{"id": "vAstuka", "headword": "वास्तुक", "headword_slp1": "vAstuka", "fold": "vastuka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāstuka, a building site. See Ghoshal, H. Rev. Syst., pp. 97-98.", "gloss_language": "en"}], "synonyms": ["वास्तुकं"], "synonyms_slp1": ["vAstukaM"]}], "vastukftya": [{"id": "vAstukftya", "headword": "वास्तुकृत्य", "headword_slp1": "vAstukftya", "fold": "vastukftya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāstu-kṛtya (SITI), building work.", "gloss_language": "en"}]}], "vastuparivara": [{"id": "vAstuparivAra", "headword": "वास्तुपरिवार", "headword_slp1": "vAstuparivAra", "fold": "vastuparivara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāstu-parivāra (SITI), vacant site attached to a house.", "gloss_language": "en"}]}], "vastupraBftaka": [{"id": "vastuprABftaka", "headword": "वस्तुप्राभृतक", "headword_slp1": "vastuprABftaka", "fold": "vastupraBftaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vastu-prābhṛtaka, cf. vastu-prābhṛtakena (LP), ‘in exchange for a present’.", "gloss_language": "en"}]}], "vasu": [{"id": "vasu", "headword": "वसु", "headword_slp1": "vasu", "fold": "vasu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasu (IE 7-1-2; EI 15), ‘eight’.", "gloss_language": "en"}], "synonyms": ["वसुः"], "synonyms_slp1": ["vasuH"]}, {"id": "vAsu", "headword": "वासु", "headword_slp1": "vAsu", "fold": "vasu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāsu (EI 11), a ward.", "gloss_language": "en"}], "synonyms": ["वासुः"], "synonyms_slp1": ["vAsuH"]}], "vasuDa": [{"id": "vasuDA", "headword": "वसुधा", "headword_slp1": "vasuDA", "fold": "vasuDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasudhā (IE 7-1-2), ‘one’.", "gloss_language": "en"}]}], "vasunDara": [{"id": "vasunDarA", "headword": "वसुन्धरा", "headword_slp1": "vasunDarA", "fold": "vasunDara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasundharā (IE 7-1-2), ‘one’.", "gloss_language": "en"}], "synonyms": ["वसुंधरा"], "synonyms_slp1": ["vasuMDarA"]}], "vasupatrapadma": [{"id": "vasupatrapadma", "headword": "वसुपत्रपद्म", "headword_slp1": "vasupatrapadma", "fold": "vasupatrapadma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vasu-patra-padma (IA 9), eight-petalled lotus.", "gloss_language": "en"}]}], "vastuksetrajalaDaragartamargasamanvita": [{"id": "vAstukzetrajalADAragartAmArgasamanvita", "headword": "वास्तुक्षेत्रजलाधारगर्तामार्गसमन्वित", "headword_slp1": "vAstukzetrajalADAragartAmArgasamanvita", "fold": "vastuksetrajalaDaragartamargasamanvita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāstu-kṣetra-jalādhāra-gartā-mārga-samanvita (EI 22), ‘together with homestead lands, tanks, pits, pathways and roads’.", "gloss_language": "en"}]}], "vasalilpondakuqimE": [{"id": "vASalilpondakuqimE", "headword": "वाशलिल्पोन्दकुडिमै", "headword_slp1": "vASalilpondakuqimE", "fold": "vasalilpondakuqimE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāśalil-ponda-kuḍimai (SITI), Tamil; ‘burden of citizenship dues at the gate’; taxes, probably other than the land revenue, payable to the state.", "gloss_language": "en"}]}], "vasalkaRikE": [{"id": "vASalkARikkE", "headword": "वाशल्काणिक्कै", "headword_slp1": "vASalkARikkE", "fold": "vasalkaRikE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāśal-kāṇikkai , (SITI), Tamil; presents offered to the palace, probably annually.", "gloss_language": "en"}]}], "vasalku": [{"id": "vASalku", "headword": "वाशल्कु", "headword_slp1": "vASalku", "fold": "vasalku", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāśal-kul̤̣i-ppaṇam (SITI), Tamil-Sanskrit; probably, door-tax, i. e., house-tax based on the main doorways.", "gloss_language": "en"}]}], "vasaltiramam": [{"id": "vASaltiramam", "headword": "वाशल्तिरमम्", "headword_slp1": "vASaltiramam", "fold": "vasaltiramam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāśal-tiramam (SITI), Tamil; door-tax; tiramam is the same as dramma.", "gloss_language": "en"}, {"gloss": "vāśal-tiramam , ‘door-tax’; same as vāśal-paṇam; see dramma.", "gloss_language": "en"}]}], "vasalviniyogam": [{"id": "vASalviniyogam", "headword": "वाशल्विनियोगम्", "headword_slp1": "vASalviniyogam", "fold": "vasalviniyogam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāśal-viniyogam (SITI), Tamil-Sanskrit; same as vāśal-paṇam, etc.", "gloss_language": "en"}]}]}