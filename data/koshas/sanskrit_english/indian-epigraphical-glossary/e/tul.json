{"tula": [{"id": "tulA", "headword": "तुला", "headword_slp1": "tulA", "fold": "tula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulā (IA 26), a weight [of silver].\n (CITD), Telugu-Kannaḍa; same as Sanskrit tola or tolaka; the weight of one rupee or 30 canteroy fanams; (1/3) of a navaṭāku; a measure or weight of gold and silver, being 100 palas or about 145 ounces troy. The tulā varied a great deal according to the age and locality.", "gloss_language": "en"}]}], "tulaBara": [{"id": "tulABAra", "headword": "तुलाभार", "headword_slp1": "tulABAra", "fold": "tulaBara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulā-bhāra (EI 4, 17, 26; SITI), name of a mahādāna; same as tulāpuruṣa; weighing a king or an exalted personage against gold or other precious metals and stones and distributing the same to temples, etc.", "gloss_language": "en"}], "synonyms": ["तुलाभारः"], "synonyms_slp1": ["tulABAraH"]}], "tulaDiroha": [{"id": "tulADiroha", "headword": "तुलाधिरोह", "headword_slp1": "tulADiroha", "fold": "tulaDiroha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tul-ādhiroha (EI 3), same as tulā-puruṣa.", "gloss_language": "en"}]}], "tulapurusa": [{"id": "tulApuruza", "headword": "तुलापुरुष", "headword_slp1": "tulApuruza", "fold": "tulapurusa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulā-puruṣa (EI 29; CII 4), name of a mahādāna; same as tulā-bhāra.", "gloss_language": "en"}], "synonyms": ["तुलापुरुषः"], "synonyms_slp1": ["tulApuruzaH"]}], "tulasivivaha": [{"id": "tulasIvivAha", "headword": "तुलसीविवाह", "headword_slp1": "tulasIvivAha", "fold": "tulasivivaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulasī-vivāha (EI 32), name of a ceremony.", "gloss_language": "en"}], "synonyms": ["तुलसीविवाहः"], "synonyms_slp1": ["tulasIvivAhaH"]}], "tulu": [{"id": "tulu", "headword": "तुलु", "headword_slp1": "tulu", "fold": "tulu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Tulu, name of a language which is written in Malayāl̤am characters.", "gloss_language": "en"}]}], "tulya": [{"id": "tulya", "headword": "तुल्य", "headword_slp1": "tulya", "fold": "tulya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulya (SITI), literally, ‘equal’; a true copy.", "gloss_language": "en"}], "synonyms": ["तुल्यः"], "synonyms_slp1": ["tulyaH"]}], "tulyameya": [{"id": "tulyameya", "headword": "तुल्यमेय", "headword_slp1": "tulyameya", "fold": "tulyameya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulya-meya (EI 7, 10; HRS), ‘what is to be weighed and measured’; same as meya in deya-meya; known from records like those of Harṣavardhana, in which it may be epithet of bhāga-bhoga or a separate item (Ind. Ep., p. 394).", "gloss_language": "en"}]}], "tulakuli": [{"id": "tulAkkUli", "headword": "तुलाक्कूलि", "headword_slp1": "tulAkkUli", "fold": "tulakuli", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tulā-kkūli (SITI), Sanskrit-Tamil; fee for weighing in balance.", "gloss_language": "en"}]}], "tulEpon": [{"id": "tulEppon", "headword": "तुलैप्पोन्", "headword_slp1": "tulEppon", "fold": "tulEpon", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tul̤ai-ppon , Tamil; ‘correct weight’ or ‘good current coin’.", "gloss_language": "en"}]}]}