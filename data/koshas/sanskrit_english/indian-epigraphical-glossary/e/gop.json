{"gopa": [{"id": "gopa", "headword": "गोप", "headword_slp1": "gopa", "fold": "gopa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gopa (EI 24), a watchman.\n (HD), officer in charge of the royal cattle; officer over five or ten villages according to the Arthaśāstra, II. 35.\n (HRS), according to the Arthaśāstra, (1) officer in charge of five or ten villages with revenue and police functions; (2) officer in charge of ten, twenty or forty families in the city; similar to the Paṭel, or Paṭvārī (H. Rev. Syst., pp. 146-47).", "gloss_language": "en"}], "synonyms": ["गोपः"], "synonyms_slp1": ["gopaH"]}], "gopala": [{"id": "gopAla", "headword": "गोपाल", "headword_slp1": "gopAla", "fold": "gopala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gopāla (IE 8-8), a milkman or cowherd.", "gloss_language": "en"}], "synonyms": ["गोपालः"], "synonyms_slp1": ["gopAlaH"]}], "gopaTa": [{"id": "gopaTa", "headword": "गोपथ", "headword_slp1": "gopaTa", "fold": "gopaTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "go-patha (EI 31), a cattle-track.", "gloss_language": "en"}], "synonyms": ["गोपथः"], "synonyms_slp1": ["gopaTaH"]}], "gopaTasara": [{"id": "gopaTaSara", "headword": "गोपथशर", "headword_slp1": "gopaTaSara", "fold": "gopaTasara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gopathaśara (CII 3), perhaps ‘a cattle-path’.", "gloss_language": "en"}]}], "gopicandana": [{"id": "gopIcandana", "headword": "गोपीचन्दन", "headword_slp1": "gopIcandana", "fold": "gopicandana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gopīcandana (IA 16), a kind of coloured earth.", "gloss_language": "en"}]}], "gopracara": [{"id": "gopracAra", "headword": "गोप्रचार", "headword_slp1": "gopracAra", "fold": "gopracara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gopracāra (EI 24, 31, 32; CII 4), pasture land.\n (EI 30), right of grazing cattle.", "gloss_language": "en"}], "synonyms": ["गोप्रचारः"], "synonyms_slp1": ["gopracAraH"]}], "gopracaraBumi": [{"id": "gopracAraBUmi", "headword": "गोप्रचारभूमि", "headword_slp1": "gopracAraBUmi", "fold": "gopracaraBumi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "go-pracāra-bhūmi (SITI), grazing-ground; same as Tamil kaṇr̤u-meypāl̤.", "gloss_language": "en"}]}], "gopura": [{"id": "gopura", "headword": "गोपुर", "headword_slp1": "gopura", "fold": "gopura", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gopura (EI 3, 19, 24) a gateway; the gateway of a temple; a tower.", "gloss_language": "en"}], "synonyms": ["गोपुरं"], "synonyms_slp1": ["gopuraM"]}], "gopuravasal": [{"id": "gopuravASal", "headword": "गोपुरवाशल्", "headword_slp1": "gopuravASal", "fold": "gopuravasal", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gopura-vāśal (SII 1), Sanskrit-Tamil; the gate of a gopura.", "gloss_language": "en"}]}]}