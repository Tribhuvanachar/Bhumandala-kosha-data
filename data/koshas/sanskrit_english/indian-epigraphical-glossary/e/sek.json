{"seka": [{"id": "Seka", "headword": "शेक", "headword_slp1": "Seka", "fold": "seka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śeka (EI 11), same as Sanskrit śikya, a loop or swing made of rope and suspended from the ends of a pole placed on one's shoulder for carrying loads, or the load itself. Cf. saṃkācitaka.", "gloss_language": "en"}]}], "sekyakara": [{"id": "sekyakAra", "headword": "सेक्यकार", "headword_slp1": "sekyakAra", "fold": "sekyakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sekyakāra (EI 12; BL), a brazier; secondarily, an engraver; cf. Bengali seṅkrā, a goldsmith.", "gloss_language": "en"}]}], "sekayam": [{"id": "SekkAyam", "headword": "शेक्कायम्", "headword_slp1": "SekkAyam", "fold": "sekayam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śekk-āyam (SITI), Tamil-Sanskrit; tax on oil-presses; also called śekk-ir̤ai and śekku-kkaḍamai (SII 12).", "gloss_language": "en"}]}], "sekukaqamE": [{"id": "SekkukaqamE", "headword": "शेक्कुकडमै", "headword_slp1": "SekkukaqamE", "fold": "sekukaqamE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śekku-kaḍamai (SII 12), same as śekk-āyam.", "gloss_language": "en"}]}], "sekuma": [{"id": "Sekkuma", "headword": "शेक्कुम", "headword_slp1": "Sekkuma", "fold": "sekuma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śekku-man̤r̤āḍi (SITI), Tamil; a tax or cess; probably related to śekku.", "gloss_language": "en"}]}]}