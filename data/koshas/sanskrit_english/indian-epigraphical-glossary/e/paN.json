{"paNga": [{"id": "paNga", "headword": "पङ्ग", "headword_slp1": "paNga", "fold": "paNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "paṅga, pāṅga (IE 8-5; EI 30, 33), Telugu-Kannaḍa; one-fourth of the produce sometimes collected from rent-free holdings in the possession of gods and Brāhmaṇas; a kind of tax; [] sometimes used to indicate ‘taxes in general’; cf. paṅga-śulka, paṅga-tappu, paṅga-tappu-śulka, paṅga-parihṛta, paṅga-parihṛta-parihāra, sarva-paṅga-parihṛta, etc. See Ep. Ind., Vol. XXXIII, pp. 54 ff.", "gloss_language": "en"}]}], "paNgatapu": [{"id": "paNgatappu", "headword": "पङ्गतप्पु", "headword_slp1": "paNgatappu", "fold": "paNgatapu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "paṅga-tappu (IE 8-5), probably, interest or fine on arrears of paṅga.", "gloss_language": "en"}]}], "paNgotkowa": [{"id": "paNgotkowa", "headword": "पङ्गोत्कोट", "headword_slp1": "paNgotkowa", "fold": "paNgotkowa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "paṅg-otkoṭa (EI 33), see paṅga and utkoṭa, names of levies.", "gloss_language": "en"}]}], "paNgu": [{"id": "paNgu", "headword": "पङ्गु", "headword_slp1": "paNgu", "fold": "paNgu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "paṅgu (EI 33), a share.", "gloss_language": "en"}], "synonyms": ["पंगु", "पङ्गुः"], "synonyms_slp1": ["paMgu", "paNguH"]}], "paNka": [{"id": "paNka", "headword": "पङ्क", "headword_slp1": "paNka", "fold": "paNka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "paṅka (EI 33), a share; cf. paṅga.", "gloss_language": "en"}], "synonyms": ["पंक", "पंकं", "पंकः", "पङ्कः"], "synonyms_slp1": ["paMka", "paMkaM", "paMkaH", "paNkaH"]}], "paNkti": [{"id": "paNkti", "headword": "पङ्क्ति", "headword_slp1": "paNkti", "fold": "paNkti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "paṅkti (IE 7-1-2), ‘ten’.", "gloss_language": "en"}], "synonyms": ["पंक्ति", "पंक्तिः", "पङ्क्तिः"], "synonyms_slp1": ["paMkti", "paMktiH", "paNktiH"]}]}