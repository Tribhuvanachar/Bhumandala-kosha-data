{"raRa": [{"id": "rARa", "headword": "राण", "headword_slp1": "rARa", "fold": "raRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇa (EI 16, 23), same as Rāṇaka; see Rāṇa-putra, rāṇa-kula.", "gloss_language": "en"}], "synonyms": ["राणं"], "synonyms_slp1": ["rARaM"]}, {"id": "rARA", "headword": "राणा", "headword_slp1": "rARA", "fold": "raRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇā (IE 8-2; EI 23, 30), derived from Rāṇaka; title of ruling chiefs; same as Rāṇa, Rāṇaka.\n Cf. Rannā.", "gloss_language": "en"}]}], "raRaka": [{"id": "rARaka", "headword": "राणक", "headword_slp1": "rARaka", "fold": "raRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇaka (IE 8-2; EI 23, 30; CII 4; BL; HD), derived from Rājanaka, Rājānaka or Rājanyaka; a feudatory title; title of feudatory rulers and, later, of the nobility. Cf. Ep. Ind., Vol. XVII, p. 321.\n (EI 9), explained as ‘the chief counsellor’.\n (EI 1), title of the great artist Śūlapāṇi described as Vārendraka-śilpi-goṣṭhī-cūḍāmaṇi.", "gloss_language": "en"}]}], "raRakacakravartin": [{"id": "rARakacakravartin", "headword": "राणकचक्रवर्तिन्", "headword_slp1": "rARakacakravartin", "fold": "raRakacakravartin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇaka-cakravartin (EI 33), feudatory title; cf. Mahā-sāmantādhipati.", "gloss_language": "en"}]}], "raRakula": [{"id": "rARakula", "headword": "राणकुल", "headword_slp1": "rARakula", "fold": "raRakula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "rāṇa-kula (LP), same as rāja-kula (q. v.).", "gloss_language": "en"}]}], "raRaraRaka": [{"id": "raRaraRaka", "headword": "रणरणक", "headword_slp1": "raRaraRaka", "fold": "raRaraRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "raṇaraṇaka (LP), anxiety.", "gloss_language": "en"}], "synonyms": ["रणरणकः"], "synonyms_slp1": ["raRaraRakaH"]}], "raRastamBa": [{"id": "raRastamBa", "headword": "रणस्तम्भ", "headword_slp1": "raRastamBa", "fold": "raRastamBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "raṇa-stambha (CII 3, 4), a victory-pillar; a column in memory of the victory in a battle; same as jaya-stambha.\n (BL), a memorial pillar raised for a person who died fighting for his master on the battle-field; same as vīra-kkal (q. v.).", "gloss_language": "en"}], "synonyms": ["रणस्तंभ", "रणस्तम्भः"], "synonyms_slp1": ["raRastaMBa", "raRastamBaH"]}], "raRaputra": [{"id": "rARaputra", "headword": "राणपुत्र", "headword_slp1": "rARaputra", "fold": "raRaputra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇa-putra (BL), also called Rāṇa-utra; literally, ‘the son of a subordinate king’; a title of nobility. See Rāja-putra.", "gloss_language": "en"}]}], "raROtra": [{"id": "rAROtra", "headword": "राणौत्र", "headword_slp1": "rAROtra", "fold": "raROtra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇa-utra (BL), see Rāṇa-putra.", "gloss_language": "en"}]}], "raRi": [{"id": "rARI", "headword": "राणी", "headword_slp1": "rARI", "fold": "raRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Rāṇī (EI 23, 33), feminine from of Rāṇa or Rāṇā (i. e. Rāṇaka); designation of a queen.", "gloss_language": "en"}]}]}