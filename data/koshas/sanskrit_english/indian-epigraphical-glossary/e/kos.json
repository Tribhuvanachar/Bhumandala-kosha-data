{"kosa": [{"id": "koza", "headword": "कोष", "headword_slp1": "koza", "fold": "kosa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṣa, treasure, see Ghoshal, H. Rev. Syst., pp. 15-16.", "gloss_language": "en"}], "synonyms": ["कोषं", "कोषः"], "synonyms_slp1": ["kozaM", "kozaH"]}], "kosaDipa": [{"id": "koSADipa", "headword": "कोशाधिप", "headword_slp1": "koSADipa", "fold": "kosaDipa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koś-ādhipa (EI 32, 33), a treasurer; same as Koś-ādhyakṣa.", "gloss_language": "en"}]}], "kosagfha": [{"id": "kozagfha", "headword": "कोषगृह", "headword_slp1": "kozagfha", "fold": "kosagfha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṣa-gṛha (HRS), treasury.", "gloss_language": "en"}]}], "kosaja": [{"id": "koSajA", "headword": "कोशजा", "headword_slp1": "koSajA", "fold": "kosaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kośajā (EI 9), a cocoon-producer.", "gloss_language": "en"}]}], "kosavaha": [{"id": "kozavAha", "headword": "कोषवाह", "headword_slp1": "kozavAha", "fold": "kosavaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṣavāha (EI 14), name of a land measure; as much land as can be irrigated by one koṣa or leather bucket.", "gloss_language": "en"}]}], "kosWa": [{"id": "kozWa", "headword": "कोष्ठ", "headword_slp1": "kozWa", "fold": "kosWa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṣṭha (IE 7-1-2), ‘four’. Cf. koṣṭhaka.", "gloss_language": "en"}], "synonyms": ["कोष्ठः"], "synonyms_slp1": ["kozWaH"]}], "kosWagara": [{"id": "kozWAgAra", "headword": "कोष्ठागार", "headword_slp1": "kozWAgAra", "fold": "kosWagara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṣṭh-āgāra (HRS), the royal granary.\n (EI 29), cf.