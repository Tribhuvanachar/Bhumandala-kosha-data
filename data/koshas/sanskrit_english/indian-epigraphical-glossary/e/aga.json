{"aga": [{"id": "aga", "headword": "अग", "headword_slp1": "aga", "fold": "aga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aga (IE 7-1-2), ‘seven’.\n (SII 3), earth or land.", "gloss_language": "en"}], "synonyms": ["अगः"], "synonyms_slp1": ["agaH"]}], "agama": [{"id": "Agama", "headword": "आगम", "headword_slp1": "Agama", "fold": "agama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āgama (SII 1), a doctrine; cf. Lākul-āgama (EI 32), the doctrine of Lakula (Lakulīśa). Cf. āgama-samaya.\n Cf. s-āgama-nirgama-praveśa (IE 8-5), ‘together with approaches, ingress and egress’.", "gloss_language": "en"}], "synonyms": ["आगमं", "आगमः"], "synonyms_slp1": ["AgamaM", "AgamaH"]}], "agamanigamadana": [{"id": "AgamanigamadAna", "headword": "आगमनिगमदान", "headword_slp1": "AgamanigamadAna", "fold": "agamanigamadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āgama-nigama-dāna (LP), tax for importing and exporting.", "gloss_language": "en"}]}], "agamarga": [{"id": "agamArga", "headword": "अगमार्ग", "headword_slp1": "agamArga", "fold": "agamarga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agamārga (SITI), a variety of dance performed in the presence of the gods in temples.", "gloss_language": "en"}]}], "agamasamaya": [{"id": "Agamasamaya", "headword": "आगमसमय", "headword_slp1": "Agamasamaya", "fold": "agamasamaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āgama-samaya, cf. Lākul-āgama-samaya (EI 32), the tenets of Lakula's doctrine.", "gloss_language": "en"}]}], "agamin": [{"id": "AgAmin", "headword": "आगामिन्", "headword_slp1": "AgAmin", "fold": "agamin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āgāmin (IE 8-5; EI 19; SITI), future income, future benefits; one of the 8 kinds of rights in the property; cf. aṣṭa-bhoga.", "gloss_language": "en"}]}], "agara": [{"id": "agara", "headword": "अगर", "headword_slp1": "agara", "fold": "agara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agara (EI 19), a corrupt form of agrahāra, often noticed in Tamil inscriptions.", "gloss_language": "en"}]}], "agarabrahmadeya": [{"id": "agarabrahmadeya", "headword": "अगरब्रह्मदेय", "headword_slp1": "agarabrahmadeya", "fold": "agarabrahmadeya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agara-brahmadeya (SITI), village granted to Brāhmaṇas; also called agara (agrahāra) and brahmadeya. See agara.", "gloss_language": "en"}]}], "agarapa": [{"id": "agarappa", "headword": "अगरप्प", "headword_slp1": "agarappa", "fold": "agarapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agara-ppar̤r̤u (SITI), Tamil; same as agara or agrahāra; land granted to Brāhmaṇas.", "gloss_language": "en"}]}], "agasali": [{"id": "agasAli", "headword": "अगसालि", "headword_slp1": "agasAli", "fold": "agasali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agasāli (EI 28), a goldsmith; same as Akṣaśālin.", "gloss_language": "en"}]}], "agahara": [{"id": "agahara", "headword": "अगहर", "headword_slp1": "agahara", "fold": "agahara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agahara, agāhara, āgahara (Chamba), corruptions of agrahāra.", "gloss_language": "en"}]}]}