-epigraphical-glossary", "senses": [{"gloss": "pavitra (EI 9), the argha vessel.\n (Ind. Ant., Vol. IX, p. 187), thread, 360 of which are tied round the neck of the image of Kṛṣṇa on Śrāvaṇa su-di 12.\n Cf. Caitra-pavitra.", "gloss_language": "en"}], "synonyms": ["पवित्रं", "पवित्रः"], "synonyms_slp1": ["pavitraM", "pavitraH"]}], "pavitraka": [{"id": "pavitraka", "headword": "पवित्रक", "headword_slp1": "pavitraka", "fold": "pavitraka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pavitraka (EI 1), meaning uncertain.", "gloss_language": "en"}], "synonyms": ["पवित्रकं", "पवित्रकः"], "synonyms_slp1": ["pavitrakaM", "pavitrakaH"]}]}