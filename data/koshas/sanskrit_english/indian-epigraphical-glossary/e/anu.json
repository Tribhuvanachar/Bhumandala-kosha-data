our.", "gloss_language": "en"}]}], "anuDyanarata": [{"id": "anuDyAnarata", "headword": "अनुध्यानरत", "headword_slp1": "anuDyAnarata", "fold": "anuDyanarata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "anudhyāna-rata (IE 8-2), see pād-ānudhyāna-rata, ‘engaged in meditating on the feet of’.", "gloss_language": "en"}]}], "anuDyata": [{"id": "anuDyAta", "headword": "अनुध्यात", "headword_slp1": "anuDyAta", "fold": "anuDyata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "anudhyāta (IE 8-2), see pād-ānudhyāta.", "gloss_language": "en"}]}], "anuDyeya": [{"id": "anuDyeya", "headword": "अनुध्येय", "headword_slp1": "anuDyeya", "fold": "anuDyeya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "anudhyeya (IE 8-2), same as anugrāhya; ‘to be favoured’.", "gloss_language": "en"}]}], "anudivasam": [{"id": "anudivasam", "headword": "अनुदिवसम्", "headword_slp1": "anudivasam", "fold": "anudivasam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "anudivasam (CII 1), daily.", "gloss_language": "en"}]}], "anudfs": [{"id": "anudfS", "headword": "अनुदृश्", "headword_slp1": "anudfS", "fold": "anudfs", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "anudṛś, cf. anudarśayanti (EI 15), ‘inform [as follows]’.", "gloss_language": "en"}]}], "anugajivita": [{"id": "anugajIvita", "headword": "अनुगजीवित", "headword_slp1": "anugajIvita", "fold": "anugajivita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "anuga-jīvita, spelt in Kannaḍa as aṇuga-jīvita or aṇuṃga-jīvita (SII 11-1), a fief held by a king's subordinate for his maintenance; similar to bīl̤a-vṛtti, bīl̤-ānuvṛtti.", "gloss_language": "en"}]}], "anugraha": [{"id": "anugraha", "headword": "अनुग्रह", "headword_slp1": "anugraha", "fold": "anugraha", "headword_language": "sa", "sour