etimes enumerated as: Cakra pāsa mogaru gadā ghana tomara tīraha | sakati sūla trisūla vajra kātara karaḍaṃḍha || Paṭukaṭārī kaṃta sarasī ghaḍu avājī | kaṇīu churī khaḍga nāli golā nārājī || ṣaṃḍuṃ ṣapnu muṃsala hala sīṃgani pharasī gupati gaṇi | niṣaṃga śāṃgi aṃkuśa guruja kuhaka bāṇa batrīsa bhaṇi || Cf. Prācīnagurjarakāvyasaṃgraha, G. O. S., pp. 106-07.", "gloss_language": "en"}]}], "sawaviviwapasamanvita": [{"id": "sAwaviviwapasamanvita", "headword": "साटविविटपसमन्वित", "headword_slp1": "sAwaviviwapasamanvita", "fold": "sawaviviwapasamanvita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "s-āṭavi-viṭapa-samanvita (EI 23), ‘together with forests and shrubs’.", "gloss_language": "en"}]}], "sawuvari": [{"id": "Sawwuvari", "headword": "शट्टुवरि", "headword_slp1": "Sawwuvari", "fold": "sawuvari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śaṭṭu-vari (SITI), Tamil; tax for the grazing ground in the village.", "gloss_language": "en"}]}]}