{"BujabalanmaqE": [{"id": "BujabalanmAqE", "headword": "भुजबलन्माडै", "headword_slp1": "BujabalanmAqE", "fold": "BujabalanmaqE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhujabalan-māḍai (SITI), name of a coin of the māḍai (māḍha) type. See māḍa, etc.", "gloss_language": "en"}]}], "Bujabalapratapacakravartin": [{"id": "BujabalapratApacakravartin", "headword": "भुजबलप्रतापचक्रवर्तिन्", "headword_slp1": "BujabalapratApacakravartin", "fold": "Bujabalapratapacakravartin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhujabalapratāpacakravartin (IE 8-2), see Cakravartin.", "gloss_language": "en"}]}], "BujabalaprOQapratapacakravartin": [{"id": "BujabalaprOQapratApacakravartin", "headword": "भुजबलप्रौढप्रतापचक्रवर्तिन्", "headword_slp1": "BujabalaprOQapratApacakravartin", "fold": "BujabalaprOQapratapacakravartin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhujabalaprauḍhapratāpacakravartin (IE 8-2), see Cakravartin.", "gloss_language": "en"}]}], "BujaNga": [{"id": "BujaNga", "headword": "भुजङ्ग", "headword_slp1": "BujaNga", "fold": "BujaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhujaṅga (IA 20), an ogre. The word bhujaṅga was adopted in Javanese in the sense of a ‘pupil, disciple, scholar; a philologist, poet, literary councillor; an officially appointed professional usually residing at or near the court’. It has been suggested on this basis that Bhavadeva-bhaṭṭa's title Bālavalabhī-bhujaṅga may really mean ‘the pupil of the Bālavalabhī school’. See IHQ, Vol. XXVII, pp. 80-82.", "gloss_language": "en"}], "synonyms": ["भुजंग", "भुजंगः", "भुजङ्गः"], "synonyms_slp1": ["BujaMga", "BujaMgaH", "BujaNgaH"]}], "Bujisyapatra": [{"id": "Bujizyapatra", "headword": "भुजिष्यपत्र", "headword_slp1": "Bujizyapatra", "fold": "Bujisyapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhujiṣya-patra (EI 24), a document granting maintenance.", "gloss_language": "en"}]}], "Bujyamana": [{"id": "BujyamAna", "headword": "भुज्यमान", "headword_slp1": "BujyamAna", "fold": "Bujyamana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhujyamāna (IA 18), also prabhujyamāna; ‘being enjoyed’.", "gloss_language": "en"}]}], "BujabalamaqE": [{"id": "BujabalamAqE", "headword": "भुजबलमाडै", "headword_slp1": "BujabalamAqE", "fold": "BujabalamaqE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhujabala-māḍai , ‘a māḍai issued by a ruler named or entitled Bhujabala’; see māḍa, māḍai.", "gloss_language": "en"}]}]}