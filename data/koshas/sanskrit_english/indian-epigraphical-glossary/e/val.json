{"valadi": [{"id": "valadI", "headword": "वलदी", "headword_slp1": "valadI", "fold": "valadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valadī (Ind. Ant., Vol. XVIII, p. 17, text line 21), correctly baladī derived from balīvarda; same as vara-balīvarda, etc.", "gloss_language": "en"}]}], "valagiri": [{"id": "vAlagiri", "headword": "वालगिरि", "headword_slp1": "vAlagiri", "fold": "valagiri", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāl̤a-giri (SITI), abbreviation of the name of the mythical mountain called cakravāla-giri.", "gloss_language": "en"}]}], "valanaqu": [{"id": "valanAqu", "headword": "वलनाडु", "headword_slp1": "valanAqu", "fold": "valanaqu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "val̤anāḍu (IE 8-4; EI 25), Tamil; a province; a district consisting of sub-divisions called kur̤r̤am or nāḍu.", "gloss_language": "en"}]}], "valaksa": [{"id": "valakza", "headword": "वलक्ष", "headword_slp1": "valakza", "fold": "valaksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valakṣa (IA 17), used to indicate the bright fortnight.", "gloss_language": "en"}], "synonyms": ["वलक्षः"], "synonyms_slp1": ["valakzaH"]}], "valaniya": [{"id": "vAlanIya", "headword": "वालनीय", "headword_slp1": "vAlanIya", "fold": "valaniya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vālanīya (LP), see valiṣyati.", "gloss_language": "en"}]}], "valatkOsan": [{"id": "valatkOzan", "headword": "वलत्कौषन्", "headword_slp1": "valatkOzan", "fold": "valatkOsan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Valatkauṣan (CII 3), official designation of uncertain import; probably, a mistake for Bala-kauṣṭhika, officer-in-charge of the treasury of the military department. Cf. Mahavalākoṣṭhika.", "gloss_language": "en"}]}], "valakosWika": [{"id": "valAkozWika", "headword": "वलाकोष्ठिक", "headword_slp1": "valAkozWika", "fold": "valakosWika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Valākoṣṭhika, probably, a mistake for Balakoṣṭhika; cf. Valat-kauṣan, Mahāvalākoṣṭhika.", "gloss_language": "en"}]}], "valaya": [{"id": "valaya", "headword": "वलय", "headword_slp1": "valaya", "fold": "valaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valaya (CITD), a ring; a bracelet; in Telugu-Kannaḍa, also an enclosure, a boundary.", "gloss_language": "en"}], "synonyms": ["वलयं", "वलयः"], "synonyms_slp1": ["valayaM", "valayaH"]}], "valayaswi": [{"id": "valayazwi", "headword": "वलयष्टि", "headword_slp1": "valayazwi", "fold": "valayaswi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vala-yaṣṭi (CII 4), mistake for bala-yaṣṭi, memorial pillar.", "gloss_language": "en"}]}], "valayayaswi": [{"id": "valayayazwi", "headword": "वलययष्टि", "headword_slp1": "valayayazwi", "fold": "valayayaswi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valaya-yaṣṭi (EI 33; CII 3), wrong emendation of bala-yaṣṭi and supposed to mean ‘a boundary-pillar’. See bala-yaṣṭi.", "gloss_language": "en"}]}], "valayitva": [{"id": "vAlayitvA", "headword": "वालयित्वा", "headword_slp1": "vAlayitvA", "fold": "valayitva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vālayitvā (LP), Gujarātī vāl̤īne.", "gloss_language": "en"}]}], "valhoqiya": [{"id": "valhoqIya", "headword": "वल्होडीय", "headword_slp1": "valhoqIya", "fold": "valhoqiya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valhoḍīya (LP), rams.", "gloss_language": "en"}]}], "vali": [{"id": "vAli", "headword": "वालि", "headword_slp1": "vAli", "fold": "vali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāl̤i (SII 2), ear-ring.", "gloss_language": "en"}], "synonyms": ["वालिः"], "synonyms_slp1": ["vAliH"]}], "valisyati": [{"id": "valisyati", "headword": "वलिस्यति", "headword_slp1": "valisyati", "fold": "valisyati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valiṣyati (LP), cf. Gujarātī vāḷi levāmāṃ āvaśe; see vālanīya.", "gloss_language": "en"}]}], "valita": [{"id": "valita", "headword": "वलित", "headword_slp1": "valita", "fold": "valita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valita, val̤ita (E 12; SITI), same as vaṇita; a small territorial unit; a district or its subdivision.", "gloss_language": "en"}], "synonyms": ["वलितः"], "synonyms_slp1": ["valitaH"]}], "valitapatraviDi": [{"id": "valitapatraviDi", "headword": "वलितपत्रविधि", "headword_slp1": "valitapatraviDi", "fold": "valitapatraviDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valita-patra-vidhi (LP), cf. Gujarātī val̤at-dān-khat.", "gloss_language": "en"}]}], "valivarda": [{"id": "valIvarda", "headword": "वलीवर्द", "headword_slp1": "valIvarda", "fold": "valivarda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valīvarda, variant spelling of balīvarda (q. v.); cf. a-param-parā-valivarda, etc. (IE 8-5); a pair of bullocks [which the villagers were obliged to provide for the cart of the royal officers when they were camping or touring in the village].", "gloss_language": "en"}], "synonyms": ["वलीवर्दः", "वलीवर्द्द", "वलीवर्द्दः"], "synonyms_slp1": ["valIvardaH", "valIvardda", "valIvarddaH"]}], "vala": [{"id": "valla", "headword": "वल्ल", "headword_slp1": "valla", "fold": "vala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valla (IE 8-8), name of a weight equal to 3 ratis; see dvi-vallakya.", "gloss_language": "en"}, {"gloss": "valla , equal to 3 ratis.", "gloss_language": "en"}], "synonyms": ["वल्लः"], "synonyms_slp1": ["vallaH"]}, {"id": "vAla", "headword": "वाल", "headword_slp1": "vAla", "fold": "vala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāta (IE 8-5; EI 15; CII 3), cf. sa-bhūta-vāta-pratyāya, etc.; probably, storms (cf. udvāta; also called āvāta.)", "gloss_language": "en"}], "synonyms": ["वालः"], "synonyms_slp1": ["vAlaH"]}], "valaBa": [{"id": "vallaBa", "headword": "वल्लभ", "headword_slp1": "vallaBa", "fold": "valaBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vallabha (IE 8-3; EI 12, 26), the king's favourite or a courtier; same as Rājavallabha.\n (IE 8-2), same as Vallabharāja; a shortened form of the title Śrī-pṛthivī-vallabha assumed by certain imperial rulers of the Kannaḍa-speaking area.", "gloss_language": "en"}], "synonyms": ["वल्लभः"], "synonyms_slp1": ["vallaBaH"]}], "valakya": [{"id": "vallakya", "headword": "वल्लक्य", "headword_slp1": "vallakya", "fold": "valakya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vallakya, cf. dvi-vallakya.", "gloss_language": "en"}]}], "valava": [{"id": "vallava", "headword": "वल्लव", "headword_slp1": "vallava", "fold": "valava", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vallava (IE 8-3; 27; LL), official designation; officer in charge of the king's cattle; same as Sanskrit Vallabha, a herdsman.", "gloss_language": "en"}], "synonyms": ["वल्लवः"], "synonyms_slp1": ["vallavaH"]}], "valamaYjaqi": [{"id": "vAlamaYjAqi", "headword": "वालमञ्जाडि", "headword_slp1": "vAlamaYjAqi", "fold": "valamaYjaqi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāla-mañjāḍi (SITI), Tamil; probably the same as vāla-vari and vāla-kkāṇam; tax of a mañjāḍi on the units of measurement in the length of a house-site.", "gloss_language": "en"}]}], "valaNgEiqaNgEmaganmE": [{"id": "valaNgEiqaNgEmaganmE", "headword": "वलङ्गैइडङ्गैमगन्मै", "headword_slp1": "valaNgEiqaNgEmaganmE", "fold": "valaNgEiqaNgEmaganmE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "valaṅgai-iḍaṅgai-maganmai (SITI), Tamil; tax on the right-hand and left-hand castes, to be paid by all able-bodied men capable of bearing arms.", "gloss_language": "en"}]}], "val": [{"id": "val", "headword": "वल्", "headword_slp1": "val", "fold": "val", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "val , sometimes regarded as (1/20) of a gadyāṇa.", "gloss_language": "en"}]}], "valalva": [{"id": "valAlva", "headword": "वलाल्व", "headword_slp1": "valAlva", "fold": "valalva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "val̤āl-val̤̣i-tir̤antān-gul̤ikai , Pāṇḍya coin supposed to be issued by Jaṭāvarman Sundara-pāṇḍya I; see gulikā, etc.", "gloss_language": "en"}]}], "valudiyacuvargam": [{"id": "valudiyaccuvargam", "headword": "वलुदियच्चुवर्गम्", "headword_slp1": "valudiyaccuvargam", "fold": "valudiyacuvargam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "val̤udiy-accu-vargam , see accu.", "gloss_language": "en"}]}]}