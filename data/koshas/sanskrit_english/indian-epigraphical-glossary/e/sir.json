{"sira": [{"id": "sIrA", "headword": "सीरा", "headword_slp1": "sIrA", "fold": "sira", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sīrā (IA 18), a land measure equal to four halas. See hala.", "gloss_language": "en"}]}], "siraHpraDanin": [{"id": "SiraHpraDAnin", "headword": "शिरःप्रधानिन्", "headword_slp1": "SiraHpraDAnin", "fold": "siraHpraDanin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śiraḥ-pradhānin (ASLV), cf. Tamil Śirappradāni (SITI), a senior minister; cf. Pradhāni, Mahāpradhāni, etc.", "gloss_language": "en"}]}], "siraHsTayin": [{"id": "SiraHsTAyin", "headword": "शिरःस्थायिन्", "headword_slp1": "SiraHsTAyin", "fold": "siraHsTayin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śiraḥ-sthāyin (IA 17), used in the description of a trial by ordeal with reference to the bearing of some sacred symbol or image on the head of the accused while undergoing it.", "gloss_language": "en"}]}], "sirakawa": [{"id": "sirakawA", "headword": "सिरकटा", "headword_slp1": "sirakawA", "fold": "sirakawa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sira-kaṭā, cf. sira-kaṭā tambā-paṭā (JBORS, Vol. XVIII, pp. 219-20), Od̤iyā; same as rakata-paṭā, Sanskrit rakta-paṭṭaka. See also rakta-mānya.", "gloss_language": "en"}]}], "siriqika": [{"id": "siriqika", "headword": "सिरिडिक", "headword_slp1": "siriqika", "fold": "siriqika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "siriḍika, siriḍikā (EI 32), name of a tax.", "gloss_language": "en"}]}], "siroraksika": [{"id": "Sirorakzika", "headword": "शिरोरक्षिक", "headword_slp1": "Sirorakzika", "fold": "siroraksika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śiro-rakṣika (IE 8-3), body-guard of the king.", "gloss_language": "en"}]}], "sirovartana": [{"id": "Sirovartt