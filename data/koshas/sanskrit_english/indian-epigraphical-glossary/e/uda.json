{"udagayana": [{"id": "udagayana", "headword": "उदगयन", "headword_slp1": "udagayana", "fold": "udagayana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udag-ayana (EI 23), the winter solstice; same as uttarāyaṇa.", "gloss_language": "en"}], "synonyms": ["उदगयनं"], "synonyms_slp1": ["udagayanaM"]}], "udagayanaparvan": [{"id": "udagayanaparvan", "headword": "उदगयनपर्वन्", "headword_slp1": "udagayanaparvan", "fold": "udagayanaparvan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udagayana-parvan (EI 20), cf. udag-ayana.", "gloss_language": "en"}]}], "udakabanDa": [{"id": "udakabanDa", "headword": "उदकबन्ध", "headword_slp1": "udakabanDa", "fold": "udakabanDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udaka-bandha (EI 3), a sluice.", "gloss_language": "en"}]}], "udakaDara": [{"id": "udakaDArA", "headword": "उदकधारा", "headword_slp1": "udakaDArA", "fold": "udakaDara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udaka-dhārā, cf. udaka-dārai (SITI), [a gift given] with the libation of water; also referred to in Tamil as udakañśeydu and udakaṃ paṇṇi. See udaka-pūrvam, etc.", "gloss_language": "en"}]}], "udakapurvam": [{"id": "udakapUrvam", "headword": "उदकपूर्वम्", "headword_slp1": "udakapUrvam", "fold": "udakapurvam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udaka-pūrvam (IA 7), also expressed as udak-ātisargeṇa, ‘with libations of water’; refers to the custom of pouring water in the hand of the donee while making the ceremonial gift of an object which cannot be placed in the latter's hands. Cf. Dra-vyasya nāma gṛhnīyād=dadān=īti tathā vadet | toyaṃ dadyāt=tato haste dāne vidhir=ayaṃ smṛtaḥ || (Agni Purāṇa, Ch. 209, verses 49-50).", "gloss_language": "en"}, {"gloss": "udaka-pūrvam , cf. udak-ātisargeṇa, udakena, tila-darbh-odaka-pavitra-pāṇinā, kuśa-lalā-pūta-hast-odakena, etc.", "gloss_language": "en"}]}], "udakasarga": [{"id": "udakasarga", "headword": "उदकसर्ग", "headword_slp1": "udakasarga", "fold": "udakasarga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udaka-sarga (IA 8), same as udak-ātisarga (cf. udaka-pūrvam).", "gloss_language": "en"}]}], "udakasiharakulaka": [{"id": "udakAsIhArakullaka", "headword": "उदकासीहारकुल्लक", "headword_slp1": "udakAsIhArakullaka", "fold": "udakasiharakulaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udak-āsīhāra-kullaka, cf. sa-vanaspaty-udak-āsīhāra-kullaka-pānīya-sametā (IE 8-5), translated as ‘together with the fruit-trees and with the water-courses and channels’ (with the omission of the doubtful words).", "gloss_language": "en"}]}], "udamana": [{"id": "udamAna", "headword": "उदमान", "headword_slp1": "udamAna", "fold": "udamana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udamāna (IE 8-6; EI 29), a small land measure; probably the same as unmāna and udāna.", "gloss_language": "en"}], "synonyms": ["उदमानः"], "synonyms_slp1": ["udamAnaH"]}], "udana": [{"id": "udAna", "headword": "उदान", "headword_slp1": "udAna", "fold": "udana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udāna, see udamāna.", "gloss_language": "en"}], "synonyms": ["उदानः"], "synonyms_slp1": ["udAnaH"]}], "udapana": [{"id": "udapAna", "headword": "उदपान", "headword_slp1": "udapAna", "fold": "udapana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udapāna (CII 1; LL), a well or reservoir.", "gloss_language": "en"}], "synonyms": ["उदपानं", "उदपानः"], "synonyms_slp1": ["udapAnaM", "udapAnaH"]}], "udara": [{"id": "udAra", "headword": "उदार", "headword_slp1": "udAra", "fold": "udara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udāra (CII 1), a person of high rank; a rich man.", "gloss_language": "en"}], "synonyms": ["उदारः"], "synonyms_slp1": ["udAraH"]}], "udarabanDana": [{"id": "udarabanDana", "headword": "उदरबन्धन", "headword_slp1": "udarabanDana", "fold": "udarabanDana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udara-bandhana (SII) 2), a waist-band; name of an ornament.", "gloss_language": "en"}]}], "udaramBariRa": [{"id": "udaramBarIRa", "headword": "उदरम्भरीण", "headword_slp1": "udaramBarIRa", "fold": "udaramBariRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udaram-bharīṇa (IA 17), same as udaram-bharin, ‘filling the belly.’", "gloss_language": "en"}]}], "udarcis": [{"id": "udarcis", "headword": "उदर्चिस्", "headword_slp1": "udarcis", "fold": "udarcis", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udarcis (IE 7-1-2), ‘three’.", "gloss_language": "en"}], "synonyms": ["उदर्च्चिस्"], "synonyms_slp1": ["udarccis"]}], "udasina": [{"id": "udAsIna", "headword": "उदासीन", "headword_slp1": "udAsIna", "fold": "udasina", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udāsīna, cf. udāsina-vāriyam (SITI), a committee which is neutral to both the parties; same as madhyastha or the arbitration committee.", "gloss_language": "en"}], "synonyms": ["उदासीनः"], "synonyms_slp1": ["udAsInaH"]}], "udaya": [{"id": "udaya", "headword": "उदय", "headword_slp1": "udaya", "fold": "udaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "udaya (EI 24), ‘the produce’ [of a field]’.", "gloss_language": "en"}], "synonyms": ["उदयः"], "synonyms_slp1": ["udayaH"]}], "udayagiri": [{"id": "udayagiri", "headword": "उदयगिरि", "headword_slp1": "udayagiri", "fold": "udayagiri", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Udaya-giri (IA 22), t