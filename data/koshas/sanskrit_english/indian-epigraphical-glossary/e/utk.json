{"utkalita": [{"id": "utkalita", "headword": "उत्कलित", "headword_slp1": "utkalita", "fold": "utkalita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkalita, cf. kaṭakam=utkalitam (IA 14, 30), ‘the camp was pitched’.", "gloss_language": "en"}], "synonyms": ["उत्कलितः"], "synonyms_slp1": ["utkalitaH"]}], "utkara": [{"id": "utkara", "headword": "उत्कर", "headword_slp1": "utkara", "fold": "utkara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkara (IE 8-5), probably, minor taxes; but see kāru-kara. Cf. upakara, nikara, etc. But see also Ghoshal, H. Rev. Syst., p. 47.", "gloss_language": "en"}], "synonyms": ["उत्करः"], "synonyms_slp1": ["utkaraH"]}], "utkarRita": [{"id": "utkarRita", "headword": "उत्कर्णित", "headword_slp1": "utkarRita", "fold": "utkarRita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkarṇita (LP), frightened.", "gloss_language": "en"}]}], "utkarsa": [{"id": "utkarza", "headword": "उत्कर्ष", "headword_slp1": "utkarza", "fold": "utkarsa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkarṣa (CII 1), used in the sense of utkṛṣṭa.", "gloss_language": "en"}], "synonyms": ["उत्कर्षः"], "synonyms_slp1": ["utkarzaH"]}], "utkirRa": [{"id": "utkIrRa", "headword": "उत्कीर्ण", "headword_slp1": "utkIrRa", "fold": "utkirRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkīrṇa (CII 3), ‘engraved’; a technical expression for the actual engraving of an inscription on copper or stone; sometimes indicated by the word udghāṭita (Ep. Ind., Vol. XXXI, p. 20) and ghaṭita (Ind. Ant., Vol. XII, p. 121). See Ullekhaka, likhita.", "gloss_language": "en"}], "synonyms": ["उत्कीर्ण्ण"], "synonyms_slp1": ["utkIrRRa"]}], "utkowa": [{"id": "utkowa", "headword": "उत्कोट", "headword_slp1": "utkowa", "fold": "utkowa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkoṭa (IE 8-5, 8-8; EI 33), Prakrit ukkoḍa; a levy; customary presents to be made on occasions to the king or landlord and others. See Ep. Ind., Vol. XXXIII, p. 56.", "gloss_language": "en"}]}], "utkf": [{"id": "utkF", "headword": "उत्कॄ", "headword_slp1": "utkF", "fold": "utkf", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ut-kṝ, ‘to engrave’; cf. Prakrit kaṇḍāra, used in some Kannaḍa inscriptions (Bul. Dec. Col. Res. Inst., Vol. XI, 1950, pp. 170-71). Cf. utkīrṇa, udghāṭita, Ullekhaka, Vilekhaka.", "gloss_language": "en"}]}], "utkfswi": [{"id": "utkfzwi", "headword": "उत्कृष्टि", "headword_slp1": "utkfzwi", "fold": "utkfswi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkṛṣṭi (IE 8-8; EI 30), same as Prakrit ukkuṭṭhī (q. v.), Sanskrit utkrośa; wailing.", "gloss_language": "en"}]}], "utkrosa": [{"id": "utkroSa", "headword": "उत्क्रोश", "headword_slp1": "utkroSa", "fold": "utkrosa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkrośa (IE 8-8), see utkṛṣṭi.", "gloss_language": "en"}], "synonyms": ["उत्क्रोशः"], "synonyms_slp1": ["utkroSaH"]}], "utkfti": [{"id": "utkfti", "headword": "उत्कृति", "headword_slp1": "utkfti", "fold": "utkfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "utkṛti (IE 7-1-2), ‘twentysix’; rarely ‘twentyone’.", "gloss_language": "en"}], "synonyms": ["उत्कृतिः"], "synonyms_slp1": ["utkftiH"]}]}