{"jana": [{"id": "jana", "headword": "जन", "headword_slp1": "jana", "fold": "jana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jana (IE 7-1-2), ‘one’.", "gloss_language": "en"}], "synonyms": ["जनः"], "synonyms_slp1": ["janaH"]}], "janapada": [{"id": "janapada", "headword": "जनपद", "headword_slp1": "janapada", "fold": "janapada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "janapada, jānapada (IE 8-3; EI 23, 33), people of the countryside; regarded by some as an official designation (EI 26), and by others as a corporate body (EI 21).", "gloss_language": "en"}], "synonyms": ["जनपदः"], "synonyms_slp1": ["janapadaH"]}], "janapraDanin": [{"id": "janapraDAnin", "headword": "जनप्रधानिन्", "headword_slp1": "janapraDAnin", "fold": "janapraDanin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Jana-pradhānin (SITI), probably, a minister governing a district.", "gloss_language": "en"}]}], "janendra": [{"id": "janendra", "headword": "जनेन्द्र", "headword_slp1": "janendra", "fold": "janendra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Janendra (CII 3; IA 15), wrongly interpreted as ‘the lord of a people or tribe, a tribal ruler’; really, the same as Narendra, ‘a king’.", "gloss_language": "en"}], "synonyms": ["जनेंद्र", "जनेन्द्रः"], "synonyms_slp1": ["janeMdra", "janendraH"]}], "jani": [{"id": "jAnI", "headword": "जानी", "headword_slp1": "jAnI", "fold": "jani", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Jānī (EI 22), a corruption of Yājñika.", "gloss_language": "en"}]}], "janino": [{"id": "janIno", "headword": "जनीनो", "headword_slp1": "janIno", "fold": "janino", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "janīna (IA 17), ‘kind to people’.", "gloss_language": "en"}]}], "janiTa": [{"id": "janiTa", "headword": "जनिथ", "headword_slp1": "janiTa", "fold": "janiTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "janitha (EI 13), cf. sudhā-janitha-niḥsyandad-vapuḥ, ‘its body welling forth from nectarous sources’.", "gloss_language": "en"}]}], "janmaBumi": [{"id": "janmaBUmi", "headword": "जन्मभूमि", "headword_slp1": "janmaBUmi", "fold": "janmaBumi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "janma-bhūmi, called janma-kkāṇi in Tamil (SITI), gift of land, probably made for the lifetime of a person.", "gloss_language": "en"}], "synonyms": ["जन्मभूमिः"], "synonyms_slp1": ["janmaBUmiH"]}], "janmapatra": [{"id": "janmapatra", "headword": "जन्मपत्र", "headword_slp1": "janmapatra", "fold": "janmapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "janma-patra (EI 1), a document recording the birth of a child prepared by an astrologer on payment.", "gloss_language": "en"}]}], "janu": [{"id": "jAnu", "headword": "जानु", "headword_slp1": "jAnu", "fold": "janu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jānu (IE 7-1-2), ‘two’.", "gloss_language": "en"}]}], "janaDanasahita": [{"id": "janaDanasahita", "headword": "जनधनसहित", "headword_slp1": "janaDanasahita", "fold": "janaDanasahita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "jana-dhana-sahita (Ep. Ind., Vol. XXXV, p. 135), ‘together with the tenants and revenue income [of the village]’; some as sa-jana-dhana.", "gloss_language": "en"}]}]}