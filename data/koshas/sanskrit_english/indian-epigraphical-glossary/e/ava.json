{"avaBfTa": [{"id": "avaBfTa", "headword": "अवभृथ", "headword_slp1": "avaBfTa", "fold": "avaBfTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avabhṛtha (EI 9; CII 4), name of the ceremonial bath at the end of a sacrifice.", "gloss_language": "en"}], "synonyms": ["अवभृथः"], "synonyms_slp1": ["avaBfTaH"]}], "avacawita": [{"id": "avacawita", "headword": "अवचटित", "headword_slp1": "avacawita", "fold": "avacawita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avacaṭita (EI 13), a crack; cf. khaṇḍa-sphuṭit-āvacaṭita-patita-saṃskār-ārtham, ‘for the repairs of dilapidated, broken, cracked and fallen [parts]’.", "gloss_language": "en"}]}], "avacCina": [{"id": "avacCinna", "headword": "अवच्छिन्न", "headword_slp1": "avacCinna", "fold": "avacCina", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avacchinna, cf. sva-sīm-āvacchinna (IE 8-5), demarcated.", "gloss_language": "en"}], "synonyms": ["अवच्छिन्नं"], "synonyms_slp1": ["avacCinnaM"]}], "avadana": [{"id": "avadAna", "headword": "अवदान", "headword_slp1": "avadAna", "fold": "avadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avadāna, also spelt āvadāna (EI 28, 29, 33), Od̤iyā; a present; a tax; tax in general; also called āvedana.\n (SITI), same as Sanskrit avasāna; termination, end.", "gloss_language": "en"}], "synonyms": ["अवदानं"], "synonyms_slp1": ["avadAnaM"]}], "avadara": [{"id": "avadAra", "headword": "अवदार", "headword_slp1": "avadAra", "fold": "avadara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avadāra (EI 13), cf. paśukul-āvadāra-karmānta-koṇakalikā-gaṅgāgrāme; meaning uncertain; possibly ‘a pound’ or ‘a pen’.", "gloss_language": "en"}]}], "avaDanin": [{"id": "avaDAnin", "headword": "अवधानिन्", "headword_slp1": "avaDAnin", "fold": "avaDanin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Avadhānin (EI 16), title of Brāhmaṇas; cf. Śatāvadhāna.", "gloss_language": "en"}]}], "avaDaraRa": [{"id": "avaDAraRA", "headword": "अवधारणा", "headword_slp1": "avaDAraRA", "fold": "avaDaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avadhāraṇā, cf. adhikaraṇ-āvadhāraṇā, ‘official investigation’ (Ep. Ind., Vol. XXXI, p. 267).", "gloss_language": "en"}]}], "avaDi": [{"id": "avaDi", "headword": "अवधि", "headword_slp1": "avaDi", "fold": "avaDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avadhi, cf. avadher=anantaram (LP), ‘after the time limit is over’.", "gloss_language": "en"}], "synonyms": ["अवधिः"], "synonyms_slp1": ["avaDiH"]}, {"id": "avaDI", "headword": "अवधी", "headword_slp1": "avaDI", "fold": "avaDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Avadhī, language of Avadh (Oudh).", "gloss_language": "en"}]}], "avaha": [{"id": "AvAha", "headword": "आवाह", "headword_slp1": "AvAha", "fold": "avaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāha (CII 1), marriage of a son; cf. vivāha, ‘marriage of a daughter’.", "gloss_language": "en"}], "synonyms": ["आवाहः"], "synonyms_slp1": ["AvAhaH"]}, {"id": "avaha", "headword": "अवह", "headword_slp1": "avaha", "fold": "avaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-vaha (EI 26), refers to the freedom of the gift village from the obligation of carrying loads of the touring officers, etc., or of supplying a horse to them free of charges.", "gloss_language": "en"}], "synonyms": ["अवहः"], "synonyms_slp1": ["avahaH"]}], "avakara": [{"id": "avakara", "headword": "अवकर", "headword_slp1": "avakara", "fold": "avakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avakara (EI 32), sweepings, a mound. Cf. avaṣkara; also niravakara, remainder after deduction (Ep. Ind., Vol. XXVIII, p. 188).", "gloss_language": "en"}], "synonyms": ["अवकरः"], "synonyms_slp1": ["avakaraH"]}], "avakasa": [{"id": "avakASa", "headword": "अवकाश", "headword_slp1": "avakASa", "fold": "avakasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avakāśa (Ep. Ind., Vol. IV, p. 347, note 5), ‘opportunity for a grammatical rule taking effect’.", "gloss_language": "en"}], "synonyms": ["अवकाशः"], "synonyms_slp1": ["avakASaH"]}], "avalaga": [{"id": "avalagA", "headword": "अवलगा", "headword_slp1": "avalagA", "fold": "avalaga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avalagā (LP), same as Gujarātī ol̤aga; cf. avalagā sad=aiv=āvalokyā (LP), ‘care should be constantly taken’.", "gloss_language": "en"}]}], "avalagaka": [{"id": "avalagaka", "headword": "अवलगक", "headword_slp1": "avalagaka", "fold": "avalagaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avalagaka (EI 2; HRS), same as avalagā (q. v.); sometimes regarded as presents or supplies.", "gloss_language": "en"}]}], "avalagana": [{"id": "avalagana", "headword": "अवलगन", "headword_slp1": "avalagana", "fold": "avalagana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avalagana (EI 2; HRS), same as avalagaka and avalagā.", "gloss_language": "en"}]}], "avalambaka": [{"id": "avalambaka", "headword": "अवलम्बक", "headword_slp1": "avalambaka", "fold": "avalambaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avalambaka (EI 30), probably, a rod from which loops are suspended for carrying bundles.", "gloss_language": "en"}], "synonyms": ["अवलंबकः", "अवलम्बकः"], "synonyms_slp1": ["avalaMbakaH", "avalambakaH"]}], "avalokya": [{"id": "avalokya", "headword": "अवलोक्य", "headword_slp1": "avalokya", "fold": "avalokya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avalokya (IE 8-8), detection.", "gloss_language": "en"}]}], "avaRa": [{"id": "AvaRa", "headword": "आवण", "headword_slp1": "AvaRa", "fold": "avaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvaṇa (SITI), Tamil; a document; generally, a sale-deed; also called vilaiy-āvaṇam; cf. āvaṇa-kkal̤ari (SITI), a place where documents like sale-deeds, etc., are registered; registration office.", "gloss_language": "en"}]}], "avani": [{"id": "avanI", "headword": "अवनी", "headword_slp1": "avanI", "fold": "avani", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avanī (EI 7-1-2), ‘one’.\n (EI 3), a district.", "gloss_language": "en"}]}], "avanimaRqala": [{"id": "avanimaRqala", "headword": "अवनिमण्डल", "headword_slp1": "avanimaRqala", "fold": "avanimaRqala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avani-maṇḍala, cf. Kon-āvani-maṇḍala (EI 32), also called Kona-maṇḍala, Kona-sīma, etc.", "gloss_language": "en"}]}], "avaniranDranyaya": [{"id": "avaniranDranyAya", "headword": "अवनिरन्ध्रन्याय", "headword_slp1": "avaniranDranyAya", "fold": "avaniranDranyaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avani-randhra-nyāya (CII 4), same as bhūmi-cchidra-nyāya (q. v.), ‘the maxim of the fallow land.’", "gloss_language": "en"}]}], "avanivetana": [{"id": "avanivetana", "headword": "अवनिवेतन", "headword_slp1": "avanivetana", "fold": "avanivetana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avani-vetana (SITI), police duties of a village; contribution for such duties; the same as Tamil pā ṭikāval.", "gloss_language": "en"}]}], "avara": [{"id": "Avara", "headword": "आवर", "headword_slp1": "Avara", "fold": "avara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvara (CII 4), a stall. Cf. āvāra.", "gloss_language": "en"}]}, {"id": "AvAra", "headword": "आवार", "headword_slp1": "AvAra", "fold": "avara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāra (IE 8-5), cf. āpaṇeṣu āvāraḥ, ‘collections to be made from the shops in a market’. Cf. āvara.", "gloss_language": "en"}], "synonyms": ["आवारः"], "synonyms_slp1": ["AvAraH"]}], "avaraDika": [{"id": "avarADika", "headword": "अवराधिक", "headword_slp1": "avarADika", "fold": "avaraDika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avar-ādhika (CII 1), ‘more or less’.", "gloss_language": "en"}]}], "avaraja": [{"id": "avaraja", "headword": "अवरज", "headword_slp1": "avaraja", "fold": "avaraja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avaraja (ML), a younger brother or cousin.", "gloss_language": "en"}], "synonyms": ["अवरजः"], "synonyms_slp1": ["avarajaH"]}], "avaraRa": [{"id": "AvaraRa", "headword": "आवरण", "headword_slp1": "AvaraRa", "fold": "avaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvaraṇa (EI 17), a shield.\n (SITI), shelter, covering; same as prākāra or wall around the temple.", "gloss_language": "en"}], "synonyms": ["आवरणं"], "synonyms_slp1": ["AvaraRaM"]}], "avarjaniya": [{"id": "AvarjanIya", "headword": "आवर्जनीय", "headword_slp1": "AvarjanIya", "fold": "avarjaniya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvarjanīya (LP), ‘to be received’.", "gloss_language": "en"}]}], "avaroDana": [{"id": "avaroDana", "headword": "अवरोधन", "headword_slp1": "avaroDana", "fold": "avaroDana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avarodhana (CII 1), household; cf. antaḥpura.", "gloss_language": "en"}], "synonyms": ["अवरोधनं"], "synonyms_slp1": ["avaroDanaM"]}], "avaroDajana": [{"id": "avaroDajana", "headword": "अवरोधजन", "headword_slp1": "avaroDajana", "fold": "avaroDajana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avarodha-jana (EI 23), inmates of the royal harem or the king's wives and concubines; wrongly interpreted as ‘a watchman’.", "gloss_language": "en"}]}], "avarta": [{"id": "Avarta", "headword": "आवर्त", "headword_slp1": "Avarta", "fold": "avarta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvarta, cf. sarv-āvarta-yutā, ‘assigned as the date of payment as it falls annually’ (Ep. Ind., Vol. XIV, p. 310, note 1).", "gloss_language": "en"}], "synonyms": ["आवर्तः", "आवर्त्त", "आवर्त्तं", "आवर्त्तः"], "synonyms_slp1": ["AvartaH", "Avartta", "AvarttaM", "AvarttaH"]}], "avasa": [{"id": "AvAsa", "headword": "आवास", "headword_slp1": "AvAsa", "fold": "avasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāsa, cf. a-kūra-cullaka-vināśi-khaṭv-āvāsa (IE 8-5), shelter or accommodation [which the villagers were obliged to provide for the touring officers of the king]; cf. saṃvāsa, etc.", "gloss_language": "en"}], "synonyms": ["आवासः"], "synonyms_slp1": ["AvAsaH"]}], "avasaka": [{"id": "AvAsaka", "headword": "आवासक", "headword_slp1": "AvAsaka", "fold": "avasaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāsaka (IE 8-5; EI 25), same as āvāsa or saṃvāsa, i. e. accommodation [which the villagers were obliged to provide to the royal officers on tour].", "gloss_language": "en"}]}], "avasanika": [{"id": "AvAsanikA", "headword": "आवासनिका", "headword_slp1": "AvAsanikA", "fold": "avasanika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāsanikā (EI 1), a house.", "gloss_language": "en"}]}], "avasara": [{"id": "avasara", "headword": "अवसर", "headword_slp1": "avasara", "fold": "avasara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Avasara (SITI), an officer of the royal household having [] the duty of bringing to the notice of the king anything that demanded his immediate attention. Cf. Kārtākṛtika.", "gloss_language": "en"}, {"gloss": "avasara (Ep. Ind., Vol. XVI, p. 347), one of the periods when the worship is performed and offerings are made to the deity in a temple.", "gloss_language": "en"}], "synonyms": ["अवसरः"], "synonyms_slp1": ["avasaraH"]}], "avasaravartana": [{"id": "avasaravarttanA", "headword": "अवसरवर्त्तना", "headword_slp1": "avasaravarttanA", "fold": "avasaravartana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Avasara-varttanā (SITI), presents payable to an Avasara (q. v.).", "gloss_language": "en"}]}], "avasaTa": [{"id": "avasaTa", "headword": "अवसथ", "headword_slp1": "avasaTa", "fold": "avasaTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avasatha (IE 8-3), explained as ‘a college or a dharma-śālā’. But see Āvasathika.", "gloss_language": "en"}], "synonyms": ["अवसथः"], "synonyms_slp1": ["avasaTaH"]}], "avasaTika": [{"id": "AvasaTika", "headword": "आवसथिक", "headword_slp1": "AvasaTika", "fold": "avasaTika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Āvasathika (IE 8-3), variously explained as ‘the superintendent of avasathas, i. e. colleges or dharma-śālās’, ‘the supervisor of the royal palace and other government buildings’ (Hist. Beng., I, ed. Majumdar, p. 284); ‘one who keeps the domestic fire (āvasathya) burning with daily offerings’ (D. Bhattacharya, Halāyudha's Brāhmaṇasarvasva, p. xx); etc.\n (EI 9, 11, 24), title or family name of Brāhmaṇas. Cf. Āvasathin.", "gloss_language": "en"}], "synonyms": ["आवसथिकः"], "synonyms_slp1": ["AvasaTikaH"]}], "avasaTin": [{"id": "AvasaTin", "headword": "आवसथिन्", "headword_slp1": "AvasaTin", "fold": "avasaTin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Āvasathin (EI 23), explained as ‘one who keeps the sacred fire called āvasathya’; cf. Āvasathika.", "gloss_language": "en"}]}], "avaskara": [{"id": "avazkara", "headword": "अवष्कर", "headword_slp1": "avazkara", "fold": "avaskara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avaṣkara, sweepings, a mound; cf. s-oṣar-āvaṣkara-sthāha-nivīta-lavaṇākara (EI 22); also sa-gart-āvaṣkara (Ep. Ind., Vol. XXXV, p. 135, text line 21). See avakara.", "gloss_language": "en"}]}], "avaswabDi": [{"id": "avazwabDi", "headword": "अवष्टब्धि", "headword_slp1": "avazwabDi", "fold": "avaswabDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avaṣṭabdhi (LP), detention.", "gloss_language": "en"}]}], "avasTa": [{"id": "avasTA", "headword": "अवस्था", "headword_slp1": "avasTA", "fold": "avasTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avasthā (IA 16), a territorial unit.", "gloss_language": "en"}]}], "avasTika": [{"id": "AvasTika", "headword": "आवस्थिक", "headword_slp1": "AvasTika", "fold": "avasTika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Āvasthika (EI 23), corruption of Āvasathika; same as Āvasathin.", "gloss_language": "en"}]}], "avata": [{"id": "AvAta", "headword": "आवात", "headword_slp1": "AvAta", "fold": "avata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāta (IE 8-5), same as vāta, storm; cf. udvāta. Cf. also nivāta.\n (EI 32; CII 3; etc.), a fiscal term referring to the income from lands as a result of changes caused by natural agencies; an income probably resulting from storms. See vāta, probably meaning ‘a storm or tempest’; also āvāt-āya.", "gloss_language": "en"}]}], "avatara": [{"id": "avatAra", "headword": "अवतार", "headword_slp1": "avatAra", "fold": "avatara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avatāra (IE 7-1-2), ‘ten’.", "gloss_language": "en"}], "synonyms": ["अवतारः"], "synonyms_slp1": ["avatAraH"]}], "avataraRa": [{"id": "avataraRa", "headword": "अवतरण", "headword_slp1": "avataraRa", "fold": "avataraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avataraṇa, cf. gṛh-āvataraṇa (IE 8-5), probably the same as umbara-bheda (q. v.).", "gloss_language": "en"}], "synonyms": ["अवतरणं"], "synonyms_slp1": ["avataraRaM"]}], "avatariamavasya": [{"id": "avatAriamAvAsyA", "headword": "अवतारिअमावास्या", "headword_slp1": "avatAriamAvAsyA", "fold": "avatariamavasya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avatāri-amāvāsyā (IA 18), Kannaḍa name for the new-moon of Pauṣa.", "gloss_language": "en"}]}], "avataya": [{"id": "AvAtAya", "headword": "आवाताय", "headword_slp1": "AvAtAya", "fold": "avataya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvāt-āya (HRS), ‘the income derived from storms’; cf. āvāta and bhūta-vāta-pratyāya.", "gloss_language": "en"}]}], "avatrap": [{"id": "avatrap", "headword": "अवत्रप्", "headword_slp1": "avatrap", "fold": "avatrap", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avatrap (CII 1), ‘to be disinclined’.", "gloss_language": "en"}]}], "avaRqaya": [{"id": "avaRqAya", "headword": "अवण्डाय", "headword_slp1": "avaRqAya", "fold": "avaRqaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avaṇḍ-āya (Ep. Ind., Vol. V, p. 96), Telugu; name of a tax.", "gloss_language": "en"}]}], "avarasidDika": [{"id": "avArasidDika", "headword": "अवारसिद्धिक", "headword_slp1": "avArasidDika", "fold": "avarasidDika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-vāra-siddhika (IE), refers to the freedom of the gift village from the obligation to supply unpaid labour in turn. Cf. a-cāra-siddhika.", "gloss_language": "en"}]}], "avaRam": [{"id": "AvaRam", "headword": "आवणम्", "headword_slp1": "AvaRam", "fold": "avaRam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āvaṇam (SITI), Tamil a document; generally, a saledeed; also called vilaiy-āvaṇam.; cf. āvaṇa-kkal̤ari (SITI), place where documents like the sale-deeds, etc., are registered; a registration office.", "gloss_language": "en"}]}], "avasaravartanE": [{"id": "avasaravarttanE", "headword": "अवसरवर्त्तनै", "headword_slp1": "avasaravarttanE", "fold": "avasaravartanE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "avasara-varttanai (SITI), presents payable to an Avasara, an officer of the royal household having the duty of bringing to the notice of the king anything that demanded his immediate attention.", "gloss_language": "en"}]}]}