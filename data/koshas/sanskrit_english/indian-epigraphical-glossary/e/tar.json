{"tar": [{"id": "tAr", "headword": "तार्", "headword_slp1": "tAr", "fold": "tar", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tār (SII 1), name of a silver coin, equal to (1/6) of a gold fanam.", "gloss_language": "en"}, {"gloss": "tār , name of a silver coin, equal to (1/6) of a gold fanam.", "gloss_language": "en"}]}], "tara": [{"id": "tara", "headword": "तर", "headword_slp1": "tara", "fold": "tara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tara (EI 9), same as nilaya; the family aggregate of dwellings with some of them meant for servants and artisans; also a street or a hamlet.\n (HRS), same as tara-deya, ferry dues, as indicated by the Arthaśāstra. See tārya.\n Cf. taram (EI 7), revenue.", "gloss_language": "en"}], "synonyms": ["तरः"], "synonyms_slp1": ["taraH"]}], "taradeya": [{"id": "taradeya", "headword": "तरदेय", "headword_slp1": "taradeya", "fold": "taradeya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tara-deya, ferry dues. See Ghoshal, H. Rev. Syst., pp. 78, 227.", "gloss_language": "en"}]}], "tarapaRi": [{"id": "tarapaRI", "headword": "तरपणी", "headword_slp1": "tarapaRI", "fold": "tarapaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tarapaṇī (HA), a wooden water-vessel used by Jain monks.", "gloss_language": "en"}]}], "tarapati": [{"id": "tarapati", "headword": "तरपति", "headword_slp1": "tarapati", "fold": "tarapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Tarapati (IE 8-3; CII 4; HD), officer in charge of the ferries; superintendent of the ferries; cf. Tarika and Tairthika; but see Ep. Ind., Vol. XVII, p. 321, where Tarika and Tara-patika are separately mentioned, and Ep. Ind., Vol. XVIII, p. 306, text line 35 where Tarapati is likewise mentioned separately from Tarika.", "gloss_language": "en"}], "synonyms": ["तरपतिः"], "synonyms_slp1": ["tarapatiH"]}], "taravara": [{"id": "taravara", "headword": "तरवर", "headword_slp1": "taravara", "fold": "taravara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Taravara (EI 20, 25), same as Talavara (q. v.); official designation.", "gloss_language": "en"}]}], "taravusatu": [{"id": "taravuSAttu", "headword": "तरवुशात्तु", "headword_slp1": "taravuSAttu", "fold": "taravusatu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Taravu-śāttu (SITI), an officer of the Col̤̣a kings, possibly associated with taravu.", "gloss_language": "en"}]}], "tarika": [{"id": "tarika", "headword": "तरिक", "headword_slp1": "tarika", "fold": "tarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Tarika (IE 8-3; HD), a ferry officer or one in charge of a ferry service. Cf. Ep. Ind., Vol. XVII, p. 321.", "gloss_language": "en"}, {"gloss": "tarika (HRS), same as tara; ferry dues.", "gloss_language": "en"}], "synonyms": ["तरिकः"], "synonyms_slp1": ["tarikaH"]}], "tarka": [{"id": "tarka", "headword": "तर्क", "headword_slp1": "tarka", "fold": "tarka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tarka (IE 7-1-2; EI 25), ‘six’.\n (CII 4), logic.", "gloss_language": "en"}], "synonyms": ["तर्कः"], "synonyms_slp1": ["tarkaH"]}], "tarkuka": [{"id": "tarkuka", "headword": "तर्कुक", "headword_slp1": "tarkuka", "fold": "tarkuka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Tarkuka (Ep. Ind., Vol. VIII, p. 34, note 7), a supplicant; a beggar.", "gloss_language": "en"}], "synonyms": ["तर्कुकः"], "synonyms_slp1": ["tarkukaH"]}], "tarya": [{"id": "tArya", "headword": "तार्य", "headword_slp1": "tArya", "fold": "tarya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tārya (HRS), same as tara; ferry dues.", "gloss_language": "en"}], "synonyms": ["तार्य्य"], "synonyms_slp1": ["tAryya"]}], "taragipawam": [{"id": "taragipAwwam", "headword": "तरगिपाट्टम्", "headword_slp1": "taragipAwwam", "fold": "taragipawam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "taragi-pāṭṭam (SII 12), brokerage fee.", "gloss_language": "en"}]}], "taraviqunel": [{"id": "taraviqunel", "headword": "तरविडुनेल्", "headword_slp1": "taraviqunel", "fold": "taraviqunel", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tarav-iḍu-něl (SITI), Tamil; paddy given in lieu of wages.", "gloss_language": "en"}]}], "taravu": [{"id": "taravu", "headword": "तरवु", "headword_slp1": "taravu", "fold": "taravu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "taravu (SITI), Tamil; ‘that which has been given’; collection of debt or tax on pressure; also a dun; also used in the sense of ‘order or instruction’.", "gloss_language": "en"}]}], "taravukoludal": [{"id": "taravukolludal", "headword": "तरवुकोल्लुदल्", "headword_slp1": "taravukolludal", "fold": "taravukoludal", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "taravu-kŏl̤l̤udal (SITI), Tamil; ‘to obtain a receipt for anything given’; collection of tax exercising pressure.", "gloss_language": "en"}]}], "tariakave": [{"id": "tariakkave", "headword": "तरिअक्कवे", "headword_slp1": "tariakkave", "fold": "tariakave", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tar̤i-akkave (SII 13), same as tar̤i-ppuḍavai.", "gloss_language": "en"}]}], "tarirE": [{"id": "tariirE", "headword": "तरिइरै", "headword_slp1": "tariirE", "fold": "tarirE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tar̤i-ir̤ai (SII 12, 13), same as tar̤i-ppuḍavai.", "gloss_language": "en"}]}], "tarikaqamE": [{"id": "tarikkaqamE", "headword": "तरिक्कडमै", "