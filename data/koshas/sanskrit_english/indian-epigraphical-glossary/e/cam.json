{"camara": [{"id": "cAmara", "headword": "चामर", "headword_slp1": "cAmara", "fold": "camara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "cāmara (IE 8-8), name of a coin; cf. cāmara-māda.\n (SII 3), a fly-whisk. See cauri, cavarālu.", "gloss_language": "en"}, {"gloss": "cāmara , also called cāmara-māḍa; probably ‘a māḍa bearing the figure of a fly-whisk’; see māḍa.", "gloss_language": "en"}], "synonyms": ["चामरं", "चामरः"], "synonyms_slp1": ["cAmaraM", "cAmaraH"]}], "camarakumara": [{"id": "cAmarakumAra", "headword": "चामरकुमार", "headword_slp1": "cAmarakumAra", "fold": "camarakumara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Cāmara-kumāra, cf. Cavari-kumāra (EI 10), probably, a prince in charge of the fly-whisk which was one of the royal insignia.", "gloss_language": "en"}]}], "camaramaqa": [{"id": "cAmaramAqa", "headword": "चामरमाड", "headword_slp1": "cAmaramAqa", "fold": "camaramaqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "cāmara-māḍa (EI 7), name of a coin; cf. cāmara.", "gloss_language": "en"}, {"gloss": "cāmara-māḍa , see cāmara and māḍa.", "gloss_language": "en"}]}], "campasasWi": [{"id": "campAzazWI", "headword": "चम्पाषष्ठी", "headword_slp1": "campAzazWI", "fold": "campasasWi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "campā-ṣaṣṭhī (EI 5), name of a tithi.", "gloss_language": "en"}]}], "camunayaka": [{"id": "camUnAyaka", "headword": "चमूनायक", "headword_slp1": "camUnAyaka", "fold": "camunayaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Camūnāyaka (EI 27), a general; cf. Senāpati, etc.", "gloss_language": "en"}]}], "camupa": [{"id": "camUpa", "headword": "चमूप", "headword_slp1": "camUpa", "fold": "camupa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Camūpa (IA 10), a g