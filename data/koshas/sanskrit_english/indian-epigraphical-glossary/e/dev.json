{"deva": [{"id": "deva", "headword": "देव", "headword_slp1": "deva", "fold": "deva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva, a god; cf. te-aḍimai (SITI), a dancing woman as the servant of a god; maid servant attached to a temple; cf. teva-kuḍimai, tenancy under the control of a temple; tevakulam (deva-kula), a temple.\n (EI 7), the king.\n (EI 3), a saint.\n (EI 7-1-2), ‘thirtythree’.", "gloss_language": "en"}], "synonyms": ["देवं", "देवः"], "synonyms_slp1": ["devaM", "devaH"]}], "devaBoga": [{"id": "devaBoga", "headword": "देवभोग", "headword_slp1": "devaBoga", "fold": "devaBoga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-bhoga (EI 23, 31; SITI), rent-free property of a temple; land given for the enjoyment of temples; same as deva-dāya, etc., Cf. devabhoga-hala.", "gloss_language": "en"}], "synonyms": ["देवभोगः"], "synonyms_slp1": ["devaBogaH"]}], "devaBogahala": [{"id": "devaBogahala", "headword": "देवभोगहल", "headword_slp1": "devaBogahala", "fold": "devaBogahala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devabhoga-hala (EI 7, 8, 15, 24), rent-free land in the possession of temples.", "gloss_language": "en"}]}], "devacCanda": [{"id": "devacCanda", "headword": "देवच्छन्द", "headword_slp1": "devacCanda", "fold": "devacCanda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-cchanda (SII 2), name of a jewel.", "gloss_language": "en"}], "synonyms": ["देवच्छंद", "देवच्छन्दः"], "synonyms_slp1": ["devacCaMda", "devacCandaH"]}], "devadana": [{"id": "devadAna", "headword": "देवदान", "headword_slp1": "devadAna", "fold": "devadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-dāna (EI 5, 23, 25, 30; SITI; ASLV), gift made to a god; rent-free land in the possession of a temple; same as deva-bhoga, deva-deya, deva-dāya, dev-āgrahāra.\n Cf. devadāna-ir̤aiyili (SITI), village or land granted to a temple.", "gloss_language": "en"}]}], "devadasi": [{"id": "devadAsI", "headword": "देवदासी", "headword_slp1": "devadAsI", "fold": "devadasi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-dāsī (EI 22, 33; LL), a dancing girl attached to a temple; a female temple-servant. See vilāsinī, gaṇikā, mahārī.", "gloss_language": "en"}]}], "devadaya": [{"id": "devadAya", "headword": "देवदाय", "headword_slp1": "devadAya", "fold": "devadaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-dāya (IE 8-5; EI 23; CII 4; SITI), a rent-free holding in the possession of a temple; a gift made in honour of a god; same as deva-deya, etc.", "gloss_language": "en"}]}], "devadeya": [{"id": "devadeya", "headword": "देवदेय", "headword_slp1": "devadeya", "fold": "devadeya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-deya (IE 8-5; HRS), grant made in favour of temples; same as deva-dāya, etc.", "gloss_language": "en"}]}], "devaDarma": [{"id": "devaDarma", "headword": "देवधर्म", "headword_slp1": "devaDarma", "fold": "devaDarma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-dharma (Ep. Ind., Vol. XXVIII, p. 144), same as deya-dharma when the gift was the image of a god.", "gloss_language": "en"}], "synonyms": ["देवधर्मः"], "synonyms_slp1": ["devaDarmaH"]}], "devaDyaksa": [{"id": "devADyakza", "headword": "देवाध्यक्ष", "headword_slp1": "devADyakza", "fold": "devaDyaksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Dev-ādhyakṣa, superintendent of religious foundations. See Ghoshal, H. Rev. Syst., p. 99.", "gloss_language": "en"}]}], "devadi": [{"id": "devadi", "headword": "देवदि", "headword_slp1": "devadi", "fold": "devadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devadi (IA 19), ‘the establishment of a temple’.", "gloss_language": "en"}]}], "devadroRi": [{"id": "devadroRI", "headword": "देवद्रोणी", "headword_slp1": "devadroRI", "fold": "devadroRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-droṇī (IE 8-3; EI 10), usually taken to mean ‘a procession of the images of gods’, or ‘procession or ablution of images’; but probably, ‘rent-free property of a temple’ (Ep. Ind., Vol. XXXIV pp. 143-44); cf. deva-droṇī-sambaddha (EI 23). A Prakrit inscription (A. R. Ep., 1959-60, No. B 173) has deva-doṇi data = Sanskrit deva-droṇī dattā.", "gloss_language": "en"}]}], "devadroRisambadDa": [{"id": "devadroRIsambadDa", "headword": "देवद्रोणीसम्बद्ध", "headword_slp1": "devadroRIsambadDa", "fold": "devadroRisambadDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devadroṇī-sambaddha (IE 8-3), same as Devadroṇy-adhikṛta; officer in charge of temple property (devadroṇī, usually taken in the sense of ‘a procession of the images of gods)’.", "gloss_language": "en"}]}], "devadroRyaDikfta": [{"id": "devadroRyaDikfta", "headword": "देवद्रोण्यधिकृत", "headword_slp1": "devadroRyaDikfta", "fold": "devadroRyaDikfta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devadroṇy-adhikṛta (IE 8-3; BL), explained as ‘the superintendent of the procession of idols’; but probably, the superintendent of the property of a temple or of temple property in general; same as Devadroṇī-sambaddha; cf. deva-droṇī (EI 13).", "gloss_language": "en"}]}], "devagara": [{"id": "devAgAra", "headword": "देवागार", "headword_slp1": "devAgAra", "fold": "devagara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dev-āgāra, cf. tevāram, devāram (SITI), a temple.", "gloss_language": "en"}], "synonyms": ["देवागारः"], "synonyms_slp1": ["devAgAraH"]}], "devagrahara": [{"id": "devAgrahAra", "headword": "देवाग्रहार", "headword_slp1": "devAgrahAra", "fold": "devagrahara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dev-āgrahāra (IE 8-5; EI 23, 25, 30; SITI), rent-free village granted to a temple; same as deva-bhoga, etc.; see agra-hāra.", "gloss_language": "en"}]}], "devagfha": [{"id": "devagfha", "headword": "देवगृह", "headword_slp1": "devagfha", "fold": "devagfha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-gṛha (EI 24), a temple.", "gloss_language": "en"}], "synonyms": ["देवगृहं"], "synonyms_slp1": ["devagfhaM"]}], "devagfhajagati": [{"id": "devagfhajagatI", "headword": "देवगृहजगती", "headword_slp1": "devagfhajagatI", "fold": "devagfhajagati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devagṛha-jagatī (IA 14), explained as ‘a temple and its ground’ or ‘a temple with the buildings attached to it.’ But cf. jagatī.", "gloss_language": "en"}]}], "devaka": [{"id": "devaka", "headword": "देवक", "headword_slp1": "devaka", "fold": "devaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devaka (IA 23), the guardian spirit or a god.", "gloss_language": "en"}], "synonyms": ["देवकः"], "synonyms_slp1": ["devakaH"]}], "devakaraRa": [{"id": "devakaraRa", "headword": "देवकरण", "headword_slp1": "devakaraRa", "fold": "devakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-karaṇa, cf. karaṇa (LP); explained as the deva-sthāna department.", "gloss_language": "en"}]}], "devakarman": [{"id": "devakarman", "headword": "देवकर्मन्", "headword_slp1": "devakarman", "fold": "devakarman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakarman (SII 1), divine rites.", "gloss_language": "en"}]}], "devakarmin": [{"id": "devakarmin", "headword": "देवकर्मिन्", "headword_slp1": "devakarmin", "fold": "devakarmin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devakarmin (EI 30; SII 1, 3, 12); cf. tevar-kan̤mi, devar-kan̤mi (EI 3; SITI); a Pūjāri or temple priest, a temple servant; servant of a god; an officer in charge of the affairs of a temple.", "gloss_language": "en"}]}], "devakriya": [{"id": "devakriyA", "headword": "देवक्रिया", "headword_slp1": "devakriyA", "fold": "devakriya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-kriyā (IA 23), worship of gods.", "gloss_language": "en"}]}], "devakula": [{"id": "devakula", "headword": "देवकुल", "headword_slp1": "devakula", "fold": "devakula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakula (EI 9, 23), a temple; cf. ācāryakula (LL).\n (EI 21), a gallery of portrait statues of deified or semi-deified ancestors.", "gloss_language": "en"}], "synonyms": ["देवकुलं"], "synonyms_slp1": ["devakulaM"]}], "devakulapuskariRi": [{"id": "devakulapuzkariRI", "headword": "देवकुलपुष्करिणी", "headword_slp1": "devakulapuzkariRI", "fold": "devakulapuskariRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakula-puṣkariṇī (IE 8-5), temples and tanks [the construction of the former and the excavation of the latter requiring the permission of the king or landlord].", "gloss_language": "en"}]}], "devakuli": [{"id": "devakulI", "headword": "देवकुली", "headword_slp1": "devakulI", "fold": "devakuli", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakulī (CII 4), a small shrine.", "gloss_language": "en"}]}], "devakulika": [{"id": "devakulika", "headword": "देवकुलिक", "headword_slp1": "devakulika", "fold": "devakulika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakulika (LL), a temple-servant.", "gloss_language": "en"}]}, {"id": "devakulikA", "headword": "देवकुलिका", "headword_slp1": "devakulikA", "fold": "devakulika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakulikā (EI 8; HA), a shrine; a cell; a supplementary or smaller shrine.", "gloss_language": "en"}]}], "devakuwikasWa": [{"id": "devakuwIkAzWa", "headword": "देवकुटीकाष्ठ", "headword_slp1": "devakuwIkAzWa", "fold": "devakuwikasWa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakuṭī-kāṣṭha (EI 7), a measuring rod.", "gloss_language": "en"}]}], "devalaya": [{"id": "devAlaya", "headword": "देवालय", "headword_slp1": "devAlaya", "fold": "devalaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dev-ālaya (EI 23), a temple; same as devakula.", "gloss_language": "en"}], "synonyms": ["देवालयः"], "synonyms_slp1": ["devAlayaH"]}], "devananpriya": [{"id": "devAnAMpriya", "headword": "देवानांप्रिय", "headword_slp1": "devAnAMpriya", "fold": "devananpriya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devānāṃpriya (EI 21; CII 1; LL), a royal title; title assumed by the Maurya kings.", "gloss_language": "en"}], "synonyms": ["देवानाम्प्रिय", "देवानाम्प्रियः"], "synonyms_slp1": ["devAnAmpriya", "devAnAmpriyaH"]}], "devaRqaja": [{"id": "devARqaja", "headword": "देवाण्डज", "headword_slp1": "devARqaja", "fold": "devaRqaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devāṇḍaja (EI 32), same as Garuḍa.", "gloss_language": "en"}]}], "devanikaya": [{"id": "devanikAya", "headword": "देवनिकाय", "headword_slp1": "devanikAya", "fold": "devanikaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-nikāya (Ep. Ind., Vol. XIII, p. 115), probably, temple authorities.", "gloss_language": "en"}], "synonyms": ["देवनिकायः"], "synonyms_slp1": ["devanikAyaH"]}], "devaputra": [{"id": "devaputra", "headword": "देवपुत्र", "headword_slp1": "devaputra", "fold": "devaputra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devaputra (IE 8-2; EI 8, 21, 30), royal title of foreign origin; ‘the Son of Heaven’; title of certain Kuṣāṇa kings; same as Daivaputra.\n (LL), Buddhist; an angel.", "gloss_language": "en"}]}], "devaraqiyal": [{"id": "devaraqiyAl", "headword": "देवरडियाल्", "headword_slp1": "devaraqiyAl", "fold": "devaraqiyal", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devaraḍiyāl̤ (ASLV), Tamil; a dancing girl attached to a temple.", "gloss_language": "en"}]}], "devaram": [{"id": "devAram", "headword": "देवारम्", "headword_slp1": "devAram", "fold": "devaram", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devāram (SITI), Tamil corruption of Sanskrit devāgāra; a temple.", "gloss_language": "en"}]}], "devatideva": [{"id": "devAtideva", "headword": "देवातिदेव", "headword_slp1": "devAtideva", "fold": "devatideva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devātideva (EI 1), epithet of the Buddha and gods.", "gloss_language": "en"}], "synonyms": ["देवातिदेवः"], "synonyms_slp1": ["devAtidevaH"]}], "devawisalam": [{"id": "devawisalam", "headword": "देवटिसलम्", "headword_slp1": "devawisalam", "fold": "devawisalam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devaṭisalam (EI 12), a ceremony indicative of royalty.", "gloss_language": "en"}]}], "devatra": [{"id": "devatrA", "headword": "देवत्रा", "headword_slp1": "devatrA", "fold": "devatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devatrā (IE 8-5), same as deva-dāya.", "gloss_language": "en"}]}], "devavarika": [{"id": "devavArika", "headword": "देववारिक", "headword_slp1": "devavArika", "fold": "devavarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Deva-vārika (EI 33), superintendent of a temple; cf. Vārika. See Ep. Ind., Vol. XXVII, p. 142, text line 35.", "gloss_language": "en"}]}], "devavesmakaraRa": [{"id": "devaveSmakaraRa", "headword": "देववेश्मकरण", "headword_slp1": "devaveSmakaraRa", "fold": "devavesmakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devaveśma-karaṇa, cf. karaṇa (LP); the department of temples.", "gloss_language": "en"}]}], "devavihara": [{"id": "devavihAra", "headword": "देवविहार", "headword_slp1": "devavihAra", "fold": "devavihara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-vihāra, land in the possession of temples. See Ghoshal, H. Rev. Syst., p. 217.", "gloss_language": "en"}]}], "devavfti": [{"id": "devavftti", "headword": "देववृत्ति", "headword_slp1": "devavftti", "fold": "devavfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-vṛtti (SITI), land set apart for the maintenance of temples.", "gloss_language": "en"}]}], "devayajYa": [{"id": "devayajYa", "headword": "देवयज्ञ", "headword_slp1": "devayajYa", "fold": "devayajYa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-yajña (CII 4), offerings to gods; one of the five mahāyajñas.", "gloss_language": "en"}], "synonyms": ["देवयज्ञः"], "synonyms_slp1": ["devayajYaH"]}], "devayatana": [{"id": "devAyatana", "headword": "देवायतन", "headword_slp1": "devAyatana", "fold": "devayatana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dev-āyatana (EI 23), a temple; same as devakula.", "gloss_language": "en"}], "synonyms": ["देवायतनं"], "synonyms_slp1": ["devAyatanaM"]}], "devi": [{"id": "devI", "headword": "देवी", "headword_slp1": "devI", "fold": "devi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devī (IE 8-2; CII 1, 3; LL), a title originally of wives [] of independent monarchs and later also of feudatory rulers; often used as a termination of the names of wives of rulers of all classes; cf. Mahādevī; also means the Mother-goddess.", "gloss_language": "en"}]}], "devikarmantika": [{"id": "devIkarmAntika", "headword": "देवीकर्मान्तिक", "headword_slp1": "devIkarmAntika", "fold": "devikarmantika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devī-karmāntika (EI 16), a temple officer.", "gloss_language": "en"}]}], "devikumara": [{"id": "devIkumAra", "headword": "देवीकुमार", "headword_slp1": "devIkumAra", "fold": "devikumara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Devī-kumāra (IA 18; CII 1), explained as ‘the son of a king, who has the rank of a prince’; the king's son born of a queen and not of a concubine.", "gloss_language": "en"}]}], "devotara": [{"id": "devottara", "headword": "देवोत्तर", "headword_slp1": "devottara", "fold": "devotara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devottara (IE 8-5), Bengali corruption of devatrā; same as deva-dāya, etc.", "gloss_language": "en"}]}], "devabrahmaRaBuktivarja": [{"id": "devabrAhmaRaBuktivarja", "headword": "देवब्राह्मणभुक्तिवर्ज", "headword_slp1": "devabrAhmaRaBuktivarja", "fold": "devabrahmaRaBuktivarja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "deva-Brāhmaṇa-bhukti-varja (EI 23, 30), ‘excluding the property of the gods (i. e. temples) and Brāhmaṇas’.", "gloss_language": "en"}]}], "devakulapuskariRyaDikan": [{"id": "devakulapuzkariRyADikaM", "headword": "देवकुलपुष्करिण्याधिकं", "headword_slp1": "devakulapuzkariRyADikaM", "fold": "devakulapuskariRyaDikan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "devakula-puṣkariṇy-ādhikaṃ kārayitvā , refers to the right of the donee to build temples and excavate tanks in the gift land without the permission of the king or landlord as was necessary in the case of ordinary tenants. Cf. Majumdar, Ins. Beng., Vol. III, p. 125.", "gloss_language": "en"}]}]}