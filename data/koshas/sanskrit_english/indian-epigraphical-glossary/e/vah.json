{"vaha": [{"id": "vaha", "headword": "वह", "headword_slp1": "vaha", "fold": "vaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vaha, cf. a-vaha (IE 8-5); [free] carrying of loads [which the villagers had to provide for the touring officers of the king or land-lord]; may also be a horse for the use of the officers.\n (EI 31; IA 18; CII 4), a streamlet; a water-channel.\n (Ep. Ind., Vol. XIV, p. 177), a common highway.", "gloss_language": "en"}], "synonyms": ["वहः"], "synonyms_slp1": ["vahaH"]}, {"id": "vAha", "headword": "वाह", "headword_slp1": "vAha", "fold": "vaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāha, cf. Vāha-nāyaka.", "gloss_language": "en"}], "synonyms": ["वाहः"], "synonyms_slp1": ["vAhaH"]}], "vahaka": [{"id": "vAhaka", "headword": "वाहक", "headword_slp1": "vAhaka", "fold": "vahaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāhaka (EI 3), probably, a driver or attendant of cattle.", "gloss_language": "en"}], "synonyms": ["वाहकः"], "synonyms_slp1": ["vAhakaH"]}], "vahala": [{"id": "vAhalA", "headword": "वाहला", "headword_slp1": "vAhalA", "fold": "vahala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāhalā (EI 3), a water course.", "gloss_language": "en"}]}], "vahali": [{"id": "vAhali", "headword": "वाहलि", "headword_slp1": "vAhali", "fold": "vahali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāhali (BL), official designation explained as ‘the lord of horses’.", "gloss_language": "en"}]}], "vahamana": [{"id": "vahamAna", "headword": "वहमान", "headword_slp1": "vahamAna", "fold": "vahamana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vahamāna (LP), cf. vahamāna-hala-balīvarda, ‘bullocks used in ploughing land’; vahamāna-samakara-bhūmi in which vahamāna means ‘[the land that is] being ploughed’.\n (LP), travelling.", "gloss_language": "en"}]}], "vahana": [{"id": "vAhana", "headword": "वाहन", "headword_slp1": "vAhana", "fold": "vahana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāhana (LP), a load-carrier; a cart, ship, etc. See vahitra.", "gloss_language": "en"}], "synonyms": ["वाहनं"], "synonyms_slp1": ["vAhanaM"]}], "vahanayaka": [{"id": "vAhanAyaka", "headword": "वाहनायक", "headword_slp1": "vAhanAyaka", "fold": "vahanayaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāha-nāyaka (EI 23), official designation; probably, ‘the officer in charge of the king's Khās Mahāls’ (from vāha, a plough); may also be the superintendent of transport. See vāhoṭaka.", "gloss_language": "en"}]}], "vahika": [{"id": "vahikA", "headword": "वहिका", "headword_slp1": "vahikA", "fold": "vahika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vahikā (LP), an account book.", "gloss_language": "en"}]}], "vahinipati": [{"id": "vAhinIpati", "headword": "वाहिनीपति", "headword_slp1": "vAhinIpati", "fold": "vahinipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāhinīpati (EI 28; IA 10), leader of forces; a general; cf. Senāpati, etc.", "gloss_language": "en"}], "synonyms": ["वाहिनीपतिः"], "synonyms_slp1": ["vAhinIpatiH"]}], "vahaRi": [{"id": "vahaRi", "headword": "वहणि", "headword_slp1": "vahaRi", "fold": "vahaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vahaṇi (IA 18), meaning uncertain.", "gloss_language": "en"}]}], "vahitra": [{"id": "vahitra", "headword": "वहित्र", "headword_slp1": "vahitra", "fold": "vahitra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vahitra (IE 8-5, 8-8; EI 30), boat or any large carrier like a cart; see vāhana. Cf. sārtha-vahitreṣu praveśe nirgame ca pratyekaṃ rūpakaḥ devasya yātr-otsave dātavyaḥ (Ep. Ind., Vol. XXV, p. 232).\n (IE 8-8), cf. bhāṇḍa-bhṛta-vahitra, ‘a wagon full of pots or jars’.", "gloss_language": "en"}], "synonyms": ["वहित्रं"], "synonyms_slp1": ["vahitraM"]}], "vahni": [{"id": "vahni", "headword": "वह्नि", "headword_slp1": "vahni", "fold": "vahni", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vahni (IE 7-1-2, EI 33), ‘three’.", "gloss_language": "en"}], "synonyms": ["वह्निः"], "synonyms_slp1": ["vahniH"]}], "vahowaka": [{"id": "vAhowaka", "headword": "वाहोटक", "headword_slp1": "vAhowaka", "fold": "vahowaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāhoṭaka (LP), either Gujarātī vighoṭi, an assessment of land collected per vighā (bīghā), or the plough tax (i. e. land tax) from vāha, a plough.", "gloss_language": "en"}]}], "vahyali": [{"id": "vAhyAli", "headword": "वाह्यालि", "headword_slp1": "vAhyAli", "fold": "vahyali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāhyāli (BL), explained as ‘stables’; cf. bāhy-āli.\n (EI 6), explained as ‘a camp’.", "gloss_language": "en"}]}]}