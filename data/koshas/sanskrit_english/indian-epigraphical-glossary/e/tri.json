{"tri": [{"id": "tri", "headword": "त्रि", "headword_slp1": "tri", "fold": "tri", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Tri (EI 32), abbreviation of Trivedin.", "gloss_language": "en"}, {"gloss": "tri (IE 7-1-2), ‘three’.", "gloss_language": "en"}], "synonyms": ["त्रिः"], "synonyms_slp1": ["triH"]}], "triBagaByantarasidDi": [{"id": "triBAgAByantarasidDi", "headword": "त्रिभागाभ्यन्तरसिद्धि", "headword_slp1": "triBAgAByantarasidDi", "fold": "triBagaByantarasidDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tribhāg-ābhyantara-siddhi (IE 8-5), generally spelt tribhog-ābhyantara-siddhi; the right to enjoy one-third of the revenue, the other two parts going in equal shares to gods and Brāhmaṇas. Cf. abhyantara-siddhi, bāhy-ābhyantara-siddhi, tribhoga.", "gloss_language": "en"}]}], "triBaNga": [{"id": "triBaNga", "headword": "त्रिभङ्ग", "headword_slp1": "triBaNga", "fold": "triBaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tri-bhaṅga (EI 17), pose in standing images with bends in three limbs, viz. the neck, the wrists and the knees.", "gloss_language": "en"}]}], "triBaNgi": [{"id": "triBaNgi", "headword": "त्रिभङ्गि", "headword_slp1": "triBaNgi", "fold": "triBaNgi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tri-bhaṅgi, cf. tri-bhaṅga; see Ep. Ind., Vol. XXXIV, p. 65.", "gloss_language": "en"}]}], "triBoga": [{"id": "triBoga", "headword": "त्रिभोग", "headword_slp1": "triBoga", "fold": "triBoga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "tri-bhoga (EI 16; IA 19), a joint tenure enjoyed by a private person, a god (or gods) and the Brāhmaṇas (cf. Ind. Ant., Vol. XIX, p. 271). See tribhāg-ābhyantara-siddhi, etc.", "gloss_language": "en"}]}], "triBogaByantara": [{"id": "triBogAByantara", "headword": "त्रिभोगाभ्यन्तर", "headword_slp