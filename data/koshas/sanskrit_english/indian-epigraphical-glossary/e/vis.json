{"visa": [{"id": "vIsa", "headword": "वीस", "headword_slp1": "vIsa", "fold": "visa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vīsa (IE 8-8; EI 5), name of a coin (JNSI, Vol. XXVI, pp. 127ff.); cf. lokkiya-vīsa, probably meaning ‘a vīsa minted at Lokkiguṇḍi’; Sanskrit viṃśa, viṃśaka, viṃśatika, or viṃśopaka.\n (Ep. Ind., Vol. VI, p. 232, note 6), Telugu-Kannaḍa; (1/16) of a haṇa (paṇa); but (1/20) of the standard coin in value essentially.\n (CITD), also called visā, visya, visāmu; Telugu-Kannaḍa; the fraction (1/10); gold equal in weight to one grain of rice; (1/256) of a Hun or Pagoda; 40 palas; a measure of land equal nearly to 2 acres.", "gloss_language": "en"}]}, {"id": "visA", "headword": "विसा", "headword_slp1": "visA", "fold": "visa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visā, also spelt visāmu (CITD), see vīsa.", "gloss_language": "en"}]}], "visaharaBoga": [{"id": "vizaharaBoga", "headword": "विषहरभोग", "headword_slp1": "vizaharaBoga", "fold": "visaharaBoga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣahara-bhoga (SITI), also called viṣa-vṛtti; land set apart for the support of a poison-doctor.", "gloss_language": "en"}]}], "visalapriyadrama": [{"id": "vIsalapriyadramma", "headword": "वीसलप्रियद्रम्म", "headword_slp1": "vIsalapriyadramma", "fold": "visalapriyadrama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vīsala-priya-dramma, also called vīsala-prī-dramma; cf. jīrṇa-viśvamalla-priya, etc. (A. R. Ep., 1957-58, Nos. B 490-92).", "gloss_language": "en"}, {"gloss": "vīsala-priya-dramma , also called vīsala-prī-dramma; cf. jīrṇa-viśvamalla-priya, Vīsala being the same as Viśvamalla.", "gloss_language": "en"}]}], "visansTula": [{"id": "visaMsTula", "headword": "विसंस्थुल", "headword_slp1": "visaMsTula", "fold": "visansTula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visaṃsthula (LP), agitated, unsteady.", "gloss_language": "en"}]}], "visatiaWuprasTa": [{"id": "visatiaWUprasTa", "headword": "विसतिअठूप्रस्थ", "headword_slp1": "visatiaWUprasTa", "fold": "visatiaWuprasTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visatiaṭhū-prastha (IA 18), a levy; probably viṃśatisatka-prastha, ‘one out of 20 prasthas.’", "gloss_language": "en"}]}], "visavfti": [{"id": "vizavftti", "headword": "विषवृत्ति", "headword_slp1": "vizavftti", "fold": "visavfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣa-vṛtti (SITI), same as viṣahara-bhoga.", "gloss_language": "en"}]}], "visaya": [{"id": "vizaya", "headword": "विषय", "headword_slp1": "vizaya", "fold": "visaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣaya (EI 8-4), a district; often a kingdom or territory; sometimes a viṣaya was included in a maṇḍala; but, in some cases, a maṇḍala was included in a viṣaya; at times maṇḍala and viṣaya were synonymous.\n (IE 8-5; EI 30; CII 3, 4; BL; SITI), a district; cf. viṣaya-suṅka (EI 24), the tax of a district; Viṣaya-vyavahārin, officer in the service of a district.\n (ASLV), same as nirvṛtti or koṭṭam; an administrative division.\n (IE 8-4; CII 4), sometimes used in a wider sense to indicate ‘a country’.\n (IE 7-1-2), ‘five’.", "gloss_language": "en"}], "synonyms": ["विषयः"], "synonyms_slp1": ["vizayaH"]}, {"id": "visaya", "headword": "विसय", "headword_slp1": "visaya", "fold": "visaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visaya (CITD), same as Telugu visā, visāmu.", "gloss_language": "en"}]}], "visayaBogika": [{"id": "vizayaBogika", "headword": "विषयभोगिक", "headword_slp1": "vizayaBogika", "fold": "visayaBogika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣaya-bhogika (EI 28), probably, the ināmdār or ināmdārs of a district.", "gloss_language": "en"}]}], "visayaBuBuj": [{"id": "vizayaBUBuj", "headword": "विषयभूभुज्", "headword_slp1": "vizayaBUBuj", "fold": "visayaBuBuj", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣaya-bhūbhuj (IA 15), explained as ‘a native ruler’ as opposed to a ‘foreign conqueror.’", "gloss_language": "en"}]}], "visayadana": [{"id": "vizayadAna", "headword": "विषयदान", "headword_slp1": "vizayadAna", "fold": "visayadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣaya-dāna (HRS), name of a tax (Ep. Ind., Vol. XI, p. 21; Vol. XIV, p. 196), probably, a regional tax or taxes realisable from a particular district; known from Gāhaḍavāla records; cf. viṣayālī.", "gloss_language": "en"}]}], "visayadanika": [{"id": "vizayadAnika", "headword": "विषयदानिक", "headword_slp1": "vizayadAnika", "fold": "visayadanika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣaya-dānika (EI 7; CII 4), collector of the levy called viṣaya-dāna; or a district officer in charge of gifts or an officer in charge of gift lands in a district; or the collector of the revenue of a district.", "gloss_language": "en"}]}], "visayaDikaraRa": [{"id": "vizayADikaraRa", "headword": "विषयाधिकरण", "headword_slp1": "vizayADikaraRa", "fold": "visayaDikaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣay-ādhikaraṇa (EI 23, 31), administrative officer of a district; the district administrator's office.", "gloss_language": "en"}]}], "visayaDipati": [{"id": "vizayADipati", "headword": "विषयाधिपति", "headword_slp1": "vizayADipati", "fold": "visayaDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣay-ādhipati, same as Viṣayapati (Ep. Ind., Vol. XXXIV, p. 219).", "gloss_language": "en"}], "synonyms": ["विषयाधिपतिः"], "synonyms_slp1": ["vizayADipatiH"]}], "visayakaraRa": [{"id": "vizayakaraRa", "headword": "विषयकरण", "headword_slp1": "vizayakaraRa", "fold": "visayakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣaya-karaṇa (EI 32), probably, the chief scribe at the office of the administrators of a district.", "gloss_language": "en"}]}], "visayali": [{"id": "vizayAlI", "headword": "विषयाली", "headword_slp1": "vizayAlI", "fold": "visayali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣayālī (EI 33), name of a tax; probably the same as viṣaya-dāna.", "gloss_language": "en"}]}], "visayamatya": [{"id": "vizayAmAtya", "headword": "विषयामात्य", "headword_slp1": "vizayAmAtya", "fold": "visayamatya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣay-āmātya (EI 27, 30), governor of a district; an Amātya in charge of a viṣaya or an Amātya under the Viṣayapati. See Ep. Ind., Vol. XXX, p. 64.", "gloss_language": "en"}]}], "visayaRa": [{"id": "vizayaRa", "headword": "विषयण", "headword_slp1": "vizayaRa", "fold": "visayaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣayaṇa (EI 1), meaning doubtful.", "gloss_language": "en"}]}], "visayapala": [{"id": "vizayapAla", "headword": "विषयपाल", "headword_slp1": "vizayapAla", "fold": "visayapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayapāla (EI 28), same as Viṣayapati.", "gloss_language": "en"}]}], "visayapati": [{"id": "vizayapati", "headword": "विषयपति", "headword_slp1": "vizayapati", "fold": "visayapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayapati (IE 8-3; CII 3, 4; BL; HD), governor of a district called viṣaya; distinguished from Viṣaya-vyāpṛtaka; same as Viṣay-ādhipati. Cf. Ind. Ant., Vol. V, p. 114. See Viṣa-yeśa, Viṣayeśvara, etc.", "gloss_language": "en"}], "synonyms": ["विषयपतिः"], "synonyms_slp1": ["vizayapatiH"]}], "visayavyapftaka": [{"id": "vizayavyApftaka", "headword": "विषयव्यापृतक", "headword_slp1": "vizayavyApftaka", "fold": "visayavyapftaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣaya-vyāpṛtaka (IE 8-3), sometimes distinguished from the Viṣayapati; an officer associated with the administration of a district (cf. Viṣaya-vyavahārin).", "gloss_language": "en"}]}], "visayavyavaharin": [{"id": "vizayavyavahArin", "headword": "विषयव्यवहारिन्", "headword_slp1": "vizayavyavahArin", "fold": "visayavyavaharin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣaya-vyavahārin (IE 8-3), an administrative officer in a district or a member of the district council. Cf. Viṣaya-vya-vahārin, Viṣayika, Viṣayin.", "gloss_language": "en"}]}], "visayesa": [{"id": "vizayeSa", "headword": "विषयेश", "headword_slp1": "vizayeSa", "fold": "visayesa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayeśa (HD), same as Viṣayapati, etc.", "gloss_language": "en"}]}], "visayesvara": [{"id": "vizayeSvara", "headword": "विषयेश्वर", "headword_slp1": "vizayeSvara", "fold": "visayesvara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayeśvara (EI 26), same as Viṣayapati, etc.", "gloss_language": "en"}]}], "visayika": [{"id": "vizayika", "headword": "विषयिक", "headword_slp1": "vizayika", "fold": "visayika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayika (EI 24), same as Viṣaya-vyavahārin; cf. Viṣayin.", "gloss_language": "en"}]}], "visayikaDikarika": [{"id": "vizayikADikArika", "headword": "विषयिकाधिकारिक", "headword_slp1": "vizayikADikArika", "fold": "visayikaDikarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayik-ādhikārika (EI 32), taken to be a single official designation; probably Viṣayika and Ādhikārika.", "gloss_language": "en"}]}], "visayin": [{"id": "vizayin", "headword": "विषयिन्", "headword_slp1": "vizayin", "fold": "visayin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viṣayin (EI 24, 32), possibly, the same as Viṣaya-vyava-hārin; cf. Viṣayika.", "gloss_language": "en"}]}], "viseRima": [{"id": "viseRima", "headword": "विसेणिम", "headword_slp1": "viseRima", "fold": "viseRima", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viseṇima, viseṇimā (CII 4), a tax, also called viseṇim-ādāya (EI 21).", "gloss_language": "en"}]}], "visesadaya": [{"id": "viSezAdAya", "headword": "विशेषादाय", "headword_slp1": "viSezAdAya", "fold": "visesadaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśeṣ-ādāya (SITI), also called viśeṣ-āya; a special group of taxes.", "gloss_language": "en"}]}], "visesaya": [{"id": "viSezAya", "headword": "विशेषाय", "headword_slp1": "viSezAya", "fold": "visesaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśeṣ-āya (SITI), same as viśeṣ-ādāya (q. v.).", "gloss_language": "en"}]}], "visiKa": [{"id": "viSiKa", "headword": "विशिख", "headword_slp1": "viSiKa", "fold": "visiKa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśikha (BL), name of a kind of building.", "gloss_language": "en"}], "synonyms": ["विशिखः"], "synonyms_slp1": ["viSiKaH"]}], "visirRa": [{"id": "viSIrRa", "headword": "विशीर्ण", "headword_slp1": "viSIrRa", "fold": "visirRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśīrṇa, wearing out, worn out part of a building; cf. bhagna-viśīrṇa-samāracana (Ep. Ind., Vol. XXXIV, p. 144).", "gloss_language": "en"}], "synonyms": ["विशीर्णः"], "synonyms_slp1": ["viSIrRaH"]}], "visisa": [{"id": "viSiza", "headword": "विशिष", "headword_slp1": "viSiza", "fold": "visisa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viśiṣa (IE 8-3; EI 1, 30), probably, the governor or commander of a fort; a word of uncertain derivation.", "gloss_language": "en"}]}], "visRubahu": [{"id": "vizRubAhu", "headword": "विष्णुबाहु", "headword_slp1": "vizRubAhu", "fold": "visRubahu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṇu-bāhu, see hari-bāhu (IE 7-1-2), ‘four’.", "gloss_language": "en"}]}], "visRugfha": [{"id": "vizRugfha", "headword": "विष्णुगृह", "headword_slp1": "vizRugfha", "fold": "visRugfha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṇu-gṛha (SITI), a Viṣṇu temple.", "gloss_language": "en"}], "synonyms": ["विष्णुगृहं"], "synonyms_slp1": ["vizRugfhaM"]}], "visRupada": [{"id": "vizRupada", "headword": "विष्णुपद", "headword_slp1": "vizRupada", "fold": "visRupada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṇu-pada (IE 7-1-2), ‘cypher’.", "gloss_language": "en"}], "synonyms": ["विष्णुपदं"], "synonyms_slp1": ["vizRupadaM"]}], "visRutiTi": [{"id": "vizRutiTi", "headword": "विष्णुतिथि", "headword_slp1": "vizRutiTi", "fold": "visRutiTi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṇu-tithi (IA 19), same as Jyaiṣṭha-sudi 11.", "gloss_language": "en"}], "synonyms": ["विष्णुतिथिः"], "synonyms_slp1": ["vizRutiTiH"]}], "visRusraDa": [{"id": "vizRuSrADa", "headword": "विष्णुश्राध", "headword_slp1": "vizRuSrADa", "fold": "visRusraDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṇu-śrādha (Ep. Ind., Vol. XXXIV, p. 37), an expression of doubtful meaning.", "gloss_language": "en"}]}], "visova": [{"id": "vIsovA", "headword": "वीसोवा", "headword_slp1": "vIsovA", "fold": "visova", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vīsovā (CII 4), name of a coin; a land measure; same as viṃśopaka.", "gloss_language": "en"}, {"gloss": "vīsovā , corruption of viṃśopaka.", "gloss_language": "en"}]}], "visovaka": [{"id": "visovaka", "headword": "विसोवक", "headword_slp1": "visovaka", "fold": "visovaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visovaka (EI 1), corrupt form of viṃśopaka (q. v.).", "gloss_language": "en"}]}], "viswapa": [{"id": "vizwapa", "headword": "विष्टप", "headword_slp1": "vizwapa", "fold": "viswapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṭapa (IE 7-1-2), ‘three’.", "gloss_language": "en"}], "synonyms": ["विष्टपं", "विष्टपः"], "synonyms_slp1": ["vizwapaM", "vizwapaH"]}], "vistaraRa": [{"id": "vistaraRa", "headword": "विस्तरण", "headword_slp1": "vistaraRa", "fold": "vistaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vistaraṇa (EI 1), meaning doubtful.", "gloss_language": "en"}]}], "viswi": [{"id": "vizwi", "headword": "विष्टि", "headword_slp1": "vizwi", "fold": "viswi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣṭi (IE 8-5; CII 4; HRS), labour which the villagers were obliged to provide to the king or landlord on occasions; unpaid labour; forced labour.\n Cf. veṭṭi (SITI), unpaid labour for public works in the village without time or other limits; usually mentioned along with vetana as veṭṭi-vetanai. Cf. veṭṭi-ccor̤u, the obligation of feeding veṭṭi labourers free of cost; also cf. Tamil veṭṭi-pāṭṭam (EI 24), explained as ‘a kind of tax’; tax in lieu of viṣṭi.", "gloss_language": "en"}], "synonyms": ["विष्टिः"], "synonyms_slp1": ["vizwiH"]}], "visudDi": [{"id": "viSudDi", "headword": "विशुद्धि", "headword_slp1": "viSudDi", "fold": "visudDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśuddhi, cf. viśuddhiṃ yāvat (LP), ‘till the account is clear’.", "gloss_language": "en"}], "synonyms": ["विशुद्धिः"], "synonyms_slp1": ["viSudDiH"]}], "visuva": [{"id": "vizuva", "headword": "विषुव", "headword_slp1": "vizuva", "fold": "visuva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣuva (CII 4; SII 1), the autumnal or vernal equinox; also called viṣuvat (q. v.).", "gloss_language": "en"}], "synonyms": ["विषुवं"], "synonyms_slp1": ["vizuvaM"]}], "visuvat": [{"id": "vizuvat", "headword": "विषुवत्", "headword_slp1": "vizuvat", "fold": "visuvat", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣuvat (IE 7-1-2), ‘two’.\n Cf. viṣuva.", "gloss_language": "en"}], "synonyms": ["विषुवन्त्"], "synonyms_slp1": ["vizuvant"]}], "visva": [{"id": "viSva", "headword": "विश्व", "headword_slp1": "viSva", "fold": "visva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśva (IE 7-1-2), same as viśvedevāḥ, ‘thirteen.’", "gloss_language": "en"}], "synonyms": ["विश्वं", "विश्वः"], "synonyms_slp1": ["viSvaM", "viSvaH"]}], "visvacakra": [{"id": "viSvacakra", "headword": "विश्वचक्र", "headword_slp1": "viSvacakra", "fold": "visvacakra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśvacakra (EI 24), name of a mahādāna.", "gloss_language": "en"}], "synonyms": ["विश्वचक्रं"], "synonyms_slp1": ["viSvacakraM"]}], "visvedevaH": [{"id": "viSvedevAH", "headword": "विश्वेदेवाः", "headword_slp1": "viSvedevAH", "fold": "visvedevaH", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśvedevāḥ (IE 7-1-2), ‘thirteen’; same as viśva.", "gloss_language": "en"}]}], "visvagdeva": [{"id": "vizvagdevA", "headword": "विष्वग्देवा", "headword_slp1": "vizvagdevA", "fold": "visvagdeva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viṣvag-devā (LL), Jain; a quadruple^1 image.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "visvakarman": [{"id": "viSvakarman", "headword": "विश्वकर्मन्", "headword_slp1": "viSvakarman", "fold": "visvakarman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viśvakarman (LL), an architect.", "gloss_language": "en"}], "synonyms": ["विश्वकर्म्मन्"], "synonyms_slp1": ["viSvakarmman"]}], "visvala": [{"id": "viSvAla", "headword": "विश्वाल", "headword_slp1": "viSvAla", "fold": "visvala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viśvāla (EI 31), Od̤iyā; a village watchman.", "gloss_language": "en"}]}], "visvasa": [{"id": "viSvAsa", "headword": "विश्वास", "headword_slp1": "viSvAsa", "fold": "visvasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viśvāsa (EI 24), official designation; same as Vaiśvāsika; cf. the titles Viśvāsa-Khāna, Viśvāsa-rāya, etc., conferred by the Muslim rulers especially in the Bengal region.", "gloss_language": "en"}], "synonyms": ["विश्वासः"], "synonyms_slp1": ["viSvAsaH"]}], "visvasana": [{"id": "viSvAsana", "headword": "विश्वासन", "headword_slp1": "viSvAsana", "fold": "visvasana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśvāsana (CII 1), ‘being inspired with faith’.", "gloss_language": "en"}], "synonyms": ["विश्वासनं"], "synonyms_slp1": ["viSvAsanaM"]}], "visvasata": [{"id": "viSvasattA", "headword": "विश्वसत्ता", "headword_slp1": "viSvasattA", "fold": "visvasata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśva-sattā (IA 14), wrong Sanskritisation of Prakrit vasa-sata (Sanskrit varṣa-śata); translated as ‘universal rule’. See Ep. Ind., Vol. XXXIV, p. 241, note 1.", "gloss_language": "en"}]}], "visvasika": [{"id": "viSvAsika", "headword": "विश्वासिक", "headword_slp1": "viSvAsika", "fold": "visvasika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viśvāsika (EI 24), same as Vaiśvāsika (q. v.), etc.", "gloss_language": "en"}]}], "visvavisvopaka": [{"id": "viSvaviSvopaka", "headword": "विश्वविश्वोपक", "headword_slp1": "viSvaviSvopaka", "fold": "visvavisvopaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Viśvaviśvopaka (IA 19), Jain; explained as ‘one whose body and soul exhibit marks of an ācārya’.", "gloss_language": "en"}]}], "visakaRam": [{"id": "viSakkARam", "headword": "विशक्काणम्", "headword_slp1": "viSakkARam", "fold": "visakaRam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśa-kkāṇam (SITI), Tamil; tax or share in the produce as remuneration due to a Viyavan̤ or village headman.", "gloss_language": "en"}]}], "visesayam": [{"id": "viSezAyam", "headword": "विशेषायम्", "headword_slp1": "viSezAyam", "fold": "visesayam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "viśeṣ-āyam, viśeṣ-ādāyam (SITI), Sanskrit; a special group of taxes.", "gloss_language": "en"}]}], "visopaka": [{"id": "visopaka", "headword": "विसोपक", "headword_slp1": "visopaka", "fold": "visopaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visopaka , corruption of viṃśopaka.", "gloss_language": "en"}]}], "visvovaka": [{"id": "visvovaka", "headword": "विस्वोवक", "headword_slp1": "visvovaka", "fold": "visvovaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "visvovaka , corruption of viṃśopaka.", "gloss_language": "en"}]}]}