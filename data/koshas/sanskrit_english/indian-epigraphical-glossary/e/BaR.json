{"BaRaka": [{"id": "BARaka", "headword": "भाणक", "headword_slp1": "BARaka", "fold": "BaRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhāṇaka (LL), Buddhist; a preacher.", "gloss_language": "en"}], "synonyms": ["भाणकः"], "synonyms_slp1": ["BARakaH"]}], "BaRqa": [{"id": "BARqa", "headword": "भाण्ड", "headword_slp1": "BARqa", "fold": "BaRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhāṇḍa, cf. bhaṇḍa (EI 5), a bale of goods.", "gloss_language": "en"}], "synonyms": ["भांड", "भांडं", "भाण्डं", "भाण्डः"], "synonyms_slp1": ["BAMqa", "BAMqaM", "BARqaM", "BARqaH"]}], "BaRqaBftavahitra": [{"id": "BARqaBftavahitra", "headword": "भाण्डभृतवहित्र", "headword_slp1": "BARqaBftavahitra", "fold": "BaRqaBftavahitra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhāṇḍa-bhṛta-vahitra (IE 8-8), ‘a wagon full of pots or jars’.", "gloss_language": "en"}]}], "BaRqaDyaksa": [{"id": "BARqADyakza", "headword": "भाण्डाध्यक्ष", "headword_slp1": "BARqADyakza", "fold": "BaRqaDyaksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhāṇḍ-ādhyakṣa (EI 28), officer in charge of the store-house. Cf. Bhāṇḍāgār-ādhikṛta, etc.", "gloss_language": "en"}]}], "BaRqagara": [{"id": "BARqAgAra", "headword": "भाण्डागार", "headword_slp1": "BARqAgAra", "fold": "BaRqagara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhāṇḍ-āgāra (EI 23, 30), a treasury or store-house.", "gloss_language": "en"}], "synonyms": ["भांडागार", "भाण्डागारः"], "synonyms_slp1": ["BAMqAgAra", "BARqAgAraH"]}], "BaRqagaraDikfta": [{"id": "BARqAgArADikfta", "headword": "भाण्डागाराधिकृत", "headword_slp1": "BARqAgArADikfta", "fold": "BaRqagaraDikfta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhāṇḍāgār-ādhikṛta (EI 12; BL; HRS), an officer employed in the treasury