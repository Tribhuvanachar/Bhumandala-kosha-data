{"maNgala": [{"id": "maNgala", "headword": "मङ्गल", "headword_slp1": "maNgala", "fold": "maNgala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maṅgala (CII 1), a ceremony for one's good or for averting evil; cf. kalyāṇa. []\n (SITI), a Brāhmaṇa village; shortened form of caturvedi-maṅgala.\n (ASLV), a small administrative unit.\n (IE 7-1-2), ‘eight’.", "gloss_language": "en"}], "synonyms": ["मंगल", "मङ्गलं", "मङ्गलः"], "synonyms_slp1": ["maMgala", "maNgalaM", "maNgalaH"]}], "maNgalakalasa": [{"id": "maNgalakalasa", "headword": "मङ्गलकलस", "headword_slp1": "maNgalakalasa", "fold": "maNgalakalasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maṅgala-kalaśa (CII 4), an auspicious vase. Cf. nidrā-kalasa.", "gloss_language": "en"}]}], "maNgaliha": [{"id": "maNgAlihA", "headword": "मङ्गालिहा", "headword_slp1": "maNgAlihA", "fold": "maNgaliha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maṅgālikā (IA 15), probably, an upper garment.", "gloss_language": "en"}]}], "maNgalikya": [{"id": "mANgalikya", "headword": "माङ्गलिक्य", "headword_slp1": "mANgalikya", "fold": "maNgalikya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "māṅgalikya (LP), some present (made in lieu of the benefit one is going to get).", "gloss_language": "en"}]}], "maNgaliyaka": [{"id": "mANgalIyaka", "headword": "माङ्गलीयक", "headword_slp1": "mANgalIyaka", "fold": "maNgaliyaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "māṅgalīyaka (LP), probably, a tax collected on the occasion of auspicious events in the royal family, such as the birth of a son to the king.", "gloss_language": "en"}]}], "maNgalya": [{"id": "mANgalya", "headword": "माङ्गल्य", "headword_slp1": "mANgalya", "fold": "maNgalya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"glo