{"akalika": [{"id": "akAlika", "headword": "अकालिक", "headword_slp1": "akAlika", "fold": "akalika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-kālika (CII 1), ‘not restricted to time’.", "gloss_language": "en"}]}], "akara": [{"id": "AkAra", "headword": "आकार", "headword_slp1": "AkAra", "fold": "akara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ākāra (CII 1), same as prakāra, a way or kind.", "gloss_language": "en"}], "synonyms": ["आकारः"], "synonyms_slp1": ["AkAraH"]}], "akarsaka": [{"id": "Akarzaka", "headword": "आकर्षक", "headword_slp1": "Akarzaka", "fold": "akarsaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ākarṣaka (EI 5), probably, the extent [of a piece of land].", "gloss_language": "en"}], "synonyms": ["आकर्षकः"], "synonyms_slp1": ["AkarzakaH"]}], "akasa": [{"id": "AkASa", "headword": "आकाश", "headword_slp1": "AkASa", "fold": "akasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ākāśa (IE 7-1-2), ‘cypher’.", "gloss_language": "en"}], "synonyms": ["आकाशं", "आकाशः"], "synonyms_slp1": ["AkASaM", "AkASaH"]}], "akasamuKin": [{"id": "AkASamuKin", "headword": "आकाशमुखिन्", "headword_slp1": "AkASamuKin", "fold": "akasamuKin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ākāśamukhin (ASLV), epithet of certain Śaiva ascetics, also called Ākāśavāsin.", "gloss_language": "en"}]}], "akasapatalotpati": [{"id": "AkASapAtAlotpatti", "headword": "आकाशपातालोत्पत्ति", "headword_slp1": "AkASapAtAlotpatti", "fold": "akasapatalotpati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ākāśa-pātāl-otpatti (EI 30), fruits and roots produced in a piece of land. Cf. ākāś-otpatti.", "gloss_language": "en"}]}], "akasavaRi": [{"id": "AkASavARI", "headword": "आकाशवाणी", "headword_slp1": "AkASavARI", "fold": "akasavaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ākāśa-vāṇī (IA 11), an unearthly voice.", "gloss_language": "en"}]}], "akasavasin": [{"id": "AkASavAsin", "headword": "आकाशवासिन्", "headword_slp1": "AkASavAsin", "fold": "akasavasin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ākāśa-vāsin (ASLV), same as Ākāśamukhin (q. v.).", "gloss_language": "en"}]}], "akasotpati": [{"id": "AkASotpatti", "headword": "आकाशोत्पत्ति", "headword_slp1": "AkASotpatti", "fold": "akasotpati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ākāś-otpatti (HRS), ‘produce of the sky’; fruits; wrongly regarded by some as the same as bhūta-vāta-pratyāya (q. v.). See ākāśa-pātāl-otpalli.", "gloss_language": "en"}]}], "akam": [{"id": "akkam", "headword": "अक्कम्", "headword_slp1": "akkam", "fold": "akam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "akkam (SII 3; SITI), Tamil; name of a coin; one-twelfth of a kāśu; a mint (cf. akka-śālā).", "gloss_language": "en"}, {"gloss": "akkam , one-twelfth of a kāśu (q. v.).", "gloss_language": "en"}]}], "akasala": [{"id": "akkaSAlA", "headword": "अक्कशाला", "headword_slp1": "akkaSAlA", "fold": "akasala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "akka-śālā (SITI), Tamil-Sanskrit; a mint; cf. akkaśālai-vari (SITI), charges payable to the mint for minting coins.", "gloss_language": "en"}]}], "akasalavaru": [{"id": "akkasAlavaru", "headword": "अक्कसालवरु", "headword_slp1": "akkasAlavaru", "fold": "akasalavaru", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "akkasālavaru (CITD), cf. Telugu agasāli, akkasāla, akasālě; also Kannaḍa agasālavāḍu; a goldsmith or his workshop.", "gloss_language": "en"}]}], "akasaliga": [{"id": "akkasAliga", "headword": "अक्कसालिग", "headword_slp1": "akkasAliga", "fold": "akasaliga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Akkasāliga (EI 7), a goldsmith; same as Akṣaśālika.", "gloss_language": "en"}]}], "akarada": [{"id": "akarada", "headword": "अकरद", "headword_slp1": "akarada", "fold": "akarada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-karada (EI 26), refers to the freedom of the donee of the gift land from paying taxes in general.", "gloss_language": "en"}]}], "akaradayin": [{"id": "akaradAyin", "headword": "अकरदायिन्", "headword_slp1": "akaradAyin", "fold": "akaradayin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-karadāyin (EI 26, 27), same as a-karada.", "gloss_language": "en"}]}], "akaravatotara": [{"id": "akaravAtottara", "headword": "अकरवातोत्तर", "headword_slp1": "akaravAtottara", "fold": "akaravatotara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-kara-vāt-ottara (IE; EI 32), sometimes with āvāta, vāt-ādeya, bhūt-opātta-pratyāya, etc., in place of vāt-ottara; cf. sa-bhūta-vāta- (or pāta)-pratyāya, etc; ‘free from the collections resulting from storms (e. g. uprooted trees, fruits, etc.).’", "gloss_language": "en"}]}], "akaraviswikoYjala": [{"id": "akaravizwikoYjalla", "headword": "अकरविष्टिकोञ्जल्ल", "headword_slp1": "akaravizwikoYjalla", "fold": "akaraviswikoYjala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-kara-viṣṭi-koñjalla (IE), refers to the freedom of the donee of the gift land from the payment of taxes and the obligation to supply free labour and koñjalla (kāñji) to the king's labourers. Cf. Select Inscriptions, p. 439.", "gloss_language": "en"}]}], "akasalEvari": [{"id": "akkaSAlEvari", "headword": "अक्कशालैवरि", "headword_slp1": "akkaSAlEvari", "fold": "akasalEvari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "akkaśālai-vari (SITI), Tamil; tax payable to the mint for minting coins; cf. accu-vari.", "gloss_language": "en"}]}]}