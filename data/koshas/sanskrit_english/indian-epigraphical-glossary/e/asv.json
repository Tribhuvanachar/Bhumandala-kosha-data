{"asva": [{"id": "aSva", "headword": "अश्व", "headword_slp1": "aSva", "fold": "asva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aśva (IE 7-1-2), ‘seven’.", "gloss_language": "en"}], "synonyms": ["अश्वः"], "synonyms_slp1": ["aSvaH"]}], "asvaqaRakapatra": [{"id": "aSvAqqARakapatra", "headword": "अश्वाड्डाणकपत्र", "headword_slp1": "aSvAqqARakapatra", "fold": "asvaqaRakapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aśv-āḍḍāṇaka-patra (LP), deed for mortgaging a horse.", "gloss_language": "en"}]}], "asvaDyaksa": [{"id": "aSvADyakza", "headword": "अश्वाध्यक्ष", "headword_slp1": "aSvADyakza", "fold": "asvaDyaksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśv-ādhyakṣa (EI 18), superintendent of stables or cavalry officer; cf. Aśva-sādhanika, Aśvapati.", "gloss_language": "en"}], "synonyms": ["अश्वाध्यक्षः"], "synonyms_slp1": ["aSvADyakzaH"]}], "asvaGasakayasTa": [{"id": "aSvaGAsakAyasTa", "headword": "अश्वघासकायस्थ", "headword_slp1": "aSvaGAsakAyasTa", "fold": "asvaGasakayasTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśva-ghāsa-kāyastha (HD), a petty officer in charge of the fodder for horses. Cf. Rājataraṅgiṇī, III. 489.", "gloss_language": "en"}], "synonyms": ["अश्वघासकायस्थः"], "synonyms_slp1": ["aSvaGAsakAyasTaH"]}], "asvameDa": [{"id": "aSvameDa", "headword": "अश्वमेध", "headword_slp1": "aSvameDa", "fold": "asvameDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aśvamedha (CII 3, 4), a sacrificial ceremony centering in a horse, generally performed by independent monarchs. Kings celebrating the sacrifice sometimes assumed suitable titles (cf. Aśvamedha-parākrama and Aśvamedha-Mahendra claimed respectively by Samudragupta and Kumāragupta I on their coins). Some kings performed two, four or more horse-sacrifices. For a list of the performers of aśvamedha known form epigraphic and numismatic records, see Sundaram Pillai Com. Vol., pp. 93 ff.", "gloss_language": "en"}], "synonyms": ["अश्वमेधः"], "synonyms_slp1": ["aSvameDaH"]}, {"id": "ASvameDa", "headword": "आश्वमेध", "headword_slp1": "ASvameDa", "fold": "asvameDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āśvamedha (EI 12), same as āśvamedhika.", "gloss_language": "en"}]}], "asvamika": [{"id": "asvAmika", "headword": "अस्वामिक", "headword_slp1": "asvAmika", "fold": "asvamika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "asvāmika (EI 19), anarchy.", "gloss_language": "en"}], "synonyms": ["अस्वामिकं"], "synonyms_slp1": ["asvAmikaM"]}], "asvapati": [{"id": "aSvapati", "headword": "अश्वपति", "headword_slp1": "aSvapati", "fold": "asvapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvapati (IE 8-2; CII 4)), cf. Aśvapati-Gajapati-Narapati-rāja-tray-ādhipati; royal title; the king as ‘the leader of the cavalry’; title of the Vijayanagara kings on account of their strength in horses (ASLV); title assumed by the rulers of some royal families.\n (EI 9, 21; CII 3; HD), an official title meaning either the master of the stables or the commander of the cavalry; cavalry officer; cf. Aśv-ādhyakṣa (EI 18). See CII, Vol. III, p. 259.", "gloss_language": "en"}], "synonyms": ["अश्वपतिः"], "synonyms_slp1": ["aSvapatiH"]}], "asvapatigajapatinarapatimuvarurayaragaRqa": [{"id": "aSvapatigajapatinarapatimUvarurAyaragaRqa", "headword": "अश्वपतिगजपतिनरपतिमूवरुरायरगण्ड", "headword_slp1": "aSvapatigajapatinarapatimUvarurAyaragaRqa", "fold": "asvapatigajapatinarapatimuvarurayaragaRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvapati-Gajapati-Narapati-mūvaru-rāyara-gaṇḍa (IE 8-2), [] title of the Vijayanagara kings; Kannaḍa translation of the title Aśvapati-Gajapati-Narapati-rāja-tray-ādhipati.", "gloss_language": "en"}]}], "asvapatigajapatinarapatirajatrayaDipati": [{"id": "aSvapatigajapatinarapatirAjatrayADipati", "headword": "अश्वपतिगजपतिनरपतिराजत्रयाधिपति", "headword_slp1": "aSvapatigajapatinarapatirAjatrayADipati", "fold": "asvapatigajapatinarapatirajatrayaDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvapati-Gajapati-Narapati-rāja-tray-ādhipati (IE 8-2; CII 4), holder (or, lord of the holders) of the three royal titles, viz., leader of the cavalry, leader of the elephant corps and leader of infantry; title assumed by the rulers of certain dynasties. Cf. Aśvapati-Gajapati-Narapati-muvaru-rāyara-gaṇḍa.", "gloss_language": "en"}]}], "asvaroha": [{"id": "aSvAroha", "headword": "अश्वारोह", "headword_slp1": "aSvAroha", "fold": "asvaroha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvāroha (EI 18), a trooper.", "gloss_language": "en"}], "synonyms": ["अश्वारोहः"], "synonyms_slp1": ["aSvArohaH"]}], "asvasaDanika": [{"id": "aSvasADanika", "headword": "अश्वसाधनिक", "headword_slp1": "aSvasADanika", "fold": "asvasaDanika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśva-sādhanika (EI 21; CII 4), a cavalry officer.", "gloss_language": "en"}]}], "asvasansTa": [{"id": "aSvasaMsTa", "headword": "अश्वसंस्थ", "headword_slp1": "aSvasaMsTa", "fold": "asvasansTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśva-saṃstha (EI 8), a horseman.", "gloss_language": "en"}]}], "asvasalakaraRa": [{"id": "aSvaSAlAkaraRa", "headword": "अश्वशालाकरण", "headword_slp1": "aSvaSAlAkaraRa", "fold": "asvasalakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aśvaśālā-karaṇa, cf. karaṇa (LP); the department of horses.", "gloss_language": "en"}]}], "asvati": [{"id": "aSvati", "headword": "अश्वति", "headword_slp1": "aSvati", "fold": "asvati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvati (EI 9), Tamil; same as Aśvinī.", "gloss_language": "en"}]}], "asvavara": [{"id": "aSvavAra", "headword": "अश्ववार", "headword_slp1": "aSvavAra", "fold": "asvavara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvavāra, cf. Asavāra (EI 2), a horseman. Cf.Bṛhad-aśvavāra.", "gloss_language": "en"}], "synonyms": ["अश्ववारः"], "synonyms_slp1": ["aSvavAraH"]}], "asvavaraka": [{"id": "aSvavAraka", "headword": "अश्ववारक", "headword_slp1": "aSvavAraka", "fold": "asvavaraka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvavāraka, Aśvavārika (LL), a trooper; same as Aśvavāra.", "gloss_language": "en"}], "synonyms": ["अश्ववारकः"], "synonyms_slp1": ["aSvavArakaH"]}], "asvin": [{"id": "aSvin", "headword": "अश्विन्", "headword_slp1": "aSvin", "fold": "asvin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Aśvin (IE 7-1-2), ‘two’; sometimes Āśvina is also used in this sense.", "gloss_language": "en"}]}], "asvina": [{"id": "ASvina", "headword": "आश्विन", "headword_slp1": "ASvina", "fold": "asvina", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Āśvina (IE 7-1-2), ‘two’; cf. Aśvin. See IHQ, Vol. XXXIII, p. 101.", "gloss_language": "en"}], "synonyms": ["आश्विनः"], "synonyms_slp1": ["ASvinaH"]}], "asviya": [{"id": "aSvIya", "headword": "अश्वीय", "headword_slp1": "aSvIya", "fold": "asviya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aśvīya (EI 12), a number of horses.", "gloss_language": "en"}], "synonyms": ["अश्वीयं", "अश्वीयः"], "synonyms_slp1": ["aSvIyaM", "aSvIyaH"]}]}