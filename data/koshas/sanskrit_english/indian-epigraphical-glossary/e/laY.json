{"laYCana": [{"id": "lAYCana", "headword": "लाञ्छन", "headword_slp1": "lAYCana", "fold": "laYCana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "lāñchana (EI 28), an emblem. Cf. cihna.\n (EI 9), the [royal] emblem; cf. Tamil lāñjanai-pper̤u, lāñjinai-pper̤u, ilāñjai-pper̤u (SITI), the royal seal.\n (CII 3, etc.), a crest as distinguished from dhvaja or a banner. Cf. cihna.\n (HA), the distinguishing mark or symbol of a Jina image, which helps one to identify the different Jinas.", "gloss_language": "en"}], "synonyms": ["लांछन", "लांछनं", "लाञ्छनं", "लाञ्छनः"], "synonyms_slp1": ["lAMCana", "lAMCanaM", "lAYCanaM", "lAYCanaH"]}], "laYCita": [{"id": "lAYCita", "headword": "लाञ्छित", "headword_slp1": "lAYCita", "fold": "laYCita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "lāñchita (EI 29), ‘registered with a seal (lāñchana)’.", "gloss_language": "en"}], "synonyms": ["लांछित"], "synonyms_slp1": ["lAMCita"]}], "laYjanEperu": [{"id": "laYjanEpperu", "headword": "लञ्जनैप्पेरु", "headword_slp1": "laYjanEpperu", "fold": "laYjanEperu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "lañjanai-pper̤u, lañjinai-pper̤u , see ilañjanai-pper̤u.", "gloss_language": "en"}]}]}