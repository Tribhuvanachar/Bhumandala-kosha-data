{"sura": [{"id": "sura", "headword": "सुर", "headword_slp1": "sura", "fold": "sura", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sura (IE 7-1-2), ‘thirtythree’.", "gloss_language": "en"}], "synonyms": ["सुरः"], "synonyms_slp1": ["suraH"]}], "suraBi": [{"id": "suraBi", "headword": "सुरभि", "headword_slp1": "suraBi", "fold": "suraBi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "surabhi, see surahī.", "gloss_language": "en"}], "synonyms": ["सुरभिः"], "synonyms_slp1": ["suraBiH"]}], "surahi": [{"id": "surahI", "headword": "सुरही", "headword_slp1": "surahI", "fold": "surahi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "surahī (HA), Sanskrit surabhi; inscribed stone with the representation of a cow with her calf and the sun and the moon in the upper part, the inscriptions usually recording gifts or donations or exemptions from obligations or taxes declared by kings. This indicated permanence and inviolability^1.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "surakaraRa": [{"id": "surAkaraRa", "headword": "सुराकरण", "headword_slp1": "surAkaraRa", "fold": "surakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "surā-karaṇa (EI 30), distillation of liquor.", "gloss_language": "en"}]}], "surataRa": [{"id": "suratARa", "headword": "सुरताण", "headword_slp1": "suratARa", "fold": "surataRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Suratāṇa (IE 8-2; EI 12), same as Arabic Sult̤ān; see Suratrāṇa, Sulatāna, etc.", "gloss_language": "en"}]}], "suratraRa": [{"id": "suratrARa", "headword": "सुरत्राण", "headword_slp1": "suratrARa", "fold": "suratraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Suratrāṇa (IE 8-2; EI 4, 1, 13, 32; BL), variously spelt as Suritrāṇa, Suratāṇa, etc.; Hindu adaptation of the Muslim royal title Sult̤ān; often adopted as a personal name. Cf. Hammīra. See Sulatāna, etc.", "gloss_language": "en"}]}], "suravala": [{"id": "suravAla", "headword": "सुरवाल", "headword_slp1": "suravAla", "fold": "suravala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Suravāla (EI 33), one who sets songs or musical instruments to tune.", "gloss_language": "en"}]}], "suri": [{"id": "sUri", "headword": "सूरि", "headword_slp1": "sUri", "fold": "suri", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sūri (EI 9), title of Jain religious teachers; often used as their name-ending.", "gloss_language": "en"}], "synonyms": ["सूरिः"], "synonyms_slp1": ["sUriH"]}], "suritraRa": [{"id": "suritrARa", "headword": "सुरित्राण", "headword_slp1": "suritrARa", "fold": "suritraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Suritrāṇa (BL), same as Suratrāṇa, etc.", "gloss_language": "en"}]}], "surya": [{"id": "sUrya", "headword": "सूर्य", "headword_slp1": "sUrya", "fold": "surya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sūrya (IE 7-1-2; EI 25), ‘twelve’.", "gloss_language": "en"}], "synonyms": ["सूर्यः", "सूर्य्य", "सूर्य्यः"], "synonyms_slp1": ["sUryaH", "sUryya", "sUryyaH"]}], "suryaBa": [{"id": "sUryaBa", "headword": "सूर्यभ", "headword_slp1": "sUryaBa", "fold": "suryaBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sūrya-bha (JAHRS, Vol. II, p. 287, text line 64), literally, ‘the sun's asterism’, the Hastā-nakṣatra.", "gloss_language": "en"}]}], "suryagraha": [{"id": "sUryagraha", "headword": "सूर्यग्रह", "headword_slp1": "sUryagraha", "fold": "suryagraha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sūrya-graha (EI 24), solar eclipse.", "gloss_language": "en"}], "synonyms": ["सूर्यग्रहः", "सूर्य्यग्रह", "सूर्य्यग्रहः"], "synonyms_slp1": ["sUryagrahaH", "sUryyagraha", "sUryyagrahaH"]}], "suryaparvan": [{"id": "sUryaparvan", "headword": "सूर्यपर्वन्", "headword_slp1": "sUryaparvan", "fold": "suryaparvan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sūrya-parvan (IA 19; LP), solar eclipse.", "gloss_language": "en"}], "synonyms": ["सूर्य्यपर्वन्"], "synonyms_slp1": ["sUryyaparvan"]}], "surayakasu": [{"id": "SurrAyakkASu", "headword": "शुर्रायक्काशु", "headword_slp1": "SurrAyakkASu", "fold": "surayakasu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śur̤r̤-āya-kkāśu (SII 12), a tax.", "gloss_language": "en"}]}], "suraBimaqa": [{"id": "suraBimAqa", "headword": "सुरभिमाड", "headword_slp1": "suraBimAqa", "fold": "suraBimaqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "surabhi-māḍa , probably, ‘māḍa bearing the figure of a cow’; see māḍa.", "gloss_language": "en"}]}]}