{"nanadesi": [{"id": "nAnAdeSi", "headword": "नानादेशि", "headword_slp1": "nAnAdeSi", "fold": "nanadesi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nānādeśi (EI 31; SITI; ASLV), guild of merchants coming from outside.", "gloss_language": "en"}]}], "nanda": [{"id": "nanda", "headword": "नन्द", "headword_slp1": "nanda", "fold": "nanda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nanda (IE 7-1-2), ‘nine’.", "gloss_language": "en"}], "synonyms": ["नंद", "नंदः", "नन्दः"], "synonyms_slp1": ["naMda", "naMdaH", "nandaH"]}], "nandadipa": [{"id": "nandAdIpa", "headword": "नन्दादीप", "headword_slp1": "nandAdIpa", "fold": "nandadipa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nandā-dīpa, also called nandā-dīvigě (CITD); used in Telugu and Kannaḍa inscriptions in the sense of a lamp that is always kept burning before a deity in a temple; same as akhaṇḍa-dīpa.", "gloss_language": "en"}]}], "nandavana": [{"id": "nandavana", "headword": "नन्दवन", "headword_slp1": "nandavana", "fold": "nandavana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nandavana, nandāvana, cf. tiru-nandavanam, etc. (SII 1); a sacred flower-garden.", "gloss_language": "en"}]}], "nandavilaku": [{"id": "nandAvilakku", "headword": "नन्दाविलक्कु", "headword_slp1": "nandAvilakku", "fold": "nandavilaku", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nandā-vil̤akku (SII 1, 2), also spelt as nondā˚, nundā˚; a perpetual lamp; same as nandā-dīpa, akhaṇḍa-dīpa.", "gloss_language": "en"}]}], "nandimuKa": [{"id": "nandImuKa", "headword": "नन्दीमुख", "headword_slp1": "nandImuKa", "fold": "nandimuKa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nandīmukha (CII 1), a species of water-birds.", "gloss_language": "en"}]}], "nandisamarohaRa": [{"id": "nAndIsamArohaRa", "headword": "नान्दीसमारोहण", "headword_slp1": "nAndIsamArohaRa", "fold": "nandisamarohaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nāndī-samārohaṇa (EI 32), a ceremony.", "gloss_language": "en"}]}], "nandisvaraswami": [{"id": "nandISvarAzwamI", "headword": "नन्दीश्वराष्टमी", "headword_slp1": "nandISvarAzwamI", "fold": "nandisvaraswami", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nandīśvar-āṣṭamī (SII 11-1), same as Phālguna-sudi 8.", "gloss_language": "en"}]}], "nanavfksasameta": [{"id": "nAnAvfkzasameta", "headword": "नानावृक्षसमेत", "headword_slp1": "nAnAvfkzasameta", "fold": "nanavfksasameta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nānā-vṛkṣa-sameta , ‘together with the various trees’; epithet of gift village. Some of the trees not to be enjoyed by unprivileged tenants were mango, madhūka, jack, coconut, arecanut, palmyra palm, sīsu, tamarind tree, etc. But the group was different in different parts of the country. Cf. Ind. Ep., p. 402.", "gloss_language": "en"}]}], "nana": [{"id": "nAnA", "headword": "नाना", "headword_slp1": "nAnA", "fold": "nana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nānā , same as nāṇaka; cf. Kuṣāṇa coins bearing the representation of the West Asian mother-goddess Nana.", "gloss_language": "en"}]}]}