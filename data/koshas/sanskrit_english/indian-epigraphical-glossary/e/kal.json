{"kala": [{"id": "kalA", "headword": "कला", "headword_slp1": "kalA", "fold": "kala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalā (IE 7-1-2), ‘sixteen’.", "gloss_language": "en"}]}, {"id": "kAla", "headword": "काल", "headword_slp1": "kAla", "fold": "kala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāla (IE 7-1-2), ‘three’.\n (CII 3, etc.), time, a period of time; used in the sense of ‘an era’; cf. kāl-ānuvartamāna-saṃvatsara (Select Inscriptions, p. 270, text lines 3-4), etc. See prakāla.", "gloss_language": "en"}], "synonyms": ["कालं", "कालः"], "synonyms_slp1": ["kAlaM", "kAlaH"]}], "kalaBasalakaraRa": [{"id": "kalaBaSAlAkaraRa", "headword": "कलभशालाकरण", "headword_slp1": "kalaBaSAlAkaraRa", "fold": "kalaBasalakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalabhaśālā-karaṇa, cf. karaṇa (LP); explained as ‘the camel department’.", "gloss_language": "en"}]}], "kalacakra": [{"id": "kAlacakra", "headword": "कालचक्र", "headword_slp1": "kAlacakra", "fold": "kalacakra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāla-cakra, a mechanical weapon placed at the gate of forts according to the Vasudevahiṇḍī (Journ. Or. Inst., Vol. X, No. 1, p. 15). See śataghnī.", "gloss_language": "en"}], "synonyms": ["कालचक्रं", "कालचक्रः"], "synonyms_slp1": ["kAlacakraM", "kAlacakraH"]}], "kalaksarita": [{"id": "kAlAkzarita", "headword": "कालाक्षरित", "headword_slp1": "kAlAkzarita", "fold": "kalaksarita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāl-ākṣarita (LP), probably, ‘a word of censure passed’.", "gloss_language": "en"}]}], "kalam": [{"id": "kalam", "headword": "कलम्", "headword_slp1": "kalam", "fold": "kalam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalam (EI 28), a grain measure.", "gloss_language": "en"}]}], "kalamba": [{"id": "kalamba", "headword": "कलम्ब", "headword_slp1": "kalamba", "fold": "kalamba", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalamba (EI 12), an arrow; ‘five’.", "gloss_language": "en"}], "synonyms": ["कलंब", "कलंबः", "कलम्बः"], "synonyms_slp1": ["kalaMba", "kalaMbaH", "kalambaH"]}], "kalana": [{"id": "kalana", "headword": "कलन", "headword_slp1": "kalana", "fold": "kalana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalana, a betelnut plantation (JAS, Letters, Vol. XX, p. 205).", "gloss_language": "en"}], "synonyms": ["कलनं", "कलनः"], "synonyms_slp1": ["kalanaM", "kalanaH"]}], "kalapacCanda": [{"id": "kalApacCanda", "headword": "कलापच्छन्द", "headword_slp1": "kalApacCanda", "fold": "kalapacCanda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalāpacchanda (SII 2), name of an ornament.", "gloss_language": "en"}]}], "kalasa": [{"id": "kalasa", "headword": "कलस", "headword_slp1": "kalasa", "fold": "kalasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalaśa (CITD), a vase, flagon or water-pot; an ornamental piece of painted wood, stone, brass, etc., fixed on the spires of temples, carts, etc.; a rounded pinnacle or ball on the top of a temple; a dome.\n (EI 5), the pinnacle of a temple; same as kumbha.\n (EI 11, 33), a measure; cf. droṇa.\n (SII 3), a pot.\n (EI 33), also called kalasikā; probably, the same as droṇa; a measure of capacity.", "gloss_language": "en"}], "synonyms": ["कलसः"], "synonyms_slp1": ["kalasaH"]}], "kalasanDi": [{"id": "kAlasanDi", "headword": "कालसन्धि", "headword_slp1": "kAlasanDi", "fold": "kalasanDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāla-sandhi (SII 1), same as trikāla.", "gloss_language": "en"}]}], "kalasi": [{"id": "kalasI", "headword": "कलसी", "headword_slp1": "kalasI", "fold": "kalasi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalasī (LP), a measure of capacity equal to sixteen maunds; cf. kalasikā, kalasikāvāpa.", "gloss_language": "en"}]}], "kalasika": [{"id": "kalasikA", "headword": "कलसिका", "headword_slp1": "kalasikA", "fold": "kalasika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalaśikā (EI 33), same as kalaśī or kalaśa; probably the same as droṇa; cf. kalaśikāvāpa.", "gloss_language": "en"}]}], "kalasikavapa": [{"id": "kalasikAvApa", "headword": "कलसिकावाप", "headword_slp1": "kalasikAvApa", "fold": "kalasikavapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalaśikāvāpa (EI 33), a land measure; originally, a plot of land on which one kalasī measure of seed could be sown; cf. droṇavāpa.", "gloss_language": "en"}]}], "kalatra": [{"id": "kalatra", "headword": "कलत्र", "headword_slp1": "kalatra", "fold": "kalatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalatra (IE 7-1-2), ‘seven’.", "gloss_language": "en"}], "synonyms": ["कलत्रं"], "synonyms_slp1": ["kalatraM"]}], "kalavaqa": [{"id": "kalavAqa", "headword": "कलवाड", "headword_slp1": "kalavAqa", "fold": "kalavaqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalavāḍa, Kalavāḍā, Kālavāḍa, Kālavāḍā (EI 24), same as Kālavāl̤a, Kālavāl̤ā.", "gloss_language": "en"}]}], "kalavala": [{"id": "kAlavAla", "headword": "कालवाल", "headword_slp1": "kAlavAla", "fold": "kalavala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kālavāl̤a, Kālavāl̤ā (EI 24), designation of uncertain meaning if it is not the same as Sanskrit Kalyapāla, a vintner.", "gloss_language": "en"}]}], "kaligaRatar": [{"id": "kAligaRattAr", "headword": "कालिगणत्तार्", "headword_slp1": "kAligaRattAr", "fold": "kaligaRatar", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāl̤i-gaṇattār (SITI), Tamil; a committee for the temple of Kāl̤i (Kālī).", "gloss_language": "en"}]}], "kalika": [{"id": "kalikA", "headword": "कलिका", "headword_slp1": "kalikA", "fold": "kalika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalikā (LP), quarrel; cf. Gujarātī kali.", "gloss_language": "en"}]}], "kalikavalika": [{"id": "kalikAvalika", "headword": "कलिकावलिक", "headword_slp1": "kalikAvalika", "fold": "kalikavalika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalikāvalika (LP), a quarrel; cf. kalikā.", "gloss_language": "en"}]}], "kaliNgavariyam": [{"id": "kaliNgavAriyam", "headword": "कलिङ्गवारियम्", "headword_slp1": "kaliNgavAriyam", "fold": "kaliNgavariyam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kaliṅga-vāriyam (SITI), Tamil; committee looking after the sluice; derived from kaliṅgu, ‘a sluice’.", "gloss_language": "en"}]}], "kalma": [{"id": "kAlma", "headword": "काल्म", "headword_slp1": "kAlma", "fold": "kalma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāl-mar̤uturu (CITD), Telugu; an unknown measure of land. Cf. mar̤uturu, ghaḍa-mar̤uturu, etc.", "gloss_language": "en"}]}], "kalnaqu": [{"id": "kalnAqu", "headword": "कल्नाडु", "headword_slp1": "kalnAqu", "fold": "kalnaqu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kal-nāḍu (SITI), Tamil; a hero-stone; setting up of a hero-stone.", "gloss_language": "en"}]}], "kalpa": [{"id": "kalpa", "headword": "कल्प", "headword_slp1": "kalpa", "fold": "kalpa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalpa (CII 1), same as saṃvarta-kalpa, the aeon of destruction.\n (CII 3, etc.), name of a fabulous tree in Indra's paradise, supposed to grant all desires.", "gloss_language": "en"}], "synonyms": ["कल्पः"], "synonyms_slp1": ["kalpaH"]}], "kalpadi": [{"id": "kalpAdi", "headword": "कल्पादि", "headword_slp1": "kalpAdi", "fold": "kalpadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalpādi (EI 5; IA 18), name applied to certain tithis.", "gloss_language": "en"}], "synonyms": ["कल्पादिः"], "synonyms_slp1": ["kalpAdiH"]}], "kalpala": [{"id": "kalpAla", "headword": "कल्पाल", "headword_slp1": "kalpAla", "fold": "kalpala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalpāla (EI 30), also called Kalvapāla, Kalyapāla, Kalyā-pāla; a distiller of liquor.", "gloss_language": "en"}]}], "kalu": [{"id": "kAlu", "headword": "कालु", "headword_slp1": "kAlu", "fold": "kalu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kālu (IE 8-6), Kannaḍa; ‘one foot’; a unit of measurement.", "gloss_language": "en"}]}], "kalvapala": [{"id": "kalvapAla", "headword": "कल्वपाल", "headword_slp1": "kalvapAla", "fold": "kalvapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalvapāla (EI 30), same as Kalpāla, etc.; a vintner.", "gloss_language": "en"}]}], "kalvapalavarika": [{"id": "kalvapAlavArika", "headword": "कल्वपालवारिक", "headword_slp1": "kalvapAlavArika", "fold": "kalvapalavarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalvapāla-vārika (IE 8-8), official designation indicating a spirit-distiller.", "gloss_language": "en"}]}], "kalyaRa": [{"id": "kalyARa", "headword": "कल्याण", "headword_slp1": "kalyARa", "fold": "kalyaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalyāṇa (CII 1), a good deed which is beneficial to the people; a ceremony to bring health and prosperity to a person (Ep. Ind., Vol. XXXV, p. 147); cf. maṅgala in the same senses.\n (EI 19), a festival (especially, marriage); cf. kalyāṇa-maṇḍapa.", "gloss_language": "en"}], "synonyms": ["कल्याणं", "कल्याणः"], "synonyms_slp1": ["kalyARaM", "kalyARaH"]}], "kalyaRagama": [{"id": "kalyARAgama", "headword": "कल्याणागम", "headword_slp1": "kalyARAgama", "fold": "kalyaRagama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalyāṇ-āgama (CII 1), ‘having pure knowledge’.", "gloss_language": "en"}]}], "kalyaRaDana": [{"id": "kalyARaDana", "headword": "कल्याणधन", "headword_slp1": "kalyARaDana", "fold": "kalyaRaDana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalyāṇa-dhana (HRS), tax levied for the expenses of festivals or for the performance of rites to avert evil. Cf. prathama-kalyāṇa (Ep. Ind., Vol. XXXV, p. 147).", "gloss_language": "en"}]}], "kalyaRaka": [{"id": "kalyARaka", "headword": "कल्याणक", "headword_slp1": "kalyARaka", "fold": "kalyaRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalyāṇaka (HA), a chief auspicious event in the life of a Tīrthaṅkara, there being five such events, viz. cyavana or descent from heaven, janma or birth, dīkṣā or initiation as monk, jñāna or attainment of kevala-jñāna, and mokṣa or nirvāṇa, i. e. death which means freedom from the last bondage in the life of a Jina. See kalyāṇikā.", "gloss_language": "en"}]}], "kalyaRasundara": [{"id": "kalyARasundara", "headword": "कल्याणसुन्दर", "headword_slp1": "kalyARasundara", "fold": "kalyaRasundara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalyāṇasundara, Śiva represented as marrying Umā Haimavatī.", "gloss_language": "en"}]}], "kalyaRi": [{"id": "kalyARI", "headword": "कल्याणी", "headword_slp1": "kalyARI", "fold": "kalyaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalyāṇī (EI 8), a square pond.", "gloss_language": "en"}]}], "kalyaRika": [{"id": "kalyARikA", "headword": "कल्याणिका", "headword_slp1": "kalyARikA", "fold": "kalyaRika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kalyāṇikā (EI 8), a festival. []\n (EI 11), certain auspicious days with the Jains. Cf. kalyāṇaka.", "gloss_language": "en"}]}], "kalyapala": [{"id": "kalyapAla", "headword": "कल्यपाल", "headword_slp1": "kalyapAla", "fold": "kalyapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalyapāla, Kalyāpāla (EI 30), same as Kalpāla, etc.; a vintner.", "gloss_language": "en"}], "synonyms": ["कल्यपालः"], "synonyms_slp1": ["kalyapAlaH"]}], "kalyasresWin": [{"id": "kalyaSrezWin", "headword": "कल्यश्रेष्ठिन्", "headword_slp1": "kalyaSrezWin", "fold": "kalyasresWin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kalya-śreṣṭhin (IA 18), a dealer in liquors, Kalya being an abbreviation of Kalyapāla, or a word meaning ‘distillery’.", "gloss_language": "en"}]}], "kalavalika": [{"id": "kallavalika", "headword": "कल्लवलिक", "headword_slp1": "kallavalika", "fold": "kalavalika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kal̤l̤avalika (EI 28), name of a tax.", "gloss_language": "en"}]}]}