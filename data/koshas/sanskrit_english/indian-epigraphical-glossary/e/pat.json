{"pataka": [{"id": "pAtaka", "headword": "पातक", "headword_slp1": "pAtaka", "fold": "pataka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pātaka (IE 8-1-2), ‘five’. Cf. pañca-mahāpātaka.", "gloss_language": "en"}], "synonyms": ["पातकं", "पातकः"], "synonyms_slp1": ["pAtakaM", "pAtakaH"]}], "patala": [{"id": "pAtAla", "headword": "पाताल", "headword_slp1": "pAtAla", "fold": "patala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pātāla (IE 7-1-2), sometimes used to indicate^1 ‘seven’.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}], "synonyms": ["पातालं", "पातालः"], "synonyms_slp1": ["pAtAlaM", "pAtAlaH"]}, {"id": "pattalA", "headword": "पत्तला", "headword_slp1": "pattalA", "fold": "patala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pattalā (EI 8-3; EI 19, 24; 26; CII 4), a territorial division; a district.\n (IA 18; LP), same as paṭṭa, a royal charter; cf. prasāda-pattalā (LP), a deed recording the grant of rent-free land; (IA 18), cf. prabhoḥ prasād-āvāpta-pattalayā, explained as ‘[area enjoyed] under a patent obtained through the favour of the lord’.", "gloss_language": "en"}]}], "patalakaraRin": [{"id": "pAtalakaraRin", "headword": "पातलकरणिन्", "headword_slp1": "pAtalakaraRin", "fold": "patalakaraRin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātala-karaṇin (IA 12), official designation.", "gloss_language": "en"}]}], "pataNga": [{"id": "pataNga", "headword": "पतङ्ग", "headword_slp1": "pataNga", "fold": "pataNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pataṅga (IA 11), a paper kite.", "gloss_language": "en"}], "synonyms": ["पतंग", "पतंगः", "पतङ्गं", "पतङ्गः"], "synonyms_slp1": ["pataMga", "pataMgaH", "pataNgaM", "pataNgaH"]}], "pataniya": [{"id": "pAtanIya", "headword": "पातनीय", "headword_slp1": "pAtanIya", "fold": "pataniya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pātanīya (LP), ‘should be left aside’, i. e. ‘should not be taken into account’.\n (LP), to be kept uncultivated; see kheḍanīya.", "gloss_language": "en"}]}], "patasaha": [{"id": "pAtasAha", "headword": "पातसाह", "headword_slp1": "pAtasAha", "fold": "patasaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātasāha (EI 11, 30; BL), Muslim imperial title; same as Persian Pādshāh. Cf. Pātasāhi, Pātisāha, Pātusāha.", "gloss_language": "en"}]}], "patasahi": [{"id": "pAtasAhi", "headword": "पातसाहि", "headword_slp1": "pAtasAhi", "fold": "patasahi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātasāhi (BI), Indian modification of an imperial title of the Muhammadans; same as Persian Pādshāh; cf. Pātasāha, Pātisāhi, etc.", "gloss_language": "en"}]}], "patayisyami": [{"id": "pAtayizyAmi", "headword": "पातयिष्यामि", "headword_slp1": "pAtayizyAmi", "fold": "patayisyami", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pātayiṣyāmi (LP), ‘I shall deduct and thus take less.’", "gloss_language": "en"}]}], "pati": [{"id": "pati", "headword": "पति", "headword_slp1": "pati", "fold": "pati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pati (LL), a king; cf. adhipati.\n (EI 18), same as Kuḍipati = Sanskrit Grāmapati.\n Cf. grāma-patyā (probably the same as grāma-jana-patitvāt) and nānā-patyā (probably nānā-grāma-jana-patitvāt). See JAS, Letters, Vol. XX, pp. 203-04.", "gloss_language": "en"}], "synonyms": ["पतिः"], "synonyms_slp1": ["patiH"]}, {"id": "patti", "headword": "पत्ति", "headword_slp1": "patti", "fold": "pati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "patti (SII 2), same as nivartana.\n (SII 1), a sheep-fold; a square measure.\n (CII 4), share of the produce.\n (IE 8-3), the smallest division of the army.", "gloss_language": "en"}], "synonyms": ["पत्तिः"], "synonyms_slp1": ["pattiH"]}, {"id": "pattI", "headword": "पत्ती", "headword_slp1": "pattI", "fold": "pati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pattī (IA 15), an extra land cess.", "gloss_language": "en"}]}], "patiBaga": [{"id": "patiBAga", "headword": "पतिभाग", "headword_slp1": "patiBAga", "fold": "patiBaga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pati-bhāga (CII 4), a share of the produce payable to the landlord.", "gloss_language": "en"}]}, {"id": "pattiBAga", "headword": "पत्तिभाग", "headword_slp1": "pattiBAga", "fold": "patiBaga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "patti-bhāga (CII 4), same as pati-bhāga, a share of produce payable to the landlord.", "gloss_language": "en"}]}], "patihari": [{"id": "patihAri", "headword": "पतिहारि", "headword_slp1": "patihAri", "fold": "patihari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Patihāri (EI 27), Sanskrit Pratihārin.", "gloss_language": "en"}]}], "patika": [{"id": "pAtikA", "headword": "पातिका", "headword_slp1": "pAtikA", "fold": "patika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pātikā, cf. rāja-pātikā.", "gloss_language": "en"}]}, {"id": "pattika", "headword": "पत्तिक", "headword_slp1": "pattika", "fold": "patika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pattika (IE 8-3), leader of the patti, the smallest division of the army.", "gloss_language": "en"}]}, {"id": "pattikA", "headword": "पत्तिका", "headword_slp1": "pattikA", "fold": "patika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pattikā (CII 4), a share; same as patti.", "gloss_language": "en"}]}], "patisaha": [{"id": "pAtisAha", "headword": "पातिसाह", "headword_slp1": "pAtisAha", "fold": "patisaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātisāha, also spelt Pādisāha (EI 30; BL); same as Persian Pādshāh; ‘Muslim imperial ruler’. See Pādishāh.", "gloss_language": "en"}]}], "patisahi": [{"id": "pAtisAhi", "headword": "पातिसाहि", "headword_slp1": "pAtisAhi", "fold": "patisahi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātisāhi (BL), Indian modification of an imperial title of the Muslim rulers; same as Persian Pādshāh. See Pātisāha, etc.", "gloss_language": "en"}]}], "patita": [{"id": "patita", "headword": "पतित", "headword_slp1": "patita", "fold": "patita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "patita (LP), uncultivated.", "gloss_language": "en"}], "synonyms": ["पतितः"], "synonyms_slp1": ["patitaH"]}, {"id": "pAtita", "headword": "पातित", "headword_slp1": "pAtita", "fold": "patita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pātita (Ep. Ind., Vol. XXXV, p. 14), ‘killed in a battle’.", "gloss_language": "en"}]}], "patra": [{"id": "patra", "headword": "पत्र", "headword_slp1": "patra", "fold": "patra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "patra (CITD), a letter or document; a note; a written paper or deed.\n (LP), a bond.\n Cf. tāmra-patra.", "gloss_language": "en"}], "synonyms": ["पत्त्रं", "पत्रं"], "synonyms_slp1": ["pattraM", "patraM"]}, {"id": "pAtra", "headword": "पात्र", "headword_slp1": "pAtra", "fold": "patra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātra (IE 8-3; EI 28, 29; BL), a minister; cf. Mahāpurohita-ṭhakkura, Paṇḍita, Upādhyāya, Karaṇa-kāyastha, etc., mentioned as Pātra probably meaning ‘a courtier.’ See Ekapātra and Mahāpātra.", "gloss_language": "en"}, {"gloss": "pātra, probably, a document (patra). See Ep. Ind., Vol. XXX, p. 169.\n (EI 9), a donee.\n Cf. Pātrapati.", "gloss_language": "en"}], "synonyms": ["पात्त्रं", "पात्रं", "पात्रः"], "synonyms_slp1": ["pAttraM", "pAtraM", "pAtraH"]}], "patrapati": [{"id": "pAtrapati", "headword": "पात्रपति", "headword_slp1": "pAtrapati", "fold": "patrapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātrapati, probably, the driver or owner of a horse-cart (ṭaṅgā). See Ep. Ind., Vol. XXXIV, p. 145.", "gloss_language": "en"}]}], "patrasamaya": [{"id": "patrasamaya", "headword": "पत्रसमय", "headword_slp1": "patrasamaya", "fold": "patrasamaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "patra-samaya (LP), the conditions laid down in a bond.", "gloss_language": "en"}]}], "patalaka": [{"id": "pattalaka", "headword": "पत्तलक", "headword_slp1": "pattalaka", "fold": "patalaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pattalaka (IE 8-3; EI 3, 9, 23), official designation; probably, not an officer in charge of a territorial unit called pattalā.", "gloss_language": "en"}]}], "patalika": [{"id": "pattalikA", "headword": "पत्तलिका", "headword_slp1": "pattalikA", "fold": "patalika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pattalikā (EI 9), official designation; feminine form of Pattalaka.", "gloss_language": "en"}]}], "patana": [{"id": "pattana", "headword": "पत्तन", "headword_slp1": "pattana", "fold": "patana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pattana (IE 8-4; IP), a township; suffixed to the names of cities like Aṇahillapura-pattana (modern Pāṭan in the Kadi District of the former Baroda State).", "gloss_language": "en"}], "synonyms": ["पत्तनं"], "synonyms_slp1": ["pattanaM"]}], "patanakarasTanagokulaDikaripurusa": [{"id": "pattanAkarasTAnagokulADikAripuruza", "headword": "पत्तनाकरस्थानगोकुलाधिकारिपुरुष", "headword_slp1": "pattanAkarasTAnagokulADikAripuruza", "fold": "patanakarasTanagokulaDikaripurusa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pattan-ākarasthāna-gokul-ādhikāri-puruṣa (IA 15), official designation or designations.", "gloss_language": "en"}]}], "patiyaRaka": [{"id": "pattiyARaka", "headword": "पत्तियाणक", "headword_slp1": "pattiyARaka", "fold": "patiyaRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pattiyāṇaka (IA 132), official designation of doubtful import; probably, an administrator or document-writer.", "gloss_language": "en"}]}], "patusaha": [{"id": "pAtusAha", "headword": "पातुसाह", "headword_slp1": "pAtusAha", "fold": "patusaha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pātusāha (BL), Indian modification of a Muslim imperial title; same as Persian Pādshāh.", "gloss_language": "en"}]}]}