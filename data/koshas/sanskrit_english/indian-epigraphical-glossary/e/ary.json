{"arya": [{"id": "arya", "headword": "अर्य", "headword_slp1": "arya", "fold": "arya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Arya (CII 1), same as Vaiśya.", "gloss_language": "en"}], "synonyms": ["अर्यः", "अर्य्य", "अर्य्यः"], "synonyms_slp1": ["aryaH", "aryya", "aryyaH"]}, {"id": "Arya", "headword": "आर्य", "headword_slp1": "Arya", "fold": "arya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ārya, cf. Tamil ayyar (EI 25), the father.\n Cf. bhadatasa aya-Isipālitasa, ‘of the Reverend Lord Ṛṣipālita’ (Ind. Ant., Vol. XI, p. 29).\n (SII 1), a [Jain] saint.", "gloss_language": "en"}], "synonyms": ["आर्यः", "आर्य्य", "आर्य्यः"], "synonyms_slp1": ["AryaH", "Aryya", "AryyaH"]}, {"id": "AryA", "headword": "आर्या", "headword_slp1": "AryA", "fold": "arya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āryā, cf. āī (EI 9), the mother.", "gloss_language": "en"}], "synonyms": ["आर्य्या"], "synonyms_slp1": ["AryyA"]}], "aryaguru": [{"id": "Aryaguru", "headword": "आर्यगुरु", "headword_slp1": "Aryaguru", "fold": "aryaguru", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ārya-guru, cf. ajja-guru (EI 5), ‘a grandfather preceptor’; preceptor's preceptor.", "gloss_language": "en"}]}], "aryaka": [{"id": "Aryaka", "headword": "आर्यक", "headword_slp1": "Aryaka", "fold": "aryaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āryaka, Prakrit ajjaka, ayyaka (EI 20, 28; CII 3; IA 15), the grandfather; father's father. Cf. prārya, āryikā.\n Cf. Prakrit ajjaka (EI 24), an ascetic.", "gloss_language": "en"}], "synonyms": ["आर्यकः", "आर्य्यक", "आर्य्यकं", "आर्य्यकः"], "synonyms_slp1": ["AryakaH", "Aryyaka", "AryyakaM", "AryyakaH"]}, {"id": "AryakA", "headword": "आर्यका", "headword_slp1": "AryakA", "fold": "aryaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āryakā, cf. Prakrit ajjakā (EI 24), Sanskrit āryikā; a female ascetic of the Jain order.", "gloss_language": "en"}], "synonyms": ["आर्य्यका"], "synonyms_slp1": ["AryyakA"]}], "aryaputra": [{"id": "Aryaputra", "headword": "आर्यपुत्र", "headword_slp1": "Aryaputra", "fold": "aryaputra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ārya-putra, Prakrit Aya-puta (IE 8-2; EI 3; HD), probably, title of a son of the ruling king. Cf. CII, Vol. I, p. 175.", "gloss_language": "en"}], "synonyms": ["आर्यपुत्रः", "आर्य्यपुत्त्रः", "आर्य्यपुत्र"], "synonyms_slp1": ["AryaputraH", "AryyaputtraH", "Aryyaputra"]}], "aryasanGa": [{"id": "AryasaMGa", "headword": "आर्यसंघ", "headword_slp1": "AryasaMGa", "fold": "aryasanGa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ārya-saṃgha (CII 3), ‘the community of the faithful (i. e. the Buddhist monks)’.", "gloss_language": "en"}]}], "aryasatya": [{"id": "Aryasatya", "headword": "आर्यसत्य", "headword_slp1": "Aryasatya", "fold": "aryasatya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ārya-satya, cf. Pali ariya-sacca (EI 5), Buddhist; four in number.", "gloss_language": "en"}]}], "aryika": [{"id": "AryikA", "headword": "आर्यिका", "headword_slp1": "AryikA", "fold": "aryika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āryikā, cf. Prakrit āyikā (EI 20, 28), the grandmother; ‘father's mother’; mentioned side by side with mahāmātṛkā, ‘mother's mother’ (Select Inscriptions, p. 225).", "gloss_language": "en"}], "synonyms": ["आर्य्यिका"], "synonyms_slp1": ["AryyikA"]}]}