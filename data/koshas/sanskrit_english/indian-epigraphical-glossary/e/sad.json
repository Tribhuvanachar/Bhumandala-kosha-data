{"sada": [{"id": "sAda", "headword": "साद", "headword_slp1": "sAda", "fold": "sada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sāda (EI 28), name of a tax.", "gloss_language": "en"}], "synonyms": ["सादः"], "synonyms_slp1": ["sAdaH"]}], "sadaka": [{"id": "sadaka", "headword": "सदक", "headword_slp1": "sadaka", "fold": "sadaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sadaka, cf. upari-sadaka, explained as ‘the upper region’ (Ep. Ind., Vol. XXXI. p. 234).", "gloss_language": "en"}]}], "sadaseva": [{"id": "sadAsevA", "headword": "सदासेवा", "headword_slp1": "sadAsevA", "fold": "sadaseva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sadā-sevā, cf. Tamil sadā-servai, sadā-sevai (SII 1; SITI); constant service; permanent service.", "gloss_language": "en"}]}], "sadyaskra": [{"id": "sAdyaskra", "headword": "साद्यस्क्र", "headword_slp1": "sAdyaskra", "fold": "sadyaskra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sādyaskra (EI 22; CII 3; etc.), name of a sacrifice.", "gloss_language": "en"}], "synonyms": ["साद्यस्क्रः"], "synonyms_slp1": ["sAdyaskraH"]}], "sadaRqadosa": [{"id": "sadaRqadoza", "headword": "सदण्डदोष", "headword_slp1": "sadaRqadoza", "fold": "sadaRqadosa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-daṇḍa-doṣa (EI 23), ‘together with [the right to] levy fines for crimes’; the meaning of doṣa is really doubtful in the context.", "gloss_language": "en"}]}], "sadaRqanigraha": [{"id": "sadaRqanigraha", "headword": "सदण्डनिग्रह", "headword_slp1": "sadaRqanigraha", "fold": "sadaRqanigraha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-daṇḍa-nigraha (EI 24), refers to the king's power to punish [culprits] by fines or corporal punishment.", "gloss_language": "en"}]}], "sadasapacara": [{"id": "sadaSApacAra", "headword": "सदशापचार", "headword_slp1": "sadaSApacAra", "fold": "sadasapacara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-daś-āpacāra , same as sa-daś-āparādha; cf. Ind. Ep., p. 397.", "gloss_language": "en"}]}], "sadasaparaDa": [{"id": "sadaSAparADa", "headword": "सदशापराध", "headword_slp1": "sadaSAparADa", "fold": "sadasaparaDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-daś-āparādha (EI 27), also quoted as sa-daś-āpacāra; ‘together with the right to punish and realise fines for the ten offences (murder, theft, etc.)’; epithet of gift village; cf. sahya-daś-āparādha probably meaning that the crimes committed in the gift village should not be punished by the king.", "gloss_language": "en"}]}], "sadeyameya": [{"id": "sadeyameya", "headword": "सदेयमेय", "headword_slp1": "sadeyameya", "fold": "sadeyameya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-deya-meya (EI 7), same as sa-dhānya-hiraṇy-ādeya, etc.", "gloss_language": "en"}]}]}