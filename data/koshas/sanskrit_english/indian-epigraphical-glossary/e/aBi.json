{"aBigamikaguRa": [{"id": "ABigAmikaguRa", "headword": "आभिगामिकगुण", "headword_slp1": "ABigAmikaguRa", "fold": "aBigamikaguRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ābhigāmika-guṇa (CII 3, 4), certain attractive qualities.", "gloss_language": "en"}]}], "aBiGata": [{"id": "aBiGAta", "headword": "अभिघात", "headword_slp1": "aBiGAta", "fold": "aBiGata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhighāta (LP), an injury.", "gloss_language": "en"}], "synonyms": ["अभिघातः"], "synonyms_slp1": ["aBiGAtaH"]}], "aBihara": [{"id": "aBihAra", "headword": "अभिहार", "headword_slp1": "aBihAra", "fold": "aBihara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhihāra (CII 1), a reward.", "gloss_language": "en"}], "synonyms": ["अभिहारः"], "synonyms_slp1": ["aBihAraH"]}], "aBijYana": [{"id": "aBijYAna", "headword": "अभिज्ञान", "headword_slp1": "aBijYAna", "fold": "aBijYana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhijñāna (LP), a token by which the identity of a person is recognised.", "gloss_language": "en"}], "synonyms": ["अभिज्ञानं"], "synonyms_slp1": ["aBijYAnaM"]}], "aBikara": [{"id": "aBikAra", "headword": "अभिकार", "headword_slp1": "aBikAra", "fold": "aBikara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhikāra, cf. kṛt-ābhikāra (CII 1), probably, one who has committed an offence under the instigation of another.", "gloss_language": "en"}]}], "aBileKitaka": [{"id": "aBileKitaka", "headword": "अभिलेखितक", "headword_slp1": "aBileKitaka", "fold": "aBileKitaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhilekhitaka (IE 8-8), probably, a written complaint.", "gloss_language": "en"}]}], "aBinava": [{"id": "aBinava", "headword": "अभिनव", "headword_slp1": "aBinava", "fold": "aBinava", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhinava (EI 5; IA 18), name of a tax; cf. abhinava-mārga-ṇaka-prabhṛti-sarv-ādāyair=upetaḥ, epithet of the gift village. It may also mean ‘new’ and the reference may be to the new mārgaṇaka tax. See abhinava-mārgaṇaka.", "gloss_language": "en"}], "synonyms": ["अभिनवः"], "synonyms_slp1": ["aBinavaH"]}], "aBinavamargaRaka": [{"id": "aBinavamArgaRaka", "headword": "अभिनवमार्गणक", "headword_slp1": "aBinavamArgaRaka", "fold": "aBinavamargaRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhinava-mārgaṇaka (Ep. Ind., Vol. III, p. 264, note 1), name of a tax. See mārgaṇaka, mārg-ādāya, etc.", "gloss_language": "en"}]}], "aBipreta": [{"id": "aBipreta", "headword": "अभिप्रेत", "headword_slp1": "aBipreta", "fold": "aBipreta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhipreta (CII 1), intention.", "gloss_language": "en"}], "synonyms": ["अभिप्रेतं"], "synonyms_slp1": ["aBipretaM"]}], "aBira": [{"id": "ABIra", "headword": "आभीर", "headword_slp1": "ABIra", "fold": "aBira", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ābhīra (IE 8-3), member of the cowherd community.", "gloss_language": "en"}], "synonyms": ["आभीरः"], "synonyms_slp1": ["ABIraH"]}], "aBirakta": [{"id": "aBirakta", "headword": "अभिरक्त", "headword_slp1": "aBirakta", "fold": "aBirakta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhirakta (CII 1), beloved one.", "gloss_language": "en"}]}], "aBiseka": [{"id": "aBizeka", "headword": "अभिषेक", "headword_slp1": "aBizeka", "fold": "aBiseka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhiṣeka (EI 4), coronation; cf. abhiṣeka-kkāṇi, abhiṣeka-kkāṇikkai (SITI), Sanskrit-Tamil; presents offered to the king at the time of his coronation.", "gloss_language": "en"}], "synonyms": ["अभिषेकः"], "synonyms_slp1": ["aBizekaH"]}], "aBisekamaRdapa": [{"id": "aBizekamaRdapa", "headword": "अभिषेकमण्दप", "headword_slp1": "aBizekamaRdapa", "fold": "aBisekamaRdapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhiṣeka-maṇḍapa (SITI), a hall where ceremonial baths are taken; the coronation hall; also called tiru-mañjana-śālai and kul̤ikkum-iḍam in Tamil.", "gloss_language": "en"}]}], "aBisekanaman": [{"id": "aBizekanAman", "headword": "अभिषेकनामन्", "headword_slp1": "aBizekanAman", "fold": "aBisekanaman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhiṣeka-nāman (SITI), the name or title assumed by a king at the time of his coronation.", "gloss_language": "en"}]}], "aBisikta": [{"id": "aBizikta", "headword": "अभिषिक्त", "headword_slp1": "aBizikta", "fold": "aBisikta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhiṣikta (CII 1), cf. dvādaśa-varṣ-ābhiṣikta, ‘when one has been anointed twelve years’, ‘when twelve years have elapsed from one's coronation’. See Ep. Ind., Vol. XXXIII, pp. 333 ff.", "gloss_language": "en"}]}], "aBiswadevata": [{"id": "aBIzwadevatA", "headword": "अभीष्टदेवता", "headword_slp1": "aBIzwadevatA", "fold": "aBiswadevata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhīṣṭa-devatā (IA 18), same as iṣṭa-devatā; the favourite deity; the tutelary^1 deity.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "aBisTana": [{"id": "aBisTAna", "headword": "अभिस्थान", "headword_slp1": "aBisTAna", "fold": "aBisTana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhisthāna, correctly abhiṣṭhāna; used in the sense of adhiṣṭhāna, ‘the residence’, ‘a city’, or ‘the headquarters’. Cf. Ep. Ind., Vol. XXXIV, p. 219.", "gloss_language": "en"}]}], "aBitvaramaRa": [{"id": "aBitvaramARa", "headword": "अभित्वरमाण", "headword_slp1": "aBitvaramARa", "fold": "aBitvaramaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Abhitvaramāṇa, Abhitvaramāṇaka (IE 8-3; EI 31; HD), the letter-carrier or a special kind of messenger. Cf. Ep. Ind., Vol. XVII, p. 321 (dūta-praiṣaṇika-gamāgamik-ābhi-tvaramāṇaka); Vogel, Ant. Ch. St., pp. 125-26.", "gloss_language": "en"}]}], "aBisekakaRikE": [{"id": "aBizekakkARikkE", "headword": "अभिषेकक्काणिक्कै", "headword_slp1": "aBizekakkARikkE", "fold": "aBisekakaRikE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhiṣeka-kkāṇikkai (SITI), Sanskrit-Tamil; presents offered to a king at the time of his coronation.", "gloss_language": "en"}]}]}