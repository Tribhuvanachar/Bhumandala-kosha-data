{"mar": [{"id": "mAr", "headword": "मार्", "headword_slp1": "mAr", "fold": "mar", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mār (IA 15), a land measure.", "gloss_language": "en"}]}], "mara": [{"id": "mara", "headword": "मर", "headword_slp1": "mara", "fold": "mara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mara (EI 14), name of a measure.", "gloss_language": "en"}], "synonyms": ["मरः"], "synonyms_slp1": ["maraH"]}], "maramakatayam": [{"id": "maramakkatayam", "headword": "मरमक्कतयम्", "headword_slp1": "maramakkatayam", "fold": "maramakatayam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maramakkatayam (EI 9), system of inheritance prevalent in the Malayāl̤am-speaking area, according to which property is owned by females and passes from female to female.", "gloss_language": "en"}]}], "maraWi": [{"id": "marAWI", "headword": "मराठी", "headword_slp1": "marAWI", "fold": "maraWi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Marāṭhī, language and people of Maharashtra.", "gloss_language": "en"}]}], "maravaqE": [{"id": "maravaqE", "headword": "मरवडै", "headword_slp1": "maravaqE", "fold": "maravaqE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maravaḍai (EI 17), name of a tax.", "gloss_language": "en"}]}], "marga": [{"id": "mArga", "headword": "मार्ग", "headword_slp1": "mArga", "fold": "marga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mārga (IE 8-1), abbreviation of Mārgaśīrṣa, Mārgaśira, etc.", "gloss_language": "en"}], "synonyms": ["मार्गः"], "synonyms_slp1": ["mArgaH"]}], "margadaya": [{"id": "mArgAdAya", "headword": "मार्गादाय", "headword_slp1": "mArgAdAya", "fold": "margadaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārg-ādāya (EI 23; SITI), same as vartma-daṇḍa; levy for passage of articles of merchandise through the gift village by the village road; tolls; tolls on the articles on transit. See mārgaka.", "gloss_language": "en"}]}], "margaka": [{"id": "mArgaka", "headword": "मार्गक", "headword_slp1": "mArgaka", "fold": "margaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārgaka (EI 26), name of a levy; same as mārg-ādāya.", "gloss_language": "en"}], "synonyms": ["मार्गकः"], "synonyms_slp1": ["mArgakaH"]}], "margaRa": [{"id": "mArgaRa", "headword": "मार्गण", "headword_slp1": "mArgaRa", "fold": "margaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārgaṇa (EI 24), a beggar^1.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}], "synonyms": ["मार्गणं", "मार्गणः"], "synonyms_slp1": ["mArgaRaM", "mArgaRaH"]}], "margaRaka": [{"id": "mArgaRaka", "headword": "मार्गणक", "headword_slp1": "mArgaRaka", "fold": "margaRaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārgaṇaka (EI 3; IA 18; CII 4; HRS), known from records like those of the Caulukyas; a levy; a kind of cess or tax; explained as ‘benevolences of a general character, as distinguished from the special types called prasthaka and skandhaka’. See mārgaṇika.", "gloss_language": "en"}], "synonyms": ["मार्गणकः"], "synonyms_slp1": ["mArgaRakaH"]}], "margaRika": [{"id": "mArgaRika", "headword": "मार्गणिक", "headword_slp1": "mArgaRika", "fold": "margaRika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārgaṇika (IE 8-5), same as mārgaṇaka.", "gloss_language": "en"}]}], "margapa": [{"id": "mArgapa", "headword": "मार्गप", "headword_slp1": "mArgapa", "fold": "margapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mārgapa (EI 20), same as Mārgapāla, etc.", "gloss_language": "en"}]}], "margapala": [{"id": "mArgapAla", "headword": "मार्गपाल", "headword_slp1": "mArgapAla", "fold": "margapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mārgapāla (HD), same as Mārgapati, etc. See Nārada quoted in the Mitākṣarā on Yājñavalkyasmṛti, II. 71. Cf. Dikpāla.", "gloss_language": "en"}]}], "margapati": [{"id": "mArgapati", "headword": "मार्गपति", "headword_slp1": "mArgapati", "fold": "margapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mārgapati (BL; HE), explained as ‘the guardian of the frontiers or passes’ (cf. Ep. Ind., Vol. XX, pp. 37, 41); probably, a collector of customs duties on the roads. See mārg-ādāya, etc.", "gloss_language": "en"}], "synonyms": ["मार्गपतिः"], "synonyms_slp1": ["mArgapatiH"]}], "margesa": [{"id": "mArgeSa", "headword": "मार्गेश", "headword_slp1": "mArgeSa", "fold": "margesa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mārgeśa (EI 20), same as Mārgapati.", "gloss_language": "en"}]}], "mariCi": [{"id": "marICi", "headword": "मरीछि", "headword_slp1": "marICi", "fold": "mariCi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "marīci, a theoretical unit of measurement (JNSI, Vol. XVI, p. 48).", "gloss_language": "en"}]}], "marJaka": [{"id": "marJaka", "headword": "मर्झक", "headword_slp1": "marJaka", "fold": "marJaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Marjhaka (ML), title of foreign origin.", "gloss_language": "en"}]}], "martaRqa": [{"id": "mArtaRqa", "headword": "मार्तण्ड", "headword_slp1": "mArtaRqa", "fold": "martaRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārtaṇḍa (IE 7-1-2), ‘twelve.’", "gloss_language": "en"}], "synonyms": ["मार्तंड", "मार्तंडः", "मार्तण्डः", "मार्त्तण्ड", "मार्त्तण्डः"], "synonyms_slp1": ["mArtaMqa", "mArtaMqaH", "mArtaRqaH", "mArttaRqa", "mArttaRqaH"]}], "marva": [{"id": "marvA", "headword": "मर्वा", "headword_slp1": "marvA", "fold": "marva", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Marvād̤ī, spelt Marwari in English; name of the Rājasthānī dialect prevalent in Marwar.", "gloss_language": "en"}]}], "maryada": [{"id": "maryAdA", "headword": "मर्यादा", "headword_slp1": "maryAdA", "fold": "maryada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maryādā (SITI), Tamil mariyādi; customary dues; manners; ways; extent; limit; also spelt in Tamil as marjādi, mariśādi, maruśādi, etc.", "gloss_language": "en"}], "synonyms": ["मर्य्यादा"], "synonyms_slp1": ["maryyAdA"]}], "maryadaDurya": [{"id": "maryAdADurya", "headword": "मर्यादाधुर्य", "headword_slp1": "maryAdADurya", "fold": "maryadaDurya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Maryādā-dhurya (BL), explained as ‘the Warden of Marches.’", "gloss_language": "en"}]}], "maryadaparihara": [{"id": "maryAdAparihAra", "headword": "मर्यादापरिहार", "headword_slp1": "maryAdAparihAra", "fold": "maryadaparihara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "maryādā-parihāra (EI 22), customary exemptions of taxes. See parihāra.", "gloss_language": "en"}]}], "marakaqamE": [{"id": "marakkaqamE", "headword": "मरक्कडमै", "headword_slp1": "marakkaqamE", "fold": "marakaqamE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mara-kkaḍamai (SITI), Tamil; tax payable for trees.", "gloss_language": "en"}]}], "maramaYjaqi": [{"id": "maramaYjAqi", "headword": "मरमञ्जाडि", "headword_slp1": "maramaYjAqi", "fold": "maramaYjaqi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mara-mañjāḍi (SITI), Tamil; tax of one mañjāḍi for every tree.", "gloss_language": "en"}]}], "margadayam": [{"id": "mArgAdAyam", "headword": "मार्गादायम्", "headword_slp1": "mArgAdAyam", "fold": "margadayam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mārg-ādāyam (SITI), Sanskrit; tolls on the articles in transit.", "gloss_language": "en"}]}], "mariyadi": [{"id": "mariyAdi", "headword": "मरियादि", "headword_slp1": "mariyAdi", "fold": "mariyadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mariyādi (SITI), Tamil; customary dues; also spelt mar-jādi, mariśādi, maruśādi, etc., and used in the sense of manner, way, extent, limit.", "gloss_language": "en"}]}], "marici": [{"id": "marIci", "headword": "मरीचि", "headword_slp1": "marIci", "fold": "marici", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "marīci , a minute unit of measurement.", "gloss_language": "en"}], "synonyms": ["मरीचिः"], "synonyms_slp1": ["marIciH"]}]}