{"Ban": [{"id": "BaM", "headword": "भं", "headword_slp1": "BaM", "fold": "Ban", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhaṃ˚ (PJS), abbreviation of Bhaṇḍārin (especially in medieval Jain inscriptions). See Bhīṇḍārin, etc.", "gloss_language": "en"}], "synonyms": ["भ", "भः"], "synonyms_slp1": ["Ba", "BaH"]}], "Banqi": [{"id": "BaMqi", "headword": "भंडि", "headword_slp1": "BaMqi", "fold": "Banqi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bhaṃḍi (CITD), same as Telugu baṃḍi, ‘a cart’; really ‘a cart load’.", "gloss_language": "en"}], "synonyms": ["भंडिः", "भण्डि", "भण्डिः"], "synonyms_slp1": ["BaMqiH", "BaRqi", "BaRqiH"]}], "Banasavergaqe": [{"id": "BAnasavergaqe", "headword": "भानसवेर्गडे", "headword_slp1": "BAnasavergaqe", "fold": "Banasavergaqe", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhānasa-věrgaḍě (IE 8-3), Kannaḍa; same as Mahānas-ādhyakṣa; superintendent of the royal kitchen. Cf. Sūpakāra-pati, Khādyaṭapākika, Mahānasika.", "gloss_language": "en"}]}], "Banu": [{"id": "BAnu", "headword": "भानु", "headword_slp1": "BAnu", "fold": "Banu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bhānu (IE 7-1-2; EI 25), ‘twelve’.", "gloss_language": "en"}], "synonyms": ["भानुः"], "synonyms_slp1": ["BAnuH"]}]}