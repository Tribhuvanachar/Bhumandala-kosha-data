{"gfha": [{"id": "gfha", "headword": "गृह", "headword_slp1": "gfha", "fold": "gfha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gṛha, cf. ghara (EI 7), a caitya; a cave. Cf. gṛha-mukha.", "gloss_language": "en"}], "synonyms": ["गृहं", "गृहः"], "synonyms_slp1": ["gfhaM", "gfhaH"]}], "gfhakara": [{"id": "gfhakara", "headword": "गृहकर", "headword_slp1": "gfhakara", "fold": "gfhakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gṛha-kara, cf. ilvari, manai-ir̤ai, manai-ppaṇam (SITI), house-tax.", "gloss_language": "en"}]}], "gfhakftya": [{"id": "gfhakftya", "headword": "गृहकृत्य", "headword_slp1": "gfhakftya", "fold": "gfhakftya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gṛha-kṛtya (HRS), an office concerned with domestic affairs of the kingdom as indicated by the Rājataraṅgiṇī. See Ghoshal, H. Rev. Syst., p. 250.", "gloss_language": "en"}]}], "gfhamuKa": [{"id": "gfhamuKa", "headword": "गृहमुख", "headword_slp1": "gfhamuKa", "fold": "gfhamuKa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gṛha-mukha, cf. ghara-mugha (LL), the door of a cave.", "gloss_language": "en"}]}], "gfhapati": [{"id": "gfhapati", "headword": "गृहपति", "headword_slp1": "gfhapati", "fold": "gfhapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gṛhapati (EI 25; CII 3; LL), a householder; same as Gṛhastha.", "gloss_language": "en"}], "synonyms": ["गृहपतिः"], "synonyms_slp1": ["gfhapatiH"]}], "gfhasTa": [{"id": "gfhasTa", "headword": "गृहस्थ", "headword_slp1": "gfhasTa", "fold": "gfhasTa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gṛhastha (LL), a householder; same as Gṛhapati.", "gloss_language": "en"}], "synonyms": ["गृहस्थः"], "synonyms_slp1": ["gfhasTaH"]}], "gfhasTana": [{"id": "gfhasTAna", "headword": "गृहस्थान",