{"nisadam": [{"id": "niSadam", "headword": "निशदम्", "headword_slp1": "niSadam", "fold": "nisadam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niśadam, also called niśadi (SII 1), supposed to be the same as nityam.", "gloss_language": "en"}]}], "nisaDi": [{"id": "niSaDi", "headword": "निशधि", "headword_slp1": "niSaDi", "fold": "nisaDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niśadhi (EI 28), also spelt nisidhi, niṣidhi, niṣedhikā, etc.; the tomb of Jain monks. Cf. niśīdikā, etc. (Sanskrit niṣadyā).", "gloss_language": "en"}]}], "nisadi": [{"id": "niSadi", "headword": "निशदि", "headword_slp1": "niSadi", "fold": "nisadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niśadi, cf. niśadam.", "gloss_language": "en"}]}], "nisadya": [{"id": "nizadyA", "headword": "निषद्या", "headword_slp1": "nizadyA", "fold": "nisadya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣadyā, cf. Prakrit nisidiyā (LL), a dwelling. Cf. niśliṣṭaka.", "gloss_language": "en"}]}], "niseDa": [{"id": "nizeDa", "headword": "निषेध", "headword_slp1": "nizeDa", "fold": "niseDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣedha (LP), same as vyāṣedha (q. v.).", "gloss_language": "en"}], "synonyms": ["निषेधः"], "synonyms_slp1": ["nizeDaH"]}], "niseDika": [{"id": "nizeDikA", "headword": "निषेधिका", "headword_slp1": "nizeDikA", "fold": "niseDika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣedhikā (BL), memorial on the burial ground of Jain religious teachers; cf. nisidhi, etc.; also niśīdikā.", "gloss_language": "en"}]}], "nisiDi": [{"id": "niziDi", "headword": "निषिधि", "headword_slp1": "niziDi", "fold": "nisiDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣidhi, niśidhi, niśīdhi (IA 12), Jain; the tomb of Jain monks.", "gloss_language": "en"}]}], "nisidi": [{"id": "nizIdI", "headword": "निषीदी", "headword_slp1": "nizIdI", "fold": "nisidi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣīdī (EI 20), a Jain tomb; cf. niṣīdhi, etc.", "gloss_language": "en"}]}], "nisidika": [{"id": "niSIdikA", "headword": "निशीदिका", "headword_slp1": "niSIdikA", "fold": "nisidika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niśīdikā, also spelt niśīdigai (SITI), the death of a Jain by fasting; the memorial set up for such a person.", "gloss_language": "en"}]}], "nisima": [{"id": "nisima", "headword": "निसिम", "headword_slp1": "nisima", "fold": "nisima", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nisima (ML), Prakrit; supposed to be the same as stūpa; cf. nissīma.", "gloss_language": "en"}]}, {"id": "nissIma", "headword": "निस्सीम", "headword_slp1": "nissIma", "fold": "nisima", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nissīma (CII 2-1), explained as ‘a piece of land outside a monastery’. See nisima.", "gloss_language": "en"}]}], "niska": [{"id": "nizka", "headword": "निष्क", "headword_slp1": "nizka", "fold": "niska", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣka (IE 8-8; EI 15, 27, 30), name of a gold coin; name sometimes applied to śatamāna, śāna, ṭaṅka, gaṇḍa-māḍa, etc.; cf. gaṇḍa-niṣka, also called gaṇḍa-māḍa. See JNSI, Vol. XVI, pp. 41 ff.\n (IE 8-8), a gold coin equal to sixteen silver drammas.\n (EI 5), a coin equal to a half-pagoda.\n (JNSI, Vol. XV, p. 139), a silver coin equal to one śata-māna.", "gloss_language": "en"}, {"gloss": "niṣka , gold coin or weight equal to one karṣa (80 ratis or about 146 grains) of 16 māṣas or to 4 or 108 or 150 suvarṇas (q. v.); silver coin equal to one śatamāna (320 ratis); sometimes identified with māḍa (q. v.).", "gloss_language": "en"}], "synonyms": ["निष्कं", "निष्कः"], "synonyms_slp1": ["nizkaM", "nizkaH"]}], "niskavala": [{"id": "nizkAvala", "headword": "निष्कावल", "headword_slp1": "nizkAvala", "fold": "niskavala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣkāvala (LP), a thing on which no one has any right; cf. Sanskrit kavala.", "gloss_language": "en"}]}], "nisliswaka": [{"id": "niSlizwaka", "headword": "निश्लिष्टक", "headword_slp1": "niSlizwaka", "fold": "nisliswaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niśliṣṭaka, Prakrit nisiḍhayā (CII 1), explained as ‘a rest-house’. But the correct reading is nisidiyā = Sanskrit niṣadyā (q. v.). See Nach. Akad. Wissen. Goetting., 1959, No. 4, pp. 47ff.", "gloss_language": "en"}]}], "nisraniksepahawa": [{"id": "niSrAnikzepahawwa", "headword": "निश्रानिक्षेपहट्ट", "headword_slp1": "niSrAnikzepahawwa", "fold": "nisraniksepahawa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niśrā-nikṣepa-haṭṭa (EI 11), probably, a place in the market for storing goods to be exported.", "gloss_language": "en"}]}], "nisWapita": [{"id": "nizWApita", "headword": "निष्ठापित", "headword_slp1": "nizWApita", "fold": "nisWapita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣṭhāpita, ‘caused to be completed’ (Sel. Ins., p. 224). Cf. nipratiṣthāpita, niṣṭhita.\n (LP), finished.", "gloss_language": "en"}]}], "nisWita": [{"id": "nizWita", "headword": "निष्ठित", "headword_slp1": "nizWita", "fold": "nisWita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣṭhita (Select Inscriptions, p. 203), completed. Cf. anuṣṭhita, niṣṭhāpita.", "gloss_language": "en"}], "synonyms": ["निष्ठितं"], "synonyms_slp1": ["nizWitaM"]}], "nisidDacawaBawapravesa": [{"id": "nizidDacAwaBawapraveSa", "headword": "निषिद्धचाटभटप्रवेश", "headword_slp1": "nizidDacAwaBawapraveSa", "fold": "nisidDacawaBawapravesa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "niṣiddha-cāṭa-bhaṭa-praveśa (EI 22), same as a-praveśa, etc.", "gloss_language": "en"}]}]}