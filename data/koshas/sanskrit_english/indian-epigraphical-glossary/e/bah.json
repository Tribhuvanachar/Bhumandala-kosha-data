{"bahatara": [{"id": "bAhattara", "headword": "बाहत्तर", "headword_slp1": "bAhattara", "fold": "bahatara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhattara (IE 8-3), literally, ‘seventytwo’, but actually ‘all’ (cf. aṣṭādaśa, etc.); see Bāhattaraniyogādhipati, Bāhattara-niyogin, Senādibāhattaraniyogādhiṣṭhāyaka.", "gloss_language": "en"}]}], "bahataraniyogaDipati": [{"id": "bAhattaraniyogADipati", "headword": "बाहत्तरनियोगाधिपति", "headword_slp1": "bAhattaraniyogADipati", "fold": "bahataraniyogaDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bāhattaraniyogādhipati (IE 8-3; EI 23, 30), the highest executive officer under South Indian kings like the Yādavas of Devagiri; same as Bāhattaraniyogin, etc.", "gloss_language": "en"}]}], "bahataraniyogin": [{"id": "bAhattaraniyogin", "headword": "बाहत्तरनियोगिन्", "headword_slp1": "bAhattaraniyogin", "fold": "bahataraniyogin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Bāhattaraniyogin (EI 19), official designation; same as Bāhattaraniyogādhipati.", "gloss_language": "en"}]}], "bahirgfha": [{"id": "bahirgfha", "headword": "बहिर्गृह", "headword_slp1": "bahirgfha", "fold": "bahirgfha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bahir-gṛha, cf. vāra-gṛha.", "gloss_language": "en"}]}], "bahirika": [{"id": "bAhirikA", "headword": "बाहिरिका", "headword_slp1": "bAhirikA", "fold": "bahirika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhirikā (EI 20), a suburb.", "gloss_language": "en"}]}], "bahis": [{"id": "bahis", "headword": "बहिस्", "headword_slp1": "bahis", "fold": "bahis", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bahis, ‘excluding’; same as Bengali baï (JAS, Letters, Vol. XX, p. 215).", "gloss_language": "en"}]}], "bahu": [{"id": "bAhu", "headword": "बाहु", "headword_slp1": "bAhu", "fold": "bahu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhu (IE 7-1-2; EI 25), ‘two’.", "gloss_language": "en"}], "synonyms": ["बाहुः"], "synonyms_slp1": ["bAhuH"]}], "bahuleya": [{"id": "bAhuleya", "headword": "बाहुलेय", "headword_slp1": "bAhuleya", "fold": "bahuleya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhuleya (CII 3; IA 1), a bull.", "gloss_language": "en"}], "synonyms": ["बाहुलेयः"], "synonyms_slp1": ["bAhuleyaH"]}], "bahusruta": [{"id": "bahuSruta", "headword": "बहुश्रुत", "headword_slp1": "bahuSruta", "fold": "bahusruta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bahuśruta (CII 1), well informed in various doctrines.", "gloss_language": "en"}]}], "bahusuvarRa": [{"id": "bahusuvarRa", "headword": "बहुसुवर्ण", "headword_slp1": "bahusuvarRa", "fold": "bahusuvarRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bahusuvarṇa, bahusuvarṇaka (EI 4; IA 19; CII 4), name of a sacrifice.", "gloss_language": "en"}]}], "bahutavatka": [{"id": "bahutAvatka", "headword": "बहुतावत्क", "headword_slp1": "bahutAvatka", "fold": "bahutavatka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bahutāvatka (CII 1), ‘many times that number’.", "gloss_language": "en"}]}], "bahuvalaya": [{"id": "bAhuvalaya", "headword": "बाहुवलय", "headword_slp1": "bAhuvalaya", "fold": "bahuvalaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhu-valaya, cf. pāku-valayam (SITI), an armlet.", "gloss_language": "en"}]}], "bahya": [{"id": "bAhya", "headword": "बाह्य", "headword_slp1": "bAhya", "fold": "bahya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhya, cf. bāhy-ābhyantar-ādāya (IE 8-5; Ep. Ind., Vol. [] XVI, p. 276, text line 14); ‘income from the sale of things imported in a village’, same as Tamil pur̤av-āyam (SITI), ‘revenue from external sources (collected mainly in cash)’ or Tamil pur̤a-kaḍamai (SITI), ‘external taxes’, explained as taxes and fees payable to the State. But pur̤a-kaḍamai is the same as pur̤av-āyam. Bāhya and ābhyantatra may thus mean respectively taxes payable to the king and those payable to the village authorities. See ābhyantara. Cf. samudaya-bāhy-ādya-stamba (EI 23), ‘land covered with original shrubs, i. e. waste which does not yield any revenue to the State’.\n (HD), a class of royal servants distinguished from Antaraṅga. See Rājataraṅgiṇī, VIII. 426, 680, 1542.", "gloss_language": "en"}], "synonyms": ["बाह्यः"], "synonyms_slp1": ["bAhyaH"]}], "bahyali": [{"id": "bAhyAli", "headword": "बाह्यालि", "headword_slp1": "bAhyAli", "fold": "bahyali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "bāhyāli (CII 4), the outskirt of a town. See vāhyāli.", "gloss_language": "en"}]}]}