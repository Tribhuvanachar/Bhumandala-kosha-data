n-epigraphical-glossary", "senses": [{"gloss": "sa-hiraṇya-bhāga-bhog-oparikara-sarv-ādāya-sameta (EI 23), ‘together with all levies such as hiraṇya, bhāga, bhoga and upa-rikara’. See the various words as noticed separately.", "gloss_language": "en"}]}], "sahiraRyadana": [{"id": "sahiraRyAdAna", "headword": "सहिरण्यादान", "headword_slp1": "sahiraRyAdAna", "fold": "sahiraRyadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-hiraṇy-ādāna (EI 26), ‘together with levies in cash’; privilege of the donee of rent-free and.", "gloss_language": "en"}]}], "sahyadasaparaDa": [{"id": "sahyadaSAparADa", "headword": "सह्यदशापराध", "headword_slp1": "sahyadaSAparADa", "fold": "sahyadasaparaDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sahya-daś-āparādha (IE), see sa-daś-āparādha.", "gloss_language": "en"}]}]}