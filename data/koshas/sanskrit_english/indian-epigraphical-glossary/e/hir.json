{"hiraRya": [{"id": "hiraRya", "headword": "हिरण्य", "headword_slp1": "hiraRya", "fold": "hiraRya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "hiraṇya (IE 8-5; EI 12, 28, 29), same as hiraṇy-āya, hiraṇya-deya; tax payable to the king in cash; dues payable in coins; cash; sometimes abbreviated as hi as in sāṃ-hi=sāṃvatsarika-hiraṇya, annual revenue income in cash; cf. a-hiraṇya-dhānya-praṇaya-pradeya (IE 8-5); it may be in addition to the tax in grain or in lieu of the latter. Cf. Tamil kāś-āya, etc. Also cf. suvarṇ-ādāya, svarṇ-āya. []\n (HRS), king's share of certain crops paid in cash.\n (CII 1), probably, ‘money’.", "gloss_language": "en"}], "synonyms": ["हिरण्यं"], "synonyms_slp1": ["hiraRyaM"]}], "hiraRyagarBa": [{"id": "hiraRyagarBa", "headword": "हिरण्यगर्भ", "headword_slp1": "hiraRyagarBa", "fold": "hiraRyagarBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "hiraṇyagarbha (EI 16; IA 10; SII 3), name of a mahādāna.", "gloss_language": "en"}], "synonyms": ["हिरण्यगर्भः"], "synonyms_slp1": ["hiraRyagarBaH"]}], "hiraRyakara": [{"id": "hiraRyakAra", "headword": "हिरण्यकार", "headword_slp1": "hiraRyakAra", "fold": "hiraRyakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Hiraṇyakāra (LL), a treasurer; also a goldsmith or mint-master. Cf. Hairaṇyika.", "gloss_language": "en"}], "synonyms": ["हिरण्यकारः"], "synonyms_slp1": ["hiraRyakAraH"]}], "hiraRyasamudayika": [{"id": "hiraRyasAmudAyika", "headword": "हिरण्यसामुदायिक", "headword_slp1": "hiraRyasAmudAyika", "fold": "hiraRyasamudayika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Hiraṇyasāmudāyika (IE 8-3), a collector of revenue in cash; sometimes mentioned along with the Audraṅgika or the collector of the udraṅga tax probably levied in grains.", "gloss_language": "en"}]}], "hiraRyasva": [{"id": "hiraRyASva", "headword": "हिरण्य