{"Kari": [{"id": "KAri", "headword": "खारि", "headword_slp1": "KAri", "fold": "Kari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "khāri (EI 17), a land measure; cf. khārī, khārīvāpa.", "gloss_language": "en"}], "synonyms": ["खारिः"], "synonyms_slp1": ["KAriH"]}, {"id": "KArI", "headword": "खारी", "headword_slp1": "KArI", "fold": "Kari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "khārī (IE 8-6; CII 4), a measure of capacity equal to sixteen droṇas.\n (IE 8-6), shortened form of khārīvāpa or khārikāvāpa.", "gloss_language": "en"}]}], "Karika": [{"id": "KArikA", "headword": "खारिका", "headword_slp1": "KArikA", "fold": "Karika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "khārikā (IE 8-6), shortened form of khārikāvāpa or khārī-vāpa; also same as khārī.", "gloss_language": "en"}]}], "Karikavapa": [{"id": "KArikAvApa", "headword": "खारिकावाप", "headword_slp1": "KArikAvApa", "fold": "Karikavapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "khārikāvāpa (IE 8-6), same as khārīvāpa.", "gloss_language": "en"}]}], "Karivapa": [{"id": "KArIvApa", "headword": "खारीवाप", "headword_slp1": "KArIvApa", "fold": "Karivapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "khārīvāpa (IE 8-6), an area of land requiring a khārī measure of seed grains for sowing; a land measure equal to sixteen droṇavāpas or two kulyavāpas.", "gloss_language": "en"}], "synonyms": ["खारीवापः"], "synonyms_slp1": ["KArIvApaH"]}], "KarosWi": [{"id": "KarozWI", "headword": "खरोष्ठी", "headword_slp1": "KarozWI", "fold": "KarosWi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kharoṣṭhī, an early Indian alphabet which was an Indian modification of the Aramaic alphabet; called Kharoṣṭrī by some.", "gloss_language": "en"}]}], "Karvaqa": [{"id"