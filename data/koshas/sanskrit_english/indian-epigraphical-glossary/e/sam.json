 "sāmīpa (CII 1), a neighbour.", "gloss_language": "en"}]}], "samiti": [{"id": "samiti", "headword": "समिति", "headword_slp1": "samiti", "fold": "samiti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samiti (EI 4), five in number.", "gloss_language": "en"}], "synonyms": ["समितिः"], "synonyms_slp1": ["samitiH"]}], "samuKavara": [{"id": "sammuKavAra", "headword": "सम्मुखवार", "headword_slp1": "sammuKavAra", "fold": "samuKavara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sammukha-vāra, probably, Sunday (Ep. Ind., Vol. XXXV, p. 115).", "gloss_language": "en"}]}], "samprapti": [{"id": "samprApti", "headword": "सम्प्राप्ति", "headword_slp1": "samprApti", "fold": "samprapti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samprāpti, cf. sampirātti (SITI) ‘that which has been obtained’; ‘an acquisition’.", "gloss_language": "en"}], "synonyms": ["संप्राप्ति", "संप्राप्तिः", "सम्प्राप्तिः"], "synonyms_slp1": ["saMprApti", "saMprAptiH", "samprAptiH"]}], "samprati": [{"id": "samprati", "headword": "सम्प्रति", "headword_slp1": "samprati", "fold": "samprati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samprati (SITI), senior accountant; the manager of a temple.", "gloss_language": "en"}], "synonyms": ["संप्रति", "सम्प्रतिः"], "synonyms_slp1": ["saMprati", "sampratiH"]}], "sampratipati": [{"id": "sampratipatti", "headword": "सम्प्रतिपत्ति", "headword_slp1": "sampratipatti", "fold": "sampratipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sampratipatti (CII 1), proper behaviour.", "gloss_language": "en"}], "synonyms": ["संप्रतिपत्ति", "संप्रतिपत्तिः", "सम्प्रतिपत्तिः"], "synonyms_slp1": ["saMpratipatti", "saMpratipattiH", "sampratipattiH"]}], "samraw": [{"id": "samrAw", "headword": "सम्राट्", "headword_slp1": "samrAw", "fold": "samraw", "headword_la