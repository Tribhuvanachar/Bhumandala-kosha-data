{"sam": [{"id": "Sam", "headword": "शम्", "headword_slp1": "Sam", "fold": "sam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śam (ML) ‘to prevent’.", "gloss_language": "en"}]}], "sama": [{"id": "sama", "headword": "सम", "headword_slp1": "sama", "fold": "sama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sama, cf. sam-ālindakam (LP), ‘with a terrace in front of the door.’", "gloss_language": "en"}], "synonyms": ["समः"], "synonyms_slp1": ["samaH"]}], "samacarya": [{"id": "samAcarya", "headword": "समाचर्य", "headword_slp1": "samAcarya", "fold": "samacarya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samācarya (CII 1), impartiality.", "gloss_language": "en"}]}], "samaDi": [{"id": "samADi", "headword": "समाधि", "headword_slp1": "samADi", "fold": "samaDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samādhi (CII 4), poetic quality of a composition.\n (EI 33), explained as a ‘granary’; probably ‘an agreement’.\n Cf. sallekhanā.", "gloss_language": "en"}], "synonyms": ["समाधिः"], "synonyms_slp1": ["samADiH"]}], "samaDigatapaYcamahasabda": [{"id": "samaDigatapaYcamahASabda", "headword": "समधिगतपञ्चमहाशब्द", "headword_slp1": "samaDigatapaYcamahASabda", "fold": "samaDigatapaYcamahasabda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samadhigata-pañca-mahāśabda (IE 8-2; CII 3), a customary epithet of feudatory rulers, indicating that they were entitled to the privilege of the pañca-mahāśabda (five kinds of musical instruments), or of using five official titles beginning with the word mahā. There are a few instances in which the epithet is applied to paramount sovereigns in South India. The title is sometimes stated to have been conferred on a feudatory by his overlord. See mahāśabda, etc.", "gloss_language": "en"}]}], "samahartf": [{"id": "samAhartf", "headword": "समाहर्तृ", "headword_slp1": "samAhartf", "fold": "samahartf", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samāhartṛ (EI 27; HD; HRS), official designation; explained as ‘the collector-general’; officer in charge of the collection of various branches of revenue; compared by Ghoshal with the Qānungo of Mughal times (H. Rev. Syst., p. 52). See Arthaśāstra, I. 12; II. 6; Śabara on Jaimini, XII. 1. 28; Ep. Ind., Vol. VIII, p. 141; Vol. XI, p. 94.", "gloss_language": "en"}]}], "samaja": [{"id": "samAja", "headword": "समाज", "headword_slp1": "samAja", "fold": "samaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samāja (EI 20; CII 1), a fair; a festival; a festive gathering [] on a particular occasion or for the celebration of an event.", "gloss_language": "en"}], "synonyms": ["समाजः"], "synonyms_slp1": ["samAjaH"]}], "samajYapti": [{"id": "samAjYapti", "headword": "समाज्ञप्ति", "headword_slp1": "samAjYapti", "fold": "samajYapti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samājñapti (EI 27), same as Ājñapti (q. v.).", "gloss_language": "en"}]}], "samaka": [{"id": "sAmaka", "headword": "सामक", "headword_slp1": "sAmaka", "fold": "samaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sāmaka (LP), ‘collectively’; cf. Gujarātī sāṃṭuṃ.", "gloss_language": "en"}], "synonyms": ["सामकं", "सामकः"], "synonyms_slp1": ["sAmakaM", "sAmakaH"]}], "samakaragrama": [{"id": "samakaragrAma", "headword": "समकरग्राम", "headword_slp1": "samakaragrAma", "fold": "samakaragrama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samakara-grāma (LP), a village for which a permanent revenue is fixed at a particular rate, not to be increased in future.", "gloss_language": "en"}]}], "samakarakula": [{"id": "samakarakula", "headword": "समकरकुल", "headword_slp1": "samakarakula", "fold": "samakarakula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samakara-kula (LP), family on which rent is fixed once for all; farmers that have to pay revenue at a particular rate.", "gloss_language": "en"}]}], "samakranta": [{"id": "samAkrAnta", "headword": "समाक्रान्त", "headword_slp1": "samAkrAnta", "fold": "samakranta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samākrānta (Ep. Ind., Vol. XXXI, p. 20), used in some Orissan records probably in the sense of ‘endowed with boundaries’.", "gloss_language": "en"}]}], "samam": [{"id": "samam", "headword": "समम्", "headword_slp1": "samam", "fold": "samam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samam (LP), ‘in the same way as’.", "gloss_language": "en"}]}], "samaYjasa": [{"id": "samaYjasa", "headword": "समञ्जस", "headword_slp1": "samaYjasa", "fold": "samaYjasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samañjasa (SITI), conformity; resemblance.", "gloss_language": "en"}], "synonyms": ["समंजस", "समञ्जसं", "समञ्जसः"], "synonyms_slp1": ["samaMjasa", "samaYjasaM", "samaYjasaH"]}], "samaYjita": [{"id": "samaYjita", "headword": "समञ्जित", "headword_slp1": "samaYjita", "fold": "samaYjita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samañjita (SITI), accountant of a village or a village assembly.", "gloss_language": "en"}]}], "samanta": [{"id": "samanta", "headword": "समन्त", "headword_slp1": "samanta", "fold": "samanta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samanta (IE 8-1), corrupt form of saṃvat.", "gloss_language": "en"}], "synonyms": ["समंत", "समन्तः"], "synonyms_slp1": ["samaMta", "samantaH"]}, {"id": "sAmanta", "headword": "सामन्त", "headword_slp1": "sAmanta", "fold": "samanta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmanta (IE 8-2; 8-3; EI 30; CII 3, 4; BL; HD), title of feudatory rulers; a feudatory smaller than the Rājan; a sub-ordinate chief; also explained as ‘a minister’ (SITI). See Bomb. Gaz., Vol. XXI, p. 354; Ep. Ind., Vol. IX, p. 297. Cf. Mahāsāmanta.", "gloss_language": "en"}, {"gloss": "Sāmanta (CII 1), a neighbour; ‘one who is in possession of a piece of land in the neighbourhood of the gift land’ (Ep. Ind., Vol. XXXIV, p. 220).", "gloss_language": "en"}], "synonyms": ["सामंत", "सामन्तः"], "synonyms_slp1": ["sAmaMta", "sAmantaH"]}], "samantaBadra": [{"id": "samantaBadra", "headword": "समन्तभद्र", "headword_slp1": "samantaBadra", "fold": "samantaBadra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samantabhadra (Ep. Ind., Vol. III, p. 199), prosperous on all sides.", "gloss_language": "en"}], "synonyms": ["समंतभद्र", "समन्तभद्रः"], "synonyms_slp1": ["samaMtaBadra", "samantaBadraH"]}], "samantaDikarin": [{"id": "sAmantADikArin", "headword": "सामन्ताधिकारिन्", "headword_slp1": "sAmantADikArin", "fold": "samantaDikarin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmant-ādhikārin (ASLV), see Sāmanta and Adhikārin.", "gloss_language": "en"}]}], "samantaDipati": [{"id": "sAmantADipati", "headword": "सामन्ताधिपति", "headword_slp1": "sAmantADipati", "fold": "samantaDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmant-ādhipati (EI 16), cf. Mahāsāmant-ādhipati.", "gloss_language": "en"}]}], "samantapaqira": [{"id": "sAmantapaqirA", "headword": "सामन्तपडिरा", "headword_slp1": "sAmantapaqirA", "fold": "samantapaqira", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmanta-paḍirā (EI 32), Od̤iyā; Sanskrit Sāmanta-pratirāja; title of a feudatory or nobleman.", "gloss_language": "en"}]}], "samantika": [{"id": "sAmantika", "headword": "सामन्तिक", "headword_slp1": "sAmantika", "fold": "samantika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sāmantika, derived from Sāmanta; chiefship (A. R. Ep., 1958-59, p. 12).", "gloss_language": "en"}]}], "samanTu": [{"id": "samanTu", "headword": "समन्थु", "headword_slp1": "samanTu", "fold": "samanTu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samanthu (IE 8-1), corrupt form of saṃvat.", "gloss_language": "en"}]}], "samanya": [{"id": "sAmAnya", "headword": "सामान्य", "headword_slp1": "sAmAnya", "fold": "samanya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sāmānya, cf. traividya-sāmānya (EI 23), cāturvedya-sāmānya; ‘belonging to’; Valabhī-cāturvidya-sāmānya, ‘one of the Catur-vedins of Valabhī’; used also in the sense of vāstavya, ‘resident of … ’ (Ep. Ind., Vol. XXXIV, pp. 172, 176).", "gloss_language": "en"}], "synonyms": ["सामान्यं"], "synonyms_slp1": ["sAmAnyaM"]}], "samaracana": [{"id": "samAracana", "headword": "समारचन", "headword_slp1": "samAracana", "fold": "samaracana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samāracana, repairs (Ep. Ind., Vol. XXXIV, p. 144).", "gloss_language": "en"}]}], "samaraRa": [{"id": "samAraRa", "headword": "समारण", "headword_slp1": "samAraRa", "fold": "samaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samāraṇa Prakrit used in Sanskrit for samāracaṇa (Ep. Ind., Vol. XXXV, p. 59).", "gloss_language": "en"}]}], "samarapaRiya": [{"id": "samarApaRIya", "headword": "समरापणीय", "headword_slp1": "samarApaRIya", "fold": "samarapaRiya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samarāpaṇīya (LP), to be got repaired; cf. Gujarātī samrā-vavuṃ; [] see samarcāpanīya, samāracana.", "gloss_language": "en"}]}], "samarapya": [{"id": "samarApya", "headword": "समराप्य", "headword_slp1": "samarApya", "fold": "samarapya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samarāpya (LP), ‘should be repaired’; cf. Gujarātī samrā-vatruṃ; also samāracana.", "gloss_language": "en"}]}], "samarcapana": [{"id": "samarcApana", "headword": "समर्चापन", "headword_slp1": "samarcApana", "fold": "samarcapana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samarcāpana (LP), repairing; cf. samarcāpanīya (LP), ‘to be got repaired’; cf. samarāpaṇīya; also samāracana.", "gloss_language": "en"}]}], "samasta": [{"id": "samasta", "headword": "समस्त", "headword_slp1": "samasta", "fold": "samasta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samasta (IE 8-1), corrupt form of saṃvat especially in medieval Orissan records.", "gloss_language": "en"}], "synonyms": ["समस्तं"], "synonyms_slp1": ["samastaM"]}], "samastamahasamantaDipati": [{"id": "samastamahAsAmantADipati", "headword": "समस्तमहासामन्ताधिपति", "headword_slp1": "samastamahAsAmantADipati", "fold": "samastamahasamantaDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samasta-mahāsāmant-ādhipati (BL), title of a feudatory ruler of the highest rank. See Mahāsāmant-ādhipati.", "gloss_language": "en"}]}], "samastasenaDipati": [{"id": "samastasenADipati", "headword": "समस्तसेनाधिपति", "headword_slp1": "samastasenADipati", "fold": "samastasenaDipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samasta-sen-ādhipati (EI 29, 30), ‘leader of all the forces’; commander-in-chief. See Sen-ādhipati, Senāpati, Maněya-samasta-sainy-ādhipati, etc.", "gloss_language": "en"}]}], "samastasuprasastyupeta": [{"id": "samastasupraSastyupeta", "headword": "समस्तसुप्रशस्त्युपेत", "headword_slp1": "samastasupraSastyupeta", "fold": "samastasuprasastyupeta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samasta-supraśasty-upeta (IE 8-2), a royal epithet.", "gloss_language": "en"}]}], "samastyetyadi": [{"id": "samastyetyAdi", "headword": "समस्त्येत्यादि", "headword_slp1": "samastyetyAdi", "fold": "samastyetyadi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samasty-ety-ādi (IE 8-2), shortened form of samasta-supra-śasty-upeta.", "gloss_language": "en"}]}], "samasyapuraRa": [{"id": "samasyApUraRa", "headword": "समस्यापूरण", "headword_slp1": "samasyApUraRa", "fold": "samasyapuraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samasyā-pūraṇa (CII 4), completion of incomplete verses.", "gloss_language": "en"}]}], "samat": [{"id": "samat", "headword": "समत्", "headword_slp1": "samat", "fold": "samat", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samat (IE 8-1), corrupt form of saṃvat.", "gloss_language": "en"}]}, {"id": "sammat", "headword": "सम्मत्", "headword_slp1": "sammat", "fold": "samat", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sammat (ASLV), same as samuta; an administrative unit.", "gloss_language": "en"}]}], "samata": [{"id": "samata", "headword": "समत", "headword_slp1": "samata", "fold": "samata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samata (IE 8-1), corrupt form of saṃvat.", "gloss_language": "en"}]}, {"id": "samatA", "headword": "समता", "headword_slp1": "samatA", "fold": "samata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samatā (CII 1), impartiality.", "gloss_language": "en"}]}, {"id": "samatta", "headword": "समत्त", "headword_slp1": "samatta", "fold": "samata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samatta (IE 8-1), corrupt form of saṃvat.", "gloss_language": "en"}]}], "samavada": [{"id": "sAmavAda", "headword": "सामवाद", "headword_slp1": "sAmavAda", "fold": "samavada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sāma-vāda, cf. Prakrit sama-vāyo (CII 1), found in a rock edict of Aśoka; ‘restrained speech’; same as saṃyama (i. e. vāk-saṃyama) found in one version; generally sama-vāyo is taken as samavāya or concord.", "gloss_language": "en"}], "synonyms": ["सामवादः"], "synonyms_slp1": ["sAmavAdaH"]}], "samavajika": [{"id": "sAmavAjika", "headword": "सामवाजिक", "headword_slp1": "sAmavAjika", "fold": "samavajika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmavājika (Ep. Ind., Vol. VI, p. 135, note 6), probably, an officer; cf. Sāmavāyika, Sāmavājin, Sāṃmavājin.", "gloss_language": "en"}]}], "samavajin": [{"id": "sAmavAjIn", "headword": "सामवाजीन्", "headword_slp1": "sAmavAjIn", "fold": "samavajin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmavājin (EI 6), probably, an officer; cf. Sāṃmavājin, Sāmavājika.", "gloss_language": "en"}]}], "samavasaraRa": [{"id": "samavasaraRa", "headword": "समवसरण", "headword_slp1": "samavasaraRa", "fold": "samavasaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samavasaraṇa (HA), congregation-hall believed to be built by celestials when a Tīrthaṅkara delivered his sermon.", "gloss_language": "en"}]}], "samavayika": [{"id": "sAmavAyika", "headword": "सामवायिक", "headword_slp1": "sAmavAyika", "fold": "samavayika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sāmavāyika (Ep. Ind., Vol. VI, p. 135, note 6), probably, an officer; cf. Sāmavājika.", "gloss_language": "en"}], "synonyms": ["सामवायिकः"], "synonyms_slp1": ["sAmavAyikaH"]}], "samaveta": [{"id": "samaveta", "headword": "समवेत", "headword_slp1": "samaveta", "fold": "samaveta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samaveta (IE 8-3), ‘associated’; generally explained as ‘assembled’; but see samupāgata, upeta, upayāta, etc.", "gloss_language": "en"}], "synonyms": ["समवेतः"], "synonyms_slp1": ["samavetaH"]}], "samaya": [{"id": "samaya", "headword": "समय", "headword_slp1": "samaya", "fold": "samaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samaya (EI 10), a religious system.\n (CITD), Telugu-Kannaḍa; a sect; an assemblage, a company or congregation; established moral or ceremonial custom; cf. samaiyam (EI 24), a creed.\n Cf. samaye (EI 19), used instead of varṣe in the dates after saṃvat.\n (SITI), a religious mendicant; cf. Samay-mudali, religious head.", "gloss_language": "en"}], "synonyms": ["समयः"], "synonyms_slp1": ["samayaH"]}], "samayacara": [{"id": "samayAcAra", "headword": "समयाचार", "headword_slp1": "samayAcAra", "fold": "samayacara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samay-ācāra (SITI), religious usage; established custom; supervision of the religious and social life of the people; censoring of public morals; also a class of officials called Samayācārya or Dāsari.", "gloss_language": "en"}], "synonyms": ["समयाचारः"], "synonyms_slp1": ["samayAcAraH"]}], "samayacarya": [{"id": "samayAcArya", "headword": "समयाचार्य", "headword_slp1": "samayAcArya", "fold": "samayacarya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Samayācārya (ASLV), also called Samayācāra; same as Dāśari; a censor of morals; a class of officials.", "gloss_language": "en"}]}], "samayaDarma": [{"id": "samayaDarma", "headword": "समयधर्म", "headword_slp1": "samayaDarma", "fold": "samayaDarma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "samaya-dharma (SITI), law of the samaya or agreement. The expression is generally used in relation to