{"asa": [{"id": "ASA", "headword": "आशा", "headword_slp1": "ASA", "fold": "asa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āśā (IE 7-1-2), ‘ten’.", "gloss_language": "en"}]}], "asamiya": [{"id": "asamIyA", "headword": "असमीया", "headword_slp1": "asamIyA", "fold": "asamiya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Asamīyā, see Assamese.", "gloss_language": "en"}]}], "asanpratipati": [{"id": "asaMpratipatti", "headword": "असंप्रतिपत्ति", "headword_slp1": "asaMpratipatti", "fold": "asanpratipati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "asaṃpratipatti (CII 1), unseemly behaviour.", "gloss_language": "en"}]}], "asana": [{"id": "Asana", "headword": "आसन", "headword_slp1": "Asana", "fold": "asana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āsana (IE 8-8), a seat.\n Cf. a-cār-āsana-carm-āṅgāra (IE 8-5; EI 15), probably, camping [of the royal officers in a village]; āsana-carma is sometimes taken as one expression meaning ‘a hide seat’.", "gloss_language": "en"}], "synonyms": ["आसनं", "आसनः"], "synonyms_slp1": ["AsanaM", "AsanaH"]}], "asanapawa": [{"id": "Asanapawwa", "headword": "आसनपट्ट", "headword_slp1": "Asanapawwa", "fold": "asanapawa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āsana-paṭṭa (EI 23, 24), a seat; a slab used as a seat.", "gloss_language": "en"}]}], "asanapiWika": [{"id": "AsanapIWikA", "headword": "आसनपीठिका", "headword_slp1": "AsanapIWikA", "fold": "asanapiWika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āsana-pīṭhikā (LL), a bench for sitting.", "gloss_language": "en"}]}], "asaRmasika": [{"id": "AzARmAsika", "headword": "आषाण्मासिक", "headword_slp1": "AzARmAsika", "fold": "asaRmasika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ā-ṣāṇmāsika (CII 1), ‘less than six months in age’.", "gloss_language": "en"}]}], "asapala": [{"id": "ASApAla", "headword": "आशापाल", "headword_slp1": "ASApAla", "fold": "asapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Āśāpāla (HD), ‘the guardian of the quarters’; a chief ruling over 10,000 villages, according to the Śukranītisāra, I. 192.", "gloss_language": "en"}], "synonyms": ["आशापालः"], "synonyms_slp1": ["ASApAlaH"]}], "asatana": [{"id": "aSAtanA", "headword": "अशातना", "headword_slp1": "aSAtanA", "fold": "asatana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "aśātanā (HA), Jain; disrespect or disobedience.", "gloss_language": "en"}]}], "asamese": [{"id": "assamese", "headword": "अस्समेसे", "headword_slp1": "assamese", "fold": "asamese", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Assamese, same as Asamīyā; language and alphabet of Assam, the alphabet being sometimes called Bengali-Assamese.", "gloss_language": "en"}]}], "asanarapravftivinivftacara": [{"id": "asannarapravfttivinivfttAcAra", "headword": "असन्नरप्रवृत्तिविनिवृत्ताचार", "headword_slp1": "asannarapravfttivinivfttAcAra", "fold": "asanarapravftivinivftacara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "asan-nara-pravṛtti-vinivṛtt-ācāra (Ind. Ant., Vol. XI p. 113, text lines 36-37), translated as ‘the established customs [of the gift land] are withheld from [injury by] the enterprise of wicked men.’", "gloss_language": "en"}]}]}