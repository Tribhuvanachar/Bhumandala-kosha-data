{"sala": [{"id": "SAlA", "headword": "शाला", "headword_slp1": "SAlA", "fold": "sala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śālā (EI 4; SII 1), a hall.\n (EI 4; SITI), a school; same as pāṭha-śālā.\n (SII 3), cf. śālai (EI 7; SITI), an alms-house; a feeding house; cf. śālā-bhoga.\n Cf. śālai (EI 24), a hospital; cf. ārogya-śālā, ātura-śālā.", "gloss_language": "en"}]}], "salaBoga": [{"id": "SAlABoga", "headword": "शालाभोग", "headword_slp1": "SAlABoga", "fold": "salaBoga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śālā-bhoga (SII 2; SII), same as Tamil arac-cālā-bhogam; land granted in favour of a feeding house (sattra-śālā). (EI 23), mentioned along with devadāna and brahmadeya; a rent-free holding in the possession of a śālā meaning an almshouse or a school.", "gloss_language": "en"}]}], "salaka": [{"id": "SalAkA", "headword": "शलाका", "headword_slp1": "SalAkA", "fold": "salaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śalākā, cf. śalāgai (SITI), name of a coin also called palañ-śalāgai (accu) and śrīyakki-palañśalāgai.", "gloss_language": "en"}, {"gloss": "śalākā , same as Tamil śalāgai.", "gloss_language": "en"}]}], "salasTanamuKya": [{"id": "SAlAsTAnamuKya", "headword": "शालास्थानमुख्य", "headword_slp1": "SAlAsTAnamuKya", "fold": "salasTanamuKya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śālāsthāna-mukhya (EI 32), probably, officer in charge of the stables.", "gloss_language": "en"}]}], "salawa": [{"id": "salAwa", "headword": "सलाट", "headword_slp1": "salAwa", "fold": "salawa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Salāṭa (PJS), Gujarātī; also called Salāvaṭa; a stone-cutter or mason.", "gloss_language": "en"}]}], "salavi": [{"id": "sAlavI", "headword": "सालवी", "headword_slp1": "sAlavI", "fold": "salavi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sālavī (LP), Gujarātī; a weaver.\n (PJS), Gujarātī; a carpenter.", "gloss_language": "en"}]}], "salina": [{"id": "SAlIna", "headword": "शालीन", "headword_slp1": "SAlIna", "fold": "salina", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śālīna (CII 4), a kind of householder.", "gloss_language": "en"}], "synonyms": ["शालीनः"], "synonyms_slp1": ["SAlInaH"]}], "salilapurvaka": [{"id": "salilapUrvaka", "headword": "सलिलपूर्वक", "headword_slp1": "salilapUrvaka", "fold": "salilapurvaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "salila-pūrvaka (IA 9), same as udaka-pūrvam, etc.", "gloss_language": "en"}]}], "saleKana": [{"id": "salleKanA", "headword": "सल्लेखना", "headword_slp1": "salleKanA", "fold": "saleKana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sallekhanā (EI 3, 6; SITI), Jain; a religious practice of the Jains; starving oneself to death; starving oneself to death in fulfilment of a vow; same as samādhi.", "gloss_language": "en"}]}], "salohita": [{"id": "salohita", "headword": "सलोहित", "headword_slp1": "salohita", "fold": "salohita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sa-lohita (Ep. Ind., Vol. XIV, p. 295), ‘one having the same blood’; a relation.", "gloss_language": "en"}]}], "salyatraya": [{"id": "Salyatraya", "headword": "शल्यत्रय", "headword_slp1": "Salyatraya", "fold": "salyatraya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śalya-traya (SII 1), the three thorns.", "gloss_language": "en"}]}], "salavaRa": [{"id": "salavaRa", "headword": "सलवण", "headword_slp1": "salavaRa", "fold": "salavaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-lavaṇa (EI 12), ‘together with salt (i. e. the right to enjoy salt produced in the land). Cf. a-lavaṇa-khātaka, etc.", "gloss_language": "en"}]}], "salavaRakara": [{"id": "salavaRAkara", "headword": "सलवणाकर", "headword_slp1": "salavaRAkara", "fold": "salavaRakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-lavaṇ-ākara (EI 12), ‘together with the salt pits’. Cf. a-lavaṇa-khātaka, etc.", "gloss_language": "en"}]}], "salohadyakara": [{"id": "salohAdyAkara", "headword": "सलोहाद्याकर", "headword_slp1": "salohAdyAkara", "fold": "salohadyakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-loh-ādy-ākara , together with the mines of metals, etc.’; epithet of gift village. Cf. Ind. Ep., p. 395.", "gloss_language": "en"}]}], "salohalavaRakara": [{"id": "salohalavaRAkara", "headword": "सलोहलवणाकर", "headword_slp1": "salohalavaRAkara", "fold": "salohalavaRakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-loha-lavaṇ-ākara (EI 23, 26), ‘together with the mines and salt-pits’, epithet of gift land. Cf. sa-loh-ādy-ākara, a-lavaṇa-khātaka, etc.", "gloss_language": "en"}]}], "salagE": [{"id": "SalAgE", "headword": "शलागै", "headword_slp1": "SalAgE", "fold": "salagE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śalāgai , Tamil; name of a coin also called pal̤añśalāgai (accu); probably had the shape of a śalākā.", "gloss_language": "en"}]}]}