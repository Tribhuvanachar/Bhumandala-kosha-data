{"saka": [{"id": "Saka", "headword": "शक", "headword_slp1": "Saka", "fold": "saka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śaka (EI 24), originally, the Scythians; later any foreigners including Muhammadans; used to indicate the Musalmans (Ep. Ind., Vol. XII, p. 44; Bhandatkar's List, No. 926).", "gloss_language": "en"}, {"gloss": "śaka, śāka (IA 9, 19), used in the sense of ‘a year’ or ‘an era’; cf. Vikrama-śaka (IA 18).", "gloss_language": "en"}], "synonyms": ["शकः"], "synonyms_slp1": ["SakaH"]}, {"id": "SAka", "headword": "शाक", "headword_slp1": "SAka", "fold": "saka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śāka, cf. a-harītaka-śāka-puṣpa-grahaṇa (EI 8-5); vegetables which the villagers were obliged to supply to the king or landlord on occasions or to the touring officers. Cf. śāka-śaka.", "gloss_language": "en"}], "synonyms": ["शाकं", "शाकः"], "synonyms_slp1": ["SAkaM", "SAkaH"]}, {"id": "sAkA", "headword": "साका", "headword_slp1": "sAkA", "fold": "saka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sākā (IA 29), Rājasthānī; same as jauhar or javhar.", "gloss_language": "en"}]}], "sakamBarividya": [{"id": "SAkamBarIvidyA", "headword": "शाकम्भरीविद्या", "headword_slp1": "SAkamBarIvidyA", "fold": "sakamBarividya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śākambharī-vidyā (EI 29; CII 4), name of a science, the nature of which is uncertain.", "gloss_language": "en"}]}], "sakanika": [{"id": "SakAnikA", "headword": "शकानिका", "headword_slp1": "SakAnikA", "fold": "sakanika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śakānikā (CII 4), a Śaka woman. Cf. anikā.", "gloss_language": "en"}]}], "sakapaRika": [{"id": "SAkapaRikA", "headword": "शाकपणिका", "headword_slp1": "SAkapaRikA", "fold": "sakapaRika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śāka-paṇikā, cf. śāka-paṇikā-nyāyena (LP), ‘like vegetables in a market’.", "gloss_language": "en"}]}], "sakarukara": [{"id": "sakarukara", "headword": "सकरुकर", "headword_slp1": "sakarukara", "fold": "sakarukara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sakarukara, occurs in a Śātavāhana inscription probably for [] Sanskrit sa-kar-otkara meaning the same thing as s-odraṅga-s-oparikara, ‘with the udraṅga (kara) and uparikara (utkara) taxes’; may also be sa-kārukara. See kāru-kara.", "gloss_language": "en"}]}], "sakra": [{"id": "Sakra", "headword": "शक्र", "headword_slp1": "Sakra", "fold": "sakra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakra (IE 7-1-2), ‘fourteen’.", "gloss_language": "en"}], "synonyms": ["शक्रः"], "synonyms_slp1": ["SakraH"]}], "sakraDvaja": [{"id": "SakraDvaja", "headword": "शक्रध्वज", "headword_slp1": "SakraDvaja", "fold": "sakraDvaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakra-dhvaja, cf. indra-daṇḍa.", "gloss_language": "en"}], "synonyms": ["शक्रध्वजः"], "synonyms_slp1": ["SakraDvajaH"]}], "sakrayajYa": [{"id": "SakrayajYa", "headword": "शक्रयज्ञ", "headword_slp1": "SakrayajYa", "fold": "sakrayajYa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakra-yajña (IE 7-1-2), ‘one hundred’.", "gloss_language": "en"}]}], "sakrotTana": [{"id": "SakrotTAna", "headword": "शक्रोत्थान", "headword_slp1": "SakrotTAna", "fold": "sakrotTana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakr-otthāna (EI 32), a festival, same as śakradhvaj-otthāna. Cf. śakra-dhvaja, indra-daṇḍa.", "gloss_language": "en"}], "synonyms": ["शक्रोत्थानं"], "synonyms_slp1": ["SakrotTAnaM"]}], "saksin": [{"id": "sAkzin", "headword": "साक्षिन्", "headword_slp1": "sAkzin", "fold": "saksin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Sākṣin (EI 3, 23; SITI), a witness; an eye-witness.", "gloss_language": "en"}]}], "saksiRaramBa": [{"id": "sakzIRAramBa", "headword": "सक्षीणारम्भ", "headword_slp1": "sakzIRAramBa", "fold": "saksiRaramBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-kṣīṇ-ārambha (CII 1), gentle in action.", "gloss_language": "en"}]}], "sakta": [{"id": "sakta", "headword": "सक्त", "headword_slp1": "sakta", "fold": "sakta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sakta (LP), written for satka, ‘belonging to’.", "gloss_language": "en"}], "synonyms": ["सक्तः"], "synonyms_slp1": ["saktaH"]}], "sakti": [{"id": "Sakti", "headword": "शक्ति", "headword_slp1": "Sakti", "fold": "sakti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śakti (EI 17), name of the wife of Kāmadeva.", "gloss_language": "en"}, {"gloss": "śakti (IE 7-1-2; EI 25), ‘three’; three in number (EI 6).", "gloss_language": "en"}], "synonyms": ["शक्तिः"], "synonyms_slp1": ["SaktiH"]}], "saktimuKa": [{"id": "SaktimuKa", "headword": "शक्तिमुख", "headword_slp1": "SaktimuKa", "fold": "saktimuKa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakti-mukha, (SITI), cf. śatti-mugam; king's order; probably the same as śrīmukha.", "gloss_language": "en"}]}], "saktitraya": [{"id": "Saktitraya", "headword": "शक्तित्रय", "headword_slp1": "Saktitraya", "fold": "saktitraya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakti-traya (SII 1), the three [regal] powers.", "gloss_language": "en"}]}], "sakya": [{"id": "SAkya", "headword": "शाक्य", "headword_slp1": "SAkya", "fold": "sakya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śākya (CII 1), a Buddhist; see Śākya-bhikṣu.", "gloss_language": "en"}], "synonyms": ["शाक्यः"], "synonyms_slp1": ["SAkyaH"]}], "sakyaBiksu": [{"id": "SAkyaBikzu", "headword": "शाक्यभिक्षु", "headword_slp1": "SAkyaBikzu", "fold": "sakyaBiksu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śākya-bhikṣu (BL; LL), epithet of a Buddhist monk; same as Śākya.", "gloss_language": "en"}], "synonyms": ["शाक्यभिक्षुः"], "synonyms_slp1": ["SAkyaBikzuH"]}], "sakyopasika": [{"id": "SAkyopAsikA", "headword": "शाक्योपासिका", "headword_slp1": "SAkyopAsikA", "fold": "sakyopasika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śāky-opāsikā (LL), a female member of the Buddhist laity.", "gloss_language": "en"}]}], "sakarotkara": [{"id": "sakarotkara", "headword": "सकरोत्कर", "headword_slp1": "sakarotkara", "fold": "sakarotkara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-kar-otkara = Prakrit sa-kar-ukara (EI 7); refers to a piece of land granted with the donee's right to enjoy major and minor taxes; cf. s-odraṅga-s-oparikara and sa-kḷpt-opakḷpta, etc. See kar-otkara as noticed separately above; also cf. kāru-kara.", "gloss_language": "en"}]}], "sakxpta": [{"id": "sakxpta", "headword": "सकॢप्त", "headword_slp1": "sakxpta", "fold": "sakxpta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-kḷpta (EI 24), ‘together with the tax on permanent tenants or the fixed revenue’; same as s-odraṅga.", "gloss_language": "en"}]}], "sakxptopakxptaka": [{"id": "sakxptopakxptaka", "headword": "सकॢप्तोपकॢप्तक", "headword_slp1": "sakxptopakxptaka", "fold": "sakxptopakxptaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-kḷpt-opakḷptaka (EI 24, 27), refers to the freedom of the gift land from the payment of fixed taxes on permanent tenants as well as occasional^1 taxes or taxes on temporary tenants; same as s-odraṅga-s-oparikara.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "sakftapranta": [{"id": "sakftaprAnta", "headword": "सकृतप्रान्त", "headword_slp1": "sakftaprAnta", "fold": "sakftapranta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "sa-kṛta-prānta , cf. Prakrit sa-kutu-ppanta (EI 26), ‘together with the demarcated boundaries’; epithet of the gift land.", "gloss_language": "en"}]}], "sakarakaRikE": [{"id": "SakkarakkARikkE", "headword": "शक्करक्काणिक्कै", "headword_slp1": "SakkarakkARikkE", "fold": "sakarakaRikE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śakkara-kkāṇikkai (SITI), Tamil; tax on potters; also known as tirigai-āyam; cf. kuśa-kkāṇam.", "gloss_language": "en"}]}]}