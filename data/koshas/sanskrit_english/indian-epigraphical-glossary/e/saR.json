{"saRa": [{"id": "SaRa", "headword": "शण", "headword_slp1": "SaRa", "fold": "saRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śaṇa (LP), linen.", "gloss_language": "en"}], "synonyms": ["शणं", "शणः"], "synonyms_slp1": ["SaRaM", "SaRaH"]}, {"id": "SARa", "headword": "शाण", "headword_slp1": "SARa", "fold": "saRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śāṇa, name of a weight or coin; a silver coin which was (1/8) of a śatamāna in weight and value; generally regarded as 40 ratis in weight, but sometimes also as 32 or 24 or 20 ratis; also called niṣka, ṭaṅka or dharaṇa or śānaka. See JNSI, Vol. XVI, pp. 42, 44-45. See śāna-pāda.", "gloss_language": "en"}, {"gloss": "śāṇa , name of a weight or a coin 40 ratis in weight; equal to 4 māṣas; sometimes regarded as 32 ratis and called niṣka and ṭaṅka; rarely also regarded as equal to 24 or 20 ratis.", "gloss_language": "en"}], "synonyms": ["शाणं", "शाणः"], "synonyms_slp1": ["SARaM", "SARaH"]}], "saRqa": [{"id": "zaRqa", "headword": "षण्ड", "headword_slp1": "zaRqa", "fold": "saRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ṣaṇḍa (IA 18), a bull living or wandering at liberty.", "gloss_language": "en"}], "synonyms": ["षंड", "षंडः", "षण्डः"], "synonyms_slp1": ["zaMqa", "zaMqaH", "zaRqaH"]}], "saRqagula": [{"id": "zaRqagula", "headword": "षण्डगुल", "headword_slp1": "zaRqagula", "fold": "saRqagula", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ṣaṇḍa-gula (LP), same as Gujarātī khāṃḍ-gol, i. e. sugar and molasses.", "gloss_language": "en"}]}], "saRmuKabahu": [{"id": "zaRmuKabAhu", "headword": "षण्मुखबाहु", "headword_slp1": "zaRmuKabAhu", "fold": "saRmuKabahu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ṣaṇmukha-bāhu (IE 7-1-2), ‘twelve’.", "gloss_language": "en"}]}], "saRqalaperu": [{"id": "Sa