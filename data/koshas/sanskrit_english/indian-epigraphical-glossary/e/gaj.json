{"gaja": [{"id": "gaja", "headword": "गज", "headword_slp1": "gaja", "fold": "gaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gaja (IE 7-1-2), ‘eight’.", "gloss_language": "en"}], "synonyms": ["गजः"], "synonyms_slp1": ["gajaH"]}], "gajaDara": [{"id": "gajaDara", "headword": "गजधर", "headword_slp1": "gajaDara", "fold": "gajaDara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gajadhara (EI 4), same as Sūtradhara or Sūtradhāra, ‘mason’.", "gloss_language": "en"}]}], "gajaDisa": [{"id": "gajADISa", "headword": "गजाधीश", "headword_slp1": "gajADISa", "fold": "gajaDisa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gajādhīśa (CII 4), ‘the lord of elephants’; official designation; title of certain rulers. Cf. Gajapati, etc.", "gloss_language": "en"}]}], "gajalaksmi": [{"id": "gajalakzmI", "headword": "गजलक्ष्मी", "headword_slp1": "gajalakzmI", "fold": "gajalaksmi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gajalakṣmī (EI 32), representation of Lakṣmī receiving water on the head from a jar held in the trunk of an elephant on either side; found on the seals of certain rulers.", "gloss_language": "en"}]}], "gajamala": [{"id": "gajamAla", "headword": "गजमाल", "headword_slp1": "gajamAla", "fold": "gajamala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "gajamāla (HA), row of elephants in the plinth of shrines; also called gajathara.", "gloss_language": "en"}]}], "gajamfgayavihara": [{"id": "gajamfgayAvihAra", "headword": "गजमृगयाविहार", "headword_slp1": "gajamfgayAvihAra", "fold": "gajamfgayavihara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Gaja-mṛgayā-vihāra (ASLV), ‘sportful hunting of elephants’; a title of the Vijayanagara kings.", "gloss_language": "en"}]}], "gajapati": [{"id": "gajapati", "hea