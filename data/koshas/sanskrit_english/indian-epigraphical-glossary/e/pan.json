{"pan": [{"id": "paM", "headword": "पं", "headword_slp1": "paM", "fold": "pan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Paṃ (IE 8-1; PJS), abbreviation of Paṇḍita.\n (PJS), abbreviation of Paṃnyāsa.", "gloss_language": "en"}], "synonyms": ["प", "पः"], "synonyms_slp1": ["pa", "paH"]}], "paniyaBajana": [{"id": "pAnIyaBAjana", "headword": "पानीयभाजन", "headword_slp1": "pAnIyaBAjana", "fold": "paniyaBajana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pānīya-bhājana (LL), a water-cistern.", "gloss_language": "en"}]}], "paniyaCayamaRqapa": [{"id": "pAnIyaCAyAmaRqapa", "headword": "पानीयछायामण्डप", "headword_slp1": "pAnIyaCAyAmaRqapa", "fold": "paniyaCayamaRqapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pānīya-chāyā-maṇḍapa (EI 28), probably, a shaded hall cooled by water.", "gloss_language": "en"}]}], "paniyagarika": [{"id": "pAnIyAgArika", "headword": "पानीयागारिक", "headword_slp1": "pAnIyAgArika", "fold": "paniyagarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pānīyāgārika (IE 8-3), superintendent of the water-chamber. See Pānīyagṛhika.", "gloss_language": "en"}]}], "paniyagrahin": [{"id": "pAnIyagrAhin", "headword": "पानीयग्राहिन्", "headword_slp1": "pAnIyagrAhin", "fold": "paniyagrahin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pānīya-grāhin (EI 31), ‘one who receives ceremonial water as the donee of a gift’; recipient of a grant. See Pāṇigrāhin.", "gloss_language": "en"}]}], "paniyagfhika": [{"id": "pAnIyagfhika", "headword": "पानीयगृहिक", "headword_slp1": "pAnIyagfhika", "fold": "paniyagfhika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pānīyagṛhika (LL), superintendent of a water-house. Cf. Pānīyāgārika.", "gloss_language": "en"}]}], "paniyaka": [{"id": "pAnIyaka", "headword": "पानीयक", "headword_slp1": "pAnIyaka", "fold": "paniyaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pānīyaka (LL), a cistern.", "gloss_language": "en"}]}], "panasa": [{"id": "pannasa", "headword": "पन्नस", "headword_slp1": "pannasa", "fold": "panasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pannasa, also spelt pannāsa, pannāsu (IE 8-6; EI 5, 12; Ep. Ind., Vol. XV, p. 336, note 3), Kannaḍa; probably derived from Sanskrit pañchāśat in the sense of a tenure in which the donee enjoyed fifty per cent of the revenue of the donated land. Cf. pannavīsa. (EI 20), explained as ‘a gift’.", "gloss_language": "en"}]}, {"id": "pannAsa", "headword": "पन्नास", "headword_slp1": "pannAsa", "fold": "panasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pannāsa (EI 30; IA 11), Kannaḍa; same as pannasa (q. v.).", "gloss_language": "en"}]}], "panasu": [{"id": "pannAsu", "headword": "पन्नासु", "headword_slp1": "pannAsu", "fold": "panasu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pannāsu (IA 10), Kannaḍa; same as pannasa (q. v.).", "gloss_language": "en"}]}], "panavisa": [{"id": "pannavIsa", "headword": "पन्नवीस", "headword_slp1": "pannavIsa", "fold": "panavisa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pannavīsa (A. R. Ep., 1958-59, No. B. 17), Kannaḍa; Sanskrit pañcaviṃśati; probably a tenure in which the donee enjoyed twentyfive per cent of the revenue of the donated land. Cf. pannāsa, etc.", "gloss_language": "en"}]}], "panaya": [{"id": "pannAya", "headword": "पन्नाय", "headword_slp1": "pannAya", "fold": "panaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pannāya (IE 8-5; EI 27), Kannaḍa, name of a tax; cf. pannāsa.", "gloss_language": "en"}, {"gloss": "pannāya (IE 8-5; EI 27), Kannaḍa; name of a tax.", "gloss_language": "en"}]}], "panayadasuNkavergaqe": [{"id": "pannAyadasuNkavergaqe", "headword": "पन्नायदसुङ्कवेर्गडे", "headword_slp1": "pannAyadasuNkavergaqe", "fold": "panayadasuNkavergaqe", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Pannāyadasuṅkavěrgaḍě (SII 11-2), Kannaḍa; official designation.", "gloss_language": "en"}]}], "panTasala": [{"id": "pAnTaSAlA", "headword": "पान्थशाला", "headword_slp1": "pAnTaSAlA", "fold": "panTasala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "pāntha-śālā (CII 4), a sarāi.", "gloss_language": "en"}]}]}