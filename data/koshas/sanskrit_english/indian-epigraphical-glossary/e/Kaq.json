{"Kaqgagraha": [{"id": "KaqgagrAha", "headword": "खड्गग्राह", "headword_slp1": "KaqgagrAha", "fold": "Kaqgagraha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Khaḍgagrāha (IE 8-3; EI 30), probably the same as Khāḍgika; swordsman; sometimes distinguished from Khaṇḍapāla.", "gloss_language": "en"}]}], "Kaqgagrahimahapatra": [{"id": "KaqgagrAhimahApAtra", "headword": "खड्गग्राहिमहापात्र", "headword_slp1": "KaqgagrAhimahApAtra", "fold": "Kaqgagrahimahapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Khaḍgagrāhi-mahāpātra (EI 28, 31), official designation in which Khaḍgagrāhin seems to indicate an officer in charge of swordsmen (as opposed to the clubmen); see Mahāpātra.", "gloss_language": "en"}]}], "Kaqgagrahin": [{"id": "KaqgagrAhin", "headword": "खड्गग्राहिन्", "headword_slp1": "KaqgagrAhin", "fold": "Kaqgagrahin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Khaḍga-grāhin (EI 28), same as the Khaṇḍāita (originally, swordsmen of the kings of Orissa); cf. Khaḍgagrāha.", "gloss_language": "en"}]}], "Kaqgaraksa": [{"id": "Kaqgarakza", "headword": "खड्गरक्ष", "headword_slp1": "Kaqgarakza", "fold": "Kaqgaraksa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Khaḍga-rakṣa (EI 30), same as Khaḍga-grāha; used in place of Aṅgarakṣa and Khaṇḍarakṣa of some records (Ind. Ant., Vol. XVII, p. 11, text line 14); probably, the king's bodyguards.", "gloss_language": "en"}]}], "Kaqgika": [{"id": "KAqgika", "headword": "खाड्गिक", "headword_slp1": "KAqgika", "fold": "Kaqgika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Khāḍgika (IE 8-3), ‘swordsman’; probably ‘a palace-guard’; mentioned separately from Khaṇḍarakṣa which is also spelt Khaḍgarakṣa.", "gloss_language": "en"}]}], "Kaqgin": [{"id": "KAqgin", "headword": "खाड्गिन्", "headword_slp1": "KAqgin", "