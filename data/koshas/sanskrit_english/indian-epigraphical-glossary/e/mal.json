{"mala": [{"id": "mAla", "headword": "माल", "headword_slp1": "mAla", "fold": "mala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "māla (EI 22), an elevated ground.", "gloss_language": "en"}], "synonyms": ["मालं", "मालः"], "synonyms_slp1": ["mAlaM", "mAlaH"]}, {"id": "malla", "headword": "मल्ल", "headword_slp1": "malla", "fold": "mala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Malla (CII 4), a wrestler, a match.", "gloss_language": "en"}], "synonyms": ["मल्लः"], "synonyms_slp1": ["mallaH"]}], "malaDari": [{"id": "malaDAri", "headword": "मलधारि", "headword_slp1": "malaDAri", "fold": "malaDari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Maladhāri (BL), epithet of a Jain religious teacher.", "gloss_language": "en"}]}], "malakara": [{"id": "mAlAkAra", "headword": "मालाकार", "headword_slp1": "mAlAkAra", "fold": "malakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mālākāra (LL), a florist. See Mālin.", "gloss_language": "en"}], "synonyms": ["मालाकारः"], "synonyms_slp1": ["mAlAkAraH"]}, {"id": "mallakara", "headword": "मल्लकर", "headword_slp1": "mallakara", "fold": "malakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "malla-kara (HRS), found in Nepal inscriptions; tax levied as tribute to the Mallas or for defence against their attack. Cf. turuṣka-daṇḍa, etc. It may also be a professional tax on wrestlers.", "gloss_language": "en"}]}], "malamargaRa": [{"id": "malamArgaRa", "headword": "मलमार्गण", "headword_slp1": "malamArgaRa", "fold": "malamargaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "malamārgaṇa (LL), cf. Gujarātī mal̤avero; a tax to be utilised when the whole village wants to honour a particular man.", "gloss_language": "en"}]}], "malavagaRamnata": [{"id": "mAlavagaRAmnAta", "headword": "मालवगणाम्नात", "headword_slp1": "mAlavagaRAmnAta", "fold": "malavagaRamnata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mālava-gaṇ-āmnāta, Mālava-gaṇa-sthiti, Mālava-pūrvā (EI 23), expressions used in early records in connection with the Vikrama-saṃvat.", "gloss_language": "en"}]}], "malavi": [{"id": "mAlavI", "headword": "मालवी", "headword_slp1": "mAlavI", "fold": "malavi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mālavī, dialect of Hindī prevalent in Mālava (Malwa).", "gloss_language": "en"}]}], "malaviya": [{"id": "mAlavIya", "headword": "मालवीय", "headword_slp1": "mAlavIya", "fold": "malaviya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mālavīya (EI 22), ‘the king of Mālava’.", "gloss_language": "en"}]}], "malaya": [{"id": "malaya", "headword": "मलय", "headword_slp1": "malaya", "fold": "malaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "malaya (IA 14), derived from Dravidian malai, ‘a hill’.", "gloss_language": "en"}], "synonyms": ["मलयः"], "synonyms_slp1": ["malayaH"]}], "malayalam": [{"id": "malayAlam", "headword": "मलयालम्", "headword_slp1": "malayAlam", "fold": "malayalam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Malayāl̤am, name of a language and alphabet.", "gloss_language": "en"}]}], "maleyasahaRi": [{"id": "maleyasAhaRi", "headword": "मलेयसाहणि", "headword_slp1": "maleyasAhaRi", "fold": "maleyasahaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Maleya-sāhaṇi (Naik's List, No. 264); mentioned alongwith Peyiya-sāhaṇi; official designation. See Sāhaṇi.", "gloss_language": "en"}]}], "malima": [{"id": "mAlima", "headword": "मालिम", "headword_slp1": "mAlima", "fold": "malima", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mālima, same as Arabic Mualim, ‘an instructor’ (Ep. Ind., Vol. XXXIV, p. 144).", "gloss_language": "en"}]}], "malaka": [{"id": "mallaka", "headword": "मल्लक", "headword_slp1": "mallaka", "fold": "malaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mallaka (EI 21) a measure.", "gloss_language": "en"}], "synonyms": ["मल्लकः"], "synonyms_slp1": ["mallakaH"]}], "malakavunDaka": [{"id": "mallakavunDaka", "headword": "मल्लकवुन्धक", "headword_slp1": "mallakavunDaka", "fold": "malakavunDaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mallaka-vundhaka, cf. talabhedyā-ghāṇaka-mallaka-vundhaka (IA 18); probably, a professional tax on wrestlers.", "gloss_language": "en"}]}], "malik": [{"id": "malik", "headword": "मलिक्", "headword_slp1": "malik", "fold": "malik", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Malik, Malika (EI 4; BL), Muslim title of nobility; same as Arabic Malik; also spelt in Indian languages as Mallika.", "gloss_language": "en"}]}], "malin": [{"id": "mAlin", "headword": "मालिन्", "headword_slp1": "mAlin", "fold": "malin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Mālin (EI 9), a florist. See Mālākāra.", "gloss_language": "en"}]}], "malayimaGamE": [{"id": "mallAyimaGamE", "headword": "मल्लायिमघमै", "headword_slp1": "mallAyimaGamE", "fold": "malayimaGamE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "mallāyi-maghamai (SITI), Tamil; probably a customary collection in the market.", "gloss_language": "en"}]}], "malanandimaqa": [{"id": "mallanandimAqa", "headword": "मल्लनन्दिमाड", "headword_slp1": "mallanandimAqa", "fold": "malanandimaqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "malla-nandi-māḍa , probably, ‘māḍa bearing the figure of a wrestler and a bull’, or ‘māḍa minted 