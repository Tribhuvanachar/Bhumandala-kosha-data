{"cara": [{"id": "cara", "headword": "चर", "headword_slp1": "cara", "fold": "cara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Cara (CII 4), a spy.", "gloss_language": "en"}], "synonyms": ["चरः"], "synonyms_slp1": ["caraH"]}, {"id": "cAra", "headword": "चार", "headword_slp1": "cAra", "fold": "cara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Cāra (IE 8-3; EI 26), a spy; same as Cara; sometimes used in place of Cāṭa.\n (EI 15), cf. a-cār-āsana-carm-āṅgāra (IE 8-5), probably, passage [of royal officers through a village]; cf. also a-pār-āsana-carm-āṅgāra [] with pāra (probably, ferrying) instead of cāra.", "gloss_language": "en"}], "synonyms": ["चारं", "चारः"], "synonyms_slp1": ["cAraM", "cAraH"]}], "carabalivarda": [{"id": "carabalIvarda", "headword": "चरबलीवर्द", "headword_slp1": "carabalIvarda", "fold": "carabalivarda", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "cara-balīvarda (IE 8-5), cf. vara-balīvarda.", "gloss_language": "en"}]}], "caraRa": [{"id": "caraRa", "headword": "चरण", "headword_slp1": "caraRa", "fold": "caraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "caraṇa (CII 4; IA 18, 20), a Vedic school; a sect or school studying a particular śākhā of the Vedas; e. g. Taittirīya-caraṇa.\n (CII 1), same as ācaraṇa; cf. dharma-caraṇa for dharm-ācaraṇa.", "gloss_language": "en"}], "synonyms": ["चरणं", "चरणः"], "synonyms_slp1": ["caraRaM", "caraRaH"]}, {"id": "cAraRa", "headword": "चारण", "headword_slp1": "cAraRa", "fold": "caraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Cāraṇa (EI 3), same as Vidyā-cāraṇa, a Jain monk endowed with magical powers.\n Cf. harita-pakva-sasy-ekṣu-cāraṇa-lavaṇ-opamardana (IE 8-5); grazing of cattle.", "gloss_language": "en"}], "synonyms": ["चारणः"], "synonyms_slp1": ["cAraRaH"]}], "caraRqi": [{"id": "caraRqi", "headword": "चरण्डि", "headword_slp1": "caraRqi", "fold": "caraRqi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "caraṇḍi (EI 31), Gujarātī; a narrow passage of water.", "gloss_language": "en"}]}], "cari": [{"id": "carI", "headword": "चरी", "headword_slp1": "carI", "fold": "cari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "carī (EI 33), pasture land; same as carī-kṣetra.\n (EI 21), grazing tax; grazing land. Cf. cārī.", "gloss_language": "en"}]}, {"id": "cArI", "headword": "चारी", "headword_slp1": "cArI", "fold": "cari", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "cārī (LP), Gujarātī cāro, grass; probably, pasture land; cf. carī.\n (CII 4), grazing tax.", "gloss_language": "en"}]}], "carmakara": [{"id": "carmakAra", "headword": "चर्मकार", "headword_slp1": "carmakAra", "fold": "carmakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Carmakāra (EI 32), a shoe-maker.", "gloss_language": "en"}], "synonyms": ["चर्मकारः", "चर्म्मकार", "चर्म्मकारः"], "synonyms_slp1": ["carmakAraH", "carmmakAra", "carmmakAraH"]}], "carman": [{"id": "carman", "headword": "चर्मन्", "headword_slp1": "carman", "fold": "carman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "carman (EI 15), cf. a-carm-āṅgāraka (IE 8-5); hide-seat which the villagers were obliged to supply to the touring officers of the king.", "gloss_language": "en"}], "synonyms": ["चर्म्मन्"], "synonyms_slp1": ["carmman"]}], "caru": [{"id": "caru", "headword": "चरु", "headword_slp1": "caru", "fold": "caru", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "caru (EI 10, 22, 23; CII 3, 4), an offering to the manes; one of the five mahāyajñas.", "gloss_language": "en"}], "synonyms": ["चरुः"], "synonyms_slp1": ["caruH"]}], "caruka": [{"id": "caruka", "headword": "चरुक", "headword_slp1": "caruka", "fold": "caruka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "caruka (EI 1), same as caru, one of the five mahāyajñas.", "gloss_language": "en"}]}], "carya": [{"id": "caryA", "headword": "चर्या", "headword_slp1": "caryA", "fold": "carya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "caryā (CII 4), discipline in Śaivite practices.", "gloss_language": "en"}], "synonyms": ["चर्य्या"], "synonyms_slp1": ["caryyA"]}], "carsam": [{"id": "carsam", "headword": "चर्सम्", "headword_slp1": "carsam", "fold": "carsam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "carsam (karṣa ?) , equal to 4 māḍas; see māḍa.", "gloss_language": "en"}]}]}