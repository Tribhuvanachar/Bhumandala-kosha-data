{"vikara": [{"id": "vikara", "headword": "विकर", "headword_slp1": "vikara", "fold": "vikara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vikara, cf. vikara-padāni (LP), a small present, a bonus; cf. Gujarātī pān-sopārī.\n (LP), cf. vikara-pada explained as ‘miscellancous expenses’.", "gloss_language": "en"}], "synonyms": ["विकरः"], "synonyms_slp1": ["vikaraH"]}], "vikaraRapawaka": [{"id": "vikaraRapawwaka", "headword": "विकरणपट्टक", "headword_slp1": "vikaraRapawwaka", "fold": "vikaraRapawaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vikaraṇa-paṭṭaka (LP), a merket-tax contract.", "gloss_language": "en"}]}], "vikramaditya": [{"id": "vikramAditya", "headword": "विक्रमादित्य", "headword_slp1": "vikramAditya", "fold": "vikramaditya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vikramāditya (IE 8-2), see āditya.", "gloss_language": "en"}], "synonyms": ["विक्रमादित्यः"], "synonyms_slp1": ["vikramAdityaH"]}], "vikfti": [{"id": "vikfti", "headword": "विकृति", "headword_slp1": "vikfti", "fold": "vikfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vikṛti (IE 7-1-2), ‘twentythree’.", "gloss_language": "en"}], "synonyms": ["विकृतिः"], "synonyms_slp1": ["vikftiH"]}], "viksepa": [{"id": "vikzepa", "headword": "विक्षेप", "headword_slp1": "vikzepa", "fold": "viksepa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vikṣepa (IA 7, 13), cf. vijaya-vikṣepa used as an epithet of the place whence a royal charter was issued; cf. vijaya-vikṣepāt Bha-rukaccha-vāsakāt; wrongly interpreted as ‘a camp or cantonment’ (IA 17). See also Vaikṣepika.", "gloss_language": "en"}], "synonyms": ["विक्षेपः"], "synonyms_slp1": ["vikzepaH"]}]}