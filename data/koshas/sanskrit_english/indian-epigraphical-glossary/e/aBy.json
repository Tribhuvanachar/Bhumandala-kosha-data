{"aByaNga": [{"id": "aByaNga", "headword": "अभ्यङ्ग", "headword_slp1": "aByaNga", "fold": "aByaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhyaṅga (IA 22), smearing the body with oil.", "gloss_language": "en"}], "synonyms": ["अभ्यंग", "अभ्यंगः", "अभ्यङ्गः"], "synonyms_slp1": ["aByaMga", "aByaMgaH", "aByaNgaH"]}], "aByantara": [{"id": "AByantara", "headword": "आभ्यन्तर", "headword_slp1": "AByantara", "fold": "aByantara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ābhyantara (HD), an officer specially intimate or in close contact with the king. Cf. Antaraṅga. See Rājataraṅgiṇī, VIII. 426. But cf. also Ābhyantarika, Abhyantar-opasthāyaka.", "gloss_language": "en"}], "synonyms": ["आभ्यंतर", "आभ्यन्तरः"], "synonyms_slp1": ["AByaMtara", "AByantaraH"]}], "aByantaraBaRqaraDikarin": [{"id": "aByantaraBARqArADikArin", "headword": "अभ्यन्तरभाण्डाराधिकारिन्", "headword_slp1": "aByantaraBARqArADikArin", "fold": "aByantaraBaRqaraDikarin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Abhyantara-bhāṇḍār-ādhikārin, cf. Bhītara-bhaṇḍār-ādhikārin (IE 8-3; EI 28).", "gloss_language": "en"}]}], "aByantaradaya": [{"id": "AByantarAdAya", "headword": "आभ्यन्तरादाय", "headword_slp1": "AByantarAdAya", "fold": "aByantaradaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ābhyantar-ādāya, cf. bāhy-ābhyantar-ādāya (IE 8-5); internal [] revenue income of a village; probably, taxes payable to the village authorities as against those payable to the king. Cf. antar-āya, abhyantara-siddhi, antaḥ-kara, etc. See bāhya.", "gloss_language": "en"}]}], "aByantarasidDi": [{"id": "aByantarasidDi", "headword": "अभ्यन्तरसिद्धि", "headword_slp1": "aByantarasidDi", "fold": "aByantarasidDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "abhyantara-siddhi, abhyantara-siddhika (IE 8-5; EI 20, 22), same as ābhyantara-siddhi; internal income or revenue, or taxes payable to the village authorities as against those payable to the king; cf. tribhog-ābhyantara-siddhi, bāhy-ābhyantara-siddhi, bāhy-ābhyantar-ādāya; also sarv-ābhyantara-siddhi (EI 20), and antaḥ-siddhika (CII 4), a privilege of the donee of rent-free land. According to some (CII 4), it refers to the privilege of the donee offering full power of adjudication in law-suits. But expressions like tribhog-ābhyantara-siddhi (q. v.) render it doubtful. See bāhya, siddhi, siddh-āya.", "gloss_language": "en"}, {"gloss": "abhyantara-siddhi (EI 22), same as abhyantara-siddhyā, abhyantara-siddhika; refers to internal revenue income or taxes to be paid to local authorities; cf. sa-bāhy-ābhyantar-ādāya.", "gloss_language": "en"}]}, {"id": "AByantarasidDi", "headword": "आभ्यन्तरसिद्धि", "headword_slp1": "AByantarasidDi", "fold": "aByantarasidDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ābhyantara-siddhi (CII 4), same as abhyantara-siddhi; explained by some as ‘the powers of adjudication’; probably, taxes payable to the village authorities as against those payable to the king. See abhyantara-siddhi, etc.", "gloss_language": "en"}]}], "aByantarika": [{"id": "AByantarika", "headword": "आभ्यन्तरिक", "headword_slp1": "AByantarika", "fold": "aByantarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ābhyantarika (IE 8-3), a guard of the inner apartments of the palace; cf. Ābhyantarikā. See Ābhyantara, Abhyantar-opasthāyaka.", "gloss_language": "en"}], "synonyms": ["आभ्यन्तरिकः"], "synonyms_slp1": ["AByantarikaH"]}, {"id": "AByantarikA", "headword": "आभ्यन्तरिका", "headword_slp1": "AByantarikA", "fold": "aByantarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Ābhyantarikā, a female guard of the inner apartment of the palace; probably also a concubine (Ep. Ind., 