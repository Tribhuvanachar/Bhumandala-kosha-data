es": [{"gloss": "āditya-kāca (EI 32), probably, the jewel called sūryakānta.", "gloss_language": "en"}]}], "adivarahadrama": [{"id": "AdivarAhadramma", "headword": "आदिवराहद्रम्म", "headword_slp1": "AdivarAhadramma", "fold": "adivarahadrama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ādivarāha-dramma (EI 30; CII 4), name of a coin (dramma) styled after Ādivarāha, i. e. Pratīhāra Bhoja I (c. 836-85 A. D.).", "gloss_language": "en"}, {"gloss": "ādivarāha-dramma , ‘a dramma issued by Ādivarāha (Patīhāra Bhoja I, c. 836-85 A. D.)’; same as śrīmad-ādivarāha-dramma; see dramma.", "gloss_language": "en"}]}], "adirEpawam": [{"id": "AdirEppAwwam", "headword": "आदिरैप्पाट्टम्", "headword_slp1": "AdirEppAwwam", "fold": "adirEpawam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ādirai-ppāṭṭam (SITI), Tamil; tax on cattle; cf. attir̤ai-pāṭṭam.", "gloss_language": "en"}]}]}