{"kowa": [{"id": "kowa", "headword": "कोट", "headword_slp1": "kowa", "fold": "kowa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭa (LP), also called koṭaḍī; ‘wall of the compound’.", "gloss_language": "en"}], "synonyms": ["कोटः"], "synonyms_slp1": ["kowaH"]}, {"id": "kowwa", "headword": "कोट्ट", "headword_slp1": "kowwa", "fold": "kowa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭa (EI 24), a fort. See koṭṭai and koṭṭam of the South Indian inscriptions.", "gloss_language": "en"}], "synonyms": ["कोट्टं", "कोट्टः"], "synonyms_slp1": ["kowwaM", "kowwaH"]}], "kowaDikaraRika": [{"id": "kowADikaraRika", "headword": "कोटाधिकरणिक", "headword_slp1": "kowADikaraRika", "fold": "kowaDikaraRika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koṭ-ādhikaraṇika (BL), officer in charge of or related to the government of a koṭa or koṭṭa (fort).", "gloss_language": "en"}]}], "kowaqi": [{"id": "kowaqi", "headword": "कोटडि", "headword_slp1": "kowaqi", "fold": "kowaqi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭaḍi, koṭaḍī cf. koṭaḍi-sahita (LP), ‘together with walls of the compound’.", "gloss_language": "en"}]}], "kowaka": [{"id": "kowaka", "headword": "कोटक", "headword_slp1": "kowaka", "fold": "kowaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭaka (Ep. Ind., Vol. XIV, p. 313), ‘a district’; same as koṭṭaka; cf. koṭṭa-viṣaya.", "gloss_language": "en"}], "synonyms": ["कोटकः"], "synonyms_slp1": ["kowakaH"]}, {"id": "kowwaka", "headword": "कोट्टक", "headword_slp1": "kowwaka", "fold": "kowaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭaka, see koṭaka.", "gloss_language": "en"}]}], "kowapala": [{"id": "kowapAla", "headword": "कोटपाल", "headword_slp1": "kowapAla", "fold": "kowapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koṭapāla (EI 17), same as Koṭṭapāla.", "gloss_language": "en"}], "synonyms": ["कोटपालः"], "synonyms_slp1": ["kowapAlaH"]}, {"id": "kowwapAla", "headword": "कोट्टपाल", "headword_slp1": "kowwapAla", "fold": "kowapala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koṭṭapāla (IE 8-3; EI 12, 18, 25, 30; BL), officer in charge of a fort; governor of a fort. Cf. the Bhagalpur plate of Nārāyaṇapāla (Ind. Ant., Vol. XV, p. 306); sometimes spelt Koṭapāla (cf. the Nalanda plate of Devapāla in Ep. Ind., Vol. XVII, p. 321). Same as Koṭṭapati.\n (EI 25), the city prefect; same as Kotwāl.", "gloss_language": "en"}]}], "kowihoma": [{"id": "kowihoma", "headword": "कोटिहोम", "headword_slp1": "kowihoma", "fold": "kowihoma", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭi-homa (EI 12, 33), name of a rite.", "gloss_language": "en"}], "synonyms": ["कोटिहोमः"], "synonyms_slp1": ["kowihomaH"]}], "kowika": [{"id": "kowikA", "headword": "कोटिका", "headword_slp1": "kowikA", "fold": "kowika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭikā, a load [of cloth] (Ep. Ind., Vol. XIV, p. 309).\n (EI 14), a measure.", "gloss_language": "en"}]}], "kowE": [{"id": "kowwE", "headword": "कोट्टै", "headword_slp1": "kowwE", "fold": "kowE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭai (ASLV), a fort.", "gloss_language": "en"}]}], "kowam": [{"id": "kowwam", "headword": "कोट्टम्", "headword_slp1": "kowwam", "fold": "kowam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭam (IE 8-4; EI 27), Tamil; a district; a district within a maṇḍala or province.\n (ASLV), a division of the rājya; sometimes subdivided into nāḍus.", "gloss_language": "en"}]}], "kowanigraha": [{"id": "kowwanigraha", "headword": "कोट्टनिग्रह", "headword_slp1": "kowwanigraha", "fold": "kowanigraha", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koṭṭa-nigraha (EI 8; IA 30; BL), commander of a fort; same as Koṭṭapāla. Cf. Koṭṭanigrahin.", "gloss_language": "en"}]}], "kowanigrahin": [{"id": "kowwanigrahin", "headword": "कोट्टनिग्रहिन्", "headword_slp1": "kowwanigrahin", "fold": "kowanigrahin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koṭṭanigrahin (IA 30), probably, the commander of a fort; same as Koṭṭanigraha.", "gloss_language": "en"}]}], "kowapati": [{"id": "kowwapati", "headword": "कोट्टपति", "headword_slp1": "kowwapati", "fold": "kowapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Koṭṭapati (IE 8-3), same as Koṭṭapāla.", "gloss_language": "en"}]}], "kowavisaya": [{"id": "kowwavizaya", "headword": "कोट्टविषय", "headword_slp1": "kowwavizaya", "fold": "kowavisaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭa-viṣaya (IE 8-4; CII 1), a viṣaya or district around a fortress; a district with its headquarters in a fort. See koṭaka.", "gloss_language": "en"}]}], "kowEkuli": [{"id": "kowwEkkUli", "headword": "कोट्टैक्कूलि", "headword_slp1": "kowwEkkUli", "fold": "kowEkuli", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭai-kkūli (SITI); ‘wages on nuts’; probably, charges for the upkeep of forts; cf. koṭṭai-magamai.", "gloss_language": "en"}]}], "kowEmagamE": [{"id": "kowwEmagamE", "headword": "कोट्टैमगमै", "headword_slp1": "kowwEmagamE", "fold": "kowEmagamE", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "koṭṭai-magamai (SITI), Tamil; tax for the maintenance of forts.", "gloss_language": "en"}]}]}