{"bra": [{"id": "brA", "headword": "ब्रा", "headword_slp1": "brA", "fold": "bra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brā, abbreviation of Brāhmaṇa (Ep. Ind., Vol. XXX, p. 55).", "gloss_language": "en"}]}], "brahmacarin": [{"id": "brahmacArin", "headword": "ब्रह्मचारिन्", "headword_slp1": "brahmacArin", "fold": "brahmacarin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmacārin (SII 2; LL), a Brāhmaṇa student; an unmarried student of the Vedas.\n (BL), epithet of one who takes a vow of celibacy.\n (SII 2), a temple servant.", "gloss_language": "en"}]}], "brahmadana": [{"id": "brahmadAna", "headword": "ब्रह्मदान", "headword_slp1": "brahmadAna", "fold": "brahmadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-dāna, cf. pirama-dānam (SITI), gift to Brāhmaṇas; same as brahmadāya, etc.", "gloss_language": "en"}]}], "brahmadaya": [{"id": "brahmadAya", "headword": "ब्रह्मदाय", "headword_slp1": "brahmadAya", "fold": "brahmadaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmadāya (EI 23; CII 4), gift to a Brāhmaṇa; the rent-free [] holding of Brāhmaṇas; same as brahmadeya. See brahmatrā, etc.", "gloss_language": "en"}], "synonyms": ["ब्रह्मदायः"], "synonyms_slp1": ["brahmadAyaH"]}], "brahmadeya": [{"id": "brahmadeya", "headword": "ब्रह्मदेय", "headword_slp1": "brahmadeya", "fold": "brahmadeya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmadeya (EI 30; ASLV; HRS; SITI), land or village given as gift (generally tax-free) to Brāhmaṇas; land to be granted to or in the possession of Brāhmaṇas.", "gloss_language": "en"}], "synonyms": ["ब्रह्मदेयः"], "synonyms_slp1": ["brahmadeyaH"]}], "brahmadeyaki": [{"id": "brahmadeyakki", "headword": "ब्रह्मदेयक्कि", "headword_slp1": "brahmadeyakki", "fold": "brahmadeyaki", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmadeya-kkil̤̣avar (SITI), Sanskrit-Tamil; sole owner of a Brahmadeya village; sometimes supposed to be the headman or chief of a Brahmadeya village.", "gloss_language": "en"}]}], "brahmaDiraja": [{"id": "brahmADirAja", "headword": "ब्रह्माधिराज", "headword_slp1": "brahmADirAja", "fold": "brahmaDiraja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahm-ādhirāja (SITI), title of distinguished Brāhmaṇa military commanders; also spelt Brahmādarāya in Tamil. See Brahma-mahārāja, Brahma-rāja.", "gloss_language": "en"}]}], "brahmahatya": [{"id": "brahmahatyA", "headword": "ब्रह्महत्या", "headword_slp1": "brahmahatyA", "fold": "brahmahatya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-hatyā (CITD), killing a Brāhmaṇa, considered to be a great sin.", "gloss_language": "en"}]}], "brahmakalpa": [{"id": "brahmakalpa", "headword": "ब्रह्मकल्प", "headword_slp1": "brahmakalpa", "fold": "brahmakalpa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-kalpa (CITD), the kalpa or age of the god Brahman, extending to many thousands of years.", "gloss_language": "en"}], "synonyms": ["ब्रह्मकल्पः"], "synonyms_slp1": ["brahmakalpaH"]}], "brahmaksatra": [{"id": "brahmakzatra", "headword": "ब्रह्मक्षत्र", "headword_slp1": "brahmakzatra", "fold": "brahmaksatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahma-kṣatra, Brahma-kṣatriya (EI 5, 12, 24), a Kṣatriya family claiming descent from a Brāhmaṇa parent; a family in which the blood of the Brāhmaṇas and Kṣatriyas has been mixed. See Vishveshvaranand Ind. Journ., Vol. I, pp. 87 ff., etc. In one record (Journ. Karnatak Univ., Vol. II, No 2, January 1959, p. 47), the Nāgavaṃśa, to which a Kadamba king's minister Māyideva belonged, is called Brahma-kṣatra because it originated from the intercourse^1 of its progenitor Nāgarāja with a Brāhmaṇa girl. Brahma-vaiśya should be likewise explained.\n[1] Correction submitted by Dr. Sampada Savardekar on 20210207. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/51.", "gloss_language": "en"}]}], "brahmamaharaja": [{"id": "brahmamahArAja", "headword": "ब्रह्ममहाराज", "headword_slp1": "brahmamahArAja", "fold": "brahmamaharaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahma-mahārāja, cf. pirama-mārāyan̤ (SITI), title of Brāhmaṇa ministers. See Brahm-ādhirāja, Brahmarāja.", "gloss_language": "en"}]}], "brahmamantra": [{"id": "brahmamantra", "headword": "ब्रह्ममन्त्र", "headword_slp1": "brahmamantra", "fold": "brahmamantra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-mantra (IA 12), five in number.", "gloss_language": "en"}]}], "brahmameDa": [{"id": "brahmameDa", "headword": "ब्रह्ममेध", "headword_slp1": "brahmameDa", "fold": "brahmameDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-medha, cf. pirama-metam (SITI), special funeral rite for a saintly person.", "gloss_language": "en"}]}], "brahman": [{"id": "brahman", "headword": "ब्रह्मन्", "headword_slp1": "brahman", "fold": "brahman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahman (IE 7-1-2), ‘nine’.", "gloss_language": "en"}]}], "brahmaRarasakaRam": [{"id": "brAhmaRarASakkARam", "headword": "ब्राह्मणराशक्काणम्", "headword_slp1": "brAhmaRarASakkARam", "fold": "brahmaRarasakaRam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brāhmaṇa-rāśa(rāja)-kkāṇam (SITI), Sanskrit-Tamil; tax payable by the Brāhmaṇa (Purohita) to the king.", "gloss_language": "en"}, {"gloss": "brāhmaṇa-rāśa(rāja)-kkāṇam (SITI), Sanskrit-Tamil; tax payable by the Brāhmaṇa (purohita) to the king.", "gloss_language": "en"}]}], "brahmaRavinsati": [{"id": "brAhmaRaviMSati", "headword": "ब्राह्मणविंशति", "headword_slp1": "brAhmaRaviMSati", "fold": "brahmaRavinsati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brāhmaṇa-viṃśati (HRS), title upon villagers for the maintenance of the Brāhmaṇas; tenure of (1/20) of the revenue of an area granted to the Brāhmaṇas.", "gloss_language": "en"}]}], "brahmaRqa": [{"id": "brahmARqa", "headword": "ब्रह्माण्ड", "headword_slp1": "brahmARqa", "fold": "brahmaRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmāṇḍa (EI 16, 21), name of a mahādāna.", "gloss_language": "en"}], "synonyms": ["ब्रह्मांड", "ब्रह्माण्डं"], "synonyms_slp1": ["brahmAMqa", "brahmARqaM"]}], "brahmaRya": [{"id": "brahmaRya", "headword": "ब्रह्मण्य", "headword_slp1": "brahmaRya", "fold": "brahmaRya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmaṇya (EI 22) ‘hospitable to the Brāhmaṇas’; see Paramabrahmaṇya, Atibrahmaṇya.", "gloss_language": "en"}], "synonyms": ["ब्रह्मण्यः"], "synonyms_slp1": ["brahmaRyaH"]}, {"id": "brAhmaRya", "headword": "ब्राह्मण्य", "headword_slp1": "brAhmaRya", "fold": "brahmaRya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brāhmaṇya (SII 1), the community of Brāhmaṇas.", "gloss_language": "en"}], "synonyms": ["ब्राह्मण्यः"], "synonyms_slp1": ["brAhmaRyaH"]}], "brahmapura": [{"id": "brahmapura", "headword": "ब्रह्मपुर", "headword_slp1": "brahmapura", "fold": "brahmapura", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmapura (EI 2), same as brahmapurī; a rent-free village in the possession of Brāhmaṇas; same as agrahāra, etc.", "gloss_language": "en"}]}], "brahmapuri": [{"id": "brahmapurI", "headword": "ब्रह्मपुरी", "headword_slp1": "brahmapurI", "fold": "brahmapuri", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmapurī (EI 4, 28; SITI), also called agara-brahmadeya (Sanskrit agrahāra-brahmadeya); a Brāhmaṇa settlement. See brahmapura.", "gloss_language": "en"}]}], "brahmaraja": [{"id": "brahmarAja", "headword": "ब्रह्मराज", "headword_slp1": "brahmarAja", "fold": "brahmaraja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahmarāja (SITI), title of a Brāhmaṇa minister.", "gloss_language": "en"}]}], "brahmaraksasa": [{"id": "brahmarAkzasa", "headword": "ब्रह्मराक्षस", "headword_slp1": "brahmarAkzasa", "fold": "brahmaraksasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahmarākṣasa (EI 3, 16), a Brāhmaṇa defeated in disputations.", "gloss_language": "en"}], "synonyms": ["ब्रह्मराक्षसः"], "synonyms_slp1": ["brahmarAkzasaH"]}], "brahmaraya": [{"id": "brahmarAya", "headword": "ब्रह्मराय", "headword_slp1": "brahmarAya", "fold": "brahmaraya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahmarāya (SITI), same as Brahmarāja. Cf. Brahm-ādhirāja.", "gloss_language": "en"}]}], "brahmarsi": [{"id": "brahmarzi", "headword": "ब्रह्मर्षि", "headword_slp1": "brahmarzi", "fold": "brahmarsi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahmarṣi (EI 22), a Brāhmaṇa sage.", "gloss_language": "en"}], "synonyms": ["ब्रह्मर्षिः"], "synonyms_slp1": ["brahmarziH"]}], "brahmastamba": [{"id": "brahmastamba", "headword": "ब्रह्मस्तम्ब", "headword_slp1": "brahmastamba", "fold": "brahmastamba", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-stamba (CII 4), a settlement of Brāhmaṇas.", "gloss_language": "en"}], "synonyms": ["ब्रह्मस्तम्बः"], "synonyms_slp1": ["brahmastambaH"]}], "brahmasTana": [{"id": "brahmasTAna", "headword": "ब्रह्मस्थान", "headword_slp1": "brahmasTAna", "fold": "brahmasTana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-sthāna (SII 13; SITI), explained as ‘an assembly hall’; the Brāhmaṇa quarters of a village; cf. Tamil pirummastānam (SITI), the quarters of the Brāhmaṇas where the village assembly (sabhā) used to meet.", "gloss_language": "en"}], "synonyms": ["ब्रह्मस्थानः"], "synonyms_slp1": ["brahmasTAnaH"]}], "brahmasya": [{"id": "brahmAsya", "headword": "ब्रह्मास्य", "headword_slp1": "brahmAsya", "fold": "brahmasya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahmāsya (IE 7-1-2), ‘four’.", "gloss_language": "en"}]}], "brahmatra": [{"id": "brahmatrA", "headword": "ब्रह्मत्रा", "headword_slp1": "brahmatrA", "fold": "brahmatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahmatrā (IE 8-5), same as brahmadāya, etc.", "gloss_language": "en"}]}], "brahmavEsya": [{"id": "brahmavESya", "headword": "ब्रह्मवैश्य", "headword_slp1": "brahmavESya", "fold": "brahmavEsya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brahma-vaiśya (A. R. Ep., 1919, No. 208); cf. Brahma-kṣatra.", "gloss_language": "en"}]}], "brahmayajYa": [{"id": "brahmayajYa", "headword": "ब्रह्मयज्ञ", "headword_slp1": "brahmayajYa", "fold": "brahmayajYa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "brahma-yajña (EI 22; CII 4), study of the Vedas; name of a mahāyajña.", "gloss_language": "en"}], "synonyms": ["ब्रह्मयज्ञः"], "synonyms_slp1": ["brahmayajYaH"]}], "brahmi": [{"id": "brAhmI", "headword": "ब्राह्मी", "headword_slp1": "brAhmI", "fold": "brahmi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Brāhmī, name of an early Indian alphabet, from which a large number of alphabets of India and some other countries have derived.", "gloss_language": "en"}]}], "brahmotara": [{"id": "brahmottara", "headword": "ब्र