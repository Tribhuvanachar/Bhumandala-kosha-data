, "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vana-vāṭikā-tṛṇa-jantu-gocara-paryanta (Ep. Ind., Vol. XXIII p. 229), ‘including forests, gardens, grass fields and pasture lands for cattle and animals.’", "gloss_language": "en"}]}]}