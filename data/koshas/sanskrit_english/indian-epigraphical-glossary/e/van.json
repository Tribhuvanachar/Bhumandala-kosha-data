{"vanPaya": [{"id": "vAMPaya", "headword": "वांफय", "headword_slp1": "vAMPaya", "fold": "vanPaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vāṃphaya, cf. niddhi-vāṃphaya-sahita (EI 12), wrong reading of nidhi-nikṣepa-sahita.", "gloss_language": "en"}]}], "vansaDara": [{"id": "vaMSaDara", "headword": "वंशधर", "headword_slp1": "vaMSaDara", "fold": "vansaDara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vaṃśadhara (EI 24), a palanquin-bearer.", "gloss_language": "en"}], "synonyms": ["वंशधरः"], "synonyms_slp1": ["vaMSaDaraH"]}], "vansakara": [{"id": "vaMSakara", "headword": "वंशकर", "headword_slp1": "vaMSakara", "fold": "vansakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vaṃśakara (LL), a bamboo-worker.", "gloss_language": "en"}], "synonyms": ["वंशकरः"], "synonyms_slp1": ["vaMSakaraH"]}], "vansavali": [{"id": "vaMSAvalI", "headword": "वंशावली", "headword_slp1": "vaMSAvalI", "fold": "vansavali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vaṃś-āvalī (IA 30), a genealogical list; called kula-pañjī or kula-pañjikā in Bengal.", "gloss_language": "en"}]}], "vansika": [{"id": "vAMSika", "headword": "वांशिक", "headword_slp1": "vAMSika", "fold": "vansika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Vāṃśika (EI 33), a flute-player.", "gloss_language": "en"}], "synonyms": ["वांशिकः"], "synonyms_slp1": ["vAMSikaH"]}], "vansya": [{"id": "vaMSya", "headword": "वंश्य", "headword_slp1": "vaMSya", "fold": "vansya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "vaṃśya, same as dhvaṃśī (q. v.).", "gloss_language": "en"}], "synonyms": ["वंश्यः"], "synonyms_slp1": ["vaMSyaH"]}], "vana": [{"id": "vana", "headword": "वन", "headword_slp1": "vana", "fold": "vana", "headword_language": "sa", "source": "indian-