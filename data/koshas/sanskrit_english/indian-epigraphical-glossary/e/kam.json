{"kama": [{"id": "kAma", "headword": "काम", "headword_slp1": "kAma", "fold": "kama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāma (IE 7-1-2), ‘thirteen’.", "gloss_language": "en"}], "synonyms": ["कामं", "कामः"], "synonyms_slp1": ["kAmaM", "kAmaH"]}, {"id": "kamma", "headword": "कम्म", "headword_slp1": "kamma", "fold": "kama", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kamma (IE 8-6; EI 12, 19), Kannaḍa; same as stambha=skambha; a land measure equal to one-hundredth of a mattaru or nivartana.", "gloss_language": "en"}]}], "kamaDenu": [{"id": "kAmaDenu", "headword": "कामधेनु", "headword_slp1": "kAmaDenu", "fold": "kamaDenu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāma-dhenu (EI 16), name of a mahādāna.", "gloss_language": "en"}], "synonyms": ["कामधेनुः"], "synonyms_slp1": ["kAmaDenuH"]}], "kamakosWa": [{"id": "kAmakozWa", "headword": "कामकोष्ठ", "headword_slp1": "kAmakozWa", "fold": "kamakosWa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāma-koṣṭha, cf. kāma-kkoṭṭam (SITI), a shrine of the goddess Pārvatī as an adjunct of the Śiva temple in the same compound.", "gloss_language": "en"}]}], "kamalapuja": [{"id": "kamalapUjA", "headword": "कमलपूजा", "headword_slp1": "kamalapUjA", "fold": "kamalapuja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kamala-pūjā (BL), probably, worship of a deity with lotuses or flowers of gold or silver.", "gloss_language": "en"}]}], "kamali": [{"id": "kAmali", "headword": "कामलि", "headword_slp1": "kAmali", "fold": "kamali", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kāmali (EI 24), often written as kambalin, which means ‘a bull’; a levy probably on prize bullocks (cf. vara-balīvarda). Cf. yamali-kambali.", "gloss_language": "en"}]}], "kamata": [{"id":