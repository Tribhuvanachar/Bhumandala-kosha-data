{"ksanti": [{"id": "kzAnti", "headword": "क्षान्ति", "headword_slp1": "kzAnti", "fold": "ksanti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kṣānti (CII 1), forgiveness.", "gloss_language": "en"}], "synonyms": ["क्षांति", "क्षांतिः", "क्षान्तिः"], "synonyms_slp1": ["kzAMti", "kzAMtiH", "kzAntiH"]}], "ksapesvara": [{"id": "kzapeSvara", "headword": "क्षपेश्वर", "headword_slp1": "kzapeSvara", "fold": "ksapesvara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kṣapeśvara (IE 7-1-2), ‘one’.", "gloss_language": "en"}]}], "ksara": [{"id": "kzAra", "headword": "क्षार", "headword_slp1": "kzAra", "fold": "ksara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kṣāra (IE 7-1-2), ‘five’.", "gloss_language": "en"}], "synonyms": ["क्षारं", "क्षारः"], "synonyms_slp1": ["kzAraM", "kzAraH"]}], "ksata": [{"id": "kzata", "headword": "क्षत", "headword_slp1": "kzata", "fold": "ksata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kṣata (EI 23), engraved; cf. utkīrṇa, udghāṭita, etc.\n Cf. Prakrit chata (EI 7), ‘written’ (Select Inscriptions, p. 202).", "gloss_language": "en"}], "synonyms": ["क्षतं"], "synonyms_slp1": ["kzataM"]}], "ksatrapa": [{"id": "kzatrapa", "headword": "क्षत्रप", "headword_slp1": "kzatrapa", "fold": "ksatrapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kṣatrapa (IE 8-2, 8-3; ML; HD), feudatory title of foreign origin; Old Persian Khshathrapāvan, ‘a provincial governor’; a Satrap. See CII, Vol. II, pp. xxxiv, 23, 28; Vogel, Ant. Ch. St., p. 166. See Mahākṣatrapa.", "gloss_language": "en"}], "synonyms": ["क्षत्रपः"], "synonyms_slp1": ["kzatrapaH"]}], "ksatf": [{"id": "kzattf", "headword": "क्षत्तृ", "headword_slp1": "kzattf", "fold": "ksatf", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kṣattṛ (HD), a chamberlain. See Hist. Dharm., Vol. III, p. 111. According to Manu (X. 16) and Yājñavalkya (I. 94), the offspring of a Kṣatriya woman from a Śūdra male was called Kṣattṛ. This apparently refers to a tribe or community.", "gloss_language": "en"}]}]}