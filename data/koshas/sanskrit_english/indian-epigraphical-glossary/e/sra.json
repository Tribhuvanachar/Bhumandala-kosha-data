{"sra": [{"id": "SrA", "headword": "श्रा", "headword_slp1": "SrA", "fold": "sra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śrā (IE 8-1), abbreviation of Śrāvaṇa.", "gloss_language": "en"}]}], "sradDa": [{"id": "SrAdDa", "headword": "श्राद्ध", "headword_slp1": "SrAdDa", "fold": "sradDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāddha (CII 4), funeral rite.", "gloss_language": "en"}], "synonyms": ["श्राद्धं"], "synonyms_slp1": ["SrAdDaM"]}], "sradDadana": [{"id": "SradDAdAna", "headword": "श्रद्धादान", "headword_slp1": "SradDAdAna", "fold": "sradDadana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śraddhā-dāna (ML), a pious gift.", "gloss_language": "en"}]}], "sradDaNga": [{"id": "SrAdDANga", "headword": "श्राद्धाङ्ग", "headword_slp1": "SrAdDANga", "fold": "sradDaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāddh-āṅga (EI 28), gift for the merit of a deceased person.", "gloss_language": "en"}]}], "sradDakara": [{"id": "SrAdDakara", "headword": "श्राद्धकर", "headword_slp1": "SrAdDakara", "fold": "sradDakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāddha-kara, tax for performing śrāddha at Gayā (Rājatar., VI. 254; VII. 1008).", "gloss_language": "en"}]}], "sradDatiTi": [{"id": "SrAdDatiTi", "headword": "श्राद्धतिथि", "headword_slp1": "SrAdDatiTi", "fold": "sradDatiTi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāddha-tithi (CII 4), date on which the śrāddha is to be performed.", "gloss_language": "en"}]}], "srahe": [{"id": "SrAhe", "headword": "श्राहे", "headword_slp1": "SrAhe", "fold": "srahe", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāhe, also spelt śrāhi, srāhi, śrāhī, srāhī, ‘the year’ (probably [] derived from Prakrit sarahi, Sanskrit śaradi, ‘in the year’); the period of 12 months. Cf. Ep. Ind., Vol. XV, p. 80, note 2; Vol. XXIX, p. 106; Vol. XXX, p. 161, note 12; XXXII, p. 233 and note 8.", "gloss_language": "en"}]}], "srahi": [{"id": "SrAhi", "headword": "श्राहि", "headword_slp1": "SrAhi", "fold": "srahi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāhi, śrāhī (IE 8-1; EI 6, 23), probably, derived from Sanskrit śaradi = Prakrit sarahi; ‘in the year’; ‘the year’; used sometimes in place of saṃvat, but sometimes side by side with it. See srāhe, etc.", "gloss_language": "en"}]}, {"id": "srAhi", "headword": "स्राहि", "headword_slp1": "srAhi", "fold": "srahi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "srāhi, srāhī, same as srāhe, etc.", "gloss_language": "en"}]}], "sramaRa": [{"id": "SramaRa", "headword": "श्रमण", "headword_slp1": "SramaRa", "fold": "sramaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śramaṇa (EI 8; CII 3; LL; BL), a Buddhist or Jain monk; an ascetic.", "gloss_language": "en"}], "synonyms": ["श्रमणः"], "synonyms_slp1": ["SramaRaH"]}], "sramaRasravika": [{"id": "SramaRaSrAvikA", "headword": "श्रमणश्राविका", "headword_slp1": "SramaRaSrAvikA", "fold": "sramaRasravika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śramaṇa-śrāvikā (LL), female disciple of Jain ascetics. Cf. Śramaṇ-opāsaka.", "gloss_language": "en"}]}], "sramaRera": [{"id": "SrAmaRera", "headword": "श्रामणेर", "headword_slp1": "SrAmaRera", "fold": "sramaRera", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śrāmaṇera (EI 25), cf. Sāmanera (EI 2); Buddhist; a novice monk; cf. the feminine form Śrāmaṇerī.", "gloss_language": "en"}], "synonyms": ["श्रामणेरः"], "synonyms_slp1": ["SrAmaReraH"]}], "sramaRika": [{"id": "SramaRikA", "headword": "श्रमणिका", "headword_slp1": "SramaRikA", "fold": "sramaRika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śramaṇikā (LL), cf. Samaṇikā (EI 25), a Buddhist nun.", "gloss_language": "en"}]}], "sramaRodesa": [{"id": "SramaRoddeSa", "headword": "श्रमणोद्देश", "headword_slp1": "SramaRoddeSa", "fold": "sramaRodesa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śramaṇoddeśa (LL), Buddhist; a novice.", "gloss_language": "en"}]}], "sramaRopasaka": [{"id": "SramaRopAsaka", "headword": "श्रमणोपासक", "headword_slp1": "SramaRopAsaka", "fold": "sramaRopasaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śramaṇ-opāsaka (LL), lay follower of Buddhist Śramaṇas. Cf. Śramaṇa-śrāvikā.", "gloss_language": "en"}]}], "sravaka": [{"id": "SrAvaka", "headword": "श्रावक", "headword_slp1": "SrAvaka", "fold": "sravaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Śrāvaka (EI 7, 8, 24; ML; LL; HA), a lay follower of Jainism or Buddhism; cf. the feminine form Śrāvikā, sometimes called Śrāvikā bhaginī in Jain records.", "gloss_language": "en"}, {"gloss": "śrāvaka (CII 1), ‘a matter relating to a declaration’.", "gloss_language": "en"}], "synonyms": ["श्रावकः"], "synonyms_slp1": ["SrAvakaH"]}], "sravaRa": [{"id": "SrAvaRa", "headword": "श्रावण", "headword_slp1": "SrAvaRa", "fold": "sravaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāvaṇa (SITI), also called śrāvaṇa-patra (q. v.), sale deed; a document; cf. śālāvaṇam (SITI), a sale deed (āvaṇa-śālāvaṇam).", "gloss_language": "en"}], "synonyms": ["श्रावणः"], "synonyms_slp1": ["SrAvaRaH"]}], "sravaRapatra": [{"id": "SrAvaRapatra", "headword": "श्रावणपत्र", "headword_slp1": "SrAvaRapatra", "fold": "sravaRapatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "śrāvaṇa-patra (EI 30), a deed of declaration;