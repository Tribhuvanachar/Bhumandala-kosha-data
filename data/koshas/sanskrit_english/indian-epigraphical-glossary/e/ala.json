{"alagacu": [{"id": "alagaccu", "headword": "अलगच्चु", "headword_slp1": "alagaccu", "fold": "alagacu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "al̤ag-accu (SITI), Tamil; name of a coin.", "gloss_language": "en"}, {"gloss": "al̤ag-accu , see accu.", "gloss_language": "en"}]}], "alam": [{"id": "alam", "headword": "अलम्", "headword_slp1": "alam", "fold": "alam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "alam (CII 1), ‘capable’.", "gloss_language": "en"}]}], "alambana": [{"id": "Alambana", "headword": "आलम्बन", "headword_slp1": "Alambana", "fold": "alambana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ālambana (LL), the base stone.", "gloss_language": "en"}], "synonyms": ["आलंबनं", "आलम्बनं"], "synonyms_slp1": ["AlaMbanaM", "AlambanaM"]}], "alavaRa": [{"id": "alavaRa", "headword": "अलवण", "headword_slp1": "alavaRa", "fold": "alavaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "alavaṇa (IA 19), probably a Sanskritised form of ar̤uvaṇa (q. v.).", "gloss_language": "en"}]}], "alaya": [{"id": "Alaya", "headword": "आलय", "headword_slp1": "Alaya", "fold": "alaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "ālaya, cf. ālai (SII 3), a temple; a contraction of dev-ālaya. Cf. āyatana, bhavana, pura, etc.", "gloss_language": "en"}], "synonyms": ["आलयं", "आलयः"], "synonyms_slp1": ["AlayaM", "AlayaH"]}], "alavawa": [{"id": "allavAwa", "headword": "अल्लवाट", "headword_slp1": "allavAwa", "fold": "alavawa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "allavāṭa (IE 8-8; EI 30), meaning uncertain.", "gloss_language": "en"}]}], "alavaRaguqaksoBa": [{"id": "alavaRaguqakzoBa", "headword": "अलवणगुडक्षोभ", "headword_slp1": "alavaRaguqakzoBa", "fold": "alavaRaguqaksoBa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-lavaṇa-guḍa-kṣobha (EI 26), same as a-lavaṇa-khātaka, guḍa or sugar being added to lavaṇa or salt; cf. a-lavaṇa-klinna-khātaka.", "gloss_language": "en"}]}], "alavaRaKataka": [{"id": "alavaRaKAtaka", "headword": "अलवणखातक", "headword_slp1": "alavaRaKAtaka", "fold": "alavaRaKataka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-lavaṇa-khātaka , cf. Prakrit a-loṇa-khādaka (EI 7), refers [] to the freedom of the gift land from being dug out or its trees being pierced for salt.", "gloss_language": "en"}]}], "alavaRaklinaKanaka": [{"id": "alavaRaklinnaKanaka", "headword": "अलवणक्लिन्नखनक", "headword_slp1": "alavaRaklinnaKanaka", "fold": "alavaRaklinaKanaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-lavaṇa-klinna-khanaka (EI 26), same as a-lavaṇa-klinna-kreṇi-khanaka.", "gloss_language": "en"}]}], "alavaRaklinaKataka": [{"id": "alavaRaklinnaKAtaka", "headword": "अलवणक्लिन्नखातक", "headword_slp1": "alavaRaklinnaKAtaka", "fold": "alavaRaklinaKataka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-lavaṇa-klinna-khātaka , same as a-lavaṇa-khātaka, klinna, sometimes wrongly spelt kliṇva, probably, ‘toddy, sugar, etc.’ being added to lavaṇa or salt. Cf. a-lavaṇa-guḍa-kṣobha, a-lavaṇa-klinna-kreṇi-khanaka, etc. Cf. Select Inscriptions, p. 408.", "gloss_language": "en"}]}], "alavaRakliRvakreRiKanaka": [{"id": "alavaRakliRvakreRiKanaka", "headword": "अलवणक्लिण्वक्रेणिखनक", "headword_slp1": "alavaRakliRvakreRiKanaka", "fold": "alavaRakliRvakreRiKanaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-lavaṇa-kliṇva(nna)-kreṇi-khanaka (EI 26, 27), same as a-lavaṇa-klinna-khātaka.", "gloss_language": "en"}]}], "alavaRakreRiKanaka": [{"id": "alavaRakreRiKanaka", "headword": "अलवणक्रेणिखनक", "headword_slp1": "alavaRakreRiKanaka", "fold": "alavaRakreRiKanaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "a-lavaṇa-kreṇi-khanaka (EI 23), same as a-lavaṇa-klinna-khātaka.", "gloss_language": "en"}]}], "alamaYji": [{"id": "AlamaYji", "headword": "आलमञ्जि", "headword_slp1": "AlamaYji", "fold": "alamaYji", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āl̤-amañji (SII 12), a levy; explained as ‘workmen pressed into service without wages’ (SITI); Sanskrit viṣṭi.", "gloss_language": "en"}]}], "alayamanyam": [{"id": "allAyamAnyam", "headword": "अल्लायमान्यम्", "headword_slp1": "allAyamAnyam", "fold": "alayamanyam", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "al̤l̤āya-mānyam (SITI), Tamil-Sanskrit; probably, the right to receive a handful of grain or a prescribed quantity of an article sold in the market as wages for measuring.", "gloss_language": "en"}]}]}