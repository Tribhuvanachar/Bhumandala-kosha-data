{"agra": [{"id": "agra", "headword": "अग्र", "headword_slp1": "agra", "fold": "agra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra (EI 24), same as agra-bhāga; the king's share.\n (CII 1), cf. anyatra agreṇa parākrameṇa, ‘without a great effort’.", "gloss_language": "en"}], "synonyms": ["अग्रं", "अग्रः"], "synonyms_slp1": ["agraM", "agraH"]}], "agraBaga": [{"id": "agraBAga", "headword": "अग्रभाग", "headword_slp1": "agraBAga", "fold": "agraBaga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-bhāga (CII 2-1; ML), the principal share; same as agra, agra-pratyāya, the king's share.", "gloss_language": "en"}], "synonyms": ["अग्रभागः"], "synonyms_slp1": ["agraBAgaH"]}], "agraBagapratyansa": [{"id": "agraBAgapratyaMSa", "headword": "अग्रभागप्रत्यंश", "headword_slp1": "agraBAgapratyaMSa", "fold": "agraBagapratyansa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agrabhāga-pratyaṃśa (CII 2-1), same as agra-bhāga, agra-pratyaṃśa.", "gloss_language": "en"}]}], "agraBfti": [{"id": "agraBfti", "headword": "अग्रभृति", "headword_slp1": "agraBfti", "fold": "agraBfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-bhṛti (CII 1), a superior personage.", "gloss_language": "en"}]}], "agraDarmarajika": [{"id": "agraDarmarAjikA", "headword": "अग्रधर्मराजिका", "headword_slp1": "agraDarmarAjikA", "fold": "agraDarmarajika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-dharmarājikā (ML), the chief Dharmarājikā (a stūpa enshrining the relies of the Dharmarāja or Buddha).", "gloss_language": "en"}]}], "agrahara": [{"id": "agrahara", "headword": "अग्रहर", "headword_slp1": "agrahara", "fold": "agrahara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agrahara (EI 24), a collector of the king's share. See agra.", "gloss_language": "en"}]}, {"id": "agrahAra", "headword": "अग्रहार", "headword_slp1": "agrahAra", "fold": "agrahara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agrahāra (IE 8-4; EI 30; CII 4; SII 1; HRS; Chamba), rent-free land given to Brāhmaṇas; a rent-free village; a Brāhmaṇa village; sometimes suffixed to names of localities especially in South India. It was primarily, ‘a rent-free village in the possession of Brāhmaṇas’; but there are occasional references [] to dev-āgrahāra (rent-free holding in the possession of a deity), vaiśy-āgrahāra (rent-free holding in the possession of the Vaiśyas), etc.; sometimes spelt agrāhāra (CII 3). See mah-āgrahāra, brahmapurī, caturvedi-maṅgala, etc.; also aṅga-bhoga.", "gloss_language": "en"}], "synonyms": ["अग्रहारः"], "synonyms_slp1": ["agrahAraH"]}], "agraharapradeyansa": [{"id": "agrahArapradeyAMSa", "headword": "अग्रहारप्रदेयांश", "headword_slp1": "agrahArapradeyAMSa", "fold": "agraharapradeyansa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agrahāra-pradey-āṃśa (EI 33), a small rent payable for land granted to Brāhmaṇas and declared rent-free.", "gloss_language": "en"}]}], "agraharika": [{"id": "agrahArika", "headword": "अग्रहारिक", "headword_slp1": "agrahArika", "fold": "agraharika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agrahārika, Āgrahārika (IE 3-8; EI 23; HD; CII 3; etc.), the owner of an agrahāra; sometimes probably, the superintendent of agrahāras; same as Agrahārin. Cf. Ep. Ind., Vol. XXIV, p. 127.", "gloss_language": "en"}]}], "agraharin": [{"id": "agrahArin", "headword": "अग्रहारिन्", "headword_slp1": "agrahArin", "fold": "agraharin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agrahārin, Agrahārīṇa (EI 23, 24), the holder of an agrahāra; headman or owner of an agrahāra village. Cf. Agrahārika.", "gloss_language": "en"}]}], "agrahariRamahatara": [{"id": "agrahArIRamahattara", "headword": "अग्रहारीणमहत्तर", "headword_slp1": "agrahArIRamahattara", "fold": "agrahariRamahatara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agrahārīṇa-mahattara (EI 24), headman among the Agrahārīṇas, i. e. owners of an agrahāra (rent-free village in the possession of Brāhmaṇas).", "gloss_language": "en"}]}], "agrahayaRi": [{"id": "AgrahAyaRI", "headword": "आग्रहायणी", "headword_slp1": "AgrahAyaRI", "fold": "agrahayaRi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āgrahāyanī (EI 8), Mārgaśīrṣa su-di 15.", "gloss_language": "en"}]}], "agraja": [{"id": "agraja", "headword": "अग्रज", "headword_slp1": "agraja", "fold": "agraja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agraja (EI 23), the elder brother (or cousin); rarely used wrongly in the sense of ‘the eldest son’ (EI 9).", "gloss_language": "en"}], "synonyms": ["अग्रजः"], "synonyms_slp1": ["agrajaH"]}], "agrajanman": [{"id": "agrajanman", "headword": "अग्रजन्मन्", "headword_slp1": "agrajanman", "fold": "agrajanman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agrajanman (EI 9), same as agraja (q. v.); wrongly used to mean ‘the eldest son’ instead of ‘the elder brother’ (cf. agraja).\n (EI 24), a Brāhmaṇa.", "gloss_language": "en"}]}], "agramahadevi": [{"id": "agramahAdevI", "headword": "अग्रमहादेवी", "headword_slp1": "agramahAdevI", "fold": "agramahadevi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agra-mahādevī (SITI), chief queen of a king.", "gloss_language": "en"}]}], "agramahamahisi": [{"id": "agramahAmahizI", "headword": "अग्रमहामहिषी", "headword_slp1": "agramahAmahizI", "fold": "agramahamahisi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agra-mahāmahiṣī (IE 8-2), title of a chief queen; cf. Mahiṣī, Agra-mahiṣī, Mahāmahiṣī, Agra-mahādevī.", "gloss_language": "en"}]}], "agramahisi": [{"id": "agramahizI", "headword": "अग्रमहिषी", "headword_slp1": "agramahizI", "fold": "agramahisi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agra-mahiṣī (IE 8-2; EI 22; LL; ML), designation of the chief queen; cf. Mahiṣī, Agra-mahādevī, etc.", "gloss_language": "en"}]}], "agramaRqapa": [{"id": "agramaRqapa", "headword": "अग्रमण्डप", "headword_slp1": "agramaRqapa", "fold": "agramaRqapa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-maṇḍapa (SITI), front hall of a temple.", "gloss_language": "en"}]}], "agrapra": [{"id": "agrapra", "headword": "अग्रप्र", "headword_slp1": "agrapra", "fold": "agrapra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-prasāda, same as tala-vṛtti (Ep. Ind., Vol. XXXI, p. 166, note 2).", "gloss_language": "en"}]}], "agrapratyansa": [{"id": "agrapratyaMSa", "headword": "अग्रप्रत्यंश", "headword_slp1": "agrapratyaMSa", "fold": "agrapratyansa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-pratyaṃśa (EI 23; CII 2-1; ML), principal share; same as agra-bhāga.", "gloss_language": "en"}]}], "agrapratyaya": [{"id": "agrapratyAya", "headword": "अग्रप्रत्याय", "headword_slp1": "agrapratyAya", "fold": "agrapratyaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-pratyāya (EI 23), principal share or income; same as agra-bhāga.", "gloss_language": "en"}]}], "agrasala": [{"id": "agraSAlA", "headword": "अग्रशाला", "headword_slp1": "agraSAlA", "fold": "agrasala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agra-śālā (SII 3), a temple-kitchen.", "gloss_language": "en"}]}], "agrayaRa": [{"id": "AgrayaRa", "headword": "आग्रयण", "headword_slp1": "AgrayaRa", "fold": "agrayaRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "āgrayaṇa (EI 7), the first Soma libation at the agniṣṭoma sacrifice; oblation consisting of first-fruits at the end of the rainy season.", "gloss_language": "en"}], "synonyms": ["आग्रयणं", "आग्रयणः"], "synonyms_slp1": ["AgrayaRaM", "AgrayaRaH"]}], "agrika": [{"id": "agrika", "headword": "अग्रिक", "headword_slp1": "agrika", "fold": "agrika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agrika (LP), ‘the previous one’.", "gloss_language": "en"}]}], "agrikapaya": [{"id": "agrikapAyA", "headword": "अग्रिकपाया", "headword_slp1": "agrikapAyA", "fold": "agrikapaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "agrika-pāyā (LP), original foundation; cf. Gujarātī pāyā, foundation.", "gloss_language": "en"}]}], "agronomoi": [{"id": "agronomoi", "headword": "अग्रोनोमोइ", "headword_slp1": "agronomoi", "fold": "agronomoi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Agronomoi (IE 8-3), Greek; probably the same as Rajjuka.", "gloss_language": "en"}]}]}