{"kuwa": [{"id": "kUwa", "headword": "कूट", "headword_slp1": "kUwa", "fold": "kuwa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kūṭa (IA 7), cf. Rāṣṭrakūṭa, Deśakūṭa, Grāmakūṭa.", "gloss_language": "en"}], "synonyms": ["कूटः"], "synonyms_slp1": ["kUwaH"]}], "kuwaka": [{"id": "kUwaka", "headword": "कूटक", "headword_slp1": "kUwaka", "fold": "kuwaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kūṭaka (EI 5), probably, headman of the cultivators; same as Grāmakūṭaka.\n (IE 8-5; EI 4, 26), tax for the maintenance of the Kūṭaka; see pravaṇikara-kūṭaka-prabhṛti-samast-ādāya (Ep. Ind., Vol. IV, p. 101).\n (CII 4), a measure of capacity.\n (EI 2), a load or measure of salt.", "gloss_language": "en"}], "synonyms": ["कूटकं", "कूटकः"], "synonyms_slp1": ["kUwakaM", "kUwakaH"]}], "kuwakolasa": [{"id": "kUwakolasa", "headword": "कूटकोलस", "headword_slp1": "kUwakolasa", "fold": "kuwakolasa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kūṭakolasa (IE 8-3; EI 29), known from the Bhauma-Kara records of Orissa; official designation of uncertain import; cf. Kūṭa or Kūṭaka.", "gloss_language": "en"}]}], "kuwasasana": [{"id": "kUwaSAsana", "headword": "कूटशासन", "headword_slp1": "kUwaSAsana", "fold": "kuwasasana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kūṭa-śāsana (EI 7; IA 30; BL), a forged charter.", "gloss_language": "en"}]}], "kuwayukta": [{"id": "kUwAyukta", "headword": "कूटायुक्त", "headword_slp1": "kUwAyukta", "fold": "kuwayukta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kūṭāyukta (EI 22), official designation; probably Kūṭa (Kūṭaka) and Āyukta.", "gloss_language": "en"}]}], "kuwi": [{"id": "kuwI", "headword": "कुटी", "headword_slp1": "kuwI", "fold": "kuwi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuṭī (IE 8-8), a factory; cf. nīla-kuṭī.\n (LL), a Buddhist temple; an abbreviation of gandhakuṭī.", "gloss_language": "en"}]}], "kuwila": [{"id": "kuwila", "headword": "कुटिल", "headword_slp1": "kuwila", "fold": "kuwila", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kuṭila, cf. Siddhamātṛkā.", "gloss_language": "en"}], "synonyms": ["कुटिलं"], "synonyms_slp1": ["kuwilaM"]}], "kuwum": [{"id": "kuwum", "headword": "कुटुम्", "headword_slp1": "kuwum", "fold": "kuwum", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Kuṭum (EI 33; LP), abbreviation of Kuṭumbika.", "gloss_language": "en"}]}], "kuwumba": [{"id": "kuwumba", "headword": "कुटुम्ब", "headword_slp1": "kuwumba", "fold": "kuwumba", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuṭumba (IE 7-1-2), ‘two’.", "gloss_language": "en"}], "synonyms": ["कुटुंब", "कुटुंबं", "कुटुम्बः"], "synonyms_slp1": ["kuwuMba", "kuwuMbaM", "kuwumbaH"]}], "kuwumbaksetra": [{"id": "kuwumbakzetra", "headword": "कुटुम्बक्षेत्र", "headword_slp1": "kuwumbakzetra", "fold": "kuwumbaksetra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuṭumba-kṣetra (CII 4), an ancestral field.", "gloss_language": "en"}]}], "kuwumbavfti": [{"id": "kuwumbavftti", "headword": "कुटुम्बवृत्ति", "headword_slp1": "kuwumbavftti", "fold": "kuwumbavfti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuṭumba-vṛtti, cf. Kannaḍa kuttumbitti (EI 18), gift of land for the maintenance of the donee's family.", "gloss_language": "en"}]}], "kuwumbayatra": [{"id": "kuwumbayAtrA", "headword": "कुटुम्बयात्रा", "headword_slp1": "kuwumbayAtrA", "fold": "kuwumbayatra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "kuṭumba-yātrā (EI 12; BL), name of a religious ceremony; [] a procession of the royal family to the 