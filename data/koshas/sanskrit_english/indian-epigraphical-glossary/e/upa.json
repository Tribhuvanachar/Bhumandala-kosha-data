{"upaDa": [{"id": "upaDA", "headword": "उपधा", "headword_slp1": "upaDA", "fold": "upaDa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upa-dhā (CII 1), cf. hīta-sukham=upadadhyuḥ; to bring [welfare and happiness to the people].", "gloss_language": "en"}]}], "upaDi": [{"id": "upADi", "headword": "उपाधि", "headword_slp1": "upADi", "fold": "upaDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upādhi (SII 1), probably, a condition.\n Cf. opādi (SII 2), dues.", "gloss_language": "en"}], "synonyms": ["उपाधिः"], "synonyms_slp1": ["upADiH"]}], "upaDyaya": [{"id": "upADyAya", "headword": "उपाध्याय", "headword_slp1": "upADyAya", "fold": "upaDyaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upādhyāya (CII 4), a teacher; epithet of Brāhmaṇas.\n (IA 19), Jain; an Ācārya who has the right of reading the sacred text, but not of explaining it. []\n (IE 8-3; EI 7), epithet of teachers; mentioned as a Pātra.\n (CII 3), a sub-teacher who is the instructor in only a part of the Veda, or in grammar and the other Vedāṅgas.", "gloss_language": "en"}], "synonyms": ["उपाध्यायः"], "synonyms_slp1": ["upADyAyaH"]}], "upaDyayini": [{"id": "upADyAyinI", "headword": "उपाध्यायिनी", "headword_slp1": "upADyAyinI", "fold": "upaDyayini", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upādhyāyinī (LL), a female teacher; the wife of an Upādhyāya.", "gloss_language": "en"}]}], "upaga": [{"id": "upaga", "headword": "उपग", "headword_slp1": "upaga", "fold": "upaga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upaga (CII 1), suitable; cf. manuṣy-opaga, ‘beneficial to men’.", "gloss_language": "en"}]}], "upagata": [{"id": "upagata", "headword": "उपगत", "headword_slp1": "upagata", "fold": "upagata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upagata (CII 1), same as saṅgata, intimately associated; see upeta, etc. See Ind. Ep., pp. 161 ff.", "gloss_language": "en"}], "synonyms": ["उपगतः"], "synonyms_slp1": ["upagataH"]}, {"id": "upagatA", "headword": "उपगता", "headword_slp1": "upagatA", "fold": "upagata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upagatā (LP), a receipt.", "gloss_language": "en"}]}], "upahan": [{"id": "upahan", "headword": "उपहन्", "headword_slp1": "upahan", "fold": "upahan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upa-han (CII 1), to harm; cf. upaghāta, injury.", "gloss_language": "en"}]}], "upakara": [{"id": "upakara", "headword": "उपकर", "headword_slp1": "upakara", "fold": "upakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakara (Ep. Ind., Vol. XXXIV, p. 106, note 5), cf. nikara and upaskara.", "gloss_language": "en"}]}], "upakarika": [{"id": "upakArikA", "headword": "उपकारिका", "headword_slp1": "upakArikA", "fold": "upakarika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakārikā, probably, a territorial unit around the headquarters of an administrative unit (Ep. Ind., Vol. XV, p. 286).", "gloss_language": "en"}]}], "upaKila": [{"id": "upaKila", "headword": "उपखिल", "headword_slp1": "upaKila", "fold": "upaKila", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakhila, cf. sa-khil-opakhila (Chamba), ‘together with fallow (khila) and partially fallow (upakhila) land’. See pakhila.", "gloss_language": "en"}]}], "upakxpta": [{"id": "upakxpta", "headword": "उपकॢप्त", "headword_slp1": "upakxpta", "fold": "upakxpta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakḷpta (EI 15; CII 3, 4), a levy; probably, the tax on temporary tenants or the unfixed taxes or minor income; cf. sa-kḷpt-opakḷpta (IE 8-5), also kḷpta, kḷpta-kara, udraṅga and uparikara.", "gloss_language": "en"}]}], "upakramakaraRa": [{"id": "upakramakaraRa", "headword": "उपक्रमकरण", "headword_slp1": "upakramakaraRa", "fold": "upakramakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakrama-karaṇa, cf. karaṇa (LP); the department of new undertakings.", "gloss_language": "en"}]}], "upaksaya": [{"id": "upakzaya", "headword": "उपक्षय", "headword_slp1": "upakzaya", "fold": "upaksaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakṣaya (LP), expense; ‘other expenses’; cf. s-opak-ṣaya, sañjāt-opakṣaya, ‘expenses incurred’.", "gloss_language": "en"}], "synonyms": ["उपक्षयः"], "synonyms_slp1": ["upakzayaH"]}], "upaksiti": [{"id": "upakziti", "headword": "उपक्षिति", "headword_slp1": "upakziti", "fold": "upaksiti", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upakṣiti (IE 8-5; EI 33), probably, tax on inferior land; may also be the same as upakṣaya.", "gloss_language": "en"}]}], "upalaksita": [{"id": "upalakzita", "headword": "उपलक्षित", "headword_slp1": "upalakzita", "fold": "upalaksita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upalakṣita (Select Inscriptions, p. 202), ‘examined’.", "gloss_language": "en"}]}], "upana": [{"id": "upAna", "headword": "उपान", "headword_slp1": "upAna", "fold": "upana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upāna (SITI), the first moulding above the plinth, in the construction of temples.", "gloss_language": "en"}]}], "upaniDi": [{"id": "upaniDi", "headword": "उपनिधि", "headword_slp1": "upaniDi", "fold": "upaniDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upanidhi (IE 8-5; EI 12), same as nikṣepa; cf. nidhi.", "gloss_language": "en"}], "synonyms": ["उपनिधिः"], "synonyms_slp1": ["upaniDiH"]}], "upanipataka": [{"id": "upanipAtaka", "headword": "उपनिपातक", "headword_slp1": "upanipAtaka", "fold": "upanipataka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upanipātaka (CII 3), same as upapātaka.", "gloss_language": "en"}]}], "upapataka": [{"id": "upapAtaka", "headword": "उपपातक", "headword_slp1": "upapAtaka", "fold": "upapataka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upapātaka (CII 3), sins of the second degree.", "gloss_language": "en"}], "synonyms": ["उपपातकं"], "synonyms_slp1": ["upapAtakaM"]}], "upapiWa": [{"id": "upapIWa", "headword": "उपपीठ", "headword_slp1": "upapIWa", "fold": "upapiWa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upapīṭha (SII 2), a lower pedestal; cf. pīṭha; also upa-pīṭhattukaṇḍappaḍai, the lower tier of the basement of a temple.", "gloss_language": "en"}]}], "upapraDanin": [{"id": "upapraDAnin", "headword": "उपप्रधानिन्", "headword_slp1": "upapraDAnin", "fold": "upapraDanin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upapradhānin (ASLV), an executive officer lower in rank than the Pradhānīn.", "gloss_language": "en"}]}], "uparahiRqiya": [{"id": "uparahiRqIya", "headword": "उपरहिण्डीय", "headword_slp1": "uparahiRqIya", "fold": "uparahiRqiya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Uparahiṇḍīya (LP), a tax-inspector.", "gloss_language": "en"}]}], "uparaksita": [{"id": "uparakzita", "headword": "उपरक्षित", "headword_slp1": "uparakzita", "fold": "uparaksita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "uparakṣita (LL), explained as ‘kept in custody’.", "gloss_language": "en"}]}], "uparika": [{"id": "uparika", "headword": "उपरिक", "headword_slp1": "uparika", "fold": "uparika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Uparika (IE 8-3; CII 3; BL; HD), a viceroy; the governor of a province. An Uparika was appointed by the emperor and he himself appointed the governor of the district (cf. Ep. Ind., Vol. XV, p. 130). He is sometimes styled Mahārāja and Rājaputra. Viśvarūpa on the Yājñavalkyasmṛti, I. 307, quotes a prose passage from Bṛhaspati where the requisite qualities of an Uparika are set out. See Vogel, Ant. Ch. St., p. 123. The word literally means ‘one placed at the top’.\n (IE 8-3), cf. Auparika, a viceroy.\n Cf. Bṛhad-uparika (IE 8-3).", "gloss_language": "en"}]}], "uparikamaharaja": [{"id": "uparikamahArAja", "headword": "उपरिकमहाराज", "headword_slp1": "uparikamahArAja", "fold": "uparikamaharaja", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Uparika-mahārāja (IE 8-3), an Uparika enjoying the title Mahārāja.", "gloss_language": "en"}]}], "uparikara": [{"id": "uparikara", "headword": "उपरिकर", "headword_slp1": "uparikara", "fold": "uparikara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "uparikara (IE 8-5; CII 3, 4; HRS), explained as ‘additional taxes’, ‘unfixed taxes’, ‘minor taxes’, or ‘tax paid by the temporary tenants’; cf. s-oparikara (IA 10), sometimes called parikara (cf. sa-parikara in place of s-opakriara). See upri.", "gloss_language": "en"}], "synonyms": ["उपरिकरः"], "synonyms_slp1": ["uparikaraH"]}], "upariNK": [{"id": "upariNK", "headword": "उपरिङ्ख्", "headword_slp1": "upariNK", "fold": "upariNK", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upa-riṅkh (EI 12), to spread.", "gloss_language": "en"}]}], "upasaka": [{"id": "upAsaka", "headword": "उपासक", "headword_slp1": "upAsaka", "fold": "upasaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upāsaka (EI 3, 8, 27; CII 3), a Buddhist lay worshipper; a lay follower of the Buddha; cf. Upāsikā.\n (SII 13), a temple servant.", "gloss_language": "en"}], "synonyms": ["उपासकः"], "synonyms_slp1": ["upAsakaH"]}], "upasampada": [{"id": "upasampadA", "headword": "उपसम्पदा", "headword_slp1": "upasampadA", "fold": "upasampada", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upasampadā (EI 9; IA 22), the initiation of a Buddhist monk.", "gloss_language": "en"}]}], "upasanDi": [{"id": "upasanDi", "headword": "उपसन्धि", "headword_slp1": "upasanDi", "fold": "upasanDi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upasandhi (SITI), intermediary service of worship in a temple, between the morning and the midday service.", "gloss_language": "en"}]}], "upasanin": [{"id": "upAsanin", "headword": "उपासनिन्", "headword_slp1": "upAsanin", "fold": "upasanin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upāsanin (EI 32), title or family name of Brāhmaṇas.", "gloss_language": "en"}]}], "upasana": [{"id": "upasanna", "headword": "उपसन्न", "headword_slp1": "upasanna", "fold": "upasana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upasanna, cf. kṛt-opasannā (EI 30); word of doubtful import.", "gloss_language": "en"}], "synonyms": ["उपसन्नः"], "synonyms_slp1": ["upasannaH"]}], "upasika": [{"id": "upAsikA", "headword": "उपासिका", "headword_slp1": "upAsikA", "fold": "upasika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upāsikā (CII 3, 4), feminine form of Upāsaka (q. v.); a female lay-follower of the Buddha.", "gloss_language": "en"}]}], "upaskara": [{"id": "upaskara", "headword": "उपस्कर", "headword_slp1": "upaskara", "fold": "upaskara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upaskara (HRS), known from the Kamauli plate of Vaidyadeva; probably meaning upakara (q. v.) or the appurtenance to a tax (kara).\n Cf. nikara.", "gloss_language": "en"}], "synonyms": ["उपस्करः"], "synonyms_slp1": ["upaskaraH"]}], "upasraya": [{"id": "upASraya", "headword": "उपाश्रय", "headword_slp1": "upASraya", "fold": "upasraya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upāśraya (LL), a shelter.", "gloss_language": "en"}], "synonyms": ["उपाश्रयः"], "synonyms_slp1": ["upASrayaH"]}], "upasTana": [{"id": "upasTAna", "headword": "उपस्थान", "headword_slp1": "upasTAna", "fold": "upasTana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upasthāna (LL), reception room.\n (HRS), a group of royal receipts arising from underhand methods of collection of the contributions in kind, as suggested by the Arthaśāstra.", "gloss_language": "en"}], "synonyms": ["उपस्थानं"], "synonyms_slp1": ["upasTAnaM"]}], "upasTanasala": [{"id": "upasTAnaSAlA", "headword": "उपस्थानशाला", "headword_slp1": "upasTAnaSAlA", "fold": "upasTanasala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upasthāna-śālā (LL), hall of reception.", "gloss_language": "en"}]}], "upatalpa": [{"id": "upatalpa", "headword": "उपतल्प", "headword_slp1": "upatalpa", "fold": "upatalpa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upatalpa (EI 8), the upper story [of a house].", "gloss_language": "en"}], "synonyms": ["उपतल्पः"], "synonyms_slp1": ["upatalpaH"]}], "upati": [{"id": "upAti", "headword": "उपाति", "headword_slp1": "upAti", "fold": "upati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upāti (SITI), Tamil; also spelt opādi; Sanskrit upādhi; literally, obstruction; dues; anything payable as a debt or obligation.", "gloss_language": "en"}]}], "upata": [{"id": "upAtta", "headword": "उपात्त", "headword_slp1": "upAtta", "fold": "upata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upātta, cf. sa-bhūt-opātta-pratyāya (EI 23), ‘together with the income derived on account of changes in the natural phenomena.’", "gloss_language": "en"}], "synonyms": ["उपात्तं", "उपात्तः"], "synonyms_slp1": ["upAttaM", "upAttaH"]}], "upaya": [{"id": "upAya", "headword": "उपाय", "headword_slp1": "upAya", "fold": "upaya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upāya (EI 6, 25), four in number; ‘four’. Cf. catur-upāya (SII 1).\n (SITI), probably, minor taxes.", "gloss_language": "en"}], "synonyms": ["उपायः"], "synonyms_slp1": ["upAyaH"]}], "upayata": [{"id": "upayAta", "headword": "उपयात", "headword_slp1": "upayAta", "fold": "upayata", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "upayāta (EI 33), same as opeta, upagata, ‘closely associated’. See samupagata, samaveta, etc.", "gloss_language": "en"}]}], "upayukta": [{"id": "upayukta", "headword": "उपयुक्त", "headword_slp1": "upayukta", "fold": "upayukta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upayukta (HD), same as Upayuktaka, ‘a subordinate officer’. See Arthaśāstra, II. 5; Ep. Ind., Vol. IV, p. 285.", "gloss_language": "en"}], "synonyms": ["उपयुक्तः"], "synonyms_slp1": ["upayuktaH"]}], "upayuktaka": [{"id": "upayuktaka", "headword": "उपयुक्तक", "headword_slp1": "upayuktaka", "fold": "upayuktaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upayuktaka (IE 8-3; HD), probably the same as Niyuk-taka, Viniyuktaka, Tad-viniyuktaka, etc. See Upayukta; cf. Yuktak-Opayukta (Ep. Ind., Vol. VII, p. 40).", "gloss_language": "en"}]}], "upayuktika": [{"id": "upayuktika", "headword": "उपयुक्तिक", "headword_slp1": "upayuktika", "fold": "upayuktika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Upayuktika (EI 23), official designation; probably the same as Upayuktaka.", "gloss_language": "en"}]}]}