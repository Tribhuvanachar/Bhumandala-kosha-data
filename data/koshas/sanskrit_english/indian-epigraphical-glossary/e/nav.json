{"navacatuskika": [{"id": "navacatuzkikA", "headword": "नवचतुष्किका", "headword_slp1": "navacatuzkikA", "fold": "navacatuskika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-catuṣkikā, cf. nava-cokī.", "gloss_language": "en"}]}], "navacoki": [{"id": "navacokI", "headword": "नवचोकी", "headword_slp1": "navacokI", "fold": "navacoki", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-cokī (HA), Sanskrit nava-catuṣkikā; a hall (open on three sides) adjacent to and in front of the gūḍha-maṇḍapa, so called because it is divided into nine sections by means of the pillars supporting its ceiling.", "gloss_language": "en"}]}], "navaH": [{"id": "nAvaH", "headword": "नावः", "headword_slp1": "nAvaH", "fold": "navaH", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nāvaḥ (HRS), charges for hiring royal boats; same as nau-bhāṭaka.", "gloss_language": "en"}], "synonyms": ["नाव"], "synonyms_slp1": ["nAva"]}], "navakara": [{"id": "navakAra", "headword": "नवकार", "headword_slp1": "navakAra", "fold": "navakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navakāra (HA), Sanskrit namaskāra; the chief Jain formula for worship or an obeissance to the arhats, siddhas, ācāryas, upā-dhyāyas and sādhus.", "gloss_language": "en"}]}], "navakarman": [{"id": "navakarman", "headword": "नवकर्मन्", "headword_slp1": "navakarman", "fold": "navakarman", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-karman, cf. Tamil nava-karumam (SITI); renovation; repairs. Cf. Prakrit nava-kama (EI 20), foundation, extension or repairs to buildings.", "gloss_language": "en"}]}], "navakarmapati": [{"id": "navakarmapati", "headword": "नवकर्मपति", "headword_slp1": "navakarmapati", "fold": "navakarmapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Navakarmapati (EI 22), an architect or the supervisor of building operations; same as Navakarmika and Navakarmin.", "gloss_language": "en"}]}], "navakarmika": [{"id": "navakarmika", "headword": "नवकर्मिक", "headword_slp1": "navakarmika", "fold": "navakarmika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Navakarmika (EI 16, 23; LL), superintendent of a work (possibly of repairs); cf. Navakamika (EI 4, 20), an overseer of work (building or repairing operations); superintendent of building operations. Cf. Navakarmapati.", "gloss_language": "en"}]}], "navakarmin": [{"id": "navakarmin", "headword": "नवकर्मिन्", "headword_slp1": "navakarmin", "fold": "navakarmin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Navakarmin (ML), same as Navakarmika, the superintendent of a work. Cf. Navakarmapati.", "gloss_language": "en"}]}], "navaKaRqa": [{"id": "navaKaRqa", "headword": "नवखण्ड", "headword_slp1": "navaKaRqa", "fold": "navaKaRqa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-khaṇḍa (IE 8-4), epithet of Bhārata or Bhāratavarṣa; see khaṇḍa.", "gloss_language": "en"}]}], "navamika": [{"id": "navamikA", "headword": "नवमिका", "headword_slp1": "navamikA", "fold": "navamika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navamikā (EI 9), meaning uncertain.", "gloss_language": "en"}]}], "navaNga": [{"id": "navANga", "headword": "नवाङ्ग", "headword_slp1": "navANga", "fold": "navaNga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navāṅga, cf. Pali navaṃga (EI 33); cf. navāṅga-Śāstṛ-śāsana.", "gloss_language": "en"}], "synonyms": ["नवाङ्गः"], "synonyms_slp1": ["navANgaH"]}], "navaniDana": [{"id": "navaniDAna", "headword": "नवनिधान", "headword_slp1": "navaniDAna", "fold": "navaniDana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-nidhāna, cf. nava-nidhāna-sahita (IA 11), epithet of gift land; see Ind. Ant., Vol. VI, pp. 180 ff. (Inscriptions Nos. 4-11); explained as ‘new taxes imposed for the first time’; probably ‘a fresh assessment of tax’ (Ep. Ind., Vol. XXXIV, p. 143).", "gloss_language": "en"}]}], "navara": [{"id": "navara", "headword": "नवर", "headword_slp1": "navara", "fold": "navara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navara, Od̤iyā; same as Sanskrit nagara; capital city, palace.", "gloss_language": "en"}]}], "navaratna": [{"id": "navaratna", "headword": "नवरत्न", "headword_slp1": "navaratna", "fold": "navaratna", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-ratna (BL), the nine gems at Vikramāditya's court.", "gloss_language": "en"}], "synonyms": ["नवरत्नं"], "synonyms_slp1": ["navaratnaM"]}], "navaratra": [{"id": "navarAtra", "headword": "नवरात्र", "headword_slp1": "navarAtra", "fold": "navaratra", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navarātra, navarātri (EI 11, 25; CII 4), the festival of Durgā; Āśvina-sudi 1 to 9.", "gloss_language": "en"}], "synonyms": ["नवरात्रं"], "synonyms_slp1": ["navarAtraM"]}], "navaratriamavasya": [{"id": "navarAtriamAvAsyA", "headword": "नवरात्रिअमावास्या", "headword_slp1": "navarAtriamAvAsyA", "fold": "navaratriamavasya", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navarātri-amāvāsyā (EI 5), new-moon preceding the nava-rātri; also called mahālayā.", "gloss_language": "en"}]}], "navataraBumi": [{"id": "navataraBUmI", "headword": "नवतरभूमी", "headword_slp1": "navataraBUmI", "fold": "navataraBumi", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navatara-bhūmī (LP), land as yet uncultivated.", "gloss_language": "en"}]}], "navinapaYjikakaraRa": [{"id": "navInapaYjikAkaraRa", "headword": "नवीनपञ्जिकाकरण", "headword_slp1": "navInapaYjikAkaraRa", "fold": "navinapaYjikakaraRa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "navīna-pañjikā-karaṇa (LP), probably, ‘to have new fences’, i. e. ‘to have additional land in one's possession.’", "gloss_language": "en"}]}], "navaniDanasahita": [{"id": "navaniDAnasahita", "headword": "नवनिधानसहित", "headword_slp1": "navaniDAnasahita", "fold": "navaniDanasahita", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "nava-nidhāna-sahita (IA 11), probably, ‘with the taxes fixed afresh’, though nidhāna is often the same as nikṣepa (q. v.).", "gloss_language": "en"}]}]}