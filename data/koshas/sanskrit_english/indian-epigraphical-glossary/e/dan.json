{"dana": [{"id": "dAna", "headword": "दान", "headword_slp1": "dAna", "fold": "dana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna, dānā (ML), a gift.\n (HRS), known from Maitraka records to mean the so-called voluntary gifts of subjects.\n Cf. dānā-sambandhe (LP), ‘as regards the sale-tax’.", "gloss_language": "en"}], "synonyms": ["दानं", "दानः"], "synonyms_slp1": ["dAnaM", "dAnaH"]}], "danadayadaniBoga": [{"id": "dAnAdAyadAnIBoga", "headword": "दानादायदानीभोग", "headword_slp1": "dAnAdAyadAnIBoga", "fold": "danadayadaniBoga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dānādāya-dānībhoga (LP), explained as ‘local cess or road-cess’; dāya is explained as ‘a gift to Brāhmaṇas or temples’, [] dānī as ‘land tax’ and bhoga as ‘right of enjoyment’; but probably, dāṇ-ādāya means excise or customs duties and dāni-bhoga a tax for the maintenance of the tax-collector.", "gloss_language": "en"}]}], "danaDikarin": [{"id": "dAnADikArin", "headword": "दानाधिकारिन्", "headword_slp1": "dAnADikArin", "fold": "danaDikarin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Dān-ādhikārin (EI 12), officer in charge of gifts, mentioned along with the Śāsan-ādhikārika, ‘officer in charge of grants (or their writing)’. See Dharm-ādhikārin. It may also mean ‘a tolls-collector’ (cf. dāna, Dānin).", "gloss_language": "en"}]}], "danamuKa": [{"id": "dAnamuKa", "headword": "दानमुख", "headword_slp1": "dAnamuKa", "fold": "danamuKa", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna-mukha (EI 7; ML), a gift; the principal gift; same as deya-dharma.", "gloss_language": "en"}]}], "danapalan": [{"id": "dAnapalaM", "headword": "दानपलं", "headword_slp1": "dAnapalaM", "fold": "danapalan", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna-palaṃ (IA 11), actually dāna(ṃ*)palaṃ, i. e. ‘the dāna (levy) is one pala’.", "gloss_language": "en"}]}], "danapati": [{"id": "dAnapati", "headword": "दानपति", "headword_slp1": "dAnapati", "fold": "danapati", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Dānapati (EI 28, 30; HD), one who gives a gift; one who dedicates the images of a deity (especially as the result of a previous vow); probably, also an official designation; see Horamurta (CII 2-1), Dānādhikārin.", "gloss_language": "en"}], "synonyms": ["दानपतिः"], "synonyms_slp1": ["dAnapatiH"]}], "danapu": [{"id": "dAnappu", "headword": "दानप्पु", "headword_slp1": "dAnappu", "fold": "danapu", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna-ppur̤am (SITI), Sanskrit-Tamil; land set apart for the purpose of charity.", "gloss_language": "en"}]}], "danapradanaka": [{"id": "dAnapradAnaka", "headword": "दानप्रदानक", "headword_slp1": "dAnapradAnaka", "fold": "danapradanaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna-pradānaka (CII 4), all kinds of gifts.", "gloss_language": "en"}]}], "danasala": [{"id": "dAnaSAlA", "headword": "दानशाला", "headword_slp1": "dAnaSAlA", "fold": "danasala", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna-śālā (IA 11), a hall for the distribution of gifts.", "gloss_language": "en"}]}], "danavolapana": [{"id": "dAnavolApana", "headword": "दानवोलापन", "headword_slp1": "dAnavolApana", "fold": "danavolapana", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāna-volāpana (LP), dāna (road-cess) and volāpana (tax; cf. Gujarātī valāvaṇuṃ). See Volāpika.", "gloss_language": "en"}]}], "danayaka": [{"id": "danAyaka", "headword": "दनायक", "headword_slp1": "danAyaka", "fold": "danayaka", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Danāyaka (IA 20), corrupt from of Daṇḍanāyaka.", "gloss_language": "en"}]}], "dani": [{"id": "dAnI", "headword": "दानी", "headword_slp1": "dAnI", "fold": "dani", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Dānī (IE 8-5; EI 26), i. e. Dānin, officer collecting tax or corn; officer storing the corn collected as tax from the farmers.", "gloss_language": "en"}]}], "daniBaga": [{"id": "dAniBAga", "headword": "दानिभाग", "headword_slp1": "dAniBAga", "fold": "daniBaga", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dāni-bhāga, same as dāṇi-bhoga (q. v.). See Ghoshal, H. Rev. Syst., p. 256.", "gloss_language": "en"}]}], "danivolapika": [{"id": "dAnIvolApika", "headword": "दानीवोलापिक", "headword_slp1": "dAnIvolApika", "fold": "danivolapika", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Dānī-volāpika (LP), explained as ‘the collector of dānī (land cess) and volāpanā (tax, relating to Gujarātī val̤āvaṇuṃ).’ See Volāpika.", "gloss_language": "en"}]}], "danta": [{"id": "danta", "headword": "दन्त", "headword_slp1": "danta", "fold": "danta", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "danta (EI 7), a pin.\n (IE 7-1-2), ‘thirtytwo’.", "gloss_language": "en"}], "synonyms": ["दंत", "दंतः", "दन्तः"], "synonyms_slp1": ["daMta", "daMtaH", "dantaH"]}], "dantakara": [{"id": "dantakAra", "headword": "दन्तकार", "headword_slp1": "dantakAra", "fold": "dantakara", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "Dantakāra (LL), a worker in ivory; here danta means hasti-danta.", "gloss_language": "en"}], "synonyms": ["दंतकार", "दन्तकारः"], "synonyms_slp1": ["daMtakAra", "dantakAraH"]}], "dantin": [{"id": "dantin", "headword": "दन्तिन्", "headword_slp1": "dantin", "fold": "dantin", "headword_language": "sa", "source": "indian-epigraphical-glossary", "senses": [{"gloss": "dantin (IE 8-1-2), ‘eight’.", "gloss_language": "en"}], "synonyms": ["दंतिन्"], "synonyms_slp1": ["daMtin"]}]}