{"dosa": [{"id": "doza", "headword": "दोष", "headword_slp1": "doza", "fold": "dosa", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SK0066 दोष doṣa Principle constituents of the body that is responsible for homeostasis, when present in the state of equilibrium. Doṣas also determine the psycho-physiological nature / constitution of an individual. Doṣas are capable of vitiating the different bodily tissues, when deviate from the state of equilibrium and can lead to diseases. These are of two classes: a. Śārīrika (bodily): Vāta, Pitta and Kapha. b. Mānasa (psychological): Raja and Tama.", "gloss_language": "en"}], "synonyms": ["doSha"], "synonyms_slp1": ["doSha"]}], "dosa virudDa": [{"id": "doza virudDa", "headword": "दोष विरुद्ध", "headword_slp1": "doza virudDa", "fold": "dosa virudDa", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SV0091 दोष विरुद्ध doṣa viruddha Utilization of drugs, diet and regimen having similar qualities with Dosa (humours - Vata, Pitta & Kapha) but at variance with the habit of the individuals is categorized under this.", "gloss_language": "en"}], "synonyms": ["doSha viruddha"], "synonyms_slp1": ["doSha viruddha"]}], "dosaja svapna": [{"id": "dozaja svapna", "headword": "दोषज स्वप्न", "headword_slp1": "dozaja svapna", "fold": "dosaja svapna", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SK0068 दोषज स्वप्न doṣaja svapna Dreams due to aggravation of Doshas", "gloss_language": "en"}], "synonyms": ["doShaja svapna"], "synonyms_slp1": ["doShaja svapna"]}], "dosadarsanan adosesu": [{"id": "dozadarSanaM adozezu", "headword": "दोषदर्शनं अदोषेषु", "headword_slp1": "dozadarSanaM adozezu", "fold": "dosadarsanan adosesu", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF0705 दोषदर्शनं अदोषेषु doṣadarśanaṁ adoṣeṣu Finds fault in unfaultable things", "gloss_language": "en"}], "synonyms": ["