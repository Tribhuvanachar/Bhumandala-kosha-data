{"vega": [{"id": "vega", "headword": "वेग", "headword_slp1": "vega", "fold": "vega", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SV0306 वेग vega Derived from Vij- to agitate, to make quickly. The Vega word means in the medical context, natural urges (for elimination), reflex, and excitement. Usually, however it is taken in the sense of natural urges of the body, which call for urgent satisfaction. in Ayurvedic parlance denotes natural reflexes or urges. They are of two types Dharaniya (Suppressible urges) such as Greed, Anger etc and Adhāraṇīya (non suppressible urges) such as Sneezing, Sleep etc.", "gloss_language": "en"}], "synonyms": ["vega"], "synonyms_slp1": ["vega"]}], "vega apradurBava": [{"id": "vega aprAdurBAva", "headword": "वेग अप्रादुर्भाव", "headword_slp1": "vega aprAdurBAva", "fold": "vega apradurBava", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF2453 वेग अप्रादुर्भाव vega aprādurbhāva Deprived of reflex", "gloss_language": "en"}], "synonyms": ["vega apraadurbhaava"], "synonyms_slp1": ["vega apraadurbhaava"]}], "vegavat": [{"id": "vegavat", "headword": "वेगवत्", "headword_slp1": "vegavat", "fold": "vegavat", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF2455 वेगवत् vegavat Sudden", "gloss_language": "en"}], "synonyms": ["vegavat"], "synonyms_slp1": ["vegavat"]}], "vegasravi": [{"id": "vegasrAvI", "headword": "वेगस्रावी", "headword_slp1": "vegasrAvI", "fold": "vegasravi", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF2454 वेगस्रावी vegasrāvī Sudden bleeding.", "gloss_language": "en"}], "synonyms": ["vegasraavii"], "synonyms_slp1": ["vegasraavii"]}], "vegantara": [{"id": "vegAntara", "headword": "वेगान्तर", "headword_slp1": "vegAntara", "fold": "vegantara", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AT0357 वेगान्तर vegāntara Interval between two attacks (impulses) of poison.", "gloss_language": "en"}], "synonyms": ["vegaantara"], "synonyms_slp1": ["vegaantara"]}]}