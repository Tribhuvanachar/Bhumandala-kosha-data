{"agni": [{"id": "agni", "headword": "अग्नि", "headword_slp1": "agni", "fold": "agni", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SK0016 अग्नि agni 1. Fire, the phenomenon of combustion manifested in light, flame, and heat 2. One of the five basic elements (Paṅcamahābhūtas) that make up all matter in the universe. 3. All factors responsible for digestion and metabolism / transformation. This is of three classes: Jaṭharāgni, Bhūtāgni and Dhātvagni. 4. Physiologically, the intensity of Agni is influenced by Doṣas and is of four types: Viṣama (irregular, due to the dominance of Vāta), Tīkṣṇa (intense, due to the dominance of Pitta), Manda (depressed due to the dominance of Kapha) and Sama (normal, due to the balanced state of all three Doṣas).", "gloss_language": "en"}], "synonyms": ["agni"], "synonyms_slp1": ["agni"]}], "agni upahati": [{"id": "agni upahati", "headword": "अग्नि उपहति", "headword_slp1": "agni upahati", "fold": "agni upahati", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF0115 अग्नि उपहति agni upahati Loss of digestive power", "gloss_language": "en"}], "synonyms": ["agni upahati"], "synonyms_slp1": ["agni upahati"]}], "agni karma": [{"id": "agni karma", "headword": "अग्नि कर्म", "headword_slp1": "agni karma", "fold": "agni karma", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AT0017 अग्नि कर्म agni karma Cauterization", "gloss_language": "en"}], "synonyms": ["agni karma"], "synonyms_slp1": ["agni karma"]}], "agni balanasa": [{"id": "agni balanASa", "headword": "अग्नि बलनाश", "headword_slp1": "agni balanASa", "fold": "agni balanasa", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF0114 अग्नि बलनाशं agni balanāśaṁ Loss of digestive power", "gloss_language": "en"}], "synonyms": ["agni balanaasha"], "synonyms_slp1": ["agni balanaasha"]}], "agni virudDa": [{"id": "agni virudDa", "head