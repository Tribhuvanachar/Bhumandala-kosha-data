{"mala": [{"id": "mala", "headword": "मल", "headword_slp1": "mala", "fold": "mala", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SK0121 मल mala The waste products of the body formed during various stages of digestion and metabolism. Mala is one of the fundamental constituent of the human body along with Doṣa and Dhātu. They are of two classes: Āhāramala and Dhātumala. Āhāramala are: Mūtra (Urine) and Purīṣa (faces). Following are the Dhātumalās: Kapha from Rasa, Pitta from Rakta, nose mucus and ear wax from the Māṃsa, Sveda (perspiration) from the Meda, nails and hair from the Asthi, rheum of the eye from the Majjā.", "gloss_language": "en"}], "synonyms": ["mala"], "synonyms_slp1": ["mala"]}], "malacCavi": [{"id": "malacCavi", "headword": "मलच्छवि", "headword_slp1": "malacCavi", "fold": "malacCavi", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AF1211 मलच्छवि malacchavi Dirty appearance", "gloss_language": "en"}], "synonyms": ["malachChavi"], "synonyms_slp1": ["malachChavi"]}], "malaja": [{"id": "malaja", "headword": "मलज", "headword_slp1": "malaja", "fold": "malaja", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SV0158 मलज malaja Parasites growing in external excreta", "gloss_language": "en"}], "synonyms": ["malaja"], "synonyms_slp1": ["malaja"]}], "malina vastra": [{"id": "malina vastra", "headword": "मलिन वस्त्र", "headword_slp1": "malina vastra", "fold": "malina vastra", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SV0159 मलिन वस्त्र malina vastra Wearing of these clothes is considered inauspicious & causes itching & other skin disorders.", "gloss_language": "en"}], "synonyms": ["malina vastra"], "synonyms_slp1": ["malina vastra"]}], "malimasa": [{"id": "malImasa", "headword": "मलीमस", "headword_slp1": "malImasa", "fold": "malimasa", "headword_language": "sa", "source": "who-nia-non-clinical