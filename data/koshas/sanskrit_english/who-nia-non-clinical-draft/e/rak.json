{"rakta": [{"id": "rakta", "headword": "रक्त", "headword_slp1": "rakta", "fold": "rakta", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SK0159 रक्त rakta The second Dhātu among seven Dhātus whose function is Jīvana (to give life). It is formed in Yakṛt (liver) and Plīhā (spleen) with the help of Raṅjaka Pitta and Rakta Dhātvagni. This is dominant in Agni mahābhūta. Is named so because of its Rakta i.e Red color.", "gloss_language": "en"}], "synonyms": ["rakta"], "synonyms_slp1": ["rakta"]}], "rakta varga": [{"id": "rakta varga", "headword": "रक्त वर्ग", "headword_slp1": "rakta varga", "fold": "rakta varga", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "DG0246 रक्त वर्ग rakta varga Group of following 7 plants", "gloss_language": "en"}], "synonyms": ["rakta varga"], "synonyms_slp1": ["rakta varga"]}], "raktapuswi": [{"id": "raktapuzwi", "headword": "रक्तपुष्टि", "headword_slp1": "raktapuzwi", "fold": "raktapuswi", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "SK0160 रक्तपुष्टि raktapuṣṭi Nourishment of Rakta Dhātu.", "gloss_language": "en"}], "synonyms": ["raktapuShTi"], "synonyms_slp1": ["raktapuShTi"]}], "raktamoksaRa": [{"id": "raktamokzaRa", "headword": "रक्तमोक्षण", "headword_slp1": "raktamokzaRa", "fold": "raktamoksaRa", "headword_language": "sa", "source": "who-nia-non-clinical-draft", "senses": [{"gloss": "AT0271 रक्तमोक्षण raktamokṣaṇa Bloodletting. It means the procedure of blood-letting for the therapeutic purposes for removing morbid Doṣa/ poisons with blood. Blood can be eliminated through scraping, application of horn or leech or venesection. It is practiced in poisoned blood and blood born diseases in pitta (billeous) predominant diseases and also in a few vāta (neurological) disorders.", "gloss_language": "en"}], "synonyms": ["raktamoxaNa"], "synonyms_slp1": ["raktamoxaNa"]}], "raktavarRa": [{"id": "raktavarRa", "headword": "