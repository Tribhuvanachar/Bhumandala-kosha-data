tilaH"]}], "Baks": [{"id": "Bakz", "headword": "भक्ष्", "headword_slp1": "Bakz", "fold": "Baks", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "भक्ष् r. 1st and 10th cls. (-भक्षति भक्षयति-ते)\n 1. To eat.\n 2. To waste.\n 3. To bite.", "gloss_language": "en"}]}], "Baksaka": [{"id": "Bakzaka", "headword": "भक्षक", "headword_slp1": "Bakzaka", "fold": "Baksaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "भक्षक mfn. (-कः-का-कं)\n 1. Gluttonous, voracious, gourmand.\n 2. A feeder,\nan eater, who or what eats.\n f. (-क्षिका) A meal, a feed.\n E. भक्ष् to\neat, aff. ण्वल् ।", "gloss_language": "en"}], "synonyms": ["भक्षकः"], "synonyms_slp1": ["BakzakaH"]}], "Baksakara": [{"id": "BakzakAra", "headword": "भक्षकार", "headword_slp1": "BakzakAra", "fold": "Baksakara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "भक्षकार m. (-रः) A confectioner, a pastry cook.\n E. भक्ष् food, कार who\nprepares; also भक्षङ्कार ।", "gloss_language": "en"}], "synonyms": ["भक्षकारः"], "synonyms_slp1": ["BakzakAraH"]}], "BaksaRa": [{"id": "BakzaRa", "headword": "भक्षण", "headword_slp1": "BakzaRa", "fold": "BaksaRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "भक्षण n. (-णं) Eating.\n E. भक्ष् to eat, aff. ल्युट् ।", "gloss_language": "en"}], "synonyms": ["भक्षणं"], "synonyms_slp1": ["BakzaRaM"]}], "BaksaRiya": [{"id": "BakzaRIya", "headword": "भक्षणीय", "headword_slp1": "BakzaRIya", "fold": "BaksaRiya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "भक्षणीय mfn. (-यः-या-यं) Eatable, to be eaten.\n E. भक्ष् and अनीयर् aff.", "gloss_language": "en"}], "synonyms": ["भक्षणीयं"], "synonyms_slp1": ["BakzaRIyaM"]}], "BaksamaRa": [{"id": "BakzamARa", "headword": "भक्षमाण", "headword_slp1": "BakzamARa", "fold": "BaksamaRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "भक्षमाण mfn. (-णः-णा-णं) Eating.\n E. भक्ष to eat, शानच् af