{"pucCa": [{"id": "pucCa", "headword": "पुच्छ", "headword_slp1": "pucCa", "fold": "pucCa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुच्छ r. 1st cl. (पुच्छति) To err, to be careless or inattentive. भ्वा० पर० अक० सेट् ।", "gloss_language": "en"}, {"gloss": "पुच्छ mn. (-च्छः-च्छं)\n 1. A tail, the tail, the hinder part.\n 2. A horse's\ntail.\n 3. The tail of the peacock.\n 4. Any hairy tail.\n 5. The end\nof anything.\n E. पुच्छ to be careless, अच् aff.", "gloss_language": "en"}], "synonyms": ["पुच्छं", "पुच्छः"], "synonyms_slp1": ["pucCaM", "pucCaH"]}], "pucCakaRwaka": [{"id": "pucCakaRwaka", "headword": "पुच्छकण्टक", "headword_slp1": "pucCakaRwaka", "fold": "pucCakaRwaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुच्छकण्टक m. (-कः) A scorpion. “वृश्चिके” ।", "gloss_language": "en"}], "synonyms": ["पुच्छकंटक", "पुच्छकण्टकः"], "synonyms_slp1": ["pucCakaMwaka", "pucCakaRwakaH"]}], "pucCajaha": [{"id": "pucCajAha", "headword": "पुच्छजाह", "headword_slp1": "pucCajAha", "fold": "pucCajaha", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुच्छजाह n. (-हं) The root of the tail.", "gloss_language": "en"}]}], "pucCawi": [{"id": "pucCawi", "headword": "पुच्छटि", "headword_slp1": "pucCawi", "fold": "pucCawi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुच्छटि(टी) f. (-टि or टी) Snapping or cracking the fingers. E.\nपुच्छ-अटि वा ङीप् ।", "gloss_language": "en"}], "synonyms": ["पुच्छटिः"], "synonyms_slp1": ["pucCawiH"]}], "pucCin": [{"id": "pucCin", "headword": "पुच्छिन्", "headword_slp1": "pucCin", "fold": "pucCin", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुच्छिन् mfn. (-च्छी-च्छिनी-च्छि) Having a tail.\n m. (-च्छी) A cock.\n E. पुच्छ a tail, and इनि aff.", "gloss_language": "en"}]}]}