{"tunda": [{"id": "tunda", "headword": "तुन्द", "headword_slp1": "tunda", "fold": "tunda", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्द n. (-न्दं) The belly.\n f. (-न्दी) The navel: see तुण्डि.\n E. तुद् to torment,\nक affix, and नुम् augment.", "gloss_language": "en"}], "synonyms": ["तुंद", "तुंदं", "तुन्दं", "तुन्दः"], "synonyms_slp1": ["tuMda", "tuMdaM", "tundaM", "tundaH"]}], "tundakupi": [{"id": "tundakUpI", "headword": "तुन्दकूपी", "headword_slp1": "tundakUpI", "fold": "tundakupi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दकूपी f. (-पी) The navel.\n E. तुन्द the belly, and कूप a pit, a well, dim.\naffix ङीष्; also with कन् added तुन्दकूपिका f. (-का).", "gloss_language": "en"}], "synonyms": ["तुंदकूपी"], "synonyms_slp1": ["tuMdakUpI"]}], "tundaparimarja": [{"id": "tundaparimArja", "headword": "तुन्दपरिमार्ज", "headword_slp1": "tundaparimArja", "fold": "tundaparimarja", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दपरिमार्ज m. (-र्जः) A lazy man, a sloth, a sluggard: see the next.", "gloss_language": "en"}], "synonyms": ["तुंदपरिमार्ज", "तुन्दपरिमार्ज्जः"], "synonyms_slp1": ["tuMdaparimArja", "tundaparimArjjaH"]}], "tundaparimfja": [{"id": "tundaparimfja", "headword": "तुन्दपरिमृज", "headword_slp1": "tundaparimfja", "fold": "tundaparimfja", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दपरिमृज m. (-जः) A lazy man, a sluggard.\n E. तुन्द the belly, मृज to\nrub, with परि prefixed, and क affix; also with the affix घञ्, तुन्द-\nपरिमार्ज as above; passing his whole time in stroking his sides.", "gloss_language": "en"}], "synonyms": ["तुन्दपरिमृजः"], "synonyms_slp1": ["tundaparimfjaH"]}], "tundavat": [{"id": "tundavat", "headword": "तुन्दवत्", "headword_slp1": "tundavat", "fold": "tundavat", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दवत् mfn. (-वान् वती-वत्) Corpulent, fat.\n E. तुन्द, and मतुप् aff. also\nfrom तुन्दि, तुन्दिवत् ।", "gloss_language": "en"}], "synonyms": ["तुंदवत्", "तुन्दवन्त्"], "synonyms_slp1": ["tuMdavat", "tundavant"]}], "tundi": [{"id": "tundi", "headword": "तुन्दि", "headword_slp1": "tundi", "fold": "tundi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दि n. (-न्दि) The belly.\n f. (-न्दिः) The navel.\n m. (-न्दिः) One of the\nGandharbas or choristers of Svarga.\n E. तुद् to vex or harass, affix\nइन्, and नुम् inserted.", "gloss_language": "en"}], "synonyms": ["तुंदि", "तुन्दिः"], "synonyms_slp1": ["tuMdi", "tundiH"]}], "tundika": [{"id": "tundika", "headword": "तुन्दिक", "headword_slp1": "tundika", "fold": "tundika", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दिक mfn. (-कः-का-कं) Having a large or prominent navel, fat, corpu-\nlent.\n f. (-का) The navel.\n E. तुन्दी the naval. कन् affix, or तुन्द with\nठन् aff.", "gloss_language": "en"}], "synonyms": ["तुंदिक", "तुन्दिकः"], "synonyms_slp1": ["tuMdika", "tundikaH"]}], "tundikara": [{"id": "tundikara", "headword": "तुन्दिकर", "headword_slp1": "tundikara", "fold": "tundikara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दिकर mfn. (-रः-रा-रं) See the preceding.", "gloss_language": "en"}], "synonyms": ["तुंदिकरः", "तुन्दिकरः"], "synonyms_slp1": ["tuMdikaraH", "tundikaraH"]}], "tundita": [{"id": "tundita", "headword": "तुन्दित", "headword_slp1": "tundita", "fold": "tundita", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दित mfn. (तः-ता-तं) Having a large or prominent naval.\n E. तुन्द with\nइतच् affix; also तुन्दिक, तुन्दिल, &c.", "gloss_language": "en"}], "synonyms": ["तुंदित", "तुन्दितः"], "synonyms_slp1": ["tuMdita", "tunditaH"]}], "tundin": [{"id": "tundin", "headword": "तुन्दिन्", "headword_slp1": "tundin", "fold": "tundin", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दिन् mfn. (-न्दी-न्दिनी-न्दि) Having a large or prominent navel.\n E. तुन्द\nwith इनि affix; also तुन्दिक, &c.", "gloss_language": "en"}], "synonyms": ["तुंदिन्"], "synonyms_slp1": ["tuMdin"]}], "tundiBa": [{"id": "tundiBa", "headword": "तुन्दिभ", "headword_slp1": "tundiBa", "fold": "tundiBa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दिभ See तुण्डिभ, &c.", "gloss_language": "en"}], "synonyms": ["तुंदिभ", "तुन्दिभः"], "synonyms_slp1": ["tuMdiBa", "tundiBaH"]}], "tundila": [{"id": "tundila", "headword": "तुन्दिल", "headword_slp1": "tundila", "fold": "tundila", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्दिल See तुण्डिल, &c.", "gloss_language": "en"}], "synonyms": ["तुंदिल", "तुन्दिलः"], "synonyms_slp1": ["tuMdila", "tundilaH"]}], "tuna": [{"id": "tunna", "headword": "तुन्न", "headword_slp1": "tunna", "fold": "tuna", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्न mfn. (-न्नः-न्ना-न्नं)\n 1. Tormented, vexed, injured.\n 2. Cut, broken,\ncut down, &c.\n m. (-न्नः) Toon or Tuna, a tree of which the wood\nbears some resemblance to mahogany, and is used for furniture,\n&c. (Cedrela tunna.)\n E. तुद् to vex, affix क्त ।", "gloss_language": "en"}], "synonyms": ["तुन्नः"], "synonyms_slp1": ["tunnaH"]}], "tunavaya": [{"id": "tunnavAya", "headword": "तुन्नवाय", "headword_slp1": "tunnavAya", "fold": "tunavaya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्नवाय m. (-यः) A taylor.\n E. तुन्न cut, (cloth, &c.) and वे to sew, affix अण्.", "gloss_language": "en"}], "synonyms": ["तुन्नवायः"], "synonyms_slp1": ["tunnavAyaH"]}], "tunasevani": [{"id": "tunnasevanI", "headword": "तुन्नसेवनी", "headword_slp1": "tunnasevanI", "fold": "tunasevani", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "तुन्नसेवनी f. (-नी) A suture of the skull.\n E. तुन्न cut, and सेवनी a suture. तुन्नं\nछिन्नं सीव्यते अनया सिव-करणे ल्युट् ङीष् ।", "gloss_language": "en"}]}], "tu