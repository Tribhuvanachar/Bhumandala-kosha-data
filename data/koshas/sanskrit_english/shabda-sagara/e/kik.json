{"kiki": [{"id": "kiki", "headword": "किकि", "headword_slp1": "kiki", "fold": "kiki", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "किकि m. (-किः) A blue jay,\n E. कि an imitative sound; the word being\nrepeated; or कै to emit a sound, and कि affix; also किकीदीवि,\nकिकी, &c.", "gloss_language": "en"}], "synonyms": ["किकिः"], "synonyms_slp1": ["kikiH"]}, {"id": "kIki", "headword": "कीकि", "headword_slp1": "kIki", "fold": "kiki", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कीकि m. (-किः) A blue jay: see किकि.", "gloss_language": "en"}], "synonyms": ["कीकिः"], "synonyms_slp1": ["kIkiH"]}], "kikidivi": [{"id": "kikidivi", "headword": "किकिदिवि", "headword_slp1": "kikidivi", "fold": "kikidivi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "किकिदिवि m. (-विः) The blue jay.\n E. किकि, an imitative sound and दिव् to\nplay, कि affix; also in other forms किकि, किकिदिव, किकिदीवि,\nकिकीदिवी.", "gloss_language": "en"}], "synonyms": ["किकिदिविः"], "synonyms_slp1": ["kikidiviH"]}, {"id": "kikIdIvi", "headword": "किकीदीवि", "headword_slp1": "kikIdIvi", "fold": "kikidivi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "किकीदीवि m. (-विः) See किकिदिवि.", "gloss_language": "en"}], "synonyms": ["किकीदीविः"], "synonyms_slp1": ["kikIdIviH"]}], "kikidiva": [{"id": "kikIdiva", "headword": "किकीदिव", "headword_slp1": "kikIdiva", "fold": "kikidiva", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "किकीदिव m. (-वः) See the preceding. E. As before, अच् aff.", "gloss_language": "en"}], "synonyms": ["किकीदिवः"], "synonyms_slp1": ["kikIdivaH"]}], "kikawa": [{"id": "kIkawa", "headword": "कीकट", "headword_slp1": "kIkawa", "fold": "kikawa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कीकट mfn. (-टः-टी-टं)\n 1. Miserly, avaricious.\n 2. Poor, needy.\n m. (-टः)\n 1.\nA country, (Behar;) or m. plu. (-टाः) its inhabitants.\n 2