{"aKu": [{"id": "AKu", "headword": "आखु", "headword_slp1": "AKu", "fold": "aKu", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखु m. (-खुः)\n 1. A rat, a mouse.\n 2. A hog.\n 3. A thief.\n 4. A sort of tree:\nsee देवताड.\n E. आङ्, खन् to dig, and कु Unādi aff.", "gloss_language": "en"}], "synonyms": ["आखुः"], "synonyms_slp1": ["AKuH"]}], "aKukarRi": [{"id": "AKukarRI", "headword": "आखुकर्णी", "headword_slp1": "AKukarRI", "fold": "aKukarRi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुकर्णी f. (-र्णी) The name of a plant, (Salvinia cucullata.)\n E. आखु a\nmouse, and कर्ण an ear; the leaves are compared to the ears of a\nmouse.", "gloss_language": "en"}]}], "aKuga": [{"id": "AKuga", "headword": "आखुग", "headword_slp1": "AKuga", "fold": "aKuga", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुग m. (-गः)\n 1. A name of GANESA.\n 2. A name of KĀRTIKEYA. E.\nआखु a rat, and ग who goes; GANESA is represented riding on a rat.", "gloss_language": "en"}], "synonyms": ["आखुगः"], "synonyms_slp1": ["AKugaH"]}], "aKuGata": [{"id": "AKuGAta", "headword": "आखुघात", "headword_slp1": "AKuGAta", "fold": "aKuGata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुघात m. (-तः) A Śūdra or man of low caste and profession, lit. a ratcatcher.\nE. आखु and घात a blow.", "gloss_language": "en"}], "synonyms": ["आखुघातः"], "synonyms_slp1": ["AKuGAtaH"]}], "aKuparRika": [{"id": "AKuparRikA", "headword": "आखुपर्णिका", "headword_slp1": "AKuparRikA", "fold": "aKuparRika", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुपर्णिका f. (-का) A plant: see आखुकर्णी.\n E. आखु and पर्ण a leaf.", "gloss_language": "en"}]}], "aKuparRi": [{"id": "AKuparRI", "headword": "आखुपर्णी", "headword_slp1": "AKuparRI", "fold": "aKuparRi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुपर्णी f. (-र्णी) See the preceding.", "gloss_language": "en"}]}], "aKupasaRa": [{"id": "AKupAzARa", "headword": "आखुपाषाण", "headword_slp1": "AKupAzARa", "fold": "aKupasaRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुपाषाण m. (-णः) A kind of mineral, a loadstone.\n E. आखु and पाषाण a\nstone.", "gloss_language": "en"}], "synonyms": ["आखुपाषाणः"], "synonyms_slp1": ["AKupAzARaH"]}], "aKuBuj": [{"id": "AKuBuj", "headword": "आखुभुज्", "headword_slp1": "AKuBuj", "fold": "aKuBuj", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुभुज् m. (-भुक्) A cat.\n E. आखु and भुज् who eats.", "gloss_language": "en"}]}], "aKuraTa": [{"id": "AKuraTa", "headword": "आखुरथ", "headword_slp1": "AKuraTa", "fold": "aKuraTa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुरथ m. (-थः) A name of GANESA.\n E. आखु, and रथ a carriage; whose\nvehicle is a rat.", "gloss_language": "en"}], "synonyms": ["आखुरथः"], "synonyms_slp1": ["AKuraTaH"]}], "aKuvisaha": [{"id": "AKuvizahA", "headword": "आखुविषहा", "headword_slp1": "AKuvizahA", "fold": "aKuvisaha", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखुविषहा f. (-हा) A kind of grass, (Andropogon serratum.)\n E. आखु, विष\nvenom, and हा what destroys; considered as a remedy for the bite\nof a rat.", "gloss_language": "en"}]}], "aKutTa": [{"id": "AKUtTa", "headword": "आखूत्थ", "headword_slp1": "AKUtTa", "fold": "aKutTa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आखूत्थ m. (-त्थः) The rising up or coming of rats, a swarm of rats. E.\nआखु and उत्थ from उत् and स्था with क aff.", "gloss_language": "en"}], "synonyms": ["आखूत्थः"], "synonyms_slp1": ["AKUtTaH"]}]}