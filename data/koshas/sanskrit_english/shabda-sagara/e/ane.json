{"aneka": [{"id": "aneka", "headword": "अनेक", "headword_slp1": "aneka", "fold": "aneka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अनेक mfn. (-कः-का-कं) Many, much, not one.\n E. अन् neg. एक one.", "gloss_language": "en"}], "synonyms": ["अनेकं"], "synonyms_slp1": ["anekaM"]}], "anekakala": [{"id": "anekakAla", "headword": "अनेककाल", "headword_slp1": "anekakAla", "fold": "anekakala", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अनेककाल adv.\n n. (-लं) A long time.\n E. अनेक, and काल time.", "gloss_language": "en"}]}], "anekaja": [{"id": "anekaja", "headword": "अनेकज", "headword_slp1": "anekaja", "fold": "anekaja", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अनेकज m. (-जः) A bird, born more than once; or in the shell, and\nupon being hatched.\n E. अनेक more than one, and ज what is born.", "gloss_language": "en"}], "synonyms": ["अनेकजः"], "synonyms_slp1": ["anekajaH"]}], "anekata": [{"id": "anekatA", "headword": "अनेकता", "headword_slp1": "anekatA", "fold": "anekata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अनेकता f. (-ता) Muchness, manifold condition; also अनेकत्व.\n E. अनेक,\nand ता or त्व aff.", "gloss_language": "en"}]}], "anekakara": [{"id": "anekAkAra", "headword": "अनेकाकार", "headword_slp1": "anekAkAra", "fold": "anekakara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अनेकाकार mfn. (-रः-रा-रं) Multiform.\n E. अनेक and आकार form.", "gloss_language": "en"}]}], "anekapa": [{"id": "anekapa", "headword": "अनेकप", "headword_slp1": "anekapa", "fold": "anekapa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अनेकप mf. (-पः-पा) An elephant.\n E. अनेक various, from अन् neg. एक\none, and प from पा who drinks, who drinks with his trunk, and\nwith his mouth.", "gloss_language": "en"}], "synonyms": ["अनेकपः"], "synonyms_slp1": ["anekapaH"]}], "anekarupa": [{"id": "anekarUpa", "headwo