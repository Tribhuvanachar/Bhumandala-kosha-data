bda-sagara", "senses": [{"gloss": "मुखपूरण n. (-णं)\n 1. A mouthful of water for rinsing the mouth.\n 2. A\nmouthful.\n 3. Filling the mouth.\n E. मुख the mouth, पूरण filling.", "gloss_language": "en"}], "synonyms": ["मुखपूरणं"], "synonyms_slp1": ["muKapUraRaM"]}], "muKapriya": [{"id": "muKapriya", "headword": "मुखप्रिय", "headword_slp1": "muKapriya", "fold": "muKapriya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखप्रिय m. (-यः) An orange.", "gloss_language": "en"}], "synonyms": ["मुखप्रियः"], "synonyms_slp1": ["muKapriyaH"]}], "muKabanDana": [{"id": "muKabanDana", "headword": "मुखबन्धन", "headword_slp1": "muKabanDana", "fold": "muKabanDana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखबन्धन n. (-नं)\n 1. A preface.\n 2. A lid.", "gloss_language": "en"}], "synonyms": ["मुखबंधन"], "synonyms_slp1": ["muKabaMDana"]}], "muKaBusaRa": [{"id": "muKaBUzaRa", "headword": "मुखभूषण", "headword_slp1": "muKaBUzaRa", "fold": "muKaBusaRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखभूषण n. (-णं) Betel, the leaf of the piper-betel eaten with the Areca\nnut, catechu and caustic lime, &c.\n E. मुख the mouth, भूषण an\nornament.", "gloss_language": "en"}], "synonyms": ["मुखभूषणं"], "synonyms_slp1": ["muKaBUzaRaM"]}], "muKaBeda": [{"id": "muKaBeda", "headword": "मुखभेद", "headword_slp1": "muKaBeda", "fold": "muKaBeda", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखभेद m. (-दः) Distortion of the face.", "gloss_language": "en"}], "synonyms": ["मुखभेदः"], "synonyms_slp1": ["muKaBedaH"]}], "muKampraca": [{"id": "muKampraca", "headword": "मुखम्प्रच", "headword_slp1": "muKampraca", "fold": "muKampraca", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखम्प्रच m. (-चः) A beggar, a petitioner.\n E. मुख the mouth, पच who\nripens, (his purpose,) from पच् with खच् aff.", "gloss_language": "en"}]}], "muKayantraRa": [{"id": "muKayant