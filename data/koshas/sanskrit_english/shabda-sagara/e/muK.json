{"muKa": [{"id": "muKa", "headword": "मुख", "headword_slp1": "muKa", "fold": "muKa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुख mfn. (-खः-खा-खं)\n 1. First, initial.\n 2. Chief, pre-eminent, principal.\nn. (-खं)\n 1. The mouth.\n 2. The face.\n 3. The entrance to a house.\n4. Commencement.\n 5. A means, an expedient.\n 6. Sound.\n 7. The\nopening division of a drama, the first act, &c.\n 8. The previous\nor preparatory incidents of a drama.\n 9. A direction, a quarter.\n10. Opening, entrance.\n 11. The head, the top, the tip.\n 12. The\nedge of any sharp instrument.\n 13. Utterance.\n 14. Source, cause,\noccasion.\n 15. The Vedas, scripture.\n m. (-खः) The beak of a bird.\nE. खन् to dig, Unādi aff. अच् with the power of ड, by which the\nfinal is rejected, मुट initial augment.", "gloss_language": "en"}], "synonyms": ["मुखं", "मुखः"], "synonyms_slp1": ["muKaM", "muKaH"]}], "muKakamala": [{"id": "muKakamala", "headword": "मुखकमल", "headword_slp1": "muKakamala", "fold": "muKakamala", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखकमल n. (-लं) A lotus-like face.", "gloss_language": "en"}]}], "muKaKura": [{"id": "muKaKura", "headword": "मुखखुर", "headword_slp1": "muKaKura", "fold": "muKaKura", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखखुर m. (-रः) A tooth.", "gloss_language": "en"}], "synonyms": ["मुखखुरः"], "synonyms_slp1": ["muKaKuraH"]}], "muKaganDaka": [{"id": "muKaganDaka", "headword": "मुखगन्धक", "headword_slp1": "muKaganDaka", "fold": "muKaganDaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मुखगन्धक m. (-कः) An onion.\n E. मुख the mouth, and गन्धक scenting.", "gloss_language": "en"}], "synonyms": ["मुखगंधक", "मुखगन्धकः"], "synonyms_slp1": ["muKagaMDaka", "muKaganDakaH"]}], "muKaGaRwa": [{"id": "muKaGaRwA", "headword": "मुखघण्टा", "headword_slp1": "muKaGaRwA", "fold": "muKaGaRwa", "headword_language": "sa", "source": "shabda-sag