guage": "en"}], "synonyms": ["पुनर्वसुः", "पुनर्व्वसुः"], "synonyms_slp1": ["punarvasuH", "punarvvasuH"]}, {"id": "punarvasU", "headword": "पुनर्वसू", "headword_slp1": "punarvasU", "fold": "punarvasu", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुनर्वसू m. du. (-सूः) An asterism; see the last.", "gloss_language": "en"}], "synonyms": ["पुनर्व्वसू"], "synonyms_slp1": ["punarvvasU"]}], "punaksatra": [{"id": "punnakzattra", "headword": "पुन्नक्षत्त्र", "headword_slp1": "punnakzattra", "fold": "punaksatra", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पुन्नक्षत्त्र n. (-त्त्रं) An asterism under which males are procreated.\n E. पुं\nfor पुमस्, and नक्षत्त्र asterism.", "gloss_language": "en"}]}], "puna": [{"id": "pUna", "headword": "पून", "headword_slp1": "pUna", "fold": "puna", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "पून mfn. (-नः-ना-नं) Lost, destroyed.\n E. पू to purify aff. क्त, deriv. irr.\n“पूञो विनाशे” पा० क्तस्य नः ।", "gloss_language": "en"}], "synonyms": ["पूनः"], "synonyms_slp1": ["pUnaH"]}]}