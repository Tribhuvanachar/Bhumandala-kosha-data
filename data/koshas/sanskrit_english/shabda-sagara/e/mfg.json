{"mfg": [{"id": "mfg", "headword": "मृग्", "headword_slp1": "mfg", "fold": "mfg", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृग् r. 4th cl. (मृग्यति) r. 10th cl. (मृगयते)\n 1. To seek, or pursue, to\nhunt, to chase.\n 2. To investigate.\n 3. To beg any thing from\nany body.", "gloss_language": "en"}]}], "mfga": [{"id": "mfga", "headword": "मृग", "headword_slp1": "mfga", "fold": "mfga", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृग m. (-गः)\n 1. A deer, an antelope.\n 2. An animal in general.\n 3. Re-\nsearch, inquiry, investigation.\n 4. Asking, soliciting, begging.\n 5.\nA kind of elephant, one with white marks on his forehead.\n 6. The\nfifth lunar constellation, more usually Mṛgaśiras: see मृगशिरस्.\n 7.\nThe month in which the moon is full in the constellation Mṛgas-\nīras.\n 8. A particular sacrifice.\n 9. Musk.\n 10. Hunting, chase.\n 11.\nOne of the four classes into which men are divided, (in erotic\nworks.)\n 12. The spots of the moon represented as an antelope.\nf. (-गी)\n 1. A description of woman, perhaps the same as the\none termed चित्रिणी, the corresponding female to the male\ncalled मृग.\n 2. A female deer, a doe.\n 3. A species of the Madhya\nmetre.\n 4. Epilepsy.\n E. मृग् to search, to chase, aff. क ।", "gloss_language": "en"}], "synonyms": ["मृगः"], "synonyms_slp1": ["mfgaH"]}], "mfgaksira": [{"id": "mfgakzIra", "headword": "मृगक्षीर", "headword_slp1": "mfgakzIra", "fold": "mfgaksira", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगक्षीर n. (-रं) Doe's milk.\n E. मृग for मृगी a female deer, and क्षीर milk.", "gloss_language": "en"}], "synonyms": ["मृगक्षीरं"], "synonyms_slp1": ["mfgakzIraM"]}], "mfgagamini": [{"id": "mfgagAminI", "headword": "मृगगामिनी", "headword_slp1": "mfgagAminI", "fold": "mfgagamini", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगगामिनी f. (-नी) A kind of medical plant, “विडङ्गायाम् ।”", "gloss_language": "en"}]}], "mfgacEwaka": [{"id": "mfgacEwaka", "headword": "मृगचैटक", "headword_slp1": "mfgacEwaka", "fold": "mfgacEwaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगचैटक m. (-कः) A wild or pole-cat. “खटाश् ।”", "gloss_language": "en"}]}], "mfgajala": [{"id": "mfgajala", "headword": "मृगजल", "headword_slp1": "mfgajala", "fold": "mfgajala", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगजल n. (-लं) Mirage.", "gloss_language": "en"}]}], "mfgajalasnana": [{"id": "mfgajalasnAna", "headword": "मृगजलस्नान", "headword_slp1": "mfgajalasnAna", "fold": "mfgajalasnana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगजलस्नान n. (-नं) Bathing in the waters of a mirage, (i. e.) an impossibility.", "gloss_language": "en"}]}], "mfgajalika": [{"id": "mfgajAlikA", "headword": "मृगजालिका", "headword_slp1": "mfgajAlikA", "fold": "mfgajalika", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगजालिका f. (-का) A net for confining deer.\n E. मृग a deer, जालिका a net.", "gloss_language": "en"}]}], "mfgajivana": [{"id": "mfgajIvana", "headword": "मृगजीवन", "headword_slp1": "mfgajIvana", "fold": "mfgajivana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगजीवन m. (-नः) A hunter.\n E. मृग a deer, जीवन living, subsistence.", "gloss_language": "en"}], "synonyms": ["मृगजीवनः"], "synonyms_slp1": ["mfgajIvanaH"]}], "mfgaRa": [{"id": "mfgaRa", "headword": "मृगण", "headword_slp1": "mfgaRa", "fold": "mfgaRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगण nf. (-णं-णा) Search, inquiry, research.\n E. मृग् to search for or\nafter, affs. युच् and टाप् ।", "gloss_language": "en"}]}], "mfgatfs": [{"id": "mfgatfz", "headword": "मृगतृष्", "headword_slp1": "mfgatfz", "fold": "mfgatfs", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगतृष् f. (-तृट्) Vapour floating over sands or deserts, and appearing\nat a distance like water.\n E. मृग a deer, तृष् to thirst, aff. क्विप्; deer\nbeing deceived by it; also with अङ् and टाप् aff, मृगतृषा, and with\nतृष्णा thirst, मृगतृष्णा ।", "gloss_language": "en"}]}], "mfgatfsa": [{"id": "mfgatfzA", "headword": "मृगतृषा", "headword_slp1": "mfgatfzA", "fold": "mfgatfsa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगतृषा f. (-षा) Mirage: see the last.", "gloss_language": "en"}]}], "mfgatfsRa": [{"id": "mfgatfzRA", "headword": "मृगतृष्णा", "headword_slp1": "mfgatfzRA", "fold": "mfgatfsRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगतृष्णा f. (-ष्णा) Sultry vapour, mirage: see the last.", "gloss_language": "en"}]}], "mfgatfsRika": [{"id": "mfgatfzRikA", "headword": "मृगतृष्णिका", "headword_slp1": "mfgatfzRikA", "fold": "mfgatfsRika", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगतृष्णिका f. (-का) Sultry vapour.\n E. कन् added to the last.", "gloss_language": "en"}]}], "mfgadansaka": [{"id": "mfgadaMSaka", "headword": "मृगदंशक", "headword_slp1": "mfgadaMSaka", "fold": "mfgadansaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगदंशक m. (-कः) A dog.\n E. मृग deer, and दंशक who bites.", "gloss_language": "en"}], "synonyms": ["मृगदंशकः"], "synonyms_slp1": ["mfgadaMSakaH"]}], "mfgadfs": [{"id": "mfgadfS", "headword": "मृगदृश्", "headword_slp1": "mfgadfS", "fold": "mfgadfs", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगदृश् f. (-दृक्) A deer-eyed woman.", "gloss_language": "en"}]}], "mfgadyut": [{"id": "mfgadyut", "headword": "मृगद्युत्", "headword_slp1": "mfgadyut", "fold": "mfgadyut", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मृगद्युत् m. (-द्युत्) A hunter.\n E. मृग, द्यु to go, क्विप् aff., तुक् added.", "gloss_language": "en"}]}], "mfgadyu": [{"id": "mfgadyU", "headword": "मृगद्यू", "headword_slp1": "mfgadyU"