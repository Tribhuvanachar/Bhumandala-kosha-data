{"Kura": [{"id": "Kura", "headword": "खुर", "headword_slp1": "Kura", "fold": "Kura", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "खुर r. 6th cl. (खुरति) To cut, to scratch.", "gloss_language": "en"}, {"gloss": "खुर m. (-रः)\n 1. A hoof, a horse's hoof, &c.\n 2. A razor.\n 3. The foot of a\nbedstead; also क्षुर 4. A sort of perfume, commonly Nakhi, ap-\nparently a dried shell fish, and of the shape of a hoof.\n E. खुर् to\ncut, रन् Uṇādi affix, the radical र is dropped.", "gloss_language": "en"}], "synonyms": ["खुरः"], "synonyms_slp1": ["KuraH"]}], "Kuraka": [{"id": "Kuraka", "headword": "खुरक", "headword_slp1": "Kuraka", "fold": "Kuraka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "खुरक m. (-कः) A plant commonly Tila.\n E. कन् added to the preceding.", "gloss_language": "en"}], "synonyms": ["खुरकः"], "synonyms_slp1": ["KurakaH"]}, {"id": "KurAka", "headword": "खुराक", "headword_slp1": "KurAka", "fold": "Kuraka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "खुराक m. (-कः) An animal in general.\n E. खुर् to cut, and आक aff.", "gloss_language": "en"}], "synonyms": ["खुराकः"], "synonyms_slp1": ["KurAkaH"]}], "Kuraksepa": [{"id": "Kurakzepa", "headword": "खुरक्षेप", "headword_slp1": "Kurakzepa", "fold": "Kuraksepa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "खुरक्षेप m. (-पः) A kick, kicking.\n E. खुर, and क्षेप throwing.", "gloss_language": "en"}], "synonyms": ["खुरक्षेपः"], "synonyms_slp1": ["KurakzepaH"]}], "KuraRas": [{"id": "KuraRas", "headword": "खुरणस्", "headword_slp1": "KuraRas", "fold": "KuraRas", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "खुरणस् mfn. (-णाः-णाः-णः) Flat-nosed, having a nose like a horse's hoof,\nE. खुर a hoof, and नस् deriv. of नासिका a nose; also with a final\nvowel खुरणस mfn. (-सः-सा-सं.)", "gloss_language": "en"}]}], "Kurapadavi": [{"id": "KurapadavI", "headword": "खुरपदवी", "headword