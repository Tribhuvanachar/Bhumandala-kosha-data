{"kaNka": [{"id": "kaNka", "headword": "कङ्क", "headword_slp1": "kaNka", "fold": "kaNka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्क m. (-ङ्कः)\n 1. A heron.\n 2. YAMA or death.\n 3. A false or pretended\nBrahman.\n 4. A title of YUDISHṬHIRA, from his assuming the dis-\nguise of a Brahman.\n 5. A man of the second or military tribe.\n 6.\nOne of the eighteen divisions of the continent.\n 7. The brother of\nKANSA.\n 8. A kind of mango.\n f. (-ङ्का)\n 1. A daughter of UGRASENA.\n2. A sort of sandal.\n E. ककि to go, अच् aff.", "gloss_language": "en"}], "synonyms": ["कंक", "कंकः", "कङ्कः"], "synonyms_slp1": ["kaMka", "kaMkaH", "kaNkaH"]}, {"id": "kaNkA", "headword": "कङ्का", "headword_slp1": "kaNkA", "fold": "kaNka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्का f. (-ङ्का) Scent of the lotus.", "gloss_language": "en"}], "synonyms": ["कंका"], "synonyms_slp1": ["kaMkA"]}], "kaNkawa": [{"id": "kaNkawa", "headword": "कङ्कट", "headword_slp1": "kaNkawa", "fold": "kaNkawa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कट m. (-टः) Mail, defensive armour.\n E. ककि to go, Uṇādi affix अटन्,\nand with कन् added कङ्कटक.", "gloss_language": "en"}], "synonyms": ["कंकट", "कंकटः", "कङ्कटः"], "synonyms_slp1": ["kaMkawa", "kaMkawaH", "kaNkawaH"]}], "kaNkaweri": [{"id": "kaNkawerI", "headword": "कङ्कटेरी", "headword_slp1": "kaNkawerI", "fold": "kaNkaweri", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कटेरी f. (-री) Turmerick.", "gloss_language": "en"}]}], "kaNkaRa": [{"id": "kaNkaRa", "headword": "कङ्कण", "headword_slp1": "kaNkaRa", "fold": "kaNkaRa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कण mn. (-णः-णं)\n 1. A bracelet or ornament of the wrist.\n 2. A string\nor ribband tied round the wrist.\n 3. An ornament or trinket.\n 4. A\ncrest.\n f. (-णी) A small bell or tinkling ornament; also किङ्किणी and\nकङ्कणीका.\