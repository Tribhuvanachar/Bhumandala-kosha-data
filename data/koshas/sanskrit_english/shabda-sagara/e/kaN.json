": "kaNkaloqya", "fold": "kaNkaloqya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कलोड्य n. (-ड्यं) A kind of drug.", "gloss_language": "en"}], "synonyms": ["कंकलोड्यं", "कङ्कलोड्यं"], "synonyms_slp1": ["kaMkaloqyaM", "kaNkaloqyaM"]}], "kaNkasatru": [{"id": "kaNkaSatru", "headword": "कङ्कशत्रु", "headword_slp1": "kaNkaSatru", "fold": "kaNkasatru", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कशत्रु m. (-त्रुः) A plant, (Hedysarnm gangeticum:) see शालपर्णी.\n E. कङ्क\na heron, and शत्रु an enemy.", "gloss_language": "en"}], "synonyms": ["कङ्कशत्रुः"], "synonyms_slp1": ["kaNkaSatruH"]}], "kaNkasaya": [{"id": "kaNkaSAya", "headword": "कङ्कशाय", "headword_slp1": "kaNkaSAya", "fold": "kaNkasaya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कशाय m. (-यः) A dog.\n E. कङ्क a heron, and शाय sleeping, sleeping\nlike a heron, from शीङ् and घञ् aff.", "gloss_language": "en"}], "synonyms": ["कंकशाय", "कङ्कशायः"], "synonyms_slp1": ["kaMkaSAya", "kaNkaSAyaH"]}], "kaNkala": [{"id": "kaNkAla", "headword": "कङ्काल", "headword_slp1": "kaNkAla", "fold": "kaNkala", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्काल m. (-लः) The skeleton.\n E. ककि to go, कालच् aff.", "gloss_language": "en"}], "synonyms": ["कंकाल", "कंकालं", "कंकालः", "कङ्कालः"], "synonyms_slp1": ["kaMkAla", "kaMkAlaM", "kaMkAlaH", "kaNkAlaH"]}], "kaNkalamalin": [{"id": "kaNkAlamAlin", "headword": "कङ्कालमालिन्", "headword_slp1": "kaNkAlamAlin", "fold": "kaNkalamalin", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कङ्कालमालिन् m. (-ली) A title of ŚIVA.\n E. कङ्काल, माला a necklace, and इनि\naffix; whose necklace is formed of bones.", "gloss_language": "en"}], "synonyms": ["कंकालमालिन्"], "synonyms_slp1": ["kaMkAlamAlin"]}], "kaNku": [{"id": "kaNku", "headword": "कङ्कु", "headword_slp1": "kaNku", "fold": "kaNku", "headword_language": "sa", "source": "shabda-s