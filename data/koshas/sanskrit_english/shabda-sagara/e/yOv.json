{"yOvata": [{"id": "yOvata", "headword": "यौवत", "headword_slp1": "yOvata", "fold": "yOvata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "यौवत n. (-तं)\n 1. Measure in general.\n 2. An assemblage of young wo-\nmen.\n 3. The state of being a youthful woman.\n E. यु to mix, deriv.\nirr.; or युवती a young woman, aff. अण् ।", "gloss_language": "en"}], "synonyms": ["यौवतं"], "synonyms_slp1": ["yOvataM"]}], "yOvana": [{"id": "yOvana", "headword": "यौवन", "headword_slp1": "yOvana", "fold": "yOvana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "यौवन n. (-नं)\n 1. Youth, manhood, prime of life, puberty.\n 2. An assem-\nblage of young women.\n E. युवन् young, अण् aff.; with कन् यौवनक ।", "gloss_language": "en"}], "synonyms": ["यौवनं"], "synonyms_slp1": ["yOvanaM"]}], "yOvanakaRwaka": [{"id": "yOvanakaRwaka", "headword": "यौवनकण्टक", "headword_slp1": "yOvanakaRwaka", "fold": "yOvanakaRwaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "यौवनकण्टक m. (-कः) Pimples on the face, especially in young persons.\nE. यौवन youth, and कण्टक a thorn.", "gloss_language": "en"}], "synonyms": ["यौवनकण्टकं", "यौवनकण्टकः"], "synonyms_slp1": ["yOvanakaRwakaM", "yOvanakaRwakaH"]}], "yOvanadarpa": [{"id": "yOvanadarpa", "headword": "यौवनदर्प", "headword_slp1": "yOvanadarpa", "fold": "yOvanadarpa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "यौवनदर्प m. (-र्पः) Pride of youth, rashness, conceit.\n E. यौवन, दर्प pride.", "gloss_language": "en"}], "synonyms": ["यौवनदर्पः"], "synonyms_slp1": ["yOvanadarpaH"]}], "yOvanadasa": [{"id": "yOvanadaSA", "headword": "यौवनदशा", "headword_slp1": "yOvanadaSA", "fold": "yOvanadasa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "यौवनदशा f. (-शा) The period of youth.\n E. यौवन, दशा state.", "gloss_language": "en"}]}], "yOvanapiqaka": [{"id": "yOvanapiqakA", "headword": "यौवनपिडका", "headword_slp1": "yOvanapiqakA