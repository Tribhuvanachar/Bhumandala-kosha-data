{"aNka": [{"id": "aNka", "headword": "अङ्क", "headword_slp1": "aNka", "fold": "aNka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्क(क, त) r. 10th cl. (अङ्कयति)\n 1. To number or count.\n 2. To mark.", "gloss_language": "en"}, {"gloss": "अङ्क n. (ङ्कं)\n 1. A mark or spot.\n 2. The flank or part above the hips.\n3. A species of dramatic entertainment.\n 4. The act of a play, &c.\n5. Fault, offence.\n 6. A line, a stroke.\n 7. Mimic war or conflict.\n 8.\nornament, decoration.\n 9. Place, abode.\n 10. Proximity, proximate.\n11. A chapter or section.\n 12. The body.\n 13. A cypher, an arithme-\ntical sign.\n E. अञ्च to go, and the Uṇādi affix क; or अङ्क to stain or\nspot, अच् aff.", "gloss_language": "en"}], "synonyms": ["अंक", "अंकः", "अङ्कः"], "synonyms_slp1": ["aMka", "aMkaH", "aNkaH"]}], "aNkati": [{"id": "aNkati", "headword": "अङ्कति", "headword_slp1": "aNkati", "fold": "aNkati", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कति m. (तिः)\n 1. A Brahman who maintains a sacred fire 2. A name of\nBRAHMĀ.\n 3. Fire.\n 4. Air, wind.\n E. अञ्च to go, and the Uṇādi aff.\nअति; च being changed to क.", "gloss_language": "en"}], "synonyms": ["अंकति", "अंकतिः", "अङ्कतिः"], "synonyms_slp1": ["aMkati", "aMkatiH", "aNkatiH"]}], "aNkana": [{"id": "aNkana", "headword": "अङ्कन", "headword_slp1": "aNkana", "fold": "aNkana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कन n. (नं)\n 1. Cyphering, writing or making cyphers.\n 2. Stamping,\nimpressing, making marks,\n E. अङ्क to mark, ल्युट् aff.", "gloss_language": "en"}], "synonyms": ["अंकन", "अंकनं", "अङ्कनं"], "synonyms_slp1": ["aMkana", "aMkanaM", "aNkanaM"]}], "aNkaniya": [{"id": "aNkanIya", "headword": "अङ्कनीय", "headword_slp1": "aNkanIya", "fold": "aNkaniya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कनीय mfn. (-यः-या-यं)\n 1. To be marked.\n 2. To be numbered.\n E. अङ्क\nto mark, अनीयर् aff.", "gloss_language": "en"}]}], "aNkaparivartana": [{"id": "aNkaparivarttana", "headword": "अङ्कपरिवर्त्तन", "headword_slp1": "aNkaparivarttana", "fold": "aNkaparivartana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कपरिवर्त्तन n. (-नः) Turning on the side.\n E. अङ्क and परिवर्त्तन turning.", "gloss_language": "en"}], "synonyms": ["अङ्कपरिवर्तन"], "synonyms_slp1": ["aNkaparivartana"]}], "aNkapalika": [{"id": "aNkapAlikA", "headword": "अङ्कपालिका", "headword_slp1": "aNkapAlikA", "fold": "aNkapalika", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कपालिका f. (का) An embrace, embracing.\n E. अङ्क the flank, and पालिका\nor पाली, nourishing.", "gloss_language": "en"}], "synonyms": ["अंकपालिका"], "synonyms_slp1": ["aMkapAlikA"]}], "aNkapali": [{"id": "aNkapAlI", "headword": "अङ्कपाली", "headword_slp1": "aNkapAlI", "fold": "aNkapali", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कपाली f. (-ली)\n 1. An embrace, embracing.\n 2. A nurse.\n 3. A plant,\n(Piring or Medicago esculenta.) E. See अङ्कपालिका.", "gloss_language": "en"}], "synonyms": ["अंकपाली"], "synonyms_slp1": ["aMkapAlI"]}], "aNkaBaj": [{"id": "aNkaBAj", "headword": "अङ्कभाज्", "headword_slp1": "aNkaBAj", "fold": "aNkaBaj", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कभाज् mfn. (-भाक्) Resting or placed upon the side or hip.\n E. अङ्क and\nभाज् possessing.", "gloss_language": "en"}], "synonyms": ["अंकभाज्"], "synonyms_slp1": ["aMkaBAj"]}], "aNkayitavya": [{"id": "aNkayitavya", "headword": "अङ्कयितव्य", "headword_slp1": "aNkayitavya", "fold": "aNkayitavya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अङ्कयितव्य mfn. (-व्यः-व्या-व्यं)\n 1. To be marked.\n 2. To be numbered.\n E. अङ्क\nto mark, तव्य aff.", "gloss_language": "en"}]}], "aNkavidya": [{"id": "aNkavidyA", "headword": "अङ्कविद्या", "headword_slp1": "aNkavidyA", "fold": "aNkavidya", "headwor