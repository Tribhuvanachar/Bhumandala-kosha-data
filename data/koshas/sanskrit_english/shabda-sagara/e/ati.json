atidiswa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदिष्ट mfn. (-ष्टः-ष्टा-ष्टं) Substituted, supplementary.\n E. अति over, and\nदिष्ट enjoined.", "gloss_language": "en"}], "synonyms": ["अतिदिष्टः"], "synonyms_slp1": ["atidizwaH"]}], "atiduHsaha": [{"id": "atiduHsaha", "headword": "अतिदुःसह", "headword_slp1": "atiduHsaha", "fold": "atiduHsaha", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदुःसह mfn. (-हः-हा-हं) Intolerable, unbearable, not to be borne or\nendured.\n E. अति and दुःसह painful.", "gloss_language": "en"}]}], "atidurgata": [{"id": "atidurgata", "headword": "अतिदुर्गत", "headword_slp1": "atidurgata", "fold": "atidurgata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदुर्गत mfn. (-तः-ता-तं) In great difficulty or distress.\n E. अति and दुर्गत\nbadly off.", "gloss_language": "en"}]}], "atiduskara": [{"id": "atiduzkara", "headword": "अतिदुष्कर", "headword_slp1": "atiduzkara", "fold": "atiduskara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदुष्कर mfn. (-रः-रा-री-रं) Very arduous, very difficult.\n E. अति and\nदुष्कर difficult.", "gloss_language": "en"}]}], "atidura": [{"id": "atidUra", "headword": "अतिदूर", "headword_slp1": "atidUra", "fold": "atidura", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदूर n. (-रं) A great distance, afar off.\n E. अति, and दूर afar.", "gloss_language": "en"}]}], "atidesa": [{"id": "atideSa", "headword": "अतिदेश", "headword_slp1": "atideSa", "fold": "atidesa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदेश m. (-शः) Substitution, supplement.\n E. अति, and देश direction.", "gloss_language": "en"}], "synonyms": ["अतिदेशः"], "synonyms_slp1": ["atideSaH"]}], "atidosa": [{"id": "atidoza", "headword": "अतिदोष", "headword_slp1": "atidoza", "fold": "atidosa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिदोष m. (-षः) A great fault.", "gloss_language": "en"}]}], "atiDfti": [{"id": "atiDfti", "headword": "अतिधृति", "headword_slp1": "atiDfti", "fold": "atiDfti", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिधृति f. (-तिः) A kind of metre, a stanza of four lines, with nineteen\nsyllables in each line.\n E. अति and धृति another metre.", "gloss_language": "en"}], "synonyms": ["अतिधृतिः"], "synonyms_slp1": ["atiDftiH"]}], "atinO": [{"id": "atinO", "headword": "अतिनौ", "headword_slp1": "atinO", "fold": "atinO", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिनौ mfn. (-नौः-नौः-नु) Landed from a boat.\n E. अति over, beyond, and\nनौ a boat.", "gloss_language": "en"}]}], "atipatana": [{"id": "atipatana", "headword": "अतिपतन", "headword_slp1": "atipatana", "fold": "atipatana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिपतन n. (-नं) Exceeding, going beyond bounds.\n E. अति beyond and\nपत to go, ल्यट् aff.", "gloss_language": "en"}], "synonyms": ["अतिपतनं"], "synonyms_slp1": ["atipatanaM"]}], "atipaTin": [{"id": "atipaTin", "headword": "अतिपथिन्", "headword_slp1": "atipaTin", "fold": "atipaTin", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिपथिन् m. (-पन्था) A good road.\n E. अति, and पथिन् a road; a very\nroad.", "gloss_language": "en"}]}], "atipara": [{"id": "atipara", "headword": "अतिपर", "headword_slp1": "atipara", "fold": "atipara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिपर m. (-रः)\n 1. A great enemy.\n 2. One who has conquered his\nenemy.\n E. अति and परः a foe.", "gloss_language": "en"}], "synonyms": ["अतिपरः"], "synonyms_slp1": ["atiparaH"]}], "atipata": [{"id": "atipAta", "headword": "अतिपात", "headword_slp1": "atipAta", "fold": "atipata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिपात m. (-तः)\n 1. Neglect of duty.\n 2. Transgression, deviation from\nlaws or 