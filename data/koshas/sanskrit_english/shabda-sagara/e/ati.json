{"ati": [{"id": "ati", "headword": "अति", "headword_slp1": "ati", "fold": "ati", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अति ind. Over, beyond, exceeding, much, very much, &c. it implies\ngenerally excess, or preeminence.\n E. अत to go, and इन् aff.", "gloss_language": "en"}]}, {"id": "atti", "headword": "अत्ति", "headword_slp1": "atti", "fold": "ati", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अत्ति f. (-त्तिः) In theatrical language, an elder sister.\n E. अत to go,\nक्तिन् aff.", "gloss_language": "en"}], "synonyms": ["अत्तिः"], "synonyms_slp1": ["attiH"]}, {"id": "Ati", "headword": "आति", "headword_slp1": "Ati", "fold": "ati", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आति m. (-तिः)\n 1. A bird.\n 2. Going.\n E. अत् to go, इण् affix: or Unādi\naffix इन्.", "gloss_language": "en"}], "synonyms": ["आतिः"], "synonyms_slp1": ["AtiH"]}], "atikaTa": [{"id": "atikaTa", "headword": "अतिकथ", "headword_slp1": "atikaTa", "fold": "atikaTa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिकथ mfn. (-थः-था-थं)\n 1. Incredible, unworthy of belief or trust.\n[]\n2. Erring, deviating from the duties of a profession or caste.\n f. (-था)\nIdle or unmeaning speech.\n E. अति excess or exceeding, and कथा\nspeech: some words substitute for this word, इतिकथ q. v.", "gloss_language": "en"}], "synonyms": ["अतिकथः"], "synonyms_slp1": ["atikaTaH"]}], "atikandaka": [{"id": "atikandaka", "headword": "अतिकन्दक", "headword_slp1": "atikandaka", "fold": "atikandaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिकन्दक m. (-कः) A tree. See हस्तिकन्द.", "gloss_language": "en"}], "synonyms": ["अतिकंदकः", "अतिकन्दकः"], "synonyms_slp1": ["atikaMdakaH", "atikandakaH"]}], "atikaya": [{"id": "atikAya", "headword": "अतिकाय", "headword_slp1": "atikAya", "fold": "atikaya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिकाय mfn. (-यः-या-यं) Gigantic.\n E. अति, and काय body.", "gloss_language": "en"}], "synonyms": ["अतिकायः"], "synonyms_slp1": ["atikAyaH"]}], "atikfcCra": [{"id": "atikfcCra", "headword": "अतिकृच्छ्र", "headword_slp1": "atikfcCra", "fold": "atikfcCra", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिकृच्छ्र n. (-च्छ्र)\n 1. A kind of penance, eating a handful of food a day\nfor six days, and fasting three.\n 2. Extreme pain or suffering. E.\nअति, and कृच्छ्र penance.", "gloss_language": "en"}], "synonyms": ["अतिकृच्छ्रः"], "synonyms_slp1": ["atikfcCraH"]}], "atikfti": [{"id": "atikfti", "headword": "अतिकृति", "headword_slp1": "atikfti", "fold": "atikfti", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिकृति f. (-तिः) A kind of metre, a stanza of four lines, with twenty-\nfive syllables to each line.\n E. अति, and कृति another metre.", "gloss_language": "en"}], "synonyms": ["अतिकृतिः"], "synonyms_slp1": ["atikftiH"]}], "atikfsa": [{"id": "atikfSa", "headword": "अतिकृश", "headword_slp1": "atikfSa", "fold": "atikfsa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिकृश mfn. (-शः-शा-शी-शं) Very thin, emaciated.\n E. अति, and कृश thin.", "gloss_language": "en"}]}], "atikrama": [{"id": "atikrama", "headword": "अतिक्रम", "headword_slp1": "atikrama", "fold": "atikrama", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिक्रम m. (-मः)\n 1. Going over or beyond, lit. or fig.\n 2. Surpassing,\nexcelling.\n 3. Transgressing.\n 4. Contrariety, opposition.\n 5. Neglect,\naversion, disregard.\n 6. Privation.\n 7. A groundless demand.\n 8. A\ngallant attack, advance of an army in front of an enemy. See अति-\nक्रम\n E. अति over, beyond, and क्रम to go; going beyond duty or\ndaring.", "gloss_language": "en"}], "synonyms": ["अतिक्रमः"], "synonyms_slp1": ["atikramaH"]}], "atikramin": [{"id": "atikramin", "headword": "अतिक्रमिन्", "headword_slp1": "atikramin", "fold": "atikramin", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिक्रमिन् mfn. (-मी-मिणी-मि)\n 1. Transgressing.\n 2. Exceeding, surpassing.\nE. अतिक्रम, and इनि aff.", "gloss_language": "en"}]}], "atikramya": [{"id": "atikramya", "headword": "अतिक्रम्य", "headword_slp1": "atikramya", "fold": "atikramya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिक्रम्य ind. Having gone over or beyond. i. e. Exceeded, transgressed,\nsurpassed, overcome, &c.\n E. अति before, क्रम to go, यत् aff.", "gloss_language": "en"}]}], "atikrasa": [{"id": "atikraSa", "headword": "अतिक्रश", "headword_slp1": "atikraSa", "fold": "atikrasa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिक्रश mfn. (-शः-शा-शी-शं) Thin, emaciated.\n E. अति, and क्रश spare; ऋ\nchanged to र.", "gloss_language": "en"}]}], "atikranta": [{"id": "atikrAnta", "headword": "अतिक्रान्त", "headword_slp1": "atikrAnta", "fold": "atikranta", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिक्रान्त mfn. (-न्तः-न्ता-न्तं)\n 1. Transgressed, exceeded, passed the proper\nbounds.\n 2. Excelled, surpassed.\n 3. Passed in time.\n 4. Attacked,\nassaulted.\n 5. Excessive, unlimited.\n 6. Prolix, diffuse.\n 7. Disregarded,\ndisliked.\n E. अति, and क्रम to go, aff.", "gloss_language": "en"}], "synonyms": ["अतिक्रांत", "अतिक्रान्तः"], "synonyms_slp1": ["atikrAMta", "atikrAntaH"]}], "atikramaka": [{"id": "atikrAmaka", "headword": "अतिक्रामक", "headword_slp1": "atikrAmaka", "fold": "atikramaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अतिक्रामक mfn. (-कः-का-कं) Exceeding, one who oversteps due bounds.\nE. अति, and क्रम to go, स्खुल् aff.", "gloss_language": "en"}], "synonyms": ["अतिक्रामकः"], "synonyms_slp1": ["atikrAmakaH"]}], "atigaRqa": [{"id": "atigaRqa", "headword": "अतिगण्ड", "headword_slp1": "atigaRqa", "fold": "atigaRqa", "headword_language": "sa", "source": "shabda-sagara"