{"dilipa": [{"id": "dilIpa", "headword": "दिलीप", "headword_slp1": "dilIpa", "fold": "dilipa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "दिलीप m. (-पः) The name of a king and ancestor of RAMA.\n E. दिली said\nto be the barbarous name of Hastinapur of the modern Delhi, and\nप who protects or rules.", "gloss_language": "en"}], "synonyms": ["दिलीपः"], "synonyms_slp1": ["dilIpaH"]}], "diliparaj": [{"id": "dilIparAj", "headword": "दिलीपराज्", "headword_slp1": "dilIparAj", "fold": "diliparaj", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "दिलीपराज् m. (-राट्) King DILIPA: see the preceding.\n E. दिलीप as above,\nand राज् a king.", "gloss_language": "en"}]}], "dilira": [{"id": "dilIra", "headword": "दिलीर", "headword_slp1": "dilIra", "fold": "dilira", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "दिलीर m. (-रः) A mushroom.", "gloss_language": "en"}], "synonyms": ["दिलीरं"], "synonyms_slp1": ["dilIraM"]}]}