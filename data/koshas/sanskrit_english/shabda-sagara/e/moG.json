{"moGa": [{"id": "moGa", "headword": "मोघ", "headword_slp1": "moGa", "fold": "moGa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मोघ mfn. (-घः-घा-घं)\n 1. Vain, useless, fruitless.\n 2. Left, abandoned.\n3. Idle.\n f. (-घा) Trumpet-flower, (Bignonia suave olens.)\n m. (-घः) A\nfence, a hedge.\n E. मुह् to be foolish, aff. अच् and the final changed.", "gloss_language": "en"}], "synonyms": ["मोघं", "मोघः"], "synonyms_slp1": ["moGaM", "moGaH"]}], "moGakarman": [{"id": "moGakarmman", "headword": "मोघकर्म्मन्", "headword_slp1": "moGakarmman", "fold": "moGakarman", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मोघकर्म्मन् mfn. (-र्म्मा-र्म्मा-र्म्म) Following vain practices, observing useless\nceremonies.\n E. मोघ, कर्म्मन् act.", "gloss_language": "en"}], "synonyms": ["मोघकर्मन्"], "synonyms_slp1": ["moGakarman"]}], "moGajYana": [{"id": "moGajYAna", "headword": "मोघज्ञान", "headword_slp1": "moGajYAna", "fold": "moGajYana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मोघज्ञान mfn. (-नः-ना-नं) Cultivating vain knowledge or any but re-\nligious wisdom.\n E. मोघ, and ज्ञान knowledge.", "gloss_language": "en"}]}], "moGapuspa": [{"id": "moGapuzpA", "headword": "मोघपुष्पा", "headword_slp1": "moGapuzpA", "fold": "moGapuspa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मोघपुष्पा f. (-ष्पा) A barren woman.", "gloss_language": "en"}]}], "moGasa": [{"id": "moGASa", "headword": "मोघाश", "headword_slp1": "moGASa", "fold": "moGasa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मोघाश mfn. (-शः-शा-शं) Indulging vain hopes.\n E. मीघ, and आशा hope.", "gloss_language": "en"}]}], "moGoli": [{"id": "moGolI", "headword": "मोघोली", "headword_slp1": "moGolI", "fold": "moGoli", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "मोघोली m. (-ली) A fence, a hedge.", "gloss_language": "en"}]}]}