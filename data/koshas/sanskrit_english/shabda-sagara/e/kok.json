{"koka": [{"id": "koka", "headword": "कोक", "headword_slp1": "koka", "fold": "koka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोक m. (-कः)\n 1. A wolf.\n 2. The ruddy goose.\n 3. A frog.\n 4. A lizard,\na chameleon.\n 5. The wild date tree.\n 6. A name of VIṢṆU.\n E. कुक्\nto seize or take, or क water, उक् to go, affix अच्.", "gloss_language": "en"}], "synonyms": ["कोकः"], "synonyms_slp1": ["kokaH"]}], "kokaqa": [{"id": "kokaqa", "headword": "कोकड", "headword_slp1": "kokaqa", "fold": "kokaqa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकड m. (-डः) An animal said to be a kind of deer, of a brown\ncolour, with a bushy tail, and lurking in holes, perhaps a hare.", "gloss_language": "en"}], "synonyms": ["कोकडः"], "synonyms_slp1": ["kokaqaH"]}], "kokadeva": [{"id": "kokadeva", "headword": "कोकदेव", "headword_slp1": "kokadeva", "fold": "kokadeva", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकदेव m. (-वः) A pigeon.", "gloss_language": "en"}], "synonyms": ["कोकदेवः"], "synonyms_slp1": ["kokadevaH"]}], "kokanada": [{"id": "kokanada", "headword": "कोकनद", "headword_slp1": "kokanada", "fold": "kokanada", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकनद n. (-दं)\n 1. The red lotus.\n 2. The red water-lily.\n E. कोक a goose,\nand नद् to sound, affix क.", "gloss_language": "en"}], "synonyms": ["कोकनदं"], "synonyms_slp1": ["kokanadaM"]}], "kokanadacCavi": [{"id": "kokanadacCavi", "headword": "कोकनदच्छवि", "headword_slp1": "kokanadacCavi", "fold": "kokanadacCavi", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकनदच्छवि mfn. (-विः-विः-वि) Red, the colour, or of that colour. E.\nकोकनद the red lotus, and छवि light, splendor.", "gloss_language": "en"}], "synonyms": ["कोकनदच्छविः"], "synonyms_slp1": ["kokanadacCaviH"]}], "kokabanDu": [{"id": "kokabanDu", "headword": "कोकबन्धु", "headword_slp1": "kokabanDu", "fold": "kokabanDu", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकबन्धु m. (-न्धुः) The sun.\n E. कोक the ruddy goose, and बन्धु a friend:\nsee चक्रवाक.", "gloss_language": "en"}], "synonyms": ["कोकबन्धुः"], "synonyms_slp1": ["kokabanDuH"]}], "kokaha": [{"id": "kokAha", "headword": "कोकाह", "headword_slp1": "kokAha", "fold": "kokaha", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकाह m. (-हः) A white horse.", "gloss_language": "en"}], "synonyms": ["कोकाहः"], "synonyms_slp1": ["kokAhaH"]}], "kokila": [{"id": "kokila", "headword": "कोकिल", "headword_slp1": "kokila", "fold": "kokila", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकिल m. (-लः)\n 1. The Kokila or Koil, the black or Indian cuckoo,\n(Cuculus Indicus.)\n 2. A firebrand, a lighted coal.\n E. कुक् to seize,\n(the heart,) and इलच् affix: the Kokila makes a prominent figure\nin Hindu poetry, and is supposed, by his musical cry, to inspire\npleasing and tender emotions.", "gloss_language": "en"}], "synonyms": ["कोकिलः"], "synonyms_slp1": ["kokilaH"]}], "kokilanayana": [{"id": "kokilanayana", "headword": "कोकिलनयन", "headword_slp1": "kokilanayana", "fold": "kokilanayana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकिलनयन m. (-नः) A plant bearing a dark black flower, (Capparis\nspinosa;) it is also applied to Barleria longifolia.\n E. कोकिल the\nKoil, and नयन an eye, to which the flower is compared; also other\nsimilar compounds, as कोकिलाक्ष &c.", "gloss_language": "en"}], "synonyms": ["कोकिलनयनः"], "synonyms_slp1": ["kokilanayanaH"]}], "kokilaksa": [{"id": "kokilAkza", "headword": "कोकिलाक्ष", "headword_slp1": "kokilAkza", "fold": "kokilaksa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकिलाक्ष m. (-क्षः) A shrub: see the preceding.\n E. कोकिल, and अक्ष the\neye, or with कन् added, कोकिलाक्षक.", "gloss_language": "en"}], "synonyms": ["कोकिलाक्षः"], "synonyms_slp1": ["kokilAkzaH"]}], "kokilavasa": [{"id": "kokilAvAsa", "headword": "कोकिलावास", "headword_slp1": "kokilAvAsa", "fold": "kokilavasa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकिलावास m. (-सः) The mango tree.\n E. कोकिल, and आवास abode.", "gloss_language": "en"}], "synonyms": ["कोकिलावासः"], "synonyms_slp1": ["kokilAvAsaH"]}], "kokileksu": [{"id": "kokilekzu", "headword": "कोकिलेक्षु", "headword_slp1": "kokilekzu", "fold": "kokileksu", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकिलेक्षु m. (-क्षुः) The black variety of sugar cane. कोकिल and इक्षु\nsugar cane.", "gloss_language": "en"}], "synonyms": ["कोकिलेक्षुः"], "synonyms_slp1": ["kokilekzuH"]}], "kokilotsava": [{"id": "kokilotsava", "headword": "कोकिलोत्सव", "headword_slp1": "kokilotsava", "fold": "kokilotsava", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "कोकिलोत्सव m. (-वः) The mango tree.\n E. कोकिल and उत्सव festival.", "gloss_language": "en"}], "synonyms": ["कोकिलोत्सवः"], "synonyms_slp1": ["kokilotsavaH"]}]}