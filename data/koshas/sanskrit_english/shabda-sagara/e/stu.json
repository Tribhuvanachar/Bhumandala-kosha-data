{"stuka": [{"id": "stuka", "headword": "स्तुक", "headword_slp1": "stuka", "fold": "stuka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुक m. (-कः) A collection of hair, a knot.\n f. (-का)\n 1. A knot or braid\nof hair.\n 2. A bunch of curly hair between the horns of a bull.\n 3.\nHip, thigh.", "gloss_language": "en"}], "synonyms": ["स्तुकः"], "synonyms_slp1": ["stukaH"]}], "stuta": [{"id": "stuta", "headword": "स्तुत", "headword_slp1": "stuta", "fold": "stuta", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुत mfn. (-तः-ता-तं) Praised, panegyrised, hymned, glorified.\n E. ष्टु to praise, aff. क्त ।", "gloss_language": "en"}], "synonyms": ["स्तुतः"], "synonyms_slp1": ["stutaH"]}], "stuti": [{"id": "stuti", "headword": "स्तुति", "headword_slp1": "stuti", "fold": "stuti", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुति f. (-तिः) Praise, eulogy.\n E. ष्टु to praise, aff. क्तिन् ।", "gloss_language": "en"}], "synonyms": ["स्तुतिः"], "synonyms_slp1": ["stutiH"]}], "stutipada": [{"id": "stutipada", "headword": "स्तुतिपद", "headword_slp1": "stutipada", "fold": "stutipada", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुतिपद n. (-दं) An object of praise.", "gloss_language": "en"}]}], "stutipaWaka": [{"id": "stutipAWaka", "headword": "स्तुतिपाठक", "headword_slp1": "stutipAWaka", "fold": "stutipaWaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुतिपाठक m. (-कः) A bard, one who accompanies a chief or an army, to\nrecite the titles and praises of the one, and to inspire the other\nby chanting martial exploits, &c.\n E. स्तुति praise, पाठक a reader.", "gloss_language": "en"}], "synonyms": ["स्तुतिपाठकः"], "synonyms_slp1": ["stutipAWakaH"]}], "stutivada": [{"id": "stutivAda", "headword": "स्तुतिवाद", "headword_slp1": "stutivAda", "fold": "stutivada", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुतिवाद m. (-दः) A laudatory speech.", "gloss_language": "en"}], "synonyms": ["स्तुतिवादः"], "synonyms_slp1": ["stutivAdaH"]}], "stutivrata": [{"id": "stutivrata", "headword": "स्तुतिव्रत", "headword_slp1": "stutivrata", "fold": "stutivrata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुतिव्रत m. (-तः) A bard, a herald: see the last.\n E. स्तुति praise, and व्रत\nobservance.", "gloss_language": "en"}], "synonyms": ["स्तुतिव्रतः"], "synonyms_slp1": ["stutivrataH"]}], "stutya": [{"id": "stutya", "headword": "स्तुत्य", "headword_slp1": "stutya", "fold": "stutya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुत्य mfn. (-त्यः-त्या-त्यं) To be praised, laudable, praise-worthy.\n E. ष्टु to praise, aff. क्यप् ।", "gloss_language": "en"}], "synonyms": ["स्तुत्यः"], "synonyms_slp1": ["stutyaH"]}], "stunaka": [{"id": "stunaka", "headword": "स्तुनक", "headword_slp1": "stunaka", "fold": "stunaka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुनक m. (-कः) A goat.\n E. ष्ट्रु to praise, नकक् Unādi aff.", "gloss_language": "en"}], "synonyms": ["स्तुनकः"], "synonyms_slp1": ["stunakaH"]}], "stuBa": [{"id": "stuBa", "headword": "स्तुभ", "headword_slp1": "stuBa", "fold": "stuBa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुभ m. (-भः) A he-goat.\n E. ष्टुभ् to stop, aff. क; also read स्तभ ।", "gloss_language": "en"}], "synonyms": ["स्तुभः"], "synonyms_slp1": ["stuBaH"]}], "stumB": [{"id": "stumB", "headword": "स्तुम्भ्", "headword_slp1": "stumB", "fold": "stumB", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुम्भ् (उ) स्तुम्भु r. 5th cl. (स्तुभ्रोति) r. 9th cl. (स्तुभ्राति)\n 1. To stop.\n 2. To be\nstupid.\n 3. To expel.", "gloss_language": "en"}], "synonyms": ["स्तुंभ्"], "synonyms_slp1": ["stuMB"]}], "stupepya": [{"id": "stupepya", "headword": "स्तुपेप्य", "headword_slp1": "stupepya", "fold": "stupepya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तुपेप्य n. (-प्यं) Excellence, preferableness, (in the language of the\nVedas.)\n E. ष्टु to praise, क्सेप्य Unādi aff.", "gloss_language": "en"}]}], "stup": [{"id": "stUp", "headword": "स्तूप्", "headword_slp1": "stUp", "fold": "stup", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तूप् r. 4th cl. (स्तूप्यति) r. 10th cl. (स्तूपयति-ते)\n 1. To heap, to pile, to\ncollect.\n 2. To erect; the form ष्टूप् is irregular.", "gloss_language": "en"}]}], "stupa": [{"id": "stUpa", "headword": "स्तूप", "headword_slp1": "stUpa", "fold": "stupa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तूप m. (-पः)\n 1. A heap, a pile of earth, &c.\n 2. A funeral pile.\n 3. A\nBuddhistic construction for keeping holy relics.\n E. ष्टूप् to heap,\naff. अच्; or ष्टु to praise, पक् Unādi aff., and the vowel made long.", "gloss_language": "en"}], "synonyms": ["स्तूपः"], "synonyms_slp1": ["stUpaH"]}], "stuyamana": [{"id": "stUyamAna", "headword": "स्तूयमान", "headword_slp1": "stUyamAna", "fold": "stuyamana", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "स्तूयमान mfn. (-नः-ना-नं) Being praised.\n E. ष्टु to praise, pass. v., शानच् aff.", "gloss_language": "en"}]}]}