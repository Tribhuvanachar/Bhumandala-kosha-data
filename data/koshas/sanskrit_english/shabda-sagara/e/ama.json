gloss_language": "en"}], "synonyms": ["अमंत्रक"], "synonyms_slp1": ["amaMtraka"]}], "amanda": [{"id": "amanda", "headword": "अमन्द", "headword_slp1": "amanda", "fold": "amanda", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमन्द m. (-न्दः) A tree. (E. अम sickness, and द from दो to cut, or destroy.)\nmfn. (-न्दः-न्दा-न्दं)\n 1. Fierce, violent.\n 2. Active.\n E. अ neg. मन्द tardy\nor dull.", "gloss_language": "en"}], "synonyms": ["अमंद", "अमन्दः"], "synonyms_slp1": ["amaMda", "amandaH"]}], "amama": [{"id": "amama", "headword": "अमम", "headword_slp1": "amama", "fold": "amama", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमम m. (-मः) One of the Jaina saints of a future age.\n mfn. (-मः-मा-मं)\nDevoid of all selfish or worldly attachment or desire.\n E. अ neg. and\nमम mine.", "gloss_language": "en"}], "synonyms": ["अममः"], "synonyms_slp1": ["amamaH"]}], "amamata": [{"id": "amamatA", "headword": "अममता", "headword_slp1": "amamatA", "fold": "amamata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अममता f. (-ता) Disinterestedness, indifference.\n E. अमम and तल् aff.", "gloss_language": "en"}]}], "amamatva": [{"id": "amamatva", "headword": "अममत्व", "headword_slp1": "amamatva", "fold": "amamatva", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अममत्व n. (-त्वं) Disinterestendess, philosophy, stoicism.\n E. अमम and त्व aff.", "gloss_language": "en"}], "synonyms": ["अममत्वं"], "synonyms_slp1": ["amamatvaM"]}], "amara": [{"id": "amara", "headword": "अमर", "headword_slp1": "amara", "fold": "amara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमर m. (-रः)\n 1. A deity, an immortal.\n 2. A plant, (Heliotropium in-\ndicum.) See अस्थिसंहार.\n 3. Also, (Euphorbia tirucalli, &c.)\n 4. Quick-\nsilver.\n f. (-रा)\n 1. The residence of INDRA.\n 2. A house post.\n 3. The\nwomb.\n 4. The umbilical cord.\n 5. A plant, (Menispermum glabrum.)\nSee गुडूची.\n 6. Bent grass, (Agrostis linearis.)\n mfn. (-रः-रा-रं) Immortal.\nE. अ neg. and मर what dies, from मृ and अच् aff.", "gloss_language": "en"}], "synonyms": ["अमरः"], "synonyms_slp1": ["amaraH"]}], "amaraRiya": [{"id": "amaraRIya", "headword": "अमरणीय", "headword_slp1": "amaraRIya", "fold": "amaraRiya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमरणीय mfn. (-यः-या-यं) What cannot die, immortal.\n E. अ neg. मरणीय\nperishable.", "gloss_language": "en"}]}], "amaraRiyata": [{"id": "amaraRIyatA", "headword": "अमरणीयता", "headword_slp1": "amaraRIyatA", "fold": "amaraRiyata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमरणीयता f. (-ता) Immortality.\n E. तल् added to the last; also अमरणीयत्वं.", "gloss_language": "en"}]}], "amarata": [{"id": "amaratA", "headword": "अमरता", "headword_slp1": "amaratA", "fold": "amarata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमरता f. (-ता) Immortality.\n E. अमर and तल् aff.", "gloss_language": "en"}]}], "amaratva": [{"id": "amaratva", "headword": "अमरत्व", "headword_slp1": "amaratva", "fold": "amaratva", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमरत्व n. (-त्वं) Immortality.\n E. अमर and त्व aff.", "gloss_language": "en"}], "synonyms": ["अमरत्वं"], "synonyms_slp1": ["amaratvaM"]}], "amaradaru": [{"id": "amaradAru", "headword": "अमरदारु", "headword_slp1": "amaradAru", "fold": "amaradaru", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमरदारु m. (-रुः) Name of a tree, (Pinus longifolius.)\n E. अमर, and दारु\na tree.", "gloss_language": "en"}], "synonyms": ["अमरदारुः"], "synonyms_slp1": ["amaradAruH"]}], "amaradvija": [{"id": "amaradvija", "headword": "अमरद्विज", "headword_slp1": "amaradvija", "fold": "amaradvija", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमरद्विज m. (-जः) A Brahman who lives by attending a temple or idol.\nE. अ