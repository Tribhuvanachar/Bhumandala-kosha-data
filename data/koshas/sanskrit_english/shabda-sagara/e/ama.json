{"ama": [{"id": "ama", "headword": "अम", "headword_slp1": "ama", "fold": "ama", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अम r. 1st cl. (अमति)\n 1. To go, to go to or towards.\n 2. To serve or honour.\n3. To sound. 10th cl. (आमयति) To afflict with sickness or pain\nfrom disease.", "gloss_language": "en"}, {"gloss": "अम ind. (-मं)\n 1. Quickly.\n 2. Little.\n mfn. (-मः-मा-मं) Unripe, (as fruit,\n&c.)\n m. (-मः) Sickness.\n E. अम to go or to be sick, अच् aff.", "gloss_language": "en"}], "synonyms": ["अमं", "अमः"], "synonyms_slp1": ["amaM", "amaH"]}, {"id": "amA", "headword": "अमा", "headword_slp1": "amA", "fold": "ama", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमा ind.\n 1. With, together with.\n 2. Near.\n f. (-मा) Day of conjunction or\nnew moon.\n E. अ neg. माङ् to measure, क्विप् affix, and टाप् fem. do.", "gloss_language": "en"}]}, {"id": "Ama", "headword": "आम", "headword_slp1": "Ama", "fold": "ama", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आम mfn. (-मः-मा-मं)\n 1. Raw, undressed, unripe.\n 2. Unbaked, unan-\nnealed.\n m. (-मः)\n 1. Sickness, disease.\n 3. Constipation, passing\nhard and unhealthy excretions.\n 4. Grain freed from the chaff.\nE. अम् to be sick, घञ् aff.", "gloss_language": "en"}], "synonyms": ["आमं", "आमः"], "synonyms_slp1": ["AmaM", "AmaH"]}], "amaNgala": [{"id": "amaNgala", "headword": "अमङ्गल", "headword_slp1": "amaNgala", "fold": "amaNgala", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमङ्गल mfn. (-लः-ला-लं) Inauspicious, unlucky, evil.\n n. (-लं) Inauspicious-\nness, ill luck.\n m. (-लः) The castor oil plant.\n E. अ neg. and मङ्गल\nauspicious: the wood has no sap, and is useless.", "gloss_language": "en"}], "synonyms": ["अमंगल", "अमङ्गलं", "अमङ्गलः"], "synonyms_slp1": ["amaMgala", "amaNgalaM", "amaNgalaH"]}], "amaNgalya": [{"id": "amaNgalya", "headword": "अमङ्गल्य", "headword_slp1": "amaNgalya", "fold": "amaNgalya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमङ्गल्य mfn. (-ल्यः-ल्या-ल्यं) Inauspicious, unlucky, productive of evil. E.\nअ neg. मङ्गल्य auspicious.", "gloss_language": "en"}], "synonyms": ["अमंगल्य", "अमङ्गल्यः"], "synonyms_slp1": ["amaMgalya", "amaNgalyaH"]}], "amaRqa": [{"id": "amaRqa", "headword": "अमण्ड", "headword_slp1": "amaRqa", "fold": "amaRqa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमण्ड m. (ण्डः) The castor oil tree, (Ricinus communis.)\n E. अ neg. मडि\nto adorn, and अच् aff.", "gloss_language": "en"}], "synonyms": ["अमंड", "अमण्डः"], "synonyms_slp1": ["amaMqa", "amaRqaH"]}, {"id": "AmaRqa", "headword": "आमण्ड", "headword_slp1": "AmaRqa", "fold": "amaRqa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "आमण्ड m. (-ण्डः) The castor oil plant.\n E. आङ् dim. मडि to adorn, अच् aff.", "gloss_language": "en"}], "synonyms": ["आमंडः", "आमण्डः"], "synonyms_slp1": ["AmaMqaH", "AmaRqaH"]}], "amaRqita": [{"id": "amaRqita", "headword": "अमण्डित", "headword_slp1": "amaRqita", "fold": "amaRqita", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमण्डित mfn. (-तः-ता-तं) Unadorned.\n E. अ neg. मण्डित adorned.", "gloss_language": "en"}]}], "amata": [{"id": "amata", "headword": "अमत", "headword_slp1": "amata", "fold": "amata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमत m. (-तः)\n 1. Sickness, disease.\n 2. Death.\n 3. Time.\n E. अम to be sick,\nand अतच् Unādi aff.", "gloss_language": "en"}], "synonyms": ["अमतः"], "synonyms_slp1": ["amataH"]}, {"id": "amatta", "headword": "अमत्त", "headword_slp1": "amatta", "fold": "amata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमत्त mfn. (-त्तः-त्ता-त्तं)\n 1. Sober, not inebriated.\n 2. Sane, not mad.\n E. अ\nneg. मत्त crazy.", "gloss_language": "en"}]}], "amati": [{"id": "amati", "headword": "अमति", "headword_slp1": "amati", "fold": "amati", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमति m. (-तिः)\n 1. Time.\n 2. The moon.\n 3. A cheat, a rogue.\n f. (-तिः) Un-\nconsciousness, ignorance, absence of knowledge or intention.\n E. अम\nto go, and अति Unādi affix, or अ neg. मति understanding.", "gloss_language": "en"}], "synonyms": ["अमतिः"], "synonyms_slp1": ["amatiH"]}], "amatipurva": [{"id": "amatipUrvva", "headword": "अमतिपूर्व्व", "headword_slp1": "amatipUrvva", "fold": "amatipurva", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमतिपूर्व्व mfn. (-र्व्वः-र्व्वा-र्व्वं) Unconscious, unintentional.\n E. अमति ignorance,\nपूर्व्व before.", "gloss_language": "en"}], "synonyms": ["अमतिपूर्व"], "synonyms_slp1": ["amatipUrva"]}], "amatra": [{"id": "amatra", "headword": "अमत्र", "headword_slp1": "amatra", "fold": "amatra", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमत्र n. (-त्रं) A vessel, a utensil.\n E. अम to go, अत्रन् Unādi aff.", "gloss_language": "en"}], "synonyms": ["अमत्रं"], "synonyms_slp1": ["amatraM"]}, {"id": "amAtra", "headword": "अमात्र", "headword_slp1": "amAtra", "fold": "amatra", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमात्र mfn. (-त्रः-त्रा-त्रं)\n 1. Not whole or entire.\n 2. Not elementary.\n E. अ\nneg. मात्र whole, &c.", "gloss_language": "en"}], "synonyms": ["अमात्रः"], "synonyms_slp1": ["amAtraH"]}], "amatsara": [{"id": "amatsara", "headword": "अमत्सर", "headword_slp1": "amatsara", "fold": "amatsara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमत्सर mfn. (-रः-रा-रं) Unenvious, charitable.\n E. अ neg. मत्सर envious.", "gloss_language": "en"}], "synonyms": ["अमत्सरः"], "synonyms_slp1": ["amatsaraH"]}], "amani": [{"id": "amani", "headword": "अमनि", "headword_slp1": "amani", "fold": "amani", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमनि f. (-निः) A road.\n E. अम to go, अनि Unādi aff.", "gloss_language": "en"}], "synonyms": ["अमनिः"], "synonyms_slp1": ["amaniH"]}], "amantavya": [{"id": "amantavya", "headword": "अमन्तव्य", "headword_slp1": "amantavya", "fold": "amantavya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमन्तव्य mfn. (-व्यः-व्या-व्यं) Not to be regarded, inadmissible, unknowable.\nAlso अमननीय mfn. (-यः-या-यं)\n E. अ neg. मन्तव्य or मननीय to be re-\ngarded.", "gloss_language": "en"}]}], "amanusya": [{"id": "amanuzya", "headword": "अमनुष्य", "headword_slp1": "amanuzya", "fold": "amanusya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमनुष्य mfn. (-ष्यः-ष्या-ष्यं) Unmanly.\n E. अ neg. मनुष्य a man.", "gloss_language": "en"}], "synonyms": ["अमनुष्यः"], "synonyms_slp1": ["amanuzyaH"]}, {"id": "amAnuzya", "headword": "अमानुष्य", "headword_slp1": "amAnuzya", "fold": "amanusya", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमानुष्य mfn. (-ष्यः-ष्यी-ष्यं) Superhuman.\n E. अ neg. मानुष्य human.", "gloss_language": "en"}]}], "amanusyata": [{"id": "amanuzyatA", "headword": "अमनुष्यता", "headword_slp1": "amanuzyatA", "fold": "amanusyata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमनुष्यता f. (-ता) Unmanliness.\n E. तल् added to the last: also with त्व,\nअमनुष्यत्वं.", "gloss_language": "en"}]}], "amanogata": [{"id": "amanogata", "headword": "अमनोगत", "headword_slp1": "amanogata", "fold": "amanogata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमनोगत mfn. (-तः-ता-तं) Unthought of, unknown.\n E. अ neg. मनोगत\nthought of.", "gloss_language": "en"}]}], "amanojYa": [{"id": "amanojYa", "headword": "अमनोज्ञ", "headword_slp1": "amanojYa", "fold": "amanojYa", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "अमनोज्ञ mfn. (-ज्ञः-ज्ञा-ज्ञं) Disagreeable, disliked.\n E. अ neg. मनोज्ञ agreeable.", "gloss_language": "en"}]}], "amanonita": [{"id": "amanonIta", "headword": "अ