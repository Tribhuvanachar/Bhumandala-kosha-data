{"sita": [{"id": "Sita", "headword": "शित", "headword_slp1": "Sita", "fold": "sita", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शित mfn. (-तः-ता-तं)\n 1. Thin, emaciated, wasted, declined.\n 2. Weak,\nfeeble.\n 3. Sharpened, whetted.\n E. शि to sharpen, or शो to pare or\nwhet, aff. क्त ।", "gloss_language": "en"}], "synonyms": ["शितं"], "synonyms_slp1": ["SitaM"]}, {"id": "SIta", "headword": "शीत", "headword_slp1": "SIta", "fold": "sita", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शीत mfn. (-तः-ता-तं)\n 1. Cold, chilly, frigid.\n 2. Idle, lazy.\n 3. Cold, dull,\n[]\napathetic, stupid.\n 4. Decocted, boiled.\n n. (-तं)\n 1. Cold, coldness.\n 2.\nWater.\n 3. Cold weather or the six months of the rainy, dewy and\ncold seasons.\n 4. Cinnamon.\n m. (-तः)\n 1. A small tree, (Cordia myxa.)\n2. A kind of ratan, (Calamus fasciculatus.)\n 3. A plant, (Marsilea\nquadrifolia.)\n 4. The Nimba-tree.\n 5. Camphor.\n 6. The cold season.\nf. (-ता)\n 1. The wife of RĀMA.\n 2. A furrow.\n E. श्यै to go, aff. क्त; the\nfem. form more usually occurs सीता, q. v.", "gloss_language": "en"}], "synonyms": ["शीतं", "शीतः"], "synonyms_slp1": ["SItaM", "SItaH"]}, {"id": "sita", "headword": "सित", "headword_slp1": "sita", "fold": "sita", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "सित mfn. (-तः-ता or ती-तं)\n 1. White.\n 2. Bound, tied.\n 3. Finished, des-\ntroyed.\n 4. Completed, concluded.\n 5. Known.\n m. (-तः)\n 1. White,\n(the colour.)\n 2. The light-half of a lunar month.\n 3. The planet\nVENUS.\n 4. An arrow.\n n. (-तं)\n 1. Silver.\n 2. Sandal.\n 3. Radish.\nf. (-ता)\n 1. Clayed or candied sugar.\n 2. Arabian jasmine.\n 3.\nA sort of Clitoria.\n 4. Bent grass with white blossoms.\n 5.\nMoon-light.\n 6. Spirituous liquor.\n 7. A handsome or well made\nwoman.\n E. षि to tie or bind, aff. क्त; or षो to destroy, क्त aff., and इ\nsubstituted for the radical vowel.", "gloss_language": "en"}], "synonyms": ["सितं", "सितः"], "synonyms_slp1": ["sitaM", "sitaH"]}, {"id": "sItA", "headword": "सीता", "headword_slp1": "sItA", "fold": "sita", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "सीता f. (-ता)\n 1. A furrow, the track of the plough-share.\n 2. The\ndaughter of JANAKA and wife of RĀMACHANDRA, so named\nbecause fabled to have sprung from a furrow made by\nJanaka while ploughing the ground to prepare it for a\nsacrifice instituted by him to obtain progeny.\n 3. One of the\nfour great branches into which the Ganges, after having fallen on\nmount Meru, is fabled to divide: the eastern branch, flowing\ninto the Varṣa Bhadrāswa.\n 4. The goddess LAKṢMĪ.\n 5. UMĀ,\nthe wife of ŚIVA.\n 6. A goddess, wife of Indra, presiding over fruits,\n&c., an Indian FLORA or POMONA.\n 7. Spirituous liquor.\n 8. Husban-\ndry.\n E. षि to bind, (the earth,) क्त aff., form irr; it is then appli-\ncable to the princess as having been turned up in the soil\nby a plough-share; and to the goddesses, as they may be sup-\nposed to have been incarnate in the wife of RĀMĀ; also, as\ndifferently derived शीता, q. v.", "gloss_language": "en"}]}], "sitata": [{"id": "SitatA", "headword": "शितता", "headword_slp1": "SitatA", "fold": "sitata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शितता f. (-ता) Sharpness.\n E. तल् added to the last; also with त्व, शितत्वं ।", "gloss_language": "en"}]}, {"id": "SItatA", "headword": "शीतता", "headword_slp1": "SItatA", "fold": "sitata", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शीतता f. (-ता) Cold, coldness.\n E. शीत and तल् aff.; also with त्व, शीतत्वं ।", "gloss_language": "en"}]}], "sitadru": [{"id": "Sitadru", "headword": "शितद्रु", "headword_slp1": "Sitadru", "fold": "sitadru", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शितद्रु f. (-द्रुः) The Śatadru or the river Sutlej.\n E. शित weakened, द्रु\nto flow, aff. कुः see शतद्रु ।", "gloss_language": "en"}], "synonyms": ["शितद्रुः"], "synonyms_slp1": ["SitadruH"]}, {"id": "sitadru", "headword": "सितद्रु", "headword_slp1": "sitadru", "fold": "sitadru", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "सितद्रु m. (-द्रुः) A plant, commonly Morata.\n E. सित white, and द्रु a tree.", "gloss_language": "en"}], "synonyms": ["सितद्रुः"], "synonyms_slp1": ["sitadruH"]}], "sitaDara": [{"id": "SitaDAra", "headword": "शितधार", "headword_slp1": "SitaDAra", "fold": "sitaDara", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शितधार mfn. (-रः-रा-रं) Sharp-edged.\n E. शित, and धारा an edge.", "gloss_language": "en"}]}], "sitasuka": [{"id": "SitaSUka", "headword": "शितशूक", "headword_slp1": "SitaSUka", "fold": "sitasuka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शितशूक m. (-कः)\n 1. Barley.\n 2. Wheat.\n E. शित sharpened, शूक the beard.", "gloss_language": "en"}], "synonyms": ["शितशूकः"], "synonyms_slp1": ["SitaSUkaH"]}, {"id": "SItaSUka", "headword": "शीतशूक", "headword_slp1": "SItaSUka", "fold": "sitasuka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शीतशूक m. (-कः) Barley.\n E. शीत cold, and शूक an awn or beard.", "gloss_language": "en"}], "synonyms": ["शीतशूकः"], "synonyms_slp1": ["SItaSUkaH"]}, {"id": "sitaSUka", "headword": "सितशूक", "headword_slp1": "sitaSUka", "fold": "sitasuka", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "सितशूक m. (-कः) Barley.\n E. शित white, an शूक and awn or ear.", "gloss_language": "en"}], "synonyms": ["सितशूकः"], "synonyms_slp1": ["sitaSUkaH"]}], "sitagra": [{"id": "SitAgra", "headword": "शिताग्र", "headword_slp1": "SitAgra", "fold": "sitagra", "headword_language": "sa", "source": "shabda-sagara", "senses": [{"gloss": "शिताग्र mfn. (-ग्रः-ग्रा-ग्रं) Sharp-pointed.\n m. (-ग्रः) A thorn.\n E. शित, अग्रं\npoint.", "gloss_language": "en"}], "synonyms": ["शिताग्रः"], "synonyms_slp1": ["S