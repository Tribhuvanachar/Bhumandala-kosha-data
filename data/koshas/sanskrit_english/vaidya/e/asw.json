s": [{"gloss": "अष्टन्-दिश् f. the eight cardinal points of the compass, viz., पूर्वा, आग्नेयी, दक्षिणा, नैरृती, पश्चिमा, वायवी, उत्तरा and ऐशानी.", "gloss_language": "en"}]}], "aswaDa": [{"id": "azwaDA", "headword": "अष्टधा", "headword_slp1": "azwaDA", "fold": "aswaDa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-धा ind. 1. eight-fold; 2. in eight parts, भिन्नोष्टधा विप्रससार वंशः R.xvi.8.", "gloss_language": "en"}]}], "aswaDatu": [{"id": "azwaDAtu", "headword": "अष्टधातु", "headword_slp1": "azwaDAtu", "fold": "aswaDatu", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-धातु n. sing. the eight metals collectively; (they are- स्वर्ण रूप्यं च ताम्रं च रंगं यशदमेव च । शीसं लौहं रसश्चेति धातवोष्टौ प्रकीर्तिताः).", "gloss_language": "en"}], "synonyms": ["अष्टधातुः"], "synonyms_slp1": ["azwaDAtuH"]}], "aswapada": [{"id": "azwapAda", "headword": "अष्टपाद", "headword_slp1": "azwapAda", "fold": "aswapada", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-पाद (I) a. having eight legs.", "gloss_language": "en"}, {"gloss": "अष्टन्-पाद (II) m. a kind of spider.", "gloss_language": "en"}], "synonyms": ["अष्टपादः"], "synonyms_slp1": ["azwapAdaH"]}, {"id": "azwApada", "headword": "अष्टापद", "headword_slp1": "azwApada", "fold": "aswapada", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टापद^1 m.n. 1. a kind of chequered cloth for dice; 2. gold, आवर्जिताष्टापद कुंभतोयैः K.S.vii.10.\n[1] Correction submitted by Scott Rhodes on 20251217. Reference: https://github.com/sanskrit-lexicon/csl-corrections/issues/102. note: headword change.", "gloss_language": "en"}], "synonyms": ["अष्टापदं", "अष्टापदः"], "synonyms_slp1": ["azwApadaM", "azwApadaH"]}], "aswamangala": [{"id": "azwamaMgala", "headword": "अष्टमंगल", "headword_slp1": "azwamaMgala", "fold": "aswamangala", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-मंगल n. the collection of eight lucky things; (they are differently enumerated- (1) मृगराजो वृषो नागः कलशो व्यजनं तथा । वैजयन्ती तथा भेरी दीप इत्यष्टमंगलम्; (2) लोकोस्मिन् मंगलान्यष्टौ ब्राह्मणो गौर्हुताशनः । हिरण्यं सर्पिरादित्य आपो राजा तथाष्टमः).", "gloss_language": "en"}], "synonyms": ["अष्टमङ्गल", "अष्टमङ्गलं", "अष्टमङ्गलः"], "synonyms_slp1": ["azwamaNgala", "azwamaNgalaM", "azwamaNgalaH"]}], "aswamasika": [{"id": "azwamAsika", "headword": "अष्टमासिक", "headword_slp1": "azwamAsika", "fold": "aswamasika", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-मासिक a. occurring once in eight months.", "gloss_language": "en"}]}], "aswamurti": [{"id": "azwamUrti", "headword": "अष्टमूर्ति", "headword_slp1": "azwamUrti", "fold": "aswamurti", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-मूर्ति m. the eight-formed, an epithet of Śiva; (these eight forms are thus enumerated in the opening stanza of the Sak.- या सृष्टिः स्रष्टुराद्या (i.e. water) वहति विधिहुतं या हविः (i.e. fire) या च होत्री (i.e. the sacrificer) ये द्वे कालं दिधत्तः (i.e. the Sun and the moon) श्रुतिविषयगुणा या स्थिता व्याप्य विश्वम् (i.e. æther) यामाहुः सर्वभूतप्रकृतिरिति (i.e. the earth) यथा प्राणिनः प्राणवन्तः (i.e. air) प्रत्यक्षामिः प्रपन्नस्तनुभिरवतु वस्ताभिरष्टाभिरीशः).", "gloss_language": "en"}], "synonyms": ["अष्टमूर्तिः", "अष्टमूर्त्ति", "अष्टमूर्त्तिः"], "synonyms_slp1": ["azwamUrtiH", "azwamUrtti", "azwamUrttiH"]}], "aswamurtiDara": [{"id": "azwamUrtiDara", "headword": "अष्टमूर्तिधर", "headword_slp1": "azwamUrtiDara", "fold": "aswamurtiDara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-मूर्ति˚धर m. (possessing eight forms) an epithet of Śiva.", "gloss_language": "en"}], "synonyms": ["अष्टमूर्त्तिधर"], "synonyms_slp1": ["azwamUrttiDara"]}], "aswaratna": [{"id": "azwaratna", "headword": "अष्टरत्न", "headword_slp1": "azwaratna", "fold": "aswaratna", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "अष्टन्-रत्न n. the eight jewels tak