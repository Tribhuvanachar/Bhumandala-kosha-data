{"suKa": [{"id": "suKa", "headword": "सुख", "headword_slp1": "suKa", "fold": "suKa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "सुख (I) a. (f. खा) 1. Happy, joyful, delighted; 2. agreeable, sweet, comfortable, दिशः प्रसेदुर्मरुतो ववुः सुखाः R.iii.14; 3. virtuous, pious; 4. easy, practicable; 5. meet, suitable.", "gloss_language": "en"}, {"gloss": "सुख (II) n. 1. Happiness, pleasure, delight, joy, comfort, सुखं हि दुःखान्यनुभूय शोभते Mrich.i.; 2. prosperity, सुखे वा दुःखे वा क्व नु खलु तदैक्यं हृदययोः Ut.vi.; 3. ease, alleviation; 4. easiness; 5. heaven, paradise; 6. water.(सुखा f. ‘the city of Varuṇa.’)(सुखम् is used as an indeclinable in the sense of- (1) happily, joyfully, well, e.g. सुखमास्तं भवान् ‘may your honour be well’; (2) willingly, rather; (3) comfortably, सुखं शेते मातस्तव खलु कृपातः पुनरयं जगन्नाथः G.L.30; (4) easily, अज्ञः सुखमाराध्यः सुखतरमाराध्यते विषेषज्ञः Bhartr.ii.3, Bg.v.3.)", "gloss_language": "en"}], "synonyms": ["सुखं"], "synonyms_slp1": ["suKaM"]}, {"id": "suKA", "headword": "सुखा", "headword_slp1": "suKA", "fold": "suKa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "सुख (I) a. (f. खा) 1. Happy, joyful, delighted; 2. agreeable, sweet, comfortable, दिशः प्रसेदुर्मरुतो ववुः सुखाः R.iii.14; 3. virtuous, pious; 4. easy, practicable; 5. meet, suitable.", "gloss_language": "en"}]}], "suKaDara": [{"id": "suKADAra", "headword": "सुखाधार", "headword_slp1": "suKADAra", "fold": "suKaDara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "सुख-आधार m. paradise.", "gloss_language": "en"}], "synonyms": ["सुखाधारः"], "synonyms_slp1": ["suKADAraH"]}], "suKaplava": [{"id": "suKAplava", "headword": "सुखाप्लव", "headword_slp1": "suKAplava", "fold": "suKaplava", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "सुख-आप्लव a. convenient for bathing.", "gloss_language": "en"}]}], "suKayata": [{"id": "suKAyata", "headword": "सुखायत", "headword_slp1": "suKAyata", "fold": "suKayata