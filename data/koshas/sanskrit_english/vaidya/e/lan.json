, "lANgUlaM"]}], "lanG": [{"id": "laMG", "headword": "लंघ्", "headword_slp1": "laMG", "fold": "lanG", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंघ् (I) vt. or vi. 1U (pp. लंघित; pres. लंघति-ते; desid. लिलंघिषति-ते) 1. To abstain from food, to fast; 2. to go, to leap, to go by leaps; 3. to go beyond, to transgress; 4. to traverse, to mount upon, अन्ये चालंघिषुः शैलान् Bt.xv.32, R.iv.52, i.47; 5. to dry, to dry up.", "gloss_language": "en"}, {"gloss": "लंघ् (II) vt. 10U (pres. लंघयति-ते) See Caus. below.", "gloss_language": "en"}, {"gloss": "लंघ् Caus. (लंघयति-ते) 1. to leap over, to go beyond, न लंघयेद्वत्सतंत्रीम् M.iv.38; 2. to traverse, to mount, to ascend; 3. to violate, to disregard, to disrespect, to offend, to displease, हस्त इव भूतिमलिनो यथायथा लंघयति खलः सुजनम् Vas.D.; 4. to cause to fast; 5. to excel, to surpass, to outshine, जगत्प्रकाशं तदशेषमिज्यया भवद्गुरुर्लंघयितुं ममोद्यतः R.iii.48; 6. to shine; 7. to disobey, R.ix.9; 8. to avert, e.g. नियतिः केन लंघ्यते.With अभि-, 1. to go beyond; 2. to transgress, to disobey.With उद्-, 1. to go over, to cross over; 2. to mount.With वि-, 1. to traverse, विलंघिताध्वा R.v.42; 2. to go beyond proper limits, R.ix.74; 3. to violate, to neglect, गम्तुं प्रवृत्ते समयं विलंघ्य K.S.iii.25; 4. to surpass, to excel, कर्णोत्पलं प्रायस्त्व दृष्ट्या विलंघ्यते K.D.ii.224; 5. to give up, to abandon, मनो बबंधान्यरसान्विलंघ्य सा R.iii.4; 6. to cause to fast.", "gloss_language": "en"}], "synonyms": ["लङ्घ्"], "synonyms_slp1": ["laNG"]}], "lanGana": [{"id": "laMGana", "headword": "लंघन", "headword_slp1": "laMGana", "fold": "lanGana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंघन m. 1. The act of leaping; 2. stepping across, R.xvi.33; 3. ascending, mounting, attaining, जनोयमुच्चैःपदलंघनोत्सुकः K.S.v.64; 4. storming, capturing; 5. exceeding, going beyond, transgressing; 6. despising, disregarding; (as in प्रणिपातलंघन); 7. injury, harm (as in आतपलंघन); 8. fasting, abstinence; 9. a particular pace of a horse; 10. going by leaps, going quickly, यूयमेव पथि शीघ्रलंघनाः Ghat.8.", "gloss_language": "en"}], "synonyms": ["लंघनं", "लङ्घन", "लङ्घनं"], "synonyms_slp1": ["laMGanaM", "laNGana", "laNGanaM"]}], "lanGita": [{"id": "laMGita", "headword": "लंघित", "headword_slp1": "laMGita", "fold": "lanGita", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंघित a. (f. ता) 1. Leaped over; 2. traversed; 3. transgressed, violated; 4. insulted, disregarded.", "gloss_language": "en"}], "synonyms": ["लङ्घित"], "synonyms_slp1": ["laNGita"]}, {"id": "laMGitA", "headword": "लंघिता", "headword_slp1": "laMGitA", "fold": "lanGita", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंघित a. (f. ता) 1. Leaped over; 2. traversed; 3. transgressed, violated; 4. insulted, disregarded.", "gloss_language": "en"}]}], "lanja": [{"id": "laMja", "headword": "लंज", "headword_slp1": "laMja", "fold": "lanja", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंज m. 1. A foot; 2. a tail; 3. the end of a lower garment tucked behind.", "gloss_language": "en"}], "synonyms": ["लंजः", "लञ्ज", "लञ्जः"], "synonyms_slp1": ["laMjaH", "laYja", "laYjaH"]}, {"id": "laMjA", "headword": "लंजा", "headword_slp1": "laMjA", "fold": "lanja", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंजा f. 1. A current; 2. sleep; 3. an adulteress; 4. an epithet of Lakṣmī.", "gloss_language": "en"}]}], "lanjika": [{"id": "laMjikA", "headword": "लंजिका", "headword_slp1": "laMjikA", "fold": "lanjika", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंजिका f. A whore, a prostitute.", "gloss_language": "en"}], "synonyms": ["लञ्जिका"], "synonyms_slp1": ["laYjikA"]}], "lanqa": [{"id": "laMqa", "headword": "लंड", "headword_slp1": "laMqa", "fold": "lanqa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "लंड n. Excrement.", "gloss_language": "en"}], "synonyms": ["लंडं", "लण्ड", "लण्डं"], "synonyms_slp1": ["l