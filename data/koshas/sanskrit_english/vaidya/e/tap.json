िर); 2. the winter (हेमंत); 3. the hot season (ग्रीष्म).", "gloss_language": "en"}]}], "taponuBava": [{"id": "taponuBAva", "headword": "तपोनुभाव", "headword_slp1": "taponuBAva", "fold": "taponuBava", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपोनुभाव m. the influence of religious penance.", "gloss_language": "en"}], "synonyms": ["तपोनुभावः"], "synonyms_slp1": ["taponuBAvaH"]}], "tapovawa": [{"id": "tapovawa", "headword": "तपोवट", "headword_slp1": "tapovawa", "fold": "tapovawa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपोऽवट m. the Brahmāvarta country.", "gloss_language": "en"}], "synonyms": ["तपोवटः"], "synonyms_slp1": ["tapovawaH"]}], "tapaHklesa": [{"id": "tapaHkleSa", "headword": "तपःक्लेश", "headword_slp1": "tapaHkleSa", "fold": "tapaHklesa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपःक्लेश m. the pain of austerity.", "gloss_language": "en"}], "synonyms": ["तपःक्लेशः"], "synonyms_slp1": ["tapaHkleSaH"]}], "tapascaraRa": [{"id": "tapaScaraRa", "headword": "तपश्चरण", "headword_slp1": "tapaScaraRa", "fold": "tapascaraRa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपश्चरण n. the practice of penance.", "gloss_language": "en"}]}], "tapascarya": [{"id": "tapaScaryA", "headword": "तपश्चर्या", "headword_slp1": "tapaScaryA", "fold": "tapascarya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपश्चर्या f. the practice of penance.", "gloss_language": "en"}]}], "tapastaksa": [{"id": "tapastakza", "headword": "तपस्तक्ष", "headword_slp1": "tapastakza", "fold": "tapastaksa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपस्-तक्ष m. an epithet of Indra.", "gloss_language": "en"}], "synonyms": ["तपस्तक्षः"], "synonyms_slp1": ["tapastakzaH"]}], "tapoDana": [{"id": "tapoDana", "headword": "तपोधन", "headword_slp1": "tapoDana", "fold": "tapoDana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तपोधन m. an 