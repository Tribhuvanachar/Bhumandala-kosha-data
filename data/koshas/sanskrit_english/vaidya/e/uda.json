antaH"]}], "udantaka": [{"id": "udaMtaka", "headword": "उदंतक", "headword_slp1": "udaMtaka", "fold": "udantaka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "उदंतक m. News, tidings.", "gloss_language": "en"}], "synonyms": ["उदंतकः", "उदन्तक", "उदन्तकः"], "synonyms_slp1": ["udaMtakaH", "udantaka", "udantakaH"]}], "udantika": [{"id": "udaMtikA", "headword": "उदंतिका", "headword_slp1": "udaMtikA", "fold": "udantika", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "उदंतिका f. Satisfaction, satiety.", "gloss_language": "en"}], "synonyms": ["उदन्तिका"], "synonyms_slp1": ["udantikA"]}], "udanya": [{"id": "udanyA", "headword": "उदन्या", "headword_slp1": "udanyA", "fold": "udanya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "उदन्या f. Thirst, निर्वर्त्यतामुदन्याप्रतीकारः Ve.vi.", "gloss_language": "en"}]}], "udaya": [{"id": "udaya", "headword": "उदय", "headword_slp1": "udaya", "fold": "udaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "उदय m. 1. Going upwards, rising, चंद्रोदय इवोदधेःR.xii.36, ii.73; 2. advancement, prosperity, तेजोद्वयस्य युगपद् व्यसनोदयाभ्याम् Sak.iv., R.ix.7; 3. the eastern mountain behind which the sun is supposed to rise; 4. creation, production, rise, आफलोदयकर्मणाम् R.i.5, K.S.iii.18, R.viii.22; 5. light, splendour; 6. result, consequence, R.i.15; 7. accomplishment, fulfilment, R.iii.1; 8. profit, revenue; 9. interest (i.e. premium paid for the use of money).", "gloss_language": "en"}], "synonyms": ["उदयः"], "synonyms_slp1": ["udayaH"]}], "udayacala": [{"id": "udayAcala", "headword": "उदयाचल", "headword_slp1": "udayAcala", "fold": "udayacala", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "उदय-अचल, -अद्रि, -पर्वत, -गिरि, -शैल m. the eastern mountain behind which the sun rises, उदयगिरिवनालीबालमंदारपुष्पम् Ud., or श्रितोदयाद्रेरभिसायमुच्चकैः Sis.i.10.", "gloss_language": "en"}], "synonyms": ["उदयाचलः"], "synonyms_slp1": ["udayAcalaH"]}], 