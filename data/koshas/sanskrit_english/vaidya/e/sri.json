{"sri": [{"id": "Sri", "headword": "श्रि", "headword_slp1": "Sri", "fold": "sri", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्रि vt. 1U (pp. श्रित; pres. श्रयति-ते; desid. शिश्रायिषयि-ते or शिश्रीषति-ते) 1. To have recourse to, to go to, to approach, शिश्रिये श्रुतवतामपश्चिमः पश्चिमे वयसि नैमिषं वशी R.xix.1, iii.70; 2. to take, to assume, to undergo, द्विपेंद्रभावं कलभः श्रयन्निव R.iii.32; 3. to cling to, to depend on; 4. to honour, to worship; 5. to dwell in.With अधि-, to ascend.With आ-, 1. to go to, to have recourse to, to take refuge with; 2. to enter; 3. to undergo, to assume, to take, एको रसः करुण एव निमित्तभेदाद्भिन्नः पृथक् पृथगिवाश्रयेति विवर्तान् Ut.iii.; 4. to follow; 5. to choose; 6. to inhabit, M.vii.72; 7. to depend upon, M.i.17; 8. to use.With उद्-, to raise.With सम्-, 1. to have recourse to; 2. to depend on; 3. to get, to obtain, to attain, M.x.60; 4. to see.", "gloss_language": "en"}]}, {"id": "SrI", "headword": "श्री", "headword_slp1": "SrI", "fold": "sri", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्री (I) vt. 9U (pres. श्रीणाति, श्रीणीते) To cook, to dress, to boil.", "gloss_language": "en"}, {"gloss": "श्री (II) vt. 1U, 10U (pres. श्रयति-ते, श्राययति-ते) To please, to propitiate.", "gloss_language": "en"}, {"gloss": "श्री f. 1. Wealth, prosperity, riches, plenty, R.iii.46, Megh.i.30; 2. royalty, majesty, royal glory; 3. the insignia of royalty, K.S.vii.46; 4. beauty, grace, loveliness, splendour, Megh.i.47, K.S.vii.32, R.iii.8, Sis.iv.68, i.75; 5. appearance, K.S.ii.2; 6. Lakṣmī, the goddess of wealth, श्रियः पतिः श्रीमति शासितुंजगत् Sis.i.1, ii.118; 7. intellect, understanding; 8. any virtue or excellence; 9. the three objects of life collectively (viz., धर्म, अर्थ and काम); 10. superhuman power; 11. a lotus; 12. cloves; 13. the sarala tree; 14. the Bilva tree; (this word will be found used in the concluding stanza of each canto of the Śiśupālavadha; it is used as an honorific prefix to the names of deities, e.g. श्रीराम, श्रीकृष्ण, as a prefix to the names or eminent persons, e.g. श्रीवाल्मीकि and celebrated works, e.g. श्रीरामायण and is found used at the beginning of manuscripts).", "gloss_language": "en"}]}], "srita": [{"id": "Srita", "headword": "श्रित", "headword_slp1": "Srita", "fold": "srita", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्रित a. (f. ता) 1. Gone to, approached, approached for protection; 2. rested on, clung to; 3. joined with, connected with; 4. protected; 5. honoured, worshipped; 6. overspread; 7. auxiliary, subservient; 8. collected, assembled.", "gloss_language": "en"}], "synonyms": ["श्रितः"], "synonyms_slp1": ["SritaH"]}, {"id": "SritA", "headword": "श्रिता", "headword_slp1": "SritA", "fold": "srita", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्रित a. (f. ता) 1. Gone to, approached, approached for protection; 2. rested on, clung to; 3. joined with, connected with; 4. protected; 5. honoured, worshipped; 6. overspread; 7. auxiliary, subservient; 8. collected, assembled.", "gloss_language": "en"}]}], "sriti": [{"id": "Sriti", "headword": "श्रिति", "headword_slp1": "Sriti", "fold": "sriti", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्रिति f. Approach, recourse.", "gloss_language": "en"}], "synonyms": ["श्रितिः"], "synonyms_slp1": ["SritiH"]}], "sris": [{"id": "Sriz", "headword": "श्रिष्", "headword_slp1": "Sriz", "fold": "sris", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्रिष् vt. 1P (pres. श्रेषति) To burn.", "gloss_language": "en"}]}], "srisa": [{"id": "SrISa", "headword": "श्रीश", "headword_slp1": "SrISa", "fold": "srisa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "श्री-ईश m. an epithet of Viṣṇu.", "gloss_language": "en"}], "synonyms": ["श्रीशः"], "synonyms_slp1": ["SrISaH"]}], "srikanWa": [{"id": "SrIkaMWa", "headword": "श्रीकंठ", "headword_slp1": "SrIkaMWa", "fold": "srikanWa", "headword_languag