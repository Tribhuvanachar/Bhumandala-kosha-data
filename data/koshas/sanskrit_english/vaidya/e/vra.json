{"vraj": [{"id": "vraj", "headword": "व्रज्", "headword_slp1": "vraj", "fold": "vraj", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "व्रज् vt. 1P (pres. व्रजति) 1. To go, to proceed, न चोच्छिष्टः क्वचिद् व्रजेत् M.ii.56; 2. to pass away (as time). (This verb is used in many of the senses of गम् q.v.).With अनु-, 1. to follow, M.xi.111; 2. to perform.With परि-, to wander about as a mendicant.With प्र-, 1. to go into exile; 2. to renounce the world, to enter on the fourth stage of life, to become a Sannyāsin, M.vi.39.With प्रति-, to go to or towards, Bt.viii.96.With प्रत्युद्-, to go out to meet.", "gloss_language": "en"}]}], "vraja": [{"id": "vraja", "headword": "व्रज", "headword_slp1": "vraja", "fold": "vraja", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "व्रज m. 1. A flock, a multitude, रुचिरचित्रतनूरुहशालिभिर्विचलितैः परितः प्रियकव्रजैः Sis.iv.32, R.vi.7; 2. a station of cowherds; 3. a cowpen; 4. a road; 5. an abode; 6. name of a district near Mathurā, Bh.V.ii.165, 179.", "gloss_language": "en"}], "synonyms": ["व्रजं", "व्रजः"], "synonyms_slp1": ["vrajaM", "vrajaH"]}], "vrajangana": [{"id": "vrajAMganA", "headword": "व्रजांगना", "headword_slp1": "vrajAMganA", "fold": "vrajangana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "व्रज-अंगना f. a woman of Vraja, a cowherdess, Bh.V.ii.165, 179.", "gloss_language": "en"}], "synonyms": ["व्रजाङ्गना"], "synonyms_slp1": ["vrajANganA"]}], "vrajajira": [{"id": "vrajAjira", "headword": "व्रजाजिर", "headword_slp1": "vrajAjira", "fold": "vrajajira", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "व्रज-अजिर n. a cowpen.", "gloss_language": "en"}]}], "vrajakisora": [{"id": "vrajakiSora", "headword": "व्रजकिशोर", "headword_slp1": "vrajakiSora", "fold": "vrajakisora", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "व्रज-किशोर, -नाथ, -मोहन, -वर, -वल्लभ m. an epithet of Kṛṣṇa.", "gloss_language": "en"}], "synonyms": ["व्रजकिश