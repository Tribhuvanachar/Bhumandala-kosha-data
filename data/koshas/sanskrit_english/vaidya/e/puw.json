{"puw": [{"id": "puw", "headword": "पुट्", "headword_slp1": "puw", "fold": "puw", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पुट् (I) vt. 6U (pres. पुटति) To embrace, to clasp, to intertwine.", "gloss_language": "en"}, {"gloss": "पुट् (II) vt. 10U (pres. पुटयति-ते) 1. To be in contact with; 2. to bind together.", "gloss_language": "en"}, {"gloss": "पुट् (III) vt. or vi. 10U (pres. पोटयति-ते) 1. To reduce to powder; 2. to shine; 3. to speak.", "gloss_language": "en"}]}], "puwa": [{"id": "puwa", "headword": "पुट", "headword_slp1": "puwa", "fold": "puwa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पुट (I) m.n. 1. A pocket; 2. a cup made of a leaf folded or doubled, R.ii.65; 3. a cavity, a concavity, e.g. अंजलिपुट; 4. the pod which envelops a young shoot, भिन्नपल्लवपुटो वनानिलः R.ix.68; 5. a cover, a covering; 6. an eyelid; 7. a horse’s hoof.", "gloss_language": "en"}, {"gloss": "पुट (II) m. A casket.", "gloss_language": "en"}, {"gloss": "पुट (III) m. A nutmeg.", "gloss_language": "en"}], "synonyms": ["पुटं", "पुटः"], "synonyms_slp1": ["puwaM", "puwaH"]}], "puwowaja": [{"id": "puwowaja", "headword": "पुटोटज", "headword_slp1": "puwowaja", "fold": "puwowaja", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पुट-उटज n. a white parasol.", "gloss_language": "en"}]}], "puwodaka": [{"id": "puwodaka", "headword": "पुटोदक", "headword_slp1": "puwodaka", "fold": "puwodaka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पुट-उदक m. a cocoanut.", "gloss_language": "en"}], "synonyms": ["पुटोदकः"], "synonyms_slp1": ["puwodakaH"]}], "puwagriva": [{"id": "puwagrIva", "headword": "पुटग्रीव", "headword_slp1": "puwagrIva", "fold": "puwagriva", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पुट-ग्रीव m. 1. a jar, a pitcher; 2. a copper vessel.", "gloss_language": "en"}], "synonyms": ["पुटग्रीवः"], "synonyms_slp1": ["puwagrIvaH"]}], "puwapaka": [{"id": "puwapAka", "headword": "