{"tanka": [{"id": "taMka", "headword": "तंक", "headword_slp1": "taMka", "fold": "tanka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तंक m. 1. Living in distress; 2. grief produced by separation from a beloved object; 3. fear, terror; 4. a stone-cutter’s chisel.", "gloss_language": "en"}], "synonyms": ["तंकः", "तङ्क", "तङ्कः"], "synonyms_slp1": ["taMkaH", "taNka", "taNkaH"]}], "tankana": [{"id": "taMkana", "headword": "तंकन", "headword_slp1": "taMkana", "fold": "tankana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तंकन n. Living in distress.", "gloss_language": "en"}]}], "tanc": [{"id": "taMc", "headword": "तंच्", "headword_slp1": "taMc", "fold": "tanc", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तंच् vt. 7P (pp. तंचित; pres. तनक्ति) To contract, to shrink, तनच्मि व्योम विस्तृतम् Bt.vi.38.", "gloss_language": "en"}], "synonyms": ["तञ्च्"], "synonyms_slp1": ["taYc"]}], "tanqaka": [{"id": "taMqaka", "headword": "तंडक", "headword_slp1": "taMqaka", "fold": "tanqaka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तंडक m. The Khanjana bird.", "gloss_language": "en"}], "synonyms": ["तंडकः", "तण्डक", "तण्डकः"], "synonyms_slp1": ["taMqakaH", "taRqaka", "taRqakaH"]}], "tanqula": [{"id": "taMqula", "headword": "तंडुल", "headword_slp1": "taMqula", "fold": "tanqula", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तंडुल m.n. Grain after thrashing, winnowing and unhusking (especially rice); the following stanza distinguishes between शस्य, धाण्य, तंडुल and अन्न- शस्यं क्षेत्रगतं प्रोक्तं सतुषं धान्यमुच्यते । निस्तुषस्तंडुलः प्रोक्तः स्विन्नमन्नमुदाहृतम्.", "gloss_language": "en"}], "synonyms": ["तंडुलः", "तण्डुल", "तण्डुलः"], "synonyms_slp1": ["taMqulaH", "taRqula", "taRqulaH"]}], "tanmaya": [{"id": "tanmaya", "headword": "तन्मय", "headword_slp1": "tanmaya", "fold": "tanmaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तन्मय a. 1. made up of that; 2. absorbed in or identical with that, become one with that.", "gloss_language": "en"}]}], "tanmatra": [{"id": "tanmAtra", "headword": "तन्मात्र", "headword_slp1": "tanmAtra", "fold": "tanmatra", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तन्मात्र n. 1. merely that, i.e. only a trifle; 2. a subtile and primary element (in Phil.).", "gloss_language": "en"}], "synonyms": ["तन्मात्रं"], "synonyms_slp1": ["tanmAtraM"]}], "tana": [{"id": "tana", "headword": "तन", "headword_slp1": "tana", "fold": "tana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तन (I) vt. 8U (pp. तत; pres. तनोति, तनुते; pass. तन्यते, तायते; desid. तितंसति, तितासति, तितानिषति.) 1. To spread, to extend, to stretch, Bt.xv.91, x.22; 2. to cover, स तमीं तमोभिरभिगम्य तताम् Sis.ix.23; 3. to do, to accomplish, to perform (as a sacrifice), नवतिं नवाधिकां महाक्रतूनां महनीयशासनः । समारुरुक्षुर्दिवमायुषः क्षये ततान सोपानपरंपरामिव R.iii.69; 4. to cause, to grant, to bestow, to give, पितुर्मुदं तेन ततान सोऽर्भकः R.iii.25; 5. to compose (as a work), e.g. तनुते टीकाम्; 6. to bend (as a bow); 7. to propagate; 8. to spin out, to weave.With अव-, 1. to cover; 2. to descend.With आ-, 1. to stretch, मौर्वी धनुषि चातता R.i.19; 2. to cause, to create, to make; 3. to diffuse, to spread.With प्र-, 1. to spread, यशांसि कवयो दिक्षु प्रतन्वंति नः Bhartr.iii.24; 2. to cause, to create; 3. to perform (as a sacrifice); 4. to cover; 5. to show, to exhibit, to show off, तद्भरीकृत्य कृतिभिर्वाचस्पत्यं प्रतायते Sis.ii.30.With वि-, 1. to cover, यो वितन्य स्थितः खम् Megh.i.58; 2. to spread; 3. to form, श्रेणीबंधाद्वितन्वद्भिरस्तंभां तोरणस्रजम् R.i.41; 4. to stretch (as a bow), वितत्य शार्ङ्गम् Bt.iii.47; 5. to cause, to give, to bestow; 6. to perform (as a sacrifice); 7. to compose (as a work), e.g. भावदीपो वितन्यते.With सम्-, to continue.", "gloss_language": "en"}, {"gloss": "तन (II) vt. 1P, 10U (pres. तनति, तानयति-ते) 1. To confide, to have faith in; 2. to assist, to aid; 3. to afflict with disease.With वि-, to spread, to extend.", "gloss_language": "en"}], "synonyms": ["तनः"], "synonyms_slp1": ["tanaH"]}, {"id": "tAna", "headword": "तान", "headword_slp1": "tAna", "fold": "tana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तान (I) m. 1. A thread, a fibre; 2. a protracted tone (in music), तानप्रदायित्वमिवोपगंतुम् K.S.i.8.", "gloss_language": "en"}, {"gloss": "तान (II) n. 1. Expanse, extension; 2. an object of sense.", "gloss_language": "en"}], "synonyms": ["तानं", "तानः"], "synonyms_slp1": ["tAnaM", "tAnaH"]}], "tanaya": [{"id": "tanaya", "headword": "तनय", "headword_slp1": "tanaya", "fold": "tanaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तनय m. 1. A son, R.ii.64; 2. a male descendant.", "gloss_language": "en"}], "synonyms": ["तनयः"], "synonyms_slp1": ["tanayaH"]}, {"id": "tanayA", "headword": "तनया", "headword_slp1": "tanayA", "fold": "tanaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तनया f. A daughter, R.ii.37.", "gloss_language": "en"}]}], "taniman": [{"id": "taniman", "headword": "तनिमन्", "headword_slp1": "taniman", "fold": "taniman", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तनिमन् m. Thinness, slenderness, minuteness.", "gloss_language": "en"}]}], "tanu": [{"id": "tanu", "headword": "तनु", "headword_slp1": "tanu", "fold": "tanu", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "तनु (I) a. (f. नु or न्वी) 1. Thin, emaciated; 2. small, puny, tiny, scanty, तनुवाग्विभवोऽपि सन् R.i.9, iii.2; 3. delicate, fine; 4. little, unimportant, trifling, Am.S.27; 5. shallow (as a river).", "gloss_language": "en"}, {"gloss": "तनु (II) f. 1. The body, the person; 2. form, appearance, प्रपन्नस्तनुभिरवतु वस्ताभिरष्टाभिरीशः Sak.i., Megh.ii.26; 3. the skin.", "gloss_language": "en"}], "synonyms": ["तनुः"], "synonyms_slp1": ["tanuH"]}, {"id": "tanU", "headword": "तनू", "headword_slp1": "tanU", "fold": "tanu", "headword_langu