{"ksi": [{"id": "kzi", "headword": "क्षि", "headword_slp1": "kzi", "fold": "ksi", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षि (I) vt. or vi. 1P (pp. क्षित or क्षीण) 1. To decay, to waste; 2. to rule, to be master of.", "gloss_language": "en"}, {"gloss": "क्षि (II) vt. 5P, 9P (pres. क्षिणोति, क्षिणाति) 1. To destroy, to diminish, to corrupt, न तद्यशः शस्त्रभृतां क्षिणोति R.ii.40; 2. to kill, to injure.", "gloss_language": "en"}, {"gloss": "क्षि Pass. (क्षीयते) 1. to waste, to decay, to be diminished, प्रतिक्षणमयं कायः क्षीयमाणो न लक्ष्यते Hit.i., पथिकस्तथापि किमपि ध्यायन् मुहुः क्षीयते Am.S.93.With अप-, to decay, to decline, to be diminished.With परि-, प्रसम्-, 1. to decay, to wane; 2. to be emaciated.", "gloss_language": "en"}, {"gloss": "क्षि Caus. (क्षययति, क्षपयति) to destroy, to remove, ममापि च क्षपयतु नीललोहितः पुनर्भवम् Sak.vii., Megh.i.53, R.viii.47.", "gloss_language": "en"}], "synonyms": ["क्षिः"], "synonyms_slp1": ["kziH"]}], "ksiti": [{"id": "kziti", "headword": "क्षिति", "headword_slp1": "kziti", "fold": "ksiti", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति f. 1. The earth; 2. an abode, a house; 3. loss, destruction; 4. the end of the world.", "gloss_language": "en"}], "synonyms": ["क्षितिः"], "synonyms_slp1": ["kzitiH"]}], "ksitisa": [{"id": "kzitISa", "headword": "क्षितीश", "headword_slp1": "kzitISa", "fold": "ksitisa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति-ईश, -ईश्वर m. a king, R.i.5, iii.3, xi.1.", "gloss_language": "en"}], "synonyms": ["क्षितीशः"], "synonyms_slp1": ["kzitISaH"]}], "ksitisvara": [{"id": "kzitISvara", "headword": "क्षितीश्वर", "headword_slp1": "kzitISvara", "fold": "ksitisvara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति-ईश, -ईश्वर m. a king, R.i.5, iii.3, xi.1.", "gloss_language": "en"}], "synonyms": ["क्षितीश्वरः"], "synonyms_slp1": ["kzitISvaraH"]}], "ksitikaRa": [{"id": "kzitikaRa", "headword": "क्षित