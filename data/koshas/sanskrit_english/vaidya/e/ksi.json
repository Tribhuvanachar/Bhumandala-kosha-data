uh", "fold": "ksitiruh", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति-रुह् m. a tree.", "gloss_language": "en"}]}], "ksitivarDana": [{"id": "kzitivarDana", "headword": "क्षितिवर्धन", "headword_slp1": "kzitivarDana", "fold": "ksitivarDana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति-वर्धन m. a corpse.", "gloss_language": "en"}], "synonyms": ["क्षितिवर्द्धनः", "क्षितिवर्धनः"], "synonyms_slp1": ["kzitivardDanaH", "kzitivarDanaH"]}], "ksitivfti": [{"id": "kzitivftti", "headword": "क्षितिवृत्ति", "headword_slp1": "kzitivftti", "fold": "ksitivfti", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति-वृत्ति f. patient behaviour.", "gloss_language": "en"}], "synonyms": ["क्षितिवृत्तिः"], "synonyms_slp1": ["kzitivfttiH"]}], "ksitivyudasa": [{"id": "kzitivyudAsa", "headword": "क्षितिव्युदास", "headword_slp1": "kzitivyudAsa", "fold": "ksitivyudasa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिति-व्युदास m. a cave within the earth, a hole underground.", "gloss_language": "en"}], "synonyms": ["क्षितिव्युदासः"], "synonyms_slp1": ["kzitivyudAsaH"]}], "ksidra": [{"id": "kzidra", "headword": "क्षिद्र", "headword_slp1": "kzidra", "fold": "ksidra", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिद्र m. 1. A disease; 2. the sun; 3. a horn.", "gloss_language": "en"}], "synonyms": ["क्षिद्रः"], "synonyms_slp1": ["kzidraH"]}], "ksip": [{"id": "kzip", "headword": "क्षिप्", "headword_slp1": "kzip", "fold": "ksip", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिप् vt. 6U (but Par. when preceded by अभि, प्रति and अति) 4P (pp. क्षिप्त; pres. क्षिपति-ते, क्षिप्यति) 1. To throw, to cast, to send, to let go, यथा महाह्रदं प्राप्य क्षिप्तं लोहं विनश्यति M.xi.263, Sant.S.iii.16, Bhartr.iii.67; 2. to put on or into, स्रजमपि शिरस्यंधः क्षिप्तां धुनोत्यहिशंकया Sak.vii.; 3. to cast away, to get rid of, किं कूर्मस्य भरव्यथा न वपुषि क्ष्मां न क्षिपत्येष यत् Mud.ii.; 4. to fix, to attach to, तदा भृत्ये दोषान् क्षिपति Hit.ii.; 5. to reject, to disdain; 6. to insult, to revile, to abuse, M.viii.270, Sant.S.iii.10.With अधि-, 1. to offend, to abuse; 2. to surpass.With अव-, 1. to cast down, to abandon; 2. to slander.With आ-, 1. to hit, to pull down; 2. to pull off, to throw off, to take off, to snatch, प्रसाधिकालंबितमग्रपादमाक्षिप्य R.vii.7; 3. to neglect; 4. to insult; 5. to object to (as an argument); 6. to infer from circumstances.With उद्-, to throw up, Rt.i.22.With उप-, 1. to cast on, वपुषि वधाय तवं शस्त्रमुपक्षिपतः M.M.v.; 2. to insult; 3. to hint, छत्रं कार्यमुपक्षिपंति Mrich.ix.With नि-, 1. to put down, to throw down, Yaj.i.103, Am.S.80; 2. to entrust, to put in the hands of, to consign to the care of, M.viii.179, 180, vi.3; 3. to encamp; 4. to cast off.With परि-, 1. to surround, गंगास्रोतः परिक्षिप्तम् K.S.vi.38; 2. to embrace.With पर्या-, to bind up, to collect, (केशांतं) पर्याक्षिपन् काचिदुदारबंधं K.S.vii.14.With प्र-, 1. to throw at or in, क्षेत्रपतिना लगुडः प्रक्षिप्तः Hit.i., नामेध्यं प्रक्षिपेदग्नौ M.iv.53; 2. to interpolate, e.g. इदं पद्यं प्रक्षिप्तम्.With वि-, 1. to throw, to cast, Am.S.54; 2. to divert; 3. to distract.With सम्-, 1. to heap, to gather, आतपात्ययसंक्षिप्तनीवारासु निषादिभिः R.i.52; 2. to with-draw, to destroy; 3. to shorten, to abridge, संक्षिप्येत क्षणं इव कथं दीर्घयामा त्रियामा Megh.ii.45.", "gloss_language": "en"}]}], "ksipa": [{"id": "kzipA", "headword": "क्षिपा", "headword_slp1": "kzipA", "fold": "ksipa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिपा f. 1. Sending, throwing, casting; 2. night.", "gloss_language": "en"}]}], "ksipaRa": [{"id": "kzipaRa", "headword": "क्षिपण", "headword_slp1": "kzipaRa", "fold": "ksipaRa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "क्षिपण n. 1. Sending, throwing, casting; 2. reviling.", "gloss_language": "en"}], "synonyms": ["क्षिपणं"], "synonyms_slp1": ["kzipaRaM"]}], "ksipaRi": [{"id