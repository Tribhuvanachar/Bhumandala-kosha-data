{"atman": [{"id": "Atman", "headword": "आत्मन्", "headword_slp1": "Atman", "fold": "atman", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "आत्मन् m. 1. A soul, आत्मानं रथिनं विद्धि शरीरं रथमेव तु Katho.; 2. Brahman (n.) i.e. the supreme spirit, e.g. तस्माद्वा एतस्तमादात्मन आकाशः सम्भूतः; 3. spirit, vitality, courage; 4. the body, स्थितः सर्वोन्नतेनोर्वीं क्रान्त्वा मेरुरिवात्मना R.i.14, or भर्तृषूपसखि निक्षिपतीनामात्मनो मधुमदोद्यामितानाम् Kir.ix.66; 5. natural disposition; 6. understanding, तमात्मसम्पन्नमनिन्दितात्मा R.xviii.18 (where आत्मन् is used in senses 5 and 6); 7. the mind, आत्मानमात्मना वेत्सि K.S.ii.10; 8. the faculty of reason; 9. the sun; 10. the fire; 11. wind; 12. a son, e.g. आत्मा वै पुत्रनामासि; 13. the self; (used in this sense as a reflexive pronoun and in the singular number and masculine gender, even when it refers to two or more things, or to nouns in different genders, e.g. पुण्य श्रमदर्शनेन तावदात्मानं पुनीमहे Sak.i., गुप्तं ददृशुरात्मानं सर्वाः स्वप्नेषु वामनैः R.x.60, आत्मानं गोपायंति कुलस्त्रियः Bh. where आत्मानम् refers to a feminine noun in the plural), आत्मानं सततं रक्षेद्वारैरपि धनैरपि Hit.i.; 14. effort.", "gloss_language": "en"}]}], "atmaDina": [{"id": "AtmADIna", "headword": "आत्माधीन", "headword_slp1": "AtmADIna", "fold": "atmaDina", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "आत्मन्-अधीन (I) a. independent.", "gloss_language": "en"}, {"gloss": "आत्मन्-अधीन (II) m. 1. a wife’s brother; 2. a son; 3. jester (in dramatic literature).", "gloss_language": "en"}], "synonyms": ["आत्माधीनः"], "synonyms_slp1": ["AtmADInaH"]}], "atmapahara": [{"id": "AtmApahAra", "headword": "आत्मापहार", "headword_slp1": "AtmApahAra", "fold": "atmapahara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "आत्मन्-अपहार m. concealing one’s self, कथं वा आत्मापहारं करोमि Sak.i.", "gloss_language": "en"}], "synonyms": ["आत्मापहारः"], "synonyms_slp1": ["AtmApahAraH"]}], "atmasin": [{"id": "AtmASin", 