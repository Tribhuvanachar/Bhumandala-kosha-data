pataMjali", "headword": "पतंजलि", "headword_slp1": "pataMjali", "fold": "patanjali", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतंजलि m. 1. Name of the celebrated author of the Mahābhāshya, a commentary on Pāṇini’s sūtras; 2. name of a philosopher, the propounder of the yoga philosophy.", "gloss_language": "en"}], "synonyms": ["पतंजलिः", "पतञ्जलि", "पतञ्जलिः"], "synonyms_slp1": ["pataMjaliH", "pataYjali", "pataYjaliH"]}, {"id": "pAtaMjalI", "headword": "पातंजली", "headword_slp1": "pAtaMjalI", "fold": "patanjali", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पातंजल (I) a. (f. ली) Composed by Patanjali, पातंजले महाभाष्ये कृतभूरिपरिश्रमः Nāgojībhaṭṭa.", "gloss_language": "en"}]}], "patat": [{"id": "patat", "headword": "पतत्", "headword_slp1": "patat", "fold": "patat", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत् (I) a. (f. न्ती) Flying, alighting, coming down &c.", "gloss_language": "en"}, {"gloss": "पतत् (II) m. A bird, क्वचित्पथा संचरते सुराणां क्वचिद्घनानां पततां क्वचिच्च R.xiii.19, Sis.ix.15.", "gloss_language": "en"}], "synonyms": ["पतन्त्"], "synonyms_slp1": ["patant"]}], "patanti": [{"id": "patantI", "headword": "पतन्ती", "headword_slp1": "patantI", "fold": "patanti", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत् (I) a. (f. न्ती) Flying, alighting, coming down &c.", "gloss_language": "en"}]}], "patadgraha": [{"id": "patadgraha", "headword": "पतद्ग्रह", "headword_slp1": "patadgraha", "fold": "patadgraha", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत्-ग्रह m. 1. the reserve of an army; 2. a spitting-pot.", "gloss_language": "en"}], "synonyms": ["पतद्ग्रहः"], "synonyms_slp1": ["patadgrahaH"]}], "patadBiru": [{"id": "patadBIru", "headword": "पतद्भीरु", "headword_slp1": "patadBIru", "fold": "patadBiru", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत्-भीरु m. a hawk, a falcon.", "gloss_language": "en"}], "synonyms": ["पतद्भीरुः"], "synonyms_slp1": ["patadBIruH"]}], "patatra": [{"id": "patatra", "headword": "पतत्र", "headword_slp1": "patatra", "fold": "patatra", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत्र n. 1. A wing, a pinion; 2. a vehicle.", "gloss_language": "en"}], "synonyms": ["पतत्त्रं", "पतत्रं"], "synonyms_slp1": ["patattraM", "patatraM"]}], "patatri": [{"id": "patatri", "headword": "पतत्रि", "headword_slp1": "patatri", "fold": "patatri", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत्रि m. A bird.", "gloss_language": "en"}], "synonyms": ["पतत्रिः"], "synonyms_slp1": ["patatriH"]}], "patatrin": [{"id": "patatrin", "headword": "पतत्रिन्", "headword_slp1": "patatrin", "fold": "patatrin", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत्रिन् m. 1. A bird, R.viii.56, ix.27, K.S.v.4; 2. an arrow; 3. a horse.", "gloss_language": "en"}]}], "patatriketana": [{"id": "patatriketana", "headword": "पतत्रिकेतन", "headword_slp1": "patatriketana", "fold": "patatriketana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतत्रिन्-केतन m. an epithet of Viṣṇu.", "gloss_language": "en"}], "synonyms": ["पतत्रिकेतनः"], "synonyms_slp1": ["patatriketanaH"]}], "patana": [{"id": "patana", "headword": "पतन", "headword_slp1": "patana", "fold": "patana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतन n. 1. The act of flying down, alighting, descending; 2. setting; 3. apostacy; 4. decline, adversity, ruin, ग्रहाधीना नरेंद्राणामुच्छ्रायाः पतनानि च Yaj.i.308.", "gloss_language": "en"}], "synonyms": ["पतनं"], "synonyms_slp1": ["patanaM"]}, {"id": "pattana", "headword": "पत्तन", "headword_slp1": "pattana", "fold": "patana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पत्तन n. A town, a city, किं सति पत्तने ग्रामे रत्नपरीक्षा Mal.i. (Cf. पट्टन.)", "gloss_language": "en"}], "synonyms": ["पत्तनं"], "synonyms_slp1": ["pattanaM"]}, {"id": "pAtana", "headword": "पातन", "headword_slp1": "pAtana", "fold": "patana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पातन n. 1. Causing to fall, bringing down; 2. lowering, humbling.(दंडस्य पातनम् ‘causing the rod to fall, i.e. beating’; गर्भस्य पातनम् ‘causing the fœtus to fall, i.e. causing an abortion.’)", "gloss_language": "en"}], "synonyms": ["पातनं"], "synonyms_slp1": ["pAtanaM"]}], "pataniya": [{"id": "patanIya", "headword": "पतनीय", "headword_slp1": "patanIya", "fold": "pataniya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतनीय n. A degrading sin.", "gloss_language": "en"}]}], "patama": [{"id": "patama", "headword": "पतम", "headword_slp1": "patama", "fold": "patama", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतम m. 1. The moon; 2. a bird; 3. a grasshopper.", "gloss_language": "en"}], "synonyms": ["पतमः"], "synonyms_slp1": ["patamaH"]}], "patasa": [{"id": "patasa", "headword": "पतस", "headword_slp1": "patasa", "fold": "patasa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतम m. 1. The moon; 2. a bird; 3. a grasshopper.", "gloss_language": "en"}], "synonyms": ["पतसः"], "synonyms_slp1": ["patasaH"]}], "patayalu": [{"id": "patayAlu", "headword": "पतयालु", "headword_slp1": "patayAlu", "fold": "patayalu", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पतयालु a. Prone to fall.", "gloss_language": "en"}], "synonyms": ["पतयालुः"], "synonyms_slp1": ["patayAluH"]}], "pataka": [{"id": "patAkA", "headword": "पताका", "headword_slp1": "patAkA", "fold": "pataka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "पताका f. 1. A flag, a banner; 2. a flag-staff; 3. a sign, a mark, a symbol; 4. an episode in a drama; (See पताकास्थानक); 5. good fortune, good luck, auspiciousness.", "gloss_language": "en"}]}, {"id": "pAtaka", "headword": "पातक", "headword_slp1": "pAtaka", "fold": "pataka", "headword_language": "sa", "source": "vaidya", "senses": [