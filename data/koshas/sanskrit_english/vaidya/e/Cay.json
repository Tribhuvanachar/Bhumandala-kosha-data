{"Caya": [{"id": "CAyA", "headword": "छाया", "headword_slp1": "CAyA", "fold": "Caya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "छाया f. 1. Shade, shadow, आसीत्कल्पतरुच्छायामाश्रिता सुरभिः पथि R.i.75, ii.6, iii.70, K.S.vi.46, Megh.ii.4; (at the end of Tatpur. compounds, छाया (f.) is changed into छाय (n.), when thickness of the shade is intended to be indicated. See R.iv.20, viii.4, xii.50); 2. a reflection, छाया न मूर्छति मलोपहतप्रसादे शुद्धे तु दर्पणतले सुलभावकाशा Sak.vii.; 3. a shadowy fancy, hallucination; 4. blending of colours; 5. lustre, light, छायामंडललक्ष्येण R.iv.5, रत्नच्छायाव्यधिकारः Megh.i.15, 35; 6. colour, complexion, e.g. मेघैरंतरितः प्रिये तव मुखच्छायानुकारी शशी, or अरुणच्छायहृदयम् Git.G.viii.; 7. beauty, Megh.ii.17, 41; 8. protection; 9. a row, a line; 10. darkness; 11. a bribe; 12. name of a wife of the Sun, the mother of Saturn; 13. an epithet of Durgā.", "gloss_language": "en"}]}], "Cayanka": [{"id": "CAyAMka", "headword": "छायांक", "headword_slp1": "CAyAMka", "fold": "Cayanka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "छाया-अंक m. the moon.", "gloss_language": "en"}], "synonyms": ["छायाङ्क", "छायाङ्कः"], "synonyms_slp1": ["CAyANka", "CAyANkaH"]}], "Cayakara": [{"id": "CAyAkara", "headword": "छायाकर", "headword_slp1": "CAyAkara", "fold": "Cayakara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "छाया-कर m. the bearer of an umbrella.", "gloss_language": "en"}], "synonyms": ["छायाकरः"], "synonyms_slp1": ["CAyAkaraH"]}], "Cayagraha": [{"id": "CAyAgraha", "headword": "छायाग्रह", "headword_slp1": "CAyAgraha", "fold": "Cayagraha", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "छाया-ग्रह m. a mirror.", "gloss_language": "en"}], "synonyms": ["छायाग्रहः"], "synonyms_slp1": ["CAyAgrahaH"]}], "Cayatanaya": [{"id": "CAyAtanaya", "headword": "छायातनय", "headword_slp1": "CAyAtanaya", "fold": "Cayatanaya", "headword_language": "sa", "source": "vaidya", "senses": [{"