{"nad": [{"id": "nad", "headword": "नद्", "headword_slp1": "nad", "fold": "nad", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नद् (I) vi. (but often used with a cognate acc., e.g. ननाद, नादान्) 1P (pres. नदति, प्रणदति) 1. To sound, to resound, to thunder, नदत्याकाशगंगायाः स्रोतस्युद्दामदिग्गजे R.i.78, Sis.v.63, Bt.ii.4; 2. to shout, to cry, to speak.With उद्-, to roar, to cry, K.S.i.56.With नि-, to sound, R.v.75.With प्र-, to sound, to resound, Sis.ix.71.With वि-, to sound, to resound.", "gloss_language": "en"}, {"gloss": "नद् Caus. (नादयति-ते) 1. to fill with noise, to make resonant; 2. to cause to make sound.With वि-, to cause to utter notes, Ghat.10.", "gloss_language": "en"}, {"gloss": "नद् (II) vi. 1P (pres. नंदति) To be glad, to be satisfied with, to be glad of anything, ननंदरुस्तौ R.ii.22, iii.11, 22, iv.3.With अभि-, 1. to be glad, to be satisfied, नाभिनंदति न द्वेष्टि Bg.ii.57; 2. to desire, to wish for, to like, नाभिनंदेत मरणं नाभिनंदेत जीवितम् M.vi.45; 3. to greet, to congratulate upon, तमभ्यनंदत् प्रथमं प्रबोधितः R.iii.68, vii.69, 71; 4. to praise, to approve of, ताः पितृभिश्चाभिनंदिताः Sak.iii.With आ-, to be glad, आनंदितारस्त्वां दृष्ट्वा Bt.xxii.14.With प्रति-, 1. to bless, K.S.vii.87; 2. to congratulate upon, M.ii.54.", "gloss_language": "en"}, {"gloss": "नद् Caus. (नंदयति-ते) to gladden, to please, to make happy, सैव कुमुद्वती मे दृष्टिं न नंदयति संस्मरणीयशोभा Sak.iv., Bt.ii.16.With आ-, to gladden, to please, to make joyous, Yaj.i.356.", "gloss_language": "en"}]}], "nada": [{"id": "nada", "headword": "नद", "headword_slp1": "nada", "fold": "nada", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नद m. 1. A river, a great river; (Mall. commenting on Sis.iv.66 thus distinguishes between नद and नदी- प्राक्स्रोतसो नद्यः प्रत्यक्स्रोतसो नदा नर्मदां विनेत्याहुः) Sis.iv.66, M.vi.90; 2. the ocean.", "gloss_language": "en"}], "synonyms": ["नदः"], "synonyms_slp1": ["nadaH"]}, {"id": "nAda", "headword": "नाद", "headword_slp1": "nAda", "fold": "nada", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नाद m. 1. A loud sound, cry, roaring, R.xii.79; 2. a sound in general; 3. the nasal sound represented by a semicircle (???) (in Yoga Phil.).", "gloss_language": "en"}], "synonyms": ["नादः"], "synonyms_slp1": ["nAdaH"]}], "nadaraja": [{"id": "nadarAja", "headword": "नदराज", "headword_slp1": "nadarAja", "fold": "nadaraja", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नद-राज m. the ocean.", "gloss_language": "en"}], "synonyms": ["नदराजः"], "synonyms_slp1": ["nadarAjaH"]}], "nadaTu": [{"id": "nadaTu", "headword": "नदथु", "headword_slp1": "nadaTu", "fold": "nadaTu", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदथु m. Noise, roaring, especially the roaring of a bull.", "gloss_language": "en"}], "synonyms": ["नदथुः"], "synonyms_slp1": ["nadaTuH"]}], "nadi": [{"id": "nadI", "headword": "नदी", "headword_slp1": "nadI", "fold": "nadi", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी f. A river, any flowing water, नदीमिवांतः सलिलां सरस्वतीम् R.iii.9, M.vi.90.", "gloss_language": "en"}]}], "nadina": [{"id": "nadIna", "headword": "नदीन", "headword_slp1": "nadIna", "fold": "nadina", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-इन, -कांत m. the ocean.", "gloss_language": "en"}], "synonyms": ["नदीनः"], "synonyms_slp1": ["nadInaH"]}], "nadikanta": [{"id": "nadIkAMta", "headword": "नदीकांत", "headword_slp1": "nadIkAMta", "fold": "nadikanta", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-इन, -कांत m. the ocean.", "gloss_language": "en"}], "synonyms": ["नदीकान्त", "नदीकान्तः"], "synonyms_slp1": ["nadIkAnta", "nadIkAntaH"]}], "nadikulapriya": [{"id": "nadIkUlapriya", "headword": "नदीकूलप्रिय", "headword_slp1": "nadIkUlapriya", "fold": "nadikulapriya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-कूलप्रिय m. a species of cane.", "gloss_language": "en"}], "synonyms": ["नदीकूलप्रियः"], "synonyms_slp1": ["nadIkUlapriyaH"]}], "nadija": [{"id": "nadIja", "headword": "नदीज", "headword_slp1": "nadIja", "fold": "nadija", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-ज m. an epithet of Bhīṣma.", "gloss_language": "en"}], "synonyms": ["नदीजं", "नदीजः"], "synonyms_slp1": ["nadIjaM", "nadIjaH"]}], "naditarasTana": [{"id": "nadItarasTAna", "headword": "नदीतरस्थान", "headword_slp1": "nadItarasTAna", "fold": "naditarasTana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-तरस्थान n. a landing place.", "gloss_language": "en"}], "synonyms": ["नदीतरस्थानं"], "synonyms_slp1": ["nadItarasTAnaM"]}], "nadidoha": [{"id": "nadIdoha", "headword": "नदीदोह", "headword_slp1": "nadIdoha", "fold": "nadidoha", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-दोह m. freight, fare.", "gloss_language": "en"}], "synonyms": ["नदीदोहः"], "synonyms_slp1": ["nadIdohaH"]}], "nadiDara": [{"id": "nadIDara", "headword": "नदीधर", "headword_slp1": "nadIDara", "fold": "nadiDara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-धर m. an epithet of Śiva.", "gloss_language": "en"}], "synonyms": ["नदीधरः"], "synonyms_slp1": ["nadIDaraH"]}], "nadipati": [{"id": "nadIpati", "headword": "नदीपति", "headword_slp1": "nadIpati", "fold": "nadipati", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-पति m. 1. the ocean; 2. an epithet of Varuṇa.", "gloss_language": "en"}], "synonyms": ["नदीपतिः"], "synonyms_slp1": ["nadIpatiH"]}], "nadipura": [{"id": "nadIpUra", "headword": "नदीपूर", "headword_slp1": "nadIpUra", "fold": "nadipura", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "नदी-पूर m. a river which has overflown its banks.", "gloss_language": "en"}], "synonyms": ["नदीपूरः"], "synonyms_slp1": ["nadIpUraH"]}], "nadiBava": [{"id": "nadIBava", "headword": "नदीभव", "headword_slp1": "nadIBava", "fold": "nadiBava",