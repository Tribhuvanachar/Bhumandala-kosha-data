{"div": [{"id": "div", "headword": "दिव्", "headword_slp1": "div", "fold": "div", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दिव् (I) vt. or vi. (pp. द्यूत or द्यून; pres. दीव्यति; desid. दुधूषति, दिदेविषति) 1. To shine; 2. to throw, to cast (as a missile), Bt.xvii.87, v.81; 3. to gamble, to play (in this sense, दिव् governs the acc. or inst., e.g. अक्षैः or अक्षान् दीव्यति); 4. to trifle with, to make sport of; 5. to deal in transactions, to stake, to sell, (with a gen.), अदेवीद्बंधुभोगानाम् Bt.viii.122; (but when preceded by a preposition it is used with an acc. or gen., e.g. शतस्य or शतं प्रतिदीव्यति); 6. to praise; 7. to be glad, to rejoice; 8. to be mad or drunk; 8. to be sleepy; 10. to wish for.", "gloss_language": "en"}, {"gloss": "दिव् (II) vt. 1P, 10U (pres. देवति, देवयति-ते) To cause to lament, to pain, to vex.", "gloss_language": "en"}, {"gloss": "दिव् (III) vi. 10Ā (pres. देवयते) To suffer pain, to lament.With परि-, to lament, to suffer pain, Bt.iv.34.", "gloss_language": "en"}, {"gloss": "दिव् f. (nom. sing. द्यौः) 1. The heaven, R.iii.4, 12, Megh.ii.30; 2. the sky; 3. a day.", "gloss_language": "en"}]}], "divaspati": [{"id": "divaspati", "headword": "दिवस्पति", "headword_slp1": "divaspati", "fold": "divaspati", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दिवस्पति m. an epithet of Indra, अनतिक्रमणीया दिवस्पतेराज्ञा Sak.vi.", "gloss_language": "en"}], "synonyms": ["दिवस्पतिः"], "synonyms_slp1": ["divaspatiH"]}], "divaspfTivyO": [{"id": "divaspfTivyO", "headword": "दिवस्पृथिव्यौ", "headword_slp1": "divaspfTivyO", "fold": "divaspfTivyO", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दिवस्पृथिव्यौ f. du. the heaven and earth.", "gloss_language": "en"}]}], "divija": [{"id": "divija", "headword": "दिविज", "headword_slp1": "divija", "fold": "divija", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दिविज m. a god.", "gloss_language": "en"}], "synonyms": ["दिविजः"], "s