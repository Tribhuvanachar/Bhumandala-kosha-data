ms": ["कश्मीरजः"], "synonyms_slp1": ["kaSmIrajaH"]}, {"id": "kASmIraja", "headword": "काश्मीरज", "headword_slp1": "kASmIraja", "fold": "kasmiraja", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काश्मीर-ज, -जन्मन् n. saffron, Bh.V.i.71.", "gloss_language": "en"}], "synonyms": ["काश्मीरजं"], "synonyms_slp1": ["kASmIrajaM"]}], "kasmirajanman": [{"id": "kaSmIrajanman", "headword": "कश्मीरजन्मन्", "headword_slp1": "kaSmIrajanman", "fold": "kasmirajanman", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कश्मीर-ज, -जन्मन् m.n. saffron, e.g. कश्मीरजस्य कटुताऽपि नितांतरम्या.", "gloss_language": "en"}]}, {"id": "kASmIrajanman", "headword": "काश्मीरजन्मन्", "headword_slp1": "kASmIrajanman", "fold": "kasmirajanman", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काश्मीर-ज, -जन्मन् n. saffron, Bh.V.i.71.", "gloss_language": "en"}]}], "kasya": [{"id": "kaSya", "headword": "कश्य", "headword_slp1": "kaSya", "fold": "kasya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कश्य (I) a. (f. श्या) Fit to be whipped.", "gloss_language": "en"}, {"gloss": "कश्य (II) n. Spirituous liquor.", "gloss_language": "en"}], "synonyms": ["कश्यं"], "synonyms_slp1": ["kaSyaM"]}, {"id": "kaSyA", "headword": "कश्या", "headword_slp1": "kaSyA", "fold": "kasya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कश्य (I) a. (f. श्या) Fit to be whipped.", "gloss_language": "en"}]}, {"id": "kASya", "headword": "काश्य", "headword_slp1": "kASya", "fold": "kasya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काश्य n. Spirituous liquor.", "gloss_language": "en"}], "synonyms": ["काश्यं"], "synonyms_slp1": ["kASyaM"]}], "kasyapa": [{"id": "kaSyapa", "headword": "कश्यप", "headword_slp1": "kaSyapa", "fold": "kasyapa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कश्यप m. 1. A tortoise; 2. name of a Ṛshi, the husband of Aditi and Diti and the father of gods and demons.", "gloss_language": "en"}], "synonyms": ["कश्यपः"], "synonyms_slp1": ["kaSyapaH"]}, {"id": "kASyapa", "headword": "काश्यप", "headword_slp1": "kASyapa", "fold": "kasyapa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काश्य-प n. flesh.", "gloss_language": "en"}, {"gloss": "काश्यप m. 1. Name of a celebrated sage; 2. a name of Kaṇāda.", "gloss_language": "en"}], "synonyms": ["काश्यपं", "काश्यपः"], "synonyms_slp1": ["kASyapaM", "kASyapaH"]}], "kas": [{"id": "kaz", "headword": "कष्", "headword_slp1": "kaz", "fold": "kas", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कष् vt. 1P (pp. कषित) 1. To rub with a touch-stone, to test, छदहेम कषन्निवालसत्कषयाषाणनिभे नभस्तले Na.ii.69; 2. to rub, to scrape, Bt.iii.49; 3. to injure, to destroy.", "gloss_language": "en"}]}, {"id": "kas", "headword": "कस्", "headword_slp1": "kas", "fold": "kas", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कस् (I) vt. 1P (pp. कसित) 1. To go, to approach.With वि-, to open, to expand, विकसति हि पतंगस्योदये पुंडरीकम् M.M.i., Sis.ix.47, K.S.vii.55; (caus. pres. कासयति-ते).With निस्-, 1. to take out; 2. to drive out or away, to banish, to expel, निरकासयद्रविमपेतवसुं वियदालयादपरदिग्गणिका Sis.ix.10.With प्र-, to open, to cause to expand, घनमुक्तांबुलवप्रकाशितैः (कुसुमैः) Ghat.19.With वि-, to open, to cause to expand, इंदुर्विकासयति कैरविणीकुलानि Bhartr.ii.", "gloss_language": "en"}, {"gloss": "कस् (II) vt. 2Ā (pres. कस्ते or कंस्ते) 1. To go; 2. to destroy.", "gloss_language": "en"}]}, {"id": "kAS", "headword": "काश्", "headword_slp1": "kAS", "fold": "kas", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काश् (I) vi. 1Ā (pp. काशित) 1. To be visible, नैवं भूमिर्न च दिशः प्रदिशो वा चकाशिरे Bh.iii.; 2. to shine, to look brilliant or beautiful, R.x.86, vii.24, K.S.i.24, Bt.ii.25; (hence) 3. to appear or look like.With प्र-, 1. to be visible; 2. to shine, to look brilliant; (hence) 3. to appear or look like.With प्रति-, 1. to appear like; 2. to shine in opposition.With वि-, 1. to open up as a flower; 2. to shine.With सम्-, to appear like.", "gloss_language": "en"}, {"gloss": "काश् (Caus. काशयति-ते) With निस्-, 1. to open; 2. to take out, to present to the sight; 3. to turn out, to banish, e.g. गृहान्निष्काशयेत्.With प्र-, 1. to show, to discover, to disclose, to reveal, अवसरोऽयमानात्मानं प्रकाशयितुम् Sak.i.; 2. to lighten, to illumine, यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः Bg.xiii.33; 3. to bring to light, to make public, to communicate, to proclaim, कदाचित्कुपितं मित्रं सर्वदोषं प्रकाशयेत् Cāṇakya.", "gloss_language": "en"}, {"gloss": "काश् (II) vi. 4Ā (pp. काशित) 1. To shine, to appear like; 2. to be visible.", "gloss_language": "en"}]}, {"id": "kAs", "headword": "कास्", "headword_slp1": "kAs", "fold": "kas", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कास् vi. 1Ā (pp. कासित) To cough, to make a sound indicating any disease.", "gloss_language": "en"}]}], "kasaRa": [{"id": "kazaRa", "headword": "कषण", "headword_slp1": "kazaRa", "fold": "kasaRa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषण n. 1. Rubbing, marking, कषणकंपनिरस्तमहाहिभिः Kir.v.47; 2. test of gold by the touchstone.", "gloss_language": "en"}], "synonyms": ["कषणः"], "synonyms_slp1": ["kazaRaH"]}], "kasaya": [{"id": "kazAya", "headword": "कषाय", "headword_slp1": "kazAya", "fold": "kasaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषाय (I) a. (f. या) 1. Astringent; 2. fragrant, स्फुटितकमलामोदमैत्रीकषायः Megh.i.31; 3. red, dark-red, चूतांकुरास्वादकषायकंठः K.S.iii.32; 4. brown; 5. improper, dirty.", "gloss_language": "en"}, {"gloss": "कषाय (II) m.n. 1. Astringent flavour; 2. the red colour; 3. a decoction which has one part of a drug with 8 or 16 parts of water, the whole being boiled down until one quarter is left, M.xi.153; 4. gum, resin, extract; 5. plastering, anointing; 6. perfuming the person, Rt.i.4; 7. dirt, uncleanliness; 8. attachment to worldly objects.", "gloss_language": "en"}, {"gloss": "कषाय (III) m. 1. Passion, emotion; 2. the Kaliyuga.", "gloss_language": "en"}], "synonyms": ["कषायः"], "synonyms_slp1": ["kazAyaH"]}, {"id": "kazAyA", "headword": "कषाया", "headword_slp1": "kazAyA", "fold": "kasaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषाय (I) a. (f. या) 1. Astringent; 2. fragrant, स्फुटितकमलामोदमैत्रीकषायः Megh.i.31; 3. red, dark-red, चूतांकुरास्वादकषायकंठः K.S.iii.32; 4. brown; 5. improper, dirty.", "gloss_language": "en"}]}, {"id": "kAzAya", "headword": "काषाय", "headword_slp1": "kAzAya", "fold": "kasaya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काषाय a. (f. यी) Red, dyed of a reddish colour, काषायवसनो याति कुंकुमालेपनो यतिः R.G.", "gloss_language": "en"}]}], "kasayita": [{"id": "kazAyita", "headword": "कषायित", "headword_slp1": "kazAyita", "fold": "kasayita", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषायित a. (f. ता) Tinged, coloured, अमुनैव कषायितस्तनी K.S.iv.34.", "gloss_language": "en"}]}, {"id": "kazAyitA", "headword": "कषायिता", "headword_slp1": "kazAyitA", "fold": "kasayita", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषायित a. (f. ता) Tinged, coloured, अमुनैव कषायितस्तनी K.S.iv.34.", "gloss_language": "en"}]}], "kasi": [{"id": "kazi", "headword": "कषि", "headword_slp1": "kazi", "fold": "kasi", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषि a. Injurious, mischievous.", "gloss_language": "en"}], "synonyms": ["कषिः"], "synonyms_slp1": ["kaziH"]}, {"id": "kASi", "headword": "काशि", "headword_slp1": "kASi", "fold": "kasi", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काशि (I) m. pl. The name of a country.", "gloss_language": "en"}, {"gloss": "काशि (II) f. Name of a celebrated city on the Ganges, the modern Benares. It is one of the seven sacred cities. See कांची.", "gloss_language": "en"}], "synonyms": ["काशिः"], "synonyms_slp1": ["kASiH"]}, {"id": "kASI", "headword": "काशी", "headword_slp1": "kASI", "fold": "kasi", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "काशी f. See काशि II.", "gloss_language": "en"}]}], "kaseruka": [{"id": "kazerukA", "headword": "कषेरुका", "headword_slp1": "kazerukA", "fold": "kaseruka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषे(से)रुका f. The backbone, the spine.", "gloss_language": "en"}]}, {"id": "kaserukA", "headword": "कसेरुका", "headword_slp1": "kaserukA", "fold": "kaseruka", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कषे(से)रुका f. The backbone, the spine.", "gloss_language": "en"}]}], "kaswa": [{"id": "kazwa", "headword": "कष्ट", "headword_slp1": "kazwa", "fold": "kaswa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कष्ट (I) a. (f. ष्टा) 1. Bad, evil, wrong, कष्टात्कष्टतरं गता R.xv.43, ‘gone from bad to worse’; 2. painful, grievous, मोहादभूत्कष्टतरः प्रबोधः R.xiv.56, or कष्टा वृत्तिः पराधीना कष्टो वासो निराश्रयः Cāṇakya.; 3. difficult, स्त्रीषु कष्टोऽधिकारः Vikr.iii., Yaj.iii.29; 4. difficult to subdue (as an enemy), M.vii.186, 210; 5. mischievous, injurious.", "gloss_language": "en"}, {"gloss": "कष्ट (II) n. 1. Evil, difficulty, misery, suffering, uneasiness, अर्थार्थी याति कष्टानि Panch.ii.; 2. sin.(कष्टम् is used as an indeclinable in the sense of ‘alas,’ कष्टं युद्धे दश शेषाः श्रुता मे त्रयोऽस्माकं पांडवानां च सप्त Bh.", "gloss_language": "en"}], "synonyms": ["कष्टं", "कष्टः"], "synonyms_slp1": ["kazwaM", "kazwaH"]}, {"id": "kazwA", "headword": "कष्टा", "headword_slp1": "kazwA", "fold": "kaswa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कष्ट (I) a. (f. ष्टा) 1. Bad, evil, wrong, कष्टात्कष्टतरं गता R.xv.43, ‘gone from bad to worse’; 2. painful, grievous, मोहादभूत्कष्टतरः प्रबोधः R.xiv.56, or कष्टा वृत्तिः पराधीना कष्टो वासो निराश्रयः Cāṇakya.; 3. difficult, स्त्रीषु कष्टोऽधिकारः Vikr.iii., Yaj.iii.29; 4. difficult to