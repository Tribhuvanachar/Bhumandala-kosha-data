{"gaR": [{"id": "gaR", "headword": "गण्", "headword_slp1": "gaR", "fold": "gaR", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण् vt. 10U (pp. गणित) 1. To count, to number, to enumerate, लीलाकमलपत्राणि गणयामास पार्वती K.S.vi.84, गणयति Git.G.ii.; 2. to class with or among; 3. to sum up, to add up; 4. to calculate, to compute; 5. to take into account, to give consideration to; 6. to estimate, to value at; 7. to consider, to regard as, to think to be, to take to be, किसलयतल्पं गणयति विहितहुताशविकल्पम् Git.G.iv., जातस्तु गण्यते सोऽत्र यः स्फुरेच्च श्रियाधिकः Panch.i., R.viii.69, xi.75, v.20; 8. to ascribe to, to attribute to, (with a loc.), जाड्यं ह्रीमति गण्यते Bhartr.ii.54; 9. to attend to, to take notice of, प्रणयमगणयित्वा यन्ममापद्गतस्य Vikr.iv.; 10. to care for, (generally with a negative particle) न हि गणयति ख्शुद्रो जंतुः परिग्रहफल्गुताम् Bhartr.ii.9, Sant.S.i.10, Bt.ii.53, xv.5, 45.With अधि-, 1. to praise; 2. to enumerate.With अव-, to disregard.With परि-, 1. to count over; 2. to consider, to think, अपरिगणयन् Megh.i.5.With प्र-, to calculate.With वि-, 1. to number, Yaj.iii.104; 2. to consider, Megh.ii.46, R.i.87; 3. to disregard, किमपि विगणयंतो बुद्धिमंतः सहंते Panch.iii.", "gloss_language": "en"}]}], "gaRa": [{"id": "gaRa", "headword": "गण", "headword_slp1": "gaRa", "fold": "gaRa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण m. 1. A flock, a multitude, a troop, a collection, सूत्रे मणिगणा इव Bg.vii.7; 2. a series, a class; 3. a body of followers or attendants; 4. a troop of demigods considered as Śiva’s attendants under the special superintendence of Gaṇeśa, a demigod of this troop, शिवमगात्मजया च कृतेर्ष्यया सकलहं सगणं शुचिमानसम् Kir.v.13, K.S.iii.40, 71, Megh.i.33, 55; 5. any assemblage or society of men formed for the attainment of the same ends; 6. a sect (in philosophy or religion); 7. a detachment of an army consisting of 27 chariots, as many elephants, 81 horses and 135 foot (a small division of अक्षौहिणी); 8. a number (in math.); 9. a foot (in prosody); 10. a series of roots or words belonging to the same rule and called after the first word of the series (in gram.), e.g. अदादिगण, i.e. the class of roots which begin with अद्; 11. an epithet of Gaṇeśa.", "gloss_language": "en"}], "synonyms": ["गणः"], "synonyms_slp1": ["gaRaH"]}], "gaRagraRi": [{"id": "gaRAgraRI", "headword": "गणाग्रणी", "headword_slp1": "gaRAgraRI", "fold": "gaRagraRi", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण-अग्रणी m. a name of Gaṇeśa.", "gloss_language": "en"}]}], "gaRacala": [{"id": "gaRAcala", "headword": "गणाचल", "headword_slp1": "gaRAcala", "fold": "gaRacala", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण-अचल m. a name of the mountain Kailāsa as the residence of the Gaṇas of Śiva.", "gloss_language": "en"}], "synonyms": ["गणाचलः"], "synonyms_slp1": ["gaRAcalaH"]}], "gaRaDipa": [{"id": "gaRADipa", "headword": "गणाधिप", "headword_slp1": "gaRADipa", "fold": "gaRaDipa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण-अधिप, -अधिपति m. 1. a name of Śiva, Sis.ix.27; 2. of Gaṇeśa; 3. the chief of a troop of soldiers or of a class of disciples.", "gloss_language": "en"}], "synonyms": ["गणाधिपः"], "synonyms_slp1": ["gaRADipaH"]}], "gaRaDipati": [{"id": "gaRADipati", "headword": "गणाधिपति", "headword_slp1": "gaRADipati", "fold": "gaRaDipati", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण-अधिप, -अधिपति m. 1. a name of Śiva, Sis.ix.27; 2. of Gaṇeśa; 3. the chief of a troop of soldiers or of a class of disciples.", "gloss_language": "en"}], "synonyms": ["गणाधिपतिः"], "synonyms_slp1": ["gaRADipatiH"]}], "gaRana": [{"id": "gaRAnna", "headword": "गणान्न", "headword_slp1": "gaRAnna", "fold": "gaRana", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "गण-अन्न n. a mess prepared for a number of persons in common, M.iv.209.", "gloss_language": "en"}]}, {"id": "gaRana", "headword": "गणन", 