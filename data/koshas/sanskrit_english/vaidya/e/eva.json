{"eva": [{"id": "eva", "headword": "एव", "headword_slp1": "eva", "fold": "eva", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "एव ind. 1. Just, exactly, e.g. एवमेव ‘exactly so’; 2. same, identical, e.g. स एवागतः; 3. only (implying exclusion), e.g. पार्थ एव धनुर्धरः (‘not others’ is the implication); 4. like, as (implying similarity), e.g. श्रीस्त एव मेऽस्तु; 5. it sometimes implies emphasis, e.g. अहमेव गच्छामि. It also implies ‘command,’ ‘restraint,’ ‘diminution’ according to some authorities.", "gloss_language": "en"}], "synonyms": ["एवं", "एवः"], "synonyms_slp1": ["evaM", "evaH"]}], "evam": [{"id": "evam", "headword": "एवम्", "headword_slp1": "evam", "fold": "evam", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "एवम् ind. So, in this way, thus, एवंवादिनि देवर्षौ पार्श्वे पितुरधोमुखी K.S.vi.84. Sometimes it implies assent (yes), एवमेतत् Ut.i. and rarely determination.", "gloss_language": "en"}]}], "evamavasTa": [{"id": "evamavasTa", "headword": "एवमवस्थ", "headword_slp1": "evamavasTa", "fold": "evamavasTa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "एवम्-अवस्थ a. so situated.", "gloss_language": "en"}]}], "evankaram": [{"id": "evaMkAram", "headword": "एवंकारम्", "headword_slp1": "evaMkAram", "fold": "evankaram", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "एवम्-कारम् ind. in this manner.", "gloss_language": "en"}]}], "evanguRa": [{"id": "evaMguRa", "headword": "एवंगुण", "headword_slp1": "evaMguRa", "fold": "evanguRa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "एवम्-गुण a. possessing such qualities.", "gloss_language": "en"}]}], "evanpraya": [{"id": "evaMprAya", "headword": "एवंप्राय", "headword_slp1": "evaMprAya", "fold": "evanpraya", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "एवम्-प्राय a. of such a kind.", "gloss_language": "en"}]}], "evanButa": [{"id": "evaMBUta", "headword": "एवंभूत", "headword_slp1": "evaMBUta", "fol