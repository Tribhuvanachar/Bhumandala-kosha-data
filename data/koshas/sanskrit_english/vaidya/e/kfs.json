eadword_slp1": "kfzijIvin", "fold": "kfsijivin", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृषि-जीविन् a. living by husbandry.", "gloss_language": "en"}]}], "kfsiPala": [{"id": "kfziPala", "headword": "कृषिफल", "headword_slp1": "kfziPala", "fold": "kfsiPala", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृषि-फल n. agricultural produce or profit, Megh.i.16.", "gloss_language": "en"}]}], "kfsiseva": [{"id": "kfzisevA", "headword": "कृषिसेवा", "headword_slp1": "kfzisevA", "fold": "kfsiseva", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृषि-सेवा f. agriculture.", "gloss_language": "en"}]}], "kfsivala": [{"id": "kfzIvala", "headword": "कृषीवल", "headword_slp1": "kfzIvala", "fold": "kfsivala", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृषीवल m. One who lives by husbandry, a farmer, कृषिं चापि कृषीवलः Yaj.i.276.", "gloss_language": "en"}], "synonyms": ["कृषीवलः"], "synonyms_slp1": ["kfzIvalaH"]}], "kfskara": [{"id": "kfzkara", "headword": "कृष्कर", "headword_slp1": "kfzkara", "fold": "kfskara", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृष्कर m. An epithet of Śiva.", "gloss_language": "en"}], "synonyms": ["कृष्करः"], "synonyms_slp1": ["kfzkaraH"]}], "kfswa": [{"id": "kfzwa", "headword": "कृष्ट", "headword_slp1": "kfzwa", "fold": "kfswa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृष्ट a. (f. ष्टा) 1. Drawn, attracted; 2. ploughed, (pp. of कृष् q.v.)", "gloss_language": "en"}], "synonyms": ["कृष्टं"], "synonyms_slp1": ["kfzwaM"]}, {"id": "kfzwA", "headword": "कृष्टा", "headword_slp1": "kfzwA", "fold": "kfswa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "कृष्ट a. (f. ष्टा) 1. Drawn, attracted; 2. ploughed, (pp. of कृष् q.v.)", "gloss_language": "en"}]}], "kfswi": [{"id": "kfzwi", "headword": "कृष्टि", "headword_slp1": "kfzwi", "fold": "kfswi", "headword_language": "sa", "source": "vaidya", "sense