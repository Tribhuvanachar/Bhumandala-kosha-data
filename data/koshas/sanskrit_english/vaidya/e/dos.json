{"dosa": [{"id": "doza", "headword": "दोष", "headword_slp1": "doza", "fold": "dosa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दोष m. 1. Fault, deficiency, राजेम्द्रनेपथ्यविधानशोभा तस्योदितासीत् पुनरुक्तदोषा R.xiv.9, M.i.107, viii.205; 2. noxious quality, badness; 3. sin, guilt, offence, R.xiv.34, M.viii.351; 4. evil, danger, बहुदोषा हि शर्वरी Mrich.i.; 5. bad consequence, detrimental effect, अकिमयमातपदोषः स्यात् Sak.iii.; 6. error, mistake; 7. a fault of composition (in rhetoric); they are classed under the five heads of पददोष, पदांशदोष, वाक्यदोष, अर्थदोष and रसदोष; the 7th Ullāsa of K.Pr. is devoted to their treatment; 8. fault of a definition (in science), (they are अव्याप्ति, अतिव्याप्ति and असंभव); 9. disorder of the three humours of the body, or the three humours (so translated ?) themselves (in medicine); 10. a calf; 11. refutation.", "gloss_language": "en"}], "synonyms": ["दोषः"], "synonyms_slp1": ["dozaH"]}, {"id": "dozA", "headword": "दोषा", "headword_slp1": "dozA", "fold": "dosa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दोषा (I) ind. At night, दोषाऽपि नूनमहिमांशुरसौ किलेति Sis.iv.46.", "gloss_language": "en"}, {"gloss": "दोषा (II) f. 1. The arm; 2. the night, as in घर्मकालदिवस इव क्षयितदोष Kad. (where the word can not be treated as an indeclinable).", "gloss_language": "en"}]}], "dosaropa": [{"id": "dozAropa", "headword": "दोषारोप", "headword_slp1": "dozAropa", "fold": "dosaropa", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दोष-आरोप m. accusation.", "gloss_language": "en"}], "synonyms": ["दोषारोपः"], "synonyms_slp1": ["dozAropaH"]}], "dosEkadfs": [{"id": "dozEkadfS", "headword": "दोषैकदृश्", "headword_slp1": "dozEkadfS", "fold": "dosEkadfs", "headword_language": "sa", "source": "vaidya", "senses": [{"gloss": "दोष-एकदृश् a. fault-finding, censorious, malevolent.", "gloss_language": "en"}]}], "dosakara": [{"id": "dozakara", "headword": "दोषकर", "headword_slp1": "dozakara", "fol