{"dama": [{"id": "dama", "headword": "दम", "headword_slp1": "dama", "fold": "dama", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dama^1, son of Bhīma, the Vidarbha king. § 344 (Nalopākhyānap.): III, 53, 2080.", "gloss_language": "en"}, {"gloss": "Dama^2, a ṛshi. § 734 (Ānuśāsanik.): XIII, 26, 1762.", "gloss_language": "en"}, {"gloss": "Dama^3 = Vishṇu (1000 names).", "gloss_language": "en"}]}], "damacandra": [{"id": "dAmacandra", "headword": "दामचन्द्र", "headword_slp1": "dAmacandra", "fold": "damacandra", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dāmacandra, a Pāṇḍava warrior. § 600 (Ghaṭotkacavadhap.): VII, 158, 7009.", "gloss_language": "en"}]}], "damaGosasuta": [{"id": "damaGozasuta", "headword": "दमघोषसुत", "headword_slp1": "damaGozasuta", "fold": "damaGosasuta", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Damaghoshasuta = Śiśupāla, q.v.", "gloss_language": "en"}]}], "damaGosatmaja": [{"id": "damaGozAtmaja", "headword": "दमघोषात्मज", "headword_slp1": "damaGozAtmaja", "fold": "damaGosatmaja", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Damaghoshātmaja = Śiśupāla, q.v.", "gloss_language": "en"}]}], "damagranTi": [{"id": "dAmagranTi", "headword": "दामग्रन्थि", "headword_slp1": "dAmagranTi", "fold": "damagranTi", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dāmagranthi, the name which Nakula assumed in the palace of Virāṭa. § 551 (Kīcakavadhap.): IV, 19, 599.-§ 552 (Goharaṇap.): IV, 31, 1020. Cf. Granthika.", "gloss_language": "en"}]}], "damana": [{"id": "damana", "headword": "दमन", "headword_slp1": "damana", "fold": "damana", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Damana^1, an ancient king. § 5 (Anukram.): I, 1, 224 (in Nārada's enumeration).", "gloss_language": "en"}, {"gloss": "Damana^2, a Brahmarshi. § 344 (Nalopākhyānap.): III, 53, 2077 (Brahmarshiḥ), 2079 (granted the Vidarbha king Bhīma that he should have three sons and a daughter).", "gloss_language": "en"}, {"gloss": "Damana^3, son of the Vidarbha king Bhīma. § 344 (Nalopākhyānap.): III, 53, 2080 (second son of Bhīma).", "gloss_language": "en"}, {"gloss": "Damana^4, a Kuru warrior. § 581 (Bhīshmavadhap.): VI, 61^4, 2699 (dāyādaṃ Pauravasya, slain by Dhrshṭadyumna).", "gloss_language": "en"}, {"gloss": "Damana^5 = Śiva (1000 names^2).", "gloss_language": "en"}, {"gloss": "Damana^6 = Vishṇu (1000 names).", "gloss_language": "en"}]}], "damayanti": [{"id": "damayantI", "headword": "दमयन्ती", "headword_slp1": "damayantI", "fold": "damayanti", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Damayantī^1, daughter of the Vidarbha king Bhīma, wife of Nala and mother of Indrasena and Indrasenā. § 11 (Parvasaṅgr.): I, 2, 436.--§ 240 (Vaivāhikap.): I, 199, 7351 (ºī yathā Nale).--§ 344 (Nalop.): III, 53, 2080 (her birth according to a boon granted by Damana), 2081, 2087, 2092, 2094, 2097, 2098, 2102.--§ 345 (do.): III, 54, 2104, 2105, 2108, 2109, 2111, 2113, 2124 (Vidarbharājño duhitā), 2130; 55, 2137, 2139, 2145, 2153; 56, 2172, 2177, 2183, 2184; 57, 2192, 2198, 2212, 2220, 2223, 2230, 2231, 2236, 2237 (married to Nala, and mother of Indrasena and Indrasenā).--§ 346 (do.): III, 58, 2241, 2245; 59, 2265; 60, 2272, 2279, 2282, 2292.--§ 347 (do.): III, 61, 2299, 2303, 2307, 2313, 2320, 2321, 2326, (2328); 62, 2335, 2338, 2339, 2340, 2345, 2347, 2352; 63, 2362, 2392, 2396, 2398; 64, (2413), 2425, 2433 (Vidarbharājatanayāṃ), 2443, 2460, 2467, 2484, 2491, 2497 (Vīrasenanṛpasnushā), 2499 (Bhīmasutā), 2504, 2510, 2521; 65, 2550, 2560, 2574, 2583, 2598, 2606, 2607.--§ 348 (do.): III, 66, 2608.-§ 349 (do.): III, 67, 2652.--§ 350 (do.). III, 68, 2655, 2657, 2684, 2693; 69, 2694, 2696, 2697, 2704, 2709, 2710, 2719, (2722), 2725, 2728, 2743.--§ 351 (do.): III, 70, 2745, 2757, 2765, 2767; 71, 2772, 2774.--§ 353 (do.): III, 73, 2855, (2859), 2885, 2889; 74, 2894, 2895, 2897, 2920; 75, 2921, 2926, 2927, 2929, 2939, 2943; 76, 2951, 2952, 2957, 2958, 2959, 2965, 2975, (2976), 2992, 2996, 3002, 3003, 3007; 77, 3010, 3012, 3017.--§ 354 (do.): III, 78, 3034, 3041, 3044; 79, 3063, 3064.--§ 355 (do.): III, 79, 3072.--§ 391 (Ṛshyaśṛṅga): III, 113, 10092 (yathā …Nalasya vai Dºī).--§ 555 (Sainyodyogap.): V, 8, 223 (yathā).--§ 565 (Gālavacarita): V, 117, 3974 (reme …yathā…Dºyāṃ Nalaḥ). Cf. Bhaimī, Bhīmanandinī, Bhīmaputrikā, Bhīmasutā (III, 2273, 2278, 2380, 2499, 2509, 2998), Vaidarbhī, Vidarbhādhipatinandinī, Vidarbharājatanayā, Vidarbhatanayā.", "gloss_language": "en"}, {"gloss": "Damayantī^2: XII, 8604 (error in C. instead of Madayantī, q.v.).", "gloss_language": "en"}]}], "damayitf": [{"id": "damayitf", "headword": "दमयितृ", "headword_slp1": "damayitf", "fold": "damayitf", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Damayitṛ = Vishṇu (1000 names).", "gloss_language": "en"}]}], "dambara": [{"id": "dambara", "headword": "दम्बर", "headword_slp1": "dambara", "fold": "dambara", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dambara, a companion of Skanda. § 615u (Skanda): IX, 45, 2541 (given to Skanda by Dhātṛ).", "gloss_language": "en"}]}], "damBa": [{"id": "damBa", "headword": "दम्भ", "headword_slp1": "damBa", "fold": "damBa", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dambha = Śiva (1000 names^2).", "gloss_language": "en"}]}], "damBodBava": [{"id": "damBodBava", "headword": "दम्भोद्भव", "headword_slp1": "damBodBava", "fold": "damBodBava", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dambhodbhava, an ancient king. § 6 (Anukram.): I, 1, 227 (in Sañjaya's enumeration).--§ 11 (Parvasaṅgr.): I, 2, 508 (ºsya cākhyānāṃ, i.e. Dambhodbhavopākhyāna).--§ 61 (Sarpasattra): I, 51, 2112 (ºenāsi samo balena, sc. Janamejaya). --§ 277 (Jarāsandhavadhap.): II, 22, 877 (śreyaso hy avamanyeha vineśuḥ, cf. § 563).--§ 563 (Dambhodbhavop.): V, 96, 3452, 3473, (3476), 3477.", "gloss_language": "en"}]}], "damBodBavopaKyana": [{"id": "damBodBavopAKyAna", "headword": "दम्भोद्भवोपाख्यान", "headword_slp1": "damBodBavopAKyAna", "fold": "damBodBavopaKyana", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dambhodbhavopākhyāna(ṃ) (“the episode relating to Dambhodbhava”). (Cf. Dambhodbhavasya ākhyānaṃ.) § 563 (Bhagavady.): There was a king of yore named Dambhodbhava, who was at the head of the earth; his sovereignty extended over the whole world. Every morning he used to ask if there were anyone superior or even equal to himself. Certain brahmans counselled him to curb his pride; and as he continued to ask the brahmans the same question day after day, some high-souled brahmans mentioned to him the ascetics Nara and Nārāyaṇa, “who have taken their birth in the race of men, and are now practising penances on Gandhamādana.” The king marched to the spot with a large army, and found them emaciated with hunger and thirst, etc. He desired a battle with them. The Ṛshis declined; but as he repeatedly summoned them to fight, Nara took up a handful of grass-blades, and therewith baffled all their arrows and cut off the eyes and ears and noses of the warriors. The king fell at the feet of the Ṛshis and said, “Let me be blessed.” Nara then told him to be obedient to the brahmans and be virtuous. The king returned to his city, and from that time began to practise righteousness.", "gloss_language": "en"}]}], "damin": [{"id": "damin", "headword": "दमिन्", "headword_slp1": "damin", "fold": "damin", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Damin, a tīrtha. § 358 (Tīrthayātrāp.): III, 82, 5014.", "gloss_language": "en"}]}], "damodara": [{"id": "dAmodara", "headword": "दामोदर", "headword_slp1": "dAmodara", "fold": "damodara", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dāmodara = Kṛshṇa, q.v.--Do.^2 = Vishṇu (1000 names).", "gloss_language": "en"}]}], "damosRisa": [{"id": "dAmozRISa", "headword": "दामोष्णीश", "headword_slp1": "dAmozRISa", "fold": "damosRisa", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Dāmoshṇīśa (B. ºīsha), a muni. § 264 (Sabhākriyāp.): II, 4, 108 (among the munis who were present when Yudhishṭhira entered his palace).", "gloss_language": "en"}]}]}