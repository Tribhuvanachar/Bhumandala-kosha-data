index-names-mahabharata", "senses": [{"gloss": "Ānartta^1, pl. (ºāḥ), a people. § 279 (Arjuna): II, 26, 997 (conquered by Arjuna).--§ 318 (Arjunābhigam.): III, 13, 610 (Kṛshṇa said that if he had not been absent from the A. country he should have prevented the gambling).--§ 319 (Saubhavadhop.): III, 14, 622, 631.--§ 320 (Saubhavadhop.): III, 15, 649 (chase all dancers); 20, 777 (ºnagaram = Dvārakā).--§ 553 (Vaivāhikap.): IV, 72, 2350 (many Dāśārhas from the A. country came with Kṛshṇa to Upaplavya).--§ 562 (Bhagavadyānap.): V, 83, 2964 (entertained Kuntī).--§ 574 (Jambūkh.): VI, 9, 359 (ºNairṛtāḥ).--§ 604 (Karṇap.): VIII, 5, 96; 7, †197 (Āºvāsī Hṛdikātmajo 'sau…Sāttvatānāṃ varishṭhaḥ).--§ 783 (Anugītāp.): XIV, 52, 1525, 1535 (ºpurīm = Dvārakā).", "gloss_language": "en"}, {"gloss": "Ānartta^2, sg., chief (or country) of the Ānarttas. § 452 (Mārkaṇḍeya-samāsyā-p.): III, 183, †12582 (Ānarttaṃ evābhimukhāḥ śivena gatvā dhanurveda-ratipradhānāḥ|tavātmajā Vṛshṇi-puraṃ praviśya tadaiva tebhyaḥ spṛhayanti, Kṛshṇe, says Kṛshṇa to Draupadī).--§ 611 (Śalyap.): IX, 17, 947 (= Sātyaki).", "gloss_language": "en"}], "synonyms": ["आनर्त्त"], "synonyms_slp1": ["Anartta"]}], "anavadya": [{"id": "anavadyA", "headword": "अनवद्या", "headword_slp1": "anavadyA", "fold": "anavadya", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Anavadyā, an Apsaras. § 102 (Aṃśāvat.): I, 65, 2553 (daughter of Prādhā).--§ 191 (Arjuna): I, 123, 4817 (among the Apsarases who danced and sang at the birth of Arjuna).", "gloss_language": "en"}]}], "anayus": [{"id": "anAyuz", "headword": "अनायुष्", "headword_slp1": "anAyuz", "fold": "anayus", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Anāyush (B. Daº), erratum for Danāyus.", "gloss_language": "en"}]}], "ana": [{"id": "anna", "headword": "अन्न", "headword_slp1": "anna", "fold": "ana", "headword_language": "sa", "source": "index-names-mahabharata", "senses": [{"gloss": "Anna = Śiva (1