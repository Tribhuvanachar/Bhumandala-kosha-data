{"meraka": [{"id": "meraka", "headword": "मेरक", "headword_slp1": "meraka", "fold": "meraka", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "meraka, m. (Divy) or nt. (Mvy), (= Pali moragu, and prob. both from Skt. mayūrakaḥ), a kind of grass used for coverlets, or a coverlet made of it: Divy 〔19.22〕; Mvy 〔9181〕; see s.v. eraka.", "gloss_language": "en"}], "synonyms": ["मेरकः"], "synonyms_slp1": ["merakaH"]}], "meraRqu": [{"id": "meraRqu", "headword": "मेरण्डु", "headword_slp1": "meraRqu", "fold": "meraRqu", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "meraṇḍu = melanduka, q.v.", "gloss_language": "en"}]}], "meru": [{"id": "meru", "headword": "मेरु", "headword_slp1": "meru", "fold": "meru", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Meru,\n(1) n. of a former Buddha: Mv 〔iii.239.9〕;\n(2) n. of a future Buddha: Mv 〔ii.355.10〕 (here text Maru, prob. misprint) = 〔iii.279.15〕 (vs);\n(3) n. of a cakravartin (= Pali Neru; note that Pali has Sineru for the mountain name Sumeru): Mvy 〔3574〕.", "gloss_language": "en"}], "synonyms": ["मेरुः"], "synonyms_slp1": ["meruH"]}], "merukalpa": [{"id": "merukalpa", "headword": "मेरुकल्प", "headword_slp1": "merukalpa", "fold": "merukalpa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Merukalpa, n. of a Buddha in a northwestern lokadhātu: SP 〔184.15〕; Chin. points to Sumerudhvaja.", "gloss_language": "en"}]}], "merukuwa": [{"id": "merukUwa", "headword": "मेरुकूट", "headword_slp1": "merukUwa", "fold": "merukuwa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Merukūṭa,\n(1) n. of two former Buddhas, in the same list: Sukh 〔5.12〕; 〔6.6〕;\n(2) n. of a Buddha in an eastern lokadhātu: SP 〔184.7〕 (Chin. indicates Sumerukūṭa);\n(3) n. of a Bodhisattva: ŚsP 〔7.8〕.", "gloss_language": "en"}]}], "meruwu": [{"id": "meruwu", "headword": "मेरुटु",