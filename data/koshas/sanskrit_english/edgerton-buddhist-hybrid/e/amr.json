{"amrapali": [{"id": "amrapAlI", "headword": "अम्रपाली", "headword_slp1": "amrapAlI", "fold": "amrapali", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Amrapālī, see Āmra˚.", "gloss_language": "en"}]}, {"id": "AmrapAlI", "headword": "आम्रपाली", "headword_slp1": "AmrapAlI", "fold": "amrapali", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Āmrapālī (also ˚likā; = Pali Ambapālī, ˚likā; in Pali and in MSV she was a courtesan), n. of a Licchavi woman, who donated her mango grove to the Buddha: Mv 〔i.300.16〕; in Mv 〔ii.293.16〕 Buddha is dwelling at Vaiśālī in this grove, Āmrapālī-vane; her miraculous origin, MSV 〔ii.16.15 ff.〕; in mss. of MPS, e.g. 〔11.1〕, regularly written Amra˚ (semi-MIndic).", "gloss_language": "en"}]}], "amratirTa": [{"id": "AmratIrTa", "headword": "आम्रतीर्थ", "headword_slp1": "AmratIrTa", "fold": "amratirTa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Āmratīrtha, = next: ˚tho nāgarājā Mvy 〔3272〕.", "gloss_language": "en"}]}], "amratirTika": [{"id": "AmratIrTika", "headword": "आम्रतीर्थिक", "headword_slp1": "AmratIrTika", "fold": "amratirTika", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Āmratīrthika (= Pali Ambatitthaka), n. of a nāga: Māy 〔247.17〕.", "gloss_language": "en"}]}], "amrapalika": [{"id": "AmrapAlikA", "headword": "आम्रपालिका", "headword_slp1": "AmrapAlikA", "fold": "amrapalika", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Āmrapālikā = next: Mv 〔i.261.15〕.", "gloss_language": "en"}]}], "amreqayati": [{"id": "Amreqayati", "headword": "आम्रेडयति", "headword_slp1": "Amreqayati", "fold": "amreqayati", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "āmreḍayati, perh. gears up, makes work (a machine): MSV 〔iv.247.18, 20〕 (Tib. sbyar, put together, prepare).", "gloss_language": "en"}]}]}