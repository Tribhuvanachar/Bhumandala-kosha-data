{"nilapaka": [{"id": "nilapaka", "headword": "निलपक", "headword_slp1": "nilapaka", "fold": "nilapaka", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "[nilapaka, see nirla˚.]", "gloss_language": "en"}]}], "nilamba": [{"id": "nilamba", "headword": "निलम्ब", "headword_slp1": "nilamba", "fold": "nilamba", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "nilamba, nt., a high number: Gv 〔133.11〕; in Mvy, cited from Gv, replaced by nivala, q.v.", "gloss_language": "en"}]}], "nilamBa": [{"id": "nilamBa", "headword": "निलम्भ", "headword_slp1": "nilamBa", "fold": "nilamBa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "-nilambha, only in a-ni˚, q.v.", "gloss_language": "en"}]}], "nilihati": [{"id": "nilihati", "headword": "निलिहति", "headword_slp1": "nilihati", "fold": "nilihati", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "nilihati (once in Skt. nilīḍha in fig. sense, pw 〔5.264〕), licks: jihvayā nileḍhum ārabdhaḥ Divy 〔137.8〕.", "gloss_language": "en"}]}], "niliyati": [{"id": "nilIyati", "headword": "निलीयति", "headword_slp1": "nilIyati", "fold": "niliyati", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "nilīyati (ni with Skt. ḍī), flies down: ˚yathā (mss., Senart em. ˚tha) Mv 〔i.219.3〕 (= 〔ii.21.5〕, where abhi-lī˚ is read, see abhilīyati).", "gloss_language": "en"}]}], "nilaka": [{"id": "nIlaka", "headword": "नीलक", "headword_slp1": "nIlaka", "fold": "nilaka", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlaka, n. of a hunter (in the story of the deer Śiriprabha): Mv 〔ii.234.19〕.", "gloss_language": "en"}], "synonyms": ["नीलकं", "नीलकः"], "synonyms_slp1": ["nIlakaM", "nIlakaH"]}], "nilakayika": [{"id": "nIlakAyika", "headword": "नीलकायिक", "headword_slp1": "nIlakAyika", "fold": "nilakayika", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīla-kāyika, n. of a class of gods, noted only in LV 〔383.9〕 ˚kair devaputrair, and 11 Vairocano (q.v., 7) nāma Nīlakāyiko devaputraḥ. I have been unable to find anything more about this term. Tib. renders sṅon po (blue) ris (form, figure; also party, like BHS kāya). This suggests that Tib. understood belonging to the group of Nīla (blue) ones, rather than blue-bodied. In LV they, and their spokesman Vairocana, seem to be superior to the four mahārāja gods.", "gloss_language": "en"}]}], "nilakftsna": [{"id": "nIlakftsna", "headword": "नीलकृत्स्न", "headword_slp1": "nIlakftsna", "fold": "nilakftsna", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "nīla-kṛtsna, nt., see kṛtsna. (Divy 〔Index〕 wrongly kind of lotus.)", "gloss_language": "en"}]}], "nilakesa": [{"id": "nIlakeSa", "headword": "नीलकेश", "headword_slp1": "nIlakeSa", "fold": "nilakesa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlakeśa, n. of a disciple of Buddha: Mv 〔i.182.19〕.", "gloss_language": "en"}]}], "nilagiryanilavega": [{"id": "nIlagiryanilavega", "headword": "नीलगिर्यनिलवेग", "headword_slp1": "nIlagiryanilavega", "fold": "nilagiryanilavega", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlagiryanilavega (text ˚anīla˚), n. of the horse-jewel of a cakravartin: Gv 〔418.8〕.", "gloss_language": "en"}]}], "nilagriva": [{"id": "nIlagrIva", "headword": "नीलग्रीव", "headword_slp1": "nIlagrIva", "fold": "nilagriva", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlagrīva, n. of a rākṣasa: Divy 〔102.29〕; 〔105.9, 24〕.", "gloss_language": "en"}], "synonyms": ["नीलग्रीवः"], "synonyms_slp1": ["nIlagrIvaH"]}], "niladaRqa": [{"id": "nIladaRqa", "headword": "नीलदण्ड", "headword_slp1": "nIladaRqa", "fold": "niladaRqa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīladaṇḍa, n. of one of the ten krodha: Dharmas 〔11〕; Sādh 〔137.11〕 etc.", "gloss_language": "en"}]}], "nilaButi": [{"id": "nIlaBUti", "headword": "नीलभूति", "headword_slp1": "nIlaBUti", "fold": "nilaButi", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlabhūti, n. of a learned brahman: MSV 〔i.8.3 ff.〕", "gloss_language": "en"}]}], "nilamukta": [{"id": "nIlamuktA", "headword": "नीलमुक्ता", "headword_slp1": "nIlamuktA", "fold": "nilamukta", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "nīlamuktā, blue pearl, a kind of gem: -hāra, Sukh 〔54.11〕. Follows lohitamuktā (-hāra), a form otherwise known; perhaps invented to match the latter (blended with Skt. nīla-maṇi?).", "gloss_language": "en"}]}], "nilavasas": [{"id": "nIlavAsas", "headword": "नीलवासस्", "headword_slp1": "nIlavAsas", "fold": "nilavasas", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlavāsas, perh. n. or ep. of Kubera as lord of yakṣas: pañcabhir Nīlavāsaso yakṣaśatair Divy 〔238.23〕.", "gloss_language": "en"}]}], "nila": [{"id": "nIlA", "headword": "नीला", "headword_slp1": "nIlA", "fold": "nila", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlā, n. of a rākṣasī: Māy 〔244.1〕.", "gloss_language": "en"}]}], "nilada": [{"id": "nIlAda", "headword": "नीलाद", "headword_slp1": "nIlAda", "fold": "nilada", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlāda, n. of a yakṣa: Divy 〔113.11〕; 〔122.23〕.", "gloss_language": "en"}]}], "nilambuda": [{"id": "nIlAmbuda", "headword": "नीलाम्बुद", "headword_slp1": "nIlAmbuda", "fold": "nilambuda", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Nīlāmbuda, n. of a nāga king: Mmk 〔18.12〕.", "gloss_language": "en"}]}], "nilotpala": [{"id": "nIlotpalA", "headword": "नीलोत्पला", "headword_slp1": "nIlotpalA", "fold": "nilotpala", "headword_la