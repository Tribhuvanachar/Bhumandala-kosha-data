", "headword": "अरिमर्दन", "headword_slp1": "arimardana", "fold": "arimardana", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Arimardana, n. of two former Buddhas: Mv 〔i.137.4〕; 〔139.8〕 (here v.l. avi˚).", "gloss_language": "en"}], "synonyms": ["अरिमर्द्दन"], "synonyms_slp1": ["arimarddana"]}], "ariya": [{"id": "ariya", "headword": "अरिय", "headword_slp1": "ariya", "fold": "ariya", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "ariya, adj. (= Pali id.; MIndic for Skt. ārya), noble: Mv 〔iii.400.6〕 ariyo (both mss., Senart em. āryo) tāyi (so with Senart, mss. tāpi).", "gloss_language": "en"}]}], "ariswa": [{"id": "arizwa", "headword": "अरिष्ट", "headword_slp1": "arizwa", "fold": "ariswa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Ariṣṭa,\n(1) n. of a former Buddha: Mv 〔iii.231.1〕;\n(2) perhaps to be read for Ṛṣṭa, q.v.;\n(3) n. of a monk (= Pali Ariṭṭha, see Vin. 〔ii.25.12 ff.〕), punished for heresy by the utkṣepaṇīya: MSV 〔iii.30.4 ff.〕", "gloss_language": "en"}], "synonyms": ["अरिष्टं", "अरिष्टः"], "synonyms_slp1": ["arizwaM", "arizwaH"]}, {"id": "arizwA", "headword": "अरिष्टा", "headword_slp1": "arizwA", "fold": "ariswa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Ariṣṭā, n. of a devakumārī in the western quarter: Mv 〔iii.308.8〕; cf. next.", "gloss_language": "en"}]}], "ariswanemi": [{"id": "arizwanemi", "headword": "अरिष्टनेमि", "headword_slp1": "arizwanemi", "fold": "ariswanemi", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Ariṣṭanemi, n. of a former Buddha: Mv 〔1.140.5〕.", "gloss_language": "en"}], "synonyms": ["अरिष्टनेमिः"], "synonyms_slp1": ["arizwanemiH"]}], "ariswika": [{"id": "arizwikA", "headword": "अरिष्टिका", "headword_slp1": "arizwikA", "fold": "ariswika", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Ar