{"vaji": [{"id": "vaji", "headword": "वजि", "headword_slp1": "vaji", "fold": "vaji", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vaji (the usual form in mss. of Mv, Senart always Vajji), or Vajji (= Pali Vajji) = Vṛji, q.v., n. of a people and country; associated with (Skt.) Malla, and with Licchavi, who in Pali are one unit in the Vajji confederacy, but the two are also treated as interchangeable: Mv 〔i.34.9〕 (prose), text vajji-, v.l. vaji-; 〔264.13〕 (vs), mss. vajim abhimukho, read vajiṃ a˚, m.c.; Senart vajji; 〔326.2〕 (prose), mss. vajiṣu or varjiṣu; 〔ii.419.9〕 (prose), mss. -vaji-or -vajri-; 〔iii.421.5〕 (vs), vaji-required by meter, mss. vajī-, vajrī-, Senart vajji-.", "gloss_language": "en"}]}, {"id": "vajji", "headword": "वज्जि", "headword_slp1": "vajji", "fold": "vaji", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajji, v.l. for Vaji, q.v.", "gloss_language": "en"}]}], "vajira": [{"id": "vajira", "headword": "वजिर", "headword_slp1": "vajira", "fold": "vajira", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "vajira (= Pali id.), MIndic for Skt. vajra, in mg. diamond (or thunderbolt?), only in vss m.c.: vajirakāya LV 〔298.19〕; vajirasāra- Gv 〔56.1〕; 〔372.8〕.", "gloss_language": "en"}]}], "vajra": [{"id": "vajra", "headword": "वज्र", "headword_slp1": "vajra", "fold": "vajra", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajra,\n(1) n. of a samādhi: Mvy 〔516〕 (var. Vajropama, q.v.): ŚsP 〔1416.1〕;\n(2) n. of a future Buddha: Gv 〔441.26〕.", "gloss_language": "en"}], "synonyms": ["वज्रं", "वज्रः"], "synonyms_slp1": ["vajraM", "vajraH"]}, {"id": "vajrA", "headword": "वज्रा", "headword_slp1": "vajrA", "fold": "vajra", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrā, n. of a yoginī: Sādh 〔445.19〕 etc.; cf. Vajrayoginī.", "gloss_language": "en"}]}], "vajraka": 