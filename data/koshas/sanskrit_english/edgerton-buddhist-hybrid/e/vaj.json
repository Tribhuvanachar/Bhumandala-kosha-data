", "headword_slp1": "vajratArA", "fold": "vajratara", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajratārā, n. of a form of Tārā: Sādh 〔178.10〕 etc.", "gloss_language": "en"}]}], "vajratiksRa": [{"id": "vajratIkzRa", "headword": "वज्रतीक्ष्ण", "headword_slp1": "vajratIkzRa", "fold": "vajratiksRa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajratīkṣṇa, n. of a form of Mañjuśrī: Sādh 〔148.17〕 etc.", "gloss_language": "en"}]}], "vajratuRqa": [{"id": "vajratuRqa", "headword": "वज्रतुण्ड", "headword_slp1": "vajratuRqa", "fold": "vajratuRqa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajratuṇḍa (Skt. Lex. id.), vajra-beaked, n. or epithet of Garuḍa: LV 〔270.9〕 (prose).", "gloss_language": "en"}], "synonyms": ["वज्रतुंड", "वज्रतुण्डः"], "synonyms_slp1": ["vajratuMqa", "vajratuRqaH"]}], "vajratuRqi": [{"id": "vajratuRqI", "headword": "वज्रतुण्डी", "headword_slp1": "vajratuRqI", "fold": "vajratuRqi", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajratuṇḍī, ep. of Tārā: Hoernle MR 〔54.2〕; said (see 〔n. 14〕) to mean vajra-navel; cf. Vajranābhi.", "gloss_language": "en"}]}], "vajradfQanetra": [{"id": "vajradfQanetra", "headword": "वज्रदृढनेत्र", "headword_slp1": "vajradfQanetra", "fold": "vajradfQanetra", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradṛḍhanetra, n. of a yakṣa: Mvy 〔3372〕.", "gloss_language": "en"}]}], "vajradrumakesaraDvaja": [{"id": "vajradrumakesaraDvaja", "headword": "वज्रद्रुमकेसरध्वज", "headword_slp1": "vajradrumakesaraDvaja", "fold": "vajradrumakesaraDvaja", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradrumakesaradhvaja, n. of a gandharva: Mvy 〔3389〕.", "gloss_language": "en"}]}], "vajraDara": [{"id": "vajraDara", "headword": "वज्रधर", "headword_slp1": "vajraDara", "fold": "vajraDara", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradhara (cf. Vajrapāṇi?), n. of a Bodhisattva or deity: Mmk 〔312.6〕; Sādh 〔515.4〕 etc.", "gloss_language": "en"}], "synonyms": ["वज्रधरः"], "synonyms_slp1": ["vajraDaraH"]}, {"id": "vajraDarA", "headword": "वज्रधरा", "headword_slp1": "vajraDarA", "fold": "vajraDara", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradharā, n. of a rākṣasī: Māy 〔243.22〕.", "gloss_language": "en"}]}], "vajraDatvisvari": [{"id": "vajraDAtvISvarI", "headword": "वज्रधात्वीश्वरी", "headword_slp1": "vajraDAtvISvarI", "fold": "vajraDatvisvari", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradhātvīśvarī, n. of a goddess: Mvy 〔4291〕; Sādh 〔65.1〕; 〔280.16〕.", "gloss_language": "en"}]}], "vajraDvaja": [{"id": "vajraDvaja", "headword": "वज्रध्वज", "headword_slp1": "vajraDvaja", "fold": "vajraDvaja", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradhvaja, n. of a number of Tathāgatas: Dbh 〔99.18〕.", "gloss_language": "en"}]}], "vajraDvajasutra": [{"id": "vajraDvajasUtra", "headword": "वज्रध्वजसूत्र", "headword_slp1": "vajraDvajasUtra", "fold": "vajraDvajasutra", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajradhvaja-sūtra, n. of a work: Śikṣ 〔22.5〕; 〔278.14〕; also called Vajradhvaja-pariṇāmanā, Śikṣ 〔213.3〕; 〔291.10〕.", "gloss_language": "en"}]}], "vajranaBi": [{"id": "vajranABi", "headword": "वज्रनाभि", "headword_slp1": "vajranABi", "fold": "vajranaBi", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajranābhi, n. of two former Buddhas: Gv 〔104.20〕; 〔257.20〕 (here Vajira˚, in a vs).", "gloss_language": "en"}]}], "vajranarayaRaketu": [{"id": "vajranArAyaRaketu", "headword": "वज्रनारायणकेतु", "headword_slp1": "vajranArAyaRaketu", "fold": "vajranarayaRaketu", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajranārāyaṇaketu, n. of a former Buddha: Gv 〔281.26〕.", "gloss_language": "en"}]}], "vajranetra": [{"id": "vajranetra", "headword": "वज्रनेत्र", "headword_slp1": "vajranetra", "fold": "vajranetra", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajranetra, n. of a Bodhisattva: Gv 〔3.3〕.", "gloss_language": "en"}]}], "vajrapadavikramin": [{"id": "vajrapadavikramin", "headword": "वज्रपदविक्रमिन्", "headword_slp1": "vajrapadavikramin", "fold": "vajrapadavikramin", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapadavikramin, n. of a Bodhisattva: Gv 〔81.8〕.", "gloss_language": "en"}]}], "vajrapadmesvari": [{"id": "vajrapadmeSvarI", "headword": "वज्रपद्मेश्वरी", "headword_slp1": "vajrapadmeSvarI", "fold": "vajrapadmesvari", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapadmeśvarī, n. of a goddess: Sādh 〔76.1〕.", "gloss_language": "en"}]}], "vajrapadmotara": [{"id": "vajrapadmottara", "headword": "वज्रपद्मोत्तर", "headword_slp1": "vajrapadmottara", "fold": "vajrapadmotara", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapadmottara, n. of a Tathāgata: Dbh 〔89.14〕.", "gloss_language": "en"}]}], "vajrapaRi": [{"id": "vajrapARi", "headword": "वज्रपाणि", "headword_slp1": "vajrapARi", "fold": "vajrapaRi", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapāṇi (in Skt. ep. of Indra; in Pali Vajirapāṇi is n. of a yakkha, also of Indra, the two being identified, at least sometimes; on his character see DPPN; in BHS sometimes = Indra, as in Mv 〔i.183.10〕 where his form is assumed by Buddha; prob. also in Gv 〔250.20〕, where he parallels, and forms the climax of, a series of devatās; and prob. SP 〔445.6〕), n. of a yakṣa, Māy 〔3〕 (living at Rājagṛha); cf. Vajra-rājagṛha; usually not, as in Māy, a mere local yakṣa, but a much more imposing and even terrifying yakṣa, who e.g. in Bbh 〔152.1〕 may be conjured up by a Bodhisattva to frighten evil-doers (cf. also Caṇḍavajrapāṇi); often called by epithets like mahāyakṣasenāpati Suv 〔85.3〕, guhyakādhipati 〔91.17〕 (see the word, and cf. LV 〔66.6〕), yakṣendra 〔158.13〕; similarly Mmk 〔548.7〕, and often; elsewhere he is an important Bodhisattva, at or near the head of lists of them, Kv 〔1.7〕; Mvy 〔649〕; one of eight, Dharmas 〔12〕; a special attendant on Buddha Laṅk 〔240.10〕; a Bodhisattva in the 8th bhūmi is Vajrapāṇisatatānubaddha, Dbh 〔71.22〕; other references to V. the Bodhisattva, Śikṣ 〔274.3〕; Sādh 〔49.13〕 etc.; Mmk 〔11.6〕; 〔62.28〕; 〔68.20〕, etc.; it is clear, however, that for Mmk, at least, the Bodhisattva and the yakṣa or guhyaka prince are the same person; so Vajrapāṇir bodhisattvo 〔25.8〕 is referred to in 12 as (Ā)guhyakādhipatinā yakṣendreṇa; in addressing Vajrapāṇiṃ guhyakādhipatim, 〔36.2〕, he is called jinaputra (= bodhisattva) in the next line; he is called a bodhisattva in 〔145.2〕 and 13, and addressed as yakṣeśa in 14.", "gloss_language": "en"}], "synonyms": ["वज्रपाणिः"], "synonyms_slp1": ["vajrapARiH"]}], "vajrapada": [{"id": "vajrapAda", "headword": "वज्रपाद", "headword_slp1": "vajrapAda", "fold": "vajrapada", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapāda, m. pl., n. of a brahmanical gotra: Divy 〔635.11〕.", "gloss_language": "en"}]}], "vajrapura": [{"id": "vajrapura", "headword": "वज्रपुर", "headword_slp1": "vajrapura", "fold": "vajrapura", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapura, nt., n. of a ‘Dravidian town’ (Dramiḍapaṭṭana): Gv 〔72.13〕.", "gloss_language": "en"}]}], "vajrapramardanin": [{"id": "vajrapramardanin", "headword": "वज्रप्रमर्दनिन्", "headword_slp1": "vajrapramardanin", "fold": "vajrapramardanin", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Vajrapramardanin, n. of a Tathāga