{"halaka": [{"id": "halaka", "headword": "हलक", "headword_slp1": "halaka", "fold": "halaka", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Halaka, n. of a hunter: Divy 〔437.12 ff.〕; 〔442.15 ff.〕 (in story of Manoharā the kiṃnarī; cf. Mālaka); in MSV 〔i.126.18 ff.〕 (as in one ms. of Divy, see 〔437.12〕, note) Phalaka.", "gloss_language": "en"}]}], "halaDara": [{"id": "halaDara", "headword": "हलधर", "headword_slp1": "halaDara", "fold": "halaDara", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "Haladhara, n. of a former Buddha: Mv 〔i.137.6〕.", "gloss_language": "en"}], "synonyms": ["हलधरः"], "synonyms_slp1": ["halaDaraH"]}], "halasira": [{"id": "halasIra", "headword": "हलसीर", "headword_slp1": "halasIra", "fold": "halasira", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "hala-sīra (m. or nt.), plow, or perh. plow-share (so pw): Divy 〔124.7〕; 〔134.7〕; see s.v. sīra.", "gloss_language": "en"}], "synonyms": ["हलसीरः"], "synonyms_slp1": ["halasIraH"]}], "halita": [{"id": "halita", "headword": "हलित", "headword_slp1": "halita", "fold": "halita", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "halita, nt., = next, q.v.", "gloss_language": "en"}]}], "haliBa": [{"id": "haliBa", "headword": "हलिभ", "headword_slp1": "haliBa", "fold": "haliBa", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "halibha, nt., a high number: Mvy 〔7867〕, cited from Gv, where in 〔133.12〕 halitam, in 〔106.2〕 palimbha (sya); also = halibhu, m. or f. (˚bhuḥ, n. sg.) Mvy 〔7739〕; Tib. in Mvy both times rmoṅ yas, rmo yas.", "gloss_language": "en"}]}], "haliBu": [{"id": "haliBu", "headword": "हलिभु", "headword_slp1": "haliBu", "fold": "haliBu", "headword_language": "sa", "source": "edgerton-buddhist-hybrid", "senses": [{"gloss": "halibhu, m. or f., = prec., q.v.", "gloss_language": "en"}]}], "halahala": [{"id": "hAl