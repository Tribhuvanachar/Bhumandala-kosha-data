{"tantrikanawyam": [{"id": "tAntrikanAwyam", "headword": "तान्त्रिकनाट्यम्", "headword_slp1": "tAntrikanAwyam", "fold": "tantrikanawyam", "headword_language": "sa", "source": "rahula-coinages", "senses": [{"gloss": "**तान्त्रिकनाट्यम्**\n\n - Salsa dance. See तान्त्रिकनृत्य.", "gloss_language": "en"}]}], "tantrikanftya": [{"id": "tAntrikanftya", "headword": "तान्त्रिकनृत्य", "headword_slp1": "tAntrikanftya", "fold": "tantrikanftya", "headword_language": "sa", "source": "rahula-coinages", "senses": [{"gloss": "**तान्त्रिकनृत्य**\n\n - Salsa dance. Composed of two Sanskrit root words: \"तान्त्रिक\" meaning \"rhythmic\" and \"नृत्य\", \"नाट्यम्\" meaning \"dance.\" The words as a whole can be translated as \"a rhythmic dance.\" This word accurately conveys the rhythmic and upbeat nature of salsa dance, making it a fitting Sanskrit term for the style. See also तान्त्रिकनाट्यम्.", "gloss_language": "en"}]}], "tantumahavahini": [{"id": "tantumahAvAhinI", "headword": "तन्तुमहावाहिनी", "headword_slp1": "tantumahAvAhinI", "fold": "tantumahavahini", "headword_language": "sa", "source": "rahula-coinages", "senses": [{"gloss": "**तन्तुमहावाहिनी ,तन्तुबक **\n\n- Kabelkran , Cable Crane", "gloss_language": "en"}], "synonyms": ["तन्तुबक"], "synonyms_slp1": ["tantubaka"]}]}