{"Gas": [{"id": "Gas", "headword": "घस्", "headword_slp1": "Gas", "fold": "Gas", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "घस् {c1c} {c2c} P. (घसति, घस्ति, घस्त)\nTo eat, devour (a defective root\nused only to form certain tenses\nof अद्).", "gloss_language": "en"}]}], "GasaH": [{"id": "GasaH", "headword": "घसः", "headword_slp1": "GasaH", "fold": "GasaH", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "घसः The eater, devourer.", "gloss_language": "en"}], "synonyms": ["घस"], "synonyms_slp1": ["Gasa"]}, {"id": "GAsaH", "headword": "घासः", "headword_slp1": "GAsaH", "fold": "GasaH", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "घासः [घस् कर्मणि घञ्]\n1 Food.\n--2\nMeadow or pasture grass;\nघासाभावात् Pt. 5; घासमुष्टिं परगवे दद्यात् संवत्सरं\nतु यः Mb.\n--Comp.\n--कुंदं, --स्थानं a\npasture.\n--कूटं hay-rick.", "gloss_language": "en"}, {"gloss": "घासः See under घस्.", "gloss_language": "en"}], "synonyms": ["घास"], "synonyms_slp1": ["GAsa"]}], "GasiH": [{"id": "GasiH", "headword": "घसिः", "headword_slp1": "GasiH", "fold": "GasiH", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "घसिः Ved. Food.", "gloss_language": "en"}], "synonyms": ["घसि"], "synonyms_slp1": ["Gasi"]}, {"id": "GAsiH", "headword": "घासिः", "headword_slp1": "GAsiH", "fold": "GasiH", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "घासिः [घस् बा˚ इण्]\n1 Fire.\n--2\nGrass.", "gloss_language": "en"}], "synonyms": ["घासि"], "synonyms_slp1": ["GAsi"]}], "Gasmara": [{"id": "Gasmara", "headword": "घस्मर", "headword_slp1": "Gasmara", "fold": "Gasmara", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "घस्मर^1 a. [घस्-क्मरच्]\n1\nVoracious, gluttonous; दावानलो घस्मरः\nBv. 1. 34.\n--2 Devourer, destroyer;\nद्रुपदसुतचमूघस्मरो द्रोणिरस्मि Ve. 5. 36.\n[1] Correction submitted by on 20170110. Reference: https://github.com/sanskrit-lexicon/CORRECTIONS/issues/332,. note: aff.