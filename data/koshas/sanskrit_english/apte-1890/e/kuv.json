{"kuveraH": [{"id": "kuveraH", "headword": "कुवेरः", "headword_slp1": "kuveraH", "fold": "kuveraH", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "कुबे(वे)रः [कुत्सितं बे(वे)रं शरीरं\nयस्य सः] The god of riches and\ntreasure and the regent of the\nnorthern quarter; कुबेरगुप्तां दिशमुष्णरश्मौ\nगंतुं प्रवृत्ते समयं विलंघ्य Ku. 3. 25 (vide\nMalli. thereon.). [Kubera is the son of\nViśravas by Iḍaviḍā and thus the\nhalfbrother of Rāvaṇa. Besides being the\nlord of riches and regent of the north,\nhe is the king of the Yakṣas and\nKinnaras, and a friend of Rudra. His abode\nis Kailāsa. He is represented as being\ndeformed in body-having three legs,\nonly eight teeth, and a yellow mark\nin place of one eye].\n--Comp.\n--अद्रिः.\n--अचलः an epithet of mountain\nKailāsa.\n--दिश् f. the north.", "gloss_language": "en"}], "synonyms": ["कुवेर"], "synonyms_slp1": ["kuvera"]}], "kuvan": [{"id": "kuvaM", "headword": "कुवं", "headword_slp1": "kuvaM", "fold": "kuvan", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "1 A flower.\n--2 A lotus.", "gloss_language": "en"}], "synonyms": ["कुव"], "synonyms_slp1": ["kuva"]}], "kuvamaH": [{"id": "kuvamaH", "headword": "कुवमः", "headword_slp1": "kuvamaH", "fold": "kuvamaH", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "कुवमः The sun.", "gloss_language": "en"}], "synonyms": ["कुवम"], "synonyms_slp1": ["kuvama"]}], "kuvara": [{"id": "kuvara", "headword": "कुवर", "headword_slp1": "kuvara", "fold": "kuvara", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "कुवर See तुवर.", "gloss_language": "en"}], "synonyms": ["कुवरः"], "synonyms_slp1": ["kuvaraH"]}, {"id": "kUvara", "headword": "कूवर", "headword_slp1": "kUvara", "fold": "kuvara", "headword_language": "sa", "source": "apte-1890", "senses": [{"gloss": "कूब(व)र a. (री f.)\n1\nBeautiful, agreeable.\n--2 Hump-backed.\n--रः, --रं The pole of a carriage to\nwhich the yoke is fixed.\n--रः A\nhump-backed man