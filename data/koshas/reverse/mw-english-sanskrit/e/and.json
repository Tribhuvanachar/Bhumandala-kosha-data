{"and": [{"id": "and", "headword": "and", "headword_slp1": "and", "fold": "and", "headword_language": "en", "source": "mw-english-sanskrit", "senses": [{"gloss": "AND, conj. च placed after the word which it connects with\nanother. In many cases ‘and’ may be omitted in San-\nskrit, and the connection expressed by the use of the\nindeclinable participle; as, ‘the beasts assembled and\ninformed the lion,’ पशुभिर्मिलित्वा सिंहो विज्ञप्तः.\n— (Moreover)\nअपिच, किञ्च, अपरं, अन्यच्च.\n— (And then) अथ.", "gloss_language": "sa"}]}], "andante": [{"id": "andante", "headword": "andante", "headword_slp1": "andante", "fold": "andante", "headword_language": "en", "source": "mw-english-sanskrit", "senses": [{"gloss": "ANDANTE, s. घनं, तत्त्वं, विलम्बितं, स्पष्टं.", "gloss_language": "sa"}]}], "andiron": [{"id": "andiron", "headword": "andiron", "headword_slp1": "andiron", "fold": "andiron", "headword_language": "en", "source": "mw-english-sanskrit", "senses": [{"gloss": "ANDIRON, s. लोहनिर्म्मितः शूलाधारः.", "gloss_language": "sa"}]}], "androgynal": [{"id": "androgynal", "headword": "androgynal", "headword_slp1": "androgynal", "fold": "androgynal", "headword_language": "en", "source": "mw-english-sanskrit", "senses": [{"gloss": "ANDROGYNAL or ANDROGYNOUS, a. द्विलिङ्गविशिष्टः -ष्टा -ष्टं.", "gloss_language": "sa"}]}]}