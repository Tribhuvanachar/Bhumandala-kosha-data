{"may": [{"id": "may", "headword": "may", "headword_slp1": "may", "fold": "may", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MAY (subs.): उत्तरवैशाखपूर्वज्यैष्ठसंवादीयुरुपीयवर्षस्य\n पञ्चमो मासः।", "gloss_language": "sa"}, {"gloss": "MAY (v.):\nI = can: q. v.: by विधिलिङ्,\nyou\nm. carry the burden:\nत्वं भारं वहेः, S. k.\nII Ex-\n-pressing desire or wish:\n(1) by आशीर्लिङ्,\nm. people live a man's life:\nजीव्याज्जनः पुरुषायुषम्,\nVi.;\n(2) by लोट्, m. you have a good journey:\nतव वर्त्मनि वर्ततां शिवम्, N.\nIII. Denoting con-\n-tingency or liability: by विधिलिङ्,\nan appli-\ncant m. or m. not get fortune:\nलभेत वा प्रार्थयिता न\n वा श्रियम्, Sa.;\nI might have disregarded this\nwretched life:\nकुर्यामुपेक्षां हतजीवितेऽस्मिन्, R.\nPh.: m. be (= perhaps: q.v.): expr. by\nविधिलिङ्।", "gloss_language": "sa"}]}], "may-bug": [{"id": "may-bug", "headword": "may-bug", "headword_slp1": "may-bug", "fold": "may-bug", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MAY-BUG: गोमयोत्थाभेदः।", "gloss_language": "sa"}]}], "may-day": [{"id": "may-day", "headword": "may-day", "headword_slp1": "may-day", "fold": "may-day", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MAY-DAY: मेमासस्य प्रथमदिवसः।", "gloss_language": "sa"}]}], "may-pole": [{"id": "may-pole", "headword": "may-pole", "headword_slp1": "may-pole", "fold": "may-pole", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MAY-POLE: *मेनृत्ययूपः।", "gloss_language": "sa"}]}], "may-quen": [{"id": "may-queen", "headword": "may-queen", "headword_slp1": "may-queen", "fold": "may-quen", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MAY-QUEEN: *मेमासेश्वरी।", "gloss_language": "sa"}]}], "mayor": [{"id": "mayor", "headword": "mayor", "headword_slp1": "mayor", "fold": "mayor", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MAYOR: *अधिनायकः।\nM. ess:\n*अधिनायिका।", "gloss_language": "sa"}]}], "mayora