sapprehend", "fold": "misaprehend", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISAPPREHEND: अन्यथा गृह्णाति (ग्रह्, c. 9.):\nv. To apprehend, wrongly.", "gloss_language": "sa"}]}], "misaprehension": [{"id": "misapprehension", "headword": "misapprehension", "headword_slp1": "misapprehension", "fold": "misaprehension", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISAPPREHENSION: v. Misunderstanding.", "gloss_language": "sa"}]}], "misbecome": [{"id": "misbecome", "headword": "misbecome", "headword_slp1": "misbecome", "fold": "misbecome", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISBECOME, MISBECOMINGNESS: v. To become,\netc., not.", "gloss_language": "sa"}]}], "misbegot": [{"id": "misbegot", "headword": "misbegot", "headword_slp1": "misbegot", "fold": "misbegot", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISBEGOT, -TEN:\n(1) विजन्मन् (mfn.);\n(2) विजातः\n(ता, तं).", "gloss_language": "sa"}]}], "misbehave": [{"id": "misbehave", "headword": "misbehave", "headword_slp1": "misbehave", "fold": "misbehave", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISBEHAVE: v. To behave improperly.\nM. ing:\nदुराचारः (रा, रं).", "gloss_language": "sa"}]}], "misbehaviour": [{"id": "misbehaviour", "headword": "misbehaviour", "headword_slp1": "misbehaviour", "fold": "misbehaviour", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISBEHAVIOUR:\n(1) दुश्चेष्टितम्;\n(2) दुर्वृत्तिः;\n(3)\nअविनयः।", "gloss_language": "sa"}]}], "miscalculate": [{"id": "miscalculate", "headword": "miscalculate", "headword_slp1": "miscalculate", "fold": "miscalculate", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCALCULATE: वि-गणयति (गण्, c. 10.): v.\nAlso to err.", "gloss_language": "sa"}]}], "miscalculation": [{"id": "miscalculation", "headword": "miscalculation", "headword_slp1": "miscalculation", "fold": "miscalculation", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCALCULATION: भ्रान्तगणना (?); भ्रमः (= error).", "gloss_language": "sa"}]}], "miscal": [{"id": "miscall", "headword": "miscall", "headword_slp1": "miscall", "fold": "miscal", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCALL: v. To call, improperly. M. ed:\nमिथ्याभिहितः (ता, तं).", "gloss_language": "sa"}]}], "miscariage": [{"id": "miscarriage", "headword": "miscarriage", "headword_slp1": "miscarriage", "fold": "miscariage", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCARRIAGE:\nI Abortion: q. v.: गर्भपातः।\nII Failure: q. v.", "gloss_language": "sa"}]}], "miscary": [{"id": "miscarry", "headword": "miscarry", "headword_slp1": "miscarry", "fold": "miscary", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCARRY:\nI To have a miscarriage: गर्मः\n स्रवति (स्रु, c. l.), पतति (पत्, c. l.), etc. (with\ngen.).\nII Not to succeed: न सिध्यति (सिध्,\nc. 4.).\nII Of letters, etc.: म्रियते (मृ, c. 6.)\n(used in Bengali).", "gloss_language": "sa"}]}], "miscelaneous": [{"id": "miscellaneous", "headword": "miscellaneous", "headword_slp1": "miscellaneous", "fold": "miscelaneous", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCELLANEOUS: प्रकीर्ण (f. र्णा), -कः (का, कं),\nR.: v. Also promiscuous, various, mix(ed).", "gloss_language": "sa"}]}], "miscelaneously": [{"id": "miscellaneously", "headword": "miscellaneously", "headword_slp1": "miscellaneously", "fold": "miscelaneously", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCELLANEOUSLY:\n(1) प्रकीर्णम्;\n(2) by adj.", "gloss_language": "sa"}]}], "miscelaneousnes": [{"id": "miscellaneousness", "headword": "miscellaneousness", "headword_slp1": "miscellaneousness", "fold": "miscelaneousnes", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCELLANEOUSNESS:\n(1) प्रकीर्णता;\n(2) मिश्रितता\n(?).", "gloss_language": "sa"}]}], "miscelany": [{"id": "miscellany", "headword": "miscellany", "headword_slp1": "miscellany", "fold": "miscelany", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCELLANY:\n(1) expr. by adj.;\n(2) संकरः\n(= medley).", "gloss_language": "sa"}]}], "mischance": [{"id": "mischance", "headword": "mischance", "headword_slp1": "mischance", "fold": "mischance", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHANCE: दुर्घटना: v. Misfortune, calamity.", "gloss_language": "sa"}]}], "mischief": [{"id": "mischief", "headword": "mischief", "headword_slp1": "mischief", "fold": "mischief", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHIEF:\nI Harm, injury:\n(1) अपकारः;\n(2) हिंसा (in old writers):\nif cattle commit m.\nto crops:\nधान्यं विहिंस्युः पशवो यदि, M. Ph.:\nm. to (lit. destruction of) crops by cattle, etc.:\nशस्यघातो गवादिमिः, N.s.\nII Damage, loss:\nq. v.: हानिः।", "gloss_language": "sa"}]}], "mischief-maker": [{"id": "mischief-maker", "headword": "mischief-maker", "headword_slp1": "mischief-maker", "fold": "mischief-maker", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHIEF-MAKER: expr. by circumlo. with:\nभेदः (= separation), विवादः (= dispute) or\nअनर्थः (= evil),\nhe was the m.:\n*स भेदं जनयामास।", "gloss_language": "sa"}]}], "mischief-making": [{"id": "mischief-making", "headword": "mischief-making", "headword_slp1": "mischief-making", "fold": "mischief-making", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHIEF-MAKING: (adj. or subs.): expr.\nby circumlo. as above.", "gloss_language": "sa"}]}], "mischievous": [{"id": "mischievous", "headword": "mischievous", "headword_slp1": "mischievous", "fold": "mischievous", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHIEVOUS:\n(1) हिंस्र (f. स्रा);\n(2) घातुकः\n(का, कं) (= murderous);\n(3) दुष्टबुद्धि (mfn.)\n(= malicious);\n(4) पाप- in comp. (= wic-\n-ked).", "gloss_language": "sa"}]}], "mischievously": [{"id": "mischievously", "headword": "mischievously", "headword_slp1": "mischievously", "fold": "mischievously", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHIEVOUSLY:\n(1) हिंसापूर्वम्;\n(2) दुष्टबद्ध्या\n(= maliciously).", "gloss_language": "sa"}]}], "mischievousnes": [{"id": "mischievousness", "headword": "mischievousness", "headword_slp1": "mischievousness", "fold": "mischievousnes", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCHIEVOUSNESS: हिंस्रता, etc.: v. Mischievous.", "gloss_language": "sa"}]}], "misconceive": [{"id": "misconceive", "headword": "misconceive", "headword_slp1": "misconceive", "fold": "misconceive", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCONCEIVE, MISCONCEPTION: v. Misun-\n-derstand, -ing.", "gloss_language": "sa"}]}], "misconduct": [{"id": "misconduct", "headword": "misconduct", "headword_slp1": "misconduct", "fold": "misconduct", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCONDUCT (subs.):\n(1) दुश्चरितम्;\n(2) दुश्चे-\nष्टितम्;\n(3) दुर्नयः: v. Also misdeed.", "gloss_language": "sa"}, {"gloss": "MISCONDUCT (v.): दुश्चरति (चर्, c. l (?);\nदुष्टं चरति; न सम्यक् व्यवहरति (हृ, c. l.).", "gloss_language": "sa"}]}], "misconstruction": [{"id": "misconstruction", "headword": "misconstruction", "headword_slp1": "misconstruction", "fold": "misconstruction", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCONSTRUCTION: असङ्गतव्याख्या; अयथार्थव्याख्या\n(?).", "gloss_language": "sa"}]}], "misconstrue": [{"id": "misconstrue", "headword": "misconstrue", "headword_slp1": "misconstrue", "fold": "misconstrue", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCONSTRUE: न सम्यक् परिगृह्णाति (ग्रह्, c. 9.),\netc.", "gloss_language": "sa"}]}], "miscreant": [{"id": "miscreant", "headword": "miscreant", "headword_slp1": "miscreant", "fold": "miscreant", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISCREANT:\n(1) खण्डितवृत्तः (त्ता, त्तं);\n(2) पापा-\nचारः (रा, रं); etc.", "gloss_language": "sa"}]}], "misdate": [{"id": "misdate", "headword": "misdate", "headword_slp1": "misdate", "fold": "misdate", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISDATE (v.): *लिखनदिनभ्रमं करोति।", "gloss_language": "sa"}]}], "misded": [{"id": "misdeed", "headword": "misdeed", "headword_slp1": "misdeed", "fold": "misded", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISDEED:\n(1) कुकर्मन् (n.), etc.;\n(2) अकार्यम्;\nof all m.s:\nसर्वेषामकार्याणाम्, Mah. s. 35. 36.:\nv. Also crime.", "gloss_language": "sa"}]}], "misdemeanour": [{"id": "misdemeanour", "headword": "misdemeanour", "headword_slp1": "misdemeanour", "fold": "misdemeanour", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISDEMEANOUR: दुश्चरितम्: v. Misconduct.", "gloss_language": "sa"}]}], "misdirect": [{"id": "misdirect", "headword": "misdirect", "headword_slp1": "misdirect", "fold": "misdirect", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISDIRECT: expr. by circumlo.,\nhe m.ed the\nletter to Jāhānābād in Gayā instead of to\nJāhānābād in Burdwan:\n*पत्रं वर्धमानान्तर्गतं\n जाहानाबादमप्रेष्य गयायां जाहानाबादं निर्दिदेश।", "gloss_language": "sa"}]}], "miser": [{"id": "miser", "headword": "miser", "headword_slp1": "miser", "fold": "miser", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISER:\n(1) कृपणः, -जनः, H. ;\n(2) मितंपचः (cook-\n-ing little) (rare), H.", "gloss_language": "sa"}]}], "miserable": [{"id": "miserable", "headword": "miserable", "headword_slp1": "miserable", "fold": "miserable", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISERABLE:\n(1) कृपण (f. णा) (= mean), yet\nm. (men) bear distress at the door of the rich:\nसहन्ते सन्तापं तदपि धनिनां द्वारि कृपणाः, J.;\n(2)\nदीनः (ना, नं) (= wretched), very m. condition:\nसुदीना दशा, Ku.;\n(3) दुःखितः (ता, तं) (= un-\n-happy), surely the poor fellow is m. like me:\nनूनमहमिव दुःखितस्तपस्वी, Mu. vi.", "gloss_language": "sa"}]}], "miserably": [{"id": "miserably", "headword": "miserably", "headword_slp1": "miserably", "fold": "miserably", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISERABLY:\n(1) कार्पण्येन;\n(2) दीनम्: v.\nMeanly, wretchedly.", "gloss_language": "sa"}]}], "miserablenes": [{"id": "miserableness", "headword": "miserableness", "headword_slp1": "miserableness", "fold": "miserablenes", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISERABLENESS:\n(1) कार्पण्यम्;\n(2) कदर्यता;\n(3)\nलुब्धता (= covetousness).", "gloss_language": "sa"}]}], "miserly": [{"id": "miserly", "headword": "miserly", "headword_slp1": "miserly", "fold": "miserly", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISERLY:\n(1) कृपण (f. णा);\n(2) कदर्य (f. र्या):\nv. Also mean.", "gloss_language": "sa"}]}], "misery": [{"id": "misery", "headword": "misery", "headword_slp1": "misery", "fold": "misery", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISERY:\n(1) दुःखम् (gen. term = distress, trou-\n-ble), the same becomes the seed of the tree of m.:\nतदेष दुःखवृक्षस्य बीजत्वमुपगच्छति,\nV p.;\neven m.ies\nmet in the Daṇḍakā:\nप्राप्तानि दुःखान्यपि दण्डकायाम्,\nR. xiv. 25.;\n(2) दैन्यम् (the state),\nfull of m.\nand thievishness:\nदैन्यस्तैन्यमयाः, N. xvii. 25.;\n(3) व्यसनम् (= calamity). fellow-disciple of m.:\nव्यसनसब्रह्मचारिन्, Mu. vi.;\n(4) कार्पण्यम् (rare),\nD. iv.", "gloss_language": "sa"}]}], "misfortune": [{"id": "misfortune", "headword": "misfortune", "headword_slp1": "misfortune", "fold": "misfortune", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISFORTUNE:\n(1) दुर्भाग्यम् (both of ill-luck\nand of disasters);\n(2) दुर्दैवम् (rarely of\ndisasters),\nthis is my m.:\nमम दुर्दैवमेतत्, H. v.", "gloss_language": "sa"}]}], "misgive": [{"id": "misgive", "headword": "misgive", "headword_slp1": "misgive", "fold": "misgive", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGIVE:\nmy heart m.s me:\nउदेति मनसि शङ्का or\nअनिष्टं शङ्कते मे हृदयम्।", "gloss_language": "sa"}]}], "misgiving": [{"id": "misgiving", "headword": "misgiving", "headword_slp1": "misgiving", "fold": "misgiving", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGIVING (subs.): शङ्का: v. Apprehension.", "gloss_language": "sa"}]}], "misgoten": [{"id": "misgotten", "headword": "misgotten", "headword_slp1": "misgotten", "fold": "misgoten", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGOTTEN (adj.): अन्यायोपार्जितः (ता, तं) and\nsim. comp.s.", "gloss_language": "sa"}]}], "misgovern": [{"id": "misgovern", "headword": "misgovern", "headword_slp1": "misgovern", "fold": "misgovern", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGOVERN: न सम्यक् शास्ति (शास्, c. 2); better\nby subs.", "gloss_language": "sa"}]}], "misgovernment": [{"id": "misgovernment", "headword": "misgovernment", "headword_slp1": "misgovernment", "fold": "misgovernment", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGOVERNMENT:\n(1) कुशासनम्;\n(2) दुष्टशासनम्;\netc.", "gloss_language": "sa"}]}], "misguide": [{"id": "misguide", "headword": "misguide", "headword_slp1": "misguide", "fold": "misguide", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGUIDE: अपथे पातयति (c. of पत्) and sim.\nexpr. s.", "gloss_language": "sa"}]}], "misguided": [{"id": "misguided", "headword": "misguided", "headword_slp1": "misguided", "fold": "misguided", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "MISGUIDED (adj.): विमार्गधावितः (ता, तं) and\nsim. comp.s.", "gloss_language": "sa"}]}], "mishap": [{"id": "mishap", "headword": "mishap", "headword_slp1": "mishap", "fold": "mishap", "headword