{"double": [{"id": "double", "headword": "double", "headword_slp1": "double", "fold": "double", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "DOUBLE (adj.):\nI Two-fold:\n(1) द्वि- in\ncomp.;\n(2) द्विकः (का, कं).\nII As much\nagain: द्विगुणः (णा, णं),\nd. pay:\nद्विगुणवेतनम्।\nIII\nIn pairs: द्वन्द्वीभूय।\nIV Deceitful, ambiguous;\nq. v.: perh. द्वि- in comp., having a d. meaning:\nद्व्यर्थः (र्था, र्थं), Va.", "gloss_language": "sa"}, {"gloss": "DOUBLE (subs.):\nI Twice as much: द्विगुणम्।\nII A trick: q. v.\nIII Companion: q. v.", "gloss_language": "sa"}, {"gloss": "DOUBLE (v.):\nI Lit.: द्विगुणीकरोति।\nII To be\nd. of: द्विगुणः (णा, णं).\nIII To double up:\nद्विभङ्गिं करोति (?). Ph.:\nto d. a cape:\n*प्रलम्बं लङ्घयति।", "gloss_language": "sa"}, {"gloss": "DOUBLE (v. i.):\nI Lit.: द्विगुणीभवति।\nII To\nreturn: परावर्तते (वृत्, c. 1.).\nIII To play\nfalse: छलनां करोति।", "gloss_language": "sa"}]}], "double-bareled": [{"id": "double-barrelled", "headword": "double-barrelled", "headword_slp1": "double-barrelled", "fold": "double-bareled", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "DOUBLE-BARRELLED: *द्विनालः (ला, लं).", "gloss_language": "sa"}]}], "double-dealer": [{"id": "double-dealer", "headword": "double-dealer", "headword_slp1": "double-dealer", "fold": "double-dealer", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "DOUBLE-DEALER, DOUBLE-DEALING: v. Deceit-\n-ful.", "gloss_language": "sa"}]}], "double-dealing": [{"id": "double-dealing", "headword": "double-dealing", "headword_slp1": "double-dealing", "fold": "double-dealing", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "DOUBLE-DEALING (subs.): v. Deceit, artifice.", "gloss_language": "sa"}]}], "double-entendre": [{"id": "double-entendre", "headword": "double-entendre", "headword_slp1": "double-entendre", "fold": "double-entendre", "headword_language": "en", "source": "borooah", "senses": [{"gloss": "DOUBLE-ENTENDR