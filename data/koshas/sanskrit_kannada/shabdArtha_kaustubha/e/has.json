"id": "hAsya", "headword": "हास्य", "headword_slp1": "hAsya", "fold": "hasya", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ನಗೆ /ನಗು", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "etymology": "निष्पत्तिः: हसे (हसने) \"ण्यत्\" (३-१-१२४)"}, {"gloss": "ಉಲ್ಲಾಸ /ನಲಿವು /ವಿನೋದ", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "citations": [{"text": "\"द्यूतमेतत् पुराकल्पे दृष्टं वैरकरं महत्। तस्माद्द्यूतं न सेवेत हास्यार्थमपि बुद्धिमान्\""}, {"text": "मनु० ९-२२७"}]}, {"gloss": "ಹಾಸ್ಯರಸ", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "citations": [{"text": "\"विकृताकारवाग्वेषचेष्टादेः कुहकाद्भवेत् । हास्यो हासस्थायीभावः श्वेतः प्रमथदैवतः\""}, {"text": "सा० द० ३-२१४"}]}, {"gloss": "ಪರಿಹಾಸಕ್ಕೆ ಯೋಗ್ಯವಾದ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "citations": [{"text": "\"संरुद्धचेष्टस्य मृगेन्द्र कामं हास्यं वचस्तद्यदहं विवक्षुः\""}, {"text": "रघु० २-४३"}]}]}], "hasyarasa": [{"id": "hAsyarasa", "headword": "हास्यरस", "headword_slp1": "hAsyarasa", "fold": "hasyarasa", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಹಾಸ ಸ್ಥಾಯಿಭಾವವುಳ್ಳ ಹಾಸ್ಯರಸ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "citations": [{"text": "\"विकृताकारवाग्वेषचेष्टादेः कुहकाद्भवेत् । हास्यो हासस्थायीभावः श्वेतः प्रमथदैवतः॥ विकृताकारवाक्चेष्टं यमालोक्य हसेज्जनः। तदत्रालम्बनं प्राहुस्तश्चेष्टोद्दीपनं मतम्॥ अनुभावोऽक्षिसङ्कोचवदनस्मेरतादयः। निद्रालस्यावहित्थाद्या अत्रस्युर्व्यभिवारिणः\""}, {"text": "सा० द० ३"}]}]}]}