{"gacCa": [{"id": "gacCa", "headword": "गच्छ", "headword_slp1": "gacCa", "fold": "gacCa", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ವೃಕ್ಷ /ಮರ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "etymology": "गतं गमनं छ्यति; निष्पत्तिः: गम्लृ (गतौ) - \"क्विप्\" (वा० ३-३-९४) । गत् । छो (छेदने) - \"कः\" (३-२-४)", "note": "\"वृक्षः कारस्करो गच्छः पलाशी विष्टरः स्थिरः\" - त्रिकाण्ड० ।"}]}], "gacCat": [{"id": "gacCat", "headword": "गच्छत्", "headword_slp1": "gacCat", "fold": "gacCat", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಹೋಗುತ್ತಿರುವ /ನಡೆಯುತ್ತಿರುವ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "etymology": "निष्पत्तिः: गम्लृ (गतौ) - \"शतृ\" (३-२-१२४)", "citations": [{"text": "\"दूरेऽभवन्भोजबलस्य गच्छतः शैलोपमातीतगजस्य निम्नगा\""}, {"text": "माघ० १२-६१"}]}, {"gloss": "ಪಡೆಯುವ /ಹೊಂದುವ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "citations": [{"text": "\"गच्छता दशरथेन निर्वृतिं भूभुजामसुलभां भुजाबलात्\""}, {"text": "चं० रा०"}]}]}], "gacCanti": [{"id": "gacCantI", "headword": "गच्छन्ती", "headword_slp1": "gacCantI", "fold": "gacCanti", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಹೋಗುತ್ತಿರುವ /ನಡೆಯುತ್ತಿರುವ", "gloss_language": "kn", "pos": "स्त्रीलिङ्गः", "citations": [{"text": "\"गच्छन्तीरलसमवेक्ष्य विस्मयिन्यस्तास्तन्वीर्न विदधिरे गतानि हंस्यः\""}, {"text": "माघ० ८-७"}]}]}]}