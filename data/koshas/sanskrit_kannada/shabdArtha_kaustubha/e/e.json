{"e": [{"id": "e", "headword": "ए", "headword_slp1": "e", "fold": "e", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಏಕಾರ", "gloss_language": "kn", "note": "ಇದು ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಕಂಠ ಮತ್ತು ತಾಲುಸ್ಥಾನಗಳಲ್ಲಿ ಹುಟ್ಟುವ ೧೧ನೆಯ ಸ್ವರವರ್ಣ.ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ದೀರ್ಘಸ್ವರವು ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುನಾಸಿಕ ಭೇದದಿಂದ ೨ ವಿಧವಾಗಿ ಒಟ್ಟು ೬ವಿಧವಾಗುವುದು."}, {"gloss": "ತೇಜಸ್ಸು", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಜಲ /ನೀರು", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ರಾತ್ರಿ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಮಹಡಿಯ ಒಳಭಾಗ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ವಿಷ್ಣು", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಆಕಾಶ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಹನ್ನೊಂದುಸಂಖ್ಯೆ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಪ್ರಾತಃಕಾಲ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ರತ್ನಜಗುಲಿ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "note": "\"एकारस्तेजसि जले रात्रौ हर्म्योदरे हरौ । व्योम्न्येकादशसङ्ख्यायां दिनादौ मणिकुट्टिमे\" - नानार्थर० ।"}, {"gloss": "ಸ್ಮೃತಿ /ನೆನಪು", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ಅಸೂಯೆ /ಹೊಟ್ಟೆಕಿಚ್ಚು", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ದಯೆ /ಕನಿಕರ", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ಸಂಬೋಧನೆ", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ಆಹ್ವಾನ", "gloss_language": "kn", "pos": "अव्ययम्", "note": "\"ए स्मृतावप्यसूयानुकम्पामन्त्रणहूतिषु\" - मेदि० ।"}]}]}