{"suyamuna": [{"id": "suyAmuna", "headword": "सुयामुन", "headword_slp1": "suyAmuna", "fold": "suyamuna", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ವಿಷ್ಣು", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "etymology": "सु शोभनं पावनं यामुनं यमुनासम्बन्धिजलकेलिपुष्पापचयरासक्रीडादिकमस्य", "citations": [{"text": "\"शूरसेनो यदुश्रेष्ठः सन्निवासः सुयामुनः\""}, {"text": "वि० स०"}], "note": "\"गोपीभिर्यमुनायां तु शोभनं पावनं महत् । जलक्रीडादि यस्येति सुयामुन इति ईरितः ॥\" - निरुक्तिः"}, {"gloss": "ಒಂದು ಪರ್ವತ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಪ್ರಾಸಾದ /ರಾಜಗೃಹ /ದೇವಸ್ಥಾನ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ವತ್ಸರಾಜ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "note": "\"सुयामुनो जनार्दने । प्रासादे वत्सराजेऽद्रिभेदे\" - हेम० ।"}, {"gloss": "ಒಂದು ಮೇಘ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "note": "\"सुयामुनो वत्सराजे प्रासादेऽभ्रान्तरेऽच्युते\" - मेदि० ।"}]}], "suyoDana": [{"id": "suyoDana", "headword": "सुयोधन", "headword_slp1": "suyoDana", "fold": "suyoDana", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ದುರ್ಯೋಧನ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "etymology": "सुखेन युध्यते; निष्पत्तिः: सु + युध (सम्प्रहारे) - \"युच्\" (वा० ३-३-१२८)", "citations": [{"text": "\"नलिनी निगूढसलिला च यत्र सा स्थलमित्यधःपतति या सुयोधने\""}, {"text": "माघ० १३-५९"}]}]}]}