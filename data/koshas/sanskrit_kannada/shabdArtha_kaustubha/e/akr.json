ce": "shabdArtha_kaustubha", "senses": [{"gloss": "ಶ್ರೀಕೃಷ್ಣನ ಸ್ನೇಹಿತನಾದ ಒಬ್ಬ ಯಾದವ.", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "note": "ಈತನು ಕಂಸನನ್ನು ಆಶ್ರಯಿಸಿ ಜೀವಿಸುತ್ತಿದ್ದನು. ಕಂಸನು ನಾರದರ ಮುಖದಿಂದ ರಾಮಕೃಷ್ಣರ ವೃತ್ತಾಂತವನ್ನು ತಿಳಿದು ಚಾಣೂರ ಮತ್ತು ಮುಷ್ಟಿಕರಿಂದ ಜಟ್ಟಿಯ ಕಾಳಗದಲ್ಲಿ ಕೊಲ್ಲಿಸುವ ಉದ್ದೇಶದಿಂದ ಶ್ರೀರಾಮಕೃಷ್ಣರನ್ನು ಕರೆತರಲು ಈ ಯಾದವನನ್ನು ಕಳುಹಿಸಿದನು. ಈ ಅಕ್ರೂರನು ಪರಮಾತ್ಮನ ಅಂಶದಿಂದ ಅವತರಿಸಿರುವ ಶ್ರೀಕೃಷ್ಣನನ್ನು ಮನಸ್ಸಿನಲ್ಲೇ ಧ್ಯಾನಮಾಡುತ್ತಾ ಭಕ್ತಿಯಿಂದ ಶ್ರೀಕೃಷ್ಣನನ್ನು ಸಂದರ್ಶಿಸಲು ರಾತ್ರಿ ರಥವನ್ನು ಏರಿ ಹೊರಟು ಪ್ರಾತಃಕಾಲವೇ ನಂದಗೋಕುಲಕ್ಕೆ ಬಂದನು. ಅಲ್ಲಿ ಗೋವುಗಳನ್ನು ಕರೆಯುತ್ತಾ ಅವುಗಳ ಮಧ್ಯೆ ನಿಂತಿದ್ದ ಶ್ರೀಕೃಷ್ಣನನ್ನೂ ಬಲರಾಮನನ್ನೂ ಕಂಡು ನಮಸ್ಕರಿಸಿ ಅವರಿಂದ ಯಥೋಚಿತವಾದ ಸತ್ಕಾರವನ್ನು ಹೊಂದಿ ತಾನು ಬಂದ ಕಾರ್ಯವನ್ನು ವಿವರವಾಗಿ ತಿಳಿಸಿದನು. ಅನಂತರ ಅವರ ಅಪ್ಪಣೆ ಪಡೆದು ಅವರನ್ನು ರಥದಲ್ಲಿ ಕುಳ್ಳಿರಿಸಿ ತಾನು ರಥವನ್ನು ಬಿಡುತ್ತಾ ಬರುತ್ತಿರುವಾಗ ಯಮುನಾತೀರದಲ್ಲಿ ಮಧ್ಯಾಹ್ನಿಕಕ್ಕಾಗಿ ಅವರ ಅನುಮತಿಹೊಂದಿ ಅವರನ್ನು ರಥದಲ್ಲೇ ಕುಳ್ಳಿರಿಸಿ ತಾನು ಯಮುನಾ ಜಲದಲ್ಲಿಳಿದು ಸ್ನಾನಮಾಡುತ್ತಿರುವಾಗ ನೀರಿನೊಳಗೆ ರಾಮಕೃಷ್ಣರಿಬ್ಬರನ್ನೂ ನೋಡುವನು. ರಥದಲ್ಲಿದ್ದವರು ಇಲ್ಲಿಗೆ ಬರಲು ಕಾರಣವೇನೆಂದು ಆಶ್ಚರ್ಯದಿಂದ ರಥದ ಹತ್ತಿರಕ್ಕೆ ಬಂದು ನೋಡಲು ರಾಮಕೃಷ್ಣರಿಬ್ಬರೂ ಅಲ್ಲೇ ಕುಳಿತಿದ್ದರು. ಪುನಃ ನೀರಿನಲ್ಲಿಳಿದು ಸ್ನಾನಮಾಡುತ್ತಿದ್ದಾಗ ಶ್ರೀಕೃಷ್ಣನು ತನ್ನ ದಿವ್ಯರೂಪವನ್ನು ತೋರಿಸಲು ನಿಜವಾಗಿಯೂ ಇವರು ಪರಮಾತ್ಮನ ಅವತಾರವೆಂದು ಅವರನ್ನು ಬಹಳವಾಗಿ ಸ್ತೋತ್ರಮಾಡಿ ಪೂಜಿಸಿ ಸಾಯಂಕಾಲದೊಳಗೆ ಮಧುರೆಯನ್ನು ತಲುಪಿ ಊರಹೊರಗೆ ಅವರನ್ನು ಇಳಿಸಿ ಅವರ ಅಪ್ಪಣೆಯಂತೆ ನಗರವನ್ನು ಪ್ರವೇಶಿಸುವನು."}, {"gloss": "ಕ್ರೂರನಲ್ಲದ / ಸರಳನಾದ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "etymology": "न क्रूरः ।"}]}], "akroDa": [{"id": "akroDa", "headword": "अक्रोध", "headword_slp1": "akroDa", "fold": "akroDa", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಕೋಪವಿಲ್ಲದಿರುವಿಕೆ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "etymology": "न क्रोधः ।"}, {"gloss": "ಕೋಪವಿಲ್ಲದ / ಶಾಂತನಾದ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "etymology": "न क्रोधो यस्य ।"}]}], "akroDana": [{"id": "akroDana", "headword": "अक्रोधन", "headword_slp1": "akroDana", "fold": "akroDana", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಒಬ್ಬ ರಾಜಕುಮಾರ / ಅಯುತಾಯುವಿನ ಮಗ", "gloss_la