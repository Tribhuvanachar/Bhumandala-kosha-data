{"aye": [{"id": "aye", "headword": "अये", "headword_slp1": "aye", "fold": "aye", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಸಂಭ್ರಮ", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ಆಶ್ಚರ್ಯ", "gloss_language": "kn", "pos": "अव्ययम्", "citations": [{"text": "\"अये, कथमार्यः पाञ्चाल्याः चतुःशालकं प्रति प्रस्थितः\""}, {"text": "वेणी०"}]}, {"gloss": "ಕೋಪ", "gloss_language": "kn", "pos": "अव्ययम्", "citations": [{"text": "\"अये, अश्वमेध इति विश्वजयिनां क्षत्रियाणां माहनुत्कर्षनिकर्षः\""}, {"text": "उ० रा० ४"}]}, {"gloss": "ಸ್ಮರಣೆ /ನೆನಪು", "gloss_language": "kn", "pos": "अव्ययम्", "citations": [{"text": "\"अये, कुसुमपुरवृत्तान्तज्ञः अहं भवत्प्रणिधिश्चेति गतार्थः\""}, {"text": "मुद्रा० २"}]}, {"gloss": "ಭಯ", "gloss_language": "kn", "pos": "अव्ययम्", "citations": [{"text": "\"अये, तत्कथं सत्यमेव कुपित आर्यः\""}, {"text": "मुद्रा० ३"}]}, {"gloss": "ಸಂಬೋಧನೆ", "gloss_language": "kn", "pos": "अव्ययम्", "citations": [{"text": "\"अये, कले, भद्रमव्याहतम्\""}, {"text": "प्रबोध० २"}]}, {"gloss": "ದುಃಖ", "gloss_language": "kn", "pos": "अव्ययम्", "citations": [{"text": "\"अये, देवपादपद्मोपजीविनोऽवस्थेयम्\""}, {"text": "मुद्रा० २"}], "note": "\"अये क्रोधविषादयोः । सम्भ्रमे स्मरणे च\" - हेम० ।"}]}]}