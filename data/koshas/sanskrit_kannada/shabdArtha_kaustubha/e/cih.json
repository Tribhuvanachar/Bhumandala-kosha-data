{"cihna": [{"id": "cihna", "headword": "चिह्न", "headword_slp1": "cihna", "fold": "cihna", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಲಕ್ಷಣ /ಗುರುತು", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "etymology": "चह्यतेऽनेन; निष्पत्तिः: चह (परिकल्पने) - \"नक्\" इत्वं च बाहु० ।", "citations": [{"text": "\"एतद् भुजारणिसमुद्भवविक्रमाग्निचिह्नं धनुर्गुणकिणः खलु धूमलेखा\""}, {"text": "नैष० ११-१०५"}]}, {"gloss": "ಮುದ್ರೆ", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः"}, {"gloss": "ಲಾಂಛನ /ಗುರುತು /ನಿಶಾನಿ", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "citations": [{"text": "\"स न्यस्यचिह्नामपि राजलक्ष्मीं तेजोविशेषानिमितां दधानः\" ।\"दूरस्थचिह्नवेधादुदयेऽस्तमयेऽपि वा सहस्रांशोः\" ।"}, {"text": "रघु० २-७, बृहत्सं० ३-३"}]}, {"gloss": "ಕುರುಹು /ಸುಳಿವು", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः"}, {"gloss": "ಪತಾಕೆ /ಧ್ವಜ", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "note": "\"चिह्नपङ्के पताकायाम्\"- नानार्थर० ।"}]}], "cihnakarin": [{"id": "cihnakArin", "headword": "चिह्नकारिन्", "headword_slp1": "cihnakArin", "fold": "cihnakarin", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಗುರುತು ಹಾಕುವವನು", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्"}, {"gloss": "ಮುದ್ರೆ ಹಾಕುವವನು", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्"}]}], "cihnayitavya": [{"id": "cihnayitavya", "headword": "चिह्नयितव्य", "headword_slp1": "cihnayitavya", "fold": "cihnayitavya", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಮುದ್ರೆ ಹಾಕಲ್ಪಡುವ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्"}, {"gloss": "ಗುರುತು ಮಾಡಲ್ಪಡುವ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "citations": [{"text": "\"लिङ्गं वा प्रतिमा द्रुमवत् स्थाप्या यथादिशं यस्मात् । तस्माच्चिह्नयितव्या दिशो द्रुमस्योर्ध्वमथवाधः ॥\""}, {"text": "ब्ऋहत्सं० ५९-७"}]}]}], "cihnita": [{"id": "cihnita", "headword": "चिह्नित", "headword_slp1": "cihnita", "fold": "cihnita", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಚಿಹ್ನೆ ಮಾಡಲ್ಪಟ್ಟ /ಗುರುತು ಹಾಕಲ್ಪಟ್ಟ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्"}, {"gloss": "ಮುದ್ರೆ ಹಾಕಲ್ಪಟ್ಟ", "gloss_language": "kn", "pos": "विशेष्यनिघ्नम्", "etymology": "निष्पत्तिः: चिह्न (लक्षणे)- \"क्तः\" (३-२-१०२)", "citations": [{"text": "\"दिवा चरेयुः कार्यार्थं चिह्निता राजशासनैः\""}, {"text": "मनु० १०-५५"}]}]}], "cihnana": [{"id": "cihnana", "headword": "चिह्नन", "headword_slp1": "cihnana", "fold": "cihnana", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಗುರುತು ಮಾಡುವುದು", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः"}, {"gloss": "ಮುದ್ರೆ ಹಾಕುವುದು", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः"}, {"gloss": "ಅಲಂಕಾರಾದಿಗಳಿಂದ ಶೃಂಗರಿಸುವುದು", "gloss_language": "kn", "pos": "नपुंसकलिङ्गः", "citations": [{"text": "\"स्फुटं चलच्चामरयुग्मचिह्ननैरनिह्नवानं निजवाजिराजताम्\""}, {"text": "नैष० १-६२"}]}]}]}