{"E": [{"id": "E", "headword": "ऐ", "headword_slp1": "E", "fold": "E", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಐಕಾರ", "gloss_language": "kn", "note": "ಇದು ಕಂಠ ಮತ್ತು ತಾಲುಸ್ಥಾನಗಳಲ್ಲಿ ವಿವೃತಪ್ರಯತ್ನದಿಂದ ಹುಟ್ಟುವ ಒಂದು ಸ್ವರವರ್ಣ. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ವರ್ಣವು ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು."}, {"gloss": "ದಿಕ್ಕು", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಹಸ್ತ /ಕೈ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಶಿವ /ಈಶ್ವರ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಪರ್ವತದ ಶಿಖರ /ಬೆಟ್ಟದ ತುದಿ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಚರ್ಮ /ತೊಗಲು", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "note": "\"ऐकारो दिङ्मुखे हस्ते हरेऽद्रिशिखरे त्वचि\" - नानार्थर० ।"}, {"gloss": "ಆಹ್ವಾನ /ಕರೆ", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ಸ್ಮೃತಿ /ನೆನಪು", "gloss_language": "kn", "pos": "अव्ययम्"}, {"gloss": "ಸಂಬೋಧನೆ", "gloss_language": "kn", "pos": "अव्ययम्", "note": "\"ऐ शब्दो दृश्यते हूतौ स्मृत्यामन्त्रणयोरपि\" - मेदि० ।"}]}]}