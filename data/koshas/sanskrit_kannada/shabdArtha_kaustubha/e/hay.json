टश्च योगम् परममास्थितः। ततस्तावसुरौ कृत्वा वेदान् समयबन्धानात्॥ रसातले विनिक्षिप्य यतः शब्दस्ततो गतौ। एतस्मिन्नन्तरे राजन् देवो हयशिरोधरः। जग्राह वेदानखिलान् रसातलगतान् हरिः। प्रादच्च ब्रह्मणे भूयः ततः स्वां प्रकृतिमाग्तः॥\" - भा० शान्ति० ३४७"}, {"gloss": "ಒಬ್ಬ ರಾಕ್ಷಸ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}, {"gloss": "ಒಬ್ಬ ದೊರೆ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}]}, {"id": "hayagrIvA", "headword": "हयग्रीवा", "headword_slp1": "hayagrIvA", "fold": "hayagriva", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ದುರ್ಗಾದೇವಿ", "gloss_language": "kn", "pos": "स्त्रीलिङ्गः"}]}], "hayaNkasa": [{"id": "hayaNkaza", "headword": "हयङ्कष", "headword_slp1": "hayaNkaza", "fold": "hayaNkasa", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಮಾತಲಿ /ಇಂದ್ರನ ಸಾರಥಿ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "etymology": "हयमुच्चैःश्रवसं कषति; निष्पत्तिः: कष (हिंसायाम्) \"खच्\" बाहु०", "note": "\"मातलिस्तु हयङ्कषः\" त्रिकाण्ड०"}]}], "hayadvisat": [{"id": "hayadvizat", "headword": "हयद्विषत्", "headword_slp1": "hayadvizat", "fold": "hayadvisat", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಮೈಷ /ಎಮ್ಮೆ", "gloss_language": "kn", "pos": "पुल्लिङ्गः"}]}], "hayapucCi": [{"id": "hayapucCI", "headword": "हयपुच्छी", "headword_slp1": "hayapucCI", "fold": "hayapucCi", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಮಾಷಪರ್ಣೀಲತೆ /ಕಾಡುದ್ದಿನ ಗಿಡ", "gloss_language": "kn", "pos": "स्त्रीलिङ्गः", "etymology": "हयस्य पुच्छमिव आकारोऽस्याः"}]}], "hayapriya": [{"id": "hayapriya", "headword": "हयप्रिय", "headword_slp1": "hayapriya", "fold": "hayapriya", "headword_language": "sa", "source": "shabdArtha_kaustubha", "senses": [{"gloss": "ಜವೆ /ಯವಧಾನ್ಯ", "gloss_language": "kn", "pos": "पुल्लिङ्गः", "etymology": "हयस्य प्रियः"}]}, {"id": "hayapriyA", "headword": "हयप्रिया", "headword_slp1": "hayapriyA", "fold": "hayapriya", "headword_language": "sa", "source