. (freedom)","spans":[{"t":"txt","s":"from the crowd, AV. xii, 1, 2 (v.l. मध्य-त॑स्)."}]}]}],"baDira":[{"id":"baDira","headword":"बधिर","headword_slp1":"baDira","senses_r":[{"n":1,"spans":[{"t":"txt","s":"&c. See col. 3."}]},{"n":2,"spans":[{"t":"txt","s":"mf(आ)n. (sometimes written वधिर) deaf, RV. &c. &c."}]},{"n":3,"pos":"m.","spans":[{"t":"txt","s":"N. of a serpent-demon (son of Kaśyapa), MBh."}]}]}],"baDu":[{"id":"baDU","headword":"बधू","headword_slp1":"baDU","senses_r":[{"n":1,"pos":"f.","spans":[{"t":"txt","s":"wrongly for वधू॑, AV. viii, 6, 14."}]}]}],"baDyoga":[{"id":"baDyoga","headword":"बध्योग","headword_slp1":"baDyoga","senses_r":[{"n":1,"pos":"m.","spans":[{"t":"txt","s":"N. of a man g. बिदादि (cf. बाध्योग)."}]}]},{"id":"bADyoga","headword":"बाध्योग","headword_slp1":"bADyoga","senses_r":[{"n":1,"spans":[{"t":"txt","s":"(ŚBr.), बाध्यौग (Kāś. on Pāṇ. vii, 3, 20) patr. fr. बध्योग."}]}]}],"baDva":[{"id":"baDva","headword":"बध्व","headword_slp1":"baDva","senses_r":[{"n":1,"pos":"m.","spans":[{"t":"txt","s":"N. of a man, AitĀr. (cf. बाध्व)."}]}]},{"id":"bADva","headword":"बाध्व","headword_slp1":"bADva","senses_r":[{"n":1,"pos":"m.","spans":[{"t":"txt","s":"patr. N. of a Ṛṣi, AitĀr. (w.r. बाध्या)."}]}]}],"baDiratama":[{"id":"baDiratama","headword":"बधिरतम","headword_slp1":"baDiratama","senses_r":[{"n":1,"spans":[{"t":"txt","s":"बधिर—तम mfn. quite deaf, Kāv."}]}]}],"baDirata":[{"id":"baDiratA","headword":"बधिरता","headword_slp1":"baDiratA","senses_r":[{"n":1,"spans":[{"t":"txt","s":"बधिर—ता f."}]}]}],"baDiratva":[{"id":"baDiratva","headword":"बधिरत्व","headword_slp1":"baDiratva","senses_r":[{"n":1,"spans":[{"t":"txt","s":"बधिर—त्व n. deafness, ib."}]}]}],"baDiranDa":[{"id":"baDirAnDa","headword":"बधिरान्ध","headword_slp1":"baDirAnDa","senses_r":[{"n":1,"pos":"m.","spans":[{"t":"txt","s":"‘deaf and blind’, N. of a serpent-demon, MBh. (cf. above)."}]}]}],"baDiraka":[{"id":"baDiraka","headword":"बधिरक","headword_slp1":"baDiraka","senses_r":[{"n":1,"pos":"m.","spans