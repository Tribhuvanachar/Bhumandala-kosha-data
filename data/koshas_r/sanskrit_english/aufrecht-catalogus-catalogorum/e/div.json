{"divirakisoraka":[{"id":"divirakiSoraka","headword":"दिविरकिशोरक","headword_slp1":"divirakiSoraka","senses_r":[{"n":1,"spans":[{"t":"txt","s":"किशोरक and दिविरकिशोरक poet. Sbhv."}]}]}],"divakara":[{"id":"divAkara","headword":"दिवाकर","headword_slp1":"divAkara","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवाकर See Dinakara, Siddhasenadivākara."}]},{"n":2,"spans":[{"t":"txt","s":"दिवाकर inhabitant of Jambūsaronagara, father of Go-\nvardhana, grandfather of Gaṅgādhara (Gaṇitāmṛta-\nsāgarī). "},{"t":"cite","s":"L. 1254","q":"L"},{"t":"txt","s":"."}]},{"n":3,"spans":[{"t":"txt","s":"दिवाकर father of Bhāskara (Śivasūtravārttika). Report\nCLXVIII."}]},{"n":4,"spans":[{"t":"txt","s":"दिवाकर father of Lolimbarāja."}]},{"n":5,"spans":[{"t":"txt","s":"दिवाकर poet. Padyāvalī. Compare Gotithīyadivākara,\nMataṅgadivākara, Yuvarājadivākara."}]},{"n":6,"spans":[{"t":"txt","s":"Vṛttaratnākaraṭīkā. Quoted by Mallinātha on\nŚiśupālavadha 1, 2."}]},{"n":7,"spans":[{"t":"txt","s":"दिवाकर son of Dinakara (?):\n Dānadinakara. "},{"t":"cite","s":"K. 180","q":"K"},{"t":"txt","s":"."}]},{"n":8,"spans":[{"t":"txt","s":"दिवाकर or दिनकर son of Nṛsiṃha, grandson of Kṛṣṇa\nDaivajña:\n Gaṇitatattva, Gaṇitatattvacintāmaṇi, Tattvacintā-\nmaṇi jy.\n Janmapaddhati or Jātakapaddhati.\n Jātakapaddhatiprakāśa.\n Padmajātaka.\n Prauḍhamanoramā Keśavapaddhatiṭīkā.\n Makarandavivaraṇa.\n Varṣagaṇitapaddhati Rathoddhatā.\n Varṣatantra.\n Varṣaphalapaddhati.\n Śrīpatiprakāśa.\n Divākarī. Oudh VIII, 14. C. Mañjubhāṣiṇī.\nOudh VII, 4."}]},{"n":9,"spans":[{"t":"txt","s":"दिवाकर son of Mahādeva:\n Dharmaśāstrasudhānidhi. read Dānahīrāvalī.\n Saptapākasaṃsthāvidhi."}]},{"n":10,"spans":[{"t":"txt","s":"दिवाकर or दिनकर son of Nṛsiṃha, grandson of Kṛṣṇa\nDaivajña, great grandson of Divākara, nephew of Śiva:\n Gaṇitāmṛtasāraṇī.\n Gopālapaddhati (?).\n Gopirājamatakhaṇḍana jy., composed in 1627.\n Jātakapaddhatyudāharaṇa.\n Makarandavivaraṇa and udāharaṇa.\n Rāmavinodaprakāśapaddhati jy."}]}]}],"divakaraBawa":[{"id":"divAkaraBawwa","headword":"दिवाकरभट्ट","headword_slp1":"divAkaraBawwa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवाकर भट्ट father of Kullūka."}]},{"n":2,"spans":[{"t":"txt","s":"दिवाकर भट्ट son of Rāmakṛṣṇa. See Dinakara."}]},{"n":3,"spans":[{"t":"txt","s":"दिवाकर भट्ट son of Gaṅgā and Mahādeva Bhaṭṭa, son\nof Bālakṛṣṇa Bhaṭṭa, son of Mahādeva Bhaṭṭa, son\nof Nārāyaṇa Bhaṭṭa, who, with Raghunātha Bhaṭṭa,\nwas son of Mādhava Bhaṭṭa, son of Rāmakṛṣṇa\nBhaṭṭa. Divākara's mother was daughter of Nīla-\nkaṇṭha Bhaṭṭa, son of Śaṅkara Bhaṭṭa, son of Nārā-\nyaṇa Bhaṭṭa, son of Rāmeśvara Bhaṭṭa. He was\nfather of Vaidyanātha. Hall p. 175:\n Dharmaśāstrasudhānidhi, written in 1683. Hall\np. 175. The Ācārārka, Tithyarka or Tithyarka-\nprakāśa, Dānahārāvalī, Prāyaścittamuktāvalī,\nŚrāddhacandrikā, and several of the following\ntreatises are parts of it.\n Ācārārka q. v.\n Āhnikacandrikā. "},{"t":"cite","s":"Khn. 70","q":"Khn"},{"t":"txt","s":". "},{"t":"cite","s":"Bik. 354","q":"Bik"},{"t":"txt","s":". Burnell\n136^a. Oppert II, 7496. Rice 194.\n Saṃkṣepāhnikacandrikā. "},{"t":"cite","s":"Peters. 1, 120","q":"Peters"},{"t":"txt","s":".\n Kālanirṇayacandrikā.\n Dānacandrikā and Dānasaṃkṣepacandrikā.\n Dānahārāvalī.\n Patitatyāgavidhi. "},{"t":"cite","s":"Ben. 147","q":"Ben"},{"t":"txt","s":".\n Punarupanayanaprayoga. "},{"t":"cite","s":"Ben. 147","q":"Ben"},{"t":"txt","s":".\n Prāyaścittacandrikā. "},{"t":"cite","s":"Khn. 76","q":"Khn"},{"t":"txt","s":".\n[]\n Prāyaścittamuktāvalī and Prāyaścittamuktāvalī-\nprakāśa.\n Mantramārtaṇḍa. Quoted in Ācārārka.\n Vṛttaratnākarādarśa, written in 1684.\n Śrāddhacandrikā.\n Sūryādipañcāyatanapratiṣṭhāpaddhati.\n Sūryādipratimāpratiṣṭhāvidhi.\n Smārtaprāyaścittapaddhati.\n Smārtaprāyaścittoddhāra."}]},{"n":4,"spans":[{"t":"txt","s":"दिवाकर भट्ट Kālopanāmaka, son of Mahādeva, grandson\nof Rāmeśvara:\n Dānacandrikā.\n Smārtaprāyaścitta\n.--This Divākara was on\nmother's side a relative of Divākara, the son\nof Mahādeva and grandson of Bālakṛṣṇa."}]}]}],"divakaradata":[{"id":"divAkaradatta","headword":"दिवाकरदत्त","headword_slp1":"divAkaradatta","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवाकरदत्त poet. Skm."}]}]}],"divakarapadDati":[{"id":"divAkarapadDati","headword":"दिवाकरपद्धति","headword_slp1":"divAkarapadDati","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवाकरपद्धति jy. by Divākara. Oppert II, 1972."}]},{"n":2,"spans":[{"t":"txt","s":"दिवाकरपद्धति jy. by Divākara. AK 867."}]}]}],"divakarapurusotama":[{"id":"divAkarapuruzottama","headword":"दिवाकरपुरुषोत्तम","headword_slp1":"divAkarapuruzottama","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवाकरपुरुषोत्तम patron of Kṛṣṇadatta (Purañjanacarita).\n"},{"t":"cite","s":"L. 2000","q":"L"},{"t":"txt","s":"."}]}]}],"divakaravatsa":[{"id":"divAkaravatsa","headword":"दिवाकरवत्स","headword_slp1":"divAkaravatsa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"Kakṣyāmālāstotra. Oppert 1209\n Vivekāñjana. Quoted by Abhinavagupta in Īśvara-\npratyabhijñāsūtravimarśinīvṛtti."}]}]}],"divakarodyota":[{"id":"divAkaroddyota","headword":"दिवाकरोद्द्योत","headword_slp1":"divAkaroddyota","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवाकरोद्द्योत See Dinakaroddyota. Quoted in Dravya-\nśuddhidīpikā "},{"t":"cite","s":"Oxf. 274","q":"Oxf"},{"t":"txt","s":"^a."}]}]}],"divanacandra":[{"id":"divAnacandra","headword":"दिवानचन्द्र","headword_slp1":"divAnacandra","senses_r":[{"n":1,"spans":[{"t":"txt","s":"Sarvārthacintāmaṇi jy. "},{"t":"cite","s":"B. 4, 204","q":"B"},{"t":"txt","s":"."}]},{"n":2,"spans":[{"t":"txt","s":"दिवानचन्द्र the author of the Sarvārthacintāmaṇi, was\nfather of Rāmakṛṣṇa (Sarvārthacintāmaṇiṭīkā)."}]}]}],"divanandiya":[{"id":"divAnandIya","headword":"दिवानन्दीय","headword_slp1":"divAnandIya","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिवानन्दीय ny. by Divānanda. Oppert II, 2829."}]}]}],"divirakisora":[{"id":"divirakiSora","headword":"दिविरकिशोर","headword_slp1":"divirakiSora","senses_r":[{"n":1,"spans":[{"t":"txt","s":"दिविरकिशोर poet. Śp. p. 35."}]}]}],"