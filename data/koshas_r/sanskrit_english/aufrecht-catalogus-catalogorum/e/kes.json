. "},{"t":"cite","s":"Bik. 440","q":"Bik"},{"t":"txt","s":".\n Keśavadīkṣitīya dh. Oppert II, 5178."}]},{"n":2,"spans":[{"t":"txt","s":"केशव दीक्षित son of Viṭṭhala Dīkṣita:\n Kratupaddhati."}]}]}],"kesavakoRiyanaToka":[{"id":"keSavakoRIyanAToka","headword":"केशवकोणीयनाथोक","headword_slp1":"keSavakoRIyanAToka","senses_r":[{"n":1,"spans":[{"t":"txt","s":"केशवकोणीयनाथोक poet. Skm."}]}]}],"kesavacarita":[{"id":"keSavacarita","headword":"केशवचरित","headword_slp1":"keSavacarita","senses_r":[{"n":1,"spans":[{"t":"txt","s":"केशवचरित Nimbārka sect. Rādh 21. Oudh XVII, 86."}]},{"n":2,"spans":[{"t":"txt","s":"केशवचरित Nimbārka sect. "},{"t":"cite","s":"Devīpr. 79, 40","q":"Devīpr"},{"t":"txt","s":"."}]}]}],"kesavacaritra":[{"id":"keSavacaritra","headword":"केशवचरित्र","headword_slp1":"keSavacaritra","senses_r":[{"n":1,"spans":[{"t":"txt","s":"केशवचरित्र a poem, describing the life of Keśavadeva,\nking of Multan, father of Tārācandra, by Vaidyanātha\nMaithila. Lahore 4."}]}]}],"kesavaCatrin":[{"id":"keSavaCattrin","headword":"केशवछत्त्रिन्","headword_slp1":"keSavaCattrin","senses_r":[{"n":1,"spans":[{"t":"txt","s":"केशवछत्त्रिन् poet. Padyāvalī."}]}]}],"kesavajivanandasarman":[{"id":"keSavajIvAnandaSarman","headword":"केशवजीवानन्दशर्मन्","headword_slp1":"keSavajIvAnandaSarman","senses_r":[{"n":1,"spans":[{"t":"txt","s":"केशवजीवानन्द शर्मन्\n Śrāddhakārikā. W. p. 34."}]}]}],"kesavadata":[{"id":"keSavadatta","headword":"केशवदत्त","headword_slp1":"keSavadatta","senses_r":[{"n":1,"spans":[{"t":"txt","s":"Praśnamañjūṣā Bhāgavatapurāṇaṭīkā. Oudh IV, 9."}]}]}],"kesavadasaKusali":[{"id":"keSavadAsaKuSAlI","headword":"केशवदासखुशाली","headword_slp1":"keSavadAsaKuSAlI","senses_r":[{"n":1,"spans":[{"t":"txt","s":"केशवदास खुशाली with the surname Rāmarāya, son of\nJīvanarāma, brother of Lakṣmīnātha:\n Ahalyākāmadhenu dh. NP. V, 58.\n C. on Śrīdhara's Bhāgavatabhāvārthadīpikā. Quoted\nin the preceding work."}]}]}],"kesavadevasarman":[{"id":"keSavadevaSarman","headword":"केशवदेवशर्मन्","headw