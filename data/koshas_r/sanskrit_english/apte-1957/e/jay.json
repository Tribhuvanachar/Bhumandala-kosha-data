,"jayantiH":[{"id":"jayantiH","headword":"जयन्तिः","headword_slp1":"jayantiH","senses_r":[{"n":1,"spans":[{"t":"txt","s":"(-न्ती)\n A synonym of the balance-post; तुलादण्डो जयन्ती च फलकाः\n पर्यायवाचकाः "},{"t":"cite","s":"Māna. 16. 48","q":"Māna"},{"t":"txt","s":"."}]}]}],"jayadraTaH":[{"id":"jayadraTaH","headword":"जयद्रथः","headword_slp1":"jayadraTaH","senses_r":[{"n":1,"spans":[{"t":"txt","s":"A king of the Sindhu district and brother-in-law of Duryodhana,\n having married Duhśalā, daughter of Dhṛtarāṣṭra. [Once while out\n on hunting, he chanced to see Draupadī in the forest, and asked of her\n food for himself and his retinue. Draupadī, by virtue of her magical\n sthālī, was able to supply him with materials sufficient for their break-fast.\n Jayadratha was so much struck with this act, as well as her personal charms,\n that he asked her to elope with him. She, of course, indignantly refused,\n but he succeeded in carrying her off, as her husbands were out on hunting.\n When they returned they pursued and captured the ravisher and released\n Draupadī; and he himself was allowed to go after having been subjected\n to many humiliations. He took a leading part in compassing the death of\n Abhimanyu, and met his doom at the hands of Arjuna in the great war.]"}]}]}],"jaya":[{"id":"jayA","headword":"जया","headword_slp1":"jayA","senses_r":[{"n":1,"pos":"f.","spans":[{"t":"txt","s":"The name of a magical lore (often mentioned with विजया)\n taught by Viśvāmitra to Rāma, विद्यामथैनं विजयां जयां च "},{"t":"cite","s":"Bk. 2. 21","q":"Bk"},{"t":"txt","s":"."}]},{"n":2,"subs":[{"n":"1","spans":[{"t":"txt","s":"N. of Durgā."}]},{"n":"2","spans":[{"t":"txt","s":"N. of an attendant of the goddess Durgā."}]},{"n":"3","spans":[{"t":"txt","s":"A kind of banner."}]},{"n":"4","spans":[{"t":"txt","s":"The third, eighth or thirteenth lunar days of any of the two lunar fortnights.\n.━{@Comp.@}: जयाजयौ, जयावह, जयाशिस्, जयोदधुर, जयकुञ्जरः, जयकोलाहलः, जयगत,^1 जयघोषः, जयघोषणम्, जयघोषणा, ज