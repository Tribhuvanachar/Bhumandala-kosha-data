{"Opakaryam":[{"id":"OpakAryam","headword":"औपकार्यम्","headword_slp1":"OpakAryam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ஔபகார்யம் : இருப்பிடம், வசிக்கும் இடம், கூடாரம்."}]}]}],"Opanisata":[{"id":"Opanizata","headword":"औपनिषत","headword_slp1":"Opanizata","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ஔபநிஷத : உபநிஷதங்களில் போதிக்கப்பட்ட, வேதங்களில் விதிக்கப்பட்ட, ஆன்மீகமான."}]}]}],"OpasanaH":[{"id":"OpAsanaH","headword":"औपासनः","headword_slp1":"OpAsanaH","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ஔபாஸந: : க்ருஹஸ்தன் தன் வீட்டில் வணங்கும் புனித அக்னி."}]}]}],"Opamyam":[{"id":"Opamyam","headword":"औपम्यम्","headword_slp1":"Opamyam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ஔபம்யம் : சமநிலை, ஒப்பு, ஒன்று போன்ற தோற்றம்."}]}]}]}