{"fRa":[{"id":"fRa","headword":"ऋण","headword_slp1":"fRa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ऋण꣫\n— 1〉 Adj. (f. आ꣫) schuldig.\n— 2〉 n.\n — a〉 Verschuldung, Verpflichtung, Schuldigkeit, Schuld, Geldschuld. Unter drei Verpflichtungen sind die gegen die Ṛṣi, Götter und Manen gemeint. Die vierte ist die gegen die Menschen, die fünfte die gegen die Gäste. अन्त्य Die letzte Verpflichtung ist die gegen die [] Manen, d. i. die Erzeugung eines Sohnes. ऋणं धारय् Jmd (Gen.) Etwas schuldig sein; कर् eine Schuld machen, borgen von (Abl.); प्र-यम् und नी eine Schuld abtragen; दा dass. und Jmd (Loc.) borgen; प्र-आप् eine Schuld auf sich laden; परि-ईप्स् eine Schukd einfordern; मृगय्, याच् um ein Darlehn bitten.\n — b〉 eine negative Grösse.\n — c〉 *Wasser.\n — d〉 *Burg, Feste."}]},{"n":2,"spans":[{"t":"txt","s":"ऋण 2〉c〉 d〉 vgl. ZACH. "},{"t":"cite","s":"Beitr. 33","q":"Beitr"},{"t":"txt","s":"."}]},{"n":3,"spans":[{"t":"txt","s":"ऋण "},{"t":"cite","s":"I. 5","q":""},{"t":"txt","s":"."}]}]}],"fRakartar":[{"id":"fRakartar","headword":"ऋणकर्तर्","headword_slp1":"fRakartar","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ऋणकर्तर् Nom. ag. Schulden machend "},{"t":"cite","s":"MBH. 13,23,21","q":"MBH"},{"t":"txt","s":". "},{"t":"cite","s":"Spr. 1330","q":"Spr"},{"t":"txt","s":"."}]}]}],"fRakati":[{"id":"fRakAti","headword":"ऋणकाति","headword_slp1":"fRakAti","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ऋण꣫काति Adj. Schuld rächend."}]}]}],"fRagraha":[{"id":"fRagraha","headword":"ऋणग्रह","headword_slp1":"fRagraha","senses_r":[{"n":1,"spans":[{"t":"txt","s":"*ऋणग्रह\n— 1〉 Adj. Schulden machend.\n— 2〉 m. das Schuldenmachen."}]}]}],"fRagrahaRa":[{"id":"fRagrAhaRa","headword":"ऋणग्राहण","headword_slp1":"fRagrAhaRa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"*ऋणग्राहण n. das Eintreiben einer Schuld."}]}]}],"fRagrahin":[{"id":"fRagrAhin","headword":"ऋणग्राहिन्","headword_slp1":"fRagrAhin","senses_r":[{"n":1,"spans":[{"t":"txt","s":"*ऋणग्राहिन् Adj. Schulden machend."}]}]}],"fRacit":[{"id":"f