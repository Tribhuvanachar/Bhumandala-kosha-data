ürdevolle Erscheinung, eine bedeutende Persönlichkeit.\n— 9〉 der männliche Same.\n— 10〉 in der Philosophie = रजस् die den Geist verdüsternde Leidenschaftlichkeit; vgl. तैजस 1〉d〉.\n— 11〉 *Mark.\n— 12〉 *Galle "},{"t":"cite","s":"RĀJAN. 21,5","q":"RĀJAN"},{"t":"txt","s":".\n— 13〉 *frische Butter.\n— 14〉 *Gold "},{"t":"cite","s":"RĀJAN. 13,9","q":"RĀJAN"},{"t":"txt","s":".\n— 15〉 mystische Bez. des lautes र.\n— 16〉 ते꣫जसे Dat. Inf. zu तिज् Ṛ"},{"t":"cite","s":"V. 1,55,1. 3,2,10","q":""},{"t":"txt","s":"."}]}]}],"tejasa":[{"id":"tejasa","headword":"तेजस","headword_slp1":"tejasa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"˚तेजस n. = तेजस् 7〉 oder 8〉."}]}]}],"tejasamaDisa":[{"id":"tejasAmaDISa","headword":"तेजसामधीश","headword_slp1":"tejasAmaDISa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तेजसामधीश m. die Sonne "},{"t":"cite","s":"HARṢAC. 139,9","q":"HARṢAC"},{"t":"txt","s":"."}]}]}],"tejasinha":[{"id":"tejasiMha","headword":"तेजसिंह","headword_slp1":"tejasiMha","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तेजसिंह m. N. pr. eines Mannes."}]}]}],"tejaskara":[{"id":"tejaskara","headword":"तेजस्कर","headword_slp1":"tejaskara","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तेजस्कर Adj. Kraft —, Lebenskraft u. s. w. verleihend."}]}]}],"tejaskama":[{"id":"tejaskAma","headword":"तेजस्काम","headword_slp1":"tejaskAma","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ते꣫जस्काम Adj.\n— 1〉 nach Kraft, nach Lebenskraft strebend.\n— 2〉 nach Einfluss, Ansehen, Wirksamkeit, Hoheit strebend."}]}]}],"tejaskaya":[{"id":"tejaskAya","headword":"तेजस्काय","headword_slp1":"tejaskAya","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तेजस्काय Adj. dessen Körper Licht ist ĀPAST."}]}]}],"tejastva":[{"id":"tejastva","headword":"तेजस्त्व","headword_slp1":"tejastva","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तेजस्त्व n.\n— 1〉 das Wesen des Feuers oder Lichts.\n— 2〉 der Gattungsbegriff तेजस्."}]}]}],"tejaspada":[{"id":"tejaspada","headword":"तेजस्पद","headword_slp1":"tejaspada","senses_r":[{"n":1,"spans":[{"t":"t