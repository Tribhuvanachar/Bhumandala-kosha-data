{"asrayasa":[{"id":"ASrayASa","headword":"आश्रयाश","headword_slp1":"ASrayASa","senses_r":[{"n":1,"spans":[{"t":"txt","s":"आश्रयाश;\nसप्तार्चिर्बहुलः शिखी हुतवहो वैश्वानरोऽग्निर्वसु-\nर्वह्निर्वायुसखः सितेतरगतिः स्वाहाप्रियः पावकः ।\nअर्चिष्मान् ज्वलनः कृशानुरनलो धूमध्वजो हव्यवाट्,\nबर्हिर्ज्योतिरुषर्बुधश्च दहनः स्याच्चित्रभानुः शुचिः ॥ ६२ ॥\nकृपीटयोनिर्दमुनाः कृष्णवर्त्माशुशुक्षणिः ।\nविभावसुरपांपित्तं जातवेदास्तनूनपात् ॥ ६३ ॥\nवीतिहोत्रो बृहद्भानुराश्रयाशो धनञ्जयः ।\nहिरण्यरेतास्तमोघ्नो रोहिताश्वो हुताशनः ॥ ६४ ॥\n"},{"t":"sutra","s":"१।१।१","id":"1.1.1"},{"t":"txt","s":"।६२"}]}]}],"asraya":[{"id":"ASraya","headword":"आश्रय","headword_slp1":"ASraya","senses_r":[{"n":1,"spans":[{"t":"txt","s":"आश्रय;\nउपघ्न आश्रयः प्रोक्तो मुनीनां स्थानमाश्रमः ।\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।२९८"}]}]}],"asrama":[{"id":"ASrama","headword":"आश्रम","headword_slp1":"ASrama","senses_r":[{"n":1,"spans":[{"t":"txt","s":"आश्रम;\nउपघ्न आश्रयः प्रोक्तो मुनीनां स्थानमाश्रमः ।\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।२९८"}]},{"n":2,"spans":[{"t":"txt","s":"आश्रम;\nब्रह्मचार्यादयो वेदे प्रोक्ताश्चत्वार आश्रमाः ।\nशूद्रोऽगृहस्थ एव स्यात्क्षत्रियो न यतिर्भवेत् ॥ ३९३ ॥\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।३९३"}]}]}],"asru":[{"id":"aSru","headword":"अश्रु","headword_slp1":"aSru","senses_r":[{"n":1,"spans":[{"t":"txt","s":"अश्रु;\nअश्रूणि वाष्परोदननयनजलाश्रास्रुनामानि ॥ ५१९ ॥\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।५१९"}]}]},{"id":"asru","headword":"अस्रु","headword_slp1":"asru","senses_r":[{"n":1,"spans":[{"t":"txt","s":"अस्रु;\nअश्रूणि वाष्परोदननयनजलाश्रास्रुनामानि ॥ ५१९ ॥\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।५१९"}]}]}],"asra":[{"id":"aSra","headword":"अश्र","headword_slp1":"aSra","senses_r":[{"n":1,"spans":[{"t":"txt","s":"अश्र;\nअश्रूणि वाष्परोदननयनजलाश्रास्रुनामानि ॥ ५१९ ॥\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।५१९"}]},{"n":2,"spans":[{"t":"txt","s":"अश्र;\nअणिरश