{"mukunda":[{"id":"mukunda","headword":"मुकुन्द","headword_slp1":"mukunda","senses_r":[{"n":1,"spans":[{"t":"txt","s":"मुकुन्द;\nविष्णुः कृष्णः केशवो मञ्जुकेशी,\nश्रीवत्साङ्कः श्रीपतिः पीतवासाः ।\nविष्वक्सेनो विश्वरूपो मुरारिः,\nशौरिः शार्ङ्गी पद्मनाभो मुकुन्दः ॥ २१ ॥\nगोविन्दो धरणिधरः सुपर्णकेतु-\nर्वैकुण्ठो जलशयनश्चतुर्भुजश्च ।\nदैत्यारिर्मधुमथनो रथाङ्गपाणि-\nर्दाशार्हः क्रतुपुरुषो वृषाकपिः स्यात् ॥ २२ ॥\nजनार्दनाधोक्षजवासुदेवं दामोदरं श्रीधरमच्युतं च ।\nउपेन्द्रमिन्द्रावरजं च बभ्रं हरिं हृषीकेशमुदाहरन्ति ॥ २३ ॥\nआत्मभूः पुण्डरीकाक्षः श्रीवत्सो विष्टरश्रवाः ।\nनारायणो जगन्नाथो वनमाली गदाधरः ॥ २४ ॥\nसनातनो जिनः शम्भुर्विधिर्वेधा गदाग्रजः ।\nकैटभारिरजो जिष्णुः कंसजित्पुरुषोत्तमः ॥ २५ ॥\n"},{"t":"sutra","s":"१।१।१","id":"1.1.1"},{"t":"txt","s":"।२१"}]}]}],"mukti":[{"id":"mukti","headword":"मुक्ति","headword_slp1":"mukti","senses_r":[{"n":1,"spans":[{"t":"txt","s":"मुक्ति;\nकैवल्यं निर्वाणं निःश्रेयसममृतमक्षरं ब्रह्म ।\nअपुनर्भवोऽपवर्गो मुक्तिर्मोक्षो महानन्दः ॥ १२४ ॥\n"},{"t":"sutra","s":"१।१।१","id":"1.1.1"},{"t":"txt","s":"।१२४"}]},{"n":2,"spans":[{"t":"txt","s":"मुक्ति;\nअर्चनामूल्ययोरर्घो विसर्गो मुक्तिवर्चसोः ।\n"},{"t":"sutra","s":"५।१।१","id":"5.1.1"},{"t":"txt","s":"।८३५"}]}]}],"mukula":[{"id":"mukula","headword":"मुकुल","headword_slp1":"mukula","senses_r":[{"n":1,"spans":[{"t":"txt","s":"मुकुल;\nकोरकजालककलिकाकुड्मलमुकुलानि तुल्यानि ॥ १८६ ॥\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।१८६"}]}]}],"muktamukta":[{"id":"muktAmukta","headword":"मुक्तामुक्त","headword_slp1":"muktAmukta","senses_r":[{"n":1,"spans":[{"t":"txt","s":"मुक्तामुक्त;\nमुक्तामुक्तममुक्तं करमुक्तं यन्त्रमुक्तं च ॥ ४६२ ॥\nशक्त्यादि पाणिमुक्तं स्यादमुक्तं क्षुरादिकम् ।\nमुक्तामुक्तं तु यष्ट्यादि यन्त्रमुक्तं शरादिकम् ॥ ४६३ ॥\n"},{"t":"sutra","s":"२।१।१","id":"2.1.1"},{"t":"txt","s":"।४६२"}]}]}],"mukura":[{"id":"mukura","headword":"मुकुर","headword_slp1":"mukura","senses_r":[{"n":1,"spans":[{"t":"txt","s":"मुकुर;\nकज्जलमञ्जनमभिहितमादर्शो दर्पणो मुकुरः ॥ ५५५ ॥\n"},{"t":"sutra","s"