{"hetvaBasalaksaRam":[{"id":"hetvABAsalakzaRam","headword":"हेत्वाभासलक्षणम्","headword_slp1":"hetvABAsalakzaRam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"एतादृशरूपशून्या हेतुवद् आभासमाना हेत्वाभासाः। अनुमितिप्रतिबन्धकयथार्थज्ञानविषयत्वं \nहेत्वाभासत्वमिति वा।"}]}]}],"hetvaBasaBedaH":[{"id":"hetvABAsaBedAH","headword":"हेत्वाभासभेदाः","headword_slp1":"hetvABAsaBedAH","senses_r":[{"n":1,"spans":[{"t":"txt","s":"ते च सव्यभिचारविरुद्धसत्प्रतिपक्षासिद्धबाधिताः पञ्चैव।"}]}]}],"hetvavayavalaksaRam":[{"id":"hetvavayavalakzaRam","headword":"हेत्ववयवलक्षणम्","headword_slp1":"hetvavayavalakzaRam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"व्याप्त्यभिधानप्रयोजकजिज्ञासाजनकज्ञानजनकन्यायावयवत्वं हेतुत्वम्।"}]}]}],"hetvaBasanirupaRam":[{"id":"hetvABAsanirUpaRam","headword":"हेत्वाभासनिरूपणम्","headword_slp1":"hetvABAsanirUpaRam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"हेत्वाभासाः च पूर्वत्रैव निरूपिताः। भागासिद्धादयः तु यथायथं पञ्चस्वेवान्तर्भूताः।\nयेऽपि लक्षणस्य के वलव्यतिरेकिहेतोः त्रयोऽतिव्याप्त्यादयो दोषाः तेऽपि व्याप्यत्वासिद्धादावन्तर्भूताः।\nलक्ष्यैकदेशवृत्तित्वम् अव्याप्तिः। अलक्ष्यवृत्तित्वम् अतिव्याप्तिः। लक्ष्यमा[८ ब]त्रावर्तनम् असम्भवः।"}]}]}],"hetvantaranigrahasTanalaksaRam":[{"id":"hetvantaranigrahasTAnalakzaRam","headword":"हेत्वन्तरनिग्रहस्थानलक्षणम्","headword_slp1":"hetvantaranigrahasTAnalakzaRam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"अविशिष्टसाधनभागमभिधाय पुनर्विशेषणवत्तद्वचनं हेत्वन्तरम्।"}]}]}]}