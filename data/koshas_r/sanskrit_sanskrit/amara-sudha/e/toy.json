{"toyapipali":[{"id":"toyapippalI","headword":"तोयपिप्पली","headword_slp1":"toyapippalI","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तोयस्य पिप्पलीव ॥\nप्रक्रिया\nतोय + ङस् + पिप्पली + सु - षष्ठी "},{"t":"sutra","s":"2.2.8","id":"2.2.8"},{"t":"txt","s":" \n तोय + पिप्पली - सुपो धातुप्रातिपदिकयोः "},{"t":"sutra","s":"2.4.71","id":"2.4.71"},{"t":"txt","s":" \n तोयपिप्पली + सु - स्वौजसमौट्छष्टाभ्याम्भिस्ङेभ्याम्भ्यस्ङसिभ्याम्भ्यस्ङसोसाम्ङ्योस्सुप्‌ "},{"t":"sutra","s":"4.1.2","id":"4.1.2"},{"t":"txt","s":" \n तोयपिप्पली + स् - उपदेशेऽजनुनासिक इत् "},{"t":"sutra","s":"1.3.2","id":"1.3.2"},{"t":"txt","s":" , तस्य लोपः "},{"t":"sutra","s":"1.3.9","id":"1.3.9"},{"t":"txt","s":" \n तोयपिप्पली - हल्ङ्याब्भ्यो दीर्घात्‌ सुतिस्यपृक्तं हल् "},{"t":"sutra","s":"6.1.68","id":"6.1.68"}]}]}],"toyam":[{"id":"toyam","headword":"तोयम्","headword_slp1":"toyam","senses_r":[{"n":1,"spans":[{"t":"txt","s":"तौति । तुः सौत्र आवरणार्थः । औणादिको यः (४.११२)\nप्रक्रिया\nधातुः - तु सौत्रो धातुः । \n तु + य - औणादिको यः (४.११२) उणादिसूत्रम् । \n तो + य - सार्वधातुकार्धधातुकयोः "},{"t":"sutra","s":"7.3.84","id":"7.3.84"},{"t":"txt","s":" \n तोय + सु - स्वौजसमौट्छष्टाभ्याम्भिस्ङेभ्याम्भ्यस्ङसिभ्याम्भ्यस्ङसोसाम्ङ्योस्सुप्‌ "},{"t":"sutra","s":"4.1.2","id":"4.1.2"},{"t":"txt","s":" \n तोय + अम् - अतोऽम् "},{"t":"sutra","s":"7.1.24","id":"7.1.24"},{"t":"txt","s":" \n तोयम् - अमि पूर्वः "},{"t":"sutra","s":"6.1.107","id":"6.1.107"}]}]}]}